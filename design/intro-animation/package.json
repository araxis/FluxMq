{
  "name": "fluxmq-intro-animation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preview": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts FluxMqIntro out/fluxmq-intro.mp4",
    "render:ad": "remotion render src/index.ts FluxMqAd out/fluxmq-ad.mp4",
    "render:gif": "remotion render src/index.ts FluxMqIntro out/fluxmq-intro.gif --codec=gif --scale=0.5 --every-nth-frame=2",
    "still": "remotion still src/index.ts FluxMqIntro out/fluxmq-intro-poster.png --frame=230",
    "still:ad": "remotion still src/index.ts FluxMqAd out/fluxmq-ad-poster.png --frame=1740"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.390",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "^4.0.390",
    "typescript": "^5.9.3"
  },
  "devDependencies": {}
}

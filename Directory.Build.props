<Project>
  <PropertyGroup>
    <FluxFlowEngineVersion>1.1.0</FluxFlowEngineVersion>
    <FluxFlowComponentsDesignerVersion>1.0.1</FluxFlowComponentsDesignerVersion>
    <FluxFlowComponentsAssertionsVersion>1.2.0</FluxFlowComponentsAssertionsVersion>
    <FluxFlowComponentsControlVersion>1.2.0</FluxFlowComponentsControlVersion>
    <FluxFlowComponentsFileSystemVersion>1.2.0</FluxFlowComponentsFileSystemVersion>
    <FluxFlowComponentsHttpVersion>1.2.0</FluxFlowComponentsHttpVersion>
    <FluxFlowComponentsMappingVersion>1.2.0</FluxFlowComponentsMappingVersion>
    <FluxFlowComponentsMetricsVersion>1.2.0</FluxFlowComponentsMetricsVersion>
    <FluxFlowComponentsMqttVersion>1.2.0</FluxFlowComponentsMqttVersion>
    <FluxFlowComponentsObservabilityVersion>1.2.0</FluxFlowComponentsObservabilityVersion>
    <FluxFlowComponentsPayloadsVersion>1.2.0</FluxFlowComponentsPayloadsVersion>
    <FluxFlowComponentsRoutingVersion>1.2.0</FluxFlowComponentsRoutingVersion>
    <FluxFlowComponentsSerializationVersion>1.2.0</FluxFlowComponentsSerializationVersion>
    <FluxFlowComponentsSecretsVersion>1.1.0</FluxFlowComponentsSecretsVersion>
    <FluxFlowComponentsSessionsVersion>1.2.0</FluxFlowComponentsSessionsVersion>
    <FluxFlowComponentsSourcesVersion>1.2.0</FluxFlowComponentsSourcesVersion>
    <FluxFlowComponentsStateVersion>1.2.0</FluxFlowComponentsStateVersion>
    <FluxFlowComponentsStorageVersion>1.1.0</FluxFlowComponentsStorageVersion>
    <FluxFlowComponentsStorageFileSystemVersion>1.1.0</FluxFlowComponentsStorageFileSystemVersion>
    <FluxFlowComponentsTimersVersion>1.2.0</FluxFlowComponentsTimersVersion>
    <FluxFlowComponentsValidationVersion>1.2.0</FluxFlowComponentsValidationVersion>
    <FluxFlowSourceRoot Condition="'$(FluxFlowSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\FluxFlow\</FluxFlowSourceRoot>
    <UseFluxFlowSourceReferences Condition="'$(UseFluxFlowSourceReferences)' == ''">false</UseFluxFlowSourceReferences>
  </PropertyGroup>
</Project>

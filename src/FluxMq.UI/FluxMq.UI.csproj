<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FluxMq.UI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>FluxMQ</ApplicationTitle>
    <ApplicationId>com.fluxmq.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17212B" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17212B" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxMq.App\FluxMq.App.csproj" />
    <ProjectReference Include="..\FluxMq.Core\FluxMq.Core.csproj" />
    <ProjectReference Include="..\FluxMq.Pipeline\FluxMq.Pipeline.csproj" />
    <ProjectReference Include="..\FluxMq.Storage\FluxMq.Storage.csproj" />
  </ItemGroup>

</Project>

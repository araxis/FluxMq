<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>FluxMq.UI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<ApplicationTitle>FluxMQ</ApplicationTitle>
		<ApplicationId>com.fluxmq.desktop</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Unpackaged Windows desktop app. -->
		<WindowsPackageType>None</WindowsPackageType>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<PublishReadyToRun>false</PublishReadyToRun>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
	  <MauiCss Remove="Components\**\*.razor.css" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Components\**\*.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0A0D12" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A0D12" BaseSize="192,192" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BlazorMonaco" Version="3.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="MudBlazor" Version="9.4.0" />
		<PackageReference Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluxMq.App\FluxMq.App.csproj" />
		<ProjectReference Include="..\FluxMq.Components\FluxMq.Components.csproj" />
		<ProjectReference Include="..\FluxMq.Core\FluxMq.Core.csproj" />
		<ProjectReference Include="..\FluxMq.Scenarios\FluxMq.Scenarios.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseFluxFlowSourceReferences)' == 'true'">
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Http\FluxFlow.Components.Http.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Mapping\FluxFlow.Components.Mapping.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Payloads\FluxFlow.Components.Payloads.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Routing\FluxFlow.Components.Routing.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Serialization\FluxFlow.Components.Serialization.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.State\FluxFlow.Components.State.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Storage\FluxFlow.Components.Storage.csproj" />
		<ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Components.Timers\FluxFlow.Components.Timers.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseFluxFlowSourceReferences)' != 'true'">
		<PackageReference Include="FluxFlow.Components.Designer" Version="$(FluxFlowComponentsDesignerVersion)" />
		<PackageReference Include="FluxFlow.Components.Http" Version="$(FluxFlowComponentsHttpVersion)" />
		<PackageReference Include="FluxFlow.Components.Mapping" Version="$(FluxFlowComponentsMappingVersion)" />
		<PackageReference Include="FluxFlow.Components.Payloads" Version="$(FluxFlowComponentsPayloadsVersion)" />
		<PackageReference Include="FluxFlow.Components.Routing" Version="$(FluxFlowComponentsRoutingVersion)" />
		<PackageReference Include="FluxFlow.Components.Serialization" Version="$(FluxFlowComponentsSerializationVersion)" />
		<PackageReference Include="FluxFlow.Components.State" Version="$(FluxFlowComponentsStateVersion)" />
		<PackageReference Include="FluxFlow.Components.Storage" Version="$(FluxFlowComponentsStorageVersion)" />
		<PackageReference Include="FluxFlow.Components.Timers" Version="$(FluxFlowComponentsTimersVersion)" />
	</ItemGroup>

</Project>

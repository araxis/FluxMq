<div class="empty-view" role="status" aria-live="polite">
    @if (Content is not null)
    {
        @Content
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1" Class="pa-4">
            <MudIcon Icon="@Icons.Material.Outlined.Inbox" Color="Color.Secondary" Size="Size.Large" aria-hidden="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@(Message ?? "No data")</MudText>
        </MudStack>
    }
</div>

@code {
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public string? Message { get; set; }
}

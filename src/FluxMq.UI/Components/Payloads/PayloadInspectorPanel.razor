@using FluxMq.Core.Payloads

<MudPaper Elevation="0" Outlined="true" Class="pa-2 payload-inspector">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
        <MudChip T="string" Size="Size.Small" Color="@FormatColor">@_inspection.DisplayTypeLabel</MudChip>
        @if (!string.IsNullOrWhiteSpace(Topic))
        {
            <MudText Typo="Typo.caption" Style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;min-width:0;flex:1 1 0">@Topic</MudText>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">@_inspection.SizeBytes B</MudText>
        @if (ReceivedAt is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@ReceivedAt.Value.ToLocalTime().ToString("HH:mm:ss")</MudText>
        }
    </MudStack>

    <MudToggleGroup T="string" @bind-Value="_activeView" Size="Size.Small" Outlined="true" Color="Color.Primary" Class="mb-1" Style="width:100%">
        <MudToggleItem Value="@("formatted")" UnselectedIcon="@Icons.Material.Filled.DataObject" SelectedIcon="@Icons.Material.Filled.DataObject" />
        <MudToggleItem Value="@("raw")" UnselectedIcon="@Icons.Material.Filled.Subject" SelectedIcon="@Icons.Material.Filled.Subject" />
        <MudToggleItem Value="@("hex")" UnselectedIcon="@Icons.Material.Filled.Tag" SelectedIcon="@Icons.Material.Filled.Tag" />
        <MudToggleItem Value="@("meta")" UnselectedIcon="@Icons.Material.Filled.Info" SelectedIcon="@Icons.Material.Filled.Info" />
    </MudToggleGroup>

    @if (_activeView == "formatted")
    {
        <pre class="payload-inspector-body">@DisplayFormatted()</pre>
    }
    else if (_activeView == "raw")
    {
        <pre class="payload-inspector-body">@DisplayRaw()</pre>
    }
    else if (_activeView == "hex")
    {
        <pre class="payload-inspector-body">@_inspection.HexDump</pre>
    }
    else
    {
        <MudStack Spacing="1" Class="mt-1">
            <MudText Typo="Typo.body2">Type: @_inspection.DisplayTypeLabel</MudText>
            <MudText Typo="Typo.body2">Size: @_inspection.SizeBytes bytes</MudText>
            <MudText Typo="Typo.body2">Text payload: @(_inspection.IsText ? "Yes" : "No")</MudText>
        </MudStack>
    }

</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "Payload Inspector";
    [Parameter] public string? Topic { get; set; }
    [Parameter] public DateTimeOffset? ReceivedAt { get; set; }
    [Parameter] public byte[]? Payload { get; set; }

    private string _activeView = "formatted";
    private PayloadInspectionResult _inspection = PayloadInspector.Inspect([]);

    private Color FormatColor => _inspection.Format switch
    {
        PayloadFormat.Json => Color.Success,
        PayloadFormat.Array => Color.Info,
        PayloadFormat.String => Color.Default,
        PayloadFormat.Number => Color.Primary,
        PayloadFormat.Boolean => Color.Primary,
        PayloadFormat.Null => Color.Secondary,
        PayloadFormat.Xml => Color.Info,
        PayloadFormat.Base64 => Color.Warning,
        PayloadFormat.Binary => Color.Error,
        _ => Color.Default
    };

    protected override void OnParametersSet()
    {
        _inspection = PayloadInspector.Inspect(Payload);
    }

    private string DisplayFormatted() => string.IsNullOrEmpty(_inspection.FormattedText)
        ? "No formatted preview available."
        : _inspection.FormattedText;

    private string DisplayRaw() => _inspection.IsText
        ? _inspection.RawText
        : "Binary payload. Use the hex view.";
}

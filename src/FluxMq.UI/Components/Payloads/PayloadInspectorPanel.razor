@using FluxMq.Core.Payloads

<MudPaper Elevation="0" Outlined="true" Class="pa-3 payload-inspector">
    <div class="payload-inspector-header">
        <div>
            <MudText Typo="Typo.subtitle2">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Topic))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Topic</MudText>
            }
        </div>
        <div class="payload-inspector-meta">
            <MudChip T="string" Size="Size.Small" Color="@FormatColor">@_inspection.ContentTypeLabel</MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@_inspection.SizeBytes bytes</MudText>
        </div>
    </div>

    @if (ReceivedAt is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            @ReceivedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")
        </MudText>
    }

    <MudTabs Rounded="true" Elevation="0" Class="mt-3">
        <MudTabPanel Text="Formatted" Icon="@Icons.Material.Filled.DataObject">
            <pre class="payload-inspector-body">@DisplayFormatted()</pre>
        </MudTabPanel>
        <MudTabPanel Text="Raw" Icon="@Icons.Material.Filled.Subject">
            <pre class="payload-inspector-body">@DisplayRaw()</pre>
        </MudTabPanel>
        <MudTabPanel Text="Hex" Icon="@Icons.Material.Filled.Tag">
            <pre class="payload-inspector-body">@_inspection.HexDump</pre>
        </MudTabPanel>
        <MudTabPanel Text="Meta" Icon="@Icons.Material.Filled.Info">
            <MudStack Spacing="1">
                <MudText Typo="Typo.body2">Type: @_inspection.ContentTypeLabel</MudText>
                <MudText Typo="Typo.body2">Size: @_inspection.SizeBytes bytes</MudText>
                <MudText Typo="Typo.body2">Text payload: @(_inspection.IsText ? "Yes" : "No")</MudText>
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "Payload Inspector";
    [Parameter] public string? Topic { get; set; }
    [Parameter] public DateTimeOffset? ReceivedAt { get; set; }
    [Parameter] public byte[]? Payload { get; set; }

    private PayloadInspectionResult _inspection = PayloadInspector.Inspect([]);

    private Color FormatColor => _inspection.Format switch
    {
        PayloadFormat.Json => Color.Success,
        PayloadFormat.Xml => Color.Info,
        PayloadFormat.Base64 => Color.Warning,
        PayloadFormat.Binary => Color.Error,
        _ => Color.Default
    };

    protected override void OnParametersSet()
    {
        _inspection = PayloadInspector.Inspect(Payload);
    }

    private string DisplayFormatted() => string.IsNullOrEmpty(_inspection.FormattedText)
        ? "No formatted preview available."
        : _inspection.FormattedText;

    private string DisplayRaw() => _inspection.IsText
        ? _inspection.RawText
        : "Binary payload. Use the hex view.";
}

@using FluxMq.Core.Payloads

<section class="payload-inspector" aria-label="@Title">
    <div class="payload-inspector-header">
        <div class="payload-inspector-title">
            <span class="payload-format-marker @FormatMarkerClass" aria-hidden="true">
                <MudIcon Icon="@FormatIcon" Size="Size.Small" aria-hidden="true" />
            </span>
            <div class="payload-title-copy">
                <strong>@Title</strong>
                <span>@TopicLabel</span>
            </div>
        </div>
        <div class="payload-meta-strip">
            <span>@_inspection.DisplayTypeLabel</span>
            <span>@_inspection.SizeBytes B</span>
            @if (ReceivedAt is not null)
            {
                <span>@ReceivedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
            }
        </div>
    </div>

    <div class="payload-view-switch" role="tablist" aria-label="Payload views">
        <button type="button"
                id="@PayloadViewTabId(FormattedView)"
                role="tab"
                aria-selected="@IsActiveView(FormattedView)"
                aria-controls="@PayloadViewPanelId"
                aria-keyshortcuts="Enter Space"
                class="@ViewButtonClass(FormattedView)"
                title="Formatted"
                @onclick="@(() => _activeView = FormattedView)">
            <MudIcon Icon="@Icons.Material.Filled.DataObject" Size="Size.Small" aria-hidden="true" />
            <span>Formatted</span>
        </button>
        <button type="button"
                id="@PayloadViewTabId(RawView)"
                role="tab"
                aria-selected="@IsActiveView(RawView)"
                aria-controls="@PayloadViewPanelId"
                aria-keyshortcuts="Enter Space"
                class="@ViewButtonClass(RawView)"
                title="Raw"
                @onclick="@(() => _activeView = RawView)">
            <MudIcon Icon="@Icons.Material.Filled.Subject" Size="Size.Small" aria-hidden="true" />
            <span>Raw</span>
        </button>
        <button type="button"
                id="@PayloadViewTabId(HexView)"
                role="tab"
                aria-selected="@IsActiveView(HexView)"
                aria-controls="@PayloadViewPanelId"
                aria-keyshortcuts="Enter Space"
                class="@ViewButtonClass(HexView)"
                title="Hex"
                @onclick="@(() => _activeView = HexView)">
            <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" aria-hidden="true" />
            <span>Hex</span>
        </button>
        <button type="button"
                id="@PayloadViewTabId(MetaView)"
                role="tab"
                aria-selected="@IsActiveView(MetaView)"
                aria-controls="@PayloadViewPanelId"
                aria-keyshortcuts="Enter Space"
                class="@ViewButtonClass(MetaView)"
                title="Metadata"
                @onclick="@(() => _activeView = MetaView)">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" aria-hidden="true" />
            <span>Meta</span>
        </button>
    </div>

    @if (_activeView == FormattedView)
    {
        <pre id="@PayloadViewPanelId"
             class="payload-inspector-body"
             role="tabpanel"
             aria-labelledby="@PayloadViewTabId(_activeView)"
             tabindex="0">@DisplayFormatted()</pre>
    }
    else if (_activeView == RawView)
    {
        <pre id="@PayloadViewPanelId"
             class="payload-inspector-body"
             role="tabpanel"
             aria-labelledby="@PayloadViewTabId(_activeView)"
             tabindex="0">@DisplayRaw()</pre>
    }
    else if (_activeView == HexView)
    {
        <pre id="@PayloadViewPanelId"
             class="payload-inspector-body"
             role="tabpanel"
             aria-labelledby="@PayloadViewTabId(_activeView)"
             tabindex="0">@_inspection.HexDump</pre>
    }
    else
    {
        <div id="@PayloadViewPanelId"
             class="payload-inspector-meta-list"
             role="tabpanel"
             aria-labelledby="@PayloadViewTabId(_activeView)"
             tabindex="0">
            <div>
                <span>Type</span>
                <strong>@_inspection.DisplayTypeLabel</strong>
            </div>
            <div>
                <span>Size</span>
                <strong>@_inspection.SizeBytes bytes</strong>
            </div>
            <div>
                <span>Text</span>
                <strong>@(_inspection.IsText ? "Yes" : "No")</strong>
            </div>
        </div>
    }
</section>

@code {
    private const string FormattedView = "formatted";
    private const string RawView = "raw";
    private const string HexView = "hex";
    private const string MetaView = "meta";

    private readonly string _payloadViewIdPrefix = $"payload-inspector-{Guid.NewGuid():N}";

    [Parameter] public string Title { get; set; } = "Payload Inspector";
    [Parameter] public string? Topic { get; set; }
    [Parameter] public DateTimeOffset? ReceivedAt { get; set; }
    [Parameter] public byte[]? Payload { get; set; }

    private string _activeView = FormattedView;
    private PayloadInspectionResult _inspection = PayloadInspector.Inspect([]);

    private string TopicLabel => string.IsNullOrWhiteSpace(Topic)
        ? "No topic"
        : Topic;

    private string FormatMarkerClass => _inspection.Format switch
    {
        PayloadFormat.Json or PayloadFormat.Array => "json",
        PayloadFormat.Number or PayloadFormat.Boolean => "scalar",
        PayloadFormat.Xml or PayloadFormat.Base64 => "structured",
        PayloadFormat.Binary => "binary",
        _ => "text"
    };

    private string FormatIcon => _inspection.Format switch
    {
        PayloadFormat.Json or PayloadFormat.Array => Icons.Material.Filled.DataObject,
        PayloadFormat.Xml => Icons.Material.Filled.Code,
        PayloadFormat.Base64 or PayloadFormat.Binary => Icons.Material.Filled.Tag,
        _ => Icons.Material.Filled.Subject
    };

    protected override void OnParametersSet()
    {
        _inspection = PayloadInspector.Inspect(Payload);
    }

    private string DisplayFormatted() => string.IsNullOrEmpty(_inspection.FormattedText)
        ? "No formatted preview available."
        : _inspection.FormattedText;

    private string DisplayRaw() => _inspection.IsText
        ? _inspection.RawText
        : "Binary payload. Use the hex view.";

    private bool IsActiveView(string view) => string.Equals(_activeView, view, StringComparison.Ordinal);

    private string PayloadViewPanelId => $"{_payloadViewIdPrefix}-panel";

    private string PayloadViewTabId(string view) => $"{_payloadViewIdPrefix}-{view}-tab";

    private string ViewButtonClass(string view) => IsActiveView(view)
        ? "payload-view-button active"
        : "payload-view-button";
}

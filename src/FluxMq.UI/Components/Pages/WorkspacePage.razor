@page "/"
@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="workspace-fill">
    @if (Projects.ActiveProject is null)
    {
        <div class="workspace-empty">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.BubbleChart" Style="font-size:64px;opacity:0.18;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">No app open</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.NoteAdd"
                               OnClick="@NewAppAsync">New app</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="@OpenFileAsync">Open file</MudButton>
                </MudStack>
            </MudStack>
        </div>
    }
    else
    {
        var active = Projects.ActiveProject;
        <div class="project-tabbar">
            @foreach (var wf in active.WorkflowNames)
            {
                var w = wf;
                var isActive = string.Equals(w, active.ActiveWorkflowName, StringComparison.Ordinal) && !_jsonView;
                <div class="project-tab @(isActive ? "project-tab-active" : "")"
                     @onclick="@(() => { active.SetActiveWorkflow(w); _jsonView = false; })">
                    <span class="project-tab-name">@w</span>
                </div>
            }
            <div class="project-tab project-tab-add" @onclick="@AddWorkflowAsync">
                <span>+</span>
            </div>
            <div class="project-tabbar-app">
                <span class="project-tab-json @(_jsonView ? "project-tab-json-active" : null)"
                      title="View JSON" @onclick="@(() => _jsonView = !_jsonView)">&lt;/&gt;</span>
                <span class="project-tabbar-app-name">@active.Name</span>
                <span class="project-tab-close" title="Close app" @onclick="@CloseActiveAsync">&#x2715;</span>
            </div>
        </div>

        @if (_jsonView)
        {
            <AppJsonPanel Project="@active" />
        }
        else if (active.ActiveWorkflowName is null && active.WorkflowNames.Count == 0)
        {
            <div class="workspace-empty">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:64px;opacity:0.18;" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">No pipelines</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@AddWorkflowAsync">Add pipeline</MudButton>
                </MudStack>
            </div>
        }
        else
        {
            <CascadingValue Value="@active" @key="@active">
                <div class="workspace-tab-content">
                    <div class="workspace-designer-region">
                        <FlowDesigner />
                    </div>
                </div>
            </CascadingValue>
        }
    }
</div>

@code {
    private readonly HashSet<FlowWorkspaceService> _subscribed = [];
    private bool _jsonView;

    protected override void OnInitialized()
    {
        Projects.Changed += OnProjectsChanged;
        SyncSubscriptions();
    }

    private void OnProjectsChanged(object? sender, EventArgs e)
    {
        SyncSubscriptions();
        InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void SyncSubscriptions()
    {
        foreach (var project in Projects.Projects)
            if (_subscribed.Add(project))
                project.Changed += OnProjectChanged;

        foreach (var stale in _subscribed.Where(p => !Projects.Projects.Contains(p)).ToList())
        {
            stale.Changed -= OnProjectChanged;
            _subscribed.Remove(stale);
        }
    }

    private async Task NewAppAsync()
    {
        var dialog = await DialogService.ShowAsync<NewAppDialog>("New App");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: NewAppDialog.NewAppResult r })
        {
            var project = Projects.NewProject();
            project.SetDisplayName(r.AppName);
            project.AddWorkflow(r.PipelineName);
            project.SetActiveWorkflow(r.PipelineName);
            var resourceKey = string.IsNullOrWhiteSpace(r.Connection.Name)
                ? "connection"
                : r.Connection.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            project.UpsertConnectionResource(resourceKey, r.Connection);
            Live.AddConnectionIfAbsent(r.Connection, r.Subscription);
        }
    }

    private async Task OpenFileAsync()
    {
        var result = await FilePicker.Default.PickAsync(new PickOptions
        {
            PickerTitle = "Open FluxMQ Project",
            FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, [".json"] },
                { DevicePlatform.macOS, ["json", "public.json"] }
            })
        });
        if (result is not null)
        {
            var project = await Projects.OpenAsync(result.FullPath);
            foreach (var (profile, sub) in project.GetConnectionProfiles())
                Live.AddConnectionIfAbsent(profile, sub);
        }
    }

    private async Task CloseActiveAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;
        _jsonView = false;
        await Projects.CloseProjectAsync(active);
    }

    private async Task AddWorkflowAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        var dialog = await DialogService.ShowAsync<NewPipelineDialog>("New Pipeline");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            active.AddWorkflow(name.Trim());
            active.SetActiveWorkflow(name.Trim());
        }
    }

    public void Dispose()
    {
        Projects.Changed -= OnProjectsChanged;
        foreach (var project in _subscribed)
            project.Changed -= OnProjectChanged;
        _subscribed.Clear();
    }
}

@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="workspace-layout @LayoutClass"
     @ref="_layoutElement"
     style="@GridStyle"
     data-left-min="@LeftPanelMinWidth"
     data-left-max="@LeftPanelMaxWidth"
     data-right-min="@RightPanelMinWidth"
     data-right-max="@RightPanelMaxWidth">
    <aside class="workspace-side workspace-left">
        <MudIconButton Class="workspace-panel-toggle"
                       Icon="@Icons.Material.Filled.ChevronLeft"
                       OnClick="@ToggleLeft" />
        <div class="workspace-side-scroll">
            <MudStack Spacing="2">
                <ConnectionPanel />
                <SessionPanel />
                <RuntimePanel />
            </MudStack>
        </div>
    </aside>

    <div class="workspace-resize-handle workspace-left-handle"
         data-workspace-resize="left"
         role="separator"
         aria-orientation="vertical" />

    <div class="workspace-rail workspace-rail-left">
        <MudIconButton Icon="@Icons.Material.Filled.MenuOpen" OnClick="@ToggleLeft" />
    </div>

    <main class="workspace-center flux-scroll">
        <div class="workspace-center-toolbar">
            <MudIconButton Icon="@(_leftOpen ? Icons.Material.Filled.KeyboardDoubleArrowLeft : Icons.Material.Filled.KeyboardDoubleArrowRight)"
                           OnClick="@ToggleLeft" />
            <MudSpacer />
            <MudIconButton Icon="@(_rightOpen ? Icons.Material.Filled.KeyboardDoubleArrowRight : Icons.Material.Filled.KeyboardDoubleArrowLeft)"
                           OnClick="@ToggleRight" />
        </div>
        <FlowDesigner />
    </main>

    <div class="workspace-rail workspace-rail-right">
        <MudIconButton Icon="@Icons.Material.Filled.Troubleshoot" OnClick="@ToggleRight" />
    </div>

    <div class="workspace-resize-handle workspace-right-handle"
         data-workspace-resize="right"
         role="separator"
         aria-orientation="vertical" />

    <aside class="workspace-side workspace-right">
        <MudIconButton Class="workspace-panel-toggle"
                       Icon="@Icons.Material.Filled.ChevronRight"
                       OnClick="@ToggleRight" />
        <div class="workspace-side-scroll">
            <LiveInspectorPanel />
        </div>
    </aside>
</div>

@code {
    private const double LeftPanelMinWidth = 280;
    private const double LeftPanelMaxWidth = 520;
    private const double RightPanelMinWidth = 320;
    private const double RightPanelMaxWidth = 600;

    private bool _leftOpen = true;
    private bool _rightOpen = true;
    private double _leftPanelWidth = 340;
    private double _rightPanelWidth = 400;
    private ElementReference _layoutElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<WorkspacePage>? _dotNetReference;

    private string LayoutClass =>
        $"{(!_leftOpen ? "workspace-left-closed" : string.Empty)} {(!_rightOpen ? "workspace-right-closed" : string.Empty)}";

    private string GridStyle => $"--workspace-left-width: {_leftPanelWidth:0}px; --workspace-right-width: {_rightPanelWidth:0}px;";

    private void ToggleLeft() => _leftOpen = !_leftOpen;
    private void ToggleRight() => _rightOpen = !_rightOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetReference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./workspace-page.js");
        await _module.InvokeVoidAsync("attachWorkspaceResizer", _layoutElement, _dotNetReference);
    }

    [JSInvokable]
    public void CommitPanelWidth(string side, double width)
    {
        if (string.Equals(side, "left", StringComparison.Ordinal))
        {
            _leftPanelWidth = Math.Clamp(width, LeftPanelMinWidth, LeftPanelMaxWidth);
        }
        else if (string.Equals(side, "right", StringComparison.Ordinal))
        {
            _rightPanelWidth = Math.Clamp(width, RightPanelMinWidth, RightPanelMaxWidth);
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("detachWorkspaceResizer", _layoutElement);
            await _module.DisposeAsync();
        }

        _dotNetReference?.Dispose();
    }
}

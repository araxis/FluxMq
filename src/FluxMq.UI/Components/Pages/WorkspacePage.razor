@page "/"
@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="workspace-fill">
    @if (Projects.ActiveProject is null)
    {
        <div class="workspace-empty">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <img class="workspace-empty-mark" src="brand/fluxmq-mark.svg" alt="" aria-hidden="true" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">No app open</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.NoteAdd"
                               OnClick="@NewAppAsync">New app</MudButton>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="@OpenFileAsync">Open file</MudButton>
                </MudStack>
            </MudStack>
        </div>
    }
    else
    {
        var active = Projects.ActiveProject;
        <div class="project-tabbar">
            @foreach (var wf in active.WorkflowNames)
            {
                var w = wf;
                var isActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Pipeline &&
                    string.Equals(w, active.ActiveWorkflowName, StringComparison.Ordinal) &&
                    !_jsonView;
                <div class="project-tab @(isActive ? "project-tab-active" : "")"
                     role="button"
                     tabindex="0"
                     aria-current="@WorkspaceTabCurrent(isActive)"
                     title="@($"Pipeline {w}")"
                     @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, () => { active.SetActiveWorkflow(w); _jsonView = false; }))"
                     @onclick="@(() => { active.SetActiveWorkflow(w); _jsonView = false; })">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                    <span class="project-tab-name">@w</span>
                    <button type="button"
                            class="project-tab-delete"
                            title="Delete pipeline"
                            aria-label="@($"Delete pipeline {w}")"
                            @onclick:stopPropagation="true"
                            @onmousedown:stopPropagation="true"
                            @onclick="@(() => RemoveWorkflowAsync(w))">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" aria-hidden="true" />
                    </button>
                </div>
            }
            @{
                var metricsActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Metrics && !_jsonView;
            }
            <div class="project-tab project-tab-metrics @(metricsActive ? "project-tab-active" : "")"
                 role="button"
                 tabindex="0"
                 aria-current="@WorkspaceTabCurrent(metricsActive)"
                 title="Metrics"
                 @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, () => { active.SetActiveMetrics(); _jsonView = false; }))"
                 @onclick="@(() => { active.SetActiveMetrics(); _jsonView = false; })">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                <span class="project-tab-name">Metrics</span>
                <span class="project-tab-count">@active.MetricNames.Count</span>
            </div>
            @foreach (var dashboard in active.DashboardNames)
            {
                var d = dashboard;
                var isActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Dashboard &&
                    string.Equals(d, active.ActiveDashboardName, StringComparison.Ordinal) &&
                    !_jsonView;
                <div class="project-tab project-tab-dashboard @(isActive ? "project-tab-active" : "")"
                     role="button"
                     tabindex="0"
                     aria-current="@WorkspaceTabCurrent(isActive)"
                     title="@($"Dashboard {d}")"
                     @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, () => { active.SetActiveDashboard(d); _jsonView = false; }))"
                     @onclick="@(() => { active.SetActiveDashboard(d); _jsonView = false; })">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                    <span class="project-tab-name">@d</span>
                    <button type="button"
                            class="project-tab-delete"
                            title="Delete dashboard"
                            aria-label="@($"Delete dashboard {d}")"
                            @onclick:stopPropagation="true"
                            @onmousedown:stopPropagation="true"
                            @onclick="@(() => RemoveDashboardAsync(d))">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" aria-hidden="true" />
                    </button>
                </div>
            }
            @foreach (var test in active.TestNames)
            {
                var t = test;
                var isActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Test &&
                    string.Equals(t, active.ActiveTestName, StringComparison.Ordinal) &&
                    !_jsonView;
                <div class="project-tab project-tab-test @(isActive ? "project-tab-active" : "")"
                     role="button"
                     tabindex="0"
                     aria-current="@WorkspaceTabCurrent(isActive)"
                     title="@($"Test {t}")"
                     @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, () => { active.SetActiveTest(t); _jsonView = false; }))"
                     @onclick="@(() => { active.SetActiveTest(t); _jsonView = false; })">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                    <span class="project-tab-name">@t</span>
                    <button type="button"
                            class="project-tab-delete"
                            title="Delete test"
                            aria-label="@($"Delete test {t}")"
                            @onclick:stopPropagation="true"
                            @onmousedown:stopPropagation="true"
                            @onclick="@(() => RemoveTestAsync(t))">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" aria-hidden="true" />
                    </button>
                </div>
            }
            @{
                var topicsActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Topics && !_jsonView;
            }
            <div class="project-tab project-tab-topics @(topicsActive ? "project-tab-active" : "")"
                 role="button"
                 tabindex="0"
                 aria-current="@WorkspaceTabCurrent(topicsActive)"
                 title="Topics"
                 @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, () => { active.SetActiveTopics(); _jsonView = false; }))"
                 @onclick="@(() => { active.SetActiveTopics(); _jsonView = false; })">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                <span class="project-tab-name">Topics</span>
                <span class="project-tab-count">@Live.RecentMessages.Select(m => m.Topic).Distinct(StringComparer.Ordinal).Count()</span>
            </div>
            @{
                var logsActive = active.ActiveArtifactKind == WorkspaceArtifactKind.Logs && !_jsonView;
            }
            <div class="project-tab @(logsActive ? "project-tab-active" : "")"
                 role="button"
                 tabindex="0"
                 aria-current="@WorkspaceTabCurrent(logsActive)"
                 title="Logs"
                 @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, SelectLogs))"
                 @onclick="@(() => SelectLogs())">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                <span class="project-tab-name">Logs</span>
            </div>
            <div class="project-tab project-tab-json-view @(_jsonView ? "project-tab-active" : "")"
                 role="button"
                 tabindex="0"
                 aria-current="@WorkspaceTabCurrent(_jsonView)"
                 title="App JSON"
                 @onkeydown="@((KeyboardEventArgs args) => RunFromKeyboardAsync(args, ToggleJsonView))"
                 @onclick="@ToggleJsonView">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="project-tab-icon" aria-hidden="true" />
                <span class="project-tab-name">App JSON</span>
            </div>
            <MudMenu Dense="true"
                     Icon="@Icons.Material.Filled.Add"
                     Size="Size.Small"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft"
                     Class="project-tab-menu"
                     PopoverClass="project-tab-create-menu">
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Timeline"
                                 OnClick="@AddWorkflowAsync">Pipeline</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.QueryStats"
                                 OnClick="@AddMetricAsync">Metric</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Dashboard"
                                 OnClick="@AddDashboardAsync">Dashboard</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.FactCheck"
                                 OnClick="@AddTestAsync">Test</MudMenuItem>
                </ChildContent>
            </MudMenu>
            <div class="project-tabbar-app">
                <span class="project-tabbar-app-name">@active.Name</span>
                <button type="button"
                        class="project-tab-close"
                        title="Close app"
                        aria-label="@($"Close app {active.Name}")"
                        @onclick:stopPropagation="true"
                        @onmousedown:stopPropagation="true"
                        @onclick="@CloseActiveAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                </button>
            </div>
        </div>

        @if (_jsonView)
        {
            <div class="workspace-tab-content">
                <AppJsonPanel Project="@active" />
            </div>
        }
        else if (active.ActiveArtifactKind == WorkspaceArtifactKind.Logs)
        {
            <div class="workspace-tab-content">
                <WorkspaceLogPanel Logs="@active.Logs"
                                   OnClear="@active.ClearLogs"
                                   Title="Logs"
                                   InitialQuery="@_pendingLogQuery"
                                   MaxEntries="1000" />
            </div>
        }
        else if (active.ActiveArtifactKind == WorkspaceArtifactKind.Topics)
        {
            <div class="workspace-tab-content">
                <TopicExplorerPanel />
            </div>
        }
        else if (active.ActiveArtifactName is null &&
                 active.WorkflowNames.Count == 0 &&
                 active.MetricNames.Count == 0 &&
                 active.DashboardNames.Count == 0 &&
                 active.TestNames.Count == 0)
        {
            <div class="workspace-empty">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <img class="workspace-empty-mark compact" src="brand/fluxmq-mark.svg" alt="" aria-hidden="true" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">No artifacts</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@AddWorkflowAsync">Add pipeline</MudButton>
                </MudStack>
            </div>
        }
        else if (active.ActiveArtifactKind == WorkspaceArtifactKind.Metrics)
        {
            <MetricDesigner Project="@active" />
        }
        else if (active.ActiveArtifactKind == WorkspaceArtifactKind.Dashboard)
        {
            <div class="workspace-tab-content">
                <div class="workspace-artifact-shell @(!_dashboardEditMode ? "workspace-artifact-shell-live" : null)">
                    @if (_dashboardEditMode)
                    {
                        <aside class="workspace-artifact-tools">
                            <ComponentCatalogPanel ArtifactKind="@WorkspaceArtifactKind.Dashboard" />
                        </aside>
                    }
                    <div class="workspace-artifact-region">
                        <DashboardDesigner Project="@active" EditModeChanged="@OnDashboardEditModeChanged" />
                    </div>
                </div>
            </div>
        }
        else if (active.ActiveArtifactKind == WorkspaceArtifactKind.Test)
        {
            <div class="workspace-tab-content">
                <div class="workspace-artifact-shell workspace-artifact-shell-full">
                    <div class="workspace-artifact-region">
                        <TestStudio Project="@active" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <CascadingValue Value="@active" @key="@active">
                <div class="workspace-tab-content">
                    <div class="workspace-artifact-shell workspace-artifact-shell-pipeline">
                        <aside class="workspace-artifact-tools">
                            <ComponentCatalogPanel ArtifactKind="@WorkspaceArtifactKind.Pipeline" />
                        </aside>
                        <div class="workspace-designer-region">
                            <FlowDesigner LogsRequested="@OpenLogs" />
                        </div>
                    </div>
                </div>
            </CascadingValue>
        }
    }
</div>

@code {
    private readonly HashSet<FlowWorkspaceService> _subscribed = [];
    private bool _jsonView;
    private FlowWorkspaceService? _lastActiveProject;
    private WorkspaceArtifactKind? _lastActiveArtifactKind;
    private string? _lastActiveArtifactName;
    private bool _dashboardEditMode = true;
    private WorkspaceLogQuery? _pendingLogQuery;

    protected override void OnInitialized()
    {
        Projects.Changed += OnProjectsChanged;
        SyncSubscriptions();
        SyncActiveArtifactSelection();
        _ = OpenStartupFileAsync();
    }

    private void OnProjectsChanged(object? sender, EventArgs e)
    {
        SyncSubscriptions();
        SyncActiveArtifactSelection();
        InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e)
    {
        SyncActiveArtifactSelection();
        InvokeAsync(StateHasChanged);
    }

    private void SyncActiveArtifactSelection()
    {
        var active = Projects.ActiveProject;
        var kind = active?.ActiveArtifactKind;
        var name = active?.ActiveArtifactName;
        var artifactChanged =
            !ReferenceEquals(active, _lastActiveProject) ||
            kind != _lastActiveArtifactKind ||
            !string.Equals(name, _lastActiveArtifactName, StringComparison.Ordinal);

        if (artifactChanged)
        {
            _jsonView = false;
            _dashboardEditMode = active is not { ActiveArtifactKind: WorkspaceArtifactKind.Dashboard, IsActiveDashboardLive: true };
            if (kind != WorkspaceArtifactKind.Logs)
            {
                _pendingLogQuery = null;
            }
        }

        _lastActiveProject = active;
        _lastActiveArtifactKind = kind;
        _lastActiveArtifactName = name;
    }

    private void SyncSubscriptions()
    {
        foreach (var project in Projects.Projects)
            if (_subscribed.Add(project))
                project.Changed += OnProjectChanged;

        foreach (var stale in _subscribed.Where(p => !Projects.Projects.Contains(p)).ToList())
        {
            stale.Changed -= OnProjectChanged;
            _subscribed.Remove(stale);
        }
    }

    private async Task NewAppAsync()
    {
        var dialog = await DialogService.ShowAsync<NewAppDialog>("New App");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: NewAppDialog.NewAppResult r })
        {
            var project = Projects.NewProject();
            project.SetDisplayName(r.AppName);
            project.AddWorkflow(r.PipelineName);
            project.SetActiveWorkflow(r.PipelineName);
            var resourceKey = string.IsNullOrWhiteSpace(r.Connection.Name)
                ? "connection"
                : r.Connection.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            project.UpsertConnectionResource(resourceKey, r.Connection);
            Live.AddConnectionIfAbsent(r.Connection, r.Subscription, resourceKey);
        }
    }

    private async Task OpenFileAsync()
    {
        var result = await FilePicker.Default.PickAsync(new PickOptions
        {
            PickerTitle = "Open FluxMQ Project",
            FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, [".json"] },
                { DevicePlatform.macOS, ["json", "public.json"] }
            })
        });
        if (result is not null)
        {
            var project = await Projects.OpenAsync(result.FullPath);
            foreach (var (name, profile, sub) in project.GetConnectionResources())
                Live.AddConnectionIfAbsent(profile, sub, name);
        }
    }

    private async Task OpenStartupFileAsync()
    {
        var path = ResolveStartupFilePath();
        if (path is null || Projects.ActiveProject is not null)
        {
            return;
        }

        try
        {
            var project = await Projects.OpenAsync(path);
            foreach (var (name, profile, sub) in project.GetConnectionResources())
                Live.AddConnectionIfAbsent(profile, sub, name);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Startup project open failed: {exception.Message}");
        }
    }

    private static string? ResolveStartupFilePath()
    {
        var args = Environment.GetCommandLineArgs().Skip(1).ToArray();
        for (var i = 0; i < args.Length; i++)
        {
            var arg = args[i];
            if (string.Equals(arg, "--open", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(arg, "--project", StringComparison.OrdinalIgnoreCase))
            {
                if (i + 1 < args.Length && ExistingJsonFile(args[i + 1]) is { } explicitPath)
                {
                    return explicitPath;
                }

                continue;
            }

            if (ExistingJsonFile(arg) is { } path)
            {
                return path;
            }
        }

        return null;
    }

    private static string? ExistingJsonFile(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var path = value.Trim().Trim('"');
        return path.EndsWith(".json", StringComparison.OrdinalIgnoreCase) && File.Exists(path)
            ? Path.GetFullPath(path)
            : null;
    }

    private async Task CloseActiveAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;
        _jsonView = false;
        await Projects.CloseProjectAsync(active);
    }

    private async Task AddWorkflowAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        var dialog = await DialogService.ShowAsync<NewPipelineDialog>("New Pipeline");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            active.AddWorkflow(name.Trim());
            active.SetActiveWorkflow(name.Trim());
            _jsonView = false;
        }
    }

    private async Task AddDashboardAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Dashboard",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Dashboard"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            active.AddDashboard(name.Trim());
            _jsonView = false;
        }
    }

    private async Task AddMetricAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Metric",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Metric"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            active.AddMetric(name.Trim());
            active.SetActiveMetrics();
            _jsonView = false;
        }
    }

    private async Task AddTestAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Test",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Test"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            active.AddTest(name.Trim());
            _jsonView = false;
        }
    }

    private void SelectLogs()
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        _pendingLogQuery = null;
        active.SetActiveLogs();
        _jsonView = false;
    }

    private void OpenLogs(WorkspaceLogQuery query)
    {
        var active = Projects.ActiveProject;
        if (active is null) return;

        _pendingLogQuery = query;
        active.SetActiveLogs();
        _jsonView = false;
    }

    private void ToggleJsonView()
    {
        if (_jsonView)
        {
            CloseJsonView();
            return;
        }

        OpenJsonView();
    }

    private void OpenJsonView()
    {
        SyncActiveArtifactSelection();
        _jsonView = true;
    }

    private void CloseJsonView()
    {
        _jsonView = false;
        SyncActiveArtifactSelection();
    }

    private static string? WorkspaceTabCurrent(bool isActive)
        => isActive ? "true" : null;

    private static bool IsActivationKey(KeyboardEventArgs args)
        => args.Key is "Enter" or " " or "Spacebar";

    private static Task RunFromKeyboardAsync(KeyboardEventArgs args, Action action)
    {
        if (IsActivationKey(args))
        {
            action();
        }

        return Task.CompletedTask;
    }

    private async Task RemoveWorkflowAsync(string name)
    {
        var active = Projects.ActiveProject;
        if (active is null || !await ConfirmDeleteAsync("pipeline", name)) return;

        active.RemoveWorkflow(name);
        _jsonView = false;
    }

    private async Task RemoveDashboardAsync(string name)
    {
        var active = Projects.ActiveProject;
        if (active is null || !await ConfirmDeleteAsync("dashboard", name)) return;

        active.RemoveDashboard(name);
        _jsonView = false;
    }

    private async Task RemoveTestAsync(string name)
    {
        var active = Projects.ActiveProject;
        if (active is null || !await ConfirmDeleteAsync("test", name)) return;

        active.RemoveTest(name);
        _jsonView = false;
    }

    private async Task<bool> ConfirmDeleteAsync(string artifactKind, string name)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete {artifactKind}",
            $"Delete {artifactKind} '{name}'? This cannot be undone.",
            "Delete",
            null,
            "Cancel",
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        return confirmed == true;
    }

    private void OnDashboardEditModeChanged(bool isEditMode)
    {
        if (_dashboardEditMode != isEditMode)
        {
            _dashboardEditMode = isEditMode;
        }

        if (Projects.ActiveProject is { ActiveArtifactKind: WorkspaceArtifactKind.Dashboard } active)
        {
            active.SetActiveDashboardLive(!isEditMode);
        }
    }

    public void Dispose()
    {
        Projects.Changed -= OnProjectsChanged;
        foreach (var project in _subscribed)
            project.Changed -= OnProjectChanged;
        _subscribed.Clear();
    }
}

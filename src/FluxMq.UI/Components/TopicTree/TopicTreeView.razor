@implements IDisposable
@inject ITopicIndex TopicIndex

<div class="topic-tree-view">

    <MudTextField T="string"
                  @bind-Value="_filter"
                  Placeholder="Filter topics…"
                  Immediate="true"
                  Clearable="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-2" />

    <div class="topic-tree-nodes">
        @if (string.IsNullOrWhiteSpace(_filter))
        {
            var roots = Roots.OrderBy(n => n.Name).ToList();
            @if (roots.Count == 0)
            {
                <EmptyView Message="@EmptyMessage" Content="@EmptyContent" />
            }
            else
            {
                @foreach (var root in roots)
                {
                    <TopicTreeNode Node="root"
                                   SelectedTopic="@SelectedTopic"
                                   TopicSelected="@TopicSelected" />
                }
            }
        }
        else
        {
            var results = SearchResults.OrderBy(n => n.FullPath).ToList();
            @if (results.Count == 0)
            {
                <EmptyView Message="No topics match your filter" />
            }
            else
            {
                @foreach (var node in results)
                {
                    <div class="topic-node-flat @(node.FullPath == SelectedTopic ? "topic-node-selected" : null)"
                         @onclick="@(() => TopicSelected.InvokeAsync(node.FullPath))">
                        <MudText Typo="Typo.body2" Class="topic-path">@node.FullPath</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@node.MessageCount</MudChip>
                        @if (node.LastActivity != default)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                                @node.LastActivity.ToLocalTime().ToString("HH:mm:ss.fff")
                            </MudText>
                        }
                    </div>
                }
            }
        }
    </div>

</div>

@code {
    [Parameter] public IReadOnlyList<MqttEnvelope>? Messages { get; set; }
    [Parameter] public string? SelectedTopic { get; set; }
    [Parameter] public EventCallback<string?> TopicSelected { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    private string _filter = string.Empty;
    private volatile bool _pendingUpdate;
    private Timer? _refreshTimer;
    private ITopicIndex? _localTopicIndex;

    private IReadOnlyCollection<TopicNode> Roots => ActiveTopicIndex.Roots.Values.ToArray();
    private IEnumerable<TopicNode> SearchResults => ActiveTopicIndex.Search(_filter);
    private ITopicIndex ActiveTopicIndex => _localTopicIndex ?? TopicIndex;

    protected override void OnInitialized()
    {
        TopicIndex.Changed += OnIndexChanged;

        // Throttle UI refreshes — at most once per 250 ms
        _refreshTimer = new Timer(_ =>
        {
            if (!_pendingUpdate) return;
            _pendingUpdate = false;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromMilliseconds(250), TimeSpan.FromMilliseconds(250));
    }

    protected override void OnParametersSet()
    {
        if (Messages is null)
        {
            _localTopicIndex = null;
            return;
        }

        var index = new TopicIndex();
        foreach (var message in Messages)
        {
            index.Process(message);
        }

        _localTopicIndex = index;
    }

    private void OnIndexChanged(object? sender, EventArgs e) => _pendingUpdate = true;

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        TopicIndex.Changed -= OnIndexChanged;
    }
}

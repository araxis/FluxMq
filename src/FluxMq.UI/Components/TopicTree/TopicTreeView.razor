@implements IDisposable
@inject ITopicIndex TopicIndex

<div class="topic-tree-view @(Compact ? "compact" : null)">

    <div class="topic-tree-nodes" role="tree" aria-label="Topics">
        @if (string.IsNullOrWhiteSpace(Filter))
        {
            var roots = Roots.OrderBy(n => n.Name).ToList();
            @if (roots.Count == 0)
            {
                <EmptyView Message="@EmptyMessage" Content="@EmptyContent" />
            }
            else
            {
                @foreach (var root in roots)
                {
                    <TopicTreeNode Node="root"
                                   SelectedTopic="@SelectedTopic"
                                   TopicSelected="@TopicSelected"
                                   Compact="@Compact" />
                }
            }
        }
        else
        {
            var results = SearchResults.OrderBy(n => n.FullPath).ToList();
            @if (results.Count == 0)
            {
                <div class="topic-tree-empty">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Small" aria-hidden="true" />
                    <strong>No matching topics</strong>
                    <span>Clear or change the search text.</span>
                </div>
            }
            else
            {
                @foreach (var node in results)
                {
                    <div class="topic-node-flat @(node.FullPath == SelectedTopic ? "topic-node-selected" : null)"
                         title="@node.FullPath"
                         role="treeitem"
                         tabindex="0"
                         aria-label="@node.FullPath"
                         aria-level="@TopicNodeLevel(node)"
                         aria-selected="@TopicNodeSelected(node)"
                         @onkeydown="@((KeyboardEventArgs args) => SelectTopicFromKeyboardAsync(args, node.FullPath))"
                         @onclick="@(() => TopicSelected.InvokeAsync(node.FullPath))">
                        <span class="topic-node-flat-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Topic" Size="Size.Small" aria-hidden="true" />
                        </span>
                        <MudText Typo="Typo.body2" Class="topic-path">@node.FullPath</MudText>
                        <span class="topic-node-count">@node.MessageCount</span>
                        @if (!Compact && node.LastActivity != default)
                        {
                            <span class="topic-node-time">
                                @node.LastActivity.ToLocalTime().ToString("HH:mm:ss.fff")
                            </span>
                        }
                    </div>
                }
            }
        }
    </div>

</div>

@code {
    [Parameter] public IReadOnlyList<MqttEnvelope>? Messages { get; set; }
    [Parameter] public string? SelectedTopic { get; set; }
    [Parameter] public EventCallback<string?> TopicSelected { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public string Filter { get; set; } = string.Empty;
    [Parameter] public bool Compact { get; set; }

    private volatile bool _pendingUpdate;
    private Timer? _refreshTimer;
    private ITopicIndex? _localTopicIndex;

    private IReadOnlyCollection<TopicNode> Roots => ActiveTopicIndex.Roots.Values.ToArray();
    private IEnumerable<TopicNode> SearchResults => ActiveTopicIndex.Search(Filter);
    private ITopicIndex ActiveTopicIndex => _localTopicIndex ?? TopicIndex;

    protected override void OnInitialized()
    {
        TopicIndex.Changed += OnIndexChanged;

        // Throttle UI refreshes — at most once per 250 ms
        _refreshTimer = new Timer(_ =>
        {
            if (!_pendingUpdate) return;
            _pendingUpdate = false;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromMilliseconds(250), TimeSpan.FromMilliseconds(250));
    }

    protected override void OnParametersSet()
    {
        if (Messages is null)
        {
            _localTopicIndex = null;
            return;
        }

        var index = new TopicIndex();
        foreach (var message in Messages)
        {
            index.Process(message);
        }

        _localTopicIndex = index;
    }

    private void OnIndexChanged(object? sender, EventArgs e) => _pendingUpdate = true;
    private static int TopicNodeLevel(TopicNode node) => node.Depth + 1;
    private string TopicNodeSelected(TopicNode node)
        => string.Equals(node.FullPath, SelectedTopic, StringComparison.Ordinal) ? "true" : "false";

    private static bool IsActivationKey(KeyboardEventArgs args)
        => args.Key is "Enter" or " " or "Spacebar";

    private Task SelectTopicFromKeyboardAsync(KeyboardEventArgs args, string? topic)
        => IsActivationKey(args) ? TopicSelected.InvokeAsync(topic) : Task.CompletedTask;

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        TopicIndex.Changed -= OnIndexChanged;
    }
}

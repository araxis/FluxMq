@* Recursive component — renders one TopicNode and its children when expanded. *@

<div class="topic-node @(Compact ? "compact" : null)" style="@($"--topic-depth:{Node.Depth};")">

    <div class="topic-node-row @(Node.FullPath == SelectedTopic ? "topic-node-selected" : null)"
         title="@Node.FullPath"
         role="treeitem"
         tabindex="0"
         aria-label="@Node.FullPath"
         aria-level="@TopicNodeLevel()"
         aria-selected="@TopicNodeSelected()"
         @onkeydown="SelectFromKeyboardAsync"
         @onclick="Select">
        <span class="topic-node-branch" aria-hidden="true"></span>

        @if (Node.HasChildren)
        {
            <button type="button"
                    class="topic-node-chevron"
                    aria-label="@TopicNodeChevronLabel()"
                    aria-expanded="@(_expanded ? "true" : "false")"
                    @onclick="Toggle"
                    @onclick:stopPropagation>
                <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                         Size="Size.Small" />
            </button>
        }
        else
        {
            <span class="topic-node-chevron topic-node-chevron-static"
                  aria-hidden="true"
                  @onclick="IgnoreChevronClick"
                  @onclick:stopPropagation>
                <span class="topic-node-chevron-placeholder"></span>
            </span>
        }

        <MudText Typo="Typo.body2" Class="topic-node-name">@Node.Name</MudText>

        <span class="topic-node-count">@Node.MessageCount</span>

        @if (!Compact && Node.LastActivity != default)
        {
            <span class="topic-node-time">
                @Node.LastActivity.ToLocalTime().ToString("HH:mm:ss.fff")
            </span>
        }

    </div>

    @if (_expanded && Node.HasChildren)
    {
        <div class="topic-node-children" role="group">
            @foreach (var child in Node.Children.Values.OrderBy(n => n.Name))
            {
                <TopicTreeNode Node="child"
                               SelectedTopic="@SelectedTopic"
                               TopicSelected="@TopicSelected"
                               Compact="@Compact" />
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public TopicNode Node { get; set; } = null!;
    [Parameter] public string? SelectedTopic { get; set; }
    [Parameter] public EventCallback<string?> TopicSelected { get; set; }
    [Parameter] public bool Compact { get; set; }

    private bool _expanded;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        _expanded = Node.Depth < 2;
        _initialized = true;
    }

    private string TopicNodeChevronLabel()
        => _expanded ? "Collapse topic branch" : "Expand topic branch";

    private int TopicNodeLevel()
        => Node.Depth + 1;

    private string TopicNodeSelected()
        => string.Equals(Node.FullPath, SelectedTopic, StringComparison.Ordinal) ? "true" : "false";

    private void Toggle() => _expanded = !_expanded;
    private static void IgnoreChevronClick() { }
    private static bool IsActivationKey(KeyboardEventArgs args)
        => args.Key is "Enter" or " " or "Spacebar";

    private Task SelectFromKeyboardAsync(KeyboardEventArgs args)
        => IsActivationKey(args) ? Select() : Task.CompletedTask;

    private Task Select() => TopicSelected.InvokeAsync(Node.FullPath);
}

@inject FlowComponentCatalog Catalog
@inject ProjectManagerService Projects
@inject DragStateService DragState

<div class="component-catalog @CatalogClass">
    <div class="catalog-title">
        <MudIcon Icon="@CatalogIcon" Size="Size.Small" Class="catalog-title-icon" />
        <span>@CatalogTitle</span>
    </div>
    @if (VisibleComponents.Count == 0)
    {
        <div class="catalog-empty">@EmptyLabel</div>
    }
    else
    {
        @foreach (var group in VisibleComponents.GroupBy(c => c.Category))
        {
            <div class="catalog-group">
                @group.Key
            </div>
            <div class="catalog-drop-zone">
                @foreach (var component in group)
                {
                    @RenderComponentCard(FlowComponentDragItem.FromPalette(component))
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public WorkspaceArtifactKind ArtifactKind { get; set; } = WorkspaceArtifactKind.Pipeline;

    private RenderFragment<FlowComponentDragItem> RenderComponentCard => dragItem =>
        @<div class="catalog-item @(!CanUseComponent ? "disabled" : null)"
              role="button"
              tabindex="@(!CanUseComponent ? "-1" : "0")"
              title="@CatalogItemTitle"
              @onpointerdown="@((PointerEventArgs args) => BeginComponentDrag(args, dragItem.Component))"
              @onkeydown="@((KeyboardEventArgs args) => AddComponentFromKeyboard(args, dragItem.Component.Type))"
              @key="dragItem.Id">
            <span class="@IconTileClass(dragItem.Component.Category)" aria-hidden="true">
                <MudIcon Icon="@IconFor(dragItem.Component)" Size="Size.Small" />
            </span>
            <span class="catalog-item-name">@dragItem.Component.DisplayName</span>
            <span class="catalog-add-button" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            </span>
        </div>;

    private IReadOnlyList<FlowComponentDescriptor> VisibleComponents => ArtifactKind switch
    {
        WorkspaceArtifactKind.Pipeline => Catalog.Components
            .Where(component => !string.Equals(component.Category, "Assertion", StringComparison.Ordinal))
            .ToArray(),
        WorkspaceArtifactKind.Test => Catalog.Components
            .Where(component => string.Equals(component.Category, "Assertion", StringComparison.Ordinal))
            .ToArray(),
        _ => Array.Empty<FlowComponentDescriptor>()
    };

    private bool CanUseComponent =>
        ArtifactKind == WorkspaceArtifactKind.Pipeline &&
        Projects.ActiveProject?.ActiveArtifactKind == WorkspaceArtifactKind.Pipeline;

    private string CatalogTitle => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "Dashboard widgets",
        WorkspaceArtifactKind.Test => "Test steps",
        _ => "Pipeline components"
    };

    private string EmptyLabel => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "No widgets",
        WorkspaceArtifactKind.Test => "No steps",
        _ => "No components"
    };

    private string CatalogClass => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "dashboard",
        WorkspaceArtifactKind.Test => "test",
        _ => "pipeline"
    };

    private string CatalogIcon => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => Icons.Material.Filled.Dashboard,
        WorkspaceArtifactKind.Test => Icons.Material.Filled.FactCheck,
        _ => Icons.Material.Filled.Extension
    };

    private string CatalogItemTitle => CanUseComponent
        ? "Drag or click to add component"
        : "Unavailable in this tab";

    private void BeginComponentDrag(PointerEventArgs args, FlowComponentDescriptor component)
    {
        if (!CanUseComponent || args.Button != 0)
        {
            return;
        }

        DragState.BeginComponentDrag(
            component.Type,
            component.DisplayName,
            args.PointerId,
            args.ClientX,
            args.ClientY);
    }

    private void AddComponentFromKeyboard(KeyboardEventArgs args, string componentType)
    {
        if (!CanUseComponent || Projects.ActiveProject is not { } active)
        {
            return;
        }

        if (args.Key is "Enter" or " ")
        {
            active.AddComponent(componentType);
        }
    }

    private static string IconFor(FlowComponentDescriptor component) => component.Category switch
    {
        "Source" => Icons.Material.Filled.Sensors,
        "Mapper" => Icons.Material.Filled.Transform,
        "Validator" => Icons.Material.Filled.FactCheck,
        "Assertion" => Icons.Material.Filled.FactCheck,
        "Observer" => Icons.Material.Filled.QueryStats,
        "Actor" => Icons.Material.Filled.PlayArrow,
        "Sink" => Icons.Material.Filled.CallMerge,
        _ => Icons.Material.Filled.Extension
    };

    private static string IconTileClass(string category) => category switch
    {
        "Source" => "catalog-icon-tile source",
        "Mapper" => "catalog-icon-tile mapper",
        "Validator" => "catalog-icon-tile validator",
        "Assertion" => "catalog-icon-tile assertion",
        "Observer" => "catalog-icon-tile observer",
        "Actor" => "catalog-icon-tile actor",
        "Sink" => "catalog-icon-tile actor",
        _ => "catalog-icon-tile"
    };
}

@inject FlowComponentCatalog Catalog
@inject DashboardWidgetRegistry DashboardWidgets
@inject ScenarioStepCatalog ScenarioSteps
@inject ProjectManagerService Projects
@inject DragStateService DragState

<div class="component-catalog @CatalogClass" aria-label="@CatalogPanelLabel">
    <div class="catalog-head">
        <div class="catalog-title">
            <span class="catalog-title-icon" aria-hidden="true">
                <MudIcon Icon="@CatalogIcon" Size="Size.Small" />
            </span>
            <span class="catalog-title-copy">
                <span class="catalog-title-label">@CatalogTitle</span>
                <span class="catalog-meta-strip" aria-label="Catalog state">
                    <span>@CatalogModeLabel</span>
                    <span class="@CatalogUseStateClass">@CatalogUseStateLabel</span>
                    <span>@CatalogSearchStateLabel</span>
                </span>
            </span>
            <span class="catalog-count" title="@CatalogCountTitle">@CatalogCountLabel</span>
        </div>
        <MudTextField T="string"
                      Value="@_searchText"
                      ValueChanged="@OnSearchTextChanged"
                      Placeholder="@SearchPlaceholder"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Secondary"
                      Class="catalog-search" />
    </div>

    <div class="catalog-list">
        @if (SearchResult.VisibleCount == 0)
        {
            <div class="catalog-empty" role="status" aria-live="polite">
                <MudIcon Icon="@EmptyIcon" Size="Size.Small" />
                <span>@EmptyLabel</span>
                <small>@EmptyHintLabel</small>
            </div>
        }
        else
        {
            @foreach (var group in SearchGroups)
            {
                <section class="catalog-section" @key="group.Category">
                    <div class="catalog-group">
                        <span>@group.Category</span>
                        <span>@group.Items.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="catalog-drop-zone" role="list">
                        @foreach (var item in group.Items)
                        {
                            @RenderCatalogItem(item)
                        }
                    </div>
                </section>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public WorkspaceArtifactKind ArtifactKind { get; set; } = WorkspaceArtifactKind.Pipeline;

    private string _searchText = string.Empty;

    private RenderFragment<CatalogEntry> RenderCatalogItem => item =>
        @<div class="@CatalogItemClass(item)"
              role="listitem"
              tabindex="@(!CanUseItem ? "-1" : "0")"
              title="@CatalogItemTitle"
              aria-label="@CatalogItemAriaLabel(item)"
              aria-grabbed="@CatalogItemGrabbed(item)"
              @onpointerdown="@((PointerEventArgs args) => BeginItemDrag(args, item))"
              @onclick="@(() => AddItem(item))"
              @onkeydown="@((KeyboardEventArgs args) => AddItemFromKeyboard(args, item))"
              @key="item.Type">
            <span class="@IconTileClass(item.Category)" aria-hidden="true">
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
            </span>
            <span class="catalog-item-main">
                <span class="catalog-item-name">@item.DisplayName</span>
                @if (ShouldShowDescription(item))
                {
                    <span class="catalog-item-description">@item.Description</span>
                }
                @if (ShouldShowRequirements(item))
                {
                    <span class="catalog-item-badges" aria-label="Widget data requirements">
                        @foreach (var requirement in item.DataRequirements.Take(3))
                        {
                            <span class="catalog-item-badge">@RequirementLabel(requirement)</span>
                        }
                    </span>
                }
                @if (ShouldShowStepMetadata(item))
                {
                    <span class="catalog-item-badges catalog-step-badges" aria-label="Test step metadata">
                        <span class="@StepPhaseBadgeClass(item)">@StepPhaseLabel(item)</span>
                        <span class="catalog-item-badge">@StepKindLabel(item)</span>
                        <span class="catalog-item-badge muted">@StepParameterLabel(item)</span>
                    </span>
                }
            </span>
            <span class="catalog-item-affordance" aria-hidden="true">
                <span class="catalog-drag-grip">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                </span>
                <span class="catalog-add-button">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                </span>
            </span>
        </div>;

    private CatalogSearchResult<CatalogEntry> SearchResult
        => CatalogSearch.Filter(AllItems, _searchText, static item => item.SearchFields);

    private IReadOnlyList<CatalogGroup> SearchGroups =>
        SearchResult.Items
            .GroupBy(static item => item.Category)
            .Select(static group => new CatalogGroup(
                group.Key,
                group.OrderBy(static item => item.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray()))
            .ToArray();

    private IReadOnlyList<CatalogEntry> AllItems => ArtifactKind switch
    {
        WorkspaceArtifactKind.Pipeline => Catalog.Components
            .Where(component => !string.Equals(component.Category, "Assertion", StringComparison.Ordinal))
            .Select(CatalogEntry.FromComponent)
            .ToArray(),
        WorkspaceArtifactKind.Dashboard => DashboardWidgets.Widgets
            .Select(CatalogEntry.FromWidget)
            .ToArray(),
        WorkspaceArtifactKind.Test => ScenarioSteps.Steps
            .Select(CatalogEntry.FromStep)
            .ToArray(),
        _ => Array.Empty<CatalogEntry>()
    };

    private bool CanUseItem => ArtifactKind switch
    {
        WorkspaceArtifactKind.Pipeline => Projects.ActiveProject?.ActiveArtifactKind == WorkspaceArtifactKind.Pipeline,
        WorkspaceArtifactKind.Dashboard => Projects.ActiveProject?.ActiveArtifactKind == WorkspaceArtifactKind.Dashboard,
        WorkspaceArtifactKind.Test => Projects.ActiveProject?.ActiveArtifactKind == WorkspaceArtifactKind.Test,
        _ => false
    };

    private string CatalogTitle => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "Dashboard widgets",
        WorkspaceArtifactKind.Test => "Test steps",
        _ => "Pipeline components"
    };

    private string CatalogPanelLabel
        => $"{CatalogTitle} catalog";

    private string CatalogModeLabel => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "Dashboard",
        WorkspaceArtifactKind.Test => "Test",
        _ => "Pipeline"
    };

    private string CatalogUseStateLabel
        => CanUseItem ? "Ready" : "Inactive tab";

    private string CatalogUseStateClass
        => CanUseItem ? "catalog-use-state ready" : "catalog-use-state inactive";

    private string CatalogSearchStateLabel
        => SearchResult.HasSearch ? "Filtered" : "All";

    private string EmptyLabel => HasSearch
        ? $"No matches for \"{_searchText.Trim()}\""
        : ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "No widgets",
        WorkspaceArtifactKind.Test => "No steps",
        _ => "No components"
    };

    private string SearchPlaceholder => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "Search widgets",
        WorkspaceArtifactKind.Test => "Search steps",
        _ => "Search components"
    };

    private string CatalogClass => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => "dashboard",
        WorkspaceArtifactKind.Test => "test",
        _ => "pipeline"
    };

    private string CatalogIcon => ArtifactKind switch
    {
        WorkspaceArtifactKind.Dashboard => Icons.Material.Filled.Dashboard,
        WorkspaceArtifactKind.Test => Icons.Material.Filled.FactCheck,
        _ => Icons.Material.Filled.Extension
    };

    private string CatalogCountLabel => SearchResult.HasSearch
        ? $"{SearchResult.VisibleCount} of {SearchResult.TotalCount}"
        : SearchResult.TotalCount.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string CatalogCountTitle => SearchResult.HasSearch
        ? $"{SearchResult.VisibleCount} matching items out of {SearchResult.TotalCount}"
        : $"{SearchResult.TotalCount} available items";

    private string EmptyIcon
        => HasSearch ? Icons.Material.Filled.SearchOff : CatalogIcon;

    private string EmptyHintLabel => HasSearch
        ? "Try a shorter search."
        : ArtifactKind switch
        {
            WorkspaceArtifactKind.Dashboard => "No widget definitions are available.",
            WorkspaceArtifactKind.Test => "No test step definitions are available.",
            _ => "No component definitions are available."
        };

    private string CatalogItemTitle => ArtifactKind switch
    {
        WorkspaceArtifactKind.Pipeline when CanUseItem => "Drag to add component",
        WorkspaceArtifactKind.Dashboard when CanUseItem => "Click to place in the selected cell, or drag to choose a cell",
        WorkspaceArtifactKind.Test when CanUseItem => "Add test step",
        _ => "Unavailable in this tab"
    };

    private string CatalogItemClass(CatalogEntry item)
    {
        var classes = new List<string> { "catalog-item" };
        if (!CanUseItem)
        {
            classes.Add("disabled");
        }

        if (IsDraggingItem(item))
        {
            classes.Add("dragging");
        }

        return string.Join(" ", classes);
    }

    private string CatalogItemAriaLabel(CatalogEntry item)
        => CanUseItem
            ? ArtifactKind switch
            {
                WorkspaceArtifactKind.Dashboard => $"{item.DisplayName}. Drag to a dashboard cell or press Enter to place. Use the edit action on the placed widget to configure it.",
                WorkspaceArtifactKind.Test => $"{item.DisplayName}. Press Enter to add test step.",
                _ => $"{item.DisplayName}. Drag or press Enter to add."
            }
            : $"{item.DisplayName}. Unavailable in this tab.";

    private string CatalogItemGrabbed(CatalogEntry item)
        => IsDraggingItem(item) ? "true" : "false";

    private bool HasSearch => !string.IsNullOrWhiteSpace(_searchText);

    private bool IsDraggingItem(CatalogEntry item)
        => DragState.ActiveComponentDrag is { } activeDrag &&
           string.Equals(activeDrag.ComponentType, item.Type, StringComparison.Ordinal) &&
           activeDrag.TargetKind == ArtifactKind;

    private bool ShouldShowDescription(CatalogEntry item)
        => ArtifactKind is WorkspaceArtifactKind.Dashboard or WorkspaceArtifactKind.Test &&
           !string.IsNullOrWhiteSpace(item.Description);

    private bool ShouldShowRequirements(CatalogEntry item)
        => ArtifactKind == WorkspaceArtifactKind.Dashboard && item.DataRequirements.Count > 0;

    private bool ShouldShowStepMetadata(CatalogEntry item)
        => ArtifactKind == WorkspaceArtifactKind.Test;

    private static string StepPhaseLabel(CatalogEntry item)
        => string.IsNullOrWhiteSpace(item.StepPhase) ? "phase" : item.StepPhase;

    private static string StepKindLabel(CatalogEntry item)
        => item.StepKind switch
        {
            ScenarioStepEditorKind.MqttPublish => "publish",
            ScenarioStepEditorKind.MqttTrigger => "trigger",
            ScenarioStepEditorKind.ExpectEvent => "expect",
            ScenarioStepEditorKind.Delay => "delay",
            ScenarioStepEditorKind.MetricThreshold => "metric",
            ScenarioStepEditorKind.Cleanup => "cleanup",
            _ => "step"
        };

    private static string StepParameterLabel(CatalogEntry item)
        => item.StepParameterCount == 1 ? "1 field" : $"{item.StepParameterCount} fields";

    private static string StepPhaseBadgeClass(CatalogEntry item)
        => StepPhaseLabel(item).ToLowerInvariant() switch
        {
            "setup" => "catalog-item-badge setup",
            "stimulus" => "catalog-item-badge stimulus",
            "observe" => "catalog-item-badge observe",
            "assert" => "catalog-item-badge assert",
            "cleanup" => "catalog-item-badge cleanup",
            _ => "catalog-item-badge"
        };

    private void OnSearchTextChanged(string? value)
        => _searchText = value ?? string.Empty;

    private void BeginItemDrag(PointerEventArgs args, CatalogEntry item)
    {
        if (ArtifactKind is not (WorkspaceArtifactKind.Pipeline or WorkspaceArtifactKind.Dashboard or WorkspaceArtifactKind.Test) ||
            !CanUseItem ||
            args.Button != 0)
        {
            return;
        }

        DragState.BeginComponentDrag(
            item.Type,
            item.DisplayName,
            args.PointerId,
            args.ClientX,
            args.ClientY,
            ArtifactKind);
    }

    private void AddItem(CatalogEntry item)
    {
        if (!CanUseItem || Projects.ActiveProject is not { } active || DragState.ActiveComponentDrag is not null)
        {
            return;
        }

        if (ArtifactKind == WorkspaceArtifactKind.Dashboard)
        {
            active.AddDashboardWidget(item.Type);
        }
        else if (ArtifactKind == WorkspaceArtifactKind.Test)
        {
            active.AddTestScenarioStep(item.Type);
        }
    }

    private void AddItemFromKeyboard(KeyboardEventArgs args, CatalogEntry item)
    {
        if (!CanUseItem || Projects.ActiveProject is not { } active)
        {
            return;
        }

        if (args.Key is "Enter" or " ")
        {
            if (ArtifactKind == WorkspaceArtifactKind.Pipeline)
            {
                active.AddComponent(item.Type);
            }
            else if (ArtifactKind == WorkspaceArtifactKind.Dashboard)
            {
                active.AddDashboardWidget(item.Type);
            }
            else if (ArtifactKind == WorkspaceArtifactKind.Test)
            {
                active.AddTestScenarioStep(item.Type);
            }
        }
    }

    private static string IconFor(FlowComponentDescriptor component) => component.Category switch
    {
        "Source" => Icons.Material.Filled.Sensors,
        "Mapper" => Icons.Material.Filled.Transform,
        "Transform" => Icons.Material.Filled.Transform,
        "Control" => Icons.Material.Filled.AccountTree,
        "Validator" => Icons.Material.Filled.FactCheck,
        "Assertion" => Icons.Material.Filled.FactCheck,
        "Observer" => Icons.Material.Filled.QueryStats,
        "Actor" => Icons.Material.Filled.PlayArrow,
        "Sink" => Icons.Material.Filled.CallMerge,
        _ => Icons.Material.Filled.Extension
    };

    private static string IconTileClass(string category) => category switch
    {
        "Source" => "catalog-icon-tile source",
        "Mapper" => "catalog-icon-tile mapper",
        "Transform" => "catalog-icon-tile mapper",
        "Control" => "catalog-icon-tile control",
        "Validator" => "catalog-icon-tile validator",
        "Assertion" => "catalog-icon-tile assertion",
        "Observer" => "catalog-icon-tile observer",
        "Actor" => "catalog-icon-tile actor",
        "Sink" => "catalog-icon-tile actor",
        "Events" => "catalog-icon-tile dashboard",
        "Action" => "catalog-icon-tile actor",
        "Expectation" => "catalog-icon-tile assertion",
        _ => "catalog-icon-tile"
    };

    private sealed record CatalogEntry(
        string Type,
        string DisplayName,
        string Category,
        string Description,
        string Icon,
        IReadOnlyList<string>? DataRequirements = null,
        ScenarioStepEditorKind? StepKind = null,
        string? StepPhase = null,
        int StepParameterCount = 0)
    {
        public IReadOnlyList<string> DataRequirements { get; init; } = DataRequirements ?? [];

        public CatalogSearchFields SearchFields => new(Type, DisplayName, Category, Description);

        public static CatalogEntry FromComponent(FlowComponentDescriptor descriptor)
            => new(
                descriptor.Type,
                descriptor.DisplayName,
                descriptor.Category,
                descriptor.Summary,
                IconFor(descriptor),
                []);

        public static CatalogEntry FromWidget(DashboardWidgetDescriptor descriptor)
            => new(
                descriptor.Type,
                descriptor.DisplayName,
                descriptor.Category,
                descriptor.Description,
                descriptor.Icon,
                descriptor.DataRequirements);

        public static CatalogEntry FromStep(ScenarioStepDescriptor descriptor)
            => new(
                descriptor.Type,
                descriptor.DisplayName,
                descriptor.Category,
                descriptor.Description,
                descriptor.Icon,
                [],
                descriptor.EditorKind,
                descriptor.DefaultPhase,
                descriptor.Fields.Count);
    }

    private sealed record CatalogGroup(string Category, IReadOnlyList<CatalogEntry> Items);

    private static string RequirementLabel(string requirement)
        => requirement switch
        {
            "runtimeEvents" => "Events",
            "topicProjection" => "Topics",
            "mqttAttributes" => "MQTT",
            "mqttSnapshots" => "MQTT",
            "payload" => "Payload",
            _ => requirement
        };
}

@namespace FluxMq.UI.Components.Workspace
@using FluxMq.UI.Services

@{
    var metric = Context.MetricValue;
    var showUnit = !string.IsNullOrWhiteSpace(metric.Unit) &&
        !string.Equals(metric.Unit, "bytes", StringComparison.Ordinal);
    var showHeader = ShowTitle || ShowSubtitle;
}

<div class="dashboard-metric-value-visual" style="@RootStyle">
    @if (showHeader)
    {
        <div class="dashboard-metric-value-titlebar">
            <div class="dashboard-widget-icon">
                <MudIcon Icon="@DashboardWidgetFormatting.WidgetIcon(Context.Widget)" Size="Size.Small" />
            </div>
            <div class="dashboard-metric-value-title-block">
                @if (ShowTitle)
                {
                    <span class="dashboard-widget-title">@Title</span>
                }
                @if (ShowSubtitle)
                {
                    <span class="dashboard-widget-subtitle">@Subtitle</span>
                }
            </div>
        </div>
    }
    <div class="dashboard-metric-value-layout">
        <div class="dashboard-metric-value-block">
            <div class="dashboard-widget-value">@metric.FormattedValue</div>
            @if (showUnit)
            {
                <div class="dashboard-metric-value-unit">@metric.Unit</div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DashboardWidgetRenderContext Context { get; set; } = null!;

    private string Title =>
        Read(DashboardWidgetCatalog.MetricValueTitleKey) ??
        DashboardWidgetFormatting.WidgetTitle(Context.Widget);

    private string Subtitle =>
        Read(DashboardWidgetCatalog.MetricValueSubtitleKey) ??
        DashboardWidgetFormatting.WidgetSubtitle(Context.Widget);

    private bool ShowTitle => ReadBool(DashboardWidgetCatalog.MetricValueShowTitleKey, true);

    private bool ShowSubtitle => ReadBool(DashboardWidgetCatalog.MetricValueShowSubtitleKey, true);

    private string RootStyle
    {
        get
        {
            var parts = new List<string>();
            Add(parts, "--dashboard-widget-title", Read(DashboardWidgetCatalog.MetricValueTitleColorKey) ?? Read(DashboardWidgetCatalog.KpiTitleColorKey));
            Add(parts, "--dashboard-widget-subtitle", Read(DashboardWidgetCatalog.MetricValueSubtitleColorKey) ?? Read(DashboardWidgetCatalog.KpiSubtitleColorKey));
            Add(parts, "--dashboard-widget-value", Read(DashboardWidgetCatalog.MetricValueValueColorKey) ?? Read(DashboardWidgetCatalog.KpiValueColorKey));
            Add(parts, "--dashboard-kpi-title-align", DashboardWidgetCatalog.NormalizeKpiHorizontalAlignment(Read(DashboardWidgetCatalog.MetricValueTitleAlignKey) ?? Read(DashboardWidgetCatalog.KpiTitleAlignKey)));
            Add(parts, "--dashboard-kpi-title-items", HorizontalAlignmentCss(Read(DashboardWidgetCatalog.MetricValueTitleAlignKey) ?? Read(DashboardWidgetCatalog.KpiTitleAlignKey)));
            Add(parts, "--dashboard-kpi-value-align", DashboardWidgetCatalog.NormalizeKpiHorizontalAlignment(Read(DashboardWidgetCatalog.MetricValueValueAlignKey) ?? Read(DashboardWidgetCatalog.KpiValueAlignKey)));
            Add(parts, "--dashboard-kpi-value-items", HorizontalAlignmentCss(Read(DashboardWidgetCatalog.MetricValueValueAlignKey) ?? Read(DashboardWidgetCatalog.KpiValueAlignKey)));
            Add(parts, "--dashboard-kpi-value-placement", ValuePlacementCss(Read(DashboardWidgetCatalog.MetricValueValuePlacementKey) ?? Read(DashboardWidgetCatalog.KpiValuePlacementKey)));
            return string.Join(string.Empty, parts);
        }
    }

    private string? Read(string key) => Context.Widget.ReadString(key);

    private bool ReadBool(string key, bool fallback)
        => bool.TryParse(Context.Widget.ReadString(key), out var parsed) ? parsed : fallback;

    private static void Add(List<string> parts, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            parts.Add($"{name}:{value.Trim()};");
        }
    }

    private static string HorizontalAlignmentCss(string? value)
        => DashboardWidgetCatalog.NormalizeKpiHorizontalAlignment(value) switch
        {
            DashboardWidgetCatalog.KpiAlignCenter => "center",
            DashboardWidgetCatalog.KpiAlignRight => "flex-end",
            _ => "flex-start"
        };

    private static string ValuePlacementCss(string? value)
        => DashboardWidgetCatalog.NormalizeKpiValuePlacement(value) switch
        {
            DashboardWidgetCatalog.KpiValuePlacementMiddle => "center",
            DashboardWidgetCatalog.KpiValuePlacementBottom => "flex-end",
            _ => "flex-start"
        };
}

@namespace FluxMq.UI.Components.Workspace

@{
    var chartType = DashboardWidgetCatalog.NormalizeChartType(Widget.ReadString(DashboardWidgetCatalog.ChartTypeKey));
}

<div class="dashboard-widget-chart">
    @if (chartType == DashboardWidgetCatalog.ChartTypeLine ||
         chartType == DashboardWidgetCatalog.ChartTypeArea)
    {
        <svg class="dashboard-widget-chart-line @chartType"
             viewBox="0 0 100 44"
             preserveAspectRatio="none"
             aria-hidden="true">
            @if (chartType == DashboardWidgetCatalog.ChartTypeArea)
            {
                <polygon points="@DashboardWidgetFormatting.ChartAreaPoints(Snapshot)" />
            }
            <polyline points="@DashboardWidgetFormatting.ChartLinePoints(Snapshot)" />
        </svg>
    }
    else
    {
        <DashboardBucketBars Snapshot="@Snapshot" />
    }
    <div class="dashboard-widget-meta">@DashboardWidgetFormatting.RateMeta(Snapshot)</div>
</div>

@code {
    [Parameter, EditorRequired]
    public DashboardWidgetSnapshot Widget { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardEventSnapshot Snapshot { get; set; } = null!;
}

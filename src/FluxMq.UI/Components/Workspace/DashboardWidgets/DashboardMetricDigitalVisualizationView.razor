@namespace FluxMq.UI.Components.Workspace
@using FluxMq.UI.Services

@{
    var metric = Context.MetricValue;
    var label = Label;
}

<div class="@RootClass" style="@RootStyle">
    <DashboardDigitalReadout Value="@DigitalValue(metric.Value)"
                             Label="@label"
                             ShowLabel="@ShowLabel"
                             LabelPlacement="@LabelPlacement"
                             AccentColor="@Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.SegmentColorKey)"
                             BackgroundColor="@Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.BackgroundColorKey)"
                             InactiveSegmentColor="@Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.InactiveSegmentColorKey)"
                             LabelColor="@Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.LabelColorKey)"
                             BorderColor="@Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.BorderColorKey)"
                             BorderWidth="@ReadInt(DashboardMetricDigitalVisualizationOptions.BorderWidthKey, DashboardMetricDigitalVisualizationOptions.DefaultBorderWidth)"
                             Radius="@ReadInt(DashboardMetricDigitalVisualizationOptions.RadiusKey, DashboardMetricDigitalVisualizationOptions.DefaultRadius)"
                             Padding="@ReadInt(DashboardMetricDigitalVisualizationOptions.PaddingKey, DashboardMetricDigitalVisualizationOptions.DefaultPadding)"
                             FitMode="@FitMode"
                             StyleKind="@DigitalStyle"
                             Glow="@DigitalGlow"
                             MinimumDigits="@MinimumDigits" />
</div>

@code {
    [Parameter, EditorRequired]
    public DashboardWidgetRenderContext Context { get; set; } = null!;

    private string RootClass =>
        "dashboard-metric-digital-layout";

    private string RootStyle
    {
        get
        {
            var alignment = Read(DashboardMetricDigitalVisualizationOptions.AlignKey);
            var placement = Read(DashboardMetricDigitalVisualizationOptions.PlacementKey);
            return string.Join(
                string.Empty,
                $"--dashboard-kpi-value-align:{DashboardMetricDigitalVisualizationOptions.NormalizeAlignment(alignment)};",
                $"--dashboard-kpi-value-items:{HorizontalAlignmentCss(alignment)};",
                $"--dashboard-kpi-value-placement:{PlacementCss(placement)};");
        }
    }

    private string Label =>
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.LabelKey) ??
        Context.Widget.ReadString("title") ??
        DashboardWidgetFormatting.WidgetTitle(Context.Widget);

    private bool ShowLabel =>
        !string.Equals(
            LabelPlacement,
            DashboardMetricDigitalVisualizationOptions.LabelPlacementHidden,
            StringComparison.Ordinal) &&
        !string.Equals(
            Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.ShowLabelKey),
            "false",
            StringComparison.OrdinalIgnoreCase);

    private string LabelPlacement => DashboardMetricDigitalVisualizationOptions.NormalizeLabelPlacement(
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.LabelPlacementKey));

    private string DigitalStyle => DashboardMetricDigitalVisualizationOptions.NormalizeStyle(
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.StyleKey));

    private string DigitalGlow => DashboardMetricDigitalVisualizationOptions.NormalizeGlow(
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.GlowKey));

    private int MinimumDigits => DashboardMetricDigitalVisualizationOptions.NormalizeDigits(
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.DigitsKey));

    private string FitMode => DashboardMetricDigitalVisualizationOptions.NormalizeFitMode(
        Context.Widget.ReadString(DashboardMetricDigitalVisualizationOptions.FitModeKey));

    private string? Read(string key) => Context.Widget.ReadString(key);

    private int ReadInt(string key, int fallback)
        => int.TryParse(
            Context.Widget.ReadString(key),
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out var value)
                ? value
                : fallback;

    private static string DigitalValue(double value)
        => Math.Abs(value % 1) < 0.001
            ? value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
            : value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string HorizontalAlignmentCss(string? value)
        => DashboardMetricDigitalVisualizationOptions.NormalizeAlignment(value) switch
        {
            DashboardMetricDigitalVisualizationOptions.AlignLeft => "flex-start",
            DashboardMetricDigitalVisualizationOptions.AlignRight => "flex-end",
            _ => "center"
        };

    private static string PlacementCss(string? value)
        => DashboardMetricDigitalVisualizationOptions.NormalizePlacement(value) switch
        {
            DashboardMetricDigitalVisualizationOptions.PlacementTop => "flex-start",
            DashboardMetricDigitalVisualizationOptions.PlacementBottom => "flex-end",
            _ => "center"
        };
}

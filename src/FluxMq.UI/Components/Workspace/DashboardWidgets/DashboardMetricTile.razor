@namespace FluxMq.UI.Components.Workspace

<div class="dashboard-metric-tile @Card.CssClass">
    <MudIcon Icon="@Card.Icon" Size="Size.Small" />
    <span class="dashboard-metric-value">@Card.Value</span>
    <span class="dashboard-metric-label">@Card.Label</span>
</div>

@code {
    [Parameter, EditorRequired]
    public DashboardMetricDisplayCard Card { get; set; } = null!;
}

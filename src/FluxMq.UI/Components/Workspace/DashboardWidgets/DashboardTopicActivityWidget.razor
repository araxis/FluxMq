@namespace FluxMq.UI.Components.Workspace

@{
    var widget = Context.Widget;
    var bars = DashboardWidgetFormatting.TopicBars(Context.Snapshot, Limit(widget));
    var showCounts = ShowCounts(widget);
}

<div class="dashboard-topic-activity-visual" style="@VisualStyle(widget)">
    @if (ShowHeader(widget))
    {
        <div class="dashboard-topic-activity-header">
            <div class="dashboard-widget-icon" aria-hidden="true">
                <MudIcon Icon="@DashboardWidgetFormatting.WidgetIcon(widget)" Size="Size.Small" />
            </div>
            <div class="dashboard-widget-title-block">
                <span class="dashboard-widget-title">@Header(widget)</span>
                <span class="dashboard-widget-subtitle">@DashboardWidgetFormatting.EventFilterSummary(widget)</span>
            </div>
        </div>
    }

    @if (bars.Count == 0)
    {
        <div class="dashboard-widget-empty">@EmptyText(widget)</div>
    }
    else
    {
        <div class="dashboard-topic-activity">
            @foreach (var topic in bars)
            {
                <div class="dashboard-topic-activity-cell"
                     style="@HeatStyle(topic)"
                     title="@Tooltip(topic)">
                    <span>@DashboardWidgetFormatting.TrimTopic(topic.Topic)</span>
                    @if (showCounts)
                    {
                        <strong>@DashboardWidgetFormatting.FormatNumber(topic.Count)</strong>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public DashboardWidgetRenderContext Context { get; set; } = null!;

    private static string Header(DashboardWidgetSnapshot widget)
        => widget.ReadString(DashboardTopicActivityVisualOptions.HeaderKey) ??
           widget.ReadString("title") ??
           DashboardTopicActivityVisualOptions.DefaultHeader;

    private static string EmptyText(DashboardWidgetSnapshot widget)
        => widget.ReadString(DashboardTopicActivityVisualOptions.EmptyTextKey) ??
           DashboardTopicActivityVisualOptions.DefaultEmptyText;

    private static bool ShowHeader(DashboardWidgetSnapshot widget)
        => ReadBoolean(widget, DashboardTopicActivityVisualOptions.ShowHeaderKey, true);

    private static bool ShowCounts(DashboardWidgetSnapshot widget)
        => ReadBoolean(widget, DashboardTopicActivityVisualOptions.ShowCountsKey, true);

    private static int Limit(DashboardWidgetSnapshot widget)
        => DashboardTopicActivityVisualOptions.NormalizeLimit(
            widget.ReadString(DashboardTopicActivityVisualOptions.LimitKey) ??
            widget.ReadString("limit"));

    private static string VisualStyle(DashboardWidgetSnapshot widget)
    {
        var header = widget.ReadString(DashboardTopicActivityVisualOptions.HeaderColorKey) ??
            DashboardTopicActivityVisualOptions.DefaultHeaderColor;
        var text = widget.ReadString(DashboardTopicActivityVisualOptions.TextColorKey) ??
            DashboardTopicActivityVisualOptions.DefaultTextColor;
        var muted = widget.ReadString(DashboardTopicActivityVisualOptions.MutedColorKey) ??
            DashboardTopicActivityVisualOptions.DefaultMutedColor;
        var accent = widget.ReadString(DashboardTopicActivityVisualOptions.AccentColorKey) ??
            DashboardTopicActivityVisualOptions.DefaultAccentColor;
        return $"--topic-activity-header-color:{header};--topic-activity-text-color:{text};--topic-activity-muted-color:{muted};--topic-activity-accent-color:{accent};";
    }

    private static string Tooltip(DashboardTopicBar topic)
        => $"{topic.Topic} / {topic.Count} events";

    private static string HeatStyle(DashboardTopicBar topic)
    {
        var width = topic.Style.StartsWith("width:", StringComparison.Ordinal)
            ? topic.Style["width:".Length..].TrimEnd(';')
            : "10%";
        return $"--topic-heat:{width};";
    }

    private static bool ReadBoolean(DashboardWidgetSnapshot widget, string key, bool fallback)
        => bool.TryParse(widget.ReadString(key), out var parsed)
            ? parsed
            : fallback;
}

@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="connections-panel" aria-label="@ConnectionsPanelLabel">
    <div class="connections-head">
        <div class="connections-title">
            <span class="connections-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" aria-hidden="true" />
            </span>
            <div class="connections-title-copy">
                <strong>Connections</strong>
                <span>@ConnectionCountLabel</span>
            </div>
        </div>
        <MudTooltip Text="@AddConnectionLabel">
            <MudIconButton Size="Size.Small"
                           Icon="@Icons.Material.Filled.Add"
                           Class="connection-add-button"
                           aria-label="@AddConnectionLabel"
                           OnClick="@AddConnectionAsync" />
        </MudTooltip>
    </div>

    @if (VisibleConnections.Count == 0)
    {
        <div class="connections-empty" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" aria-hidden="true" />
            <div>
                <div class="connections-empty-title">No connections</div>
                <div class="connections-empty-copy">Add a broker connection to start live traffic.</div>
            </div>
        </div>
    }
    else
    {
        <div class="connections-list" role="list">
            @foreach (var conn in VisibleConnections)
            {
                <div class="@ConnectionRowClass(conn)"
                     role="listitem"
                     aria-label="@ConnectionRowLabel(conn)"
                     @key="conn.Id">
                    <span class="@ConnectionDotClass(conn.State)" aria-hidden="true"></span>

                    <div class="connection-main">
                        <div class="connection-name-line">
                            <span class="connection-name">@ConnectionDisplayName(conn)</span>
                            <span class="@ConnectionMarkerClass(conn.State)" title="@ConnectionMarkerLabel(conn.State)">
                                @ConnectionMarkerLabel(conn.State)
                            </span>
                        </div>
                        <div class="connection-endpoint">@ConnectionEndpoint(conn)</div>
                        <div class="connection-meta">
                            <span>@SubscriptionLabel(conn)</span>
                            @if (conn.Profile.UseTls)
                            {
                                <span>TLS</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(conn.LastError))
                        {
                            <div class="connection-error" title="@conn.LastError">@conn.LastError</div>
                        }
                    </div>

                    <div class="connection-actions">
                        <MudTooltip Text="@PrimaryActionLabel(conn)">
                            <MudIconButton Size="Size.Small"
                                           Icon="@PrimaryActionIcon(conn)"
                                           Class="@PrimaryActionClass(conn)"
                                           aria-label="@PrimaryActionLabel(conn)"
                                           OnClick="@(() => ToggleConnectionAsync(conn))" />
                        </MudTooltip>
                        <MudTooltip Text="@RemoveLabel(conn)">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.DeleteOutline"
                                           Class="connection-remove-button"
                                           aria-label="@RemoveLabel(conn)"
                                           OnClick="@(() => RemoveAsync(conn.Id))" />
                        </MudTooltip>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Live.Changed += OnChanged;

    private IReadOnlyList<ManagedConnection> VisibleConnections => Live.Connections
        .Where(static connection => !LiveMqttWorkspaceService.IsTopicMonitorConnection(connection))
        .ToArray();

    private string ConnectionCountLabel => VisibleConnections.Count == 1
        ? "1 connection"
        : $"{VisibleConnections.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)} connections";

    private string ConnectionsPanelLabel => $"Connections, {ConnectionCountLabel}";

    private string AddConnectionLabel => VisibleConnections.Count == 0
        ? "Add first broker connection"
        : $"Add broker connection, {ConnectionCountLabel} configured";

    private async Task AddConnectionAsync()
    {
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>("New Connection", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
            Live.AddConnection(r.Profile, r.Subscription);
    }

    private Task ToggleConnectionAsync(ManagedConnection connection)
        => connection.State is MqttClientState.Disconnected or MqttClientState.Faulted
            ? ConnectAsync(connection.Id)
            : DisconnectAsync(connection.Id);

    private Task ConnectAsync(Guid id) => Live.ConnectAsync(id);
    private Task DisconnectAsync(Guid id) => Live.DisconnectAsync(id);
    private Task RemoveAsync(Guid id) => Live.RemoveConnectionAsync(id);

    private static string ConnectionRowClass(ManagedConnection connection)
        => connection.State == MqttClientState.Faulted
            ? "connection-row faulted"
            : "connection-row";

    private static string ConnectionDisplayName(ManagedConnection connection)
        => string.IsNullOrWhiteSpace(connection.ResourceName)
            ? connection.Profile.Name
            : connection.ResourceName;

    private static string ConnectionEndpoint(ManagedConnection connection)
        => $"{connection.Profile.Host}:{connection.Profile.Port.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string ConnectionRowLabel(ManagedConnection connection)
        => $"{ConnectionDisplayName(connection)}, {ConnectionEndpoint(connection)}, {ConnectionMarkerLabel(connection.State)}";

    private static string SubscriptionLabel(ManagedConnection connection)
        => string.IsNullOrWhiteSpace(connection.Subscription)
            ? "Sub #"
            : $"Sub {connection.Subscription}";

    private static string ConnectionMarkerLabel(MqttClientState state) => state switch
    {
        MqttClientState.Connected => "Connected",
        MqttClientState.Connecting => "Connecting",
        MqttClientState.Reconnecting => "Reconnecting",
        MqttClientState.Faulted => "Faulted",
        _ => "Disconnected"
    };

    private static string ConnectionMarkerClass(MqttClientState state) => state switch
    {
        MqttClientState.Connected => "connection-marker live",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "connection-marker pending",
        MqttClientState.Faulted => "connection-marker faulted",
        _ => "connection-marker"
    };

    private static string ConnectionDotClass(MqttClientState state) => state switch
    {
        MqttClientState.Connected => "connection-dot live",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "connection-dot pending",
        MqttClientState.Faulted => "connection-dot faulted",
        _ => "connection-dot"
    };

    private static string PrimaryActionIcon(ManagedConnection connection)
        => connection.State is MqttClientState.Disconnected or MqttClientState.Faulted
            ? Icons.Material.Filled.PlayArrow
            : Icons.Material.Filled.Stop;

    private static string PrimaryActionClass(ManagedConnection connection)
        => connection.State is MqttClientState.Disconnected or MqttClientState.Faulted
            ? "connection-action-button connect"
            : "connection-action-button disconnect";

    private static string PrimaryActionLabel(ManagedConnection connection)
        => connection.State is MqttClientState.Disconnected or MqttClientState.Faulted
            ? $"Connect {ConnectionDisplayName(connection)}"
            : $"Disconnect {ConnectionDisplayName(connection)}";

    private static string RemoveLabel(ManagedConnection connection)
        => $"Remove {ConnectionDisplayName(connection)}";

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;
}

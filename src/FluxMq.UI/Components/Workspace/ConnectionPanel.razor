@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<MudStack Row="true" AlignItems="AlignItems.Center" Class="px-2 pt-1">
    <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="Color.Primary" />
    <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Connections</MudText>
    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add" OnClick="@AddConnectionAsync" />
</MudStack>

@if (Live.Connections.Count == 0)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 pb-2">
        No connections. Click + to add one.
    </MudText>
}
else
{
    <MudTreeView T="ManagedConnection" Dense="true" Hover="true">
        @foreach (var conn in Live.Connections)
        {
            <MudTreeViewItem T="ManagedConnection" Value="@conn">
                <Content>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-grow-1 py-1">
                        <MudIcon Icon="@Icons.Material.Filled.Circle"
                                 Size="Size.Small"
                                 Color="@StateColor(conn.State)"
                                 Style="font-size:10px;min-width:10px" />
                        <MudStack Spacing="0" Class="flex-grow-1">
                            <MudText Typo="Typo.body2">@conn.Profile.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @conn.Profile.Host:@conn.Profile.Port
                            </MudText>
                            @if (!string.IsNullOrEmpty(conn.LastError))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@conn.LastError</MudText>
                            }
                        </MudStack>
                        @if (conn.State is MqttClientState.Disconnected or MqttClientState.Faulted)
                        {
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.PlayArrow"
                                           Color="Color.Success"
                                           OnClick="@(() => ConnectAsync(conn.Id))" />
                        }
                        else
                        {
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Stop"
                                           Color="Color.Error"
                                           OnClick="@(() => DisconnectAsync(conn.Id))" />
                        }
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.DeleteOutline"
                                       OnClick="@(() => RemoveAsync(conn.Id))" />
                    </MudStack>
                </Content>
            </MudTreeViewItem>
        }
    </MudTreeView>
}


@code {
    protected override void OnInitialized() => Live.Changed += OnChanged;

    private async Task AddConnectionAsync()
    {
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>("New Connection", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
            Live.AddConnection(r.Profile, r.Subscription);
    }

    private Task ConnectAsync(Guid id) => Live.ConnectAsync(id);
    private Task DisconnectAsync(Guid id) => Live.DisconnectAsync(id);
    private Task RemoveAsync(Guid id) => Live.RemoveConnectionAsync(id);

    private static Color StateColor(MqttClientState state) => state switch
    {
        MqttClientState.Connected => Color.Success,
        MqttClientState.Connecting or MqttClientState.Reconnecting => Color.Warning,
        MqttClientState.Faulted => Color.Error,
        _ => Color.Default
    };

    private static Severity SeverityFor(WorkspaceDiagnostic d) => d.Severity switch
    {
        "Error" => Severity.Error,
        "Warning" => Severity.Warning,
        "Info" => Severity.Info,
        _ => Severity.Normal
    };

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;
}

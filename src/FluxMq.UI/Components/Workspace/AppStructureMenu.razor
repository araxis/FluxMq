@using FluxMq.Scenarios
@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="app-structure">
    @if (Projects.ActiveProject is not { } active)
    {
        <span class="app-structure-empty" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Small" aria-hidden="true" />
            <span>No app open</span>
        </span>
    }
    else
    {
        var conns = GetConnections(active);

        <span class="app-structure-app" title="@BuildAppMeta(active)">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" aria-hidden="true" />
            <span class="app-structure-name">@active.Name</span>
        </span>

        <div class="app-structure-actions" role="navigation" aria-label="@StructureNavigationLabel(active)">
            <MudMenu Dense="true"
                     Label="@StructureMenuLabel("Brokers", conns.Count)"
                     AriaLabel="@StructureMenuAriaLabel(active, "Brokers", conns.Count, "broker connection")"
                     StartIcon="@Icons.Material.Filled.Hub"
                     EndIcon="@Icons.Material.Filled.ExpandMore"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     Class="app-structure-menu"
                     PopoverClass="app-structure-popover"
                     Modal="false"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (conns.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-empty">
                        @MenuEmptyRow(Icons.Material.Filled.Hub, "No connections", "Add a broker profile to connect.")
                    </MudMenuItem>
                }
                else
                {
                    @foreach (var conn in conns)
                    {
                        var c = conn;
                        <MudMenuItem Disabled="@BrokerActionDisabled(c)"
                                     OnClick="@(() => ToggleBrokerAsync(c))"
                                     Class="@BrokerItemClass(c)"
                                     title="@BrokerItemTitle(c)">
                            <div class="@BrokerRowClass(c)">
                                <span class="app-menu-broker-icon-frame" aria-hidden="true">
                                    <MudIcon Icon="@BrokerActionIcon(c)" Size="Size.Small" aria-hidden="true" />
                                </span>
                                <span class="app-menu-broker-copy">
                                    <span>@c.ResourceName</span>
                                    <small>@BrokerEndpointLabel(c)</small>
                                </span>
                                <span class="@BrokerConnectionClass(c)"
                                      aria-label="@BrokerActionLabel(c)">
                                    <span>@BrokerConnectionText(c)</span>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem OnClick="@(() => AddConnectionAsync(active))"
                             Class="app-menu-child app-menu-command-item app-menu-add">
                    @MenuCommandRow("Add connection", "Broker profile")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Pipelines", active.WorkflowNames.Count)"
                 AriaLabel="@StructureMenuAriaLabel(active, "Pipelines", active.WorkflowNames.Count, "pipeline")"
                 StartIcon="@Icons.Material.Filled.Timeline"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="app-structure-menu"
                 PopoverClass="app-structure-popover"
                 Modal="false"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.WorkflowNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-empty">
                        @MenuEmptyRow(Icons.Material.Filled.Timeline, "No pipelines", "Create a flow to process traffic.")
                    </MudMenuItem>
                }
                else
                {
                    @foreach (var workflow in active.WorkflowNames)
                    {
                        var w = workflow;
                        <MudMenuItem OnClick="@(() => SelectPipeline(active, w))"
                                     Class="@ArtifactMenuItemClass(active, WorkspaceArtifactKind.Pipeline, w)"
                                     aria-current="@ArtifactMenuItemCurrent(active, WorkspaceArtifactKind.Pipeline, w)"
                                     title="@w">
                            <div class="app-menu-artifact-row app-menu-compact-artifact-row">
                                <span class="app-menu-artifact-icon-frame pipeline" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" aria-hidden="true" />
                                </span>
                                <span class="app-menu-artifact-copy">
                                    <span class="app-menu-artifact-name">@w</span>
                                    <span class="app-menu-artifact-meta">Pipeline</span>
                                </span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="@DeleteLabel("pipeline", w)">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("pipeline", w)"
                                                       OnClick="@(() => RemovePipelineAsync(active, w))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem OnClick="@(() => AddPipelineAsync(active))"
                             Class="app-menu-child app-menu-command-item app-menu-add">
                    @MenuCommandRow("Add pipeline", "Processing flow")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Dashboards", active.DashboardNames.Count)"
                 AriaLabel="@StructureMenuAriaLabel(active, "Dashboards", active.DashboardNames.Count, "dashboard")"
                 StartIcon="@Icons.Material.Filled.Dashboard"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="app-structure-menu"
                 PopoverClass="app-structure-popover"
                 Modal="false"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.DashboardNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-empty">
                        @MenuEmptyRow(Icons.Material.Filled.Dashboard, "No dashboards", "Create a view for live metrics.")
                    </MudMenuItem>
                }
                else
                {
                    @foreach (var dashboard in active.DashboardNames)
                    {
                        var d = dashboard;
                        <MudMenuItem OnClick="@(() => SelectDashboard(active, d))"
                                     Class="@ArtifactMenuItemClass(active, WorkspaceArtifactKind.Dashboard, d)"
                                     aria-current="@ArtifactMenuItemCurrent(active, WorkspaceArtifactKind.Dashboard, d)"
                                     title="@d">
                            <div class="app-menu-artifact-row app-menu-compact-artifact-row">
                                <span class="app-menu-artifact-icon-frame dashboard" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" aria-hidden="true" />
                                </span>
                                <span class="app-menu-artifact-copy">
                                    <span class="app-menu-artifact-name">@d</span>
                                    <span class="app-menu-artifact-meta">Dashboard</span>
                                </span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="@DeleteLabel("dashboard", d)">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("dashboard", d)"
                                                       OnClick="@(() => RemoveDashboardAsync(active, d))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem OnClick="@(() => AddDashboardAsync(active))"
                             Class="app-menu-child app-menu-command-item app-menu-add">
                    @MenuCommandRow("Add dashboard", "Metric view")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Metrics", active.MetricNames.Count)"
                 AriaLabel="@StructureMenuAriaLabel(active, "Metrics", active.MetricNames.Count, "metric")"
                 StartIcon="@Icons.Material.Filled.QueryStats"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="app-structure-menu"
                 PopoverClass="app-structure-popover"
                 Modal="false"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.MetricNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-empty">
                        @MenuEmptyRow(Icons.Material.Filled.QueryStats, "No metrics", "Add a metric to power dashboards.")
                    </MudMenuItem>
                }
                else
                {
                    <MudMenuItem OnClick="@(() => SelectMetrics(active))"
                                 Class="@ArtifactMenuItemClass(active, WorkspaceArtifactKind.Metrics, "Metrics")"
                                 aria-current="@ArtifactMenuItemCurrent(active, WorkspaceArtifactKind.Metrics, "Metrics")"
                                 title="@MetricDesignerItemLabel(active)"
                                 aria-label="@MetricDesignerItemLabel(active)">
                        <div class="app-menu-artifact-row app-menu-compact-artifact-row app-menu-metrics-row">
                            <span class="app-menu-artifact-icon-frame metrics" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" aria-hidden="true" />
                            </span>
                            <span class="app-menu-artifact-copy">
                                <span class="app-menu-artifact-name">Metric designer</span>
                                <span class="app-menu-artifact-meta">@CountLabel(active.MetricNames.Count, "metric")</span>
                            </span>
                            <span class="app-menu-artifact-action">Open</span>
                        </div>
                    </MudMenuItem>
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem OnClick="@(() => AddMetricAsync(active))"
                             Class="app-menu-child app-menu-command-item app-menu-add">
                    @MenuCommandRow("Add metric", "Dashboard signal")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Tests", active.TestNames.Count)"
                 AriaLabel="@StructureMenuAriaLabel(active, "Tests", active.TestNames.Count, "test")"
                 StartIcon="@Icons.Material.Filled.FactCheck"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="app-structure-menu"
                 PopoverClass="app-structure-popover"
                 Modal="false"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.TestNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-empty">
                        @MenuEmptyRow(Icons.Material.Filled.FactCheck, "No tests", "Create a scenario to validate flows.")
                    </MudMenuItem>
                }
                else
                {
                    @foreach (var test in active.TestNames)
                    {
                        var t = test;
                        var latestTestRun = LatestTestRun(active, t);
                        <MudMenuItem OnClick="@(() => SelectTest(active, t))"
                                     Class="@TestArtifactItemClass(active, t, latestTestRun)"
                                     aria-current="@ArtifactMenuItemCurrent(active, WorkspaceArtifactKind.Test, t)"
                                     title="@TestArtifactTitle(t, latestTestRun)">
                            <div class="@TestRunMenuRowClass(latestTestRun)">
                                <span class="app-menu-test-icon-frame" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" aria-hidden="true" />
                                </span>
                                <span class="app-menu-artifact-copy">
                                    <span class="app-menu-artifact-name">@t</span>
                                    <span class="app-menu-artifact-meta">@TestRunMenuMeta(latestTestRun)</span>
                                </span>
                                <span class="@TestRunMenuSummaryClass(latestTestRun)"
                                      aria-label="@TestRunMenuSummaryLabel(latestTestRun)">
                                    <span class="@TestRunMenuMarkerClass(latestTestRun)">
                                        <MudIcon Icon="@TestRunMenuIcon(latestTestRun)" Size="Size.Small" aria-hidden="true" />
                                        <span>@TestRunMenuText(latestTestRun)</span>
                                    </span>
                                    <span class="app-menu-test-summary-meta">@TestRunMenuDetailText(latestTestRun)</span>
                                </span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="@DeleteLabel("test", t)">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("test", t)"
                                                       OnClick="@(() => RemoveTestAsync(active, t))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem OnClick="@(() => AddTestAsync(active))"
                             Class="app-menu-child app-menu-command-item app-menu-add">
                    @MenuCommandRow("Add test", "Scenario check")
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
        </div>

    }
</div>

@code {
    private readonly HashSet<FlowWorkspaceService> _subscribed = [];

    private static RenderFragment MenuEmptyRow(string icon, string title, string hint) => @<div class="app-menu-empty-row" role="status" aria-live="polite">
        <span class="app-menu-empty-icon" aria-hidden="true">
            <MudIcon Icon="@icon" Size="Size.Small" aria-hidden="true" />
        </span>
        <span class="app-menu-empty-copy">
            <span>@title</span>
            <small>@hint</small>
        </span>
        <span class="app-menu-empty-text">Empty</span>
    </div>;

    private static RenderFragment MenuCommandRow(string title, string hint) => @<div class="app-menu-command-row">
        <span class="app-menu-command-icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-hidden="true" />
        </span>
        <span class="app-menu-command-copy">
            <span>@title</span>
            <small>@hint</small>
        </span>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" aria-hidden="true"
                 Size="Size.Small"
                 Class="app-menu-command-cue" />
    </div>;

    protected override void OnInitialized()
    {
        Projects.Changed += OnChanged;
        Live.Changed += OnChanged;
        SyncSubscriptions();
    }

    private List<ManagedConnection> GetConnections(FlowWorkspaceService app)
    {
        var profiles = app.GetConnectionProfiles();
        var connectionNames = app.GetConnectionNames();
        return Live.Connections.Where(c =>
            profiles.Any(p =>
                string.Equals(p.Profile.Host, c.Profile.Host, StringComparison.OrdinalIgnoreCase) &&
                p.Profile.Port == c.Profile.Port) ||
            connectionNames.Any(name => string.Equals(name, c.ResourceName, StringComparison.Ordinal))).ToList();
    }

    private static string StructureMenuLabel(string label, int count)
        => $"{label} {count.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string StructureNavigationLabel(FlowWorkspaceService app)
        => $"{app.Name} structure navigation, {BuildAppMeta(app)}";

    private static string StructureMenuAriaLabel(FlowWorkspaceService app, string sectionLabel, int count, string singular)
        => $"{app.Name} {sectionLabel.ToLowerInvariant()} menu, {CountLabel(count, singular)}";

    private static string BuildAppMeta(FlowWorkspaceService app)
    {
        var parts = new[]
        {
            CountLabel(app.WorkflowNames.Count, "pipeline"),
            CountLabel(app.MetricNames.Count, "metric"),
            CountLabel(app.DashboardNames.Count, "dashboard"),
            CountLabel(app.TestNames.Count, "test")
        };

        return string.Join(" / ", parts);
    }

    private static string CountLabel(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private static string DeleteLabel(string artifactKind, string name)
        => $"Delete {artifactKind} {name}";

    private static string MetricDesignerItemLabel(FlowWorkspaceService app)
        => $"Open {app.Name} metric designer, {CountLabel(app.MetricNames.Count, "metric")}";

    private static ScenarioRunResult? LatestTestRun(FlowWorkspaceService app, string testName)
        => app.ScenarioRunHistory.FirstOrDefault(result =>
            string.Equals(result.Name, testName, StringComparison.Ordinal));

    private string TestArtifactItemClass(FlowWorkspaceService app, string name, ScenarioRunResult? latestRun)
    {
        var parts = new List<string>
        {
            ArtifactItemClass(app, WorkspaceArtifactKind.Test, name),
            "app-menu-test-item"
        };

        if (latestRun is not null)
        {
            parts.Add(latestRun.Status.ToString().ToLowerInvariant());
        }

        return string.Join(" ", parts);
    }

    private static string TestRunMenuMeta(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No run yet"
            : $"Latest {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}";

    private static string TestRunMenuSummaryLabel(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No scenario run history"
            : $"Latest run {latestRun.Status}, {TestRunMenuDetailText(latestRun)}";

    private static string TestRunMenuText(ScenarioRunResult? latestRun)
        => latestRun?.Status.ToString() ?? "No run";

    private static string TestRunMenuDetailText(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No history"
            : $"{CountLabel(latestRun.Steps.Count, "step")} / {TestRunMenuIssueText(latestRun)}";

    private static string TestRunMenuIssueText(ScenarioRunResult latestRun)
    {
        var issueCount = latestRun.Steps.Count(step =>
            step.Status is ScenarioStepRunStatus.Failed or ScenarioStepRunStatus.TimedOut or ScenarioStepRunStatus.Canceled);

        return issueCount == 0 ? "No issues" : CountLabel(issueCount, "issue");
    }

    private static string TestRunMenuRowClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-artifact-row app-menu-test-row passed",
            ScenarioRunStatus.Failed => "app-menu-artifact-row app-menu-test-row failed",
            ScenarioRunStatus.Canceled => "app-menu-artifact-row app-menu-test-row canceled",
            _ => "app-menu-artifact-row app-menu-test-row idle"
        };

    private static string TestRunMenuSummaryClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-test-summary passed",
            ScenarioRunStatus.Failed => "app-menu-test-summary failed",
            ScenarioRunStatus.Canceled => "app-menu-test-summary canceled",
            _ => "app-menu-test-summary idle"
        };

    private static string TestRunMenuMarkerClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-test-marker passed",
            ScenarioRunStatus.Failed => "app-menu-test-marker failed",
            ScenarioRunStatus.Canceled => "app-menu-test-marker canceled",
            _ => "app-menu-test-marker idle"
        };

    private static string TestRunMenuIcon(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => Icons.Material.Filled.CheckCircle,
            ScenarioRunStatus.Failed => Icons.Material.Filled.ErrorOutline,
            ScenarioRunStatus.Canceled => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.RadioButtonUnchecked
        };

    private static string TestArtifactTitle(string testName, ScenarioRunResult? latestRun)
        => latestRun is null
            ? $"Test {testName}. No run history."
            : $"Test {testName}. Latest run {latestRun.Status} at {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}.";

    private static string BrokerActionIcon(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => Icons.Material.Filled.Stop,
        MqttClientState.Connecting or MqttClientState.Reconnecting => Icons.Material.Filled.Sync,
        MqttClientState.Faulted => Icons.Material.Filled.PlayArrow,
        _ => Icons.Material.Filled.PlayArrow
    };

    private static bool BrokerActionDisabled(ManagedConnection connection)
        => connection.State is MqttClientState.Connecting or MqttClientState.Reconnecting;

    private static string BrokerActionLabel(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => $"Disconnect {connection.ResourceName}",
        MqttClientState.Connecting => $"Connecting {connection.ResourceName}",
        MqttClientState.Reconnecting => $"Reconnecting {connection.ResourceName}",
        _ => $"Connect {connection.ResourceName}"
    };

    private static string BrokerEndpointLabel(ManagedConnection connection)
        => $"{connection.Profile.Host}:{connection.Profile.Port}";

    private static string BrokerItemTitle(ManagedConnection connection)
        => $"{BrokerActionLabel(connection)} at {BrokerEndpointLabel(connection)}";

    private static string BrokerConnectionText(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => "Live",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "Pending",
        MqttClientState.Faulted => "Fault",
        _ => "Idle"
    };

    private static string BrokerRowClass(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => "app-menu-broker-row live",
        MqttClientState.Faulted => "app-menu-broker-row faulted",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "app-menu-broker-row pending",
        _ => "app-menu-broker-row idle"
    };

    private static string BrokerConnectionClass(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => "app-menu-broker-connection live",
        MqttClientState.Faulted => "app-menu-broker-connection faulted",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "app-menu-broker-connection pending",
        _ => "app-menu-broker-connection idle"
    };

    private static string BrokerItemClass(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => "app-menu-child app-menu-broker-item broker-live",
        MqttClientState.Faulted => "app-menu-child app-menu-broker-item broker-faulted",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "app-menu-child app-menu-broker-item broker-pending",
        _ => "app-menu-child app-menu-broker-item"
    };

    private string ArtifactItemClass(FlowWorkspaceService app, WorkspaceArtifactKind kind, string name)
    {
        var active = IsArtifactActive(app, kind, name);

        return active ? "app-menu-child active-artifact" : "app-menu-child";
    }

    private string ArtifactMenuItemClass(FlowWorkspaceService app, WorkspaceArtifactKind kind, string name)
        => $"{ArtifactItemClass(app, kind, name)} app-menu-artifact-item";

    private string? ArtifactMenuItemCurrent(FlowWorkspaceService app, WorkspaceArtifactKind kind, string name)
        => IsArtifactActive(app, kind, name) ? "true" : null;

    private bool IsArtifactActive(FlowWorkspaceService app, WorkspaceArtifactKind kind, string name)
        => app == Projects.ActiveProject &&
           app.ActiveArtifactKind == kind &&
           string.Equals(app.ActiveArtifactName, name, StringComparison.Ordinal);

    private async Task ToggleBrokerAsync(ManagedConnection connection)
    {
        if (connection.State is MqttClientState.Connected)
        {
            await Live.DisconnectAsync(connection.Id);
            return;
        }

        await Live.ConnectAsync(connection.Id);
    }

    private void SelectPipeline(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveWorkflow(name);
    }

    private void SelectDashboard(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveDashboard(name);
    }

    private void SelectMetrics(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        app.SetActiveMetrics();
    }

    private void SelectTest(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveTest(name);
    }

    private async Task RemovePipelineAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("pipeline", name)) return;

        app.RemoveWorkflow(name);
    }

    private async Task RemoveDashboardAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("dashboard", name)) return;

        app.RemoveDashboard(name);
    }

    private async Task RemoveTestAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("test", name)) return;

        app.RemoveTest(name);
    }

    private async Task<bool> ConfirmDeleteAsync(string artifactKind, string name)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete {artifactKind}",
            $"Delete {artifactKind} '{name}'? This cannot be undone.",
            "Delete",
            null,
            "Cancel",
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        return confirmed == true;
    }

    private async Task AddConnectionAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>(
            "New Connection",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
        {
            var resourceKey = string.IsNullOrWhiteSpace(r.Profile.Name)
                ? "connection"
                : r.Profile.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            app.UpsertConnectionResource(resourceKey, r.Profile);
            Live.AddConnectionIfAbsent(r.Profile, r.Subscription, resourceKey);
        }
    }


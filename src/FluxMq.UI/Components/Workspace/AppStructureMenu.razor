@using FluxMq.Scenarios
@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="app-structure">
    @if (Projects.ActiveProject is not { } active)
    {
        <span class="app-structure-empty">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Small" />
            <span>No app open</span>
        </span>
    }
    else
    {
        var conns = GetConnections(active);

        <span class="app-structure-app" title="@BuildAppMeta(active)">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            <span class="app-structure-name">@active.Name</span>
            <span class="app-structure-current">@CurrentArtifactLabel(active)</span>
        </span>

        <div class="app-structure-actions" role="navigation" aria-label="App structure navigation">
            <MudMenu Dense="true"
                     Label="@StructureMenuLabel("Brokers", conns.Count)"
                     StartIcon="@Icons.Material.Filled.Hub"
                     EndIcon="@Icons.Material.Filled.ExpandMore"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     Class="app-structure-menu"
                     PopoverClass="app-structure-popover"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (conns.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-muted">No connections</MudMenuItem>
                }
                else
                {
                    @foreach (var conn in conns)
                    {
                        var c = conn;
                        <MudMenuItem Icon="@BrokerActionIcon(c)"
                                     Disabled="@BrokerActionDisabled(c)"
                                     OnClick="@(() => ToggleBrokerAsync(c))"
                                     Class="@BrokerItemClass(c)">
                            <div class="app-menu-broker">
                                <span>@BrokerActionLabel(c)</span>
                                <span>@c.ResourceName - @c.Profile.Host:@c.Profile.Port</span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem Icon="@Icons.Material.Filled.Add"
                             OnClick="@(() => AddConnectionAsync(active))"
                             Class="app-menu-child app-menu-add">Add connection</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Pipelines", active.WorkflowNames.Count)"
                 StartIcon="@Icons.Material.Filled.Timeline"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="@StructureMenuClass(active, WorkspaceArtifactKind.Pipeline)"
                 PopoverClass="app-structure-popover"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.WorkflowNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-muted">No pipelines</MudMenuItem>
                }
                else
                {
                    @foreach (var workflow in active.WorkflowNames)
                    {
                        var w = workflow;
                        <MudMenuItem Icon="@Icons.Material.Filled.Timeline"
                                     OnClick="@(() => SelectPipeline(active, w))"
                                     Class="@ArtifactItemClass(active, WorkspaceArtifactKind.Pipeline, w)"
                                     title="@w">
                            <div class="app-menu-artifact-row">
                                <span class="app-menu-artifact-name">@w</span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="Delete pipeline">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("pipeline", w)"
                                                       OnClick="@(() => RemovePipelineAsync(active, w))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem Icon="@Icons.Material.Filled.Add"
                             OnClick="@(() => AddPipelineAsync(active))"
                             Class="app-menu-child app-menu-add">Add pipeline</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Dashboards", active.DashboardNames.Count)"
                 StartIcon="@Icons.Material.Filled.Dashboard"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="@StructureMenuClass(active, WorkspaceArtifactKind.Dashboard)"
                 PopoverClass="app-structure-popover"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.DashboardNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-muted">No dashboards</MudMenuItem>
                }
                else
                {
                    @foreach (var dashboard in active.DashboardNames)
                    {
                        var d = dashboard;
                        <MudMenuItem Icon="@Icons.Material.Filled.Dashboard"
                                     OnClick="@(() => SelectDashboard(active, d))"
                                     Class="@ArtifactItemClass(active, WorkspaceArtifactKind.Dashboard, d)"
                                     title="@d">
                            <div class="app-menu-artifact-row">
                                <span class="app-menu-artifact-name">@d</span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="Delete dashboard">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("dashboard", d)"
                                                       OnClick="@(() => RemoveDashboardAsync(active, d))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem Icon="@Icons.Material.Filled.Add"
                             OnClick="@(() => AddDashboardAsync(active))"
                             Class="app-menu-child app-menu-add">Add dashboard</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Metrics", active.MetricNames.Count)"
                 StartIcon="@Icons.Material.Filled.QueryStats"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="@StructureMenuClass(active, WorkspaceArtifactKind.Metrics)"
                 PopoverClass="app-structure-popover"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.MetricNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-muted">No metrics</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.QueryStats"
                                 OnClick="@(() => SelectMetrics(active))"
                                 Class="@ArtifactItemClass(active, WorkspaceArtifactKind.Metrics, "Metrics")">
                        Metric designer
                    </MudMenuItem>
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem Icon="@Icons.Material.Filled.Add"
                             OnClick="@(() => AddMetricAsync(active))"
                             Class="app-menu-child app-menu-add">Add metric</MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudMenu Dense="true"
                 Label="@StructureMenuLabel("Tests", active.TestNames.Count)"
                 StartIcon="@Icons.Material.Filled.FactCheck"
                 EndIcon="@Icons.Material.Filled.ExpandMore"
                 Size="Size.Small"
                 Variant="Variant.Text"
                 Class="@StructureMenuClass(active, WorkspaceArtifactKind.Test)"
                 PopoverClass="app-structure-popover"
                 AnchorOrigin="Origin.BottomLeft"
                 TransformOrigin="Origin.TopLeft">
            <ChildContent>
                @if (active.TestNames.Count == 0)
                {
                    <MudMenuItem Disabled="true" Class="app-menu-muted">No tests</MudMenuItem>
                }
                else
                {
                    @foreach (var test in active.TestNames)
                    {
                        var t = test;
                        var latestTestRun = LatestTestRun(active, t);
                        <MudMenuItem OnClick="@(() => SelectTest(active, t))"
                                     Class="@TestArtifactItemClass(active, t, latestTestRun)"
                                     title="@TestArtifactTitle(t, latestTestRun)">
                            <div class="@TestRunMenuRowClass(latestTestRun)">
                                <span class="app-menu-test-icon-frame" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                                </span>
                                <span class="app-menu-artifact-copy">
                                    <span class="app-menu-artifact-name">@t</span>
                                    <span class="app-menu-artifact-meta">@TestRunMenuMeta(latestTestRun)</span>
                                </span>
                                <span class="@TestRunMenuSummaryClass(latestTestRun)"
                                      aria-label="@TestRunMenuStateLabel(latestTestRun)">
                                    <span class="@TestRunMenuPillClass(latestTestRun)">
                                        <MudIcon Icon="@TestRunMenuIcon(latestTestRun)" Size="Size.Small" />
                                        <span>@TestRunMenuText(latestTestRun)</span>
                                    </span>
                                    <span class="app-menu-test-summary-meta">@TestRunMenuDetailText(latestTestRun)</span>
                                </span>
                                <span class="app-menu-inline-action" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                                    <MudTooltip Text="Delete test">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Class="app-menu-delete-button"
                                                       aria-label="@DeleteLabel("test", t)"
                                                       OnClick="@(() => RemoveTestAsync(active, t))" />
                                    </MudTooltip>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                }

                <MudDivider Class="app-menu-divider" />
                <MudMenuItem Icon="@Icons.Material.Filled.Add"
                             OnClick="@(() => AddTestAsync(active))"
                             Class="app-menu-child app-menu-add">Add test</MudMenuItem>
            </ChildContent>
        </MudMenu>
        </div>

        <span class="app-structure-meta">@BuildActiveMeta(active)</span>
    }
</div>

@code {
    private readonly HashSet<FlowWorkspaceService> _subscribed = [];

    protected override void OnInitialized()
    {
        Projects.Changed += OnChanged;
        Live.Changed += OnChanged;
        SyncSubscriptions();
    }

    private List<ManagedConnection> GetConnections(FlowWorkspaceService app)
    {
        var profiles = app.GetConnectionProfiles();
        var connectionNames = app.GetConnectionNames();
        return Live.Connections.Where(c =>
            profiles.Any(p =>
                string.Equals(p.Profile.Host, c.Profile.Host, StringComparison.OrdinalIgnoreCase) &&
                p.Profile.Port == c.Profile.Port) ||
            connectionNames.Any(name => string.Equals(name, c.ResourceName, StringComparison.Ordinal))).ToList();
    }

    private static string BuildActiveMeta(FlowWorkspaceService app)
    {
        var artifact = app.ActiveArtifactKind switch
        {
            WorkspaceArtifactKind.Dashboard => app.ActiveDashboardName,
            WorkspaceArtifactKind.Metrics => "Metrics",
            WorkspaceArtifactKind.Test => app.ActiveTestName,
            WorkspaceArtifactKind.Topics => "Topics",
            WorkspaceArtifactKind.Logs => "Logs",
            _ => app.ActiveWorkflowName
        };

        var prefix = app.ActiveArtifactKind switch
        {
            WorkspaceArtifactKind.Dashboard => "dashboard",
            WorkspaceArtifactKind.Metrics => "metrics",
            WorkspaceArtifactKind.Test => "test",
            WorkspaceArtifactKind.Topics => "page",
            WorkspaceArtifactKind.Logs => "page",
            _ => "pipeline"
        };

        return string.IsNullOrWhiteSpace(artifact)
            ? BuildAppMeta(app)
            : $"{prefix}: {artifact}";
    }

    private static string CurrentArtifactLabel(FlowWorkspaceService app)
        => app.ActiveArtifactKind switch
        {
            WorkspaceArtifactKind.Dashboard => "Dashboard",
            WorkspaceArtifactKind.Metrics => "Metrics",
            WorkspaceArtifactKind.Test => "Test",
            WorkspaceArtifactKind.Topics => "Topics",
            WorkspaceArtifactKind.Logs => "Logs",
            _ => "Pipeline"
        };

    private static string StructureMenuLabel(string label, int count)
        => $"{label} {count.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private static string StructureMenuClass(FlowWorkspaceService app, WorkspaceArtifactKind kind)
        => app.ActiveArtifactKind == kind ? "app-structure-menu active" : "app-structure-menu";

    private static string BuildAppMeta(FlowWorkspaceService app)
    {
        var parts = new[]
        {
            CountLabel(app.WorkflowNames.Count, "pipeline"),
            CountLabel(app.MetricNames.Count, "metric"),
            CountLabel(app.DashboardNames.Count, "dashboard"),
            CountLabel(app.TestNames.Count, "test")
        };

        return string.Join(" / ", parts);
    }

    private static string CountLabel(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private static string DeleteLabel(string artifactKind, string name)
        => $"Delete {artifactKind} {name}";

    private static ScenarioRunResult? LatestTestRun(FlowWorkspaceService app, string testName)
        => app.ScenarioRunHistory.FirstOrDefault(result =>
            string.Equals(result.Name, testName, StringComparison.Ordinal));

    private string TestArtifactItemClass(FlowWorkspaceService app, string name, ScenarioRunResult? latestRun)
    {
        var parts = new List<string>
        {
            ArtifactItemClass(app, WorkspaceArtifactKind.Test, name),
            "app-menu-test-item"
        };

        if (latestRun is not null)
        {
            parts.Add(latestRun.Status.ToString().ToLowerInvariant());
        }

        return string.Join(" ", parts);
    }

    private static string TestRunMenuMeta(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "Ready for first run"
            : $"Latest {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}";

    private static string TestRunMenuStateLabel(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No scenario run history"
            : $"Latest run {latestRun.Status}, {TestRunMenuDetailText(latestRun)}";

    private static string TestRunMenuText(ScenarioRunResult? latestRun)
        => latestRun?.Status.ToString() ?? "No run";

    private static string TestRunMenuDetailText(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No history"
            : $"{CountLabel(latestRun.Steps.Count, "step")} / {TestRunMenuIssueText(latestRun)}";

    private static string TestRunMenuIssueText(ScenarioRunResult latestRun)
    {
        var issueCount = latestRun.Steps.Count(step =>
            step.Status is ScenarioStepRunStatus.Failed or ScenarioStepRunStatus.TimedOut or ScenarioStepRunStatus.Canceled);

        return issueCount == 0 ? "No issues" : CountLabel(issueCount, "issue");
    }

    private static string TestRunMenuRowClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-artifact-row app-menu-test-row passed",
            ScenarioRunStatus.Failed => "app-menu-artifact-row app-menu-test-row failed",
            ScenarioRunStatus.Canceled => "app-menu-artifact-row app-menu-test-row canceled",
            _ => "app-menu-artifact-row app-menu-test-row idle"
        };

    private static string TestRunMenuSummaryClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-test-summary passed",
            ScenarioRunStatus.Failed => "app-menu-test-summary failed",
            ScenarioRunStatus.Canceled => "app-menu-test-summary canceled",
            _ => "app-menu-test-summary idle"
        };

    private static string TestRunMenuPillClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "app-menu-test-pill passed",
            ScenarioRunStatus.Failed => "app-menu-test-pill failed",
            ScenarioRunStatus.Canceled => "app-menu-test-pill canceled",
            _ => "app-menu-test-pill idle"
        };

    private static string TestRunMenuIcon(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => Icons.Material.Filled.CheckCircle,
            ScenarioRunStatus.Failed => Icons.Material.Filled.ErrorOutline,
            ScenarioRunStatus.Canceled => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.RadioButtonUnchecked
        };

    private static string TestArtifactTitle(string testName, ScenarioRunResult? latestRun)
        => latestRun is null
            ? $"Test {testName}. No run history."
            : $"Test {testName}. Latest run {latestRun.Status} at {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}.";

    private static string BrokerActionIcon(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => Icons.Material.Filled.Stop,
        MqttClientState.Connecting or MqttClientState.Reconnecting => Icons.Material.Filled.Sync,
        MqttClientState.Faulted => Icons.Material.Filled.PlayArrow,
        _ => Icons.Material.Filled.PlayArrow
    };

    private static bool BrokerActionDisabled(ManagedConnection connection)
        => connection.State is MqttClientState.Connecting or MqttClientState.Reconnecting;

    private static string BrokerActionLabel(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => $"Disconnect {connection.ResourceName}",
        MqttClientState.Connecting => $"Connecting {connection.ResourceName}",
        MqttClientState.Reconnecting => $"Reconnecting {connection.ResourceName}",
        _ => $"Connect {connection.ResourceName}"
    };

    private static string BrokerItemClass(ManagedConnection connection) => connection.State switch
    {
        MqttClientState.Connected => "app-menu-child broker-live",
        MqttClientState.Faulted => "app-menu-child broker-faulted",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "app-menu-child broker-pending",
        _ => "app-menu-child"
    };

    private string ArtifactItemClass(FlowWorkspaceService app, WorkspaceArtifactKind kind, string name)
    {
        var active = app == Projects.ActiveProject &&
                     app.ActiveArtifactKind == kind &&
                     string.Equals(app.ActiveArtifactName, name, StringComparison.Ordinal);

        return active ? "app-menu-child active-artifact" : "app-menu-child";
    }

    private async Task ToggleBrokerAsync(ManagedConnection connection)
    {
        if (connection.State is MqttClientState.Connected)
        {
            await Live.DisconnectAsync(connection.Id);
            return;
        }

        await Live.ConnectAsync(connection.Id);
    }

    private void SelectPipeline(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveWorkflow(name);
    }

    private void SelectDashboard(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveDashboard(name);
    }

    private void SelectMetrics(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        app.SetActiveMetrics();
    }

    private void SelectTest(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveTest(name);
    }

    private async Task RemovePipelineAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("pipeline", name)) return;

        app.RemoveWorkflow(name);
    }

    private async Task RemoveDashboardAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("dashboard", name)) return;

        app.RemoveDashboard(name);
    }

    private async Task RemoveTestAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        if (!await ConfirmDeleteAsync("test", name)) return;

        app.RemoveTest(name);
    }

    private async Task<bool> ConfirmDeleteAsync(string artifactKind, string name)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete {artifactKind}",
            $"Delete {artifactKind} '{name}'? This cannot be undone.",
            "Delete",
            null,
            "Cancel",
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });

        return confirmed == true;
    }

    private async Task AddConnectionAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>(
            "New Connection",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
        {
            var resourceKey = string.IsNullOrWhiteSpace(r.Profile.Name)
                ? "connection"
                : r.Profile.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            app.UpsertConnectionResource(resourceKey, r.Profile);
            Live.AddConnectionIfAbsent(r.Profile, r.Subscription, resourceKey);
        }
    }

    private async Task AddPipelineAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>("New Pipeline");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddWorkflow(name.Trim());
            app.SetActiveWorkflow(name.Trim());
        }
    }

    private async Task AddDashboardAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Dashboard",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Dashboard"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddDashboard(name.Trim());
        }
    }

    private async Task AddMetricAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Metric",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Metric"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddMetric(name.Trim());
            app.SetActiveMetrics();
        }
    }

    private async Task AddTestAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Test",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Test"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddTest(name.Trim());
        }
    }

    private void SyncSubscriptions()
    {
        foreach (var app in Projects.Projects)
            if (_subscribed.Add(app))
                app.Changed += OnChanged;

        foreach (var stale in _subscribed.Where(p => !Projects.Projects.Contains(p)).ToList())
        {
            stale.Changed -= OnChanged;
            _subscribed.Remove(stale);
        }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        SyncSubscriptions();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Projects.Changed -= OnChanged;
        Live.Changed -= OnChanged;
        foreach (var app in _subscribed)
            app.Changed -= OnChanged;
        _subscribed.Clear();
    }
}

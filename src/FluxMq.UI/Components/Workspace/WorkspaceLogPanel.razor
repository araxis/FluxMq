@using FluxMq.UI.Models

<div class="@RootClass">
    <div class="workspace-log-header">
        <div class="workspace-log-title">
            <span class="workspace-log-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            </span>
            <div>
                <h2>@Title</h2>
                <div class="workspace-log-subtitle">@SummaryLabel</div>
            </div>
        </div>

        <div class="workspace-log-actions" aria-label="Log commands">
            @if (Logs.Count > 0)
            {
                <div class="workspace-log-stats" aria-label="Log summary">
                    <span><strong>@Logs.Count</strong> total</span>
                    @if (ProblemCount > 0)
                    {
                        <span class="problems"><strong>@ProblemCount</strong> @ProblemCountLabel</span>
                    }
                </div>
            }
            <MudTooltip Text="Reset filters">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                               Size="Size.Small"
                               Class="workspace-log-icon-button"
                               Disabled="@(!HasActiveFilters)"
                               OnClick="ResetFilters" />
            </MudTooltip>
            <MudTooltip Text="Clear logs">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                               Size="Size.Small"
                               Class="workspace-log-icon-button danger"
                               Disabled="@(Logs.Count == 0)"
                               OnClick="ClearAsync" />
            </MudTooltip>
        </div>
    </div>

    <div class="workspace-log-toolbar" role="search" aria-label="Log filters">
        @if (string.IsNullOrWhiteSpace(ForcedScope))
        {
            <div class="workspace-log-filter-block scope">
                <span class="workspace-log-filter-label">Scope</span>
                <div class="workspace-log-segment" role="group" aria-label="Scope filter">
                    @foreach (var scope in ScopeOptions)
                    {
                        <button type="button"
                                class="@FilterButtonClass(_scope, scope)"
                                aria-pressed="@AriaPressed(IsScopeSelected(scope))"
                                @onclick="@(() => SetScope(scope))">
                            @ScopeLabel(scope)
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="workspace-log-forced-scope" aria-label="Fixed scope">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                <span>@ScopeLabel(ForcedScope)</span>
            </div>
        }

        <div class="workspace-log-filter-block severity">
            <span class="workspace-log-filter-label">Level</span>
            <div class="workspace-log-segment" role="group" aria-label="Level filter">
                @foreach (var severity in SeverityOptions)
                {
                    <button type="button"
                            class="@FilterButtonClass(_severity, severity)"
                            aria-pressed="@AriaPressed(IsSeveritySelected(severity))"
                            @onclick="@(() => SetSeverity(severity))">
                        @SeverityOptionLabel(severity)
                    </button>
                }
            </div>
        </div>

        <MudTextField T="string"
                      Placeholder="Search logs"
                      aria-label="Search logs"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      @bind-Value="_search"
                      Class="workspace-log-search" />
    </div>

    @if (ProblemCount > 0)
    {
        <div class="workspace-log-status @ProblemStatusClass" role="status" aria-live="polite">
            <span class="workspace-log-status-icon" aria-hidden="true">
                <MudIcon Icon="@ProblemStatusIcon" Size="Size.Small" />
            </span>
            <div class="workspace-log-status-copy">
                <strong>@ProblemStatusTitle</strong>
                <span>@ProblemStatusText</span>
            </div>
            <button type="button"
                    class="workspace-log-status-action"
                    disabled="@IsSeveritySelected(WorkspaceLogFilter.Problems)"
                    @onclick="@(() => SetSeverity(WorkspaceLogFilter.Problems))">
                Show problems
            </button>
        </div>
    }

    <div class="workspace-log-list" role="log" aria-label="Workspace logs">
        @if (FilteredLogs.Count == 0)
        {
            <div class="workspace-log-empty" role="status" aria-live="polite">
                <MudIcon Icon="@EmptyIcon" Size="Size.Medium" />
                <strong>@EmptyTitle</strong>
                <span>@EmptyText</span>
                @if (HasActiveFilters)
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Class="workspace-log-empty-action"
                               OnClick="ResetFilters">
                        Reset filters
                    </MudButton>
                }
            </div>
        }
        else
        {
            @foreach (var entry in FilteredLogs)
            {
                var detailLabels = DetailLabels(entry);
                <article class="workspace-log-row @SeverityClass(entry)"
                         aria-label="@($"{SeverityLabel(entry)} log at {FormatLogTime(entry)} from {SourceCode(entry)}")"
                         @key="entry">
                    <span class="workspace-log-row-icon" title="@SeverityLabel(entry)" aria-hidden="true">
                        <MudIcon Icon="@SeverityIcon(entry)" Size="Size.Small" />
                    </span>
                    <div class="workspace-log-row-time">
                        <span>@FormatLogTime(entry)</span>
                        <small>@FormatLogDate(entry)</small>
                    </div>
                    <div class="workspace-log-row-source">
                        <strong>@SourceCode(entry)</strong>
                        <span>@EntryScopeLabel(entry)</span>
                    </div>
                    <div class="workspace-log-row-body">
                        <div class="workspace-log-row-message">@entry.Message</div>
                        @if (detailLabels.Count > 0)
                        {
                            <div class="workspace-log-row-meta">
                                @foreach (var label in detailLabels)
                                {
                                    <span>@label</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Context))
                        {
                            <div class="workspace-log-row-context">@entry.Context</div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

@code {
    private static readonly string[] SeverityOptions =
    [
        WorkspaceLogFilter.All,
        WorkspaceLogFilter.Problems,
        "Error",
        "Warning",
        "Info",
        "Debug",
        "Trace"
    ];

    private string _scope = WorkspaceLogFilter.All;
    private string _severity = WorkspaceLogFilter.All;
    private string? _search;

    [Parameter] public IReadOnlyList<WorkspaceLogEntry> Logs { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string Title { get; set; } = "Logs";
    [Parameter] public string? ForcedScope { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public int MaxEntries { get; set; } = 500;

    private string RootClass => Compact ? "workspace-log-shell compact" : "workspace-log-shell";
    private string EffectiveScope => string.IsNullOrWhiteSpace(ForcedScope) ? _scope : ForcedScope;
    private bool HasActiveFilters =>
        (string.IsNullOrWhiteSpace(ForcedScope) &&
         !string.Equals(_scope, WorkspaceLogFilter.All, StringComparison.Ordinal)) ||
        !string.Equals(_severity, WorkspaceLogFilter.All, StringComparison.Ordinal) ||
        !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<WorkspaceLogEntry> FilteredLogs =>
        WorkspaceLogFilter.Apply(Logs, new WorkspaceLogQuery(EffectiveScope, _severity, _search), MaxEntries);

    private IReadOnlyList<WorkspaceLogEntry> ProblemLogs =>
        WorkspaceLogFilter.Apply(Logs, new WorkspaceLogQuery(EffectiveScope, WorkspaceLogFilter.Problems, _search), MaxEntries);

    private int ErrorCount => ProblemLogs.Count(log => SeverityLabel(log) is "Critical" or "Error");
    private int WarningCount => ProblemLogs.Count(log => SeverityLabel(log) is "Warning");
    private int ProblemCount => ErrorCount + WarningCount;

    private string ProblemCountLabel => ProblemCount == 1 ? "problem" : "problems";

    private string SummaryLabel => Logs.Count == 0
        ? "No entries recorded"
        : $"{FilteredLogs.Count} shown / {Logs.Count} total";

    private string EmptyIcon => HasActiveFilters
        ? Icons.Material.Filled.SearchOff
        : Icons.Material.Filled.ReceiptLong;

    private string EmptyTitle => HasActiveFilters ? "No matching logs" : "No logs yet";

    private string EmptyText => HasActiveFilters
        ? "Adjust filters or search text."
        : "Validate, run, or test the app to record workspace events.";

    private string ProblemStatusClass => ErrorCount > 0 ? "error" : "warning";
    private string ProblemStatusIcon => ErrorCount > 0 ? Icons.Material.Filled.ErrorOutline : Icons.Material.Filled.WarningAmber;
    private string ProblemStatusTitle => ErrorCount > 0 ? "Action needed" : "Warnings recorded";

    private string ProblemStatusText => (ErrorCount, WarningCount) switch
    {
        (> 0, > 0) => $"{FormatCount(ErrorCount, "error")} and {FormatCount(WarningCount, "warning")} in the current log stream.",
        (> 0, _) => $"{FormatCount(ErrorCount, "error")} in the current log stream.",
        _ => $"{FormatCount(WarningCount, "warning")} in the current log stream."
    };

    private IReadOnlyList<string> ScopeOptions
    {
        get
        {
            var scopes = new List<string>
            {
                WorkspaceLogFilter.All,
                WorkspaceLogScopes.App,
                WorkspaceLogScopes.TestRunner,
                WorkspaceLogScopes.System
            };

            foreach (var scope in Logs
                         .Select(log => log.Scope)
                         .Where(scope => !string.IsNullOrWhiteSpace(scope))
                         .Distinct(StringComparer.Ordinal))
            {
                if (!scopes.Contains(scope, StringComparer.Ordinal))
                {
                    scopes.Add(scope);
                }
            }

            return scopes;
        }
    }

    private async Task ClearAsync()
    {
        if (OnClear.HasDelegate)
        {
            await OnClear.InvokeAsync();
        }
    }

    private void ResetFilters()
    {
        if (string.IsNullOrWhiteSpace(ForcedScope))
        {
            _scope = WorkspaceLogFilter.All;
        }

        _severity = WorkspaceLogFilter.All;
        _search = null;
    }

    private void SetScope(string scope)
        => _scope = scope;

    private void SetSeverity(string severity)
        => _severity = severity;

    private bool IsScopeSelected(string scope)
        => string.Equals(_scope, scope, StringComparison.Ordinal);

    private bool IsSeveritySelected(string severity)
        => string.Equals(_severity, severity, StringComparison.Ordinal);

    private static string FilterButtonClass(string selected, string option)
        => string.Equals(selected, option, StringComparison.Ordinal)
            ? "workspace-log-filter-button active"
            : "workspace-log-filter-button";

    private static string AriaPressed(bool selected)
        => selected ? "true" : "false";

    private static string ScopeLabel(string? scope)
        => scope switch
        {
            WorkspaceLogFilter.All => "All",
            WorkspaceLogScopes.App => "Runtime",
            WorkspaceLogScopes.TestRunner => "Tests",
            WorkspaceLogScopes.System => "System",
            { Length: > 0 } value => value,
            _ => "All"
        };

    private static string SeverityOptionLabel(string severity)
        => severity switch
        {
            WorkspaceLogFilter.All => "All",
            WorkspaceLogFilter.Problems => "Problems",
            _ => severity
        };

    private static string FormatLogTime(WorkspaceLogEntry entry)
        => entry.Timestamp.ToLocalTime().ToString("HH:mm:ss");

    private static string FormatLogDate(WorkspaceLogEntry entry)
        => entry.Timestamp.ToLocalTime().ToString("MMM d");

    private static string SourceCode(WorkspaceLogEntry entry)
        => string.IsNullOrWhiteSpace(entry.Code)
            ? entry.Source
            : $"{entry.Source} / {entry.Code}";

    private static string EntryScopeLabel(WorkspaceLogEntry entry)
    {
        var scope = ScopeLabel(entry.Scope);
        var artifact = ArtifactLabel(entry);
        return string.IsNullOrWhiteSpace(artifact) ? scope : $"{scope} - {artifact}";
    }

    private static IReadOnlyList<string> DetailLabels(WorkspaceLogEntry entry)
    {
        var labels = new List<string>(2);
        if (!string.IsNullOrWhiteSpace(entry.NodeName))
        {
            labels.Add(entry.NodeName);
        }

        if (!string.IsNullOrWhiteSpace(entry.PortName))
        {
            labels.Add(entry.PortName);
        }

        return labels;
    }

    private static string? ArtifactLabel(WorkspaceLogEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ArtifactKind) &&
            !string.IsNullOrWhiteSpace(entry.ArtifactName))
        {
            return $"{entry.ArtifactKind}: {entry.ArtifactName}";
        }

        if (!string.IsNullOrWhiteSpace(entry.ArtifactKind))
        {
            return entry.ArtifactKind;
        }

        if (!string.IsNullOrWhiteSpace(entry.WorkflowName))
        {
            return $"{WorkspaceLogArtifactKinds.Pipeline}: {entry.WorkflowName}";
        }

        return null;
    }

    private static string SeverityLabel(WorkspaceLogEntry entry)
        => WorkspaceLogFilter.NormalizeSeverity(entry);

    private static string SeverityClass(WorkspaceLogEntry entry)
        => SeverityClass(SeverityLabel(entry));

    private static string SeverityClass(string severity)
    {
        if (string.Equals(severity, WorkspaceLogFilter.Problems, StringComparison.OrdinalIgnoreCase))
        {
            return "problems";
        }

        return WorkspaceLogFilter.NormalizeSeverity(severity).ToLowerInvariant() switch
        {
            "critical" => "critical",
            "error" => "error",
            "warning" => "warning",
            "debug" => "debug",
            "trace" => "trace",
            _ => "info"
        };
    }

    private static string SeverityIcon(WorkspaceLogEntry entry)
        => SeverityLabel(entry) switch
        {
            "Critical" => Icons.Material.Filled.Report,
            "Error" => Icons.Material.Filled.ErrorOutline,
            "Warning" => Icons.Material.Filled.WarningAmber,
            "Debug" => Icons.Material.Filled.BugReport,
            "Trace" => Icons.Material.Filled.Timeline,
            _ => Icons.Material.Filled.Info
        };

    private static string FormatCount(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";
}

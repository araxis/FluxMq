@using FluxMq.UI.Models

<div class="@RootClass">
    <div class="workspace-log-header">
        <div class="workspace-log-title">
            <span class="workspace-log-title-icon">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            </span>
            <div>
                <h2>@Title</h2>
                <div class="workspace-log-subtitle">@SummaryLabel</div>
            </div>
        </div>

        <div class="workspace-log-actions">
            @foreach (var summary in SeveritySummaries)
            {
                <span class="workspace-log-summary @SeverityClass(summary.Severity)">
                    <span>@summary.Label</span>
                    <strong>@summary.Count</strong>
                </span>
            }
            <MudTooltip Text="Reset filters">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                               Size="Size.Small"
                               Class="workspace-log-icon-button"
                               Disabled="@(!HasActiveFilters)"
                               OnClick="ResetFilters" />
            </MudTooltip>
            <MudTooltip Text="Clear logs">
                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                               Size="Size.Small"
                               Class="workspace-log-icon-button danger"
                               Disabled="@(Logs.Count == 0)"
                               OnClick="ClearAsync" />
            </MudTooltip>
        </div>
    </div>

    <div class="workspace-log-toolbar">
        @if (string.IsNullOrWhiteSpace(ForcedScope))
        {
            <MudSelect T="string"
                       Label="Scope"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       @bind-Value="_scope"
                       Class="workspace-log-filter">
                @foreach (var scope in ScopeOptions)
                {
                    <MudSelectItem T="string" Value="@scope">@scope</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSelect T="string"
                   Label="Level"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   @bind-Value="_severity"
                   Class="workspace-log-filter">
            @foreach (var severity in SeverityOptions)
            {
                <MudSelectItem T="string" Value="@severity">@severity</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string"
                      Label="Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      @bind-Value="_search"
                      Class="workspace-log-search" />
    </div>

    <div class="workspace-log-list" role="log" aria-label="Workspace logs">
        @if (FilteredLogs.Count == 0)
        {
            <div class="workspace-log-empty">
                <MudIcon Icon="@EmptyIcon" Size="Size.Medium" />
                <strong>@EmptyTitle</strong>
                <span>@EmptyText</span>
                @if (HasActiveFilters)
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Class="workspace-log-empty-action"
                               OnClick="ResetFilters">
                        Reset filters
                    </MudButton>
                }
            </div>
        }
        else
        {
            @foreach (var entry in FilteredLogs)
            {
                <article class="workspace-log-row @SeverityClass(entry)" @key="entry">
                    <div class="workspace-log-row-time">
                        <span>@FormatLogTime(entry)</span>
                        <small>@FormatLogDate(entry)</small>
                    </div>
                    <div class="workspace-log-row-severity">
                        <span>@SeverityLabel(entry)</span>
                    </div>
                    <div class="workspace-log-row-body">
                        <div class="workspace-log-row-message">@entry.Message</div>
                        <div class="workspace-log-row-meta">
                            <span>@SourceCode(entry)</span>
                            <span>@entry.Scope</span>
                            @if (ArtifactLabel(entry) is { Length: > 0 } artifact)
                            {
                                <span>@artifact</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.NodeName))
                            {
                                <span>@entry.NodeName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.PortName))
                            {
                                <span>@entry.PortName</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Context))
                        {
                            <div class="workspace-log-row-context">@entry.Context</div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

@code {
    private static readonly string[] SeverityOptions =
    [
        WorkspaceLogFilter.All,
        "Critical",
        "Error",
        "Warning",
        "Info",
        "Debug",
        "Trace"
    ];

    private string _scope = WorkspaceLogFilter.All;
    private string _severity = WorkspaceLogFilter.All;
    private string? _search;

    [Parameter] public IReadOnlyList<WorkspaceLogEntry> Logs { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string Title { get; set; } = "Logs";
    [Parameter] public string? ForcedScope { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public int MaxEntries { get; set; } = 500;

    private string RootClass => Compact ? "workspace-log-shell compact" : "workspace-log-shell";
    private string EffectiveScope => string.IsNullOrWhiteSpace(ForcedScope) ? _scope : ForcedScope;
    private bool HasActiveFilters =>
        (string.IsNullOrWhiteSpace(ForcedScope) &&
         !string.Equals(_scope, WorkspaceLogFilter.All, StringComparison.Ordinal)) ||
        !string.Equals(_severity, WorkspaceLogFilter.All, StringComparison.Ordinal) ||
        !string.IsNullOrWhiteSpace(_search);

    private IReadOnlyList<WorkspaceLogEntry> FilteredLogs =>
        WorkspaceLogFilter.Apply(Logs, new WorkspaceLogQuery(EffectiveScope, _severity, _search), MaxEntries);

    private string SummaryLabel => Logs.Count == 0
        ? "No entries recorded"
        : $"{FilteredLogs.Count} shown / {Logs.Count} total";

    private string EmptyIcon => HasActiveFilters
        ? Icons.Material.Filled.SearchOff
        : Icons.Material.Filled.ReceiptLong;

    private string EmptyTitle => HasActiveFilters ? "No matching logs" : "No logs yet";

    private string EmptyText => HasActiveFilters
        ? "Reset filters or adjust the search text."
        : "Validate, run, or test the app to record workspace events.";

    private IReadOnlyList<SeveritySummary> SeveritySummaries
    {
        get
        {
            var counts = Logs
                .GroupBy(WorkspaceLogFilter.NormalizeSeverity, StringComparer.Ordinal)
                .ToDictionary(group => group.Key, group => group.Count(), StringComparer.Ordinal);

            return
            [
                new("Error", "Errors", counts.GetValueOrDefault("Error") + counts.GetValueOrDefault("Critical")),
                new("Warning", "Warnings", counts.GetValueOrDefault("Warning")),
                new("Info", "Other", Logs.Count -
                    counts.GetValueOrDefault("Error") -
                    counts.GetValueOrDefault("Critical") -
                    counts.GetValueOrDefault("Warning"))
            ];
        }
    }

    private IReadOnlyList<string> ScopeOptions
    {
        get
        {
            var scopes = new List<string>
            {
                WorkspaceLogFilter.All,
                WorkspaceLogScopes.App,
                WorkspaceLogScopes.TestRunner,
                WorkspaceLogScopes.System
            };

            foreach (var scope in Logs
                         .Select(log => log.Scope)
                         .Where(scope => !string.IsNullOrWhiteSpace(scope))
                         .Distinct(StringComparer.Ordinal))
            {
                if (!scopes.Contains(scope, StringComparer.Ordinal))
                {
                    scopes.Add(scope);
                }
            }

            return scopes;
        }
    }

    private async Task ClearAsync()
    {
        if (OnClear.HasDelegate)
        {
            await OnClear.InvokeAsync();
        }
    }

    private void ResetFilters()
    {
        if (string.IsNullOrWhiteSpace(ForcedScope))
        {
            _scope = WorkspaceLogFilter.All;
        }

        _severity = WorkspaceLogFilter.All;
        _search = null;
    }

    private static string FormatLogTime(WorkspaceLogEntry entry)
        => entry.Timestamp.ToLocalTime().ToString("HH:mm:ss");

    private static string FormatLogDate(WorkspaceLogEntry entry)
        => entry.Timestamp.ToLocalTime().ToString("MMM d");

    private static string SourceCode(WorkspaceLogEntry entry)
        => string.IsNullOrWhiteSpace(entry.Code)
            ? entry.Source
            : $"{entry.Source} / {entry.Code}";

    private static string? ArtifactLabel(WorkspaceLogEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ArtifactKind) &&
            !string.IsNullOrWhiteSpace(entry.ArtifactName))
        {
            return $"{entry.ArtifactKind}: {entry.ArtifactName}";
        }

        if (!string.IsNullOrWhiteSpace(entry.ArtifactKind))
        {
            return entry.ArtifactKind;
        }

        if (!string.IsNullOrWhiteSpace(entry.WorkflowName))
        {
            return $"{WorkspaceLogArtifactKinds.Pipeline}: {entry.WorkflowName}";
        }

        return null;
    }

    private static Color LevelColor(WorkspaceLogEntry entry)
        => WorkspaceLogFilter.NormalizeSeverity(entry) switch
        {
            "Critical" => Color.Error,
            "Error" => Color.Error,
            "Warning" => Color.Warning,
            "Debug" => Color.Info,
            "Trace" => Color.Secondary,
            _ => Color.Success
        };

    private static string SeverityLabel(WorkspaceLogEntry entry)
        => WorkspaceLogFilter.NormalizeSeverity(entry);

    private static string SeverityClass(WorkspaceLogEntry entry)
        => SeverityClass(WorkspaceLogFilter.NormalizeSeverity(entry));

    private static string SeverityClass(string severity)
        => WorkspaceLogFilter.NormalizeSeverity(severity).ToLowerInvariant() switch
        {
            "critical" => "critical",
            "error" => "error",
            "warning" => "warning",
            "debug" => "debug",
            "trace" => "trace",
            _ => "info"
        };

    private sealed record SeveritySummary(string Severity, string Label, int Count);
}

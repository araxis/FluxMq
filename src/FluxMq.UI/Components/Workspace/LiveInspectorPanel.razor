@implements IDisposable
@inject LiveMqttWorkspaceService Live

<MudStack Spacing="2" Class="pa-2">

    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Traffic</MudText>
        @if (!string.IsNullOrWhiteSpace(_selectedTopic))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="@ClearTopic">@_selectedTopic</MudChip>
        }
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@DisplayedMessages.Count</MudChip>
    </MudStack>

    <MudPaper Elevation="0" Outlined="true" Class="pa-2">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Publish</MudText>
        <MudTextField T="string" Label="Topic" @bind-Value="_publishTopic" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField T="string" Label="Payload" @bind-Value="_publishPayload" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@_busy" OnClick="@PublishAsync" Class="mt-1">Publish</MudButton>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@(_treeView ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.ListAlt)"
                     Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.subtitle2" Class="flex-grow-1">@(_treeView ? "Topics" : "Messages")</MudText>
            <MudToggleIconButton @bind-Toggled="_treeView"
                                 Icon="@Icons.Material.Filled.ListAlt"
                                 ToggledIcon="@Icons.Material.Filled.AccountTree"
                                 Size="Size.Small" />
        </MudStack>

        <MudTextField T="string"
                      @bind-Value="_filter"
                      Placeholder="@(_treeView ? "Filter topics…" : "Filter messages…")"
                      Immediate="true"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mb-2" />

        @if (_treeView)
        {
            <TopicTreeView Messages="@MessageSource"
                           SelectedTopic="@_selectedTopic"
                           TopicSelected="@OnTopicSelected"
                           Filter="@_filter" />
        }
        else
        {
            <MudTable T="MqttEnvelope" Items="@FilteredTableMessages" Dense="true" Hover="true" Elevation="0"
                      RowsPerPage="10" SelectOnRowClick="true"
                      SelectedItem="@Live.SelectedMessage"
                      SelectedItemChanged="@OnSelectionChanged">
                <HeaderContent>
                    <MudTh>Topic</MudTh>
                    <MudTh>Bytes</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Topic">
                        <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width:160px; display:block">@context.Topic</MudText>
                    </MudTd>
                    <MudTd DataLabel="Bytes">@context.Payload.Length</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyView Message="No messages" />
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager HideRowsPerPage="true" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>

    <PayloadInspectorPanel Title="Payload"
                           Topic="@Live.SelectedMessage?.Topic"
                           ReceivedAt="@Live.SelectedMessage?.ReceivedAt"
                           Payload="@Live.SelectedMessage?.Payload" />


</MudStack>

@code {
    private bool _busy;
    private bool _treeView = true;
    private string _publishTopic = "fluxmq/test";
    private string _publishPayload = "{\"hello\":\"fluxmq\"}";
    private string? _selectedTopic;
    private string _filter = string.Empty;

    private IReadOnlyList<MqttEnvelope> MessageSource => Live.SelectedStoredSession is null
        ? Live.RecentMessages
        : Live.SelectedSessionMessages;

    private IReadOnlyList<MqttEnvelope> DisplayedMessages => string.IsNullOrWhiteSpace(_selectedTopic)
        ? MessageSource
        : MessageSource.Where(message => IsInSelectedTopic(message.Topic)).ToArray();

    private IReadOnlyList<MqttEnvelope> FilteredTableMessages =>
        string.IsNullOrWhiteSpace(_filter)
            ? DisplayedMessages
            : DisplayedMessages.Where(m => m.Topic.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();

    protected override void OnInitialized() => Live.Changed += OnChanged;

    private async Task PublishAsync()
    {
        _busy = true;
        try { await Live.PublishAsync(_publishTopic, _publishPayload); }
        finally { _busy = false; StateHasChanged(); }
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnSelectionChanged(MqttEnvelope? msg)
    {
        if (msg is not null)
            Live.SelectMessage(msg);
    }

    private void OnTopicSelected(string? topic)
    {
        _selectedTopic = topic;
        if (string.IsNullOrWhiteSpace(topic)) return;
        var latest = DisplayedMessages.OrderByDescending(m => m.ReceivedAt).FirstOrDefault();
        if (latest is not null)
            Live.SelectMessage(latest);
    }

    private void ClearTopic() => _selectedTopic = null;

    private bool IsInSelectedTopic(string topic)
    {
        if (string.IsNullOrWhiteSpace(_selectedTopic)) return true;
        return string.Equals(topic, _selectedTopic, StringComparison.Ordinal) ||
               topic.StartsWith($"{_selectedTopic}/", StringComparison.Ordinal);
    }

    public void Dispose() => Live.Changed -= OnChanged;
}

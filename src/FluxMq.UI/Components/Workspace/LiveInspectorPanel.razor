@implements IDisposable
@using FluxMq.Core.Payloads
@using FluxMq.UI.Models
@using System.Text
@using MQTTnet.Protocol
@inject LiveMqttWorkspaceService Live
@inject ProjectManagerService Projects

<div class="inspector-shell">
    <div class="inspector-tabs" role="tablist" aria-label="Inspector views">
        <button type="button"
                class="inspector-tab @(_activeTab == InspectorTab.Inspect ? "active" : null)"
                @onclick="@(() => _activeTab = InspectorTab.Inspect)">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <span>Inspect</span>
        </button>
        <button type="button"
                class="inspector-tab @(_activeTab == InspectorTab.Publish ? "active" : null)"
                @onclick="@(() => _activeTab = InspectorTab.Publish)">
            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
            <span>Publish</span>
        </button>
        <button type="button"
                class="inspector-tab @(_activeTab == InspectorTab.Topics ? "active" : null)"
                @onclick="@(() => _activeTab = InspectorTab.Topics)">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            <span>Topics</span>
            @if (DisplayedMessages.Count > 0)
            {
                <span class="tab-count">@DisplayedMessages.Count</span>
            }
        </button>
    </div>

    @if (_activeTab == InspectorTab.Publish)
    {
        <div class="publish-view">
            <div class="inspector-panel publish-form-panel">
                @if (PublishConnections.Count > 0)
                {
                    <label class="publish-field">
                        <span class="field-label">Broker</span>
                        <select class="publish-input" @bind="_publishConnectionId">
                            @foreach (var connection in PublishConnections)
                            {
                                <option value="@connection.Id.ToString()">
                                    @connection.ResourceName (@connection.Profile.Host:@connection.Profile.Port)
                                </option>
                            }
                        </select>
                    </label>
                }

                <label class="publish-field">
                    <span class="field-label">Topic</span>
                    <input class="publish-input" @bind="_publishTopic" />
                </label>

                <label class="publish-field">
                    <span class="field-label split">
                        <span>Payload</span>
                        <span>@PayloadMeta</span>
                    </span>
                    <textarea class="publish-textarea" spellcheck="false" @bind="_publishPayload"></textarea>
                </label>

                <div class="publish-row">
                    <label class="select-pill" aria-label="Quality of service">
                        <select @bind="_publishQos">
                            <option value="@MqttQualityOfServiceLevel.AtMostOnce">QoS 0</option>
                            <option value="@MqttQualityOfServiceLevel.AtLeastOnce">QoS 1</option>
                            <option value="@MqttQualityOfServiceLevel.ExactlyOnce">QoS 2</option>
                        </select>
                    </label>
                    <button type="button"
                            class="pill-button publish-retain @(_retain ? "active" : null)"
                            @onclick="@(() => _retain = !_retain)">
                        <span>Retain</span>
                        <strong>@(_retain ? "On" : "Off")</strong>
                    </button>
                    <button type="button"
                            class="publish-submit"
                            disabled="@_busy"
                            @onclick="PublishAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                        <span>Publish</span>
                    </button>
                </div>

                @if (Live.SelectedStoredSession is not null)
                {
                    <div class="stored-session-note">
                        <span>@Live.SelectedStoredSession.Name</span>
                        <button type="button" @onclick="@Live.ClearStoredSessionSelection">Switch to live</button>
                    </div>
                }
            </div>

            <div class="inspector-panel live-topic-panel">
                <div class="section-label">
                    <span>Live topics</span>
                    @if (LiveTopicRows.Count > 0)
                    {
                        <span class="section-badge">@LiveTopicRows.Count</span>
                    }
                </div>

                <div class="live-topic-list">
                    @if (LiveTopicRows.Count == 0)
                    {
                        <div class="empty-topic-row">No topics yet</div>
                    }
                    else
                    {
                        @foreach (var topic in LiveTopicRows)
                        {
                            <button type="button"
                                    class="live-topic-row @(string.Equals(topic.Topic, _selectedTopic, StringComparison.Ordinal) ? "active" : null)"
                                    @onclick="@(() => OnTopicSelected(topic.Topic))">
                                <span class="live-topic-dot @(topic.IsHot ? "hot" : null)"></span>
                                <span class="live-topic-name">@topic.Topic</span>
                                <span class="live-topic-rate">@topic.RateLabel</span>
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="inspector-panel last-payload-panel">
                <div class="section-label">
                    <span>Last payload</span>
                    @if (LastPayloadMessage is not null)
                    {
                        <span>@LastPayloadMeta</span>
                    }
                </div>
                <pre class="last-payload-body">@LastPayloadPreview</pre>
            </div>
        </div>
    }
    else if (_activeTab == InspectorTab.Topics)
    {
        <div class="inspector-panel fill">
            <div class="section-label">
                <span>Live topics</span>
                <span class="section-badge">@MessageSource.Count msgs</span>
            </div>

            <div class="topic-toolbar">
                <button type="button" class="icon-toggle" @onclick="@(() => _treeView = !_treeView)">
                    <MudIcon Icon="@(_treeView ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.ListAlt)"
                             Size="Size.Small" />
                </button>
                <input class="topic-filter"
                       placeholder="@(_treeView ? "Filter topics..." : "Filter messages...")"
                       @bind="_filter"
                       @bind:event="oninput" />
            </div>

            @if (_treeView)
            {
                <TopicTreeView Messages="@MessageSource"
                               SelectedTopic="@_selectedTopic"
                               TopicSelected="@OnTopicSelected"
                               Filter="@_filter" />
            }
            else
            {
                <MudTable T="MqttEnvelope" Items="@FilteredTableMessages" Dense="true" Hover="true"
                          Elevation="0" RowsPerPage="10" SelectOnRowClick="true"
                          SelectedItem="@Live.SelectedMessage"
                          SelectedItemChanged="@OnSelectionChanged">
                    <HeaderContent>
                        <MudTh>Topic</MudTh>
                        <MudTh>Bytes</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Topic">
                            <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width:160px;display:block">
                                @context.Topic
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Bytes">@context.Payload.Length</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <EmptyView Message="No messages" />
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager HideRowsPerPage="true" />
                    </PagerContent>
                </MudTable>
            }
        </div>
    }
    else
    {
        <div class="inspector-panel fill">
            <PayloadInspectorPanel Title="Payload"
                                   Topic="@Live.SelectedMessage?.Topic"
                                   ReceivedAt="@Live.SelectedMessage?.ReceivedAt"
                                   Payload="@Live.SelectedMessage?.Payload" />
        </div>
    }
</div>

@code {
    private InspectorTab _activeTab = InspectorTab.Publish;
    private bool _busy;
    private bool _treeView = true;
    private string _publishConnectionId = string.Empty;
    private string _publishTopic = "fluxmq/test";
    private string _publishPayload = "{\"hello\":\"fluxmq\"}";
    private MqttQualityOfServiceLevel _publishQos = MqttQualityOfServiceLevel.AtMostOnce;
    private bool _retain;
    private string? _selectedTopic;
    private string _filter = string.Empty;
    private System.Threading.Timer? _clock;
    private FlowWorkspaceService? _activeProject;

    private IReadOnlyList<MqttEnvelope> MessageSource => Live.SelectedStoredSession is null
        ? Live.RecentMessages
        : Live.SelectedSessionMessages;

    private IReadOnlyList<MqttEnvelope> DisplayedMessages => string.IsNullOrWhiteSpace(_selectedTopic)
        ? MessageSource
        : MessageSource.Where(m => IsInSelectedTopic(m.Topic)).ToArray();

    private IReadOnlyList<MqttEnvelope> FilteredTableMessages =>
        string.IsNullOrWhiteSpace(_filter)
            ? DisplayedMessages
            : DisplayedMessages.Where(m => m.Topic.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<LiveTopicRow> LiveTopicRows => BuildLiveTopicRows();

    private IReadOnlyList<ManagedConnection> PublishConnections => BuildPublishConnections();

    private MqttEnvelope? LastPayloadMessage => MessageSource
        .OrderByDescending(m => m.ReceivedAt)
        .FirstOrDefault();

    private string LastPayloadMeta
    {
        get
        {
            var message = LastPayloadMessage;
            if (message is null)
                return "idle";

            var age = DateTimeOffset.UtcNow - message.ReceivedAt;
            var ageText = age.TotalSeconds < 60
                ? $"{Math.Max(0, age.TotalSeconds):0}s ago"
                : $"{Math.Max(1, age.TotalMinutes):0}m ago";

            return $"{ageText} / {message.Payload.Length} B";
        }
    }

    private string LastPayloadPreview
    {
        get
        {
            var message = LastPayloadMessage;
            if (message is null)
                return "No payload captured.";

            var inspection = PayloadInspector.Inspect(message.Payload);
            return string.IsNullOrWhiteSpace(inspection.FormattedText)
                ? inspection.HexDump
                : inspection.FormattedText;
        }
    }

    private string PayloadMeta
    {
        get
        {
            var payload = Encoding.UTF8.GetBytes(_publishPayload);
            var inspection = PayloadInspector.Inspect(payload);
            return $"{inspection.DisplayTypeLabel} / {payload.Length} B";
        }
    }

    protected override void OnInitialized()
    {
        Live.Changed += OnChanged;
        Projects.Changed += OnProjectsChanged;
        SyncActiveProjectSubscription();
        EnsurePublishBrokerSelection();
        _clock = new System.Threading.Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task PublishAsync()
    {
        EnsurePublishBrokerSelection();
        _busy = true;
        try
        {
            var connectionId = Guid.TryParse(_publishConnectionId, out var parsedConnectionId)
                ? parsedConnectionId
                : (Guid?)null;
            var selectedConnection = connectionId is { } id
                ? PublishConnections.FirstOrDefault(connection => connection.Id == id)
                : null;

            var published = await Live.PublishAsync(connectionId, _publishTopic, _publishPayload, _publishQos, _retain);
            if (published)
            {
                Projects.ActiveProject?.RecordManualMqttPublish(
                    _publishTopic,
                    _publishPayload,
                    (int)_publishQos,
                    _retain,
                    selectedConnection?.ResourceName);
            }
        }
        finally { _busy = false; StateHasChanged(); }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectsChanged(object? sender, EventArgs e)
    {
        SyncActiveProjectSubscription();
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e)
    {
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSelectionChanged(MqttEnvelope? msg)
    {
        if (msg is not null)
            Live.SelectMessage(msg);
    }

    private void OnTopicSelected(string? topic)
    {
        _selectedTopic = topic;
        if (string.IsNullOrWhiteSpace(topic)) return;
        var latest = DisplayedMessages.OrderByDescending(m => m.ReceivedAt).FirstOrDefault();
        if (latest is not null)
            Live.SelectMessage(latest);
    }

    private bool IsInSelectedTopic(string topic) =>
        string.IsNullOrWhiteSpace(_selectedTopic) ||
        string.Equals(topic, _selectedTopic, StringComparison.Ordinal) ||
        topic.StartsWith($"{_selectedTopic}/", StringComparison.Ordinal);

    private IReadOnlyList<ManagedConnection> BuildPublishConnections()
    {
        var appConnectionOrder = (Projects.ActiveProject?.GetConnectionNames() ?? [])
            .Select((name, index) => (Name: name, Index: index))
            .ToDictionary(item => item.Name, item => item.Index, StringComparer.Ordinal);

        return Live.Connections
            .OrderBy(connection => appConnectionOrder.TryGetValue(connection.ResourceName, out var index)
                ? index
                : int.MaxValue)
            .ThenBy(connection => connection.ResourceName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void EnsurePublishBrokerSelection()
    {
        var connections = PublishConnections;
        if (connections.Count == 0)
        {
            _publishConnectionId = string.Empty;
            return;
        }

        if (Guid.TryParse(_publishConnectionId, out var selectedId) &&
            connections.Any(connection => connection.Id == selectedId))
        {
            return;
        }

        _publishConnectionId = connections[0].Id.ToString();
    }

    private void SyncActiveProjectSubscription()
    {
        var activeProject = Projects.ActiveProject;
        if (ReferenceEquals(_activeProject, activeProject))
        {
            return;
        }

        if (_activeProject is not null)
        {
            _activeProject.Changed -= OnProjectChanged;
        }

        _activeProject = activeProject;

        if (_activeProject is not null)
        {
            _activeProject.Changed += OnProjectChanged;
        }
    }

    private IReadOnlyList<LiveTopicRow> BuildLiveTopicRows()
    {
        var now = DateTimeOffset.UtcNow;
        var windowStart = now.AddSeconds(-10);

        return MessageSource
            .GroupBy(m => m.Topic, StringComparer.Ordinal)
            .Select(group =>
            {
                var latest = group.Max(m => m.ReceivedAt);
                var recentCount = group.Count(m => m.ReceivedAt >= windowStart);
                var rate = recentCount / 10d;

                return new LiveTopicRow(
                    group.Key,
                    now - latest < TimeSpan.FromSeconds(15),
                    rate >= 10 ? $"{rate:0}/s" : $"{rate:0.0}/s");
            })
            .OrderByDescending(row => row.IsHot)
            .ThenBy(row => row.Topic, StringComparer.Ordinal)
            .Take(8)
            .ToArray();
    }

    public void Dispose()
    {
        Live.Changed -= OnChanged;
        Projects.Changed -= OnProjectsChanged;
        if (_activeProject is not null)
        {
            _activeProject.Changed -= OnProjectChanged;
        }

        _clock?.Dispose();
    }

    private sealed record LiveTopicRow(string Topic, bool IsHot, string RateLabel);

    private enum InspectorTab
    {
        Inspect,
        Publish,
        Topics
    }
}

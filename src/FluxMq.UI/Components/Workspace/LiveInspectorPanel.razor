@implements IDisposable
@using FluxMq.Core.Mqtt
@using FluxMq.Core.Payloads
@using FluxMq.UI.Models
@using System.Text
@using MQTTnet.Protocol
@inject LiveMqttWorkspaceService Live
@inject ProjectManagerService Projects

<div class="publisher-shell">
    <header class="publisher-header">
        <div class="publisher-title-lockup">
            <span class="publisher-icon">
                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
            </span>
            <span class="publisher-title-text">
                <strong>MQTT Publisher</strong>
                <span>@ActiveAppLabel</span>
            </span>
        </div>
        <span class="@ConnectionMarkerClass">@ConnectionMarkerLabel</span>
    </header>

    <section class="publisher-panel publish-form-panel">
        <div class="publish-form-grid">
            <label class="publish-field broker">
                <span class="field-label split">
                    <span>MQTT client</span>
                    <span>@ClientCountLabel</span>
                </span>
                @if (PublishConnections.Count > 0)
                {
                    <select class="publish-input" @bind="_publishConnectionId">
                        @foreach (var connection in PublishConnections)
                        {
                            <option value="@connection.Id.ToString()">
                                @connection.ResourceName (@connection.Profile.Host:@connection.Profile.Port)
                            </option>
                        }
                    </select>
                }
                else
                {
                    <div class="publish-empty">No MQTT clients</div>
                }
            </label>

            <label class="publish-field topic">
                <span class="field-label">Topic</span>
                <input class="publish-input" @bind="_publishTopic" />
            </label>

            <label class="publish-field payload">
                <span class="field-label split">
                    <span>Payload</span>
                    <span>@PayloadMeta</span>
                </span>
                <textarea class="publish-textarea" spellcheck="false" @bind="_publishPayload"></textarea>
            </label>

            <div class="publish-row">
                <label class="publish-qos-select" aria-label="Quality of service">
                    <select @bind="_publishQos">
                        <option value="@MqttQualityOfServiceLevel.AtMostOnce">QoS 0</option>
                        <option value="@MqttQualityOfServiceLevel.AtLeastOnce">QoS 1</option>
                        <option value="@MqttQualityOfServiceLevel.ExactlyOnce">QoS 2</option>
                    </select>
                </label>
                <button type="button"
                        class="publish-retain-toggle @(_retain ? "active" : null)"
                        aria-pressed="@(_retain ? "true" : "false")"
                        @onclick="@(() => _retain = !_retain)">
                    <span>Retain</span>
                    <strong>@(_retain ? "On" : "Off")</strong>
                </button>
                <button type="button"
                        class="publish-submit"
                        disabled="@(!CanPublish)"
                        @onclick="PublishAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                    <span>@PublishButtonLabel</span>
                </button>
            </div>
        </div>
    </section>

    <section class="publisher-panel diagnostics-panel">
        <div class="section-label">
            <span>MQTT connection</span>
            @if (LatestDiagnostic is not null)
            {
                <span>@LatestDiagnostic.Code</span>
            }
        </div>

        @if (LatestDiagnostic is null)
        {
            <div class="publisher-diagnostic muted">Idle</div>
        }
        else
        {
            <div class="@LatestDiagnosticClass">
                <MudIcon Icon="@LatestDiagnosticIcon" Size="Size.Small" />
                <span>@LatestDiagnostic.Message</span>
            </div>
        }
    </section>
</div>

@code {
    private bool _busy;
    private string _publishConnectionId = string.Empty;
    private string _publishTopic = "fluxmq/test";
    private string _publishPayload = "{\"hello\":\"fluxmq\"}";
    private MqttQualityOfServiceLevel _publishQos = MqttQualityOfServiceLevel.AtMostOnce;
    private bool _retain;
    private FlowWorkspaceService? _activeProject;

    private IReadOnlyList<ManagedConnection> PublishConnections => BuildPublishConnections();

    private ManagedConnection? SelectedConnection
    {
        get
        {
            EnsurePublishBrokerSelection();
            return Guid.TryParse(_publishConnectionId, out var selectedId)
                ? PublishConnections.FirstOrDefault(connection => connection.Id == selectedId)
                : null;
        }
    }

    private WorkspaceDiagnostic? LatestDiagnostic => Live.Diagnostics.LastOrDefault();

    private bool CanPublish =>
        !_busy &&
        SelectedConnection is not null &&
        !string.IsNullOrWhiteSpace(_publishTopic);

    private string ActiveAppLabel => Projects.ActiveProject is null
        ? "No active app"
        : Projects.ActiveProject.Name;

    private string ClientCountLabel => PublishConnections.Count switch
    {
        0 => "0 clients",
        1 => "1 client",
        var count => $"{count} clients"
    };

    private string ConnectionMarkerLabel => SelectedConnection?.State.ToString() ?? "No client";

    private string ConnectionMarkerClass => SelectedConnection?.State switch
    {
        MqttClientState.Connected => "connection-marker connected",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "connection-marker pending",
        MqttClientState.Faulted => "connection-marker faulted",
        _ => "connection-marker"
    };

    private string LatestDiagnosticClass => LatestDiagnostic?.Severity switch
    {
        "Error" => "publisher-diagnostic error",
        "Warning" => "publisher-diagnostic warning",
        "Info" => "publisher-diagnostic info",
        _ => "publisher-diagnostic muted"
    };

    private string LatestDiagnosticIcon => LatestDiagnostic?.Severity switch
    {
        "Error" => Icons.Material.Filled.ErrorOutline,
        "Warning" => Icons.Material.Filled.WarningAmber,
        "Info" => Icons.Material.Filled.CheckCircleOutline,
        _ => Icons.Material.Filled.Info
    };

    private string PublishButtonLabel => _busy ? "Publishing" : "Publish";

    private string PayloadMeta
    {
        get
        {
            var payload = Encoding.UTF8.GetBytes(_publishPayload);
            var inspection = PayloadInspector.Inspect(payload);
            return $"{inspection.DisplayTypeLabel} / {payload.Length} B";
        }
    }

    protected override void OnInitialized()
    {
        Live.Changed += OnChanged;
        Projects.Changed += OnProjectsChanged;
        SyncActiveProjectSubscription();
        EnsureLiveConnectionsForActiveProject();
        EnsurePublishBrokerSelection();
    }

    private async Task PublishAsync()
    {
        var connection = SelectedConnection;
        if (connection is null)
        {
            return;
        }

        _busy = true;
        try
        {
            if (connection.State != MqttClientState.Connected)
            {
                await Live.ConnectAsync(connection.Id);
            }

            var connectedConnection = PublishConnections.FirstOrDefault(item => item.Id == connection.Id);
            if (connectedConnection?.State != MqttClientState.Connected)
            {
                return;
            }

            var published = await Live.PublishAsync(
                connectedConnection.Id,
                _publishTopic,
                _publishPayload,
                _publishQos,
                _retain);

            if (published)
            {
                Projects.ActiveProject?.RecordManualMqttPublish(
                    _publishTopic,
                    _publishPayload,
                    (int)_publishQos,
                    _retain,
                    connectedConnection.ResourceName);
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectsChanged(object? sender, EventArgs e)
    {
        SyncActiveProjectSubscription();
        EnsureLiveConnectionsForActiveProject();
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e)
    {
        EnsureLiveConnectionsForActiveProject();
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<ManagedConnection> BuildPublishConnections()
    {
        var projectConnections = Projects.ActiveProject?.GetConnectionResources() ?? [];
        var appConnectionOrder = projectConnections
            .Select((connection, index) => (connection.Name, Index: index))
            .ToDictionary(item => item.Name, item => item.Index, StringComparer.Ordinal);

        var liveConnections = Live.Connections;
        if (Projects.ActiveProject is not null)
        {
            liveConnections = liveConnections
                .Where(connection => appConnectionOrder.ContainsKey(connection.ResourceName))
                .ToArray();
        }

        return liveConnections
            .OrderBy(connection => appConnectionOrder.TryGetValue(connection.ResourceName, out var index)
                ? index
                : int.MaxValue)
            .ThenBy(connection => connection.ResourceName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void EnsureLiveConnectionsForActiveProject()
    {
        if (Projects.ActiveProject is not { } project)
        {
            return;
        }

        foreach (var (name, profile, subscription) in project.GetConnectionResources())
        {
            Live.AddConnectionIfAbsent(profile, subscription, name);
        }
    }

    private void EnsurePublishBrokerSelection()
    {
        var connections = BuildPublishConnections();
        if (connections.Count == 0)
        {
            _publishConnectionId = string.Empty;
            return;
        }

        if (Guid.TryParse(_publishConnectionId, out var selectedId) &&
            connections.Any(connection => connection.Id == selectedId))
        {
            return;
        }

        _publishConnectionId = connections[0].Id.ToString();
    }

    private void SyncActiveProjectSubscription()
    {
        var activeProject = Projects.ActiveProject;
        if (ReferenceEquals(_activeProject, activeProject))
        {
            return;
        }

        if (_activeProject is not null)
        {
            _activeProject.Changed -= OnProjectChanged;
        }

        _activeProject = activeProject;

        if (_activeProject is not null)
        {
            _activeProject.Changed += OnProjectChanged;
        }
    }

    public void Dispose()
    {
        Live.Changed -= OnChanged;
        Projects.Changed -= OnProjectsChanged;
        if (_activeProject is not null)
        {
            _activeProject.Changed -= OnProjectChanged;
        }
    }
}

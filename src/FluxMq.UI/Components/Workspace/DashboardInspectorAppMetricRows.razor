@using FluxMq.App.Metrics

<PropertyGridRow Name="Metric">
    <PropertyGridSelect Value="@(MetricId ?? string.Empty)"
                        Options="@MetricOptions"
                        AriaLabel="Metric"
                        ValueChanged="@MetricChanged" />
</PropertyGridRow>
@foreach (var parameter in Parameters)
{
    var currentParameter = parameter;
    <PropertyGridRow Name="@currentParameter.DisplayName">
        @RenderParameterField(currentParameter)
    </PropertyGridRow>
}
<PropertyGridRow Name="Preview">
    <span class="property-grid-cell-text" title="@Summary">@Preview</span>
</PropertyGridRow>
<PropertyGridRow Name="Actions">
    <button type="button"
            class="property-grid-action-button"
            disabled="@string.IsNullOrWhiteSpace(MetricId)"
            @onclick="@(() => OpenMetric.InvokeAsync())">Open metric</button>
</PropertyGridRow>

@code {
    private const string TrueValue = "true";
    private const string FalseValue = "false";

    [Parameter]
    public string? MetricId { get; set; }

    [Parameter]
    public IReadOnlyList<PropertyGridSelectOption> MetricOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<MetricParamSpec> Parameters { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, string> ParameterValues { get; set; } =
        new Dictionary<string, string>(StringComparer.Ordinal);

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public string Preview { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string?> MetricChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> ParameterChanged { get; set; }

    [Parameter]
    public EventCallback OpenMetric { get; set; }

    private RenderFragment RenderParameterField(MetricParamSpec parameter)
    {
        var value = ParameterValue(parameter);
        if (parameter.Kind == MetricParamKind.Select && parameter.Options is { Count: > 0 })
        {
            return @<PropertyGridSelect Value="@value"
                                        Options="@ParameterSelectOptions(parameter)"
                                        AriaLabel="@parameter.DisplayName"
                                        ValueChanged="@((string? next) => SetParameterAsync(parameter.Key, next))" />;
        }

        if (parameter.Kind == MetricParamKind.Toggle)
        {
            return @<div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(value, TrueValue)"
                        @onclick="@(() => SetParameterAsync(parameter.Key, TrueValue))">On</button>
                <button type="button"
                        class="@ChoiceClass(value, FalseValue)"
                        @onclick="@(() => SetParameterAsync(parameter.Key, FalseValue))">Off</button>
            </div>;
        }

        return @<input class="property-grid-input"
                       value="@value"
                       @oninput="@((ChangeEventArgs args) => SetParameterAsync(parameter.Key, args.Value?.ToString()))" />;
    }

    private string ParameterValue(MetricParamSpec parameter)
        => ParameterValues.TryGetValue(parameter.Key, out var value)
            ? value
            : parameter.DefaultValue ?? string.Empty;

    private Task SetParameterAsync(string key, string? value)
        => ParameterChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private static IReadOnlyList<PropertyGridSelectOption> ParameterSelectOptions(MetricParamSpec parameter)
        => [
            new("", parameter.Required ? "Select value" : "Default"),
            .. (parameter.Options ?? []).Select(static option => new PropertyGridSelectOption(option.Value, option.Label))
        ];

    private static string ChoiceClass(string? currentValue, string value)
        => string.Equals(currentValue ?? string.Empty, value, StringComparison.Ordinal)
            ? "property-grid-choice selected"
            : "property-grid-choice";
}

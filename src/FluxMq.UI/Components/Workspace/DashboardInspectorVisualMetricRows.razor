@using FluxMq.UI.Models
@using FluxMq.UI.Services
@using MudBlazor
@using System.Globalization

@if (Draft is not null)
{
    <PropertyGridRow Name="@Labels.PrimaryCardRow">
        @if (PrimaryMetricSegmentOptions.Count > 0)
        {
            <PropertyGridIconSegment Value="@Draft.PrimaryMetric"
                                     Options="@PrimaryMetricSegmentOptions"
                                     AriaLabel="@Labels.PrimaryCardRow"
                                     ShowLabels="true"
                                     ValueChanged="@PrimaryMetricChanged" />
        }
        else
        {
            <PropertyGridSelect Value="@Draft.PrimaryMetric"
                                Options="@MetricOptions"
                                AriaLabel="@Labels.PrimaryCardRow"
                                ValueChanged="@PrimaryMetricChanged" />
        }
    </PropertyGridRow>

    @if (Draft.Profile.SupportsMetricSlots)
    {
        @foreach (var item in Draft.DisplayMetrics.Select((metric, index) => new { Metric = metric, Index = index }))
        {
            var currentMetric = item.Metric;
            var currentMetricLabel = VisualMetricLabel(currentMetric);
            <PropertyGridRow Name="@($"{Labels.CardRowPrefix} {item.Index + 1}")">
                <div class="property-grid-inline visual-metric-row">
                    <span class="visual-metric-position" aria-label="@($"Card position {item.Index + 1}")">
                        @((item.Index + 1).ToString(CultureInfo.InvariantCulture))
                    </span>
                    <span class="visual-metric-copy">
                        <span class="visual-metric-label" title="@currentMetricLabel">
                            @currentMetricLabel
                        </span>
                        <small>@currentMetric</small>
                    </span>
                    <span class="visual-metric-actions" aria-label="@MetricCardCommandsLabel(currentMetricLabel)">
                        <button type="button"
                                class="visual-metric-icon-button"
                                title="@MoveMetricUpLabel(currentMetricLabel)"
                                aria-label="@MoveMetricUpLabel(currentMetricLabel)"
                                disabled="@(item.Index == 0)"
                                @onclick="@(() => MoveMetric.InvokeAsync(new DashboardInspectorMetricMove(currentMetric, -1)))">
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" aria-hidden="true" />
                        </button>
                        <button type="button"
                                class="visual-metric-icon-button"
                                title="@MoveMetricDownLabel(currentMetricLabel)"
                                aria-label="@MoveMetricDownLabel(currentMetricLabel)"
                                disabled="@(item.Index == Draft.DisplayMetrics.Count - 1)"
                                @onclick="@(() => MoveMetric.InvokeAsync(new DashboardInspectorMetricMove(currentMetric, 1)))">
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" aria-hidden="true" />
                        </button>
                        <button type="button"
                                class="visual-metric-icon-button danger"
                                title="@RemoveMetricCardLabel(currentMetricLabel)"
                                aria-label="@RemoveMetricCardLabel(currentMetricLabel)"
                                disabled="@(!Draft.CanRemoveDisplayMetric)"
                                @onclick="@(() => RemoveMetric.InvokeAsync(currentMetric))">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                        </button>
                    </span>
                </div>
            </PropertyGridRow>
        }

        <PropertyGridRow Name="@Labels.AddCardRow">
            <div class="property-grid-inline visual-metric-add-row">
                <PropertyGridSelect Value="@(MetricToAdd ?? string.Empty)"
                                    Options="@AddMetricOptions"
                                    AriaLabel="@Labels.AddCardRow"
                                    ValueChanged="@MetricToAddChanged" />
                <button type="button"
                        class="visual-metric-add-button"
                        title="@AddMetricCardLabel"
                        aria-label="@AddMetricCardLabel"
                        disabled="@string.IsNullOrWhiteSpace(MetricToAdd)"
                        @onclick="@(() => AddMetric.InvokeAsync())">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-hidden="true" />
                </button>
            </div>
        </PropertyGridRow>

        <PropertyGridRow Name="@Labels.ColumnsRow" Unit="cols">
            <input class="property-grid-input"
                   type="number"
                   min="@DashboardWidgetCatalog.MinMetricCardColumns"
                   max="@DashboardWidgetCatalog.MaxMetricCardColumns"
                   step="1"
                   value="@Draft.MetricCardColumns"
                   @oninput="@SetMetricCardColumnsAsync" />
        </PropertyGridRow>
    }
}

@code {
    private const int MaxPrimaryMetricSegmentOptions = 4;

    [Parameter]
    public DashboardWidgetSettingsDraft? Draft { get; set; }

    [Parameter]
    public DashboardWidgetInspectorLabels Labels { get; set; } = DashboardWidgetInspectorLabels.Default;

    [Parameter]
    public string? MetricToAdd { get; set; }

    [Parameter]
    public IReadOnlyList<PropertyGridSelectOption> MetricOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PropertyGridSelectOption> AddMetricOptions { get; set; } = [];

    [Parameter]
    public EventCallback<string?> PrimaryMetricChanged { get; set; }

    [Parameter]
    public EventCallback<string?> MetricToAddChanged { get; set; }

    [Parameter]
    public EventCallback AddMetric { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorMetricMove> MoveMetric { get; set; }

    [Parameter]
    public EventCallback<string> RemoveMetric { get; set; }

    [Parameter]
    public EventCallback<int> CardColumnsChanged { get; set; }

    private IReadOnlyList<PropertyGridIconSegmentOption> PrimaryMetricSegmentOptions
        => MetricSegmentOptions(MetricOptions);

    private string AddMetricCardLabel => string.IsNullOrWhiteSpace(MetricToAdd)
        ? "Add selected metric card"
        : $"Add metric card for {VisualMetricLabel(MetricToAdd)}";

    private static string MetricCardCommandsLabel(string metricLabel)
        => $"{metricLabel} card commands";

    private static string MoveMetricUpLabel(string metricLabel)
        => $"Move {metricLabel} up";

    private static string MoveMetricDownLabel(string metricLabel)
        => $"Move {metricLabel} down";

    private static string RemoveMetricCardLabel(string metricLabel)
        => $"Remove {metricLabel}";

    private async Task SetMetricCardColumnsAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            await CardColumnsChanged.InvokeAsync(value);
        }
    }

    private static string VisualMetricLabel(string metricId)
        => DashboardWidgetCatalog.MetricOptions
            .FirstOrDefault(metric => string.Equals(metric.Id, metricId, StringComparison.Ordinal))
            ?.Label ?? metricId;

    private static IReadOnlyList<PropertyGridIconSegmentOption> MetricSegmentOptions(
        IReadOnlyList<PropertyGridSelectOption> options)
    {
        var selectableOptions = options
            .Where(static option => !option.Disabled && !string.IsNullOrWhiteSpace(option.Value))
            .ToArray();

        if (selectableOptions.Length is 0 or > MaxPrimaryMetricSegmentOptions)
        {
            return [];
        }

        return [.. selectableOptions.Select(static option => new PropertyGridIconSegmentOption(
            option.Value,
            Icons.Material.Filled.RadioButtonChecked,
            option.Label))];
    }
}

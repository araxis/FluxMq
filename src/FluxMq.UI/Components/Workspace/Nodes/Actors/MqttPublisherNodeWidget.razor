@using FluxMq.UI.Components.Diagram
@using FluxMq.Core.Models
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Publish"
                 CategoryColor="@Color.Tertiary"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="mqtt-publisher-summary node-ui-summary">
            <div class="mqtt-publisher-meta node-ui-facts">
                <div class="mqtt-publisher-meta-item broker node-ui-fact">
                    <span>Broker</span>
                    <strong title="@DisplayConnection">@DisplayConnection</strong>
                </div>
                <div class="mqtt-publisher-meta-item node-ui-fact">
                    <span>Input buffer</span>
                    <strong>@ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity)</strong>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="mqtt-publisher-editor node-ui-editor" aria-label="Publisher settings">
            @{
                var brokerOptions = BrokerOptions;
            }
            @if (brokerOptions.Count > 0)
            {
                <MudSelect T="string"
                           Label="Broker connection"
                           @bind-Value="_connection"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="mqtt-publisher-broker-field">
                    @foreach (var option in brokerOptions)
                    {
                        <MudSelectItem Value="@option.Name">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <div class="mqtt-publisher-broker-cell">
                    <MudTextField T="string"
                                  Label="Connection name"
                                  @bind-Value="_connection"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mqtt-publisher-broker-field" />
                </div>
            }
            <MudNumericField T="int"
                             Label="Input buffer"
                             Value="@_boundedCapacity"
                             ValueChanged="@SetBoundedCapacity"
                             Min="1"
                             Max="100000"
                             Step="100"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="mqtt-publisher-buffer-field" />
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MqttPublisherNodeModel Model => (MqttPublisherNodeModel)Node;

    private string _connection = string.Empty;
    private int _boundedCapacity = ActorNodeConfiguration.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string DisplayConnection => ResolveConnectionName(Model.Connection);

    private IReadOnlyList<BrokerOption> BrokerOptions
    {
        get
        {
            var options = new Dictionary<string, BrokerOption>(StringComparer.Ordinal);
            foreach (var (name, profile, _) in Flow.GetConnectionResources())
            {
                AddOption(name, profile, isAppResource: true);
            }

            foreach (var connection in Live.Connections)
            {
                AddOption(connection.ResourceName, connection.Profile, isAppResource: false);
            }

            if (!string.IsNullOrWhiteSpace(Model.Connection) && !options.ContainsKey(Model.Connection.Trim()))
            {
                options[Model.Connection.Trim()] = new BrokerOption(Model.Connection.Trim(), Model.Connection.Trim());
            }

            return options.Values
                .OrderByDescending(static option => option.IsAppResource)
                .ThenBy(static option => option.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            void AddOption(string? name, MqttConnectionProfile profile, bool isAppResource)
            {
                if (string.IsNullOrWhiteSpace(name))
                {
                    return;
                }

                var resourceName = name.Trim();
                options.TryAdd(
                    resourceName,
                    new BrokerOption(
                        resourceName,
                        $"{resourceName} ({profile.Host}:{profile.Port})",
                        isAppResource));
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _connection = ResolveConnectionName(Model.Connection);
        _boundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.Connection = string.IsNullOrWhiteSpace(_connection)
            ? DefaultConnectionName()
            : _connection.Trim();
        Model.BoundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(_boundedCapacity);

        var isExistingAppResource = Flow.GetConnectionNames()
            .Any(name => string.Equals(name, Model.Connection, StringComparison.Ordinal));

        if (isExistingAppResource)
        {
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
            return Task.CompletedTask;
        }

        var selectedProfile = Live.Connections
            .FirstOrDefault(c => string.Equals(c.ResourceName, Model.Connection, StringComparison.Ordinal))
            ?.Profile;

        if (selectedProfile is not null)
        {
            Flow.SyncConnectionAndUpdateNode(Model.Connection, selectedProfile, Node.NodeName, Model.BuildConfiguration());
        }
        else
        {
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        }

        return Task.CompletedTask;
    }

    private async Task SetBoundedCapacity(int value)
    {
        _boundedCapacity = value;
        await RefreshDialogAsync();
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
        => _boundedCapacity is < 1 or > 100000
            ? "Input buffer must be between 1 and 100000."
            : null;

    private string ResolveConnectionName(string? configuredConnection)
    {
        var configured = configuredConnection?.Trim() ?? string.Empty;
        var appConnectionNames = Flow.GetConnectionNames();

        if (configured.Length > 0 &&
            (!string.Equals(configured, FlowDefinitionComposer.BrokerResourceName, StringComparison.Ordinal) ||
             appConnectionNames.Any(name => string.Equals(name, configured, StringComparison.Ordinal))))
        {
            return configured;
        }

        return DefaultConnectionName();
    }

    private string DefaultConnectionName()
        => BrokerOptions.FirstOrDefault()?.Name ?? FlowDefinitionComposer.BrokerResourceName;

    private sealed record BrokerOption(string Name, string Label, bool IsAppResource = false);
}

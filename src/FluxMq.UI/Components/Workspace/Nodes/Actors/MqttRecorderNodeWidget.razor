@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Save"
                 CategoryColor="@Color.Tertiary"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="mqtt-recorder-summary">
            <div class="mqtt-recorder-meta">
                <div class="mqtt-recorder-meta-item target">
                    <span>Target</span>
                    <strong>Local sessions</strong>
                </div>
                <div class="mqtt-recorder-meta-item">
                    <span>Input buffer</span>
                    <strong>@ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity)</strong>
                </div>
            </div>

            <div class="mqtt-recorder-contract" aria-label="Recording request fields">
                <span class="mqtt-recorder-contract-label">Request fields</span>
                <span class="mqtt-recorder-token">sessionId</span>
                <span class="mqtt-recorder-token">envelope</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="mqtt-recorder-editor" aria-label="Recorder settings">
            <MudNumericField T="int"
                             Label="Input buffer"
                             @bind-Value="_boundedCapacity"
                             Min="1"
                             Max="100000"
                             Step="100"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="mqtt-recorder-buffer-field" />
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MqttRecorderNodeModel Model => (MqttRecorderNodeModel)Node;

    private int _boundedCapacity = ActorNodeConfiguration.DefaultBoundedCapacity;

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
        => _boundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity);

    private Task SaveAsync()
    {
        Model.BoundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(_boundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Description"
                 CategoryColor="@Color.Tertiary"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="file-writer-summary">
            <div class="file-writer-meta">
                <div class="file-writer-meta-item target">
                    <span>Target</span>
                    <strong>Input path</strong>
                </div>
                <div class="file-writer-meta-item">
                    <span>Input buffer</span>
                    <strong>@ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity)</strong>
                </div>
            </div>

            <div class="file-writer-contract" aria-label="File write request fields">
                <span class="file-writer-contract-label">Request fields</span>
                <span class="file-writer-token">path</span>
                <span class="file-writer-token">content</span>
                <span class="file-writer-token">mode</span>
                <span class="file-writer-token">createDirectory</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="file-writer-editor" aria-label="File writer settings">
            <MudNumericField T="int"
                             Label="Input buffer"
                             @bind-Value="_boundedCapacity"
                             Min="1"
                             Max="100000"
                             Step="100"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Class="file-writer-buffer-field" />
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private FileWriterNodeModel Model => (FileWriterNodeModel)Node;

    private int _boundedCapacity = ActorNodeConfiguration.DefaultBoundedCapacity;

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
        => _boundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity);

    private Task SaveAsync()
    {
        Model.BoundedCapacity = ActorNodeConfiguration.NormalizeBoundedCapacity(_boundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

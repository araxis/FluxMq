@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FilterAlt"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        @if (!string.IsNullOrWhiteSpace(Model.Expression))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 node-expr-preview">@Model.Expression</MudText>
        }
        else
        {
            <div class="flow-node-filters mt-1 d-flex flex-wrap gap-1">
                @foreach (var pattern in Model.Patterns)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Filled"
                             Color="@(pattern.StartsWith('$') ? Color.Warning : Color.Secondary)"
                             Icon="@Icons.Material.Filled.Topic">
                        @pattern
                    </MudChip>
                }
            </div>
        }
    </Body>
    <Editor>
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Topic filters" Icon="@Icons.Material.Filled.Topic" Class="pt-3">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        MQTT topic patterns. Use <code>#</code> (multi-level wildcard) and <code>+</code> (single-level wildcard).
                    </MudText>
                    @for (var i = 0; i < _draftPatterns.Count; i++)
                    {
                        var index = i;
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudTextField T="string"
                                          Value="@_draftPatterns[index]"
                                          ValueChanged="@(v => _draftPatterns[index] = v ?? string.Empty)"
                                          Placeholder="sensors/#"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="flex-grow-1" />
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Close"
                                           OnClick="@(() => _draftPatterns.RemoveAt(index))" />
                        </MudStack>
                    }
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@AddPattern">Add pattern</MudButton>
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Expression" Icon="@Icons.Material.Filled.Code" Class="pt-3">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Optional C# expression (DynamicExpresso). When set, overrides topic patterns.
                        Must evaluate to <code>bool</code>.
                    </MudText>
                    <MudTextField T="string"
                                  @bind-Value="_expression"
                                  Label="Filter expression"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="node-expr-field"
                                  Placeholder='topic.StartsWith("sensors/") && payload.Length < 1024'
                                  HelperText="Leave empty to use topic patterns above." />
                    <MudExpansionPanel Text="Available variables" Dense="true" Gutters="false">
                        <MudSimpleTable Dense="true" Striped="true" Class="mt-1">
                            <thead>
                                <tr><th>Variable</th><th>Type</th><th>Example</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><code>topic</code></td><td>string</td><td><code>topic.StartsWith("sensors/")</code></td></tr>
                                <tr><td><code>payload</code></td><td>string</td><td><code>payload.Contains("error")</code></td></tr>
                                <tr><td><code>qos</code></td><td>int</td><td><code>qos >= 1</code></td></tr>
                                <tr><td><code>retain</code></td><td>bool</td><td><code>retain == true</code></td></tr>
                                <tr><td><code>receivedAt</code></td><td>DateTimeOffset</td><td><code>receivedAt.Hour >= 8</code></td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudExpansionPanel>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MessageFilterNodeModel Model => (MessageFilterNodeModel)Node;

    private readonly List<string> _draftPatterns = [];
    private string _expression = string.Empty;

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _draftPatterns.Clear();
        _draftPatterns.AddRange(Model.Patterns);
        if (_draftPatterns.Count == 0) _draftPatterns.Add("#");
        _expression = Model.Expression;
    }

    private void AddPattern() => _draftPatterns.Add(string.Empty);

    private Task SaveAsync()
    {
        var trimmed = _draftPatterns
            .Select(p => p?.Trim() ?? string.Empty)
            .Where(p => p.Length > 0)
            .ToArray();
        Model.Patterns = trimmed.Length > 0 ? trimmed : ["#"];
        Model.Expression = _expression.Trim();
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

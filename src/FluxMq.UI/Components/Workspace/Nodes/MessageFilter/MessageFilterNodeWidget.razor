@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FilterAlt"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Large"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="message-filter-summary">
            <div class="message-filter-meta">
                <div class="message-filter-meta-item scope">
                    <span>Topic scope</span>
                    <strong>@PatternCountCaption</strong>
                </div>
                <div class="message-filter-meta-item">
                    <span>Condition</span>
                    <strong>@ConditionCaption</strong>
                </div>
            </div>

            <div class="message-filter-patterns" aria-label="Topic filter patterns">
                <span class="message-filter-pattern-label">Patterns</span>
                @foreach (var pattern in SummaryPatterns)
                {
                    <span class="@PatternTokenClass(pattern)">@pattern</span>
                }
                @if (PatternOverflow > 0)
                {
                    <span class="message-filter-token overflow">+@PatternOverflow</span>
                }
            </div>

            @if (HasExpression)
            {
                <div class="message-filter-expression-preview" title="@ExpressionCaption">
                    <span class="message-filter-expression-label">Condition</span>
                    <span class="message-filter-expression-text">@ExpressionCaption</span>
                </div>
            }
        </div>
    </Body>
    <Editor>
        <div class="message-filter-editor" aria-label="Flow filter settings">
            <div class="message-filter-editor-grid" aria-label="Filter rules">
                <section class="message-filter-scope-editor" aria-label="Topic pattern filters">
                    <div class="message-filter-section-bar">
                        <span>Topic scope</span>
                        <MudTooltip Text="Add pattern">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Secondary"
                                           aria-label="Add topic pattern"
                                           Class="message-filter-add"
                                           OnClick="@AddPattern" />
                        </MudTooltip>
                    </div>

                    <div class="message-filter-pattern-list">
                        @for (var i = 0; i < _draftPatterns.Count; i++)
                        {
                            var index = i;
                            <div class="message-filter-pattern-row">
                                <MudTextField T="string"
                                              aria-label="@($"Topic pattern {index + 1}")"
                                              Value="@_draftPatterns[index]"
                                              ValueChanged="@(value => SetPattern(index, value))"
                                              Placeholder="sensors/#"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="message-filter-pattern-field" />
                                <MudTooltip Text="Remove pattern">
                                    <MudIconButton Size="Size.Small"
                                                   Icon="@Icons.Material.Filled.Close"
                                                   aria-label="@($"Remove topic pattern {index + 1}")"
                                                   Class="message-filter-remove"
                                                   OnClick="@(() => RemovePattern(index))" />
                                </MudTooltip>
                            </div>
                        }

                        @if (_draftPatterns.Count == 0)
                        {
                            <div class="message-filter-empty" role="status">No topic patterns</div>
                        }
                    </div>
                </section>

                <section class="message-filter-condition-editor" aria-label="Condition expression">
                    <div class="message-filter-section-bar text-only">
                        <span>Optional condition</span>
                    </div>

                    <MudTextField T="string"
                                  @bind-Value="_expression"
                                  Label="Condition expression"
                                  aria-label="Condition expression"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="7"
                                  Class="message-filter-expression-field"
                                  Placeholder='payload.Length < 1024 && retain == false' />
                    <div class="message-filter-reference" aria-label="Condition expression variables">
                        <span class="message-filter-reference-label">Variables</span>
                        @foreach (var variable in ExpressionVariables)
                        {
                            <span class="message-filter-variable">@variable</span>
                        }
                    </div>
                </section>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MessageFilterNodeModel Model => (MessageFilterNodeModel)Node;

    private readonly List<string> _draftPatterns = [];
    private string _expression = string.Empty;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private bool HasExpression => !string.IsNullOrWhiteSpace(Model.Expression);
    private int PatternCount => Model.Patterns.Count(static pattern => !string.IsNullOrWhiteSpace(pattern));
    private string PatternCountCaption => $"{PatternCount} {PatternLabel(PatternCount)}";
    private string ConditionCaption => HasExpression ? "Expression" : "None";
    private string ExpressionCaption => Model.Expression.Trim();
    private IReadOnlyList<string> SummaryPatterns
        => Model.Patterns.Where(static pattern => !string.IsNullOrWhiteSpace(pattern)).Take(MaxSummaryPatterns).ToArray();
    private int PatternOverflow
        => Math.Max(0, Model.Patterns.Count(static pattern => !string.IsNullOrWhiteSpace(pattern)) - MaxSummaryPatterns);
    private const int MaxSummaryPatterns = 3;

    private static readonly string[] ExpressionVariables =
    [
        "topic",
        "payload",
        "qos",
        "retain",
        "receivedAt"
    ];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _draftPatterns.Clear();
        _draftPatterns.AddRange(Model.Patterns);
        if (_draftPatterns.Count == 0) _draftPatterns.Add("#");
        _expression = Model.Expression;
    }

    private async Task AddPattern()
    {
        _draftPatterns.Add(string.Empty);
        await RefreshDialogAsync();
    }

    private async Task RemovePattern(int index)
    {
        if (index >= 0 && index < _draftPatterns.Count)
        {
            _draftPatterns.RemoveAt(index);
            await RefreshDialogAsync();
        }
    }

    private async Task SetPattern(int index, string? value)
    {
        if (index >= 0 && index < _draftPatterns.Count)
        {
            _draftPatterns[index] = value ?? string.Empty;
            await RefreshDialogAsync();
        }
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
        => _draftPatterns.Any(static pattern => !string.IsNullOrWhiteSpace(pattern))
            ? null
            : "Add at least one topic pattern before saving.";

    private Task SaveAsync()
    {
        var trimmed = _draftPatterns
            .Select(p => p?.Trim() ?? string.Empty)
            .Where(p => p.Length > 0)
            .ToArray();
        Model.Patterns = trimmed.Length > 0 ? trimmed : ["#"];
        Model.Expression = _expression.Trim();
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private static string PatternTokenClass(string pattern)
        => pattern.StartsWith('$')
            ? "message-filter-token system"
            : "message-filter-token";

    private static string PatternLabel(int count) => count == 1 ? "pattern" : "patterns";
}

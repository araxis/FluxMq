@*
    Per-type widget shell. Concrete widgets (MqttConnection, Trigger, ...) pass:
        Body   = the read-only view face
        Editor = the edit face (optional). When present a pencil icon flips the
                 card; the Editor receives Save / Cancel callbacks via context.

    Common chrome (selection state, expand/collapse, activity badge, port chips,
    diagram port renderers) lives here so widgets stay focused on their content.
*@
<div class="flow-node @(Node.Selected ? "flow-node-selected" : null) @(Node.IsCollapsed ? "flow-node-collapsed" : null)">
    <div class="node-flip @(_isEditing ? "flipped" : null)">
        <div class="node-flip-inner">

            <!-- ── Front face: the normal widget view ──────────────────── -->
            <div class="node-flip-face">
                <div class="flow-node-header">
                    <MudIconButton Size="Size.Small"
                                   Icon="@(Node.IsCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => Node.Toggle())" />
                    <MudIcon Icon="@HeaderIcon" Color="@CategoryColor" Size="Size.Small" Class="me-2" />
                    <div class="flow-node-title">
                        <MudText Typo="Typo.subtitle2">@Node.NodeName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Node.DisplayName</MudText>
                    </div>
                    @if (Editor is not null)
                    {
                        <MudTooltip Text="Edit settings">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Edit"
                                           OnClick="@StartEdit" />
                        </MudTooltip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="@CategoryColor">@Node.Category</MudChip>
                </div>

                @if (!Node.IsCollapsed)
                {
                    <MudDivider Class="my-2" />
                    @if (!string.IsNullOrWhiteSpace(Node.ActivityText))
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                            @Node.ActivityText
                        </MudAlert>
                    }

                    @Body

                    <div class="flow-node-ports mt-2">
                        @foreach (var port in Node.PortDescriptors)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="@(port.IsInput ? Color.Info : Color.Success)">
                                @(port.IsInput ? "In" : "Out") · @port.Name
                            </MudChip>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Node.ActivityText))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Node.ActivityText</MudText>
                }
            </div>

            <!-- ── Back face: the edit panel (only rendered when an editor was provided) ── -->
            @if (Editor is not null)
            {
                <div class="node-flip-face node-flip-back">
                    <div class="flow-node-header">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Color="@CategoryColor" Size="Size.Small" Class="me-2" />
                        <div class="flow-node-title">
                            <MudText Typo="Typo.subtitle2">@Node.NodeName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Edit settings</MudText>
                        </div>
                    </div>
                    <MudDivider Class="my-2" />
                    <div class="node-edit-body">
                        @Editor(new NodeEditorContext(SaveAndClose, CancelEdit))
                    </div>
                    <div class="node-edit-actions">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@CancelEdit">Cancel</MudButton>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="@CategoryColor"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   OnClick="@(() => SaveAndClose())">Save</MudButton>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Diagram-engine port hosts. The CSS in app.css turns them into visible
       connector dots on each side of the node. *@
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" />
    }
</div>

@code {
    [Parameter, EditorRequired] public FluxMq.UI.Models.FlowDiagramNodeModel Node { get; set; } = null!;
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment<NodeEditorContext>? Editor { get; set; }
    [Parameter] public string HeaderIcon { get; set; } = Icons.Material.Filled.Memory;
    [Parameter] public Color CategoryColor { get; set; } = Color.Default;

    /// <summary>
    /// When the user starts editing the parent widget can hand us a save callback
    /// here. The shell calls it on Save before the flip back to the read view.
    /// </summary>
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Called on Cancel so widgets can discard their draft state.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _isEditing;

    private void StartEdit()
    {
        // Force expand so the back face has room.
        Node.SetCollapsed(false);
        _isEditing = true;
    }

    private async Task SaveAndClose()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }
        _isEditing = false;
    }

    private async Task CancelEdit()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        _isEditing = false;
    }

    /// <summary>
    /// Passed to widget-supplied editor fragments so they can trigger Save / Cancel
    /// from inside (e.g. an Enter key on a single-field edit).
    /// </summary>
    public sealed record NodeEditorContext(Func<Task> Save, Func<Task> Cancel);
}

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FolderOpen"
                 CategoryColor="@Color.Primary"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Replays messages from a stored MQTT recording session.
        </MudText>
        <MudStack Spacing="1" Class="mt-2">
            <Stat Icon="@Icons.Material.Filled.Folder" Label="Session" Value="@(ResolvedSessionName ?? "—")" />
            @if (Model.PreserveTiming)
            {
                <Stat Icon="@Icons.Material.Filled.Speed" Label="Speed" Value="@($"{Model.Speed:0.##}×")" />
            }
        </MudStack>
    </Body>
    <Editor>
        @{
            var sessions = Live.StoredSessions;
        }
        @if (sessions.Count > 0)
        {
            <MudSelect T="string" Label="Session" @bind-Value="_sessionId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       ToStringFunc="@(id => sessions.FirstOrDefault(s => s.Id.ToString() == id)?.Name ?? id)">
                @foreach (var session in sessions)
                {
                    <MudSelectItem Value="@session.Id.ToString()">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">@session.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(session.ProjectName) && session.ProjectName != "Default")
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@session.ProjectName</MudChip>
                            }
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                No recorded sessions found. Record a session first.
            </MudAlert>
        }
        <MudCheckBox T="bool" @bind-Value="_preserveTiming" Label="Preserve original timing" Dense="true" />
        @if (_preserveTiming)
        {
            <MudNumericField T="double" Label="Playback speed" @bind-Value="_speed"
                             Min="0.1" Max="100" Step="0.1"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             HelperText="1 = real-time, 2 = double speed, 0.5 = half speed" />
        }
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private SessionSourceNodeModel Model => (SessionSourceNodeModel)Node;

    private string? ResolvedSessionName
    {
        get
        {
            if (string.IsNullOrEmpty(Model.SessionId)) return null;
            return Live.StoredSessions.FirstOrDefault(s => s.Id.ToString() == Model.SessionId)?.Name ?? Model.SessionId;
        }
    }

    private string _sessionId = string.Empty;
    private bool _preserveTiming;
    private double _speed = 1;

    protected override void OnParametersSet()
    {
        LoadDraft();
    }

    private void LoadDraft()
    {
        _sessionId = Model.SessionId;
        _preserveTiming = Model.PreserveTiming;
        _speed = Model.Speed;
    }

    private Task SaveAsync()
    {
        Model.SessionId = _sessionId;
        Model.PreserveTiming = _preserveTiming;
        Model.Speed = _speed;
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

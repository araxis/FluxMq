@using FluxMq.UI.Components.Diagram
@using FluxMq.Core.Models
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Bolt"
                 CategoryColor="@Color.Primary"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <MudStack Spacing="1" Class="mt-1">
            <Stat Icon="@Icons.Material.Filled.Cable" Label="Broker" Value="@(Model.Connection.Length > 0 ? Model.Connection : "—")" />
        </MudStack>
        <div class="flow-node-filters mt-1 d-flex flex-wrap gap-1">
            @foreach (var subscription in Model.Subscriptions)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="@(subscription.TopicFilter.StartsWith('$') ? Color.Warning : Color.Primary)"
                         Icon="@Icons.Material.Filled.Topic">
                    @subscription.TopicFilter · QoS @subscription.QualityOfService
                </MudChip>
            }
        </div>
    </Body>
    <Editor>
        @{
            var brokerOptions = BrokerOptions;
        }
        @if (brokerOptions.Count > 0)
        {
            <MudSelect T="string" Label="Broker connection" @bind-Value="_connection"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var option in brokerOptions)
                {
                    <MudSelectItem Value="@option.Name">@option.Label</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudTextField T="string"
                          Label="Connection name"
                          @bind-Value="_connection"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Add a broker connection in the left panel to enable the dropdown." />
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">Subscriptions</MudText>
        @for (var i = 0; i < _draftSubscriptions.Count; i++)
        {
            var index = i;
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudTextField T="string"
                              Value="@_draftSubscriptions[index].TopicFilter"
                              ValueChanged="@(v => _draftSubscriptions[index] = _draftSubscriptions[index] with { TopicFilter = v ?? string.Empty })"
                              Placeholder="topic/#"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flex-grow-1" />
                <MudSelect T="int"
                           Value="@_draftSubscriptions[index].QualityOfService"
                           ValueChanged="@(value => _draftSubscriptions[index] = _draftSubscriptions[index] with { QualityOfService = value })"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="trigger-qos-select"
                           Style="width: 112px; min-width: 112px;"
                           Label="QoS">
                    <MudSelectItem Value="0">QoS 0</MudSelectItem>
                    <MudSelectItem Value="1">QoS 1</MudSelectItem>
                    <MudSelectItem Value="2">QoS 2</MudSelectItem>
                </MudSelect>
                <MudTooltip Text="Ask the broker to send retained messages when this subscription starts.">
                    <MudCheckBox T="bool"
                                 Value="@_draftSubscriptions[index].ReceiveRetainedMessages"
                                 ValueChanged="@(value => _draftSubscriptions[index] = _draftSubscriptions[index] with { ReceiveRetainedMessages = value })"
                                 Dense="true"
                                 Label="Receive retained" />
                </MudTooltip>
                <MudTooltip Text="Keep the original MQTT retain flag on messages delivered to the pipeline.">
                    <MudCheckBox T="bool"
                                 Value="@_draftSubscriptions[index].RetainAsPublished"
                                 ValueChanged="@(value => _draftSubscriptions[index] = _draftSubscriptions[index] with { RetainAsPublished = value })"
                                 Dense="true"
                                 Label="Keep retain flag" />
                </MudTooltip>
                <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.Close"
                               OnClick="@(() => RemoveRowAsync(index))" />
            </MudStack>
        }
        <MudButton Size="Size.Small"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@AddRow">Add subscription</MudButton>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MqttTriggerNodeModel Model => (MqttTriggerNodeModel)Node;

    private string _connection = string.Empty;
    private readonly List<MqttTriggerSubscriptionDraft> _draftSubscriptions = [];
    private MqttTriggerNodeModel? _loadedModel;

    private IReadOnlyList<BrokerOption> BrokerOptions
    {
        get
        {
            var options = new Dictionary<string, BrokerOption>(StringComparer.Ordinal);
            foreach (var (name, profile, _) in Flow.GetConnectionResources())
            {
                AddOption(name, profile, isAppResource: true);
            }

            foreach (var connection in Live.Connections)
            {
                AddOption(connection.ResourceName, connection.Profile, isAppResource: false);
            }

            return options.Values
                .OrderByDescending(static option => option.IsAppResource)
                .ThenBy(static option => option.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            void AddOption(string? name, MqttConnectionProfile profile, bool isAppResource)
            {
                if (string.IsNullOrWhiteSpace(name))
                {
                    return;
                }

                var resourceName = name.Trim();
                options.TryAdd(
                    resourceName,
                    new BrokerOption(
                        resourceName,
                        $"{resourceName} ({profile.Host}:{profile.Port})",
                        isAppResource));
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedModel, Model))
        {
            return;
        }

        LoadDraft();
    }

    private void LoadDraft()
    {
        _loadedModel = Model;
        _connection = Model.Connection;
        _draftSubscriptions.Clear();
        _draftSubscriptions.AddRange(Model.Subscriptions);
        if (_draftSubscriptions.Count == 0) _draftSubscriptions.Add(new("#", MqttTriggerNodeModel.DefaultSubscriptionQos));
    }

    private async Task AddRow()
    {
        _draftSubscriptions.Add(new(string.Empty, MqttTriggerNodeModel.DefaultSubscriptionQos));
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task RemoveRowAsync(int index)
    {
        if (index < 0 || index >= _draftSubscriptions.Count)
        {
            return;
        }

        _draftSubscriptions.RemoveAt(index);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private Task SaveAsync()
    {
        var subscriptions = _draftSubscriptions
            .Select(subscription => new MqttTriggerSubscriptionDraft(
                subscription.TopicFilter?.Trim() ?? string.Empty,
                MqttTriggerNodeModel.NormalizeQualityOfService(subscription.QualityOfService),
                subscription.ReceiveRetainedMessages,
                subscription.RetainAsPublished))
            .Where(subscription => subscription.TopicFilter.Length > 0)
            .ToList();
        if (subscriptions.Count == 0) subscriptions.Add(new("#", MqttTriggerNodeModel.DefaultSubscriptionQos));

        Model.Connection = _connection;
        Model.Subscriptions = subscriptions;

        var isExistingAppResource = Flow.GetConnectionNames()
            .Any(name => string.Equals(name, _connection, StringComparison.Ordinal));

        if (isExistingAppResource)
        {
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
            return Task.CompletedTask;
        }

        var selectedProfile = Live.Connections
            .FirstOrDefault(c => string.Equals(c.ResourceName, _connection, StringComparison.Ordinal))
            ?.Profile;

        if (selectedProfile is not null)
            Flow.SyncConnectionAndUpdateNode(_connection, selectedProfile, Node.NodeName, Model.BuildConfiguration());
        else
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());

        return Task.CompletedTask;
    }

    private sealed record BrokerOption(string Name, string Label, bool IsAppResource = false);
}

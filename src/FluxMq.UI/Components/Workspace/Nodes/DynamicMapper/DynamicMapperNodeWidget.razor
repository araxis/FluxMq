@implements IDisposable
@using FluxMq.Core.Models
@using FluxMq.UI.Components.Diagram
@using System.Text.Json
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live
@inject AppThemeService ThemeService
@inject NodeEditDialogRefreshService DialogRefresh
@inject IJSRuntime JsRuntime

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Transform"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.ExtraExtraLarge"
                 EditDialogContentClass="dynamic-mapper-dialog"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="dynamic-mapper-summary node-ui-summary">
            <div class="dynamic-mapper-meta node-ui-facts">
                <div class="dynamic-mapper-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong title="@_inputType">@_inputType</strong>
                </div>
                <div class="dynamic-mapper-meta-item output node-ui-fact">
                    <span>Output</span>
                    <strong title="@OutputModeCaption">@OutputModeCaption</strong>
                </div>
                <div class="dynamic-mapper-meta-item node-ui-fact">
                    <span>Engine</span>
                    <strong>@EngineCaption</strong>
                </div>
                <div class="dynamic-mapper-meta-item node-ui-fact">
                    <span>Mode</span>
                    <strong>@OutputModeLabel</strong>
                </div>
            </div>

            <div class="dynamic-mapper-fields node-ui-token-group">
                <div class="dynamic-mapper-field-row node-ui-token-row" aria-label="Mapper input variables">
                    <span class="dynamic-mapper-field-label node-ui-fact-label">Input variables</span>
                    @foreach (var variable in SummaryVariables)
                    {
                        <span class="dynamic-mapper-token node-ui-token">@variable.Label</span>
                    }
                    @if (SummaryVariableOverflow > 0)
                    {
                        <span class="dynamic-mapper-token overflow node-ui-token">+@SummaryVariableOverflow</span>
                    }
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="dynamic-mapper-editor node-ui-editor" aria-label="Dynamic mapper settings">
            <div class="dynamic-mapper-control-row" aria-label="Mapper configuration">
                <MudSelect T="string"
                           Label="Input schema"
                           Value="@_inputType"
                           ValueChanged="@SetInputType"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="dynamic-mapper-input-schema-field">
                    @foreach (var inputType in DynamicMapperNodeModel.InputTypes)
                    {
                        <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="Engine"
                           Value="@_engine"
                           ValueChanged="@SetEngine"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="dynamic-mapper-engine-field">
                    <MudSelectItem Value="@("jsonata")">JSONata</MudSelectItem>
                    <MudSelectItem Value="@("dynamic-expresso")">Dynamic Expresso</MudSelectItem>
                </MudSelect>

                <MudSelect T="string"
                           Label="Result mode"
                           Value="@_outputMode"
                           ValueChanged="@SetOutputMode"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="dynamic-mapper-result-mode-field">
                    <MudSelectItem Value="@DynamicMapperNodeModel.OutputContractAny">Any</MudSelectItem>
                    <MudSelectItem Value="@DynamicMapperNodeModel.OutputContractTyped">Typed</MudSelectItem>
                    <MudSelectItem Value="@DynamicMapperNodeModel.OutputContractJsonSchemaFile">JSON Schema file</MudSelectItem>
                </MudSelect>

                <div @key="SchemaControlKey" class="dynamic-mapper-schema-control">
                    @if (IsTypedOutputMode)
                    {
                        <MudSelect T="string"
                                   Label="Typed schema"
                                   Value="@_outputType"
                                   ValueChanged="@SetOutputType"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="dynamic-mapper-output-schema-field">
                            <MudSelectItem Value="@("MqttPublishRequest")">MqttPublishRequest</MudSelectItem>
                            <MudSelectItem Value="@("HttpRequestInput")">HttpRequestInput</MudSelectItem>
                            <MudSelectItem Value="@("PayloadInspectionRequest")">PayloadInspectionRequest</MudSelectItem>
                            <MudSelectItem Value="@("FileWriteRequest")">FileWriteRequest</MudSelectItem>
                            <MudSelectItem Value="@("MqttRecordingRequest")">MqttRecordingRequest</MudSelectItem>
                            <MudSelectItem Value="@("StateReducerInput")">StateReducerInput</MudSelectItem>
                        </MudSelect>
                    }
                    else if (IsJsonSchemaFileMode)
                    {
                        <div class="dynamic-mapper-schema-file">
                            <MudTextField T="string"
                                          Label="JSON Schema file"
                                          Value="@_outputSchemaPath"
                                          ValueChanged="@SetOutputSchemaPath"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="dynamic-mapper-output-schema-field" />
                            <MudTooltip Text="Select schema file">
                                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               Class="dynamic-mapper-file-picker-button"
                                               OnClick="@PickOutputSchemaFileAsync" />
                            </MudTooltip>
                        </div>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Label="Typed schema"
                                      Value="@("None")"
                                      Disabled="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="dynamic-mapper-output-schema-field" />
                    }
                </div>
            </div>

            <div class="dynamic-mapper-workspace">
                <section class="dynamic-mapper-input-workspace node-ui-code-surface" aria-label="Sample input JSON">
                    <div class="dynamic-mapper-workspace-header">
                        <div>
                            <span class="dynamic-mapper-kicker">Input</span>
                            <strong>Sample JSON</strong>
                        </div>
                        <div class="dynamic-mapper-workspace-actions">
                            <span class="dynamic-mapper-heading-token node-ui-token">@_sampleSource</span>
                            <MudTooltip Text="Reload sample input">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Size="Size.Small"
                                               Class="dynamic-mapper-toolbar-action"
                                               OnClick="@ReloadWorkspaceSample" />
                            </MudTooltip>
                        </div>
                    </div>

                    <div class="dynamic-mapper-editor-host" @ref="_inputEditorHost">
                        <StandaloneCodeEditor @key="_inputEditorVersion"
                                              @ref="_inputEditor"
                                              Id="@InputEditorId"
                                              CssClass="dynamic-mapper-monaco-editor dynamic-mapper-input-editor"
                                              ConstructionOptions="@InputEditorConstructionOptions"
                                              OnDidChangeModelContent="@OnInputEditorContentChanged" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_inputJsonError))
                    {
                        <div class="dynamic-mapper-input-error" role="alert">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                            <span>@_inputJsonError</span>
                        </div>
                    }
                </section>

                <section class="dynamic-mapper-expression-workspace node-ui-code-surface" aria-label="Mapping expression">
                    <div class="dynamic-mapper-workspace-header">
                        <div>
                            <span class="dynamic-mapper-kicker">Mapping</span>
                            <strong>@EngineCaption expression</strong>
                        </div>
                    </div>

                    <div class="dynamic-mapper-editor-host" @ref="_expressionEditorHost">
                        <StandaloneCodeEditor @key="_editorVersion"
                                              @ref="_editor"
                                              Id="@EditorId"
                                              CssClass="dynamic-mapper-monaco-editor dynamic-mapper-expression-editor"
                                              ConstructionOptions="@EditorConstructionOptions"
                                              OnDidChangeModelContent="@OnEditorContentChanged" />
                    </div>
                </section>

                <section class="dynamic-mapper-result-workspace node-ui-code-surface" aria-label="Mapping result">
                    <div class="dynamic-mapper-workspace-header">
                        <div>
                            <span class="dynamic-mapper-kicker">Result</span>
                            <strong>@_previewResult.Title</strong>
                        </div>
                        <div class="dynamic-mapper-workspace-actions">
                            <span class="@PreviewResultMarkerClass">@PreviewResultMarkerText</span>
                        </div>
                    </div>

                    <div class="dynamic-mapper-editor-host" @ref="_resultEditorHost">
                        <StandaloneCodeEditor @key="_resultEditorVersion"
                                              @ref="_resultEditor"
                                              Id="@ResultEditorId"
                                              CssClass="dynamic-mapper-monaco-editor dynamic-mapper-result-editor"
                                              ConstructionOptions="@ResultEditorConstructionOptions" />
                    </div>
                </section>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private DynamicMapperNodeModel Model => (DynamicMapperNodeModel)Node;

    private string _engine = "jsonata";
    private string _inputType = "MqttEnvelope";
    private string _outputType = "MqttPublishRequest";
    private string _outputMode = DynamicMapperNodeModel.OutputContractTyped;
    private string _outputSchemaPath = string.Empty;
    private string _expression = string.Empty;
    private StandaloneCodeEditor? _editor;
    private StandaloneCodeEditor? _inputEditor;
    private StandaloneCodeEditor? _resultEditor;
    private StandaloneCodeEditor? _initializedEditor;
    private StandaloneCodeEditor? _initializedInputEditor;
    private StandaloneCodeEditor? _initializedResultEditor;
    private ElementReference _inputEditorHost;
    private ElementReference _expressionEditorHost;
    private ElementReference _resultEditorHost;
    private int _editorVersion;
    private int _inputEditorVersion;
    private int _resultEditorVersion;
    private int _schemaControlVersion;
    private IReadOnlyList<DynamicMapperOutputField> _outputFields = [];
    private IReadOnlyList<DynamicMapperVariable> _variables = [];
    private DynamicMapperPreviewResult _previewResult = ErrorPreview("MqttPublishRequest", "Preview unavailable.");
    private MqttEnvelope _sampleEnvelope = DynamicMapperWorkbenchPreview.FallbackEnvelope();
    private string _sampleSource = "sample";
    private bool _sampleEdited;
    private string _inputJsonText = string.Empty;
    private string? _inputJsonError;
    private bool _syncingEditor;
    private bool _syncingInputEditor;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string EditorId => $"mapper-expression-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";
    private string InputEditorId => $"mapper-input-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";
    private string ResultEditorId => $"mapper-result-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";
    private string SchemaControlKey => $"{_outputMode}:{_schemaControlVersion}";
    private bool IsTypedOutputMode => string.Equals(_outputMode, DynamicMapperNodeModel.OutputContractTyped, StringComparison.Ordinal);
    private bool IsJsonSchemaFileMode => string.Equals(_outputMode, DynamicMapperNodeModel.OutputContractJsonSchemaFile, StringComparison.Ordinal);
    private string OutputFieldsKey => IsTypedOutputMode
        ? _outputType
        : IsJsonSchemaFileMode ? "JsonSchema" : "Any";
    private string OutputModeLabel => IsTypedOutputMode
        ? "typed"
        : IsJsonSchemaFileMode ? "json schema" : "any";
    private string OutputModeCaption => IsTypedOutputMode
        ? _outputType
        : IsJsonSchemaFileMode ? "JSON Schema" : "Any JSON";
    private bool IsMqttInput => string.Equals(_inputType, "MqttEnvelope", StringComparison.Ordinal);
    private string EngineCaption => string.Equals(_engine, "jsonata", StringComparison.OrdinalIgnoreCase)
        ? "JSONata"
        : "Dynamic Expresso";
    private string ResultPreviewTitle => IsTypedOutputMode
        ? _outputType
        : IsJsonSchemaFileMode ? "JSON Schema result" : "Any JSON";
    private string PreviewResultMarkerClass => _previewResult.Success
        ? "dynamic-mapper-result-marker ok"
        : "dynamic-mapper-result-marker error";
    private string PreviewResultMarkerText => _previewResult.Success ? "valid" : "error";
    private IReadOnlyList<DynamicMapperVariable> SummaryVariables
        => _variables
            .Where(static variable => variable.Depth == 0)
            .Take(MaxSummaryTokens)
            .ToArray();
    private int SummaryVariableOverflow
        => Math.Max(0, _variables.Count(static variable => variable.Depth == 0) - MaxSummaryTokens);
    private const int MaxSummaryTokens = 4;

    protected override void OnInitialized()
    {
        Live.Changed += OnLiveChanged;
        ThemeService.Changed += OnThemeChanged;
        RefreshWorkbench();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraftFromModel(resetSample: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var syncExpression = false;
        var syncInput = false;
        var syncResult = false;

        if (_editor is not null && !ReferenceEquals(_initializedEditor, _editor))
        {
            _initializedEditor = _editor;
            syncExpression = true;
        }

        if (_inputEditor is not null && !ReferenceEquals(_initializedInputEditor, _inputEditor))
        {
            _initializedInputEditor = _inputEditor;
            syncInput = true;
        }

        if (_resultEditor is not null && !ReferenceEquals(_initializedResultEditor, _resultEditor))
        {
            _initializedResultEditor = _resultEditor;
            syncResult = true;
        }

        if (syncExpression || syncInput || syncResult)
        {
            await ConfigureMonacoAsync();
        }

        if (syncExpression)
        {
            await SyncEditorAsync();
        }

        if (syncInput)
        {
            await SyncInputEditorAsync();
        }

        if (syncResult)
        {
            await SyncResultEditorAsync();
        }

        if (syncExpression || syncInput || syncResult)
        {
            await LayoutEditorsAfterRenderAsync();
        }
    }

    public void Dispose()
    {
        Live.Changed -= OnLiveChanged;
        ThemeService.Changed -= OnThemeChanged;
    }

    private Task LoadDraft()
    {
        LoadDraftFromModel(resetSample: true);
        return RefreshEditorsAndRenderAsync();
    }

    private void LoadDraftFromModel(bool resetSample)
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        if (resetSample)
        {
            _sampleEdited = false;
        }

        _engine = string.IsNullOrWhiteSpace(Model.Engine) ? "jsonata" : Model.Engine;
        _inputType = DynamicMapperNodeModel.NormalizeInputType(Model.InputType);
        _outputType = string.IsNullOrWhiteSpace(Model.OutputType) ? "MqttPublishRequest" : Model.OutputType;
        _outputMode = DynamicMapperNodeModel.NormalizeOutputContract(Model.OutputContract);
        _outputSchemaPath = Model.OutputSchemaPath;
        _schemaControlVersion++;
        _expression = string.IsNullOrWhiteSpace(Model.Expression)
            ? DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType)
            : Model.Expression;
        _editorVersion++;
        _inputEditorVersion++;
        _resultEditorVersion++;
        RefreshWorkbench();
    }

    private void OnLiveChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            RefreshWorkbench();
            await SyncInputEditorAsync();
            await SyncResultEditorAsync();
            StateHasChanged();
        });
    }

    private void OnThemeChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(ConfigureMonacoAsync);

    private void RefreshWorkbench()
    {
        if (!_sampleEdited)
        {
            if (IsMqttInput)
            {
                var (envelope, source) = ResolveSampleEnvelope();
                LoadSampleEnvelope(envelope, source, updateInputJson: true);
            }
            else
            {
                _sampleSource = _inputType;
                _inputJsonError = null;
                _inputJsonText = DynamicMapperWorkbenchPreview.InputJson(_inputType, _sampleEnvelope);
            }
        }

        _variables = DynamicMapperWorkbenchPreview.Variables(_inputType, _sampleEnvelope);
        _outputFields = DynamicMapperWorkbenchPreview.OutputFields(OutputFieldsKey, _engine);
        RefreshPreview();
    }

    private (MqttEnvelope Envelope, string Source) ResolveSampleEnvelope()
    {
        if (Live.SelectedMessage is not null)
        {
            return (Live.SelectedMessage, "selected");
        }

        if (Live.LatestMessage is not null)
        {
            return (Live.LatestMessage, "live");
        }

        if (Live.SelectedSessionMessages.LastOrDefault() is { } sessionMessage)
        {
            return (sessionMessage, "session");
        }

        if (Live.RecentMessages.LastOrDefault() is { } recentMessage)
        {
            return (recentMessage, "recent");
        }

        return (DynamicMapperWorkbenchPreview.FallbackEnvelope(), "sample");
    }

    private async Task ReloadWorkspaceSample()
    {
        _sampleEdited = false;
        RefreshWorkbench();
        await RefreshEditorsAndRenderAsync();
    }

    private void LoadSampleEnvelope(MqttEnvelope envelope, string source, bool updateInputJson)
    {
        _sampleEnvelope = envelope;
        _sampleSource = source;
        _inputJsonError = null;
        if (updateInputJson)
        {
            _inputJsonText = DynamicMapperWorkbenchPreview.InputJson(envelope);
        }
    }

    private void ApplyInputJson()
    {
        var result = DynamicMapperWorkbenchPreview.ParseInputJson(_inputJsonText);
        if (result is { Success: true, Envelope: not null })
        {
            LoadSampleEnvelope(result.Envelope, "edited", updateInputJson: false);
            _sampleEdited = true;
            _variables = DynamicMapperWorkbenchPreview.Variables(_inputType, _sampleEnvelope);
            _outputFields = DynamicMapperWorkbenchPreview.OutputFields(OutputFieldsKey, _engine);
            RefreshPreview();
            return;
        }

        _sampleEdited = true;
        _sampleSource = "invalid";
        _inputJsonError = result.Error ?? "Input JSON is invalid.";
        _variables = [];
        _outputFields = DynamicMapperWorkbenchPreview.OutputFields(OutputFieldsKey, _engine);
        RefreshPreview();
    }

    private Task SetEngine(string value)
    {
        if (string.Equals(_engine, value, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        var wasDefault = string.Equals(
            NormalizeExpression(_expression),
            NormalizeExpression(DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType)),
            StringComparison.Ordinal);
        _engine = value;
        if (wasDefault)
        {
            _expression = DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType);
        }

        _editorVersion++;
        RefreshWorkbench();
        return RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private Task SetInputType(string value)
    {
        var normalized = DynamicMapperNodeModel.NormalizeInputType(value);
        if (string.Equals(_inputType, normalized, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        var wasDefault = string.Equals(
            NormalizeExpression(_expression),
            NormalizeExpression(DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType)),
            StringComparison.Ordinal);
        _inputType = normalized;
        _sampleEdited = false;
        if (wasDefault)
        {
            _expression = DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType);
            _editorVersion++;
        }

        RefreshWorkbench();
        return RefreshEditorsAndRenderAsync();
    }

    private async Task SetOutputMode(string value)
    {
        var normalized = DynamicMapperNodeModel.NormalizeOutputContract(value);
        if (string.Equals(_outputMode, normalized, StringComparison.Ordinal))
        {
            return;
        }

        _outputMode = normalized;
        _schemaControlVersion++;
        RefreshWorkbench();
        await RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private Task SetOutputType(string value)
    {
        if (string.Equals(_outputType, value, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _outputType = value;
        _expression = DynamicMapperNodeModel.DefaultExpression(_outputType, _engine, _inputType);
        _editorVersion++;
        RefreshWorkbench();
        return RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private Task SetOutputSchemaPath(string value)
    {
        _outputSchemaPath = value ?? string.Empty;
        RefreshWorkbench();
        return RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private async Task PickOutputSchemaFileAsync()
    {
        var result = await FilePicker.Default.PickAsync(JsonSchemaPickOptions());
        if (result is null)
        {
            return;
        }

        _outputSchemaPath = result.FullPath;
        RefreshWorkbench();
        await RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private StandaloneEditorConstructionOptions InputEditorConstructionOptions(StandaloneCodeEditor editor)
        => new()
        {
            AutomaticLayout = true,
            Language = "json",
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            ReadOnly = !IsMqttInput,
            ScrollBeyondLastLine = false,
            Value = _inputJsonText
        };

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
        => new()
        {
            AutomaticLayout = true,
            Language = string.Equals(_engine, "jsonata", StringComparison.OrdinalIgnoreCase) ? "jsonata" : "csharp",
            ScrollBeyondLastLine = false,
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            Value = _expression
        };

    private StandaloneEditorConstructionOptions ResultEditorConstructionOptions(StandaloneCodeEditor editor)
        => new()
        {
            AutomaticLayout = true,
            Language = "json",
            ReadOnly = true,
            RenderLineHighlight = "none",
            ScrollBeyondLastLine = false,
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            Value = _previewResult.Json
        };

    private async Task ConfigureMonacoAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("fluxmqMonaco.ensureConfigured", ThemeService.IsDarkMode);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Dynamic Mapper Monaco configuration failed: {exception.Message}");
        }
    }

    private async Task OnInputEditorContentChanged()
    {
        if (!IsMqttInput)
        {
            return;
        }

        if (_syncingInputEditor)
        {
            return;
        }

        if (_inputEditor is not null)
        {
            _inputJsonText = await _inputEditor.GetValue();
        }

        ApplyInputJson();
        await RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private async Task OnEditorContentChanged()
    {
        if (_syncingEditor)
        {
            return;
        }

        if (_editor is not null)
        {
            _expression = await _editor.GetValue();
        }

        RefreshPreview();
        await RefreshEditorsAndRenderAsync(syncInput: false);
    }

    private async Task RefreshEditorsAndRenderAsync(bool syncInput = true)
    {
        if (syncInput)
        {
            await SyncInputEditorAsync();
        }

        await InvokeAsync(StateHasChanged);
        await SyncResultEditorAsync();
        await DialogRefresh.RefreshAsync(Node.NodeName);
        await LayoutEditorsAfterRenderAsync();
    }

    private async Task SyncEditorAsync()
    {
        if (_editor is null)
        {
            return;
        }

        _syncingEditor = true;
        try
        {
            try
            {
                await _editor.SetValue(_expression);
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"Dynamic Mapper expression editor sync failed: {exception.Message}");
            }
        }
        finally
        {
            _syncingEditor = false;
        }
    }

    private async Task SyncInputEditorAsync()
    {
        if (_inputEditor is null)
        {
            return;
        }

        _syncingInputEditor = true;
        try
        {
            try
            {
                await _inputEditor.SetValue(_inputJsonText);
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"Dynamic Mapper sample editor sync failed: {exception.Message}");
            }
        }
        finally
        {
            _syncingInputEditor = false;
        }
    }

    private async Task SyncResultEditorAsync()
    {
        if (_resultEditor is null)
        {
            return;
        }

        try
        {
            await _resultEditor.SetValue(_previewResult.Json);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Dynamic Mapper result editor sync failed: {exception.Message}");
        }
    }

    private async Task LayoutEditorsAfterRenderAsync()
    {
        await Task.Yield();
        await LayoutEditorsAsync();
        await Task.Delay(50);
        await LayoutEditorsAsync();
    }

    private async Task LayoutEditorsAsync()
    {
        await LayoutEditorAsync(_inputEditor, _inputEditorHost);
        await LayoutEditorAsync(_editor, _expressionEditorHost);
        await LayoutEditorAsync(_resultEditor, _resultEditorHost);
    }

    private async Task LayoutEditorAsync(StandaloneCodeEditor? editor, ElementReference host)
    {
        if (editor is null)
        {
            return;
        }

        try
        {
            var size = await JsRuntime.InvokeAsync<EditorHostSize>("fluxmqMonaco.measureElement", host);
            if (size is not null && size.Width > 0 && size.Height > 0)
            {
                await editor.Layout(new Dimension { Width = size.Width, Height = size.Height }, null);
            }
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Dynamic Mapper editor layout failed: {exception.Message}");
        }
    }

    private async Task SaveAsync()
    {
        if (_editor is not null)
        {
            _expression = await _editor.GetValue();
        }

        Model.Engine = string.IsNullOrWhiteSpace(_engine) ? "jsonata" : _engine.Trim();
        Model.InputType = DynamicMapperNodeModel.NormalizeInputType(_inputType);
        Model.OutputType = string.IsNullOrWhiteSpace(_outputType) ? "MqttPublishRequest" : _outputType.Trim();
        Model.OutputContract = DynamicMapperNodeModel.NormalizeOutputContract(_outputMode);
        Model.OutputSchemaPath = _outputSchemaPath.Trim();
        Model.Expression = string.IsNullOrWhiteSpace(_expression)
            ? DynamicMapperNodeModel.DefaultExpression(Model.OutputType, Model.Engine, Model.InputType)
            : _expression.Trim();
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
    }

    private string? ValidateEditor()
        => string.IsNullOrWhiteSpace(_expression)
            ? "Enter a mapping expression before saving."
            : null;

    private void RefreshPreview()
    {
        _previewResult = BuildPreview();
    }

    private DynamicMapperPreviewResult BuildPreview()
    {
        if (string.IsNullOrWhiteSpace(_expression))
        {
            return ErrorPreview(ResultPreviewTitle, "Enter a mapping expression before previewing.");
        }

        if (!string.IsNullOrWhiteSpace(_inputJsonError))
        {
            return ErrorPreview(ResultPreviewTitle, _inputJsonError);
        }

        return IsTypedOutputMode
            ? DynamicMapperWorkbenchPreview.Preview(_engine, _outputType, _expression, _inputType, _sampleEnvelope)
            : DynamicMapperWorkbenchPreview.PreviewAny(_engine, _expression, _inputType, _sampleEnvelope, ResultPreviewTitle);
    }

    private static string NormalizeExpression(string expression)
        => string.Join('\n', expression.Split(["\r\n", "\n"], StringSplitOptions.None).Select(line => line.TrimEnd())).Trim();

    private static PickOptions JsonSchemaPickOptions()
        => new()
        {
            PickerTitle = "Select JSON Schema",
            FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, [".json"] },
                { DevicePlatform.macOS, ["json", "public.json"] }
            })
        };

    private static DynamicMapperPreviewResult ErrorPreview(string title, string message)
        => new(false, title, [], message, JsonSerializer.Serialize(
            new Dictionary<string, object?>
            {
                ["error"] = message
            },
            PreviewJsonOptions));

    private static bool IsNonCriticalEditorException(Exception exception)
        => exception is JSException or JSDisconnectedException or InvalidOperationException or ObjectDisposedException;

    private static readonly JsonSerializerOptions PreviewJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private sealed class EditorHostSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }

}

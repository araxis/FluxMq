@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.DataObject"
                 CategoryColor="@Color.Primary"
                 EditDialogMaxWidth="MaxWidth.Large"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 EditorValidationError="@ValidateEditor"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="generated-source-summary node-ui-summary">
            <div class="generated-source-meta node-ui-facts">
                <div class="generated-source-meta-item node-ui-fact">
                    <span>Messages</span>
                    <strong>@MessageCountCaption</strong>
                </div>
                <div class="generated-source-meta-item topic node-ui-fact">
                    <span>First topic</span>
                    <strong title="@FirstTopicCaption">@FirstTopicCaption</strong>
                </div>
                <div class="generated-source-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="generated-source-previews" aria-label="Generated message preview">
                @foreach (var message in MessagePreview)
                {
                    <div class="generated-source-preview-row">
                        <span class="generated-source-preview-topic" title="@message.Topic">@message.Topic</span>
                        <span class="generated-source-token node-ui-token">QoS @SourceNodeConfiguration.NormalizeQualityOfService(message.QualityOfService)</span>
                        @if (message.Retain)
                        {
                            <span class="generated-source-token node-ui-token">retain</span>
                        }
                    </div>
                }
                @if (MessagePreviewOverflow > 0)
                {
                    <span class="generated-source-more">+@MessagePreviewOverflow more</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="generated-source-editor node-ui-editor" aria-label="Generated source settings">
            <div class="generated-source-layout" aria-label="Generated source editor layout">
                <div class="generated-source-message-table" aria-label="Generated message rows">
                    <div class="generated-source-table-header">
                        <span class="generated-source-column-header number">#</span>
                        <span class="generated-source-column-header">Topic</span>
                        <span class="generated-source-column-header">Payload</span>
                        <span class="generated-source-column-header">QoS</span>
                        <span class="generated-source-column-header">Retain</span>
                        <span class="generated-source-column-header">Received at</span>
                        <span class="generated-source-column-header action">
                            <MudTooltip Text="@AddGeneratedMessageLabel">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               aria-label="@AddGeneratedMessageLabel"
                                               Class="generated-source-add-button"
                                               OnClick="@AddMessageAsync" />
                            </MudTooltip>
                        </span>
                    </div>
                    @if (_messages.Count == 0)
                    {
                        <div class="generated-source-empty" role="status" aria-live="polite">
                            Add at least one generated message.
                        </div>
                    }
                    else
                    {
                        @for (var i = 0; i < _messages.Count; i++)
                        {
                            var index = i;
                            <div class="generated-source-message-row" @key="_messages[index]">
                                <span class="generated-source-message-index">@($"{index + 1:00}")</span>
                                <MudTextField T="string"
                                              Value="@_messages[index].Topic"
                                              ValueChanged="@(value => UpdateMessageTopicAsync(index, value))"
                                              Placeholder="@($"Topic {index + 1}")"
                                              aria-label="@($"Generated message {index + 1} topic")"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Class="generated-source-topic-field" />
                                <MudTextField T="string"
                                              Value="@_messages[index].Payload"
                                              ValueChanged="@(value => _messages[index].Payload = value ?? string.Empty)"
                                              Placeholder="Payload"
                                              aria-label="@($"Generated message {index + 1} payload")"
                                              Lines="2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="generated-source-payload-field" />
                                <MudSelect T="int"
                                           Value="@_messages[index].QualityOfService"
                                           ValueChanged="@(value => _messages[index].QualityOfService = value)"
                                           Label="QoS"
                                           aria-label="@($"Generated message {index + 1} QoS")"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Class="generated-source-qos-field">
                                    <MudSelectItem Value="@(0)">QoS 0</MudSelectItem>
                                    <MudSelectItem Value="@(1)">QoS 1</MudSelectItem>
                                    <MudSelectItem Value="@(2)">QoS 2</MudSelectItem>
                                </MudSelect>
                                <div class="generated-source-retain-toggle">
                                    <MudCheckBox T="bool"
                                                 Value="@_messages[index].Retain"
                                                 ValueChanged="@(value => _messages[index].Retain = value)"
                                                 aria-label="@($"Generated message {index + 1} retained")"
                                                 Dense="true"
                                                 Class="generated-source-retain-check" />
                                </div>
                                <MudTextField T="string"
                                              Value="@_messages[index].ReceivedAt"
                                              ValueChanged="@(value => _messages[index].ReceivedAt = value ?? string.Empty)"
                                              Placeholder="Received at"
                                              aria-label="@($"Generated message {index + 1} received at")"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="generated-source-received-field" />
                                <MudTooltip Text="@RemoveGeneratedMessageLabel(index)">
                                    <MudIconButton Size="Size.Small"
                                                   Icon="@Icons.Material.Filled.Close"
                                                   aria-label="@RemoveGeneratedMessageLabel(index)"
                                                   Class="generated-source-remove-button"
                                                   OnClick="@(() => RemoveMessage(index))" />
                                </MudTooltip>
                            </div>
                        }
                    }
                </div>

                <aside class="generated-source-sidecar" aria-label="Generated source support settings">
                    <MudNumericField T="int"
                                     Label="Output buffer"
                                     Value="@_boundedCapacity"
                                     ValueChanged="@SetBoundedCapacity"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="generated-source-buffer-field" />
                </aside>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private GeneratedSourceNodeModel Model => (GeneratedSourceNodeModel)Node;

    private int _boundedCapacity = SourceNodeConfiguration.DefaultBoundedCapacity;
    private readonly List<GeneratedMessageDraft> _messages = [];
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string MessageCountCaption => Model.Messages.Count.ToString();
    private string FirstTopicCaption => Model.Messages.FirstOrDefault()?.Topic ?? "No topic";
    private string BufferCaption => SourceNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity).ToString();
    private IReadOnlyList<GeneratedMessageDraft> MessagePreview => Model.Messages.Take(3).ToArray();
    private int MessagePreviewOverflow => Math.Max(0, Model.Messages.Count - 3);

    private string AddGeneratedMessageLabel => $"Add generated message to {Node.NodeName}";

    private string RemoveGeneratedMessageLabel(int index)
    {
        if (index < 0 || index >= _messages.Count)
        {
            return $"Remove generated message from {Node.NodeName}";
        }

        var topic = _messages[index].Topic?.Trim();
        var target = string.IsNullOrWhiteSpace(topic)
            ? $"generated message {index + 1}"
            : topic;

        return $"Remove {target} from {Node.NodeName}";
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _boundedCapacity = SourceNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity);
        _messages.Clear();
        _messages.AddRange(Model.Messages.Select(message => new GeneratedMessageDraft
        {
            Topic = message.Topic,
            Payload = message.Payload,
            QualityOfService = message.QualityOfService,
            Retain = message.Retain,
            ReceivedAt = message.ReceivedAt
        }));
        if (_messages.Count == 0)
            AddMessageDraft();
    }

    private async Task AddMessageAsync()
    {
        AddMessageDraft();
        await RefreshDialogAsync();
    }

    private async Task UpdateMessageTopicAsync(int index, string? value)
    {
        if (index >= 0 && index < _messages.Count)
        {
            _messages[index].Topic = value ?? string.Empty;
            await RefreshDialogAsync();
        }
    }

    private async Task SetBoundedCapacity(int value)
    {
        _boundedCapacity = value;
        await RefreshDialogAsync();
    }

    private void AddMessageDraft()
        => _messages.Add(new GeneratedMessageDraft
        {
            Topic = "factory/sample",
            Payload = """{"value":21.7,"unit":"c","status":"ok"}"""
        });

    private async Task RemoveMessage(int index)
    {
        if (index >= 0 && index < _messages.Count)
        {
            _messages.RemoveAt(index);
            await RefreshDialogAsync();
        }
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
    {
        if (_messages.Count == 0)
        {
            return "Add at least one generated message before saving.";
        }

        if (_messages.All(static message => string.IsNullOrWhiteSpace(message.Topic)))
        {
            return "Add at least one generated message before saving.";
        }

        if (_messages.Any(static message => string.IsNullOrWhiteSpace(message.Topic)))
        {
            return "Each generated message needs a topic.";
        }

        return _boundedCapacity is < 1 or > 100000
            ? "Output buffer must be between 1 and 100000."
            : null;
    }

    private Task SaveAsync()
    {
        Model.Messages = _messages
            .Where(message => !string.IsNullOrWhiteSpace(message.Topic))
            .Select(message => new GeneratedMessageDraft
            {
                Topic = message.Topic.Trim(),
                Payload = message.Payload ?? string.Empty,
                QualityOfService = SourceNodeConfiguration.NormalizeQualityOfService(message.QualityOfService),
                Retain = message.Retain,
                ReceivedAt = message.ReceivedAt?.Trim() ?? string.Empty
            })
            .ToList();
        if (Model.Messages.Count == 0)
        {
            Model.Messages.Add(new GeneratedMessageDraft
            {
                Topic = "factory/sample",
                Payload = """{"value":21.7,"unit":"c","status":"ok"}"""
            });
        }

        Model.BoundedCapacity = SourceNodeConfiguration.NormalizeBoundedCapacity(_boundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.PlayCircle"
                 CategoryColor="@Color.Primary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 EditorValidationError="@ValidateEditor"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="replay-source-summary node-ui-summary">
            <div class="replay-source-meta node-ui-facts">
                <div class="replay-source-meta-item session node-ui-fact">
                    <span>Session</span>
                    <strong title="@SessionCaption">@SessionCaption</strong>
                </div>
                <div class="replay-source-meta-item node-ui-fact">
                    <span>Speed</span>
                    <strong>@SpeedCaption</strong>
                </div>
                <div class="replay-source-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="replay-source-editor node-ui-editor" aria-label="Replay source settings">
            @{
                var sessions = Live.StoredSessions;
            }
            <div class="replay-source-editor-grid node-ui-form-grid" aria-label="Replay source configuration fields">
                @if (sessions.Count > 0)
                {
                    <MudSelect T="string"
                               Label="Session"
                               Value="@_sessionId"
                               ValueChanged="@SetSessionId"
                               aria-label="Replay session"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="replay-source-session-field"
                               ToStringFunc="@(id => sessions.FirstOrDefault(s => s.Id.ToString() == id)?.Name ?? id)">
                        @foreach (var session in sessions)
                        {
                            <MudSelectItem Value="@session.Id.ToString()">
                                <div class="replay-source-session-option">
                                    <span>@session.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(session.ProjectName) && session.ProjectName != "Default")
                                    {
                                        <small>@session.ProjectName</small>
                                    }
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string"
                                  Label="Session ID"
                                  Value="@_sessionId"
                                  ValueChanged="@SetSessionId"
                                  aria-label="Replay session ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="replay-source-session-field" />
                }
                <MudNumericField T="double"
                                 Label="Playback speed"
                                 Value="@_speed"
                                 ValueChanged="@SetSpeed"
                                 aria-label="Replay playback speed"
                                 Min="0.1"
                                 Max="1000"
                                 Step="0.1"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="replay-source-speed-field" />

                <MudNumericField T="int"
                                 Label="Output buffer"
                                 Value="@_boundedCapacity"
                                 ValueChanged="@SetBoundedCapacity"
                                 aria-label="Replay output buffer"
                                 Min="1"
                                 Max="100000"
                                 Step="100"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="replay-source-buffer-field" />
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private ReplaySourceNodeModel Model => (ReplaySourceNodeModel)Node;

    private string _sessionId = string.Empty;
    private double _speed = 1;
    private int _boundedCapacity = SourceNodeConfiguration.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string SessionCaption => ResolvedSessionName ?? "No session";
    private string SpeedCaption => $"{NormalizedSpeed:0.##}x";
    private string BufferCaption => SourceNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity).ToString();
    private double NormalizedSpeed => Model.Speed > 0 && double.IsFinite(Model.Speed) ? Model.Speed : 1;

    private string? ResolvedSessionName
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Model.SessionId))
            {
                return null;
            }

            return Live.StoredSessions.FirstOrDefault(s => s.Id.ToString() == Model.SessionId)?.Name ?? Model.SessionId;
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _sessionId = Model.SessionId;
        _speed = Model.Speed > 0 && double.IsFinite(Model.Speed) ? Model.Speed : 1;
        _boundedCapacity = SourceNodeConfiguration.NormalizeBoundedCapacity(Model.BoundedCapacity);
    }

    private async Task SetSessionId(string value)
    {
        _sessionId = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetSpeed(double value)
    {
        _speed = value;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetBoundedCapacity(int value)
    {
        _boundedCapacity = value;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
    {
        if (string.IsNullOrWhiteSpace(_sessionId))
        {
            return "Select or enter a replay session before saving.";
        }

        if (_speed is < 0.1 or > 1000 || !double.IsFinite(_speed))
        {
            return "Playback speed must be between 0.1 and 1000.";
        }

        return _boundedCapacity is < 1 or > 100000
            ? "Output buffer must be between 1 and 100000."
            : null;
    }

    private Task SaveAsync()
    {
        Model.SessionId = _sessionId?.Trim() ?? string.Empty;
        Model.Speed = _speed > 0 && double.IsFinite(_speed) ? _speed : 1;
        Model.BoundedCapacity = SourceNodeConfiguration.NormalizeBoundedCapacity(_boundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Public"
                 CategoryColor="@Color.Tertiary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="http-client-summary">
            <div class="http-client-meta">
                <div class="http-client-meta-item target">
                    <span>Target</span>
                    <strong title="@TargetCaption">@TargetCaption</strong>
                </div>
                <div class="http-client-meta-item">
                    <span>Timeout</span>
                    <strong>@TimeoutCaption</strong>
                </div>
                <div class="http-client-meta-item">
                    <span>Input buffer</span>
                    <strong>@InputBufferCaption</strong>
                </div>
            </div>

            <div class="http-client-contracts">
                <div class="http-client-contract" aria-label="HTTP request fields">
                    <span class="http-client-contract-label">Request fields</span>
                    <span class="http-client-token">method</span>
                    <span class="http-client-token">url</span>
                    <span class="http-client-token">headers</span>
                    <span class="http-client-token">body</span>
                </div>
                <div class="http-client-contract" aria-label="HTTP response fields">
                    <span class="http-client-contract-label">Response fields</span>
                    <span class="http-client-token">status</span>
                    <span class="http-client-token">headers</span>
                    <span class="http-client-token">body</span>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="http-client-editor" aria-label="HTTP client settings">
            <MudTextField T="string"
                          Label="Base URL"
                          @bind-Value="_baseUrl"
                          Placeholder="https://api.example.test/"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="http-client-base-url-field" />

            <div class="http-client-number-grid">
                <MudNumericField T="int"
                                 Label="Timeout ms"
                                 @bind-Value="_defaultTimeoutMilliseconds"
                                 Min="1"
                                 Max="600000"
                                 Step="1000"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="http-client-timeout-field" />
                <MudNumericField T="int"
                                 Label="Max body bytes"
                                 @bind-Value="_maxResponseBodyBytes"
                                 Min="1"
                                 Max="104857600"
                                 Step="1024"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="http-client-body-limit-field" />
                <MudNumericField T="int"
                                 Label="Input buffer"
                                 @bind-Value="_boundedCapacity"
                                 Min="1"
                                 Max="100000"
                                 Step="64"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="http-client-buffer-field" />
            </div>

            <div class="http-client-options" aria-label="HTTP client options">
                <MudCheckBox T="bool"
                             Label="Follow redirects"
                             @bind-Value="_followRedirects"
                             Color="Color.Primary" />
                <MudCheckBox T="bool"
                             Label="Non-success status emits error"
                             @bind-Value="_treatNonSuccessStatusAsError"
                             Color="Color.Primary" />
            </div>

            <MudTextField T="string"
                          Label="Default headers"
                          @bind-Value="_defaultHeadersText"
                          Lines="5"
                          Placeholder="Authorization: Bearer token"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="http-client-headers-field" />
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private HttpRequestNodeModel Model => (HttpRequestNodeModel)Node;

    private string _baseUrl = string.Empty;
    private string _defaultHeadersText = string.Empty;
    private int _defaultTimeoutMilliseconds = HttpRequestNodeModel.DefaultTimeoutMilliseconds;
    private int _maxResponseBodyBytes = HttpRequestNodeModel.DefaultMaxResponseBodyBytes;
    private bool _followRedirects = true;
    private bool _treatNonSuccessStatusAsError;
    private int _boundedCapacity = HttpRequestNodeModel.DefaultBoundedCapacity;

    private string TargetCaption => string.IsNullOrWhiteSpace(_baseUrl) ? "Per request" : _baseUrl.Trim();
    private string TimeoutCaption => $"{HttpRequestNodeModel.NormalizePositiveInt(_defaultTimeoutMilliseconds, HttpRequestNodeModel.DefaultTimeoutMilliseconds)} ms";
    private string InputBufferCaption => HttpRequestNodeModel
        .NormalizePositiveInt(_boundedCapacity, HttpRequestNodeModel.DefaultBoundedCapacity)
        .ToString();

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _baseUrl = Model.BaseUrl;
        _defaultHeadersText = Model.DefaultHeadersText;
        _defaultTimeoutMilliseconds = HttpRequestNodeModel.NormalizePositiveInt(Model.DefaultTimeoutMillisecondsValue, HttpRequestNodeModel.DefaultTimeoutMilliseconds);
        _maxResponseBodyBytes = HttpRequestNodeModel.NormalizePositiveInt(Model.MaxResponseBodyBytes, HttpRequestNodeModel.DefaultMaxResponseBodyBytes);
        _followRedirects = Model.FollowRedirects;
        _treatNonSuccessStatusAsError = Model.TreatNonSuccessStatusAsError;
        _boundedCapacity = HttpRequestNodeModel.NormalizePositiveInt(Model.BoundedCapacity, HttpRequestNodeModel.DefaultBoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.BaseUrl = _baseUrl.Trim();
        Model.DefaultHeadersText = _defaultHeadersText.Trim();
        Model.DefaultTimeoutMillisecondsValue = HttpRequestNodeModel.NormalizePositiveInt(_defaultTimeoutMilliseconds, HttpRequestNodeModel.DefaultTimeoutMilliseconds);
        Model.MaxResponseBodyBytes = HttpRequestNodeModel.NormalizePositiveInt(_maxResponseBodyBytes, HttpRequestNodeModel.DefaultMaxResponseBodyBytes);
        Model.FollowRedirects = _followRedirects;
        Model.TreatNonSuccessStatusAsError = _treatNonSuccessStatusAsError;
        Model.BoundedCapacity = HttpRequestNodeModel.NormalizePositiveInt(_boundedCapacity, HttpRequestNodeModel.DefaultBoundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

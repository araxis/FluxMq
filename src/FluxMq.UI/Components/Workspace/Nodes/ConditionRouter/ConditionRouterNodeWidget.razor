@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.CallSplit"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="condition-router-summary">
            <div class="condition-router-meta">
                <div class="condition-router-meta-item input">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="condition-router-meta-item">
                    <span>True</span>
                    <strong>WhenTrue</strong>
                </div>
                <div class="condition-router-meta-item">
                    <span>False</span>
                    <strong>WhenFalse</strong>
                </div>
            </div>

            <div class="condition-router-expression" aria-label="Condition router expression">
                <span class="condition-router-section-label">Condition</span>
                <strong title="@ExpressionPreview">@ExpressionPreview</strong>
            </div>

            <div class="condition-router-variables" aria-label="Condition router variables">
                <span class="condition-router-section-label">Variables</span>
                @foreach (var variable in SummaryVariables)
                {
                    <span class="condition-router-token" title="@($"{variable.Name}: {variable.Type}")">@variable.Name</span>
                }
                @if (VariableOverflow > 0)
                {
                    <span class="condition-router-token overflow">+@VariableOverflow</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="condition-router-editor" aria-label="Condition router settings">
            <section class="condition-router-editor-surface" aria-label="Condition router configuration">
                <div class="condition-router-config-row">
                    <MudSelect T="string"
                               Value="@_inputType"
                               ValueChanged="@SetInputType"
                               Label="Input type"
                               aria-label="Condition input type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="condition-router-input-field">
                        @foreach (var inputType in ConditionRouterNodeModel.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@InputTypeLabel(inputType)</MudSelectItem>
                        }
                    </MudSelect>

                    <div class="condition-router-output-map" aria-label="Condition router outputs">
                        <div>
                            <span>True</span>
                            <strong>WhenTrue</strong>
                        </div>
                        <div>
                            <span>False</span>
                            <strong>WhenFalse</strong>
                        </div>
                    </div>
                </div>

                <div class="condition-router-expression-row" aria-label="Condition router rule">
                    <MudTextField T="string"
                                  @bind-Value="_expression"
                                  Label="Condition"
                                  aria-label="Condition expression"
                                  Variant="Variant.Outlined"
                                  Lines="8"
                                  Class="condition-router-expression-field"
                                  Placeholder="@ExpressionPlaceholder" />

                    <div class="condition-router-variable-reference" aria-label="Available condition variables">
                        <span class="condition-router-variable-label">Variables</span>
                        <span class="condition-router-variable-list">
                            @foreach (var variable in Variables)
                            {
                                <span class="condition-router-variable-token" title="@($"{variable.Type}: {variable.Example}")">
                                    <code>@variable.Name</code>
                                    <small>@variable.Type</small>
                                </span>
                            }
                        </span>
                    </div>
                </div>
            </section>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private ConditionRouterNodeModel Model => (ConditionRouterNodeModel)Node;

    private string _expression = string.Empty;
    private string _inputType = "MqttEnvelope";
    private bool IsMetricInput => string.Equals(_inputType, "NumberMetricReading", StringComparison.Ordinal);
    private string InputTypeCaption => InputTypeLabel(ConditionRouterNodeModel.NormalizeInputType(Model.InputType));
    private string ExpressionPreview => string.IsNullOrWhiteSpace(Model.Expression)
        ? ConditionRouterNodeModel.DefaultExpression(Model.InputType)
        : Model.Expression.Trim();
    private IReadOnlyList<ConditionVariable> Variables => IsMetricInput ? MetricVariables : MqttVariables;
    private IReadOnlyList<ConditionVariable> SummaryVariables => Variables.Take(MaxSummaryVariables).ToArray();
    private int VariableOverflow => Math.Max(0, Variables.Count - MaxSummaryVariables);
    private string ExpressionPlaceholder => IsMetricInput ? "value > 10" : "topic.StartsWith(\"sensors/\") && qos >= 1";
    private const int MaxSummaryVariables = 4;

    private static readonly IReadOnlyList<ConditionVariable> MqttVariables =
    [
        new("topic", "string", "topic.StartsWith(\"sensors/\")"),
        new("payload", "string", "payload.Contains(\"error\")"),
        new("qos", "int", "qos >= 1"),
        new("retain", "bool", "retain == true"),
        new("receivedAt", "DateTimeOffset", "receivedAt.Hour >= 8")
    ];

    private static readonly IReadOnlyList<ConditionVariable> MetricVariables =
    [
        new("metricId", "string", "metricId == \"messageRate\""),
        new("value", "double", "value > 10"),
        new("timestamp", "DateTimeOffset", "timestamp.Minute >= 0"),
        new("reading", "FluxMetricReading<double>", "reading.Value > 10")
    ];

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _inputType = ConditionRouterNodeModel.NormalizeInputType(Model.InputType);
        _expression = string.IsNullOrWhiteSpace(Model.Expression)
            ? ConditionRouterNodeModel.DefaultExpression(_inputType)
            : Model.Expression;
    }

    private Task SaveAsync()
    {
        Model.InputType = ConditionRouterNodeModel.NormalizeInputType(_inputType);
        Model.Expression = _expression.Trim();
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private Task SetInputType(string value)
    {
        var normalized = ConditionRouterNodeModel.NormalizeInputType(value);
        if (!string.Equals(_inputType, normalized, StringComparison.Ordinal))
        {
            _inputType = normalized;
            _expression = ConditionRouterNodeModel.DefaultExpression(_inputType);
        }

        return Task.CompletedTask;
    }

    private static string InputTypeLabel(string inputType)
        => string.Equals(inputType, "NumberMetricReading", StringComparison.Ordinal)
            ? "Number metric"
            : "MQTT message";

    private readonly record struct ConditionVariable(string Name, string Type, string Example);
}

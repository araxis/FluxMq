@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject FlowWorkspaceService Flow

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Bolt"
                 CategoryColor="@Color.Primary"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <MudStack Spacing="1" Class="mt-1">
            <Stat Icon="@Icons.Material.Filled.Cable" Label="Broker" Value="@(Model.Connection.Length > 0 ? Model.Connection : "—")" />
        </MudStack>
        <div class="flow-node-filters mt-1 d-flex flex-wrap gap-1">
            @foreach (var filter in Model.Subscriptions)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="@(filter.StartsWith('$') ? Color.Warning : Color.Primary)"
                         Icon="@Icons.Material.Filled.Topic">
                    @filter
                </MudChip>
            }
        </div>
    </Body>
    <Editor>
        @{
            var connectionNames = Flow.GetConnectionNames();
        }
        @if (connectionNames.Count > 0)
        {
            <MudSelect T="string" Label="Broker connection" @bind-Value="_connection"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var name in connectionNames)
                {
                    <MudSelectItem Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudTextField T="string"
                          Label="Connection (resource name)"
                          @bind-Value="_connection"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Add an mqtt.connection resource to enable the dropdown." />
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">Subscriptions</MudText>
        @for (var i = 0; i < _draftFilters.Count; i++)
        {
            var index = i;
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudTextField T="string"
                              Value="@_draftFilters[index]"
                              ValueChanged="@(v => _draftFilters[index] = v ?? string.Empty)"
                              Placeholder="topic/#"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flex-grow-1" />
                <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.Close"
                               OnClick="@(() => _draftFilters.RemoveAt(index))" />
            </MudStack>
        }
        <MudButton Size="Size.Small"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@AddRow">Add filter</MudButton>
    </Editor>
</NodeWidgetShell>

@code {
    private MqttTriggerNodeModel Model => (MqttTriggerNodeModel)Node;

    private string _connection = string.Empty;
    private readonly List<string> _draftFilters = [];

    protected override void OnParametersSet()
    {
        LoadDraft();
    }

    private void LoadDraft()
    {
        _connection = Model.Connection;
        _draftFilters.Clear();
        _draftFilters.AddRange(Model.Subscriptions);
        if (_draftFilters.Count == 0) _draftFilters.Add("#");
    }

    private void AddRow() => _draftFilters.Add(string.Empty);

    private Task SaveAsync()
    {
        var trimmed = _draftFilters
            .Select(f => f?.Trim() ?? string.Empty)
            .Where(f => f.Length > 0)
            .ToArray();
        if (trimmed.Length == 0) trimmed = ["#"];

        Model.Connection = _connection;
        Model.Subscriptions = trimmed;
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

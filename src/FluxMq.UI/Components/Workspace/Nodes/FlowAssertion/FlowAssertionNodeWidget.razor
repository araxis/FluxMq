@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FactCheck"
                 CategoryColor="@Color.Info"
                 EditDialogMaxWidth="MaxWidth.Large"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="flow-assertion-summary">
            <div class="flow-assertion-meta">
                <div class="flow-assertion-meta-item assertion">
                    <span>Assertion</span>
                    <strong title="@AssertionCaption">@AssertionCaption</strong>
                </div>
                <div class="flow-assertion-meta-item">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="flow-assertion-meta-item">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="flow-assertion-contracts">
                <div class="flow-assertion-contract" aria-label="Assertion output fields">
                    <span class="flow-assertion-contract-label">Outputs</span>
                    <span class="flow-assertion-token">result</span>
                    <span class="flow-assertion-token pass">passed</span>
                    <span class="flow-assertion-token fail">failed</span>
                </div>
            </div>

            <div class="@ExpressionPreviewClass" title="@ExpressionCaption">
                @ExpressionCaption
            </div>
        </div>
    </Body>
    <Editor>
        <div class="flow-assertion-editor">
            <section class="flow-assertion-editor-surface" aria-label="Flow assertion settings">
                <div class="flow-assertion-config-row" aria-label="Flow assertion configuration">
                    <MudTextField T="string"
                                  Label="Assertion name"
                                  @bind-Value="_assertionName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="flow-assertion-name-field" />
                    <MudSelect T="string"
                               Label="Input type"
                               @bind-Value="_inputType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="flow-assertion-input-field">
                        @foreach (var inputType in FlowAssertionNodeModel.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int"
                                     Label="Input buffer"
                                     @bind-Value="_boundedCapacity"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="flow-assertion-buffer-field" />
                </div>

                <div class="flow-assertion-rule-surface" aria-label="Flow assertion rule">
                    <div class="flow-assertion-rule-grid">
                        <MudTextField T="string"
                                      Label="Expression"
                                      @bind-Value="_expression"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="10"
                                      Class="flow-assertion-expression-field"
                                      Placeholder='topic.StartsWith("factory/") && qos >= 1' />

                        <aside class="flow-assertion-rule-aside">
                            <MudTextField T="string"
                                          Label="Failure message"
                                          @bind-Value="_failureMessage"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="4"
                                          Class="flow-assertion-message-field"
                                          Placeholder="Message on failure" />

                            <div class="flow-assertion-reference" aria-label="Assertion expression variables">
                                <span class="flow-assertion-reference-label">Variables</span>
                                <span class="flow-assertion-variable-list">
                                    @foreach (var variable in ExpressionVariables)
                                    {
                                        <span class="flow-assertion-variable">@variable</span>
                                    }
                                </span>
                            </div>
                        </aside>
                    </div>
                </div>
            </section>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private FlowAssertionNodeModel Model => (FlowAssertionNodeModel)Node;

    private string _assertionName = FlowAssertionNodeModel.DefaultAssertionName;
    private string _inputType = FlowAssertionNodeModel.DefaultInputType;
    private string _expression = FlowAssertionNodeModel.DefaultExpression;
    private string _failureMessage = FlowAssertionNodeModel.DefaultFailureMessage;
    private int _boundedCapacity = FlowAssertionNodeModel.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string AssertionCaption => string.IsNullOrWhiteSpace(Model.AssertionName)
        ? FlowAssertionNodeModel.DefaultAssertionName
        : Model.AssertionName.Trim();
    private string InputTypeCaption => FlowAssertionNodeModel.NormalizeInputType(Model.InputType);
    private string BufferCaption => FlowAssertionNodeModel.NormalizeBoundedCapacity(Model.BoundedCapacity).ToString();
    private string ExpressionCaption => string.IsNullOrWhiteSpace(Model.Expression)
        ? "No expression"
        : Model.Expression.Trim();
    private string ExpressionPreviewClass => string.IsNullOrWhiteSpace(Model.Expression)
        ? "flow-assertion-expression-preview empty"
        : "flow-assertion-expression-preview";

    private static readonly string[] ExpressionVariables =
    [
        "input",
        "value",
        "inputType",
        "topic",
        "payload",
        "qos",
        "path",
        "isValid",
        "issueCount"
    ];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _assertionName = Model.AssertionName;
        _inputType = FlowAssertionNodeModel.NormalizeInputType(Model.InputType);
        _expression = Model.Expression;
        _failureMessage = Model.FailureMessage;
        _boundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(Model.BoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.AssertionName = string.IsNullOrWhiteSpace(_assertionName)
            ? FlowAssertionNodeModel.DefaultAssertionName
            : _assertionName.Trim();
        Model.InputType = FlowAssertionNodeModel.NormalizeInputType(_inputType);
        Model.Expression = string.IsNullOrWhiteSpace(_expression)
            ? FlowAssertionNodeModel.DefaultExpression
            : _expression.Trim();
        Model.FailureMessage = string.IsNullOrWhiteSpace(_failureMessage)
            ? FlowAssertionNodeModel.DefaultFailureMessage
            : _failureMessage.Trim();
        Model.BoundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(_boundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

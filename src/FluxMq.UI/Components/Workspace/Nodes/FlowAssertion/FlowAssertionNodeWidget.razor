@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FactCheck"
                 CategoryColor="@Color.Warning"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <MudStack Spacing="1" Class="mt-1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.AssertionName</MudText>
            <div class="d-flex flex-wrap gap-1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@Model.InputType</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Passed</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Failed</MudChip>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Expression))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="node-expr-preview">@Model.Expression</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Error">No assertion set</MudText>
            }
        </MudStack>
    </Body>
    <Editor>
        <MudStack Spacing="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Assertion name"
                                  @bind-Value="_assertionName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Label="Input type"
                               @bind-Value="_inputType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @foreach (var inputType in FlowAssertionNodeModel.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudTextField T="string"
                          Label="Expression"
                          @bind-Value="_expression"
                          Variant="Variant.Outlined"
                          Lines="4"
                          Class="node-expr-field"
                          Placeholder='topic.StartsWith("factory/") && qos >= 1'
                          HelperText="Must evaluate to bool. Variables always include input, value, and inputType; known types also expose helpers such as topic, payload, qos, path, isValid, or issueCount." />
            <MudTextField T="string"
                          Label="Failure message"
                          @bind-Value="_failureMessage"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudNumericField T="int"
                             Label="Input buffer"
                             @bind-Value="_boundedCapacity"
                             Min="1"
                             Max="100000"
                             Step="100"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense" />
            <MudExpansionPanel Text="Expression variables" Dense="true" Class="pa-0">
                <MudSimpleTable Dense="true" Striped="true" Class="mt-1">
                    <thead>
                        <tr><th>Variable</th><th>Available when</th><th>Example</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><code>input</code></td><td>all input types</td><td><code>input != null</code></td></tr>
                        <tr><td><code>topic</code></td><td>MQTT-shaped values</td><td><code>topic.StartsWith("sensors/")</code></td></tr>
                        <tr><td><code>qos</code></td><td>MQTT-shaped values</td><td><code>qos >= 1</code></td></tr>
                        <tr><td><code>path</code></td><td>FileWriteRequest</td><td><code>path.EndsWith(".json")</code></td></tr>
                        <tr><td><code>isValid</code></td><td>JsonSchemaValidationResult</td><td><code>isValid == true</code></td></tr>
                        <tr><td><code>issueCount</code></td><td>JsonSchemaValidationResult</td><td><code>issueCount == 0</code></td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudExpansionPanel>
        </MudStack>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private FlowAssertionNodeModel Model => (FlowAssertionNodeModel)Node;

    private string _assertionName = FlowAssertionNodeModel.DefaultAssertionName;
    private string _inputType = FlowAssertionNodeModel.DefaultInputType;
    private string _expression = FlowAssertionNodeModel.DefaultExpression;
    private string _failureMessage = FlowAssertionNodeModel.DefaultFailureMessage;
    private int _boundedCapacity = FlowAssertionNodeModel.DefaultBoundedCapacity;

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _assertionName = Model.AssertionName;
        _inputType = FlowAssertionNodeModel.NormalizeInputType(Model.InputType);
        _expression = Model.Expression;
        _failureMessage = Model.FailureMessage;
        _boundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(Model.BoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.AssertionName = string.IsNullOrWhiteSpace(_assertionName)
            ? FlowAssertionNodeModel.DefaultAssertionName
            : _assertionName.Trim();
        Model.InputType = FlowAssertionNodeModel.NormalizeInputType(_inputType);
        Model.Expression = string.IsNullOrWhiteSpace(_expression)
            ? FlowAssertionNodeModel.DefaultExpression
            : _expression.Trim();
        Model.FailureMessage = string.IsNullOrWhiteSpace(_failureMessage)
            ? FlowAssertionNodeModel.DefaultFailureMessage
            : _failureMessage.Trim();
        Model.BoundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(_boundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

@implements IDisposable
@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject AppThemeService ThemeService
@inject IJSRuntime JsRuntime
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FactCheck"
                 CategoryColor="@Color.Info"
                 EditDialogMaxWidth="MaxWidth.Large"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="flow-assertion-summary node-ui-summary">
            <div class="flow-assertion-meta node-ui-facts">
                <div class="flow-assertion-meta-item assertion node-ui-fact">
                    <span>Assertion</span>
                    <strong title="@AssertionCaption">@AssertionCaption</strong>
                </div>
                <div class="flow-assertion-meta-item node-ui-fact">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="flow-assertion-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="flow-assertion-output-fields node-ui-token-group">
                <div class="flow-assertion-output-row node-ui-token-row" aria-label="Assertion output fields">
                    <span class="flow-assertion-output-label node-ui-fact-label">Outputs</span>
                    <span class="flow-assertion-token node-ui-token">result</span>
                    <span class="flow-assertion-token pass node-ui-token">passed</span>
                    <span class="flow-assertion-token fail node-ui-token">failed</span>
                </div>
            </div>

            <div class="@ExpressionPreviewClass" title="@ExpressionCaption">
                @ExpressionCaption
            </div>
        </div>
    </Body>
    <Editor>
        <div class="flow-assertion-editor node-ui-editor" aria-label="Flow assertion settings">
            <div class="flow-assertion-config-row node-ui-form-grid" aria-label="Flow assertion configuration">
                <MudTextField T="string"
                              Label="Assertion name"
                              @bind-Value="_assertionName"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flow-assertion-name-field" />
                <MudSelect T="string"
                           Label="Input type"
                           @bind-Value="_inputType"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="flow-assertion-input-field">
                    @foreach (var inputType in FlowAssertionNodeModel.InputTypes)
                    {
                        <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int"
                                 Label="Input buffer"
                                 @bind-Value="_boundedCapacity"
                                 Min="1"
                                 Max="100000"
                                 Step="100"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="flow-assertion-buffer-field" />
            </div>

            <div class="flow-assertion-rule-row" aria-label="Flow assertion rule">
                <section class="flow-assertion-expression-workspace node-ui-code-surface" aria-label="Assertion expression">
                    <div class="flow-assertion-workspace-header">
                        <div>
                            <span class="flow-assertion-kicker">Condition</span>
                            <strong>Pass condition</strong>
                        </div>
                    </div>

                    <div class="flow-assertion-editor-host" @ref="_expressionEditorHost">
                        <StandaloneCodeEditor @key="_editorVersion"
                                              @ref="_editor"
                                              Id="@EditorId"
                                              CssClass="flow-assertion-code-editor"
                                              ConstructionOptions="@EditorConstructionOptions"
                                              OnDidChangeModelContent="@OnExpressionContentChanged" />
                    </div>
                </section>

                <div class="flow-assertion-rule-sidecar">
                    <MudTextField T="string"
                                  Label="Failure message"
                                  @bind-Value="_failureMessage"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  Class="flow-assertion-message-field"
                                  Placeholder="Message on failure" />

                    <div class="flow-assertion-variable-strip" aria-label="Assertion expression variables">
                        <span class="flow-assertion-variable-label">Variables</span>
                        <span class="flow-assertion-variable-list">
                            @foreach (var variable in ExpressionVariables)
                            {
                                <span class="flow-assertion-variable">@variable</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private FlowAssertionNodeModel Model => (FlowAssertionNodeModel)Node;

    private string _assertionName = FlowAssertionNodeModel.DefaultAssertionName;
    private string _inputType = FlowAssertionNodeModel.DefaultInputType;
    private string _expression = FlowAssertionNodeModel.DefaultExpression;
    private string _failureMessage = FlowAssertionNodeModel.DefaultFailureMessage;
    private int _boundedCapacity = FlowAssertionNodeModel.DefaultBoundedCapacity;
    private StandaloneCodeEditor? _editor;
    private StandaloneCodeEditor? _initializedEditor;
    private ElementReference _expressionEditorHost;
    private int _editorVersion;
    private bool _syncingEditor;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string EditorId => $"flow-assertion-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";
    private string AssertionCaption => string.IsNullOrWhiteSpace(Model.AssertionName)
        ? FlowAssertionNodeModel.DefaultAssertionName
        : Model.AssertionName.Trim();
    private string InputTypeCaption => FlowAssertionNodeModel.NormalizeInputType(Model.InputType);
    private string BufferCaption => FlowAssertionNodeModel.NormalizeBoundedCapacity(Model.BoundedCapacity).ToString();
    private string ExpressionCaption => string.IsNullOrWhiteSpace(Model.Expression)
        ? "No expression"
        : Model.Expression.Trim();
    private string ExpressionPreviewClass => string.IsNullOrWhiteSpace(Model.Expression)
        ? "flow-assertion-expression-preview empty"
        : "flow-assertion-expression-preview";

    private static readonly string[] ExpressionVariables =
    [
        "input",
        "value",
        "inputType",
        "topic",
        "payload",
        "qos",
        "path",
        "isValid",
        "issueCount"
    ];

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editor is not null && !ReferenceEquals(_initializedEditor, _editor))
        {
            _initializedEditor = _editor;
            await ConfigureCodeEditorAsync();
            await SyncEditorAsync();
            await LayoutEditorAfterRenderAsync();
        }
    }

    public void Dispose()
        => ThemeService.Changed -= OnThemeChanged;

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _assertionName = Model.AssertionName;
        _inputType = FlowAssertionNodeModel.NormalizeInputType(Model.InputType);
        _expression = Model.Expression;
        _failureMessage = Model.FailureMessage;
        _boundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(Model.BoundedCapacity);
        _editorVersion++;
    }

    private void OnThemeChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(ConfigureCodeEditorAsync);

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
        => new()
        {
            AutomaticLayout = true,
            Language = "csharp",
            ScrollBeyondLastLine = false,
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            Value = _expression
        };

    private async Task ConfigureCodeEditorAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("fluxmqMonaco.ensureConfigured", ThemeService.IsDarkMode);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Flow Assertion code editor configuration failed: {exception.Message}");
        }
    }

    private async Task SaveAsync()
    {
        if (_editor is not null)
        {
            try
            {
                _expression = await _editor.GetValue();
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"Flow Assertion code editor read failed: {exception.Message}");
            }
        }

        Model.AssertionName = string.IsNullOrWhiteSpace(_assertionName)
            ? FlowAssertionNodeModel.DefaultAssertionName
            : _assertionName.Trim();
        Model.InputType = FlowAssertionNodeModel.NormalizeInputType(_inputType);
        Model.Expression = string.IsNullOrWhiteSpace(_expression)
            ? FlowAssertionNodeModel.DefaultExpression
            : _expression.Trim();
        Model.FailureMessage = string.IsNullOrWhiteSpace(_failureMessage)
            ? FlowAssertionNodeModel.DefaultFailureMessage
            : _failureMessage.Trim();
        Model.BoundedCapacity = FlowAssertionNodeModel.NormalizeBoundedCapacity(_boundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
    }

    private async Task OnExpressionContentChanged()
    {
        if (_syncingEditor || _editor is null)
        {
            return;
        }

        _expression = await _editor.GetValue();
        await RefreshDialogAsync();
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
        await LayoutEditorAfterRenderAsync();
    }

    private async Task SyncEditorAsync()
    {
        if (_editor is null)
        {
            return;
        }

        _syncingEditor = true;
        try
        {
            await _editor.SetValue(_expression);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Flow Assertion code editor sync failed: {exception.Message}");
        }
        finally
        {
            _syncingEditor = false;
        }
    }

    private async Task LayoutEditorAfterRenderAsync()
    {
        await Task.Yield();
        await LayoutEditorAsync();
        await Task.Delay(50);
        await LayoutEditorAsync();
    }

    private async Task LayoutEditorAsync()
    {
        if (_editor is null)
        {
            return;
        }

        try
        {
            var size = await JsRuntime.InvokeAsync<EditorHostSize>("fluxmqMonaco.measureElement", _expressionEditorHost);
            if (size is not null && size.Width > 0 && size.Height > 0)
            {
                await _editor.Layout(new Dimension { Width = size.Width, Height = size.Height }, null);
            }
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Flow Assertion editor layout failed: {exception.Message}");
        }
    }

    private string? ValidateEditor()
        => string.IsNullOrWhiteSpace(_expression)
            ? "Enter an assertion condition before saving."
            : null;

    private static bool IsNonCriticalEditorException(Exception exception)
        => exception is JSException or JSDisconnectedException or InvalidOperationException or ObjectDisposedException;

    private sealed class EditorHostSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}

@using FluxMq.UI.Components.Diagram
@using FluxMq.Core.Models
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject LiveMqttWorkspaceService Live

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.SyncAlt"
                 CategoryColor="@Color.Primary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="connection-state-trigger-summary">
            <div class="connection-state-trigger-meta">
                <div class="connection-state-trigger-meta-item broker">
                    <span>Broker</span>
                    <strong title="@ConnectionCaption">@ConnectionCaption</strong>
                </div>
                <div class="connection-state-trigger-meta-item">
                    <span>Output</span>
                    <strong>Client state</strong>
                </div>
                <div class="connection-state-trigger-meta-item">
                    <span>Mode</span>
                    <strong>State changes</strong>
                </div>
            </div>

            <div class="connection-state-trigger-contracts">
                <div class="connection-state-trigger-contract" aria-label="Connection state trigger output fields">
                    <span class="connection-state-trigger-contract-label">Fields</span>
                    <span class="connection-state-trigger-token">profileId</span>
                    <span class="connection-state-trigger-token">state</span>
                    <span class="connection-state-trigger-token">errors</span>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        @{
            var brokerOptions = BrokerOptions;
        }
        <div class="connection-state-trigger-editor" aria-label="Connection state trigger settings">
            @if (brokerOptions.Count > 0)
            {
                <MudSelect T="string"
                           Label="Broker connection"
                           @bind-Value="_connection"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="connection-state-trigger-broker-field">
                    @foreach (var option in brokerOptions)
                    {
                        <MudSelectItem Value="@option.Name">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField T="string"
                              Label="Connection name"
                              @bind-Value="_connection"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="connection-state-trigger-broker-field" />
            }
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private ConnectionStateTriggerNodeModel Model => (ConnectionStateTriggerNodeModel)Node;

    private string _connection = string.Empty;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string ConnectionCaption => string.IsNullOrWhiteSpace(Model.Connection)
        ? FlowDefinitionComposer.BrokerResourceName
        : Model.Connection.Trim();

    private IReadOnlyList<BrokerOption> BrokerOptions
    {
        get
        {
            var options = new Dictionary<string, BrokerOption>(StringComparer.Ordinal);
            foreach (var (name, profile, _) in Flow.GetConnectionResources())
            {
                AddOption(name, profile, isAppResource: true);
            }

            foreach (var connection in Live.Connections)
            {
                AddOption(connection.ResourceName, connection.Profile, isAppResource: false);
            }

            return options.Values
                .OrderByDescending(static option => option.IsAppResource)
                .ThenBy(static option => option.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            void AddOption(string? name, MqttConnectionProfile profile, bool isAppResource)
            {
                if (string.IsNullOrWhiteSpace(name))
                {
                    return;
                }

                var resourceName = name.Trim();
                options.TryAdd(
                    resourceName,
                    new BrokerOption(
                        resourceName,
                        $"{resourceName} ({profile.Host}:{profile.Port})",
                        isAppResource));
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _connection = Model.Connection;
    }

    private Task SaveAsync()
    {
        Model.Connection = _connection.Trim();

        var isExistingAppResource = Flow.GetConnectionNames()
            .Any(name => string.Equals(name, _connection, StringComparison.Ordinal));

        if (isExistingAppResource)
        {
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
            return Task.CompletedTask;
        }

        var selectedProfile = Live.Connections
            .FirstOrDefault(c => string.Equals(c.ResourceName, _connection, StringComparison.Ordinal))
            ?.Profile;

        if (selectedProfile is not null)
            Flow.SyncConnectionAndUpdateNode(_connection, selectedProfile, Node.NodeName, Model.BuildConfiguration());
        else
            Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());

        return Task.CompletedTask;
    }

    private sealed record BrokerOption(string Name, string Label, bool IsAppResource = false);
}

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Plagiarism"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="payload-inspect-summary node-ui-summary">
            <div class="payload-inspect-meta node-ui-facts">
                <div class="payload-inspect-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong>Payload request</strong>
                </div>
                <div class="payload-inspect-meta-item node-ui-fact">
                    <span>Preview</span>
                    <strong>@PreviewCaption</strong>
                </div>
                <div class="payload-inspect-meta-item node-ui-fact">
                    <span>Format cap</span>
                    <strong>@FormatCapCaption</strong>
                </div>
                <div class="payload-inspect-meta-item node-ui-fact">
                    <span>Input buffer</span>
                    <strong>@InputBufferCaption</strong>
                </div>
            </div>

            <div class="payload-inspect-contracts node-ui-token-group">
                <div class="payload-inspect-contract node-ui-token-row" aria-label="Payload inspection request fields">
                    <span class="payload-inspect-contract-label node-ui-fact-label">Request fields</span>
                    <span class="payload-inspect-token node-ui-token">text</span>
                    <span class="payload-inspect-token node-ui-token">bytes</span>
                    <span class="payload-inspect-token node-ui-token">contentType</span>
                    <span class="payload-inspect-token node-ui-token">encodingHint</span>
                </div>
                <div class="payload-inspect-contract node-ui-token-row" aria-label="Payload inspection result fields">
                    <span class="payload-inspect-contract-label node-ui-fact-label">Result fields</span>
                    <span class="payload-inspect-token node-ui-token">kind</span>
                    <span class="payload-inspect-token node-ui-token">contentType</span>
                    <span class="payload-inspect-token node-ui-token">byteCount</span>
                    <span class="payload-inspect-token node-ui-token">preview</span>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="payload-inspect-editor node-ui-editor" aria-label="Payload inspection settings">
            <div class="payload-inspect-number-grid node-ui-form-grid">
                <MudNumericField T="int"
                                 Label="Preview bytes"
                                 Value="@_maxPreviewBytes"
                                 ValueChanged="@SetMaxPreviewBytes"
                                 Min="1"
                                 Max="1048576"
                                 Step="128"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="payload-inspect-preview-field" />
                <MudNumericField T="int"
                                 Label="Formatted chars"
                                 Value="@_maxFormattedChars"
                                 ValueChanged="@SetMaxFormattedChars"
                                 Min="1"
                                 Max="1048576"
                                 Step="512"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="payload-inspect-formatted-field" />
                <MudNumericField T="int"
                                 Label="Input buffer"
                                 Value="@_boundedCapacity"
                                 ValueChanged="@SetBoundedCapacity"
                                 Min="1"
                                 Max="100000"
                                 Step="64"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="payload-inspect-buffer-field" />
            </div>

            <div class="payload-inspect-options node-ui-checkbox-row" aria-label="Payload inspection options">
                <MudCheckBox T="bool"
                             Label="Detect Base64"
                             @bind-Value="_detectBase64"
                             Color="Color.Primary" />
                <MudCheckBox T="bool"
                             Label="Format JSON"
                             @bind-Value="_formatJson"
                             Color="Color.Primary" />
                <MudCheckBox T="bool"
                             Label="Format XML"
                             @bind-Value="_formatXml"
                             Color="Color.Primary" />
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private PayloadInspectNodeModel Model => (PayloadInspectNodeModel)Node;

    private int _maxPreviewBytes = PayloadInspectNodeModel.DefaultMaxPreviewBytes;
    private int _maxFormattedChars = PayloadInspectNodeModel.DefaultMaxFormattedChars;
    private bool _detectBase64 = true;
    private bool _formatJson = true;
    private bool _formatXml = true;
    private int _boundedCapacity = PayloadInspectNodeModel.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string PreviewCaption => $"{PayloadInspectNodeModel.NormalizePositiveInt(Model.MaxPreviewBytes, PayloadInspectNodeModel.DefaultMaxPreviewBytes)} bytes";
    private string FormatCapCaption => $"{PayloadInspectNodeModel.NormalizePositiveInt(Model.MaxFormattedChars, PayloadInspectNodeModel.DefaultMaxFormattedChars)} chars";
    private string InputBufferCaption => PayloadInspectNodeModel
        .NormalizePositiveInt(Model.BoundedCapacity, PayloadInspectNodeModel.DefaultBoundedCapacity)
        .ToString();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _maxPreviewBytes = PayloadInspectNodeModel.NormalizePositiveInt(Model.MaxPreviewBytes, PayloadInspectNodeModel.DefaultMaxPreviewBytes);
        _maxFormattedChars = PayloadInspectNodeModel.NormalizePositiveInt(Model.MaxFormattedChars, PayloadInspectNodeModel.DefaultMaxFormattedChars);
        _detectBase64 = Model.DetectBase64;
        _formatJson = Model.FormatJson;
        _formatXml = Model.FormatXml;
        _boundedCapacity = PayloadInspectNodeModel.NormalizePositiveInt(Model.BoundedCapacity, PayloadInspectNodeModel.DefaultBoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.MaxPreviewBytes = PayloadInspectNodeModel.NormalizePositiveInt(_maxPreviewBytes, PayloadInspectNodeModel.DefaultMaxPreviewBytes);
        Model.MaxFormattedChars = PayloadInspectNodeModel.NormalizePositiveInt(_maxFormattedChars, PayloadInspectNodeModel.DefaultMaxFormattedChars);
        Model.DetectBase64 = _detectBase64;
        Model.FormatJson = _formatJson;
        Model.FormatXml = _formatXml;
        Model.BoundedCapacity = PayloadInspectNodeModel.NormalizePositiveInt(_boundedCapacity, PayloadInspectNodeModel.DefaultBoundedCapacity);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private async Task SetMaxPreviewBytes(int value)
    {
        _maxPreviewBytes = value;
        await RefreshDialogAsync();
    }

    private async Task SetMaxFormattedChars(int value)
    {
        _maxFormattedChars = value;
        await RefreshDialogAsync();
    }

    private async Task SetBoundedCapacity(int value)
    {
        _boundedCapacity = value;
        await RefreshDialogAsync();
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
    {
        if (_maxPreviewBytes is < 1 or > 1048576)
        {
            return "Preview bytes must be between 1 and 1048576.";
        }

        if (_maxFormattedChars is < 1 or > 1048576)
        {
            return "Formatted chars must be between 1 and 1048576.";
        }

        return _boundedCapacity is < 1 or > 100000
            ? "Input buffer must be between 1 and 100000."
            : null;
    }
}

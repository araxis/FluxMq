@using FluxMq.App.Metrics
@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject IFluxMetricCatalog Catalog

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.StackedLineChart"
                 CategoryColor="@Color.Primary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="metric-source-summary">
            <div class="metric-source-meta">
                <div class="metric-source-meta-item metric">
                    <span>Metric</span>
                    <strong title="@MetricCaption">@MetricCaption</strong>
                </div>
                <div class="metric-source-meta-item">
                    <span>Latest</span>
                    <strong>@LatestValue</strong>
                </div>
                <div class="metric-source-meta-item">
                    <span>Start</span>
                    <strong>@StartModeCaption</strong>
                </div>
                <div class="metric-source-meta-item">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            @if (Model.Parameters.Count > 0)
            {
                <div class="metric-source-parameters" aria-label="Metric source parameters">
                    <span class="metric-source-contract-label">Parameters</span>
                    @foreach (var parameter in ParameterPreview)
                    {
                        <span class="metric-source-token" title="@($"{parameter.Key}: {parameter.Value}")">@parameter.Key</span>
                    }
                    @if (ParameterPreviewOverflow > 0)
                    {
                        <span class="metric-source-token overflow">+@ParameterPreviewOverflow</span>
                    }
                </div>
            }

            <div class="metric-source-contract" aria-label="Metric source output fields">
                <span class="metric-source-contract-label">Output fields</span>
                <span class="metric-source-token">NumberMetricReading</span>
                <span class="metric-source-token">metricId</span>
                <span class="metric-source-token">timestamp</span>
                <span class="metric-source-token">value</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="metric-source-editor" aria-label="Metric source settings">
            <div class="metric-source-config-row" aria-label="Metric source configuration">
                @if (MetricOptions.Count > 0)
                {
                    <MudSelect T="string"
                               Label="Metric"
                               Value="@_metricId"
                               ValueChanged="@SetMetricId"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="metric-source-metric-field">
                        @foreach (var option in MetricOptions)
                        {
                            <MudSelectItem Value="@option.Id">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <div class="metric-source-empty" role="status">
                        Add a metric in the Metrics tab, then select it here.
                    </div>
                }

                <MudNumericField T="int"
                                 Label="Output buffer"
                                 Value="@_boundedCapacity"
                                 ValueChanged="@(value => _boundedCapacity = Math.Max(1, value))"
                                 Min="1"
                                 Max="100000"
                                 Step="100"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="metric-source-buffer-field" />
            </div>

            @if (!string.IsNullOrWhiteSpace(SelectedMetricSummary))
            {
                <div class="metric-source-description-row">
                    <span>Metric</span>
                    <strong>@SelectedMetricSummary</strong>
                </div>
            }

            <div class="metric-source-start-row" aria-label="Metric source start behavior">
                <MudCheckBox T="bool"
                             Label="Emit latest reading on start"
                             Value="@_emitLatestOnStart"
                             ValueChanged="@(value => _emitLatestOnStart = value)"
                             Class="metric-source-start-check" />
            </div>

            @if (SelectedDescriptor is { } descriptor && descriptor.Parameters.Count > 0)
            {
                <div class="metric-source-parameter-group" aria-label="Metric parameters">
                    <div class="metric-source-parameter-heading">
                        <span>Parameters</span>
                        <strong>@ParameterCountCaption</strong>
                    </div>

                    <div class="metric-source-parameter-composer">
                        @foreach (var parameter in descriptor.Parameters)
                        {
                            @RenderParameterField(parameter)
                        }
                    </div>
                </div>
            }
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MetricSourceNodeModel Model => (MetricSourceNodeModel)Node;
    private string _metricId = string.Empty;
    private bool _emitLatestOnStart = true;
    private int _boundedCapacity = 1000;
    private readonly Dictionary<string, string> _parameters = new(StringComparer.Ordinal);
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private const string TrueValue = "true";
    private const string FalseValue = "false";
    private const int MaxParameterTokens = 3;

    private string MetricCaption => MetricLabel(Model.MetricId);
    private string BufferCaption => Math.Max(1, Model.BoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string StartModeCaption => Model.EmitLatestOnStart ? "latest" : "next";
    private IReadOnlyList<KeyValuePair<string, string>> ParameterPreview
        => Model.Parameters.Take(MaxParameterTokens).ToArray();
    private int ParameterPreviewOverflow => Math.Max(0, Model.Parameters.Count - MaxParameterTokens);
    private string ParameterCountCaption
        => SelectedDescriptor?.Parameters.Count switch
        {
            1 => "1 field",
            int count when count > 1 => $"{count} fields",
            _ => "No fields"
        };

    private IReadOnlyList<MetricOption> MetricOptions
        => Flow.GetMetricResources()
            .Select(static pair => new MetricOption(
                pair.Key,
                string.IsNullOrWhiteSpace(pair.Value.DisplayName)
                    ? pair.Key
                    : pair.Value.DisplayName))
            .OrderBy(static option => option.Label, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private FluxMetricResourceDefinition? SelectedResource
        => string.IsNullOrWhiteSpace(_metricId) ? null : Flow.GetMetricResource(_metricId);

    private MetricDescriptor? SelectedDescriptor
        => SelectedResource is { } resource ? Catalog.Describe(resource.TypeId) : null;

    private string SelectedMetricSummary
        => SelectedDescriptor?.Description ?? string.Empty;

    private string LatestValue
        => Flow.TryGetLatestMetricReading(Model.MetricId, Model.Parameters, out var reading)
            ? reading.Value.ToString(reading.Value >= 100 ? "0" : "0.##", System.Globalization.CultureInfo.InvariantCulture)
            : "waiting";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            _ = LoadDraft();
        }
    }

    private Task LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _metricId = Model.MetricId;
        _emitLatestOnStart = Model.EmitLatestOnStart;
        _boundedCapacity = Math.Max(1, Model.BoundedCapacity);
        _parameters.Clear();
        foreach (var (key, value) in Model.Parameters)
        {
            _parameters[key] = value;
        }

        return Task.CompletedTask;
    }

    private Task SaveAsync()
    {
        Model.MetricId = _metricId.Trim();
        Model.EmitLatestOnStart = _emitLatestOnStart;
        Model.BoundedCapacity = Math.Max(1, _boundedCapacity);
        Model.SetParameters(_parameters);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private Task SetMetricId(string value)
    {
        _metricId = value?.Trim() ?? string.Empty;
        _parameters.Clear();
        if (SelectedDescriptor is { } descriptor)
        {
            foreach (var parameter in descriptor.Parameters)
            {
                if (!string.IsNullOrWhiteSpace(parameter.DefaultValue))
                {
                    _parameters[parameter.Key] = parameter.DefaultValue;
                }
            }
        }

        return Task.CompletedTask;
    }

    private string ParameterValue(MetricParamSpec parameter)
        => _parameters.TryGetValue(parameter.Key, out var value) ? value : parameter.DefaultValue ?? string.Empty;

    private RenderFragment RenderParameterField(MetricParamSpec parameter)
    {
        var value = ParameterValue(parameter);
        if (parameter.Kind == MetricParamKind.Select && parameter.Options is { Count: > 0 } options)
        {
            return @<div class="metric-source-parameter-cell" title="@ParameterHelpTitle(parameter)">
                <MudSelect T="string"
                           Label="@parameter.DisplayName"
                           Value="@value"
                           ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="metric-source-parameter-field">
                    @foreach (var option in options)
                    {
                        <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </div>;
        }

        if (parameter.Kind == MetricParamKind.Toggle)
        {
            return @<div class="metric-source-parameter-cell" title="@ParameterHelpTitle(parameter)">
                <MudSelect T="string"
                           Label="@parameter.DisplayName"
                           Value="@value"
                           ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="metric-source-parameter-field">
                    <MudSelectItem Value="@string.Empty">Default</MudSelectItem>
                    <MudSelectItem Value="@TrueValue">On</MudSelectItem>
                    <MudSelectItem Value="@FalseValue">Off</MudSelectItem>
                </MudSelect>
            </div>;
        }

        var inputType = parameter.Kind is MetricParamKind.Integer or MetricParamKind.Number
            ? InputType.Number
            : InputType.Text;
        return @<div class="metric-source-parameter-cell" title="@ParameterHelpTitle(parameter)">
            <MudTextField T="string"
                          Label="@parameter.DisplayName"
                          Value="@value"
                          ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                          Placeholder="@parameter.Placeholder"
                          InputType="@inputType"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="metric-source-parameter-field" />
        </div>;
    }

    private static string ParameterHelpTitle(MetricParamSpec parameter)
        => parameter.HelpText?.Trim() ?? string.Empty;

    private void SetParameterValue(string parameterKey, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _parameters.Remove(parameterKey);
        }
        else
        {
            _parameters[parameterKey] = value.Trim();
        }
    }

    private string MetricLabel(string metricId)
        => string.IsNullOrWhiteSpace(metricId)
            ? "Not selected"
            : Flow.GetMetricResource(metricId)?.DisplayName ?? metricId;

    private sealed record MetricOption(string Id, string Label);
}

@using FluxMq.App.Metrics
@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.StackedLineChart"
                 CategoryColor="@Color.Primary"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <MudStack Spacing="1" Class="mt-1">
            <Stat Icon="@Icons.Material.Filled.QueryStats" Label="Metric" Value="@MetricLabel(Model.MetricId)" />
            <Stat Icon="@Icons.Material.Filled.Tag" Label="Output" Value="Number metric" />
            <Stat Icon="@Icons.Material.Filled.Speed" Label="Latest" Value="@LatestValue" />
        </MudStack>
    </Body>
    <Editor>
        <MudStack Spacing="2">
            @if (MetricOptions.Count > 0)
            {
                <MudSelect T="string"
                           Label="Metric"
                           Value="@_metricId"
                           ValueChanged="@SetMetricId"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    @foreach (var option in MetricOptions)
                    {
                        <MudSelectItem Value="@option.Id">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Add a metric in the Metrics tab, then select it here.
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(SelectedMetricSummary))
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                    @SelectedMetricSummary
                </MudAlert>
            }

            @if (SelectedMetric?.Parameters.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Parameters</MudText>
                @foreach (var parameter in SelectedMetric.Parameters)
                {
                    @RenderParameterField(parameter)
                }
            }

            <MudSwitch T="bool"
                       Label="Emit latest reading on start"
                       Value="@_emitLatestOnStart"
                       ValueChanged="@(value => _emitLatestOnStart = value)"
                       Color="Color.Primary" />

            <MudNumericField T="int"
                             Label="Buffer"
                             Value="@_boundedCapacity"
                             ValueChanged="@(value => _boundedCapacity = Math.Max(1, value))"
                             Min="1"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HelperText="Maximum pending readings before backpressure." />
        </MudStack>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private MetricSourceNodeModel Model => (MetricSourceNodeModel)Node;
    private string _metricId = string.Empty;
    private bool _emitLatestOnStart = true;
    private int _boundedCapacity = 1000;
    private readonly Dictionary<string, string> _parameters = new(StringComparer.Ordinal);
    private readonly FluxMetricResolver _metricResolver = new();

    private IReadOnlyList<MetricOption> MetricOptions
        => Flow.GetMetricArtifacts()
            .Select(static pair => new MetricOption(
                pair.Key,
                string.IsNullOrWhiteSpace(pair.Value.DisplayName)
                    ? pair.Key
                    : pair.Value.DisplayName))
            .OrderBy(static option => option.Label, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private FluxMetricArtifactDefinition? SelectedMetric
        => string.IsNullOrWhiteSpace(_metricId) ? null : Flow.GetMetricArtifact(_metricId);

    private string SelectedMetricSummary
    {
        get
        {
            if (SelectedMetric is null)
            {
                return string.Empty;
            }

            try
            {
                return FluxMetricQuerySummary.DescribeSentence(
                    _metricResolver.Resolve(SelectedMetric, _parameters));
            }
            catch
            {
                return "Metric parameters need attention before this source can run.";
            }
        }
    }

    private string LatestValue
        => Flow.TryGetLatestMetricReading(Model.MetricId, Model.Parameters, out var reading)
            ? reading.Value.ToString(reading.Value >= 100 ? "0" : "0.##", System.Globalization.CultureInfo.InvariantCulture)
            : "waiting";

    protected override void OnParametersSet() => LoadDraft();

    private Task LoadDraft()
    {
        _metricId = Model.MetricId;
        _emitLatestOnStart = Model.EmitLatestOnStart;
        _boundedCapacity = Model.BoundedCapacity;
        _parameters.Clear();
        foreach (var (key, value) in Model.Parameters)
        {
            _parameters[key] = value;
        }

        return Task.CompletedTask;
    }

    private Task SaveAsync()
    {
        Model.MetricId = _metricId.Trim();
        Model.EmitLatestOnStart = _emitLatestOnStart;
        Model.BoundedCapacity = Math.Max(1, _boundedCapacity);
        Model.SetParameters(_parameters);
        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private Task SetMetricId(string value)
    {
        _metricId = value?.Trim() ?? string.Empty;
        _parameters.Clear();
        if (SelectedMetric is { } metric)
        {
            foreach (var parameter in metric.Parameters)
            {
                if (!string.IsNullOrWhiteSpace(parameter.DefaultValue))
                {
                    _parameters[parameter.Id] = parameter.DefaultValue;
                }
            }
        }

        return Task.CompletedTask;
    }

    private string ParameterValue(FluxMetricParameterDefinition parameter)
        => _parameters.TryGetValue(parameter.Id, out var value) ? value : parameter.DefaultValue;

    private RenderFragment RenderParameterField(FluxMetricParameterDefinition parameter)
    {
        var value = ParameterValue(parameter);
        if (parameter.AllowedValues.Count > 0)
        {
            return @<MudSelect T="string"
                               Label="@parameter.LabelOrId()"
                               Value="@value"
                               ValueChanged="@(next => SetParameterValue(parameter.Id, next))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               HelperText="@ParameterHelper(parameter)">
                @if (!parameter.Required)
                {
                    <MudSelectItem Value="@string.Empty">Default</MudSelectItem>
                }
                @foreach (var option in parameter.AllowedValues)
                {
                    <MudSelectItem Value="@option">@option</MudSelectItem>
                }
            </MudSelect>;
        }

        if (string.Equals(parameter.Kind, FluxMetricParameterKinds.Toggle, StringComparison.Ordinal))
        {
            return @<MudSelect T="string"
                               Label="@parameter.LabelOrId()"
                               Value="@value"
                               ValueChanged="@(next => SetParameterValue(parameter.Id, next))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               HelperText="@ParameterHelper(parameter)">
                <MudSelectItem Value="@string.Empty">Default</MudSelectItem>
                <MudSelectItem Value="@TrueValue">On</MudSelectItem>
                <MudSelectItem Value="@FalseValue">Off</MudSelectItem>
            </MudSelect>;
        }

        return @<MudTextField T="string"
                              Label="@parameter.LabelOrId()"
                              Value="@value"
                              ValueChanged="@(next => SetParameterValue(parameter.Id, next))"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="@ParameterHelper(parameter)" />;
    }

    private void SetParameterValue(string parameterId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _parameters.Remove(parameterId);
        }
        else
        {
            _parameters[parameterId] = value.Trim();
        }
    }

    private string MetricLabel(string metricId)
        => string.IsNullOrWhiteSpace(metricId)
            ? "Not selected"
            : Flow.GetMetricArtifact(metricId)?.DisplayName ?? metricId;

    private static string ParameterHelper(FluxMetricParameterDefinition parameter)
        => string.IsNullOrWhiteSpace(parameter.Target)
            ? parameter.Kind
            : $"{parameter.Kind} · {parameter.Target}";

    private const string TrueValue = "true";
    private const string FalseValue = "false";

    private sealed record MetricOption(string Id, string Label);
}

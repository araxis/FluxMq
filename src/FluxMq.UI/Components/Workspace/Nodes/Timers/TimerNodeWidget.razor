@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Timer"
                 CategoryColor="@TimerCategoryColor"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="timer-node-summary">
            <div class="timer-node-meta">
                <div class="timer-node-meta-item mode">
                    <span>Mode</span>
                    <strong>@ModeCaption</strong>
                </div>
                <div class="timer-node-meta-item timing">
                    <span>@PrimaryLabel</span>
                    <strong title="@PrimaryCaption">@PrimaryCaption</strong>
                </div>
                <div class="timer-node-meta-item detail">
                    <span>@SecondaryLabel</span>
                    <strong title="@SecondaryCaption">@SecondaryCaption</strong>
                </div>
                <div class="timer-node-meta-item">
                    <span>Buffer</span>
                    <strong>@BoundedCapacityCaption</strong>
                </div>
            </div>

            <div class="timer-node-contract" aria-label="@ContractAriaLabel">
                <span class="timer-node-contract-label">@ContractLabel</span>
                @foreach (var token in SummaryTokens)
                {
                    <span class="@TimerTokenClass">@token</span>
                }
                @if (!string.IsNullOrWhiteSpace(LimitToken))
                {
                    <span class="timer-node-token muted">@LimitToken</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="timer-node-editor" aria-label="Timer settings">
            @if (Node is TimerIntervalNodeModel)
            {
                <section class="timer-node-editor-surface" aria-label="Interval timer settings">
                    <div class="timer-node-primary-row interval">
                        <MudNumericField T="int"
                                          Label="Interval ms"
                                          @bind-Value="_intervalMilliseconds"
                                         Min="1"
                                         Max="86400000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                        <MudNumericField T="int"
                                         Label="Initial delay ms"
                                         @bind-Value="_initialDelayMilliseconds"
                                         Min="0"
                                         Max="86400000"
                                         Step="100"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="timer-node-field" />
                    </div>

                    <div class="timer-node-settings-row interval" aria-label="Interval timer limits">
                        <MudNumericField T="int"
                                         Label="Max ticks"
                                         @bind-Value="_maxTicks"
                                         Min="0"
                                         Max="1000000"
                                         Step="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                        @OutputBufferField()
                        <div class="timer-node-option-cell">
                            <MudCheckBox T="bool"
                                         @bind-Value="_emitImmediately"
                                         Label="Emit immediately"
                                         Dense="true"
                                         Class="timer-node-check" />
                        </div>
                    </div>
                </section>
            }
            else if (Node is TimerScheduleNodeModel)
            {
                <section class="timer-node-editor-surface" aria-label="Scheduled timer settings">
                    <div class="timer-node-primary-row schedule">
                        <MudTextField T="string"
                                      Label="Cron"
                                      @bind-Value="_cron"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="timer-node-field" />
                        <MudTextField T="string"
                                      Label="Time zone"
                                      @bind-Value="_timeZoneId"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="timer-node-field" />
                    </div>

                    <div class="timer-node-settings-row schedule" aria-label="Scheduled timer limits">
                        <MudNumericField T="int"
                                         Label="Max ticks"
                                         @bind-Value="_maxTicks"
                                         Min="0"
                                         Max="1000000"
                                         Step="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                        @OutputBufferField()
                    </div>
                </section>
            }
            else if (Node is TimerDelayNodeModel)
            {
                <section class="timer-node-editor-surface" aria-label="Delay timer settings">
                    <div class="timer-node-primary-row passthrough">
                        @InputTypeSelect()
                        <MudNumericField T="int"
                                         Label="Delay ms"
                                         @bind-Value="_delayMilliseconds"
                                         Min="0"
                                         Max="86400000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                    </div>

                    <div class="timer-node-settings-row passthrough" aria-label="Delay timer buffer">
                        @InputBufferField()
                    </div>
                </section>
            }
            else if (Node is TimerDebounceNodeModel)
            {
                <section class="timer-node-editor-surface" aria-label="Debounce timer settings">
                    <div class="timer-node-primary-row passthrough">
                        @InputTypeSelect()
                        <MudNumericField T="int"
                                         Label="Quiet period ms"
                                         @bind-Value="_quietPeriodMilliseconds"
                                         Min="1"
                                         Max="86400000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                    </div>

                    <div class="timer-node-settings-row passthrough" aria-label="Debounce timer buffer">
                        @InputBufferField()
                    </div>
                </section>
            }
            else if (Node is TimerThrottleNodeModel)
            {
                <section class="timer-node-editor-surface" aria-label="Throttle timer settings">
                    <div class="timer-node-primary-row passthrough throttle">
                        @InputTypeSelect()
                        <MudNumericField T="int"
                                         Label="Interval ms"
                                         @bind-Value="_throttleIntervalMilliseconds"
                                         Min="1"
                                         Max="86400000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="timer-node-field" />
                    </div>

                    <div class="timer-node-settings-row option" aria-label="Throttle timer options">
                        @InputBufferField()
                        <div class="timer-node-option-cell">
                            <MudCheckBox T="bool"
                                         @bind-Value="_emitFirstImmediately"
                                         Label="Emit first immediately"
                                         Dense="true"
                                         Class="timer-node-check" />
                        </div>
                    </div>
                </section>
            }
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private int _intervalMilliseconds = TimerIntervalNodeModel.DefaultIntervalMilliseconds;
    private int _initialDelayMilliseconds = TimerIntervalNodeModel.DefaultInitialDelayMilliseconds;
    private bool _emitImmediately;
    private string _cron = TimerScheduleNodeModel.DefaultCron;
    private string _timeZoneId = TimerScheduleNodeModel.DefaultTimeZoneId;
    private string _inputType = TimerDelayNodeModel.DefaultInputType;
    private int _delayMilliseconds = TimerDelayNodeModel.DefaultDelayMilliseconds;
    private int _quietPeriodMilliseconds = TimerDebounceNodeModel.DefaultQuietPeriodMilliseconds;
    private int _throttleIntervalMilliseconds = TimerThrottleNodeModel.DefaultIntervalMilliseconds;
    private bool _emitFirstImmediately = true;
    private int _maxTicks;
    private int _boundedCapacity = TimerIntervalNodeModel.DefaultBoundedCapacity;

    protected override void OnParametersSet() => LoadDraft();

    private string ModeCaption => Node switch
    {
        TimerIntervalNodeModel => "Interval",
        TimerScheduleNodeModel => "Schedule",
        TimerDelayNodeModel => "Delay",
        TimerDebounceNodeModel => "Debounce",
        TimerThrottleNodeModel => "Throttle",
        _ => "Timer"
    };

    private string PrimaryLabel => Node switch
    {
        TimerScheduleNodeModel => "Cron",
        TimerDebounceNodeModel => "Quiet",
        TimerThrottleNodeModel => "Window",
        TimerDelayNodeModel => "Delay",
        _ => "Every"
    };

    private string PrimaryCaption => Node switch
    {
        TimerIntervalNodeModel interval => FormatMilliseconds(interval.IntervalMilliseconds),
        TimerScheduleNodeModel schedule => string.IsNullOrWhiteSpace(schedule.Cron) ? TimerScheduleNodeModel.DefaultCron : schedule.Cron.Trim(),
        TimerDelayNodeModel delay => FormatMilliseconds(delay.DelayMilliseconds),
        TimerDebounceNodeModel debounce => FormatMilliseconds(debounce.QuietPeriodMilliseconds),
        TimerThrottleNodeModel throttle => FormatMilliseconds(throttle.IntervalMilliseconds),
        _ => "timer"
    };

    private string SecondaryLabel => Node switch
    {
        TimerIntervalNodeModel => "Start",
        TimerScheduleNodeModel => "Time zone",
        TimerThrottleNodeModel => "First",
        _ => "Input"
    };

    private string SecondaryCaption => Node switch
    {
        TimerIntervalNodeModel interval => interval.EmitImmediately
            ? "immediate"
            : FormatMilliseconds(interval.InitialDelayMilliseconds),
        TimerScheduleNodeModel schedule => string.IsNullOrWhiteSpace(schedule.TimeZoneId) ? TimerScheduleNodeModel.DefaultTimeZoneId : schedule.TimeZoneId.Trim(),
        TimerDelayNodeModel delay => TimerDelayNodeModel.NormalizeInputType(delay.InputType),
        TimerDebounceNodeModel debounce => TimerDelayNodeModel.NormalizeInputType(debounce.InputType),
        TimerThrottleNodeModel throttle => throttle.EmitFirstImmediately ? "immediate" : "delayed",
        _ => "input"
    };

    private string BoundedCapacityCaption => Node switch
    {
        TimerIntervalNodeModel interval => TimerNodeConfiguration.NormalizePositiveInt(interval.BoundedCapacity, TimerIntervalNodeModel.DefaultBoundedCapacity).ToString(),
        TimerScheduleNodeModel schedule => TimerNodeConfiguration.NormalizePositiveInt(schedule.BoundedCapacity, TimerScheduleNodeModel.DefaultBoundedCapacity).ToString(),
        TimerDelayNodeModel delay => TimerNodeConfiguration.NormalizePositiveInt(delay.BoundedCapacity, TimerDelayNodeModel.DefaultBoundedCapacity).ToString(),
        TimerDebounceNodeModel debounce => TimerNodeConfiguration.NormalizePositiveInt(debounce.BoundedCapacity, TimerDebounceNodeModel.DefaultBoundedCapacity).ToString(),
        TimerThrottleNodeModel throttle => TimerNodeConfiguration.NormalizePositiveInt(throttle.BoundedCapacity, TimerThrottleNodeModel.DefaultBoundedCapacity).ToString(),
        _ => string.Empty
    };

    private string ContractAriaLabel => $"{ModeCaption} timer fields";

    private Color TimerCategoryColor => string.Equals(Node.Category, "Control", StringComparison.Ordinal)
        ? Color.Secondary
        : Color.Primary;

    private string TimerTokenClass => string.Equals(Node.Category, "Control", StringComparison.Ordinal)
        ? "timer-node-token passthrough"
        : "timer-node-token";

    private string ContractLabel => Node switch
    {
        TimerIntervalNodeModel or TimerScheduleNodeModel => "Output fields",
        _ => "Passthrough"
    };

    private IReadOnlyList<string> SummaryTokens => Node switch
    {
        TimerIntervalNodeModel => ["TimerTick", "tickId", "timestamp"],
        TimerScheduleNodeModel => ["ScheduleTick", "cron", "scheduledAt"],
        TimerDelayNodeModel delay => [TimerDelayNodeModel.NormalizeInputType(delay.InputType), "delayed", "unchanged"],
        TimerDebounceNodeModel debounce => [TimerDelayNodeModel.NormalizeInputType(debounce.InputType), "last input", "unchanged"],
        TimerThrottleNodeModel throttle => [TimerDelayNodeModel.NormalizeInputType(throttle.InputType), "window", "unchanged"],
        _ => []
    };

    private string LimitToken => Node switch
    {
        TimerIntervalNodeModel interval => $"max {MaxTicksText(interval.MaxTicks)}",
        TimerScheduleNodeModel schedule => $"max {MaxTicksText(schedule.MaxTicks)}",
        _ => string.Empty
    };

    private void LoadDraft()
    {
        switch (Node)
        {
            case TimerIntervalNodeModel interval:
                _intervalMilliseconds = interval.IntervalMilliseconds;
                _initialDelayMilliseconds = interval.InitialDelayMilliseconds;
                _emitImmediately = interval.EmitImmediately;
                _maxTicks = interval.MaxTicks;
                _boundedCapacity = interval.BoundedCapacity;
                break;
            case TimerScheduleNodeModel schedule:
                _cron = schedule.Cron;
                _timeZoneId = schedule.TimeZoneId;
                _maxTicks = schedule.MaxTicks;
                _boundedCapacity = schedule.BoundedCapacity;
                break;
            case TimerDelayNodeModel delay:
                _inputType = delay.InputType;
                _delayMilliseconds = delay.DelayMilliseconds;
                _boundedCapacity = delay.BoundedCapacity;
                break;
            case TimerDebounceNodeModel debounce:
                _inputType = debounce.InputType;
                _quietPeriodMilliseconds = debounce.QuietPeriodMilliseconds;
                _boundedCapacity = debounce.BoundedCapacity;
                break;
            case TimerThrottleNodeModel throttle:
                _inputType = throttle.InputType;
                _throttleIntervalMilliseconds = throttle.IntervalMilliseconds;
                _emitFirstImmediately = throttle.EmitFirstImmediately;
                _boundedCapacity = throttle.BoundedCapacity;
                break;
        }
    }

    private Task SaveAsync()
    {
        switch (Node)
        {
            case TimerIntervalNodeModel interval:
                interval.IntervalMilliseconds = TimerNodeConfiguration.NormalizePositiveInt(
                    _intervalMilliseconds,
                    TimerIntervalNodeModel.DefaultIntervalMilliseconds);
                interval.InitialDelayMilliseconds = TimerNodeConfiguration.NormalizeNonNegativeInt(
                    _initialDelayMilliseconds,
                    TimerIntervalNodeModel.DefaultInitialDelayMilliseconds);
                interval.EmitImmediately = _emitImmediately;
                interval.MaxTicks = TimerNodeConfiguration.NormalizeNonNegativeInt(_maxTicks, 0);
                interval.BoundedCapacity = TimerNodeConfiguration.NormalizePositiveInt(
                    _boundedCapacity,
                    TimerIntervalNodeModel.DefaultBoundedCapacity);
                break;
            case TimerScheduleNodeModel schedule:
                schedule.Cron = string.IsNullOrWhiteSpace(_cron) ? TimerScheduleNodeModel.DefaultCron : _cron.Trim();
                schedule.TimeZoneId = string.IsNullOrWhiteSpace(_timeZoneId) ? TimerScheduleNodeModel.DefaultTimeZoneId : _timeZoneId.Trim();
                schedule.MaxTicks = TimerNodeConfiguration.NormalizeNonNegativeInt(_maxTicks, 0);
                schedule.BoundedCapacity = TimerNodeConfiguration.NormalizePositiveInt(
                    _boundedCapacity,
                    TimerScheduleNodeModel.DefaultBoundedCapacity);
                break;
            case TimerDelayNodeModel delay:
                delay.InputType = TimerDelayNodeModel.NormalizeInputType(_inputType);
                delay.DelayMilliseconds = TimerNodeConfiguration.NormalizeNonNegativeInt(
                    _delayMilliseconds,
                    TimerDelayNodeModel.DefaultDelayMilliseconds);
                delay.BoundedCapacity = TimerNodeConfiguration.NormalizePositiveInt(
                    _boundedCapacity,
                    TimerDelayNodeModel.DefaultBoundedCapacity);
                break;
            case TimerDebounceNodeModel debounce:
                debounce.InputType = TimerDelayNodeModel.NormalizeInputType(_inputType);
                debounce.QuietPeriodMilliseconds = TimerNodeConfiguration.NormalizePositiveInt(
                    _quietPeriodMilliseconds,
                    TimerDebounceNodeModel.DefaultQuietPeriodMilliseconds);
                debounce.BoundedCapacity = TimerNodeConfiguration.NormalizePositiveInt(
                    _boundedCapacity,
                    TimerDebounceNodeModel.DefaultBoundedCapacity);
                break;
            case TimerThrottleNodeModel throttle:
                throttle.InputType = TimerDelayNodeModel.NormalizeInputType(_inputType);
                throttle.IntervalMilliseconds = TimerNodeConfiguration.NormalizePositiveInt(
                    _throttleIntervalMilliseconds,
                    TimerThrottleNodeModel.DefaultIntervalMilliseconds);
                throttle.EmitFirstImmediately = _emitFirstImmediately;
                throttle.BoundedCapacity = TimerNodeConfiguration.NormalizePositiveInt(
                    _boundedCapacity,
                    TimerThrottleNodeModel.DefaultBoundedCapacity);
                break;
        }

        Flow.UpdateNodeConfiguration(Node.NodeName, Node.BuildConfiguration());
        return Task.CompletedTask;
    }

    private static string MaxTicksText(int maxTicks)
        => maxTicks > 0 ? maxTicks.ToString() : "unlimited";

    private static string FormatMilliseconds(int milliseconds)
        => $"{milliseconds} ms";

    private RenderFragment InputTypeSelect() => @<MudSelect T="string"
                                                            Label="Input type"
                                                            @bind-Value="_inputType"
                                                            Variant="Variant.Outlined"
                                                            Margin="Margin.Dense"
                                                            Class="timer-node-field">
        @foreach (var inputType in TimerDelayNodeModel.InputTypes)
        {
            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
        }
    </MudSelect>;

    private RenderFragment OutputBufferField() => @<MudNumericField T="int"
                                                                    Label="Output buffer"
                                                                    @bind-Value="_boundedCapacity"
                                                                    Min="1"
                                                                    Max="100000"
                                                                    Step="100"
                                                                    Variant="Variant.Outlined"
                                                                    Margin="Margin.Dense"
                                                                    Class="timer-node-field timer-node-buffer-field" />;

    private RenderFragment InputBufferField() => @<MudNumericField T="int"
                                                                   Label="Input buffer"
                                                                   @bind-Value="_boundedCapacity"
                                                                   Min="1"
                                                                   Max="100000"
                                                                   Step="100"
                                                                   Variant="Variant.Outlined"
                                                                   Margin="Margin.Dense"
                                                                   Class="timer-node-field timer-node-buffer-field" />;
}

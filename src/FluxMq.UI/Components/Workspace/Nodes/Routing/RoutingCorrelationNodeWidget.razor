@implements IDisposable
@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject AppThemeService ThemeService
@inject IJSRuntime JsRuntime
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.SyncAlt"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Large"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="routing-correlation-summary node-ui-summary">
            <div class="routing-correlation-meta node-ui-facts">
                <div class="routing-correlation-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="routing-correlation-meta-item node-ui-fact">
                    <span>Sides</span>
                    <strong title="@SideFlowCaption">@SideFlowCaption</strong>
                </div>
                <div class="routing-correlation-meta-item node-ui-fact">
                    <span>Timeout</span>
                    <strong>@TimeoutCaption</strong>
                </div>
                <div class="routing-correlation-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-correlation-rules" aria-label="Routing correlation rules">
                <span class="routing-correlation-summary-label node-ui-fact-label">Correlation</span>
                <span class="routing-correlation-token node-ui-token" title="@KeyExpressionCaption">key @KeyExpressionCaption</span>
                <span class="routing-correlation-token node-ui-token" title="@SideExpressionCaption">side @SideExpressionCaption</span>
                <span class="routing-correlation-token node-ui-token">@CaseCaption</span>
                <span class="routing-correlation-token node-ui-token">@PendingCaption</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-correlation-editor node-ui-editor" aria-label="Routing correlation settings">
            <div class="routing-correlation-rule-row" aria-label="Routing correlation matching rule">
                <div class="routing-correlation-expression-stack" aria-label="Routing correlation expressions">
                    <section class="routing-correlation-key-workspace node-ui-code-surface" aria-label="Correlation key expression">
                        <div class="routing-correlation-workspace-header">
                            <div>
                                <span class="routing-correlation-kicker">Key expression</span>
                                <strong>Correlation key</strong>
                            </div>
                        </div>

                        <div class="routing-correlation-editor-host" @ref="_keyEditorHost">
                            <StandaloneCodeEditor @key="_editorVersion"
                                                  @ref="_keyEditor"
                                                  Id="@KeyEditorId"
                                                  CssClass="routing-correlation-code-editor"
                                                  ConstructionOptions="@KeyEditorConstructionOptions"
                                                  OnDidChangeModelContent="@OnKeyExpressionContentChanged" />
                        </div>
                    </section>

                    <section class="routing-correlation-side-workspace node-ui-code-surface" aria-label="Correlation side expression">
                        <div class="routing-correlation-workspace-header">
                            <div>
                                <span class="routing-correlation-kicker">Side expression</span>
                                <strong>Request or response selector</strong>
                            </div>
                        </div>

                        <div class="routing-correlation-editor-host" @ref="_sideEditorHost">
                            <StandaloneCodeEditor @key="_editorVersion"
                                                  @ref="_sideEditor"
                                                  Id="@SideEditorId"
                                                  CssClass="routing-correlation-code-editor"
                                                  ConstructionOptions="@SideEditorConstructionOptions"
                                                  OnDidChangeModelContent="@OnSideExpressionContentChanged" />
                        </div>
                    </section>
                </div>

                <div class="routing-correlation-sidecar">
                    <div class="routing-correlation-config-row" aria-label="Routing correlation input settings">
                        <MudSelect T="string"
                                   Label="Input type"
                                   @bind-Value="_inputType"
                                   aria-label="Routing correlation input type"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   Class="routing-correlation-input-field">
                            @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                            {
                                <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="int"
                                         Label="Input buffer"
                                         @bind-Value="_boundedCapacity"
                                         aria-label="Routing correlation input buffer"
                                         Min="1"
                                         Max="100000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="routing-correlation-buffer-field" />

                        <MudNumericField T="int"
                                         Label="Timeout ms"
                                         @bind-Value="_timeoutMilliseconds"
                                         aria-label="Routing correlation timeout"
                                         Min="1"
                                         Max="86400000"
                                         Step="1000"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="routing-correlation-timeout-field" />

                        <MudNumericField T="int"
                                         Label="Max pending"
                                         @bind-Value="_maxPending"
                                         aria-label="Routing correlation max pending"
                                         Min="1"
                                         Max="100000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="routing-correlation-pending-field" />
                    </div>

                    <div class="routing-correlation-side-map-row" aria-label="Routing correlation side mapping">
                        <MudTextField T="string"
                                      Label="Request side"
                                      Value="@_requestSide"
                                      ValueChanged="@SetRequestSide"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="routing-correlation-request-field" />

                        <MudTextField T="string"
                                      Label="Response side"
                                      Value="@_responseSide"
                                      ValueChanged="@SetResponseSide"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="routing-correlation-response-field" />

                        <div class="routing-correlation-case-option">
                            <MudCheckBox T="bool"
                                         Label="Case sensitive"
                                         Value="@_caseSensitive"
                                         ValueChanged="@SetCaseSensitive"
                                         Class="routing-correlation-case-check" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingCorrelationNodeModel Model => (RoutingCorrelationNodeModel)Node;

    private string _inputType = RoutingCorrelationNodeModel.DefaultInputType;
    private string _keyExpression = RoutingCorrelationNodeModel.DefaultKeyExpression;
    private string _sideExpression = RoutingCorrelationNodeModel.DefaultSideExpression;
    private string _requestSide = RoutingCorrelationNodeModel.DefaultRequestSide;
    private string _responseSide = RoutingCorrelationNodeModel.DefaultResponseSide;
    private bool _caseSensitive = RoutingCorrelationNodeModel.DefaultCaseSensitive;
    private int _timeoutMilliseconds = RoutingCorrelationNodeModel.DefaultTimeoutMilliseconds;
    private int _maxPending = RoutingCorrelationNodeModel.DefaultMaxPending;
    private int _boundedCapacity = RoutingCorrelationNodeModel.DefaultBoundedCapacity;
    private StandaloneCodeEditor? _keyEditor;
    private StandaloneCodeEditor? _sideEditor;
    private StandaloneCodeEditor? _initializedKeyEditor;
    private StandaloneCodeEditor? _initializedSideEditor;
    private ElementReference _keyEditorHost;
    private ElementReference _sideEditorHost;
    private int _editorVersion;
    private bool _syncingEditors;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;
    private string KeyEditorId => $"routing-correlation-key-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";
    private string SideEditorId => $"routing-correlation-side-{Node.NodeName.Replace('.', '-').Replace(' ', '-')}";

    private string InputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
    private string KeyExpressionCaption => RoutingNodeConfiguration.NormalizeText(
        Model.KeyExpression,
        RoutingCorrelationNodeModel.DefaultKeyExpression);
    private string SideExpressionCaption => RoutingNodeConfiguration.NormalizeText(
        Model.SideExpression,
        RoutingCorrelationNodeModel.DefaultSideExpression);
    private string RequestSideCaption => RoutingNodeConfiguration.NormalizeText(
        Model.RequestSide,
        RoutingCorrelationNodeModel.DefaultRequestSide);
    private string ResponseSideCaption => RoutingCorrelationNodeModel.NormalizeResponseSide(
        RequestSideCaption,
        RoutingNodeConfiguration.NormalizeText(Model.ResponseSide, RoutingCorrelationNodeModel.DefaultResponseSide),
        Model.CaseSensitive);
    private string SideFlowCaption => $"{RequestSideCaption} to {ResponseSideCaption}";
    private string CaseCaption => Model.CaseSensitive ? "case exact" : "case folded";
    private string TimeoutCaption => $"{RoutingNodeConfiguration.NormalizePositiveInt(Model.TimeoutMilliseconds, RoutingCorrelationNodeModel.DefaultTimeoutMilliseconds)} ms";
    private string PendingCaption => $"{RoutingNodeConfiguration.NormalizePositiveInt(Model.MaxPending, RoutingCorrelationNodeModel.DefaultMaxPending)} pending";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingCorrelationNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var editorChanged = false;

        if (_keyEditor is not null && !ReferenceEquals(_initializedKeyEditor, _keyEditor))
        {
            _initializedKeyEditor = _keyEditor;
            editorChanged = true;
        }

        if (_sideEditor is not null && !ReferenceEquals(_initializedSideEditor, _sideEditor))
        {
            _initializedSideEditor = _sideEditor;
            editorChanged = true;
        }

        if (editorChanged)
        {
            await ConfigureCodeEditorsAsync();
            await SyncEditorsAsync();
            await LayoutEditorsAfterRenderAsync();
        }
    }

    public void Dispose()
        => ThemeService.Changed -= OnThemeChanged;

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _inputType = RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
        _keyExpression = RoutingNodeConfiguration.NormalizeText(
            Model.KeyExpression,
            RoutingCorrelationNodeModel.DefaultKeyExpression);
        _sideExpression = RoutingNodeConfiguration.NormalizeText(
            Model.SideExpression,
            RoutingCorrelationNodeModel.DefaultSideExpression);
        _caseSensitive = Model.CaseSensitive;
        _requestSide = RoutingNodeConfiguration.NormalizeText(
            Model.RequestSide,
            RoutingCorrelationNodeModel.DefaultRequestSide);
        _responseSide = RoutingCorrelationNodeModel.NormalizeResponseSide(
            _requestSide,
            RoutingNodeConfiguration.NormalizeText(Model.ResponseSide, RoutingCorrelationNodeModel.DefaultResponseSide),
            _caseSensitive);
        _timeoutMilliseconds = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.TimeoutMilliseconds,
            RoutingCorrelationNodeModel.DefaultTimeoutMilliseconds);
        _maxPending = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.MaxPending,
            RoutingCorrelationNodeModel.DefaultMaxPending);
        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingCorrelationNodeModel.DefaultBoundedCapacity);
        _editorVersion++;
    }

    private void OnThemeChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(ConfigureCodeEditorsAsync);

    private StandaloneEditorConstructionOptions KeyEditorConstructionOptions(StandaloneCodeEditor editor)
        => CreateEditorConstructionOptions(_keyExpression);

    private StandaloneEditorConstructionOptions SideEditorConstructionOptions(StandaloneCodeEditor editor)
        => CreateEditorConstructionOptions(_sideExpression);

    private StandaloneEditorConstructionOptions CreateEditorConstructionOptions(string value)
        => new()
        {
            AutomaticLayout = true,
            Language = "csharp",
            ScrollBeyondLastLine = false,
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            Value = value
        };

    private async Task ConfigureCodeEditorsAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("fluxmqMonaco.ensureConfigured", ThemeService.IsDarkMode);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Routing Correlation code editor configuration failed: {exception.Message}");
        }
    }

    private async Task SaveAsync()
    {
        if (_keyEditor is not null)
        {
            try
            {
                _keyExpression = await _keyEditor.GetValue();
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"Routing Correlation key code editor read failed: {exception.Message}");
            }
        }

        if (_sideEditor is not null)
        {
            try
            {
                _sideExpression = await _sideEditor.GetValue();
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"Routing Correlation side code editor read failed: {exception.Message}");
            }
        }

        Model.InputType = RoutingNodeConfiguration.NormalizeInputType(_inputType);
        Model.KeyExpression = RoutingNodeConfiguration.NormalizeText(
            _keyExpression,
            RoutingCorrelationNodeModel.DefaultKeyExpression);
        Model.SideExpression = RoutingNodeConfiguration.NormalizeText(
            _sideExpression,
            RoutingCorrelationNodeModel.DefaultSideExpression);
        Model.CaseSensitive = _caseSensitive;
        Model.RequestSide = RoutingNodeConfiguration.NormalizeText(
            _requestSide,
            RoutingCorrelationNodeModel.DefaultRequestSide);
        Model.ResponseSide = RoutingCorrelationNodeModel.NormalizeResponseSide(
            Model.RequestSide,
            RoutingNodeConfiguration.NormalizeText(_responseSide, RoutingCorrelationNodeModel.DefaultResponseSide),
            Model.CaseSensitive);
        Model.TimeoutMilliseconds = RoutingNodeConfiguration.NormalizePositiveInt(
            _timeoutMilliseconds,
            RoutingCorrelationNodeModel.DefaultTimeoutMilliseconds);
        Model.MaxPending = RoutingNodeConfiguration.NormalizePositiveInt(
            _maxPending,
            RoutingCorrelationNodeModel.DefaultMaxPending);
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingCorrelationNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
    }

    private async Task OnKeyExpressionContentChanged()
    {
        if (_syncingEditors || _keyEditor is null)
        {
            return;
        }

        _keyExpression = await _keyEditor.GetValue();
        await RefreshDialogAsync();
    }

    private async Task OnSideExpressionContentChanged()
    {
        if (_syncingEditors || _sideEditor is null)
        {
            return;
        }

        _sideExpression = await _sideEditor.GetValue();
        await RefreshDialogAsync();
    }

    private async Task SetRequestSide(string value)
    {
        _requestSide = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetResponseSide(string value)
    {
        _responseSide = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetCaseSensitive(bool value)
    {
        _caseSensitive = value;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task RefreshDialogAsync()
    {
        await InvokeAsync(StateHasChanged);
        await DialogRefresh.RefreshAsync(Node.NodeName);
        await LayoutEditorsAfterRenderAsync();
    }

    private async Task SyncEditorsAsync()
    {
        _syncingEditors = true;
        try
        {
            await SyncEditorAsync(_keyEditor, _keyExpression, "key");
            await SyncEditorAsync(_sideEditor, _sideExpression, "side");
        }
        finally
        {
            _syncingEditors = false;
        }
    }

    private static async Task SyncEditorAsync(StandaloneCodeEditor? editor, string value, string editorName)
    {
        if (editor is null)
        {
            return;
        }

        try
        {
            await editor.SetValue(value);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Routing Correlation {editorName} code editor sync failed: {exception.Message}");
        }
    }

    private async Task LayoutEditorsAfterRenderAsync()
    {
        await Task.Yield();
        await LayoutEditorsAsync();
        await Task.Delay(50);
        await LayoutEditorsAsync();
    }

    private async Task LayoutEditorsAsync()
    {
        await LayoutEditorAsync(_keyEditor, _keyEditorHost, "key");
        await LayoutEditorAsync(_sideEditor, _sideEditorHost, "side");
    }

    private async Task LayoutEditorAsync(StandaloneCodeEditor? editor, ElementReference host, string editorName)
    {
        if (editor is null)
        {
            return;
        }

        try
        {
            var size = await JsRuntime.InvokeAsync<EditorHostSize>("fluxmqMonaco.measureElement", host);
            if (size is not null && size.Width > 0 && size.Height > 0)
            {
                await editor.Layout(new Dimension { Width = size.Width, Height = size.Height }, null);
            }
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"Routing Correlation {editorName} code editor layout failed: {exception.Message}");
        }
    }

    private string? ValidateEditor()
    {
        if (string.IsNullOrWhiteSpace(_keyExpression))
        {
            return "Enter a correlation key expression before saving.";
        }

        if (string.IsNullOrWhiteSpace(_sideExpression))
        {
            return "Enter a correlation side expression before saving.";
        }

        if (string.IsNullOrWhiteSpace(_requestSide))
        {
            return "Enter a request side name before saving.";
        }

        if (string.IsNullOrWhiteSpace(_responseSide))
        {
            return "Enter a response side name before saving.";
        }

        var comparer = _caseSensitive ? StringComparer.Ordinal : StringComparer.OrdinalIgnoreCase;
        return comparer.Equals(_requestSide.Trim(), _responseSide.Trim())
            ? "Request and response side names must be different."
            : null;
    }

    private static bool IsNonCriticalEditorException(Exception exception)
        => exception is JSException or JSDisconnectedException or InvalidOperationException or ObjectDisposedException;

    private sealed class EditorHostSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}

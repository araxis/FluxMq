@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.ViewColumn"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="routing-window-summary">
            <div class="routing-window-meta">
                <div class="routing-window-meta-item input">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="routing-window-meta-item">
                    <span>Output</span>
                    <strong>FlowWindow</strong>
                </div>
                <div class="routing-window-meta-item">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-window-limits" aria-label="Routing window limits">
                <span class="routing-window-contract-label">Window limits</span>
                <span class="routing-window-token">@MaxItemsCaption</span>
                <span class="routing-window-token">@TimeCaption</span>
                <span class="routing-window-token">@PartialCaption</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-window-editor" aria-label="Routing window settings">
            <section class="routing-window-window-panel" aria-label="Routing window configuration">
                <div class="routing-window-source-row" aria-label="Routing window source settings">
                    <MudSelect T="string"
                               Label="Input type"
                               @bind-Value="_inputType"
                               aria-label="Routing window input type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="routing-window-input-field">
                        @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int"
                                     Label="Input buffer"
                                     @bind-Value="_boundedCapacity"
                                     aria-label="Routing window input buffer"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-window-buffer-field" />
                </div>

                <div class="routing-window-limit-row" aria-label="Routing window limit settings">
                    <MudNumericField T="int"
                                     Label="Max items"
                                     @bind-Value="_maxItems"
                                     aria-label="Routing window max items"
                                     Min="0"
                                     Max="100000"
                                     Step="10"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-window-max-items-field" />

                    <MudNumericField T="int"
                                     Label="Time window ms"
                                     @bind-Value="_timeMilliseconds"
                                     aria-label="Routing window time in milliseconds"
                                     Min="0"
                                     Max="86400000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-window-time-field" />

                    <div class="routing-window-partial-option">
                        <MudCheckBox T="bool"
                                     Label="Emit partial"
                                     aria-label="Emit partial window on completion"
                                     @bind-Value="_emitPartialOnCompletion"
                                     Class="routing-window-partial-check" />
                    </div>
                </div>
            </section>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingWindowNodeModel Model => (RoutingWindowNodeModel)Node;

    private string _inputType = RoutingWindowNodeModel.DefaultInputType;
    private int _maxItems = RoutingWindowNodeModel.DefaultMaxItems;
    private int _timeMilliseconds = RoutingWindowNodeModel.DefaultTimeMilliseconds;
    private bool _emitPartialOnCompletion = RoutingWindowNodeModel.DefaultEmitPartialOnCompletion;
    private int _boundedCapacity = RoutingWindowNodeModel.DefaultBoundedCapacity;

    private string InputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
    private int NormalizedMaxItems => RoutingNodeConfiguration.NormalizeNonNegativeInt(
        Model.MaxItems,
        RoutingWindowNodeModel.DefaultMaxItems);
    private int NormalizedTimeMilliseconds => RoutingNodeConfiguration.NormalizeNonNegativeInt(
        Model.TimeMilliseconds,
        RoutingWindowNodeModel.DefaultTimeMilliseconds);
    private int EffectiveMaxItems => NormalizedMaxItems == 0 && NormalizedTimeMilliseconds == 0
        ? RoutingWindowNodeModel.DefaultMaxItems
        : NormalizedMaxItems;
    private string MaxItemsCaption => EffectiveMaxItems > 0
        ? $"max {EffectiveMaxItems}"
        : "count off";
    private string TimeCaption => NormalizedTimeMilliseconds > 0
        ? $"{NormalizedTimeMilliseconds} ms"
        : "time off";
    private string PartialCaption => Model.EmitPartialOnCompletion ? "partial on" : "partial off";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingWindowNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _inputType = RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
        _maxItems = RoutingNodeConfiguration.NormalizeNonNegativeInt(
            Model.MaxItems,
            RoutingWindowNodeModel.DefaultMaxItems);
        _timeMilliseconds = RoutingNodeConfiguration.NormalizeNonNegativeInt(
            Model.TimeMilliseconds,
            RoutingWindowNodeModel.DefaultTimeMilliseconds);
        if (_maxItems == 0 && _timeMilliseconds == 0)
        {
            _maxItems = RoutingWindowNodeModel.DefaultMaxItems;
        }

        _emitPartialOnCompletion = Model.EmitPartialOnCompletion;
        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingWindowNodeModel.DefaultBoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.InputType = RoutingNodeConfiguration.NormalizeInputType(_inputType);
        Model.MaxItems = RoutingNodeConfiguration.NormalizeNonNegativeInt(
            _maxItems,
            RoutingWindowNodeModel.DefaultMaxItems);
        Model.TimeMilliseconds = RoutingNodeConfiguration.NormalizeNonNegativeInt(
            _timeMilliseconds,
            RoutingWindowNodeModel.DefaultTimeMilliseconds);
        if (Model.MaxItems == 0 && Model.TimeMilliseconds == 0)
        {
            Model.MaxItems = RoutingWindowNodeModel.DefaultMaxItems;
        }

        Model.EmitPartialOnCompletion = _emitPartialOnCompletion;
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingWindowNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

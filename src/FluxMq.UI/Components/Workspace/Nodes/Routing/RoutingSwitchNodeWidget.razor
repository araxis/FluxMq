@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.AccountTree"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="routing-switch-summary node-ui-summary">
            <div class="routing-switch-meta node-ui-facts">
                <div class="routing-switch-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="routing-switch-meta-item node-ui-fact">
                    <span>Routes</span>
                    <strong>@RouteCountCaption</strong>
                </div>
                <div class="routing-switch-meta-item node-ui-fact">
                    <span>Envelope</span>
                    <strong>@EnvelopeCaption</strong>
                </div>
                <div class="routing-switch-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-switch-expression" aria-label="Routing switch expression">
                <span class="routing-switch-contract-label node-ui-fact-label">Expression</span>
                <strong title="@ExpressionPreview">@ExpressionPreview</strong>
            </div>

            <div class="routing-switch-routes" aria-label="Routing switch routes">
                <span class="routing-switch-contract-label node-ui-fact-label">Route outputs</span>
                @foreach (var route in RoutePreview)
                {
                    <span class="routing-switch-token node-ui-token" title="@($"{route.Key} => {route.OutputPort}")">@route.OutputPort</span>
                }
                @if (RoutePreviewOverflow > 0)
                {
                    <span class="routing-switch-token overflow node-ui-token">+@RoutePreviewOverflow</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-switch-editor node-ui-editor" aria-label="Routing switch settings">
            <div class="routing-switch-config-row node-ui-form-grid">
                <MudSelect T="string"
                           Label="Input type"
                           @bind-Value="_inputType"
                           aria-label="Routing switch input type"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Class="routing-switch-input-field">
                    @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                    {
                        <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="int"
                                 Label="Input buffer"
                                 @bind-Value="_boundedCapacity"
                                 aria-label="Routing switch input buffer"
                                 Min="1"
                                 Max="100000"
                                 Step="100"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Class="routing-switch-buffer-field" />

                <div class="routing-switch-envelope-option">
                    <MudCheckBox T="bool"
                                 Label="Emit envelope"
                                 aria-label="Emit route envelope"
                                 @bind-Value="_emitRouteEnvelope"
                                 Class="routing-switch-envelope-check" />
                </div>
            </div>

            <div class="routing-switch-rule-grid" aria-label="Routing switch rule expression">
                <div class="routing-switch-expression-stack">
                    <MudTextField T="string"
                                  Label="Expression"
                                  Value="@_expression"
                                  ValueChanged="@SetExpression"
                                  aria-label="Routing switch expression"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Lines="5"
                                  Class="routing-switch-expression-field"
                                  Placeholder="qos >= 1" />

                    <div class="routing-switch-variable-reference" aria-label="Routing switch expression variables">
                        <span class="routing-switch-variable-label">Variables</span>
                        <div class="routing-switch-variable-list">
                            @foreach (var variable in ExpressionVariables)
                            {
                                <span class="routing-switch-variable-token node-ui-token">
                                    <code>@variable.Name</code>
                                    <small>@variable.Type</small>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="routing-switch-route-composer" aria-label="Routing switch route outputs">
                <div class="routing-switch-route-header">
                    <span>Match key</span>
                    <span>Output port</span>
                    <MudTooltip Text="Add route">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Class="routing-switch-route-add"
                                       aria-label="Add route"
                                       OnClick="@AddRoute" />
                    </MudTooltip>
                </div>

                <div class="routing-switch-route-list">
                    @for (var index = 0; index < _routeDrafts.Count; index++)
                    {
                        var route = _routeDrafts[index];
                        <div class="routing-switch-route-row" @key="route">
                            <MudTextField T="string"
                                          aria-label="@($"Route match key {index + 1}")"
                                          Value="@route.Key"
                                          ValueChanged="@(value => SetRouteKeyAsync(route, value))"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Placeholder="Match key"
                                          Class="routing-switch-route-key-field" />
                            <MudTextField T="string"
                                          aria-label="@($"Route output port {index + 1}")"
                                          Value="@route.OutputPort"
                                          ValueChanged="@(value => SetRouteOutputAsync(route, value))"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Placeholder="Output port"
                                          Class="routing-switch-route-output-field" />
                            <MudTooltip Text="Remove route">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Disabled="@(_routeDrafts.Count == 1)"
                                               Class="routing-switch-route-remove"
                                               aria-label="@($"Remove route {route.Key}")"
                                               OnClick="@(() => RemoveRoute(route))" />
                            </MudTooltip>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingSwitchNodeModel Model => (RoutingSwitchNodeModel)Node;

    private string _inputType = RoutingSwitchNodeModel.DefaultInputType;
    private string _expression = RoutingSwitchNodeModel.DefaultExpression;
    private bool _emitRouteEnvelope;
    private int _boundedCapacity = RoutingSwitchNodeModel.DefaultBoundedCapacity;
    private List<RouteDraft> _routeDrafts = [];
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private string InputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
    private string RouteCountCaption => $"{Model.Routes.Count} routes";
    private string EnvelopeCaption => Model.EmitRouteEnvelope ? "on" : "off";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingSwitchNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string ExpressionPreview => string.IsNullOrWhiteSpace(Model.Expression)
        ? RoutingSwitchNodeModel.DefaultExpression
        : Model.Expression.Trim();
    private IReadOnlyList<RoutingSwitchRoute> RoutePreview => Model.Routes.Take(3).ToArray();
    private int RoutePreviewOverflow => Math.Max(0, Model.Routes.Count - 3);
    private static readonly IReadOnlyList<ExpressionVariable> ExpressionVariables =
    [
        new("topic", "string"),
        new("payloadText", "string"),
        new("qos", "number"),
        new("retain", "bool"),
        new("receivedAt", "time"),
        new("payloadJson", "json")
    ];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _inputType = RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
        _expression = Model.Expression;
        _routeDrafts = Model.Routes
            .Select(static route => new RouteDraft(route.Key, route.OutputPort))
            .ToList();
        if (_routeDrafts.Count == 0)
        {
            _routeDrafts =
            [
                new("True", "WhenTrue"),
                new("False", "WhenFalse")
            ];
        }
        _emitRouteEnvelope = Model.EmitRouteEnvelope;
        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingSwitchNodeModel.DefaultBoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.InputType = RoutingNodeConfiguration.NormalizeInputType(_inputType);
        Model.Expression = string.IsNullOrWhiteSpace(_expression)
            ? RoutingSwitchNodeModel.DefaultExpression
            : _expression.Trim();
        Model.Routes = RoutingSwitchNodeModel.ParseRoutes(FormatRouteDrafts());
        Model.EmitRouteEnvelope = _emitRouteEnvelope;
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingSwitchNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private async Task AddRoute()
    {
        var ordinal = _routeDrafts.Count + 1;
        var key = $"Route{ordinal}";
        while (_routeDrafts.Any(route => string.Equals(route.Key, key, StringComparison.Ordinal)))
        {
            ordinal++;
            key = $"Route{ordinal}";
        }

        _routeDrafts.Add(new RouteDraft(key, key));
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task RemoveRoute(RouteDraft route)
    {
        if (_routeDrafts.Count <= 1)
        {
            return;
        }

        _routeDrafts.Remove(route);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetExpression(string value)
    {
        _expression = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetRouteKeyAsync(RouteDraft route, string value)
    {
        route.Key = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetRouteOutputAsync(RouteDraft route, string value)
    {
        route.OutputPort = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private string? ValidateEditor()
    {
        if (string.IsNullOrWhiteSpace(_expression))
        {
            return "Enter a routing expression before saving.";
        }

        if (_routeDrafts.Count == 0 || !_routeDrafts.Any(IsCompleteRoute))
        {
            return "Add at least one complete route before saving.";
        }

        if (_routeDrafts.Any(route => string.IsNullOrWhiteSpace(route.Key)))
        {
            return "Each route needs a match key.";
        }

        if (_routeDrafts.Any(route => string.IsNullOrWhiteSpace(route.OutputPort)))
        {
            return "Each route needs an output port.";
        }

        return _routeDrafts
            .GroupBy(route => route.Key.Trim(), StringComparer.Ordinal)
            .Any(group => group.Count() > 1)
            ? "Route match keys must be unique."
            : null;
    }

    private static bool IsCompleteRoute(RouteDraft route)
        => !string.IsNullOrWhiteSpace(route.Key) &&
           !string.IsNullOrWhiteSpace(route.OutputPort);

    private string FormatRouteDrafts()
        => string.Join(
            Environment.NewLine,
            _routeDrafts
                .Select(static route => $"{route.Key?.Trim()}={route.OutputPort?.Trim()}")
                .Where(static line => !string.IsNullOrWhiteSpace(line.Split('=', 2)[0])));

    private sealed class RouteDraft(string key, string outputPort)
    {
        public string Key { get; set; } = key;
        public string OutputPort { get; set; } = outputPort;
    }

    private sealed record ExpressionVariable(string Name, string Type);
}

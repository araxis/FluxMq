@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.CallMerge"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="routing-merge-summary node-ui-summary">
            <div class="routing-merge-meta node-ui-facts">
                <div class="routing-merge-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="routing-merge-meta-item node-ui-fact">
                    <span>Inputs</span>
                    <strong>@InputCountCaption</strong>
                </div>
                <div class="routing-merge-meta-item output node-ui-fact">
                    <span>Output</span>
                    <strong>Merged item</strong>
                </div>
                <div class="routing-merge-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-merge-ports" aria-label="Routing merge inputs">
                <span class="routing-merge-summary-label node-ui-fact-label">Input ports</span>
                @foreach (var input in InputPreview)
                {
                    <span class="routing-merge-token node-ui-token" title="@input">@input</span>
                }
                @if (InputPreviewOverflow > 0)
                {
                    <span class="routing-merge-token overflow node-ui-token">+@InputPreviewOverflow</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-merge-editor node-ui-editor" aria-label="Routing merge settings">
            <div class="routing-merge-layout" aria-label="Routing merge editor layout">
                <div class="routing-merge-port-composer" aria-label="Routing merge input ports">
                    <div class="routing-merge-port-header">
                        <span>Input port</span>
                        <MudTooltip Text="Add input port">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Class="routing-merge-add-port"
                                           aria-label="Add input port"
                                           OnClick="@AddInput" />
                        </MudTooltip>
                    </div>

                    <div class="routing-merge-port-list">
                        @for (var index = 0; index < _inputDrafts.Count; index++)
                        {
                            var input = _inputDrafts[index];
                            <div class="routing-merge-port-row" @key="input">
                                <MudTextField T="string"
                                              Value="@input.Name"
                                              ValueChanged="@(value => SetInputNameAsync(input, value))"
                                              aria-label="@($"Input port {index + 1}")"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Class="routing-merge-input-name-field"
                                              Placeholder="Primary" />
                                <MudTooltip Text="@(_inputDrafts.Count > 1 ? "Remove input port" : "Keep at least one input")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Disabled="@(_inputDrafts.Count <= 1)"
                                                   Class="routing-merge-remove-port"
                                                   aria-label="@($"Remove input port {input.Name}")"
                                                   OnClick="@(() => RemoveInput(input))" />
                                </MudTooltip>
                            </div>
                        }
                    </div>
                </div>

                <div class="routing-merge-sidecar" aria-label="Routing merge support settings">
                    <MudSelect T="string"
                               Label="Input type"
                               @bind-Value="_inputType"
                               aria-label="Routing merge input type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="routing-merge-input-field">
                        @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int"
                                     Label="Input buffer"
                                     @bind-Value="_boundedCapacity"
                                     aria-label="Routing merge input buffer"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-merge-buffer-field" />
                </div>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingMergeNodeModel Model => (RoutingMergeNodeModel)Node;

    private string _inputType = RoutingMergeNodeModel.DefaultInputType;
    private List<PortDraft> _inputDrafts = [];
    private int _boundedCapacity = RoutingMergeNodeModel.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private IReadOnlyList<string> NormalizedInputs => RoutingNodeConfiguration.NormalizePortList(
        Model.Inputs,
        ["Output", "Errors"],
        ["Left", "Right"]);
    private string InputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
    private string InputCountCaption => $"{NormalizedInputs.Count} inputs";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingMergeNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private IReadOnlyList<string> InputPreview => NormalizedInputs.Take(4).ToArray();
    private int InputPreviewOverflow => Math.Max(0, NormalizedInputs.Count - 4);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _inputType = RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
        _inputDrafts = RoutingNodeConfiguration.SplitLines(Model.FormatInputs())
            .Select(static input => new PortDraft(input))
            .ToList();
        if (_inputDrafts.Count == 0)
        {
            _inputDrafts = [new("Left")];
        }

        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingMergeNodeModel.DefaultBoundedCapacity);
    }

    private async Task AddInput()
    {
        _inputDrafts.Add(new($"Input{_inputDrafts.Count + 1}"));
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task RemoveInput(PortDraft input)
    {
        if (_inputDrafts.Count <= 1)
        {
            return;
        }

        _inputDrafts.Remove(input);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetInputNameAsync(PortDraft input, string value)
    {
        input.Name = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private Task SaveAsync()
    {
        Model.InputType = RoutingNodeConfiguration.NormalizeInputType(_inputType);
        Model.Inputs = RoutingNodeConfiguration.NormalizePortList(
            _inputDrafts.Select(static input => input.Name),
            ["Output", "Errors"],
            ["Left", "Right"]);
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingMergeNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private string? ValidateEditor()
        => ValidatePortDrafts(
            _inputDrafts,
            ["Output", "Errors"],
            "Add at least one input port before saving.",
            "Each input port needs a name.",
            "Input port names can use letters, numbers, and underscores and cannot start with a number.",
            "Input port names cannot be Output or Errors.",
            "Input port names must be unique.");

    private static string? ValidatePortDrafts(
        IReadOnlyCollection<PortDraft> drafts,
        IReadOnlyCollection<string> reserved,
        string emptyMessage,
        string blankMessage,
        string invalidNameMessage,
        string reservedMessage,
        string duplicateMessage)
    {
        if (drafts.Count == 0 || !drafts.Any(IsNamedPort))
        {
            return emptyMessage;
        }

        foreach (var draft in drafts)
        {
            var name = draft.Name?.Trim() ?? string.Empty;
            if (name.Length == 0)
            {
                return blankMessage;
            }

            var normalized = RoutingNodeConfiguration.NormalizePortName(name, string.Empty);
            if (!string.Equals(name, normalized, StringComparison.Ordinal))
            {
                return invalidNameMessage;
            }

            if (reserved.Contains(normalized, StringComparer.Ordinal))
            {
                return reservedMessage;
            }
        }

        return drafts
            .GroupBy(
                draft => RoutingNodeConfiguration.NormalizePortName(draft.Name, string.Empty),
                StringComparer.Ordinal)
            .Any(group => group.Count() > 1)
            ? duplicateMessage
            : null;
    }

    private static bool IsNamedPort(PortDraft draft)
        => !string.IsNullOrWhiteSpace(draft.Name);

    private sealed class PortDraft(string name)
    {
        public string Name { get; set; } = name;
    }
}

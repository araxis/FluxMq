@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase
@inject NodeEditDialogRefreshService DialogRefresh

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.CallSplit"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft"
                 EditorValidationError="@ValidateEditor">
    <Body>
        <div class="routing-fork-summary node-ui-summary">
            <div class="routing-fork-meta node-ui-facts">
                <div class="routing-fork-meta-item input node-ui-fact">
                    <span>Input</span>
                    <strong title="@InputTypeCaption">@InputTypeCaption</strong>
                </div>
                <div class="routing-fork-meta-item node-ui-fact">
                    <span>Outputs</span>
                    <strong>@OutputCountCaption</strong>
                </div>
                <div class="routing-fork-meta-item node-ui-fact">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-fork-ports" aria-label="Routing fork outputs">
                <span class="routing-fork-summary-label node-ui-fact-label">Output ports</span>
                @foreach (var output in OutputPreview)
                {
                    <span class="routing-fork-token node-ui-token" title="@output">@output</span>
                }
                @if (OutputPreviewOverflow > 0)
                {
                    <span class="routing-fork-token overflow node-ui-token">+@OutputPreviewOverflow</span>
                }
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-fork-editor node-ui-editor" aria-label="Routing fork settings">
            <div class="routing-fork-layout" aria-label="Routing fork editor layout">
                <div class="routing-fork-port-composer" aria-label="Routing fork output ports">
                    <div class="routing-fork-port-header">
                        <span>Output port</span>
                        <MudTooltip Text="@AddOutputPortLabel">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Class="routing-fork-add-port"
                                           aria-label="@AddOutputPortLabel"
                                           OnClick="@AddOutput" />
                        </MudTooltip>
                    </div>

                    <div class="routing-fork-port-list">
                        @for (var index = 0; index < _outputDrafts.Count; index++)
                        {
                            var output = _outputDrafts[index];
                            <div class="routing-fork-port-row" @key="output">
                                <MudTextField T="string"
                                              Value="@output.Name"
                                              ValueChanged="@(value => SetOutputNameAsync(output, value))"
                                              aria-label="@OutputPortFieldLabel(output, index)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Class="routing-fork-output-name-field"
                                              Placeholder="Audit" />
                                <MudTooltip Text="@RemoveOutputPortLabel(output)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Disabled="@(_outputDrafts.Count <= 1)"
                                                   Class="routing-fork-remove-port"
                                                   aria-label="@RemoveOutputPortLabel(output)"
                                                   OnClick="@(() => RemoveOutput(output))" />
                                </MudTooltip>
                            </div>
                        }
                    </div>
                </div>

                <div class="routing-fork-sidecar" aria-label="Routing fork support settings">
                    <MudSelect T="string"
                               Label="Input type"
                               @bind-Value="_inputType"
                               aria-label="Routing fork input type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="routing-fork-input-field">
                        @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int"
                                     Label="Input buffer"
                                     @bind-Value="_boundedCapacity"
                                     aria-label="Routing fork input buffer"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-fork-buffer-field" />
                </div>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingForkNodeModel Model => (RoutingForkNodeModel)Node;

    private string _inputType = RoutingForkNodeModel.DefaultInputType;
    private List<PortDraft> _outputDrafts = [];
    private int _boundedCapacity = RoutingForkNodeModel.DefaultBoundedCapacity;
    private string? _loadedNodeName;
    private FlowDiagramNodeModel? _loadedNode;

    private IReadOnlyList<string> NormalizedOutputs => RoutingNodeConfiguration.NormalizePortList(
        Model.Outputs,
        ["Input", "Errors"],
        ["A", "B"]);
    private string InputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
    private string OutputCountCaption => $"{NormalizedOutputs.Count} outputs";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingForkNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private IReadOnlyList<string> OutputPreview => NormalizedOutputs.Take(4).ToArray();
    private int OutputPreviewOverflow => Math.Max(0, NormalizedOutputs.Count - 4);

    private string AddOutputPortLabel => $"Add output port to {Node.NodeName}";

    private string OutputPortFieldLabel(PortDraft output, int index)
    {
        var target = string.IsNullOrWhiteSpace(output.Name)
            ? $"output port {index + 1}"
            : output.Name.Trim();

        return $"Edit output port {target} for {Node.NodeName}";
    }

    private string RemoveOutputPortLabel(PortDraft output)
    {
        if (_outputDrafts.Count <= 1)
        {
            return $"Keep at least one output port on {Node.NodeName}";
        }

        var name = output.Name?.Trim();
        var target = string.IsNullOrWhiteSpace(name) ? "output port" : name;
        return $"Remove {target} from {Node.NodeName}";
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loadedNode, Node) || !string.Equals(_loadedNodeName, Node.NodeName, StringComparison.Ordinal))
        {
            LoadDraft();
        }
    }

    private void LoadDraft()
    {
        _loadedNode = Node;
        _loadedNodeName = Node.NodeName;
        _inputType = RoutingNodeConfiguration.NormalizeInputType(Model.InputType);
        _outputDrafts = RoutingNodeConfiguration.SplitLines(Model.FormatOutputs())
            .Select(static output => new PortDraft(output))
            .ToList();
        if (_outputDrafts.Count == 0)
        {
            _outputDrafts = [new("A")];
        }

        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingForkNodeModel.DefaultBoundedCapacity);
    }

    private async Task AddOutput()
    {
        _outputDrafts.Add(new($"Output{_outputDrafts.Count + 1}"));
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task RemoveOutput(PortDraft output)
    {
        if (_outputDrafts.Count <= 1)
        {
            return;
        }

        _outputDrafts.Remove(output);
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private async Task SetOutputNameAsync(PortDraft output, string value)
    {
        output.Name = value ?? string.Empty;
        await DialogRefresh.RefreshAsync(Node.NodeName);
    }

    private Task SaveAsync()
    {
        Model.InputType = RoutingNodeConfiguration.NormalizeInputType(_inputType);
        Model.Outputs = RoutingNodeConfiguration.NormalizePortList(
            _outputDrafts.Select(static output => output.Name),
            ["Input", "Errors"],
            ["A", "B"]);
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingForkNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }

    private string? ValidateEditor()
        => ValidatePortDrafts(
            _outputDrafts,
            ["Input", "Errors"],
            "Add at least one output port before saving.",
            "Each output port needs a name.",
            "Output port names can use letters, numbers, and underscores and cannot start with a number.",
            "Output port names cannot be Input or Errors.",
            "Output port names must be unique.");

    private static string? ValidatePortDrafts(
        IReadOnlyCollection<PortDraft> drafts,
        IReadOnlyCollection<string> reserved,
        string emptyMessage,
        string blankMessage,
        string invalidNameMessage,
        string reservedMessage,
        string duplicateMessage)
    {
        if (drafts.Count == 0 || !drafts.Any(IsNamedPort))
        {
            return emptyMessage;
        }

        foreach (var draft in drafts)
        {
            var name = draft.Name?.Trim() ?? string.Empty;
            if (name.Length == 0)
            {
                return blankMessage;
            }

            var normalized = RoutingNodeConfiguration.NormalizePortName(name, string.Empty);
            if (!string.Equals(name, normalized, StringComparison.Ordinal))
            {
                return invalidNameMessage;
            }

            if (reserved.Contains(normalized, StringComparer.Ordinal))
            {
                return reservedMessage;
            }
        }

        return drafts
            .GroupBy(
                draft => RoutingNodeConfiguration.NormalizePortName(draft.Name, string.Empty),
                StringComparer.Ordinal)
            .Any(group => group.Count() > 1)
            ? duplicateMessage
            : null;
    }

    private static bool IsNamedPort(PortDraft draft)
        => !string.IsNullOrWhiteSpace(draft.Name);

    private sealed class PortDraft(string name)
    {
        public string Name { get; set; } = name;
    }
}

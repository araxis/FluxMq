@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.Hub"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false"
                 OnSave="@SaveAsync"
                 OnCancel="@LoadDraft">
    <Body>
        <div class="routing-join-summary">
            <div class="routing-join-meta">
                <div class="routing-join-meta-item input">
                    <span>Left</span>
                    <strong title="@LeftInputTypeCaption">@LeftInputTypeCaption</strong>
                </div>
                <div class="routing-join-meta-item input">
                    <span>Right</span>
                    <strong title="@RightInputTypeCaption">@RightInputTypeCaption</strong>
                </div>
                <div class="routing-join-meta-item">
                    <span>Output</span>
                    <strong>FlowJoinResult</strong>
                </div>
                <div class="routing-join-meta-item">
                    <span>Buffer</span>
                    <strong>@BufferCaption</strong>
                </div>
            </div>

            <div class="routing-join-rules" aria-label="Routing join rules">
                <span class="routing-join-contract-label">Join</span>
                <span class="routing-join-token" title="@JoinExpressionCaption">@JoinExpressionCaption</span>
                <span class="routing-join-token">@TimeoutCaption</span>
                <span class="routing-join-token">@PendingCaption</span>
                <span class="routing-join-token">@CaseCaption</span>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="routing-join-editor" aria-label="Routing join settings">
            <section class="routing-join-editor-surface" aria-label="Routing join input contracts">
                <div class="routing-join-config-row">
                    <MudSelect T="string"
                               Label="Left input type"
                               @bind-Value="_leftInputType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="routing-join-left-type-field">
                        @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string"
                               Label="Right input type"
                               @bind-Value="_rightInputType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="routing-join-right-type-field">
                        @foreach (var inputType in RoutingNodeConfiguration.InputTypes)
                        {
                            <MudSelectItem Value="@inputType">@inputType</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int"
                                     Label="Input buffer"
                                     @bind-Value="_boundedCapacity"
                                     Min="1"
                                     Max="100000"
                                     Step="100"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="routing-join-buffer-field" />
                </div>

                <div class="routing-join-matching-section" aria-label="Routing join matching rule">
                    <div class="routing-join-key-row" aria-label="Routing join key expressions">
                        <MudTextField T="string"
                                      Label="Left key expression"
                                      @bind-Value="_leftKeyExpression"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="routing-join-left-key-field"
                                      Placeholder="topic" />

                        <MudTextField T="string"
                                      Label="Right key expression"
                                      @bind-Value="_rightKeyExpression"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="routing-join-right-key-field"
                                      Placeholder="topic" />
                    </div>

                    <div class="routing-join-limit-row" aria-label="Routing join limit settings">
                        <MudNumericField T="int"
                                         Label="Timeout ms"
                                         @bind-Value="_timeoutMilliseconds"
                                         Min="1"
                                         Max="86400000"
                                         Step="1000"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="routing-join-timeout-field" />

                        <MudNumericField T="int"
                                         Label="Max pending"
                                         @bind-Value="_maxPending"
                                         Min="1"
                                         Max="100000"
                                         Step="100"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="routing-join-pending-field" />

                        <div class="routing-join-case-option">
                            <MudCheckBox T="bool"
                                         Label="Case sensitive"
                                         @bind-Value="_caseSensitive"
                                         Class="routing-join-case-check" />
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </Editor>
</NodeWidgetShell>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    private RoutingJoinNodeModel Model => (RoutingJoinNodeModel)Node;

    private string _leftInputType = RoutingJoinNodeModel.DefaultLeftInputType;
    private string _rightInputType = RoutingJoinNodeModel.DefaultRightInputType;
    private string _leftKeyExpression = RoutingJoinNodeModel.DefaultLeftKeyExpression;
    private string _rightKeyExpression = RoutingJoinNodeModel.DefaultRightKeyExpression;
    private bool _caseSensitive = RoutingJoinNodeModel.DefaultCaseSensitive;
    private int _timeoutMilliseconds = RoutingJoinNodeModel.DefaultTimeoutMilliseconds;
    private int _maxPending = RoutingJoinNodeModel.DefaultMaxPending;
    private int _boundedCapacity = RoutingJoinNodeModel.DefaultBoundedCapacity;

    private string LeftInputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.LeftInputType);
    private string RightInputTypeCaption => RoutingNodeConfiguration.NormalizeInputType(Model.RightInputType);
    private string LeftKeyExpressionCaption => RoutingNodeConfiguration.NormalizeText(
        Model.LeftKeyExpression,
        RoutingJoinNodeModel.DefaultLeftKeyExpression);
    private string RightKeyExpressionCaption => RoutingNodeConfiguration.NormalizeText(
        Model.RightKeyExpression,
        RoutingJoinNodeModel.DefaultRightKeyExpression);
    private string JoinExpressionCaption => $"{LeftKeyExpressionCaption} = {RightKeyExpressionCaption}";
    private string CaseCaption => Model.CaseSensitive ? "case exact" : "case folded";
    private string TimeoutCaption => $"{RoutingNodeConfiguration.NormalizePositiveInt(Model.TimeoutMilliseconds, RoutingJoinNodeModel.DefaultTimeoutMilliseconds)} ms";
    private string PendingCaption => $"{RoutingNodeConfiguration.NormalizePositiveInt(Model.MaxPending, RoutingJoinNodeModel.DefaultMaxPending)} pending";
    private string BufferCaption => RoutingNodeConfiguration.NormalizePositiveInt(
        Model.BoundedCapacity,
        RoutingJoinNodeModel.DefaultBoundedCapacity).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnParametersSet() => LoadDraft();

    private void LoadDraft()
    {
        _leftInputType = RoutingNodeConfiguration.NormalizeInputType(Model.LeftInputType);
        _rightInputType = RoutingNodeConfiguration.NormalizeInputType(Model.RightInputType);
        _leftKeyExpression = RoutingNodeConfiguration.NormalizeText(
            Model.LeftKeyExpression,
            RoutingJoinNodeModel.DefaultLeftKeyExpression);
        _rightKeyExpression = RoutingNodeConfiguration.NormalizeText(
            Model.RightKeyExpression,
            RoutingJoinNodeModel.DefaultRightKeyExpression);
        _caseSensitive = Model.CaseSensitive;
        _timeoutMilliseconds = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.TimeoutMilliseconds,
            RoutingJoinNodeModel.DefaultTimeoutMilliseconds);
        _maxPending = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.MaxPending,
            RoutingJoinNodeModel.DefaultMaxPending);
        _boundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            Model.BoundedCapacity,
            RoutingJoinNodeModel.DefaultBoundedCapacity);
    }

    private Task SaveAsync()
    {
        Model.LeftInputType = RoutingNodeConfiguration.NormalizeInputType(_leftInputType);
        Model.RightInputType = RoutingNodeConfiguration.NormalizeInputType(_rightInputType);
        Model.LeftKeyExpression = RoutingNodeConfiguration.NormalizeText(
            _leftKeyExpression,
            RoutingJoinNodeModel.DefaultLeftKeyExpression);
        Model.RightKeyExpression = RoutingNodeConfiguration.NormalizeText(
            _rightKeyExpression,
            RoutingJoinNodeModel.DefaultRightKeyExpression);
        Model.CaseSensitive = _caseSensitive;
        Model.TimeoutMilliseconds = RoutingNodeConfiguration.NormalizePositiveInt(
            _timeoutMilliseconds,
            RoutingJoinNodeModel.DefaultTimeoutMilliseconds);
        Model.MaxPending = RoutingNodeConfiguration.NormalizePositiveInt(
            _maxPending,
            RoutingJoinNodeModel.DefaultMaxPending);
        Model.BoundedCapacity = RoutingNodeConfiguration.NormalizePositiveInt(
            _boundedCapacity,
            RoutingJoinNodeModel.DefaultBoundedCapacity);

        Flow.UpdateNodeConfiguration(Node.NodeName, Model.BuildConfiguration());
        return Task.CompletedTask;
    }
}

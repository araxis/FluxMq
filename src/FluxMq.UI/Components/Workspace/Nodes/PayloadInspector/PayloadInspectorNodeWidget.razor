@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FindInPage"
                 CategoryColor="@Color.Secondary"
                 EditDialogMaxWidth="MaxWidth.Medium"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryToken="false">
    <Body>
        <div class="payload-inspector-node-summary node-ui-summary">
            <div class="payload-inspector-node-meta node-ui-facts">
                <div class="payload-inspector-node-meta-item behavior node-ui-fact">
                    <span>Behavior</span>
                    <strong>Auto detect payload</strong>
                </div>
                <div class="payload-inspector-node-meta-item node-ui-fact">
                    <span>Formats</span>
                    <strong>JSON, XML, text, Base64, binary</strong>
                </div>
            </div>
        </div>
    </Body>
    <Editor>
        <div class="payload-inspector-node-editor node-ui-editor" aria-label="Payload inspector details">
            <div class="payload-inspector-node-capability" aria-label="Payload inspector decode behavior">
                <span class="payload-inspector-node-editor-label">Detection</span>
                <strong>Auto detect payload</strong>
                <span class="payload-inspector-node-editor-note">JSON, XML, text, Base64, and binary payloads</span>
            </div>

            <div class="payload-inspector-node-detail-list" aria-label="Payload inspector operation details">
                <section class="payload-inspector-node-detail-row" aria-label="Payload inspector input details">
                    <span class="payload-inspector-node-editor-label">Input</span>
                    <strong>MQTT envelope payload</strong>
                    <span class="payload-inspector-node-editor-note">Topic and message payload are inspected</span>
                </section>

                <section class="payload-inspector-node-detail-row" aria-label="Payload inspector result details">
                    <span class="payload-inspector-node-editor-label">Result</span>
                    <strong>Inspected payload summary</strong>
                    <span class="payload-inspector-node-editor-note">Detected format, formatted text, and hex view</span>
                </section>
            </div>
        </div>
    </Editor>
</NodeWidgetShell>

@using FluxMq.UI.Components.Diagram
@inherits FluxMq.UI.Components.Diagram.NodeWidgetBase

<NodeWidgetShell Node="@Node"
                 HeaderIcon="@Icons.Material.Filled.FindInPage"
                 CategoryColor="@Color.Secondary"
                 ShowHeaderIcon="false"
                 ShowDisplayName="true"
                 ShowCategoryChip="false">
    <Body>
        <div class="payload-inspector-node-summary">
            <div class="payload-inspector-node-meta">
                <div class="payload-inspector-node-meta-item input">
                    <span>Input</span>
                    <strong>MqttEnvelope</strong>
                </div>
                <div class="payload-inspector-node-meta-item output">
                    <span>Output</span>
                    <strong>InspectedMqttMessage</strong>
                </div>
                <div class="payload-inspector-node-meta-item">
                    <span>Formats</span>
                    <strong>Auto detect</strong>
                </div>
            </div>

            <div class="payload-inspector-node-contracts">
                <div class="payload-inspector-node-contract" aria-label="Payload inspector input fields">
                    <span class="payload-inspector-node-contract-label">Input fields</span>
                    <span class="payload-inspector-node-token">topic</span>
                    <span class="payload-inspector-node-token">payload</span>
                    <span class="payload-inspector-node-token">qos</span>
                    <span class="payload-inspector-node-token">retain</span>
                </div>
                <div class="payload-inspector-node-contract" aria-label="Payload inspector result fields">
                    <span class="payload-inspector-node-contract-label">Result fields</span>
                    <span class="payload-inspector-node-token">kind</span>
                    <span class="payload-inspector-node-token">contentType</span>
                    <span class="payload-inspector-node-token">formatted</span>
                    <span class="payload-inspector-node-token">hexDump</span>
                </div>
            </div>
        </div>
    </Body>
</NodeWidgetShell>

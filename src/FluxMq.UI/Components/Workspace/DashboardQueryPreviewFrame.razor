@namespace FluxMq.UI.Components.Workspace

<section class="dashboard-query-preview-frame">
    <header class="dashboard-query-preview-frame-header">
        <div>
            <span>Widget preview</span>
            @if (ShowHelp)
            {
                <small>Current style and draft query</small>
            }
        </div>
        <div class="dashboard-query-preview-frame-actions">
            <span class="@BadgeClass">@DataLabel</span>
            @if (!IsLive && RefreshSample.HasDelegate)
            {
                <button type="button"
                        class="dashboard-query-preview-frame-refresh"
                        title="Refresh sample data"
                        @onclick="@RefreshSampleAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                    <span>Refresh sample</span>
                </button>
            }
        </div>
    </header>

    <div class="dashboard-query-preview-frame-widget">
        @WidgetContent
    </div>

    @if (ResultContent is not null)
    {
        <div class="dashboard-query-preview-frame-result">
            @ResultContent
        </div>
    }
</section>

@code {
    [Parameter]
    public string DataLabel { get; set; } = "Sample data";

    [Parameter]
    public bool IsLive { get; set; }

    [Parameter]
    public bool ShowHelp { get; set; } = true;

    [Parameter]
    public EventCallback RefreshSample { get; set; }

    [Parameter]
    public RenderFragment? WidgetContent { get; set; }

    [Parameter]
    public RenderFragment? ResultContent { get; set; }

    private string BadgeClass => IsLive
        ? "dashboard-query-preview-frame-badge live"
        : "dashboard-query-preview-frame-badge sample";

    private Task RefreshSampleAsync() => RefreshSample.InvokeAsync();
}

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <div class="new-app-dialog-title">
            <span class="new-app-dialog-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h6" Class="new-app-dialog-heading">New app</MudText>
            <span class="@FormStatusClass" role="status" aria-live="polite">@FormStatusText</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="new-app-dialog-content">
            <section class="new-app-dialog-section" aria-labelledby="new-app-workspace-heading">
                <div class="new-app-dialog-section-title" id="new-app-workspace-heading">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                    <span>Workspace</span>
                </div>

                <div class="new-app-dialog-grid two">
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="App name"
                                  @bind-Value="_appName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Immediate="true"
                                  Placeholder="Telemetry app"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="First pipeline"
                                  @bind-Value="_pipelineName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Immediate="true"
                                  Placeholder="ingest"
                                  OnKeyDown="@OnKeyDown" />
                </div>
            </section>

            <section class="new-app-dialog-section" aria-labelledby="new-app-connection-heading">
                <div class="new-app-dialog-section-title" id="new-app-connection-heading">
                    <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" />
                    <span>Connection</span>
                </div>

                <div class="new-app-dialog-grid connection">
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="Connection name"
                                  @bind-Value="_connName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Placeholder="local-broker"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="new-app-dialog-field wide"
                                  Label="Host"
                                  @bind-Value="_host"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Immediate="true"
                                  Placeholder="localhost"
                                  OnKeyDown="@OnKeyDown" />
                    <MudNumericField T="int"
                                     Class="new-app-dialog-field"
                                     Label="Port"
                                     @bind-Value="_port"
                                     Min="1"
                                     Max="65535"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="Client ID"
                                  @bind-Value="_clientId"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="new-app-dialog-field wide"
                                  Label="Trigger topic"
                                  @bind-Value="_subscription"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Placeholder="factory/#"
                                  OnKeyDown="@OnKeyDown" />
                </div>
            </section>

            <section class="new-app-dialog-section compact" aria-labelledby="new-app-security-heading">
                <div class="new-app-dialog-security-row">
                    <div class="new-app-dialog-section-title" id="new-app-security-heading">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        <span>Security</span>
                    </div>
                    <MudCheckBox T="bool"
                                 Class="new-app-dialog-tls"
                                 @bind-Value="_useTls"
                                 Label="TLS"
                                 Dense="true" />
                </div>

                <div class="new-app-dialog-grid two">
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="Username"
                                  @bind-Value="_username"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="new-app-dialog-field"
                                  Label="Password"
                                  @bind-Value="_password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  OnKeyDown="@OnKeyDown" />
                </div>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="new-app-dialog-actions">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       Class="new-app-dialog-cancel"
                       aria-label="Cancel new app"
                       OnClick="@Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Class="new-app-dialog-create"
                       Disabled="@(!IsValid)"
                       aria-label="Create app"
                       OnClick="@Submit">Create</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _appName = string.Empty;
    private string _pipelineName = string.Empty;

    private string _connName = "local-broker";
    private string _host = "localhost";
    private int _port = 1883;
    private string _clientId = Guid.NewGuid().ToString("N")[..8];
    private string _subscription = "#";
    private bool _useTls;
    private string? _username;
    private string? _password;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_appName) &&
        !string.IsNullOrWhiteSpace(_pipelineName) &&
        !string.IsNullOrWhiteSpace(_host) &&
        _port is >= 1 and <= 65535;

    private string FormStatusClass
        => IsValid ? "new-app-dialog-status ready" : "new-app-dialog-status";

    private string FormStatusText
        => IsValid ? "Ready" : "Required fields";

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!IsValid) return;

        var profile = new MqttConnectionProfile
        {
            Name = string.IsNullOrWhiteSpace(_connName) ? "local-broker" : _connName.Trim(),
            Host = _host.Trim(),
            Port = _port,
            ClientId = string.IsNullOrWhiteSpace(_clientId) ? Guid.NewGuid().ToString("N")[..8] : _clientId.Trim(),
            Username = string.IsNullOrWhiteSpace(_username) ? null : _username,
            Password = string.IsNullOrWhiteSpace(_password) ? null : _password,
            UseTls = _useTls,
            CleanStart = true
        };

        MudDialog.Close(DialogResult.Ok(
            new NewAppResult(_appName.Trim(), _pipelineName.Trim(), profile, _subscription)));
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Submit();
    }

    public record NewAppResult(
        string AppName,
        string PipelineName,
        MqttConnectionProfile Connection,
        string Subscription);
}

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">New App</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField T="string"
                          Label="App name"
                          @bind-Value="_appName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          HelperText="Used as the suggested filename when saving"
                          OnKeyDown="@OnKeyDown" />
            <MudTextField T="string"
                          Label="First pipeline name"
                          @bind-Value="_pipelineName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          OnKeyDown="@OnKeyDown" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(!IsValid)"
                   OnClick="@Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _appName = string.Empty;
    private string _pipelineName = string.Empty;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_appName) && !string.IsNullOrWhiteSpace(_pipelineName);

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (IsValid)
            MudDialog.Close(DialogResult.Ok(new NewAppResult(_appName.Trim(), _pipelineName.Trim())));
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") Submit();
    }

    public record NewAppResult(string AppName, string PipelineName);
}

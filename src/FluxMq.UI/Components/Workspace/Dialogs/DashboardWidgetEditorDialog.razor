@using FluxMq.UI.Models
@inject DashboardEventFilterCatalog EventFilters

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <div class="dashboard-widget-editor-title">
            <span class="dashboard-widget-editor-title-icon" aria-hidden="true">
                <MudIcon Icon="@Profile.Icon" Size="Size.Small" />
            </span>
            <div class="dashboard-widget-editor-title-copy">
                <MudText Typo="Typo.h6">@Profile.Title settings</MudText>
                <div class="dashboard-widget-editor-meta-strip" aria-label="Widget summary">
                    <span>@Widget.Name</span>
                    <span>@Widget.Type</span>
                    <span>@EditorModeLabel</span>
                    <span>@EditorDetailLabel</span>
                </div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="dashboard-widget-editor-shell" role="form" aria-label="@EditorAriaLabel">
            @if (Profile.ShowsEventTabs)
            {
                <MudTabs Elevation="0"
                         Rounded="false"
                         ApplyEffectsToContainer="true"
                         Class="dashboard-widget-editor-tabs">
                    <MudTabPanel Text="Display" Icon="@Icons.Material.Filled.DashboardCustomize">
                        <div class="dashboard-widget-editor-tab">
                            @TitleField

                            @if (Profile.UsesGaugeStyle)
                            {
                                <div class="dashboard-widget-editor-section">
                                    <div class="dashboard-widget-editor-section-head">
                                        <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />
                                        <span>Gauge style</span>
                                    </div>
                                    <MudToggleGroup T="string"
                                                    @bind-Value="_draft.GaugeStyle"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    Size="Size.Small"
                                                    Color="Color.Primary"
                                                    Outlined="true"
                                                    Delimiters="true">
                                        <MudToggleItem T="string" Value="@DashboardEventGaugeWidgetOptions.StyleRing" Text="Ring" />
                                        <MudToggleItem T="string" Value="@DashboardEventGaugeWidgetOptions.StyleMeter" Text="Meter" />
                                    </MudToggleGroup>
                                </div>
                            }

                            @if (Profile.UsesChartType)
                            {
                                <div class="dashboard-widget-editor-section">
                                    <div class="dashboard-widget-editor-section-head">
                                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" />
                                        <span>Chart type</span>
                                    </div>
                                    <MudToggleGroup T="string"
                                                    @bind-Value="_draft.ChartType"
                                                    SelectionMode="SelectionMode.SingleSelection"
                                                    Size="Size.Small"
                                                    Color="Color.Primary"
                                                    Outlined="true"
                                                    Delimiters="true">
                                        <MudToggleItem T="string" Value="@DashboardChartWidgetOptions.TypeBars" Text="Bars" />
                                        <MudToggleItem T="string" Value="@DashboardChartWidgetOptions.TypeLine" Text="Line" />
                                        <MudToggleItem T="string" Value="@DashboardChartWidgetOptions.TypeArea" Text="Area" />
                                        <MudToggleItem T="string" Value="@DashboardChartWidgetOptions.TypeTopics" Text="Topics" />
                                    </MudToggleGroup>
                                </div>
                            }

                            @if (Profile.UsesVisualMetrics)
                            {
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="6">
                                        <MudSelect T="string"
                                                   Label="Primary metric"
                                                   @bind-Value="_draft.PrimaryMetric"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true">
                                            @foreach (var option in DashboardWidgetCatalog.MetricOptions)
                                            {
                                                <MudSelectItem T="string" Value="@option.Id">@option.Label</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudNumericField T="int"
                                                         Label="Card columns"
                                                         @bind-Value="_draft.MetricCardColumns"
                                                         Min="@DashboardWidgetCatalog.MinMetricCardColumns"
                                                         Max="@DashboardWidgetCatalog.MaxMetricCardColumns"
                                                         Step="1"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>

                                <div class="dashboard-widget-editor-section">
                                    <div class="dashboard-widget-editor-section-head">
                                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />
                                        <span>Metric cards</span>
                                    </div>
                                    <div class="dashboard-widget-editor-metric-options">
                                        @foreach (var option in DashboardWidgetCatalog.MetricOptions)
                                        {
                                            var selected = _draft.IsDisplayMetricSelected(option.Id);
                                            var disabled = selected && _draft.DisplayMetrics.Count == 1;

                                            <MudCheckBox T="bool"
                                                         Value="@selected"
                                                         ValueChanged="@((bool value) => _draft.ToggleDisplayMetric(option.Id, value))"
                                                         Disabled="@disabled"
                                                         Dense="true"
                                                         Label="@option.Label" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="Data" Icon="@Icons.Material.Filled.Dataset">
                        <MudGrid Spacing="2" Class="dashboard-widget-editor-tab">
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Event type"
                                           Value="@_draft.EventType"
                                           ValueChanged="@SetEventType"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    @foreach (var option in EventFilters.EventTypes)
                                    {
                                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Status"
                                           @bind-Value="_draft.Status"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    @foreach (var option in _draft.CurrentEventType.StatusOptions)
                                    {
                                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Filters" Icon="@Icons.Material.Filled.FilterAlt">
                        <MudGrid Spacing="2" Class="dashboard-widget-editor-tab">
                            @if (_draft.CurrentEventType.Fields.Count == 0)
                            {
                                <MudItem xs="12">
                                    <div class="dashboard-widget-editor-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" />
                                        <span>No filters for this event type</span>
                                    </div>
                                </MudItem>
                            }
                            else
                            {
                                @foreach (var field in _draft.CurrentEventType.Fields)
                                {
                                    var currentField = field;
                                    <MudItem xs="12" md="@FilterFieldColumns(currentField)">
                                        @RenderFilterField(currentField)
                                    </MudItem>
                                }
                            }
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            }
            else if (Profile.IsTopicTreeWidget)
            {
                <MudStack Spacing="2" Class="dashboard-widget-editor-tab">
                    @TitleField
                    <div class="dashboard-widget-editor-section">
                        <div class="dashboard-widget-editor-section-head">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                            <span>Topic tree</span>
                        </div>
                        <MudSwitch T="bool"
                                   @bind-Value="_draft.ExcludeSystemTopics"
                                   Color="Color.Primary"
                                   Label="Hide system topics" />
                    </div>
                </MudStack>
            }
            else
            {
                <MudStack Spacing="2" Class="dashboard-widget-editor-tab">
                    @TitleField
                </MudStack>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="dashboard-widget-editor-actions">
            <div class="dashboard-widget-editor-action-status" aria-live="polite">
                <MudIcon Icon="@ActionStatusIcon" Size="Size.Small" />
                <span>@ActionStatusLabel</span>
            </div>
            <MudButton OnClick="@Reset"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@(!HasChanges)"
                       Class="dashboard-widget-editor-reset">
                Reset
            </MudButton>
            <span class="dashboard-widget-editor-action-spacer"></span>
            <MudButton OnClick="@Cancel"
                       Size="Size.Small"
                       Class="dashboard-widget-editor-cancel">
                Cancel
            </MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Check"
                       Disabled="@(!HasChanges)"
                       OnClick="@Submit"
                       Class="dashboard-widget-editor-apply">
                Apply
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private const string AnyValue = "";
    private static readonly IReadOnlyList<DashboardFilterChoice> QosFilterOptions =
    [
        new(AnyValue, "Any"),
        new("0", "0"),
        new("1", "1"),
        new("2", "2")
    ];

    private static readonly IReadOnlyList<DashboardFilterChoice> RetainFilterOptions =
    [
        new(AnyValue, "Any"),
        new("true", "True"),
        new("false", "False")
    ];

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardWidgetSnapshot Widget { get; set; } = null!;

    private DashboardWidgetSettingsDraft _draft = null!;
    private IReadOnlyDictionary<string, string> _initialConfiguration = new Dictionary<string, string>(StringComparer.Ordinal);

    private DashboardWidgetSettingsProfile Profile => _draft.Profile;

    private RenderFragment TitleField => @<MudTextField T="string"
                                                        Label="Title"
                                                        @bind-Value="_draft.Title"
                                                        Variant="Variant.Outlined"
                                                        Margin="Margin.Dense"
                                                        Class="dashboard-widget-editor-title-field" />;

    private string EditorAriaLabel => $"Edit {Profile.Title} widget {Widget.Name}";

    private string EditorModeLabel => Profile.IsTopicTreeWidget
        ? "Topic data"
        : Profile.IsEventWidget
            ? "Event data"
            : "Widget";

    private string EditorDetailLabel => Profile.UsesVisualMetrics
        ? $"{_draft.DisplayMetrics.Count} metrics"
        : Profile.UsesMetricVisualization
            ? "Metric visual"
            : Profile.UsesEventFilters
                ? $"{_draft.CurrentEventType.Fields.Count} filters"
                : "Display";

    private bool HasChanges => !ConfigurationEquals(_draft.BuildConfiguration(), _initialConfiguration);

    private string ActionStatusLabel => HasChanges ? "Unsaved changes" : "No changes";

    private string ActionStatusIcon => HasChanges
        ? Icons.Material.Filled.Edit
        : Icons.Material.Filled.CheckCircle;

    protected override void OnInitialized()
    {
        _draft = DashboardWidgetSettingsDraft.Create(Widget, EventFilters);
        _initialConfiguration = new Dictionary<string, string>(_draft.BuildConfiguration(), StringComparer.Ordinal);
    }

    private void SetEventType(string? value)
    {
        _draft.SetEventType(value);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Reset()
    {
        _draft = DashboardWidgetSettingsDraft.Create(Widget, EventFilters);
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(new DashboardWidgetUpdate(_draft.BuildConfiguration())));
    }

    private RenderFragment RenderFilterField(DashboardEventFilterFieldDescriptor field)
    {
        if (IsQosFilter(field))
        {
            return @<MudStack Spacing="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Label</MudText>
                <MudToggleGroup T="string"
                                Value="@_draft.GetFilterValue(field.Key)"
                                ValueChanged="@((string value) => _draft.SetFilterValue(field.Key, value))"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small"
                                Color="Color.Primary"
                                Outlined="true"
                                Delimiters="true">
                    @foreach (var option in QosFilterOptions)
                    {
                        <MudToggleItem T="string"
                                       Value="@option.Value"
                                       Text="@option.Label" />
                    }
                </MudToggleGroup>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@field.HelperText</MudText>
            </MudStack>;
        }

        if (IsRetainFilter(field))
        {
            return @<MudStack Spacing="1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@field.Label</MudText>
                <MudToggleGroup T="string"
                                Value="@_draft.GetFilterValue(field.Key)"
                                ValueChanged="@((string value) => _draft.SetFilterValue(field.Key, value))"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small"
                                Color="Color.Primary"
                                Outlined="true"
                                Delimiters="true">
                    @foreach (var option in RetainFilterOptions)
                    {
                        <MudToggleItem T="string"
                                       Value="@option.Value"
                                       Text="@option.Label" />
                    }
                </MudToggleGroup>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@field.HelperText</MudText>
            </MudStack>;
        }

        return @<MudTextField T="string"
                              Label="@field.Label"
                              Value="@_draft.GetFilterValue(field.Key)"
                              ValueChanged="@((string? value) => _draft.SetFilterValue(field.Key, value))"
                              Placeholder="@field.Placeholder"
                              HelperText="@field.HelperText"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />;
    }

    private static int FilterFieldColumns(DashboardEventFilterFieldDescriptor field)
        => IsQosFilter(field) || IsRetainFilter(field) ? 6 : 12;

    private static bool IsQosFilter(DashboardEventFilterFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.QosAttributeKey, StringComparison.Ordinal);

    private static bool IsRetainFilter(DashboardEventFilterFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.RetainAttributeKey, StringComparison.Ordinal);

    private static bool ConfigurationEquals(
        IReadOnlyDictionary<string, string> left,
        IReadOnlyDictionary<string, string> right)
    {
        if (left.Count != right.Count)
        {
            return false;
        }

        foreach (var (key, value) in left)
        {
            if (!right.TryGetValue(key, out var otherValue) ||
                !string.Equals(value, otherValue, StringComparison.Ordinal))
            {
                return false;
            }
        }

        return true;
    }

    public sealed record DashboardWidgetUpdate(IReadOnlyDictionary<string, string> Configuration);

    private sealed record DashboardFilterChoice(string Value, string Label);
}

@implements IDisposable
@using FluxMq.UI.Services
@inject NodeEditDialogRefreshService EditorRefresh

<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Color="@CategoryColor" Size="Size.Small" Class="me-1" />
            <div>
                <MudText Typo="Typo.h6">@NodeDisplayName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Edit settings</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value="_nodeId"
                          Label="Node ID"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Error="@(!string.IsNullOrWhiteSpace(NodeIdError))"
                          ErrorText="@NodeIdError"
                          HelperText="Key used in the pipeline definition. Must be unique within the workflow." />
            @if (EditorContent is not null)
            {
                <MudDivider />
                @EditorContent
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="@CategoryColor"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Check"
                   Disabled="@(!CanSubmit)"
                   OnClick="@Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string NodeDisplayName { get; set; } = "Node";
    [Parameter] public string NodeId { get; set; } = "";
    [Parameter] public string WorkflowName { get; set; } = "";
    [Parameter] public Color CategoryColor { get; set; } = Color.Primary;
    [Parameter] public RenderFragment? EditorContent { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public FlowWorkspaceService? Flow { get; set; }

    private string _nodeId = "";
    private string _registeredNodeId = "";

    private string? NodeIdError => ValidateNodeId(NormalizedNodeId);

    private bool CanSubmit => string.IsNullOrWhiteSpace(NodeIdError);

    private string NormalizedNodeId => _nodeId.Trim();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_nodeId))
            _nodeId = NodeId;

        if (!string.Equals(_registeredNodeId, NodeId, StringComparison.Ordinal))
        {
            if (!string.IsNullOrWhiteSpace(_registeredNodeId))
            {
                EditorRefresh.Unregister(_registeredNodeId);
            }

            _registeredNodeId = NodeId;
            EditorRefresh.Register(NodeId, RequestRenderAsync);
        }
    }

    public void Dispose()
    {
        if (!string.IsNullOrWhiteSpace(_registeredNodeId))
        {
            EditorRefresh.Unregister(_registeredNodeId);
        }
    }

    private Task RequestRenderAsync() => InvokeAsync(StateHasChanged);

    private async Task Submit()
    {
        var nextNodeId = NormalizedNodeId;
        if (!string.IsNullOrWhiteSpace(ValidateNodeId(nextNodeId)))
        {
            return;
        }

        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }

        if (Flow is not null &&
            !string.Equals(nextNodeId, NodeId, StringComparison.Ordinal))
        {
            Flow.RenameWorkflowNode(WorkflowName, NodeId, nextNodeId);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
        MudDialog.Cancel();
    }

    private string? ValidateNodeId(string nodeId)
    {
        if (string.IsNullOrWhiteSpace(nodeId))
        {
            return "Node ID is required.";
        }

        if (Flow is null ||
            string.IsNullOrWhiteSpace(WorkflowName) ||
            string.Equals(nodeId, NodeId, StringComparison.Ordinal))
        {
            return null;
        }

        return Flow.GetWorkflowNodes(WorkflowName).Any(node => string.Equals(node.Name, nodeId, StringComparison.Ordinal))
            ? "Another node already uses this ID."
            : null;
    }
}

@implements IDisposable
@using FluxMq.UI.Services
@inject NodeEditDialogRefreshService EditorRefresh

<MudDialog>
    <TitleContent>
        <div class="node-edit-dialog-title">
            <div class="node-edit-dialog-title-icon">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Color="@CategoryColor" Size="Size.Small" />
            </div>
            <div class="node-edit-dialog-title-copy">
                <MudText Typo="Typo.h6" Class="node-edit-dialog-title-name">@NodeDisplayName</MudText>
                <div class="node-edit-dialog-meta-strip">
                    <span>@NodeId</span>
                    @if (!string.IsNullOrWhiteSpace(WorkflowName))
                    {
                        <span>@WorkflowName</span>
                    }
                    <span>Editor</span>
                </div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="node-edit-dialog-shell">
            <section class="node-edit-dialog-section node-edit-dialog-identity">
                <div class="node-edit-dialog-section-head">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                    <span>Identity</span>
                </div>
                <MudTextField T="string"
                              @bind-Value="_nodeId"
                              Label="Node ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Error="@(!string.IsNullOrWhiteSpace(NodeIdError))"
                              ErrorText="@NodeIdError"
                              HelperText="Unique within workflow"
                              Class="node-edit-dialog-node-id" />
            </section>
            @if (EditorContent is not null)
            {
                <section class="node-edit-dialog-section node-edit-dialog-editor">
                    <div class="node-edit-dialog-section-head">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                        <span>Properties</span>
                    </div>
                    @EditorContent
                </section>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="node-edit-dialog-actions">
            <div class="node-edit-dialog-action-status">
                <MudIcon Icon="@SubmitStatusIcon" Color="@SubmitStatusColor" Size="Size.Small" />
                <span>@SubmitStatusText</span>
            </div>
            <span class="node-edit-dialog-action-spacer"></span>
            <MudButton OnClick="@Cancel"
                       Variant="Variant.Text"
                       Class="node-edit-dialog-button">Cancel</MudButton>
            <MudButton Color="@CategoryColor"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Check"
                       Disabled="@(!CanSubmit)"
                       OnClick="@Submit"
                       Class="node-edit-dialog-button node-edit-dialog-save">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string NodeDisplayName { get; set; } = "Node";
    [Parameter] public string NodeId { get; set; } = "";
    [Parameter] public string WorkflowName { get; set; } = "";
    [Parameter] public Color CategoryColor { get; set; } = Color.Primary;
    [Parameter] public RenderFragment? EditorContent { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public FlowWorkspaceService? Flow { get; set; }

    private string _nodeId = "";
    private string _registeredNodeId = "";

    private string? NodeIdError => ValidateNodeId(NormalizedNodeId);

    private bool CanSubmit => string.IsNullOrWhiteSpace(NodeIdError);

    private string NormalizedNodeId => _nodeId.Trim();

    private string SubmitStatusText => CanSubmit
        ? "Ready to save"
        : NodeIdError ?? "Review required";

    private string SubmitStatusIcon => CanSubmit
        ? Icons.Material.Filled.CheckCircle
        : Icons.Material.Filled.ErrorOutline;

    private Color SubmitStatusColor => CanSubmit
        ? CategoryColor
        : Color.Error;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_nodeId))
            _nodeId = NodeId;

        if (!string.Equals(_registeredNodeId, NodeId, StringComparison.Ordinal))
        {
            if (!string.IsNullOrWhiteSpace(_registeredNodeId))
            {
                EditorRefresh.Unregister(_registeredNodeId);
            }

            _registeredNodeId = NodeId;
            EditorRefresh.Register(NodeId, RequestRenderAsync);
        }
    }

    public void Dispose()
    {
        if (!string.IsNullOrWhiteSpace(_registeredNodeId))
        {
            EditorRefresh.Unregister(_registeredNodeId);
        }
    }

    private Task RequestRenderAsync() => InvokeAsync(StateHasChanged);

    private async Task Submit()
    {
        var nextNodeId = NormalizedNodeId;
        if (!string.IsNullOrWhiteSpace(ValidateNodeId(nextNodeId)))
        {
            return;
        }

        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }

        if (Flow is not null &&
            !string.Equals(nextNodeId, NodeId, StringComparison.Ordinal))
        {
            Flow.RenameWorkflowNode(WorkflowName, NodeId, nextNodeId);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
        MudDialog.Cancel();
    }

    private string? ValidateNodeId(string nodeId)
    {
        if (string.IsNullOrWhiteSpace(nodeId))
        {
            return "Node ID is required.";
        }

        if (Flow is null ||
            string.IsNullOrWhiteSpace(WorkflowName) ||
            string.Equals(nodeId, NodeId, StringComparison.Ordinal))
        {
            return null;
        }

        return Flow.GetWorkflowNodes(WorkflowName).Any(node => string.Equals(node.Name, nodeId, StringComparison.Ordinal))
            ? "Another node already uses this ID."
            : null;
    }
}

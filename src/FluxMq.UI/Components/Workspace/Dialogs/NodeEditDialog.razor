@implements IDisposable
@using FluxMq.UI.Services
@inject NodeEditDialogRefreshService EditorRefresh

<MudDialog>
    <TitleContent>
        <div class="node-edit-dialog-title">
            <MudText Typo="Typo.h6" Class="node-edit-dialog-heading">@NodeDisplayName</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="@ContentClassName" role="form" aria-label="Edit node">
            <section class="node-edit-dialog-section node-edit-dialog-identity" aria-label="Node identity">
                <MudTextField T="string"
                              @bind-Value="_nodeId"
                              Label="Node ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Error="@(!string.IsNullOrWhiteSpace(NodeIdError))"
                              OnKeyDown="@OnNodeIdKeyDown"
                              aria-label="Node ID"
                              aria-describedby="@ValidationElementId"
                              Class="node-edit-dialog-node-id" />
            </section>
            @if (EditorContent is not null)
            {
                <div class="node-edit-dialog-editor">
                    @EditorContent
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="node-edit-dialog-actions">
            @if (!CanSubmit)
            {
                <span id="node-edit-dialog-validation"
                      class="node-edit-dialog-validation-message"
                      role="status"
                      aria-live="polite">@SubmitValidationText</span>
            }
            <span class="node-edit-dialog-action-spacer"></span>
            <MudButton OnClick="@Cancel"
                       Variant="Variant.Text"
                       Size="Size.Small"
                       aria-label="Cancel node edit"
                       Class="node-edit-dialog-button">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Check"
                       Disabled="@(!CanSubmit)"
                       OnClick="@Submit"
                       aria-label="Save node edit"
                       Class="node-edit-dialog-button node-edit-dialog-save">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string NodeDisplayName { get; set; } = "Node";
    [Parameter] public string NodeId { get; set; } = "";
    [Parameter] public string WorkflowName { get; set; } = "";
    [Parameter] public string? ContentClass { get; set; }
    [Parameter] public RenderFragment? EditorContent { get; set; }
    [Parameter] public Func<string?>? EditorValidationError { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public FlowWorkspaceService? Flow { get; set; }

    private string _nodeId = "";
    private string _registeredNodeId = "";
    private string? _editorError;

    private string? NodeIdError => ValidateNodeId(NormalizedNodeId);

    private string? EditorError => _editorError;

    private string ContentClassName => string.IsNullOrWhiteSpace(ContentClass)
        ? "node-edit-dialog-content"
        : $"node-edit-dialog-content {ContentClass}";

    private bool CanSubmit => string.IsNullOrWhiteSpace(NodeIdError) &&
        string.IsNullOrWhiteSpace(EditorError);

    private string NormalizedNodeId => _nodeId.Trim();

    private string? ValidationElementId => CanSubmit ? null : "node-edit-dialog-validation";

    private string SubmitValidationText => NodeIdError ?? EditorError ?? "Review required";

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_nodeId))
            _nodeId = NodeId;

        if (!string.Equals(_registeredNodeId, NodeId, StringComparison.Ordinal))
        {
            if (!string.IsNullOrWhiteSpace(_registeredNodeId))
            {
                EditorRefresh.Unregister(_registeredNodeId);
            }

            _registeredNodeId = NodeId;
            EditorRefresh.Register(NodeId, RequestRenderAsync);
        }

        RefreshValidationState();
    }

    public void Dispose()
    {
        if (!string.IsNullOrWhiteSpace(_registeredNodeId))
        {
            EditorRefresh.Unregister(_registeredNodeId);
        }
    }

    private Task RequestRenderAsync()
        => InvokeAsync(() =>
        {
            RefreshValidationState();
            StateHasChanged();
        });

    private async Task Submit()
    {
        RefreshValidationState();
        var nextNodeId = NormalizedNodeId;
        if (!CanSubmit || !string.IsNullOrWhiteSpace(ValidateNodeId(nextNodeId)))
        {
            return;
        }

        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }

        if (Flow is not null &&
            !string.Equals(nextNodeId, NodeId, StringComparison.Ordinal))
        {
            Flow.RenameWorkflowNode(WorkflowName, NodeId, nextNodeId);
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task OnNodeIdKeyDown(KeyboardEventArgs args)
    {
        RefreshValidationState();
        if (args.Key == "Enter" && CanSubmit)
        {
            await Submit();
        }
    }

    private void RefreshValidationState()
        => _editorError = EditorValidationError?.Invoke();

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
        MudDialog.Cancel();
    }

    private string? ValidateNodeId(string nodeId)
    {
        if (string.IsNullOrWhiteSpace(nodeId))
        {
            return "Node ID is required.";
        }

        if (Flow is null ||
            string.IsNullOrWhiteSpace(WorkflowName) ||
            string.Equals(nodeId, NodeId, StringComparison.Ordinal))
        {
            return null;
        }

        return Flow.GetWorkflowNodes(WorkflowName).Any(node => string.Equals(node.Name, nodeId, StringComparison.Ordinal))
            ? "Another node already uses this ID."
            : null;
    }
}

@using FluxMq.UI.Models
@inject DashboardEventFilterCatalog EventFilters
@inject ScenarioStepCatalog ScenarioSteps

<MudDialog Options="@EditorDialogOptions">
    <TitleContent>
        <div class="scenario-step-editor-title">
            <MudIcon Icon="@StepDescriptor.Icon" Size="Size.Small" aria-hidden="true" />
            <div class="scenario-step-editor-title-copy">
                <MudText Typo="Typo.h6">@DialogTitle</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Step.Type</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="1" Class="scenario-step-editor" aria-label="@DialogTitle">
            @if (IsMqttPublish)
            {
                @if (ConnectionNames.Count > 0)
                {
                    <MudSelect T="string"
                               Label="@_connectionField.Label"
                               @bind-Value="_connection"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @foreach (var connectionName in ConnectionNames)
                        {
                            <MudSelectItem T="string" Value="@connectionName">@connectionName</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string"
                                  Label="@_connectionField.Label"
                                  @bind-Value="_connection"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                }
                <MudTextField T="string"
                              Label="@_topicField.Label"
                              @bind-Value="_topic"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudTextField T="string"
                              Label="@_payloadField.Label"
                              @bind-Value="_payload"
                              Lines="@PayloadLines"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudStack Spacing="1" Class="scenario-step-editor-toggle">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_payloadEncodingField.Label</MudText>
                    <MudToggleGroup T="string"
                                    Value="@_payloadEncoding"
                                    ValueChanged="@SetPayloadEncoding"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    Outlined="true"
                                    Delimiters="true">
                        @foreach (var option in PayloadEncodingOptions)
                        {
                            <MudToggleItem T="string"
                                           Value="@option.Value"
                                           Text="@option.Label" />
                        }
                    </MudToggleGroup>
                </MudStack>
                <MudStack Spacing="1" Class="scenario-step-editor-toggle">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_qosField.Label</MudText>
                    <MudToggleGroup T="string"
                                    Value="@_qos"
                                    ValueChanged="@SetQos"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    Outlined="true"
                                    Delimiters="true">
                        @foreach (var option in QosOptions)
                        {
                            <MudToggleItem T="string"
                                           Value="@option.Value"
                                           Text="@option.Label" />
                        }
                    </MudToggleGroup>
                </MudStack>
                <MudCheckBox T="bool"
                             Label="@_retainField.Label"
                             @bind-Value="_retain"
                             Dense="true" />
            }
            else if (IsMqttTrigger)
            {
                @if (ConnectionNames.Count > 0)
                {
                    <MudSelect T="string"
                               Label="@_connectionField.Label"
                               @bind-Value="_connection"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @foreach (var connectionName in ConnectionNames)
                        {
                            <MudSelectItem T="string" Value="@connectionName">@connectionName</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string"
                                  Label="@_connectionField.Label"
                                  @bind-Value="_connection"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                }
                <MudTextField T="string"
                              Label="@_subscriptionsField.Label"
                              @bind-Value="_subscriptions"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudStack Spacing="1" Class="scenario-step-editor-toggle">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_qosField.Label</MudText>
                    <MudToggleGroup T="string"
                                    Value="@_qos"
                                    ValueChanged="@SetQos"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    Outlined="true"
                                    Delimiters="true">
                        @foreach (var option in QosOptions)
                        {
                            <MudToggleItem T="string"
                                           Value="@option.Value"
                                           Text="@option.Label" />
                        }
                    </MudToggleGroup>
                </MudStack>
                <MudStack Row="true" Spacing="2" Class="scenario-step-editor-checks">
                    <MudCheckBox T="bool"
                                 Label="@_receiveRetainedField.Label"
                                 @bind-Value="_receiveRetained"
                                 Dense="true" />
                    <MudCheckBox T="bool"
                                 Label="@_retainAsPublishedField.Label"
                                 @bind-Value="_retainAsPublished"
                                 Dense="true" />
                </MudStack>
            }
            else if (IsDescriptorFieldEditor)
            {
                <div class="scenario-step-editor-field-grid">
                    @foreach (var field in StepDescriptor.Fields)
                    {
                        var currentField = field;
                        @if (currentField.Kind == ScenarioStepFieldKind.Select)
                        {
                            <MudSelect T="string"
                                       Label="@currentField.Label"
                                       Value="@GenericFieldValue(currentField)"
                                       ValueChanged="@((string? value) => SetGenericSelectValue(currentField, value))"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                @foreach (var option in currentField.Options)
                                {
                                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (currentField.Kind == ScenarioStepFieldKind.CheckBox)
                        {
                            <MudCheckBox T="bool"
                                         Label="@currentField.Label"
                                         Value="@GenericBoolValue(currentField)"
                                         ValueChanged="@((bool value) => SetGenericBoolValue(currentField, value))"
                                         Dense="true" />
                        }
                        else
                        {
                            <MudTextField T="string"
                                          Label="@currentField.Label"
                                          Value="@GenericFieldValue(currentField)"
                                          ValueChanged="@((string? value) => SetGenericFieldValue(currentField.Key, value))"
                                          Lines="@FieldLines(currentField)"
                                          InputType="@FieldInputType(currentField)"
                                          HelperText="@GenericFieldHelp(currentField)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        }
                    }
                </div>
            }
            else
            {
                <MudSelect T="string"
                           Label="Event type"
                           Value="@_eventType"
                           ValueChanged="@SetEventType"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    @foreach (var option in EventFilters.EventTypes)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                @foreach (var field in CurrentEventType.Fields)
                {
                    var currentField = field;
                    @if (IsQosFilter(currentField))
                    {
                        <MudStack Spacing="1" Class="scenario-step-editor-toggle">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@currentField.Label</MudText>
                            <MudToggleGroup T="string"
                                            Value="@GetFilterValue(currentField.Key)"
                                            ValueChanged="@((string value) => SetFilterValue(currentField.Key, value))"
                                            SelectionMode="SelectionMode.SingleSelection"
                                            Size="Size.Small"
                                            Color="Color.Primary"
                                            Outlined="true"
                                            Delimiters="true">
                                @foreach (var option in ExpectQosOptions)
                                {
                                    <MudToggleItem T="string"
                                                   Value="@option.Value"
                                                   Text="@option.Label" />
                                }
                            </MudToggleGroup>
                        </MudStack>
                    }
                    else if (IsRetainFilter(currentField))
                    {
                        <MudStack Spacing="1" Class="scenario-step-editor-toggle">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@currentField.Label</MudText>
                            <MudToggleGroup T="string"
                                            Value="@GetFilterValue(currentField.Key)"
                                            ValueChanged="@((string value) => SetFilterValue(currentField.Key, value))"
                                            SelectionMode="SelectionMode.SingleSelection"
                                            Size="Size.Small"
                                            Color="Color.Primary"
                                            Outlined="true"
                                            Delimiters="true">
                                @foreach (var option in ExpectRetainOptions)
                                {
                                    <MudToggleItem T="string"
                                                   Value="@option.Value"
                                                   Text="@option.Label" />
                                }
                            </MudToggleGroup>
                        </MudStack>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      Label="@currentField.Label"
                                      Value="@GetFilterValue(currentField.Key)"
                                      ValueChanged="@((string? value) => SetFilterValue(currentField.Key, value))"
                                      Placeholder="@currentField.Placeholder"
                                      HelperText="@currentField.HelperText"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    }
                }
                <MudSelect T="string"
                           Label="Status"
                           @bind-Value="_status"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    @foreach (var option in CurrentEventType.StatusOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string"
                              Label="Payload contains"
                              @bind-Value="_payloadContains"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudNumericField T="int"
                                 Label="Timeout ms"
                                 @bind-Value="_timeoutMs"
                                 Min="1"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <div class="scenario-step-editor-actions">
            @if (HasValidationIssues)
            {
                <div class="scenario-step-editor-validation invalid" role="status" aria-live="polite">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" aria-hidden="true" />
                    <span>@ValidationSummaryText</span>
                </div>
            }
            <div class="scenario-step-editor-action-buttons">
                <MudButton OnClick="@Cancel"
                           Variant="Variant.Text"
                           aria-label="Cancel step edit">Cancel</MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           aria-label="Apply step edit"
                           Disabled="@HasValidationIssues"
                           OnClick="@Submit">Apply</MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private const string AnyValue = "";

    private static readonly DialogOptions EditorDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        BackdropClick = false
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public ScenarioStepSnapshot Step { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<string> ConnectionNames { get; set; } = [];

    private string _connection = string.Empty;
    private string _topic = string.Empty;
    private string _payload = string.Empty;
    private string _payloadEncoding = string.Empty;
    private string _qos = string.Empty;
    private string _subscriptions = string.Empty;
    private bool _retain;
    private bool _receiveRetained;
    private bool _retainAsPublished;
    private readonly Dictionary<string, string> _filterValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _genericValues = new(StringComparer.Ordinal);
    private string _eventType = AnyValue;
    private string _status = AnyValue;
    private string _payloadContains = string.Empty;
    private int _timeoutMs = 5000;
    private ScenarioStepFieldDescriptor _connectionField = EmptyPublishField(ScenarioStepCatalog.ConnectionKey);
    private ScenarioStepFieldDescriptor _topicField = EmptyPublishField(ScenarioStepCatalog.TopicKey);
    private ScenarioStepFieldDescriptor _payloadField = EmptyPublishField(ScenarioStepCatalog.PayloadKey);
    private ScenarioStepFieldDescriptor _payloadEncodingField = EmptyPublishField(ScenarioStepCatalog.PayloadEncodingKey);
    private ScenarioStepFieldDescriptor _qosField = EmptyPublishField(ScenarioStepCatalog.QosKey);
    private ScenarioStepFieldDescriptor _retainField = EmptyPublishField(ScenarioStepCatalog.RetainKey);
    private ScenarioStepFieldDescriptor _subscriptionsField = EmptyPublishField(ScenarioStepCatalog.SubscriptionsKey);
    private ScenarioStepFieldDescriptor _receiveRetainedField = EmptyPublishField(ScenarioStepCatalog.ReceiveRetainedKey);
    private ScenarioStepFieldDescriptor _retainAsPublishedField = EmptyPublishField(ScenarioStepCatalog.RetainAsPublishedKey);
    private ScenarioStepFieldDescriptor _expectQosField = EmptyPublishField(ScenarioStepCatalog.QosAttributeKey);
    private ScenarioStepFieldDescriptor _expectRetainField = EmptyPublishField(ScenarioStepCatalog.RetainAttributeKey);

    private ScenarioStepDescriptor StepDescriptor => ScenarioSteps.Describe(Step.Type);

    private bool IsMqttPublish => StepDescriptor.EditorKind == ScenarioStepEditorKind.MqttPublish;

    private bool IsMqttTrigger => StepDescriptor.EditorKind == ScenarioStepEditorKind.MqttTrigger;

    private bool IsEventEditor => StepDescriptor.EditorKind == ScenarioStepEditorKind.ExpectEvent;

    private bool IsDescriptorFieldEditor => !IsMqttPublish && !IsMqttTrigger && !IsEventEditor;

    private string DialogTitle => $"{StepDescriptor.DisplayName} step";

    private DashboardEventTypeDescriptor CurrentEventType => EventFilters.Find(_eventType);

    private int PayloadLines => Math.Max(1, _payloadField.Lines);

    private IReadOnlyList<ScenarioStepFieldOption> PayloadEncodingOptions => _payloadEncodingField.Options;

    private IReadOnlyList<ScenarioStepFieldOption> QosOptions => _qosField.Options;

    private IReadOnlyList<ScenarioStepFieldOption> ExpectQosOptions => _expectQosField.Options;

    private IReadOnlyList<ScenarioStepFieldOption> ExpectRetainOptions => _expectRetainField.Options;

    private IReadOnlyList<string> ValidationMessages => BuildValidationMessages();

    private bool HasValidationIssues => ValidationMessages.Count > 0;

    private string ValidationSummaryText => ValidationMessages is { Count: > 0 } messages
        ? $"{messages.Count} {(messages.Count == 1 ? "issue" : "issues")} - {messages[0]}"
        : string.Empty;

    protected override void OnInitialized()
    {
        CacheScenarioFields();

        if (IsMqttPublish)
        {
            InitializeMqttPublish();
            return;
        }

        if (IsMqttTrigger)
        {
            InitializeMqttTrigger();
            return;
        }

        if (IsDescriptorFieldEditor)
        {
            InitializeGenericFields();
            return;
        }

        InitializeExpectEvent();
    }

    private void SetEventType(string? value)
    {
        _eventType = Normalize(value);
        TrimFiltersToEventType();
        ResetStatusWhenUnsupported();
    }

    private void SetPayloadEncoding(string value)
        => _payloadEncoding = NormalizeSelect(value, PayloadEncodingOptions);

    private void SetQos(string value)
        => _qos = NormalizeSelect(value, QosOptions);

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (HasValidationIssues)
        {
            return;
        }

        var configuration = IsMqttPublish
            ? CreateMqttPublishConfiguration()
            : IsMqttTrigger
                ? CreateMqttTriggerConfiguration()
                : IsDescriptorFieldEditor
                    ? CreateGenericConfiguration()
                    : CreateExpectEventConfiguration();

        MudDialog.Close(DialogResult.Ok(new ScenarioStepUpdate(Step.Type, configuration)));
    }

    private void InitializeMqttPublish()
    {
        _connection = Step.ReadString(ScenarioStepCatalog.ConnectionKey) ??
                      FieldDefault(_connectionField);
        _topic = Step.ReadString(ScenarioStepCatalog.TopicKey) ??
                 FieldDefault(_topicField);
        _payload = Step.ReadString(ScenarioStepCatalog.PayloadKey) ??
                   FieldDefault(_payloadField);
        _payloadEncoding = NormalizeSelect(
            Step.ReadString(ScenarioStepCatalog.PayloadEncodingKey) ??
            FieldDefault(_payloadEncodingField),
            PayloadEncodingOptions);
        _qos = NormalizeSelect(
            Step.ReadString(ScenarioStepCatalog.QosKey) ??
            FieldDefault(_qosField),
            QosOptions);
        _retain = bool.TryParse(
            Step.ReadString(ScenarioStepCatalog.RetainKey) ??
            FieldDefault(_retainField),
            out var retain) && retain;
    }

    private void InitializeExpectEvent()
    {
        _eventType = Step.ReadString(ScenarioStepCatalog.EventTypeKey) ?? AnyValue;
        foreach (var key in EventFilters.FilterKeys)
        {
            _filterValues[key] = Step.ReadString(key) ?? string.Empty;
        }

        _status = Step.ReadString(ScenarioStepCatalog.StatusKey) ?? AnyValue;
        _payloadContains = Step.ReadString(ScenarioStepCatalog.PayloadContainsKey) ?? string.Empty;
        _timeoutMs = ReadTimeout();
        TrimFiltersToEventType();
        ResetStatusWhenUnsupported();
    }

    private void InitializeMqttTrigger()
    {
        _connection = Step.ReadString(ScenarioStepCatalog.ConnectionKey) ??
                      FieldDefault(_connectionField);
        _subscriptions = Step.ReadString(ScenarioStepCatalog.SubscriptionsKey) ??
                         FieldDefault(_subscriptionsField);
        _qos = NormalizeSelect(
            Step.ReadString(ScenarioStepCatalog.QosKey) ??
            FieldDefault(_qosField),
            QosOptions);
        _receiveRetained = bool.TryParse(
            Step.ReadString(ScenarioStepCatalog.ReceiveRetainedKey) ??
            FieldDefault(_receiveRetainedField),
            out var receiveRetained) && receiveRetained;
        _retainAsPublished = !bool.TryParse(
                                  Step.ReadString(ScenarioStepCatalog.RetainAsPublishedKey) ??
                                  FieldDefault(_retainAsPublishedField),
                                  out var retainAsPublished) || retainAsPublished;
    }

    private void InitializeGenericFields()
    {
        _genericValues.Clear();
        foreach (var field in StepDescriptor.Fields)
        {
            var value = Step.ReadString(field.Key) ?? FieldDefault(field);
            _genericValues[field.Key] = field.Kind == ScenarioStepFieldKind.Select
                ? NormalizeSelect(value, field.Options)
                : Normalize(value);
        }
    }

    private Dictionary<string, string> CreateExpectEventConfiguration()
    {
        var configuration = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            [ScenarioStepCatalog.EventTypeKey] = Normalize(_eventType),
            [ScenarioStepCatalog.StatusKey] = Normalize(_status),
            [ScenarioStepCatalog.PayloadContainsKey] = Normalize(_payloadContains),
            [ScenarioStepCatalog.TimeoutMsKey] = Math.Max(1, _timeoutMs).ToString(System.Globalization.CultureInfo.InvariantCulture)
        };

        var activeFieldKeys = CurrentEventType.Fields.Select(static field => field.Key).ToHashSet(StringComparer.Ordinal);
        foreach (var key in EventFilters.FilterKeys)
        {
            configuration[key] = activeFieldKeys.Contains(key)
                ? Normalize(GetFilterValue(key))
                : string.Empty;
        }

        return configuration;
    }

    private Dictionary<string, string> CreateMqttPublishConfiguration()
    {
        var configuration = new Dictionary<string, string>(StringComparer.Ordinal);
        configuration[ScenarioStepCatalog.ConnectionKey] = Normalize(_connection);
        configuration[ScenarioStepCatalog.TopicKey] = Normalize(_topic);
        configuration[ScenarioStepCatalog.PayloadKey] = _payload ?? string.Empty;
        configuration[ScenarioStepCatalog.PayloadEncodingKey] = NormalizeSelect(
            _payloadEncoding,
            PayloadEncodingOptions);
        configuration[ScenarioStepCatalog.QosKey] = NormalizeSelect(_qos, QosOptions);
        configuration[ScenarioStepCatalog.RetainKey] = _retain ? "true" : "false";

        return configuration;
    }

    private Dictionary<string, string> CreateMqttTriggerConfiguration()
    {
        var configuration = new Dictionary<string, string>(StringComparer.Ordinal);
        configuration[ScenarioStepCatalog.ConnectionKey] = Normalize(_connection);
        configuration[ScenarioStepCatalog.SubscriptionsKey] = Normalize(_subscriptions);
        configuration[ScenarioStepCatalog.QosKey] = NormalizeSelect(_qos, QosOptions);
        configuration[ScenarioStepCatalog.ReceiveRetainedKey] = _receiveRetained ? "true" : "false";
        configuration[ScenarioStepCatalog.RetainAsPublishedKey] = _retainAsPublished ? "true" : "false";

        return configuration;
    }

    private Dictionary<string, string> CreateGenericConfiguration()
    {
        var configuration = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var field in StepDescriptor.Fields)
        {
            var value = GenericFieldValue(field);
            configuration[field.Key] = field.Kind == ScenarioStepFieldKind.Select
                ? NormalizeSelect(value, field.Options)
                : Normalize(value);
        }

        return configuration;
    }

    private string GetFilterValue(string key)
        => _filterValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetFilterValue(string key, string? value)
        => _filterValues[key] = Normalize(value);

    private string GenericFieldValue(ScenarioStepFieldDescriptor field)
        => _genericValues.TryGetValue(field.Key, out var value)
            ? value
            : FieldDefault(field);

    private bool GenericBoolValue(ScenarioStepFieldDescriptor field)
        => bool.TryParse(GenericFieldValue(field), out var value) && value;

    private void SetGenericFieldValue(string key, string? value)
        => _genericValues[key] = Normalize(value);

    private void SetGenericSelectValue(ScenarioStepFieldDescriptor field, string? value)
        => _genericValues[field.Key] = NormalizeSelect(value, field.Options);

    private void SetGenericBoolValue(ScenarioStepFieldDescriptor field, bool value)
        => _genericValues[field.Key] = value ? "true" : "false";

    private static bool IsQosFilter(DashboardEventFilterFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.QosAttributeKey, StringComparison.Ordinal);

    private static bool IsRetainFilter(DashboardEventFilterFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.RetainAttributeKey, StringComparison.Ordinal);

    private void TrimFiltersToEventType()
    {
        var activeFieldKeys = CurrentEventType.Fields.Select(static field => field.Key).ToHashSet(StringComparer.Ordinal);
        foreach (var key in EventFilters.FilterKeys.Where(key => !activeFieldKeys.Contains(key)))
        {
            _filterValues[key] = string.Empty;
        }
    }

    private void ResetStatusWhenUnsupported()
    {
        if (!CurrentEventType.StatusOptions.Any(option => string.Equals(option.Value, _status, StringComparison.Ordinal)))
        {
            _status = AnyValue;
        }
    }

    private static string Normalize(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private void CacheScenarioFields()
    {
        _connectionField = StepField(ScenarioStepCatalog.ConnectionKey);
        _topicField = StepField(ScenarioStepCatalog.TopicKey);
        _payloadField = StepField(ScenarioStepCatalog.PayloadKey);
        _payloadEncodingField = StepField(ScenarioStepCatalog.PayloadEncodingKey);
        _qosField = StepField(ScenarioStepCatalog.QosKey);
        _retainField = StepField(ScenarioStepCatalog.RetainKey);
        _subscriptionsField = StepField(ScenarioStepCatalog.SubscriptionsKey);
        _receiveRetainedField = StepField(ScenarioStepCatalog.ReceiveRetainedKey);
        _retainAsPublishedField = StepField(ScenarioStepCatalog.RetainAsPublishedKey);
        _expectQosField = StepField(ScenarioStepCatalog.QosAttributeKey);
        _expectRetainField = StepField(ScenarioStepCatalog.RetainAttributeKey);
    }

    private ScenarioStepFieldDescriptor StepField(string key)
        => StepDescriptor.Fields.FirstOrDefault(field => string.Equals(field.Key, key, StringComparison.Ordinal)) ??
           EmptyPublishField(key);

    private static ScenarioStepFieldDescriptor EmptyPublishField(string key)
        => new(key, key, ScenarioStepFieldKind.Text, string.Empty, []);

    private string FieldDefault(ScenarioStepFieldDescriptor field)
        => field.Kind == ScenarioStepFieldKind.Connection && ConnectionNames.Count > 0
            ? ConnectionNames[0]
            : field.DefaultValue;

    private int ReadTimeout()
    {
        var value = Step.ReadString(ScenarioStepCatalog.TimeoutMsKey);
        return int.TryParse(value, out var timeout) && timeout > 0 ? timeout : 5000;
    }

    private static int FieldLines(ScenarioStepFieldDescriptor field)
        => field.Kind == ScenarioStepFieldKind.MultilineText ? Math.Max(2, field.Lines) : 1;

    private static InputType FieldInputType(ScenarioStepFieldDescriptor field)
        => IsIntegerField(field) || IsNumberField(field) ? InputType.Number : InputType.Text;

    private static string? GenericFieldHelp(ScenarioStepFieldDescriptor field)
    {
        if (IsIntegerField(field))
        {
            return "Use whole milliseconds, 0 or greater.";
        }

        return IsNumberField(field) ? "Use a numeric threshold." : null;
    }

    private IReadOnlyList<string> BuildValidationMessages()
    {
        var messages = new List<string>();

        if (IsMqttPublish)
        {
            AddRequiredMessage(messages, _connectionField.Label, _connection);
            AddRequiredMessage(messages, _topicField.Label, _topic);
            return messages;
        }

        if (IsMqttTrigger)
        {
            AddRequiredMessage(messages, _connectionField.Label, _connection);
            AddRequiredMessage(messages, _subscriptionsField.Label, _subscriptions);
            return messages;
        }

        if (IsDescriptorFieldEditor)
        {
            foreach (var field in StepDescriptor.Fields)
            {
                var value = GenericFieldValue(field);
                if (IsIntegerField(field) &&
                    (!int.TryParse(value, out var integer) || integer < GenericMinimumInteger(field)))
                {
                    messages.Add($"{field.Label} must be {GenericMinimumInteger(field)} or greater.");
                }
                else if (IsNumberField(field) &&
                         !double.TryParse(
                             value,
                             System.Globalization.NumberStyles.Float,
                             System.Globalization.CultureInfo.InvariantCulture,
                             out _))
                {
                    messages.Add($"{field.Label} must be a number.");
                }
            }

            return messages;
        }

        if (_timeoutMs < 1)
        {
            messages.Add("Timeout must be 1 ms or greater.");
        }

        return messages;
    }

    private static void AddRequiredMessage(ICollection<string> messages, string label, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            messages.Add($"{label} is required.");
        }
    }

    private static bool IsIntegerField(ScenarioStepFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.DelayMsKey, StringComparison.Ordinal) ||
           string.Equals(field.Key, ScenarioStepCatalog.WindowMsKey, StringComparison.Ordinal);

    private static int GenericMinimumInteger(ScenarioStepFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.WindowMsKey, StringComparison.Ordinal) ? 1 : 0;

    private static bool IsNumberField(ScenarioStepFieldDescriptor field)
        => string.Equals(field.Key, ScenarioStepCatalog.ThresholdKey, StringComparison.Ordinal);

    private static string NormalizeSelect(string? value, IReadOnlyList<ScenarioStepFieldOption> options)
    {
        var normalized = Normalize(value);
        if (options.Count == 0)
        {
            return normalized;
        }

        if (options.Any(option => string.Equals(option.Value, normalized, StringComparison.Ordinal)))
        {
            return normalized;
        }

        return options[0].Value;
    }

    public sealed record ScenarioStepUpdate(string Type, IReadOnlyDictionary<string, string> Configuration);
}

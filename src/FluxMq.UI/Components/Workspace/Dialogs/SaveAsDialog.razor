<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" Label="File path" @bind-Value="_path"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="@HelperText" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Submit">@SubmitText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string SuggestedPath { get; set; } = string.Empty;
    [Parameter] public string DialogTitle { get; set; } = "Save As";
    [Parameter] public string HelperText { get; set; } = "Full path including .json extension";
    [Parameter] public string SubmitText { get; set; } = "Save";

    private string _path = string.Empty;

    protected override void OnParametersSet() => _path = SuggestedPath;

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(_path));
}

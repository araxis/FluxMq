<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <div class="add-connection-dialog-title">
            <span class="add-connection-dialog-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h6" Class="add-connection-dialog-heading">New connection</MudText>
            <span class="@FormStatusClass" role="status" aria-live="polite">@FormStatusText</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="add-connection-dialog-content">
            <section class="add-connection-dialog-section" aria-labelledby="add-connection-broker-heading">
                <div class="add-connection-dialog-section-title" id="add-connection-broker-heading">
                    <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                    <span>Broker</span>
                </div>

                <div class="add-connection-dialog-grid broker">
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Broker name"
                                  @bind-Value="_name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Placeholder="local-broker"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Client ID"
                                  @bind-Value="_clientId"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Host"
                                  @bind-Value="_host"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Immediate="true"
                                  Placeholder="localhost"
                                  OnKeyDown="@OnKeyDown" />
                    <MudNumericField T="int"
                                     Class="add-connection-dialog-field"
                                     Label="Port"
                                     @bind-Value="_port"
                                     Min="1"
                                     Max="65535"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                    <MudNumericField T="int"
                                     Class="add-connection-dialog-field"
                                     Label="Keep alive seconds"
                                     @bind-Value="_keepAliveSeconds"
                                     Min="1"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                    <div class="add-connection-dialog-checkbox-cell">
                        <MudCheckBox T="bool"
                                     Class="add-connection-dialog-checkbox"
                                     @bind-Value="_cleanStart"
                                     Label="Clean start"
                                     Dense="true" />
                    </div>
                </div>
            </section>

            <section class="add-connection-dialog-section compact" aria-labelledby="add-connection-security-heading">
                <div class="add-connection-dialog-section-title" id="add-connection-security-heading">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                    <span>Security</span>
                </div>

                <div class="add-connection-dialog-grid two">
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Username"
                                  @bind-Value="_username"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  OnKeyDown="@OnKeyDown" />
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Password"
                                  @bind-Value="_password"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  OnKeyDown="@OnKeyDown" />
                    <div class="add-connection-dialog-checkbox-cell">
                        <MudCheckBox T="bool"
                                     Class="add-connection-dialog-checkbox"
                                     @bind-Value="_useTls"
                                     Label="Use TLS"
                                     Dense="true" />
                    </div>
                    <div class="add-connection-dialog-checkbox-cell">
                        <MudCheckBox T="bool"
                                     Class="add-connection-dialog-checkbox"
                                     @bind-Value="_allowUntrustedCertificates"
                                     Label="Allow untrusted certificate"
                                     Dense="true"
                                     Disabled="@(!_useTls)" />
                    </div>
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="CA certificate path"
                                  @bind-Value="_caCertificatePath"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="@(!_useTls)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                                  AdornmentColor="Color.Info"
                                  AdornmentAriaLabel="Select CA certificate"
                                  OnAdornmentClick="@(() => PickCertificateFileAsync(CertificateFileTarget.Ca))" />
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Client certificate path"
                                  @bind-Value="_clientCertificatePath"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="@(!_useTls)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                                  AdornmentColor="Color.Info"
                                  AdornmentAriaLabel="Select client certificate"
                                  OnAdornmentClick="@(() => PickCertificateFileAsync(CertificateFileTarget.Client))" />
                    <MudTextField T="string"
                                  Class="add-connection-dialog-field"
                                  Label="Client certificate password"
                                  @bind-Value="_clientCertificatePassword"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="@(!_useTls)"
                                  OnKeyDown="@OnKeyDown" />
                </div>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="add-connection-dialog-actions">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       Class="add-connection-dialog-cancel"
                       aria-label="Cancel new connection"
                       OnClick="@Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Class="add-connection-dialog-add"
                       Disabled="@(!IsValid)"
                       aria-label="Add connection"
                       OnClick="@Submit">Add</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _name = "local-broker";
    private string _host = "localhost";
    private int _port = 1883;
    private string _clientId = Guid.NewGuid().ToString("N")[..8];
    private int _keepAliveSeconds = 60;
    private bool _cleanStart = true;
    private bool _useTls;
    private bool _allowUntrustedCertificates;
    private string _caCertificatePath = string.Empty;
    private string _clientCertificatePath = string.Empty;
    private string _clientCertificatePassword = string.Empty;
    private string? _username;
    private string? _password;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_host) &&
        _port is >= 1 and <= 65535 &&
        _keepAliveSeconds > 0;

    private string FormStatusClass
        => IsValid ? "add-connection-dialog-status ready" : "add-connection-dialog-status";

    private string FormStatusText
        => string.IsNullOrWhiteSpace(_host)
            ? "Host required"
            : _port is < 1 or > 65535
                ? "Port range"
                : _keepAliveSeconds < 1
                    ? "Keep alive range"
                    : "Ready";

    private void Cancel() => MudDialog.Cancel();

    private async Task PickCertificateFileAsync(CertificateFileTarget target)
    {
        var result = await FilePicker.Default.PickAsync(CertificatePickOptions(target));
        if (result is null)
        {
            return;
        }

        var path = string.IsNullOrWhiteSpace(result.FullPath)
            ? result.FileName
            : result.FullPath;

        if (target == CertificateFileTarget.Ca)
        {
            _caCertificatePath = path;
        }
        else
        {
            _clientCertificatePath = path;
        }
    }

    private static PickOptions CertificatePickOptions(CertificateFileTarget target)
        => new()
        {
            PickerTitle = target == CertificateFileTarget.Ca
                ? "Select CA Certificate"
                : "Select Client Certificate",
            FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, [".pem", ".crt", ".cer", ".pfx", ".p12"] },
                { DevicePlatform.macOS, ["public.data"] }
            })
        };

    private void Submit()
    {
        if (!IsValid)
        {
            return;
        }

        var profile = new MqttConnectionProfile
        {
            Name = string.IsNullOrWhiteSpace(_name) ? "local-broker" : _name.Trim(),
            Host = string.IsNullOrWhiteSpace(_host) ? "localhost" : _host.Trim(),
            Port = _port,
            ClientId = string.IsNullOrWhiteSpace(_clientId) ? Guid.NewGuid().ToString("N")[..8] : _clientId.Trim(),
            Username = string.IsNullOrWhiteSpace(_username) ? null : _username,
            Password = string.IsNullOrWhiteSpace(_password) ? null : _password,
            UseTls = _useTls,
            AllowUntrustedCertificates = _useTls && _allowUntrustedCertificates,
            CaCertificatePath = _useTls ? NullIfWhiteSpace(_caCertificatePath) : null,
            ClientCertificatePath = _useTls ? NullIfWhiteSpace(_clientCertificatePath) : null,
            ClientCertificatePassword = _useTls ? NullIfWhiteSpace(_clientCertificatePassword) : null,
            KeepAlive = TimeSpan.FromSeconds(_keepAliveSeconds),
            CleanStart = _cleanStart
        };
        MudDialog.Close(DialogResult.Ok(new AddConnectionResult(
            profile,
            LiveMqttWorkspaceService.DefaultBrokerMonitorSubscription)));
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit();
        }
    }

    private static string? NullIfWhiteSpace(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private enum CertificateFileTarget
    {
        Ca,
        Client
    }

    public record AddConnectionResult(MqttConnectionProfile Profile, string Subscription);
}

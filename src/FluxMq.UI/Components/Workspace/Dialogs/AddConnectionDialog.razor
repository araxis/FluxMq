@inject IDialogService DialogService

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">New Connection</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField T="string" Label="Name" @bind-Value="_name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" Label="Host" @bind-Value="_host" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField T="int" Label="Port" @bind-Value="_port" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" Label="Client ID" @bind-Value="_clientId" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudCheckBox T="bool" @bind-Value="_useTls" Label="TLS" Dense="true" />
            <MudTextField T="string" Label="Username" @bind-Value="_username" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" Label="Password" @bind-Value="_password"
                          InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Submit">Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _name = "local-broker";
    private string _host = "localhost";
    private int _port = 1883;
    private string _clientId = Guid.NewGuid().ToString("N")[..8];
    private bool _useTls;
    private string? _username;
    private string? _password;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var profile = new MqttConnectionProfile
        {
            Name = string.IsNullOrWhiteSpace(_name) ? "local-broker" : _name.Trim(),
            Host = string.IsNullOrWhiteSpace(_host) ? "localhost" : _host.Trim(),
            Port = _port,
            ClientId = string.IsNullOrWhiteSpace(_clientId) ? Guid.NewGuid().ToString("N")[..8] : _clientId.Trim(),
            Username = string.IsNullOrWhiteSpace(_username) ? null : _username,
            Password = string.IsNullOrWhiteSpace(_password) ? null : _password,
            UseTls = _useTls,
            CleanStart = true
        };
        MudDialog.Close(DialogResult.Ok(new AddConnectionResult(
            profile,
            LiveMqttWorkspaceService.DefaultBrokerMonitorSubscription)));
    }

    public record AddConnectionResult(MqttConnectionProfile Profile, string Subscription);
}

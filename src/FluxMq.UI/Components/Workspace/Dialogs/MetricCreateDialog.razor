@using FluxMq.App.Metrics

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <div class="metric-create-title">
            <span class="metric-create-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" aria-hidden="true" />
            </span>
            <span class="metric-create-title-copy">
                <strong>New metric</strong>
                <small>Choose type and defaults</small>
            </span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="metric-create-dialog" role="form" aria-label="Create metric">
            <div class="metric-create-topbar">
                <label class="metric-create-search" role="search">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" aria-hidden="true" />
                    <input value="@_search"
                           placeholder="Search metric types"
                           aria-label="Search metric types"
                           @oninput="@OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button"
                                title="Clear search"
                                aria-label="Clear search"
                                @onclick="@ClearSearch">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                        </button>
                    }
                </label>
                <span class="metric-create-count" role="status" aria-live="polite">@FilteredDescriptors.Count of @SortedDescriptors.Count types</span>
            </div>

            <div class="metric-create-layout">
                <div class="metric-create-type-list" role="listbox" aria-label="Metric type">
                    @foreach (var descriptor in FilteredDescriptors)
                    {
                        var current = descriptor;
                        <button type="button"
                                class="@TypeButtonClass(current)"
                                role="option"
                                aria-selected="@IsSelected(current)"
                                title="@current.Description"
                                @onclick="@(() => SelectDescriptor(current))">
                            <span class="metric-create-type-icon">
                                <MudIcon Icon="@IconFor(current)" Size="Size.Small" aria-hidden="true" />
                            </span>
                            <span>
                                <strong>@current.DisplayName</strong>
                                <small>@current.TypeId</small>
                            </span>
                            <em>@current.ValueKind</em>
                        </button>
                    }

                    @if (FilteredDescriptors.Count == 0)
                    {
                        <div class="metric-create-empty">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" aria-hidden="true" />
                            <span>No metric types match your search</span>
                        </div>
                    }
                </div>

                <div class="metric-create-details">
                    @if (SelectedDescriptor is { } selectedDescriptor)
                    {
                        <div class="metric-create-selected">
                            <span class="metric-create-selected-icon">
                                <MudIcon Icon="@IconFor(selectedDescriptor)" Size="Size.Small" aria-hidden="true" />
                            </span>
                            <div>
                                <strong>@selectedDescriptor.DisplayName</strong>
                                <span>@selectedDescriptor.Description</span>
                            </div>
                        </div>

                        <label class="metric-create-name-field">
                            <span>Metric name</span>
                            <input value="@_name"
                                   aria-label="Metric name"
                                   aria-invalid="@(!CanCreate)"
                                   autocomplete="off"
                                   spellcheck="false"
                                   @oninput="@OnNameInput"
                                   @onkeydown="@OnKeyDown" />
                        </label>

                        <div class="metric-create-resource-id">
                            <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" aria-hidden="true" />
                            <span>@MetricIdPreview</span>
                        </div>

                        <div class="metric-create-meta">
                            <span>@selectedDescriptor.ValueKind</span>
                            <span>@(string.IsNullOrWhiteSpace(selectedDescriptor.Unit) ? "unitless" : selectedDescriptor.Unit)</span>
                            <span>@ParameterCountText(selectedDescriptor)</span>
                        </div>

                        @if (DefaultParameterPreview.Count > 0)
                        {
                            <div class="metric-create-defaults">
                                <div class="metric-create-section-label">Defaults</div>
                                @foreach (var parameter in DefaultParameterPreview)
                                {
                                    <div class="metric-create-default-row">
                                        <span>@parameter.Key</span>
                                        <strong>@parameter.Value</strong>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="metric-create-empty-defaults">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" aria-hidden="true" />
                                <span>This type has no parameters.</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="metric-create-actions">
            <MudButton OnClick="@Cancel"
                       Size="Size.Small"
                       aria-label="Cancel metric creation">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!CanCreate)"
                       aria-label="Create metric"
                       OnClick="@Submit">Create metric</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public IReadOnlyList<MetricDescriptor> Descriptors { get; set; } = [];

    [Parameter] public IReadOnlyList<string> ExistingMetricIds { get; set; } = [];

    private string _search = string.Empty;
    private string _name = string.Empty;
    private string? _selectedTypeId;
    private bool _initialized;

    private IReadOnlyList<MetricDescriptor> SortedDescriptors =>
        [.. Descriptors.OrderBy(static descriptor => descriptor.DisplayName, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<MetricDescriptor> FilteredDescriptors =>
        [
            .. SortedDescriptors.Where(descriptor =>
                string.IsNullOrWhiteSpace(_search) ||
                descriptor.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                descriptor.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                descriptor.TypeId.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ];

    private MetricDescriptor? SelectedDescriptor =>
        SortedDescriptors.FirstOrDefault(descriptor => string.Equals(descriptor.TypeId, _selectedTypeId, StringComparison.Ordinal));

    private bool CanCreate => SelectedDescriptor is not null && !string.IsNullOrWhiteSpace(_name);

    private string MetricIdPreview => MetricDesignerState.UniqueMetricId(_name, ExistingMetricIds);

    private IReadOnlyList<KeyValuePair<string, string>> DefaultParameterPreview =>
        SelectedDescriptor is { } descriptor
            ? [.. MetricDesignerState.DefaultParameters(descriptor)]
            : [];

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        if (SortedDescriptors.FirstOrDefault() is { } descriptor)
        {
            _selectedTypeId = descriptor.TypeId;
            _name = descriptor.DisplayName;
        }
    }

    private void SelectDescriptor(MetricDescriptor descriptor)
    {
        var previous = SelectedDescriptor?.DisplayName;
        _selectedTypeId = descriptor.TypeId;
        if (string.IsNullOrWhiteSpace(_name) ||
            string.Equals(_name, previous, StringComparison.Ordinal))
        {
            _name = descriptor.DisplayName;
        }
    }

    private bool IsSelected(MetricDescriptor descriptor)
        => string.Equals(descriptor.TypeId, _selectedTypeId, StringComparison.Ordinal);

    private string TypeButtonClass(MetricDescriptor descriptor)
        => IsSelected(descriptor) ? "metric-create-type selected" : "metric-create-type";

    private static string IconFor(MetricDescriptor descriptor)
        => descriptor.ValueKind == MetricValueKind.Double
            ? Icons.Material.Filled.Speed
            : Icons.Material.Filled.QueryStats;

    private static string ParameterCountText(MetricDescriptor descriptor)
        => descriptor.Parameters.Count == 1 ? "1 parameter" : $"{descriptor.Parameters.Count} parameters";

    private void Cancel() => MudDialog.Cancel();

    private void OnSearchInput(ChangeEventArgs args)
        => _search = args.Value?.ToString() ?? string.Empty;

    private void ClearSearch()
        => _search = string.Empty;

    private void OnNameInput(ChangeEventArgs args)
        => _name = args.Value?.ToString() ?? string.Empty;

    private void Submit()
    {
        if (!CanCreate || SelectedDescriptor is not { } descriptor)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new MetricCreateResult(
            MetricIdPreview,
            descriptor.TypeId,
            _name.Trim(),
            new Dictionary<string, string>(MetricDesignerState.DefaultParameters(descriptor), StringComparer.Ordinal))));
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit();
        }
    }

    public sealed record MetricCreateResult(
        string MetricId,
        string TypeId,
        string DisplayName,
        Dictionary<string, string> Parameters);
}

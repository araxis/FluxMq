@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="scenario-report-title">
            <div class="scenario-report-title-main">
                <span class="scenario-report-title-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" />
                </span>
                <div class="scenario-report-title-copy">
                    <MudText Typo="Typo.h6" Class="scenario-report-heading">@Title</MudText>
                    <div class="scenario-report-meta-strip" aria-label="Scenario report summary">
                        @if (!string.IsNullOrWhiteSpace(RunScopeText))
                        {
                            <span class="@ReportMetaClass(RunScopeColor)">
                                <MudIcon Icon="@RunScopeIcon" Size="Size.Small" />
                                <span>@RunScopeText</span>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(RunStatusText))
                        {
                            <span class="@ReportMetaClass(RunStatusColor)">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                                <span>@RunStatusText</span>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(RunStepSummaryText))
                        {
                            <span>
                                <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" />
                                <span>@RunStepSummaryText</span>
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="scenario-report-toolbar" aria-label="Scenario report actions">
                <span class="@ExportStateClass" title="@ExportStateTooltip">
                    <MudIcon Icon="@ExportStateIcon" Size="Size.Small" />
                    <span>@ExportStateText</span>
                </span>
                <div class="scenario-report-action-group compact" aria-label="Scenario report export actions">
                    <div class="scenario-report-action-cluster">
                        <span class="scenario-report-action-label">Summary</span>
                        <MudTooltip Text="@CopySummaryTooltip">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Class="scenario-report-action"
                                           Disabled="@(!HasSummaryReport)"
                                           OnClick="@CopySummaryAsync"
                                           aria-label="Copy summary report" />
                        </MudTooltip>
                        <MudTooltip Text="@SaveSummaryTooltip">
                            <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                           Size="Size.Small"
                                           Class="scenario-report-action"
                                           Disabled="@(!HasSummaryReport)"
                                           OnClick="@SaveSummary"
                                           aria-label="Save summary report" />
                        </MudTooltip>
                    </div>
                    <div class="scenario-report-action-cluster">
                        <span class="scenario-report-action-label">JSON</span>
                        <MudTooltip Text="@CopyJsonTooltip">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Class="scenario-report-action"
                                           Disabled="@(!HasJsonReport)"
                                           OnClick="@CopyJsonAsync"
                                           aria-label="Copy JSON report" />
                        </MudTooltip>
                        <MudTooltip Text="@SaveJsonTooltip">
                            <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                           Size="Size.Small"
                                           Class="scenario-report-action"
                                           Disabled="@(!HasJsonReport)"
                                           OnClick="@SaveJson"
                                           aria-label="Save JSON report" />
                        </MudTooltip>
                    </div>
                </div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="scenario-report-content">
            <div class="scenario-report-summary-grid" aria-label="Run details">
                @if (!string.IsNullOrWhiteSpace(RunIdText))
                {
                    <div class="scenario-report-metric">
                        <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />
                        <span>Run</span>
                        <strong>@RunIdText</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(RunFinishedAtText))
                {
                    <div class="scenario-report-metric">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        <span>Finished</span>
                        <strong>@RunFinishedAtText</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(RunDurationText))
                {
                    <div class="scenario-report-metric">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                        <span>Duration</span>
                        <strong>@RunDurationText</strong>
                    </div>
                }
                <div class="@IssueMetricClass">
                    <MudIcon Icon="@IssueIcon" Size="Size.Small" />
                    <span>Issue</span>
                    <strong>@IssueText</strong>
                </div>
            </div>

            <MudTabs Elevation="0" Class="scenario-report-tabs">
                <MudTabPanel Text="Summary">
                    <div class="scenario-report-viewer" aria-label="Text report">
                        @if (HasSummaryReport)
                        {
                            <pre>@TextReport</pre>
                        }
                        else
                        {
                            <div class="scenario-report-empty" role="status">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Medium" />
                                <strong>No summary report</strong>
                                <span>This run did not include a text summary.</span>
                            </div>
                        }
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="JSON">
                    <div class="scenario-report-viewer" aria-label="JSON report">
                        @if (HasJsonReport)
                        {
                            <pre>@JsonReport</pre>
                        }
                        else
                        {
                            <div class="scenario-report-empty" role="status">
                                <MudIcon Icon="@Icons.Material.Filled.DataObject" Size="Size.Medium" />
                                <strong>No JSON report</strong>
                                <span>This run did not include a JSON payload.</span>
                            </div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="scenario-report-actions">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Class="scenario-report-close"
                       OnClick="@Close">Close</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title { get; set; } = "Scenario report";
    [Parameter] public string RunScopeText { get; set; } = string.Empty;
    [Parameter] public string RunScopeIcon { get; set; } = Icons.Material.Filled.Schedule;
    [Parameter] public Color RunScopeColor { get; set; } = Color.Default;
    [Parameter] public string RunIdText { get; set; } = string.Empty;
    [Parameter] public string RunStatusText { get; set; } = string.Empty;
    [Parameter] public Color RunStatusColor { get; set; } = Color.Default;
    [Parameter] public string RunStepSummaryText { get; set; } = string.Empty;
    [Parameter] public string RunIssueText { get; set; } = string.Empty;
    [Parameter] public Color RunIssueColor { get; set; } = Color.Default;
    [Parameter] public string RunFinishedAtText { get; set; } = string.Empty;
    [Parameter] public string RunDurationText { get; set; } = string.Empty;
    [Parameter] public string TextReport { get; set; } = string.Empty;
    [Parameter] public string JsonReport { get; set; } = string.Empty;

    private string IssueText
        => string.IsNullOrWhiteSpace(RunIssueText) ? "No issues" : RunIssueText;

    private string IssueIcon
        => string.IsNullOrWhiteSpace(RunIssueText)
            ? Icons.Material.Filled.CheckCircle
            : Icons.Material.Filled.ReportProblem;

    private string IssueMetricClass
        => string.IsNullOrWhiteSpace(RunIssueText)
            ? "scenario-report-metric success"
            : ReportMetricClass(RunIssueColor);

    private bool HasSummaryReport => !string.IsNullOrWhiteSpace(TextReport);

    private bool HasJsonReport => !string.IsNullOrWhiteSpace(JsonReport);

    private int AvailableReportFormatCount
        => (HasSummaryReport ? 1 : 0) + (HasJsonReport ? 1 : 0);

    private string ExportStateClass
        => AvailableReportFormatCount == 0
            ? "scenario-report-export-state empty"
            : "scenario-report-export-state ready";

    private string ExportStateIcon
        => AvailableReportFormatCount == 0
            ? Icons.Material.Filled.ErrorOutline
            : Icons.Material.Filled.IosShare;

    private string ExportStateText
        => AvailableReportFormatCount switch
        {
            2 => "2 formats ready",
            1 => "1 format ready",
            _ => "No export content"
        };

    private string ExportStateTooltip
        => AvailableReportFormatCount == 0
            ? "No report content is available to copy or save."
            : "Copy or save the available report formats.";

    private string CopySummaryTooltip
        => HasSummaryReport ? "Copy summary report" : "Summary report unavailable";

    private string SaveSummaryTooltip
        => HasSummaryReport ? "Save summary report" : "Summary report unavailable";

    private string CopyJsonTooltip
        => HasJsonReport ? "Copy JSON report" : "JSON report unavailable";

    private string SaveJsonTooltip
        => HasJsonReport ? "Save JSON report" : "JSON report unavailable";

    public enum ReportDialogAction
    {
        SaveSummary,
        SaveJson
    }

    private async Task CopySummaryAsync()
    {
        if (!HasSummaryReport)
        {
            Snackbar.Add("No scenario summary to copy", Severity.Warning);
            return;
        }

        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(TextReport);
        Snackbar.Add("Scenario report summary copied", Severity.Success);
    }

    private async Task CopyJsonAsync()
    {
        if (!HasJsonReport)
        {
            Snackbar.Add("No scenario report JSON to copy", Severity.Warning);
            return;
        }

        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(JsonReport);
        Snackbar.Add("Scenario report JSON copied", Severity.Success);
    }

    private static string ReportMetaClass(Color color)
        => color switch
        {
            Color.Success => "success",
            Color.Error => "danger",
            Color.Warning => "warning",
            Color.Info => "info",
            Color.Primary => "accent",
            _ => string.Empty
        };

    private static string ReportMetricClass(Color color)
        => string.IsNullOrWhiteSpace(ReportMetaClass(color))
            ? "scenario-report-metric"
            : $"scenario-report-metric {ReportMetaClass(color)}";

    private void SaveJson()
    {
        if (!HasJsonReport)
        {
            Snackbar.Add("No scenario report JSON to save", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(ReportDialogAction.SaveJson));
    }

    private void SaveSummary()
    {
        if (!HasSummaryReport)
        {
            Snackbar.Add("No scenario summary to save", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(ReportDialogAction.SaveSummary));
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}

<MudDialog Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <div class="new-pipeline-dialog-title">
            <span class="new-pipeline-dialog-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h6" Class="new-pipeline-dialog-heading">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="new-pipeline-dialog-content">
            <section class="new-pipeline-dialog-section" aria-label="@Title">
                <MudTextField T="string"
                              Class="new-pipeline-dialog-field"
                              Label="@Label"
                              @bind-Value="_name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              Immediate="true"
                              Placeholder="@PlaceholderText"
                              OnKeyDown="@OnKeyDown" />
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="new-pipeline-dialog-actions">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       Class="new-pipeline-dialog-cancel"
                       aria-label="@CancelAriaLabel"
                       OnClick="@Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Class="new-pipeline-dialog-submit"
                       Disabled="@(!IsValid)"
                       aria-label="@SubmitAriaLabel"
                       OnClick="@Submit">@ActionText</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "New Pipeline";
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string ActionText { get; set; } = "Create";

    private string _name = string.Empty;

    private bool IsValid => !string.IsNullOrWhiteSpace(_name);

    private string PlaceholderText
        => Label.Equals("Name", StringComparison.OrdinalIgnoreCase) ? "Name" : Label;

    private string CancelAriaLabel => $"Cancel {Title}";

    private string SubmitAriaLabel => $"{ActionText} {Title}";

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (IsValid)
        {
            MudDialog.Close(DialogResult.Ok(_name.Trim()));
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit();
        }
    }
}

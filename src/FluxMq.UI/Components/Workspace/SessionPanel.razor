@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

<div class="sessions-panel" aria-label="@SessionsPanelLabel">
    @if (Live.IsRecording)
    {
        <div class="session-recording-strip" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="Size.Small" aria-hidden="true" />
            <div class="session-recording-copy">
                <strong>@RecordingName</strong>
                <span>@RecordedMessageLabel</span>
            </div>
            <MudTooltip Text="Stop recording">
                <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.StopCircle"
                               Class="session-stop-button"
                               aria-label="Stop recording"
                               OnClick="@Live.StopRecording" />
            </MudTooltip>
        </div>
    }

    <div class="sessions-head">
        <div class="sessions-title">
            <span class="sessions-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" aria-hidden="true" />
            </span>
            <div class="sessions-title-copy">
                <strong>Recordings</strong>
                <span>@SessionCountLabel</span>
            </div>
        </div>

        <MudTooltip Text="@RecordButtonLabel">
            <MudIconButton Size="Size.Small"
                           Icon="@Icons.Material.Filled.FiberManualRecord"
                           Class="session-record-button"
                           Disabled="@Live.IsRecording"
                           aria-label="@RecordButtonLabel"
                           OnClick="@StartRecordingAsync" />
        </MudTooltip>
    </div>

    @if (Live.SelectedStoredSession is not null)
    {
        <div class="session-live-strip">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" aria-hidden="true" />
            <span>@Live.SelectedStoredSession.Name</span>
            <MudTooltip Text="Switch to live traffic">
                <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.Sensors"
                               Class="session-live-button"
                               aria-label="Switch to live traffic"
                               OnClick="@Live.ClearStoredSessionSelection" />
            </MudTooltip>
        </div>
    }

    <div class="sessions-toolbar" role="search" aria-label="Session filters">
        <MudTextField T="string"
                      Value="@_search"
                      ValueChanged="@OnSearchChanged"
                      Placeholder="Search sessions"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Secondary"
                      aria-label="Search recorded sessions"
                      Class="session-search" />
    </div>

    @{
        var projectGroups = ProjectGroups;
    }

    @if (projectGroups.Count == 0)
    {
        <div class="sessions-empty" role="status" aria-live="polite">
            <MudIcon Icon="@EmptyIcon" Size="Size.Medium" aria-hidden="true" />
            <strong class="sessions-empty-title">@EmptyTitle</strong>
            <span class="sessions-empty-copy">@EmptyText</span>
            @if (HasSearch)
            {
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                           Class="sessions-empty-action"
                           OnClick="@ClearSearch">
                    Clear search
                </MudButton>
            }
        </div>
    }
    else
    {
        <div class="sessions-list" role="list">
            @foreach (var group in projectGroups)
            {
                <section class="session-project-group" aria-label="@($"{group.Name} sessions")" @key="group.Name">
                    <div class="session-project-head">
                        <span>@group.Name</span>
                        <strong>@ProjectSessionLabel(group.Sessions.Count)</strong>
                    </div>

                    @foreach (var session in group.Sessions)
                    {
                        <div role="listitem" @key="session.Id">
                            <button type="button"
                                    class="@SessionRowClass(session)"
                                    aria-label="@SessionRowLabel(session)"
                                    title="@SessionRowLabel(session)"
                                    @onclick="@(() => SelectSessionAsync(session))">
                                <span class="@SessionDotClass(session)" aria-hidden="true"></span>
                                <span class="session-row-main">
                                    <span class="session-row-name-line">
                                        <span class="session-row-name">@session.Name</span>
                                        <span class="@SessionMarkerClass(session)">@SessionMarkerLabel(session)</span>
                                    </span>
                                    <span class="session-row-meta">
                                        <span>@ProfileLabel(session)</span>
                                        <span>@DurationLabel(session)</span>
                                        <span>@StartedLabel(session)</span>
                                    </span>
                                </span>
                            </button>
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private string _search = string.Empty;

    private IReadOnlyList<SessionProjectGroup> ProjectGroups => BuildProjectGroups();

    private IReadOnlyList<StoredSession> AllSessions => Live.StoredSessions;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    private string SessionCountLabel => AllSessions.Count switch
    {
        0 => "No recordings",
        _ when HasSearch => $"{FilteredSessionCount} of {AllSessions.Count} shown",
        1 => "1 recording",
        _ => $"{AllSessions.Count} recordings"
    };

    private string SessionsPanelLabel => Live.IsRecording
        ? $"Recordings, {SessionCountLabel}, recording {RecordingName}"
        : $"Recordings, {SessionCountLabel}";

    private string RecordingName => string.IsNullOrWhiteSpace(Live.ActiveRecordingSession?.Name)
        ? "Recording"
        : Live.ActiveRecordingSession.Name;

    private string RecordedMessageLabel => Live.RecordedMessageCount == 1
        ? "1 message captured"
        : $"{Live.RecordedMessageCount} messages captured";

    private string RecordButtonLabel => Live.IsRecording ? "Recording in progress" : "Start recording";

    private string EmptyIcon => HasSearch
        ? Icons.Material.Filled.SearchOff
        : Icons.Material.Filled.History;

    private string EmptyTitle => HasSearch ? "No matching sessions" : "No recorded sessions";

    private string EmptyText => HasSearch
        ? "Clear the search or try another project, profile, or session name."
        : "Start a recording to capture broker traffic for replay and inspection.";

    private int FilteredSessionCount => AllSessions.Count(SessionMatchesSearch);

    protected override void OnInitialized() => Live.Changed += OnChanged;

    private async Task StartRecordingAsync()
    {
        var parameters = new DialogParameters<StartRecordingDialog>
        {
            { x => x.ExistingProjects, Live.ProjectNames }
        };
        var dialog = await DialogService.ShowAsync<StartRecordingDialog>("Start Recording", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: StartRecordingDialog.StartRecordingResult r })
        {
            Live.StartRecording(r.SessionName, r.ProjectName);
        }
    }

    private Task SelectSessionAsync(StoredSession session) => Live.SelectStoredSessionAsync(session);

    private void OnSearchChanged(string value)
    {
        _search = value;
    }

    private void ClearSearch()
    {
        _search = string.Empty;
    }

    private IReadOnlyList<SessionProjectGroup> BuildProjectGroups()
    {
        var sessions = AllSessions
            .Where(SessionMatchesSearch)
            .GroupBy(static session => ProjectName(session), StringComparer.OrdinalIgnoreCase)
            .OrderBy(static group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(static group => new SessionProjectGroup(
                group.Key,
                group.OrderByDescending(static session => session.StartedAt).ToArray()))
            .Where(static group => group.Sessions.Count > 0)
            .ToArray();

        return sessions;
    }

    private bool SessionMatchesSearch(StoredSession session)
    {
        if (!HasSearch)
        {
            return true;
        }

        var search = _search.Trim();
        return session.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               ProjectName(session).Contains(search, StringComparison.OrdinalIgnoreCase) ||
               session.ProfileName.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private string SessionRowClass(StoredSession session)
    {
        var marker = SessionMarkerKey(session);
        var selected = IsSelected(session) ? " selected" : string.Empty;
        return $"session-row {marker}{selected}";
    }

    private string SessionDotClass(StoredSession session) => $"session-dot {SessionMarkerKey(session)}";

    private string SessionMarkerClass(StoredSession session) => $"session-marker {SessionMarkerKey(session)}";

    private string SessionMarkerKey(StoredSession session)
    {
        if (IsRecordingSession(session))
        {
            return "recording";
        }

        return IsSelected(session) ? "selected" : "stored";
    }

    private string SessionMarkerLabel(StoredSession session)
    {
        if (IsRecordingSession(session))
        {
            return "Recording";
        }

        return IsSelected(session) ? "Loaded" : "Stored";
    }

    private string SessionRowLabel(StoredSession session)
        => $"Load {SessionMarkerLabel(session).ToLowerInvariant()} session {session.Name} from {ProjectName(session)}, {ProfileLabel(session)}, {DurationLabel(session)}, started {StartedLabel(session)}";

    private bool IsSelected(StoredSession session)
        => Live.SelectedStoredSession?.Id == session.Id;

    private bool IsRecordingSession(StoredSession session)
        => Live.ActiveRecordingSession?.Id == session.Id;

    private static string ProjectName(StoredSession session)
        => string.IsNullOrWhiteSpace(session.ProjectName) ? "Default" : session.ProjectName.Trim();

    private static string ProjectSessionLabel(int count)
        => count == 1 ? "1 session" : $"{count} sessions";

    private static string ProfileLabel(StoredSession session)
        => string.IsNullOrWhiteSpace(session.ProfileName) ? "Workspace profile" : session.ProfileName;

    private static string StartedLabel(StoredSession session)
        => session.StartedAt.ToLocalTime().ToString("MMM d HH:mm");

    private static string DurationLabel(StoredSession session)
    {
        if (session.EndedAt is null)
        {
            return "Open session";
        }

        var duration = session.EndedAt.Value - session.StartedAt;
        if (duration.TotalMinutes < 1)
        {
            return "<1m";
        }

        if (duration.TotalHours < 1)
        {
            return $"{Math.Max(1, (int)Math.Round(duration.TotalMinutes))}m";
        }

        var hours = (int)duration.TotalHours;
        var minutes = duration.Minutes;
        return minutes == 0 ? $"{hours}h" : $"{hours}h {minutes}m";
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;

    private sealed record SessionProjectGroup(string Name, IReadOnlyList<StoredSession> Sessions);
}

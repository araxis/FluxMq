@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

@if (Live.IsRecording)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="px-2 py-1">
        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Error" Size="Size.Small" />
        <MudText Typo="Typo.caption" Class="flex-grow-1">
            @Live.ActiveRecordingSession?.Name · @Live.RecordedMessageCount msgs
        </MudText>
        <MudIconButton Size="Size.Small"
                       Icon="@Icons.Material.Filled.StopCircle"
                       Color="Color.Error"
                       OnClick="@Live.StopRecording" />
    </MudStack>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="px-2 pt-1">
    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Secondary" />
    <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Projects</MudText>
    <MudIconButton Size="Size.Small"
                   Icon="@Icons.Material.Filled.FiberManualRecord"
                   Color="Color.Error"
                   Disabled="@Live.IsRecording"
                   OnClick="@StartRecordingAsync" />
</MudStack>

@if (Live.SelectedStoredSession is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-3 pb-1">
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Sensors"
                   OnClick="@Live.ClearStoredSessionSelection">
            Switch to Live
        </MudButton>
    </MudStack>
}

@{
    var allSessions = Live.StoredSessions;
    var projects = Live.ProjectNames.ToList();
    if (projects.Count == 0 && allSessions.Count == 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 pb-2">
            No recorded sessions. Start a recording first.
        </MudText>
    }
    else
    {
        if (projects.Count == 0) projects.Add("Default");

        <MudTreeView T="object" Dense="true" Hover="true">
            @foreach (var project in projects)
            {
                var sessions = allSessions
                    .Where(s => string.Equals(
                        string.IsNullOrWhiteSpace(s.ProjectName) ? "Default" : s.ProjectName,
                        project, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(s => s.StartedAt)
                    .ToList();

                <MudTreeViewItem T="object" Value="@project" Text="@project"
                                 Icon="@Icons.Material.Filled.FolderOpen"
                                 Expanded="true">
                    @foreach (var session in sessions)
                    {
                        var isSelected = Live.SelectedStoredSession?.Id == session.Id;
                        <MudTreeViewItem T="object" Value="@session"
                                         OnClick="@(() => SelectSessionAsync(session))">
                            <Content>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-grow-1 py-1">
                                    <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                                             Size="Size.Small"
                                             Color="@(isSelected ? Color.Success : Color.Default)" />
                                    <MudStack Spacing="0" Class="flex-grow-1">
                                        <MudText Typo="Typo.body2">@session.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @session.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </Content>
                        </MudTreeViewItem>
                    }
                </MudTreeViewItem>
            }
        </MudTreeView>
    }
}

@code {
    protected override void OnInitialized() => Live.Changed += OnChanged;

    private async Task StartRecordingAsync()
    {
        var parameters = new DialogParameters<StartRecordingDialog>
        {
            { x => x.ExistingProjects, Live.ProjectNames }
        };
        var dialog = await DialogService.ShowAsync<StartRecordingDialog>("Start Recording", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: StartRecordingDialog.StartRecordingResult r })
            Live.StartRecording(r.SessionName, r.ProjectName);
    }

    private Task SelectSessionAsync(StoredSession session) => Live.SelectStoredSessionAsync(session);

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Live.Changed -= OnChanged;
}

@using FluxMq.UI.Services

<div class="test-studio">
    <div class="test-studio-toolbar">
        <div class="test-studio-heading">
            <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" />
            <span>@Title</span>
        </div>
        <MudToggleGroup T="TestStudioMode"
                        Value="@_mode"
                        ValueChanged="@SetMode"
                        Size="Size.Small"
                        SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary">
            <MudToggleItem T="TestStudioMode" Value="@TestStudioMode.Designer" Text="Scenario Designer" />
            <MudToggleItem T="TestStudioMode" Value="@TestStudioMode.Runner" Text="Runner Console" />
        </MudToggleGroup>
    </div>

    @if (_mode == TestStudioMode.Designer)
    {
        <div class="test-studio-body designer">
            <aside class="test-studio-tools">
                <ComponentCatalogPanel ArtifactKind="@WorkspaceArtifactKind.Test" />
            </aside>
            <div class="test-studio-region">
                <TestScenarioDesigner Project="@Project" />
            </div>
        </div>
    }
    else
    {
        <div class="test-studio-body runner">
            <TestRunnerConsole Project="@Project" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    private TestStudioMode _mode = TestStudioMode.Designer;

    private string Title
        => Project.GetActiveTestScenario() is { } scenario
            ? scenario.Name
            : "Test Studio";

    private void SetMode(TestStudioMode mode)
        => _mode = mode;

    private enum TestStudioMode
    {
        Designer,
        Runner
    }
}

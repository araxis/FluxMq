@using FluxMq.UI.Services

<div class="test-studio" aria-label="Test studio workspace">
    <header class="test-studio-toolbar" aria-label="Test studio toolbar">
        <div class="test-studio-heading">
            <span class="test-studio-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" />
            </span>
            <div class="test-studio-title-copy">
                <strong>@Title</strong>
                <small>@Subtitle</small>
            </div>
            <div class="test-studio-meta" aria-label="Test studio summary">
                <span>@TestCountLabel</span>
                <span>@ActiveScenarioLabel</span>
                <span>@RunCountLabel</span>
            </div>
        </div>
        <div class="test-studio-mode-switch" role="tablist" aria-label="Test studio mode">
            <button type="button"
                    id="@DesignerTabId"
                    class="@ModeButtonClass(TestStudioMode.Designer)"
                    role="tab"
                    aria-selected="@(_mode == TestStudioMode.Designer)"
                    aria-controls="@DesignerPanelId"
                    aria-label="@ModeButtonLabel(TestStudioMode.Designer)"
                    @onclick="@(() => SetMode(TestStudioMode.Designer))">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                <span>Design</span>
            </button>
            <button type="button"
                    id="@RunnerTabId"
                    class="@ModeButtonClass(TestStudioMode.Runner)"
                    role="tab"
                    aria-selected="@(_mode == TestStudioMode.Runner)"
                    aria-controls="@RunnerPanelId"
                    aria-label="@ModeButtonLabel(TestStudioMode.Runner)"
                    @onclick="@(() => SetMode(TestStudioMode.Runner))">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
                <span>Run</span>
            </button>
        </div>
    </header>

    @if (_mode == TestStudioMode.Designer)
    {
        <div class="test-studio-body designer"
             id="@DesignerPanelId"
             role="tabpanel"
             aria-labelledby="@DesignerTabId"
             tabindex="0">
            <aside class="test-studio-tools">
                <ComponentCatalogPanel ArtifactKind="@WorkspaceArtifactKind.Test" />
            </aside>
            <div class="test-studio-region">
                <TestScenarioDesigner Project="@Project" />
            </div>
        </div>
    }
    else
    {
        <div class="test-studio-body runner"
             id="@RunnerPanelId"
             role="tabpanel"
             aria-labelledby="@RunnerTabId"
             tabindex="0">
            <TestRunnerConsole Project="@Project" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    private const string DesignerTabId = "test-studio-designer-tab";
    private const string DesignerPanelId = "test-studio-designer-panel";
    private const string RunnerTabId = "test-studio-runner-tab";
    private const string RunnerPanelId = "test-studio-runner-panel";

    private TestStudioMode _mode = TestStudioMode.Designer;

    private string Title
        => Project.GetActiveTestScenario() is { } scenario
            ? scenario.Name
            : "Test Studio";

    private string Subtitle
        => Project.GetActiveTestScenario() is { } scenario
            ? "Active test scenario"
            : "Create or select a scenario";

    private string TestCountLabel
        => FormatCount(Project.TestNames.Count, "test");

    private string ActiveScenarioLabel
        => Project.GetActiveTestScenario() is { } scenario
            ? FormatCount(scenario.StepCount, "step")
            : "No steps";

    private string RunCountLabel
        => Project.GetActiveTestScenario() is { } scenario
            ? FormatCount(Project.ScenarioRunHistory.Count(result => string.Equals(result.Name, scenario.Name, StringComparison.Ordinal)), "run")
            : "No runs";

    private static string FormatCount(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private void SetMode(TestStudioMode mode)
        => _mode = mode;

    private string ModeButtonClass(TestStudioMode mode)
        => _mode == mode ? "test-studio-mode-button active" : "test-studio-mode-button";

    private static string ModeButtonLabel(TestStudioMode mode)
        => mode switch
        {
            TestStudioMode.Designer => "Design test scenarios",
            TestStudioMode.Runner => "Run test scenarios",
            _ => "Select test mode"
        };

    private enum TestStudioMode
    {
        Designer,
        Runner
    }
}

@using System.Globalization
@using FluxMq.App.Metrics
@inject IFluxMetricCatalog Catalog
@inject DashboardMetricRegistry MetricRegistry
@inject IDialogService DialogService

<div class="metrics-workbench">
    <div class="metrics-commandbar">
        <div class="metrics-heading">
            <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" Class="metrics-heading-icon" aria-hidden="true" />
            <div>
                <div class="metrics-title">Metrics</div>
                <div class="@MetricsMetaClass">@MetricCountText</div>
            </div>
        </div>
    </div>

    <div class="metrics-body">
        <section class="metrics-list-pane" aria-label="Metric resources">
            <div class="metrics-list-toolbar">
                <label class="metrics-filter-field metrics-search-field">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" aria-hidden="true" />
                    <input value="@_search"
                           placeholder="Search metrics"
                           aria-label="Search metrics"
                           @oninput="@OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button"
                                class="metrics-inline-clear"
                                title="Clear search"
                                aria-label="Clear search"
                                @onclick="@ClearSearch">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                        </button>
                    }
                </label>

                <div class="metrics-filter-field metrics-type-field">
                    <MudIcon Class="metrics-type-filter-icon" Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" aria-hidden="true" />
                    <MudSelect T="string"
                               Class="metrics-type-select"
                               PopoverClass="metrics-type-select-popover"
                               ListClass="metrics-type-select-list"
                               Value="@_typeFilter"
                               ValueChanged="@SetTypeFilter"
                               Variant="Variant.Text"
                               Margin="Margin.Dense"
                               Dense="true"
                               Underline="false"
                               Modal="false"
                               RelativeWidth="DropdownWidth.Adaptive"
                               MaxHeight="320"
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               aria-label="Metric type">
                        <MudSelectItem T="string" Value="@AllTypes">All types</MudSelectItem>
                        @foreach (var descriptor in SortedDescriptors)
                        {
                            <MudSelectItem T="string" Value="@descriptor.TypeId">@descriptor.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (HasActiveFilters)
                {
                    <MudTooltip Text="Reset filters">
                        <button type="button"
                                class="metrics-filter-reset"
                                aria-label="Reset filters"
                                @onclick="@ResetFilters">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" aria-hidden="true" />
                        </button>
                    </MudTooltip>
                }

                <button type="button"
                        class="metrics-new-button"
                        @onclick="@OpenNewMetricDialogAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-hidden="true" />
                    <span>New metric</span>
                </button>
            </div>
            <div class="metrics-list-head">
                <span>Name</span>
                <span>Type</span>
                <span>Query</span>
                <span>Uses</span>
                <span>Latest</span>
            </div>

            <div class="metrics-list">
                @if (Rows.Count == 0)
                {
                    <div class="metrics-list-empty create-empty" role="status" aria-live="polite">
                        <span class="metrics-empty-icon" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" aria-hidden="true" />
                        </span>
                        <span class="metrics-empty-copy">
                            <strong>No metrics yet</strong>
                            <span>Create one to feed dashboard widgets and metric sources.</span>
                        </span>
                        <button type="button"
                                class="metrics-empty-action"
                                @onclick="@OpenNewMetricDialogAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-hidden="true" />
                            <span>New metric</span>
                        </button>
                    </div>
                }
                else if (FilteredRows.Count == 0)
                {
                    <div class="metrics-list-empty filter-empty" role="status" aria-live="polite">
                        <span class="metrics-empty-icon muted" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" aria-hidden="true" />
                        </span>
                        <span class="metrics-empty-copy">
                            <strong>No matching metrics</strong>
                            <span>@FilterEmptyDescription</span>
                        </span>
                        <button type="button"
                                class="metrics-empty-action secondary"
                                @onclick="@ResetFilters">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" aria-hidden="true" />
                            <span>Reset filters</span>
                        </button>
                    </div>
                }
                else
                {
                    @foreach (var row in FilteredRows)
                    {
                        var current = row;
                        <button type="button"
                                class="@RowClass(current)"
                                aria-label="@MetricRowLabel(current)"
                                @key="current.Id"
                                @onclick="@(() => SelectMetricAsync(current.Id))">
                            <span class="metrics-cell metrics-cell-name" title="@current.Id">
                                <strong>@current.DisplayName</strong>
                                <small>@current.Id</small>
                            </span>
                            <span class="metrics-cell metrics-cell-type">
                                <span class="metrics-type-summary" title="@current.TypeName">
                                    <MudIcon Icon="@TypeIcon(current.TypeId)" Size="Size.Small" aria-hidden="true" />
                                    <span>@current.TypeName</span>
                                </span>
                            </span>
                            <span class="metrics-cell metrics-cell-summary" title="@current.Summary">@current.Summary</span>
                            <span class="metrics-cell metrics-cell-uses" title="@($"{current.ReferenceCount} references")">
                                <span class="@ReferenceCountClass(current.ReferenceCount)">@current.ReferenceCount</span>
                            </span>
                            <span class="metrics-cell metrics-cell-latest">
                                @if (current.Latest is { } latest)
                                {
                                    <span class="metrics-latest-marker live">
                                        <span class="metrics-live-dot"></span>
                                        <strong>@latest.FormattedValue</strong>
                                        @if (!string.IsNullOrWhiteSpace(latest.Unit))
                                        {
                                            <small>@latest.Unit</small>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="metrics-latest-marker muted">
                                        <MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" Size="Size.Small" aria-hidden="true" />
                                        <small>No reading</small>
                                    </span>
                                }
                            </span>
                        </button>
                    }
                }
            </div>
        </section>

        <section class="metrics-editor-pane" aria-label="Metric editor">
            @if (_draft is null || _selectedMetricName is null)
            {
                <div class="metrics-editor-empty" role="status" aria-live="polite">
                    <span class="metrics-empty-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" aria-hidden="true" />
                    </span>
                    <span class="metrics-empty-copy">
                        <strong>@EditorEmptyTitle</strong>
                        <span>@EditorEmptyDescription</span>
                    </span>
                </div>
            }
            else
            {
                <div class="metrics-editor-header">
                    <div class="metrics-editor-title">
                        <span class="metrics-editor-icon">
                            <MudIcon Icon="@EditorIcon" Size="Size.Small" aria-hidden="true" />
                        </span>
                        <div class="metrics-editor-copy">
                            <div class="metrics-editor-name">@(_draft.DisplayName.Length == 0 ? _draft.Id : _draft.DisplayName)</div>
                            <div class="metrics-editor-subtitle">
                                <span>@EditorSubtitle</span>
                                <code>@_draft.Id</code>
                            </div>
                        </div>
                    </div>

                    <div class="metrics-editor-actions">
                        @if (ShowUnsavedIndicator)
                        {
                            <div class="metrics-unsaved-indicator dirty" title="This metric has unsaved changes">
                                <span class="metrics-unsaved-dot"></span>
                                <span>Unsaved</span>
                            </div>
                        }
                        <div class="metrics-action-strip">
                            @if (_draft.IsDirty)
                            {
                                <MudTooltip Text="Cancel changes">
                                    <button type="button"
                                            class="metrics-header-icon-button"
                                            aria-label="Cancel changes"
                                            @onclick="@CancelEdit">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                                    </button>
                                </MudTooltip>
                            }
                            <MudTooltip Text="Duplicate metric">
                                <button type="button"
                                        class="metrics-header-icon-button"
                                        aria-label="Duplicate metric"
                                        @onclick="@DuplicateSelectedMetricAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-hidden="true" />
                                </button>
                            </MudTooltip>
                            <MudTooltip Text="Delete metric">
                                <button type="button"
                                        class="metrics-header-icon-button danger"
                                        aria-label="Delete metric"
                                        @onclick="@DeleteSelectedMetricAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" aria-hidden="true" />
                                </button>
                            </MudTooltip>
                        </div>
                        @if (_draft.IsDirty)
                        {
                            <button type="button"
                                    class="metrics-save-button"
                                    disabled="@(!CanSave)"
                                    title="@SaveButtonTitle"
                                    aria-label="@SaveButtonTitle"
                                    @onclick="@SaveMetricAsync">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" aria-hidden="true" />
                                <span>Save</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="metrics-editor-scroll">
                    <div class="metrics-editor-compact-layout">
                        <div class="metrics-editor-main-panel">
                            <div class="metrics-compact-section">
                                <div class="metrics-section-heading">
                                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" aria-hidden="true" />
                                    <span>Edit metric</span>
                                </div>
                                <div class="metrics-form-grid compact">
                                    <div class="@ResourceIdFieldClass"
                                         id="@MetricIdFieldId"
                                         title="@MetricIdValidationMessage"
                                         tabindex="-1"
                                         aria-invalid="@AriaState(HasValidationMessage(MetricIdValidationMessage))"
                                         aria-errormessage="@MetricIdErrorElementId">
                                        <span>Metric id</span>
                                        <code>@_draft.Id</code>
                                        @if (CanOpenRename)
                                        {
                                            <button type="button"
                                                    title="Rename metric"
                                                    aria-label="Rename metric"
                                                    @onclick="@RenameMetricAsync">
                                                <MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Size="Size.Small" aria-hidden="true" />
                                            </button>
                                        }
                                    </div>
                                    <label class="@DisplayNameFieldClass"
                                           id="@DisplayNameFieldId"
                                           tabindex="-1"
                                           title="@DisplayNameValidationMessage">
                                        <span>Display name</span>
                                        <input value="@_draft.DisplayName"
                                               aria-label="Display name"
                                               aria-invalid="@AriaState(HasValidationMessage(DisplayNameValidationMessage))"
                                               aria-errormessage="@DisplayNameErrorElementId"
                                               @oninput="@OnDraftDisplayNameInput" />
                                    </label>
                                    <div class="@MetricTypeFieldClass"
                                         id="@MetricTypeFieldId"
                                         title="@MetricTypeFieldTitle"
                                         tabindex="-1"
                                         aria-invalid="@AriaState(HasValidationMessage(MetricTypeValidationMessage))"
                                         aria-errormessage="@MetricTypeErrorElementId">
                                        <span class="metrics-type-picker-icon">
                                            <MudIcon Icon="@EditorIcon" Size="Size.Small" aria-hidden="true" />
                                        </span>
                                        <div class="metrics-type-picker-copy">
                                            <span>Metric type</span>
                                            <strong>@(CurrentDescriptor?.DisplayName ?? _draft.TypeId)</strong>
                                            <small>@MetricTypeDetailLine</small>
                                        </div>
                                        <button type="button"
                                                aria-label="Change metric type"
                                                @onclick="@OpenMetricTypeDialogAsync">
                                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" aria-hidden="true" />
                                            <span>Change</span>
                                        </button>
                                    </div>
                                    <label class="metrics-identity-field">
                                        <span>Description</span>
                                        <input value="@_draft.Description"
                                               aria-label="Description"
                                               placeholder="Optional"
                                               @oninput="@OnDraftDescriptionInput" />
                                    </label>
                                </div>
                            </div>

                            <div class="metrics-compact-section">
                                <div class="metrics-section-heading">
                                    <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Small" aria-hidden="true" />
                                    <span>Parameters</span>
                                </div>
                                @if (CurrentDescriptor is not { } descriptorForParameters)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        Select a registered metric type before editing parameters.
                                    </MudAlert>
                                }
                                else if (descriptorForParameters.Parameters.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                        This metric type has no editable parameters.
                                    </MudAlert>
                                }
                                else
                                {
                                    <div class="metrics-parameter-grid">
                                        @foreach (var parameter in descriptorForParameters.Parameters)
                                        {
                                            var currentParameter = parameter;
                                            <div class="@ParameterRowClass(currentParameter)" @key="currentParameter.Key">
                                                @RenderParameterField(currentParameter)
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <aside class="metrics-editor-side-panel" aria-label="@MetricDetailsLabel">
                            @{
                                var hasDraftPreview = TryGetDraftPreview(out var preview);
                            }
                            <div class="metrics-side-card preview-context">
                                <div class="metrics-section-heading">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" aria-hidden="true" />
                                    <span>Live preview</span>
                                    @if (hasDraftPreview)
                                    {
                                        <span class="metrics-side-indicator live">Live</span>
                                    }
                                </div>
                                @if (hasDraftPreview)
                                {
                                    <div class="metrics-preview-card live">
                                        <div class="metrics-preview-marker">
                                            <span class="metrics-live-dot"></span>
                                            <span>Reading</span>
                                        </div>
                                        <div class="metrics-preview-value">
                                            <strong>@preview.FormattedValue</strong>
                                            @if (!string.IsNullOrWhiteSpace(preview.Unit))
                                            {
                                                <span>@preview.Unit</span>
                                            }
                                        </div>
                                        <div class="metrics-preview-meta">Updated @FormatRelativeTime(preview.Timestamp)</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="metrics-preview-card muted" title="Stopped or not emitted.">
                                        <div class="metrics-preview-empty" role="status" aria-live="polite">
                                            <MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" Size="Size.Small" aria-hidden="true" />
                                            <span>
                                                <strong>No reading</strong>
                                                <small>Stopped or not emitted</small>
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="metrics-side-card references-context">
                                <div class="metrics-section-heading">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" aria-hidden="true" />
                                    <span>References</span>
                                    @if (ReferenceSummaries.Count > 0)
                                    {
                                        <span class="metrics-side-indicator">@ReferenceSummaries.Count</span>
                                    }
                                </div>
                                @if (ReferenceSummaries.Count == 0)
                                {
                                    <div class="metrics-reference-empty" role="status" aria-live="polite">
                                        <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" aria-hidden="true" />
                                        <span>
                                            <strong>No references</strong>
                                            <small>No dashboard bindings</small>
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="metrics-reference-list" role="list" aria-label="Dashboard bindings for selected metric">
                                        @foreach (var reference in ReferenceSummaries)
                                        {
                                            <div class="metrics-reference-row" role="listitem" title="@ReferenceTitle(reference)">
                                                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Class="metrics-reference-icon" aria-hidden="true" />
                                                <span class="metrics-reference-main">
                                                    <strong>@reference.WidgetName</strong>
                                                    <span>@ReferenceLocationLine(reference)</span>
                                                </span>
                                                <span class="metrics-reference-tags">
                                                    @if (!string.IsNullOrWhiteSpace(reference.WidgetType))
                                                    {
                                                        <em>@reference.WidgetType</em>
                                                    }
                                                    @if (reference.IsPrimary)
                                                    {
                                                        <small>Primary</small>
                                                    }
                                                </span>
                                                <span class="metrics-reference-action">
                                                    <MudTooltip Text="@ReferenceOpenTooltip(reference)">
                                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                                       Size="Size.Small"
                                                                       Class="metrics-reference-open"
                                                                       aria-label="@ReferenceOpenLabel(reference)"
                                                                       OnClick="@(() => OpenReferenceDashboardAsync(reference))" />
                                                    </MudTooltip>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (ValidationItems is { Count: > 0 } validationItems)
                            {
                                <div class="metrics-side-card danger">
                                    <div class="metrics-section-heading">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" aria-hidden="true" />
                                        <span>Validation</span>
                                        <span class="metrics-side-indicator danger">@validationItems.Count</span>
                                    </div>
                                    <div class="metrics-validation-list">
                                        @foreach (var item in validationItems)
                                        {
                                            @if (string.IsNullOrWhiteSpace(item.TargetId))
                                            {
                                                <div class="metrics-validation-line" id="@item.MessageId">
                                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" aria-hidden="true" />
                                                    <span>@item.Message</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <a class="metrics-validation-line"
                                                   id="@item.MessageId"
                                                   href="#@item.TargetId"
                                                   title="Show field">
                                                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" aria-hidden="true" />
                                                    <span>@item.Message</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </aside>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private const string AllTypes = "";
    private const string TrueValue = "true";
    private const string FalseValue = "false";
    private const string DefaultToggleValue = "";
    private const string MetricIdFieldId = "metric-field-id";
    private const string DisplayNameFieldId = "metric-field-display-name";
    private const string MetricTypeFieldId = "metric-field-type";
    private const string MetricIdErrorId = "metric-error-id";
    private const string DisplayNameErrorId = "metric-error-display-name";
    private const string MetricTypeErrorId = "metric-error-type";

    private sealed record MetricValidationItem(string Message, string? TargetId, string? MessageId);

    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    private long _revision = -1;
    private string _search = string.Empty;
    private string _typeFilter = AllTypes;
    private string? _selectedMetricName;
    private MetricDesignerDraft? _draft;

    private IReadOnlyDictionary<string, FluxMetricResourceDefinition> Metrics => Project.GetMetricResources();

    private IReadOnlyList<MetricDescriptor> SortedDescriptors =>
        [.. Catalog.Descriptors.OrderBy(static descriptor => descriptor.DisplayName, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<MetricDesignerRow> Rows =>
        MetricDesignerState.BuildRows(Metrics, Catalog, Project.CountMetricReferences, TryGetLatestValue);

    private IReadOnlyList<MetricDesignerRow> FilteredRows =>
        MetricDesignerState.ApplyFilter(Rows, _search, _typeFilter);

    private string MetricCountText =>
        MetricDesignerState.MetricCountText(Rows.Count, FilteredRows.Count, HasActiveFilters);

    private string MetricsMetaClass =>
        HasActiveFilters ? "metrics-meta filtered" : "metrics-meta";

    private MetricDescriptor? SelectedTypeFilter =>
        string.IsNullOrWhiteSpace(_typeFilter) ? null : Catalog.Describe(_typeFilter);

    private string FilterEmptyDescription =>
        MetricDesignerState.FilterEmptyDescription(_search, SelectedTypeFilter?.DisplayName);

    private string EditorEmptyTitle =>
        Rows.Count == 0 ? "No metrics yet" : "No metric selected";

    private string EditorEmptyDescription =>
        Rows.Count == 0
            ? "Create a metric on the left to configure parameters and preview values."
            : "Select a metric from the list.";

    private IReadOnlyList<MetricValidationItem> ValidationItems => BuildValidationItems();

    private IReadOnlyList<string> ValidationErrors =>
        [.. ValidationItems.Select(static item => item.Message)];

    private IReadOnlyList<MetricReferenceSummary> ReferenceSummaries =>
        string.IsNullOrWhiteSpace(_selectedMetricName)
            ? []
            : Project.GetMetricReferenceSummaries(_selectedMetricName);

    private MetricDescriptor? CurrentDescriptor =>
        _draft is null ? null : Catalog.Describe(_draft.TypeId);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search) ||
        !string.IsNullOrWhiteSpace(_typeFilter);

    private bool CanSave =>
        _draft is { IsDirty: true } &&
        ValidationErrors.Count == 0;

    private bool CanOpenRename =>
        _draft is { IsDirty: false };

    private string EditorSubtitle =>
        CurrentDescriptor is { } descriptor
            ? MetricDesignerState.ParameterSummary(descriptor, _draft?.Parameters ?? new Dictionary<string, string>())
            : "Unknown metric type";

    private string MetricDetailsLabel =>
        _draft is null
            ? "Metric details"
            : $"Metric details for {(_draft.DisplayName.Length == 0 ? _draft.Id : _draft.DisplayName)}";

    private string EditorIcon =>
        CurrentDescriptor?.ValueKind == MetricValueKind.Double
            ? Icons.Material.Filled.Speed
            : Icons.Material.Filled.QueryStats;

    private string ValidationSummary =>
        ValidationErrors.Count == 1
            ? "1 issue needs attention"
            : $"{ValidationErrors.Count} issues need attention";

    private bool ShowUnsavedIndicator =>
        _draft is { IsDirty: true } &&
        ValidationErrors.Count == 0;

    private string SaveButtonTitle =>
        ValidationErrors.Count > 0
            ? ValidationSummary
            : "Save metric";

    private string? MetricIdValidationMessage =>
        _draft is null ? null : MetricDesignerState.ValidateMetricId(_draft, Metrics.Keys);

    private string? DisplayNameValidationMessage =>
        _draft is null ? null : MetricDesignerState.ValidateDisplayName(_draft);

    private string? MetricTypeValidationMessage =>
        _draft is not null && CurrentDescriptor is null
            ? "Metric type is not registered."
            : null;

    private string MetricTypeFieldTitle =>
        MetricTypeValidationMessage ??
        CurrentDescriptor?.Description ??
        string.Empty;

    private string MetricTypeDetailLine =>
        CurrentDescriptor is { } descriptor
            ? $"{descriptor.TypeId} · {MetricTypeFactsText(descriptor)}"
            : "Unknown type";

    private string? MetricIdErrorElementId =>
        HasValidationMessage(MetricIdValidationMessage) ? MetricIdErrorId : null;

    private string? DisplayNameErrorElementId =>
        HasValidationMessage(DisplayNameValidationMessage) ? DisplayNameErrorId : null;

    private string? MetricTypeErrorElementId =>
        HasValidationMessage(MetricTypeValidationMessage) ? MetricTypeErrorId : null;

    private string ResourceIdFieldClass =>
        HasValidationMessage(MetricIdValidationMessage)
            ? "metrics-resource-id-field invalid"
            : "metrics-resource-id-field";

    private string DisplayNameFieldClass =>
        HasValidationMessage(DisplayNameValidationMessage)
            ? "metrics-identity-field invalid"
            : "metrics-identity-field";

    private string MetricTypeFieldClass =>
        HasValidationMessage(MetricTypeValidationMessage)
            ? "metrics-type-picker-field invalid"
            : "metrics-type-picker-field";

    private IReadOnlyList<MetricValidationItem> BuildValidationItems()
    {
        if (_draft is null)
        {
            return [];
        }

        var items = new List<MetricValidationItem>();
        if (MetricDesignerState.ValidateMetricId(_draft, Metrics.Keys) is { } idError)
        {
            items.Add(new MetricValidationItem(idError, MetricIdFieldId, MetricIdErrorId));
        }

        if (MetricDesignerState.ValidateDisplayName(_draft) is { } displayNameError)
        {
            items.Add(new MetricValidationItem(displayNameError, DisplayNameFieldId, DisplayNameErrorId));
        }

        if (CurrentDescriptor is not { } descriptor)
        {
            items.Add(new MetricValidationItem("Metric type is not registered.", MetricTypeFieldId, MetricTypeErrorId));
            return items;
        }

        foreach (var parameter in descriptor.Parameters)
        {
            if (MetricDesignerState.ValidateParameter(_draft, parameter) is { } parameterError)
            {
                items.Add(new MetricValidationItem(parameterError, ParameterFieldId(parameter), ParameterErrorId(parameter)));
            }
        }

        return items;
    }

    private string TypeIcon(string? typeId)
        => Catalog.Describe(typeId ?? string.Empty)?.ValueKind == MetricValueKind.Double
            ? Icons.Material.Filled.Speed
            : Icons.Material.Filled.QueryStats;

    protected override void OnParametersSet()
    {
        if (_revision == Project.DefinitionRevision)
        {
            return;
        }

        _revision = Project.DefinitionRevision;
        if (_selectedMetricName is null || !Metrics.ContainsKey(_selectedMetricName))
        {
            _selectedMetricName = Metrics.Keys.Order(StringComparer.OrdinalIgnoreCase).FirstOrDefault();
        }

        if (_draft is null || !_draft.IsDirty)
        {
            LoadSelectedMetric();
        }
    }

    private void LoadSelectedMetric()
    {
        if (string.IsNullOrWhiteSpace(_selectedMetricName) ||
            Metrics.TryGetValue(_selectedMetricName, out var resource) is false)
        {
            _draft = null;
            return;
        }

        _draft = MetricDesignerDraft.FromResource(_selectedMetricName, resource);
    }

    private async Task SelectMetricAsync(string metricName)
    {
        if (string.Equals(metricName, _selectedMetricName, StringComparison.Ordinal))
        {
            return;
        }

        if (!await ConfirmDiscardIfDirtyAsync())
        {
            return;
        }

        _selectedMetricName = metricName;
        LoadSelectedMetric();
    }

    private async Task OpenNewMetricDialogAsync()
    {
        if (!await ConfirmDiscardIfDirtyAsync())
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Descriptors"] = SortedDescriptors,
            ["ExistingMetricIds"] = Metrics.Keys.ToArray()
        };
        var dialog = await DialogService.ShowAsync<MetricCreateDialog>("New metric", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MetricCreateDialog.MetricCreateResult created })
        {
            return;
        }

        Project.AddMetric(created.MetricId);
        Project.UpdateMetric(
            created.MetricId,
            new FluxMetricResourceDefinition
            {
                Id = created.MetricId,
                TypeId = created.TypeId,
                DisplayName = created.DisplayName,
                Description = Catalog.Describe(created.TypeId)?.Description ?? string.Empty,
                Parameters = created.Parameters
            });

        _selectedMetricName = created.MetricId;
        _revision = -1;
        LoadSelectedMetric();
    }

    private async Task SaveMetricAsync()
    {
        if (_draft is null || ValidationErrors.Count > 0)
        {
            return;
        }

        var previousId = _draft.OriginalId;
        var nextId = _draft.Id.Trim();
        var resource = _draft.ToResource(Catalog);
        if (!string.Equals(previousId, nextId, StringComparison.Ordinal))
        {
            Project.RenameMetric(previousId, nextId);
            _selectedMetricName = nextId;
        }

        Project.UpdateMetric(nextId, resource);
        _revision = -1;
        LoadSelectedMetric();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RenameMetricAsync()
    {
        if (_draft is null || !CanOpenRename)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["CurrentMetricId"] = _draft.OriginalId,
            ["ExistingMetricIds"] = Metrics.Keys.ToArray()
        };
        var dialog = await DialogService.ShowAsync<MetricRenameDialog>("Rename metric", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MetricRenameDialog.MetricRenameResult rename } ||
            string.Equals(rename.MetricId, _draft.OriginalId, StringComparison.Ordinal))
        {
            return;
        }

        Project.RenameMetric(_draft.OriginalId, rename.MetricId);
        _selectedMetricName = rename.MetricId;
        _revision = -1;
        LoadSelectedMetric();
    }

    private async Task DuplicateSelectedMetricAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedMetricName) ||
            !await ConfirmDiscardIfDirtyAsync())
        {
            return;
        }

        if (!Metrics.TryGetValue(_selectedMetricName, out var source))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["SourceMetricId"] = _selectedMetricName,
            ["SourceDisplayName"] = source.DisplayName,
            ["ExistingMetricIds"] = Metrics.Keys.ToArray()
        };
        var dialog = await DialogService.ShowAsync<MetricDuplicateDialog>("Duplicate metric", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MetricDuplicateDialog.MetricDuplicateResult duplicate })
        {
            return;
        }

        Project.UpdateMetric(
            duplicate.MetricId,
            source with
            {
                Id = duplicate.MetricId,
                DisplayName = duplicate.DisplayName,
                Parameters = new Dictionary<string, string>(source.Parameters, StringComparer.Ordinal),
                Labels = new Dictionary<string, string>(source.Labels, StringComparer.Ordinal)
            });

        _selectedMetricName = duplicate.MetricId;
        _revision = -1;
        LoadSelectedMetric();
    }

    private async Task DeleteSelectedMetricAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedMetricName))
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["MetricId"] = _selectedMetricName,
            ["References"] = ReferenceSummaries
        };
        var dialog = await DialogService.ShowAsync<MetricDeleteDialog>("Delete metric", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var next = Metrics.Keys
            .Where(metric => !string.Equals(metric, _selectedMetricName, StringComparison.Ordinal))
            .Order(StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault();
        Project.RemoveMetric(_selectedMetricName);
        _selectedMetricName = next;
        _revision = -1;
        LoadSelectedMetric();
    }

    private async Task OpenMetricTypeDialogAsync()
    {
        if (_draft is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["Descriptors"] = SortedDescriptors,
            ["CurrentTypeId"] = _draft.TypeId,
            ["HasParameters"] = _draft.Parameters.Count > 0
        };
        var dialog = await DialogService.ShowAsync<MetricTypeChangeDialog>("Change metric type", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MetricTypeChangeDialog.MetricTypeChangeResult change })
        {
            return;
        }

        ChangeMetricType(change.TypeId);
    }

    private void ChangeMetricType(string? typeId)
    {
        if (_draft is null ||
            string.IsNullOrWhiteSpace(typeId) ||
            string.Equals(_draft.TypeId, typeId, StringComparison.Ordinal))
        {
            return;
        }

        if (Catalog.Describe(typeId) is not { } descriptor)
        {
            _draft.TypeId = typeId;
            return;
        }

        _draft.SetType(descriptor);
    }

    private async Task<bool> ConfirmDiscardIfDirtyAsync()
    {
        if (_draft is not { IsDirty: true })
        {
            return true;
        }

        return await ShowMetricConfirmDialogAsync(
            "Discard changes",
            "Discard unsaved metric changes?",
            "Discard",
            "danger",
            "The selected metric will stay saved as it was before editing.");
    }

    private async Task OpenReferenceDashboardAsync(MetricReferenceSummary reference)
    {
        if (string.IsNullOrWhiteSpace(reference.DashboardName) ||
            !await ConfirmDiscardIfDirtyAsync())
        {
            return;
        }

        Project.SetActiveDashboardCellReference(reference.DashboardName, reference.CellName);
    }

    private async Task<bool> ShowMetricConfirmDialogAsync(
        string title,
        string message,
        string confirmText,
        string tone,
        string? detail = null)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = title,
            ["Message"] = message,
            ["ConfirmText"] = confirmText,
            ["Tone"] = tone,
            ["Detail"] = detail
        };
        var dialog = await DialogService.ShowAsync<MetricConfirmDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private void CancelEdit() => LoadSelectedMetric();

    private Task SetSearch(string? value)
    {
        _search = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SetTypeFilter(string? value)
    {
        _typeFilter = value ?? AllTypes;
        return Task.CompletedTask;
    }

    private void OnSearchInput(ChangeEventArgs args)
        => _search = args.Value?.ToString() ?? string.Empty;

    private void ClearSearch()
        => _search = string.Empty;

    private void ResetFilters()
    {
        _search = string.Empty;
        _typeFilter = AllTypes;
    }

    private void OnDraftDisplayNameInput(ChangeEventArgs args)
    {
        if (_draft is not null)
        {
            _draft.DisplayName = args.Value?.ToString() ?? string.Empty;
        }
    }

    private void OnDraftDescriptionInput(ChangeEventArgs args)
    {
        if (_draft is not null)
        {
            _draft.Description = args.Value?.ToString() ?? string.Empty;
        }
    }

    private RenderFragment RenderParameterField(MetricParamSpec parameter)
    {
        if (_draft is null)
        {
            return @<span></span>;
        }

        var value = _draft.ParameterValue(parameter);
        var validationMessage = ParameterValidationMessage(parameter);
        var hasValidationError = !string.IsNullOrWhiteSpace(validationMessage);
        var errorElementId = ParameterErrorElementId(parameter, hasValidationError);
        if (parameter.Kind == MetricParamKind.Select && parameter.Options is { Count: > 0 } options)
        {
            return @<label class="@ParameterFieldClass(parameter, hasValidationError)"
                           id="@ParameterFieldId(parameter)"
                           tabindex="-1"
                           title="@validationMessage">
                @RenderParameterLabel(parameter)
                <span class="metrics-param-control select">
                    <select value="@value"
                            aria-label="@parameter.DisplayName"
                            aria-invalid="@AriaState(hasValidationError)"
                            aria-errormessage="@errorElementId"
                            @onchange="@((ChangeEventArgs args) => SetParameterValue(parameter.Key, args.Value?.ToString()))">
                        @if (!parameter.Required)
                        {
                            <option value="@string.Empty">Default</option>
                        }
                        @foreach (var option in options)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" aria-hidden="true" />
                </span>
            </label>;
        }

        if (parameter.Kind == MetricParamKind.Toggle)
        {
            var toggleValue = ToggleValue(value);
            return @<div class="@ParameterFieldClass(parameter, hasValidationError)"
                         id="@ParameterFieldId(parameter)"
                         tabindex="-1"
                         title="@validationMessage">
                @RenderParameterLabel(parameter)
                <div class="metrics-param-toggle"
                     role="radiogroup"
                     aria-orientation="horizontal"
                     aria-label="@parameter.DisplayName"
                     aria-invalid="@AriaState(hasValidationError)"
                     aria-errormessage="@errorElementId">
                    <button type="button"
                            class="@ToggleOptionClass(toggleValue, DefaultToggleValue)"
                            aria-checked="@AriaState(IsToggleSelected(toggleValue, DefaultToggleValue))"
                            role="radio"
                            @onclick="@(() => SetParameterValue(parameter.Key, DefaultToggleValue))">Default</button>
                    <button type="button"
                            class="@ToggleOptionClass(toggleValue, TrueValue)"
                            aria-checked="@AriaState(IsToggleSelected(toggleValue, TrueValue))"
                            role="radio"
                            @onclick="@(() => SetParameterValue(parameter.Key, TrueValue))">On</button>
                    <button type="button"
                            class="@ToggleOptionClass(toggleValue, FalseValue)"
                            aria-checked="@AriaState(IsToggleSelected(toggleValue, FalseValue))"
                            role="radio"
                            @onclick="@(() => SetParameterValue(parameter.Key, FalseValue))">Off</button>
                </div>
            </div>;
        }

        return @<label class="@ParameterFieldClass(parameter, hasValidationError)"
                       id="@ParameterFieldId(parameter)"
                       tabindex="-1"
                       title="@validationMessage">
            @RenderParameterLabel(parameter)
            <span class="metrics-param-control">
                <input type="@ParameterInputType(parameter)"
                       value="@value"
                       min="@ParameterMinimum(parameter)"
                       max="@ParameterMaximum(parameter)"
                       step="@ParameterStep(parameter)"
                       inputmode="@ParameterInputMode(parameter)"
                       placeholder="@ParameterPlaceholder(parameter)"
                       aria-label="@parameter.DisplayName"
                       aria-invalid="@AriaState(hasValidationError)"
                       aria-errormessage="@errorElementId"
                       @oninput="@((ChangeEventArgs args) => SetParameterValue(parameter.Key, args.Value?.ToString()))" />
            </span>
        </label>;
    }

    private RenderFragment RenderParameterLabel(MetricParamSpec parameter)
    {
        var assistiveText = ParameterAssistiveText(parameter);
        var meta = ParameterMetaText(parameter);
        return @<span class="metrics-param-label">
            <span>@parameter.DisplayName</span>
            <span class="metrics-param-label-tools">
                @if (!string.IsNullOrWhiteSpace(meta))
                {
                    <em>@meta</em>
                }
                @if (!string.IsNullOrWhiteSpace(assistiveText))
                {
                    <MudTooltip Text="@assistiveText">
                        <span class="metrics-param-help" role="img" tabindex="0" aria-label="@assistiveText">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" aria-hidden="true" />
                        </span>
                    </MudTooltip>
                }
            </span>
        </span>;
    }

    private void SetParameterValue(string parameterKey, string? value)
    {
        if (_draft is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            _draft.Parameters.Remove(parameterKey);
        }
        else
        {
            _draft.Parameters[parameterKey] = value.Trim();
        }
    }

    private bool TryGetLatestValue(
        string metricId,
        FluxMetricResourceDefinition resource,
        out MetricDesignerLatestValue latest)
    {
        latest = default!;
        if (!Project.TryGetLatestMetricReading(metricId, resource.Parameters, out var reading))
        {
            return false;
        }

        var formatted = MetricRegistry.Format(resource.TypeId, reading.Value);
        latest = new MetricDesignerLatestValue(formatted.FormattedValue, formatted.Unit, reading.Timestamp);
        return true;
    }

    private bool TryGetDraftPreview(out MetricDesignerLatestValue latest)
    {
        latest = default!;
        if (_draft is null ||
            string.IsNullOrWhiteSpace(_selectedMetricName) ||
            !Project.TryGetLatestMetricReading(_selectedMetricName, _draft.Parameters, out var reading))
        {
            return false;
        }

        var formatted = MetricRegistry.Format(_draft.TypeId, reading.Value);
        latest = new MetricDesignerLatestValue(formatted.FormattedValue, formatted.Unit, reading.Timestamp);
        return true;
    }

    private string RowClass(MetricDesignerRow row)
        => string.Equals(row.Id, _selectedMetricName, StringComparison.Ordinal)
            ? "metrics-row selected"
            : "metrics-row";

    private static string MetricRowLabel(MetricDesignerRow row)
    {
        var referenceCount = row.ReferenceCount.ToString(CultureInfo.InvariantCulture);
        var referenceLabel = row.ReferenceCount == 1
            ? "1 reference"
            : $"{referenceCount} references";
        var latestLabel = row.Latest is null
            ? "no latest reading"
            : string.IsNullOrWhiteSpace(row.Latest.Unit)
                ? $"latest {row.Latest.FormattedValue}"
                : $"latest {row.Latest.FormattedValue} {row.Latest.Unit}";

        return $"Select metric {row.DisplayName} ({row.Id}), {row.TypeName}, {referenceLabel}, {latestLabel}";
    }

    private static string ReferenceCountClass(int count)
        => count > 0 ? "metrics-ref-count active" : "metrics-ref-count";

    private static string ToggleValue(string? value)
        => value is TrueValue or FalseValue ? value : DefaultToggleValue;

    private static bool IsToggleSelected(string currentValue, string optionValue)
        => string.Equals(currentValue, optionValue, StringComparison.Ordinal);

    private static string ToggleOptionClass(string currentValue, string optionValue)
        => IsToggleSelected(currentValue, optionValue)
            ? "active"
            : string.Empty;

    private static string AriaState(bool value)
        => value ? "true" : "false";

    private static bool HasValidationMessage(string? value)
        => !string.IsNullOrWhiteSpace(value);

    private static string ReferenceTitle(MetricReferenceSummary reference)
    {
        var role = reference.IsPrimary ? "Primary binding" : "Binding";
        var widgetType = string.IsNullOrWhiteSpace(reference.WidgetType) ? "widget" : reference.WidgetType;
        return $"{role}: {reference.WidgetName} in {ReferenceLocationLine(reference)} ({widgetType})";
    }

    private static string ReferenceOpenLabel(MetricReferenceSummary reference)
        => string.IsNullOrWhiteSpace(reference.CellName)
            ? $"Open dashboard {reference.DashboardName} for widget {reference.WidgetName}"
            : $"Open {ReferenceLocationLine(reference)} and select widget {reference.WidgetName}";

    private static string ReferenceOpenTooltip(MetricReferenceSummary reference)
        => string.IsNullOrWhiteSpace(reference.CellName)
            ? $"Open dashboard {reference.DashboardName}"
            : $"Open {ReferenceLocationLine(reference)}";

    private static string ReferenceCellLabel(MetricReferenceSummary reference)
        => !string.IsNullOrWhiteSpace(reference.CellLabel)
            ? $"Cell {reference.CellLabel}"
            : string.IsNullOrWhiteSpace(reference.CellName)
                ? string.Empty
                : $"Cell {reference.CellName}";

    private static string ReferenceLocationLine(MetricReferenceSummary reference)
    {
        var cell = ReferenceCellLabel(reference);
        return string.IsNullOrWhiteSpace(cell)
            ? reference.DashboardName
            : $"{reference.DashboardName} · {cell}";
    }

    private static string ParameterRowClass(MetricParamSpec parameter)
        => parameter.Kind switch
        {
            MetricParamKind.Topic => "metrics-parameter-row topic",
            MetricParamKind.Text => "metrics-parameter-row wide",
            MetricParamKind.Integer or MetricParamKind.Number or MetricParamKind.Duration or MetricParamKind.Toggle or MetricParamKind.Select => "metrics-parameter-row compact",
            _ => "metrics-parameter-row"
        };

    private string? ParameterValidationMessage(MetricParamSpec parameter)
        => _draft is null ? null : MetricDesignerState.ValidateParameter(_draft, parameter);

    private static string ParameterFieldId(MetricParamSpec parameter)
        => $"metric-field-param-{FieldIdPart(parameter.Key)}";

    private static string ParameterErrorId(MetricParamSpec parameter)
        => $"metric-error-param-{FieldIdPart(parameter.Key)}";

    private static string? ParameterErrorElementId(MetricParamSpec parameter, bool hasValidationError)
        => hasValidationError ? ParameterErrorId(parameter) : null;

    private static string FieldIdPart(string value)
    {
        var cleaned = new string(
            value
                .Select(static character => char.IsAsciiLetterOrDigit(character) ? character : '-')
                .ToArray())
            .Trim('-');

        return string.IsNullOrWhiteSpace(cleaned) ? "field" : cleaned;
    }

    private static string ParameterFieldClass(MetricParamSpec parameter, bool hasValidationError)
    {
        var className = parameter.Kind == MetricParamKind.Toggle
            ? "metrics-param-field toggle"
            : "metrics-param-field";

        return hasValidationError ? $"{className} invalid" : className;
    }

    private static string ParameterInputType(MetricParamSpec parameter)
        => parameter.Kind is MetricParamKind.Integer or MetricParamKind.Number
            ? "number"
            : "text";

    private static string? ParameterInputMode(MetricParamSpec parameter)
        => parameter.Kind switch
        {
            MetricParamKind.Integer => "numeric",
            MetricParamKind.Number => "decimal",
            _ => null
        };

    private static string? ParameterMinimum(MetricParamSpec parameter)
        => parameter.Min?.ToString(CultureInfo.InvariantCulture);

    private static string? ParameterMaximum(MetricParamSpec parameter)
        => parameter.Max?.ToString(CultureInfo.InvariantCulture);

    private static string? ParameterStep(MetricParamSpec parameter)
        => parameter.Kind switch
        {
            MetricParamKind.Integer => "1",
            MetricParamKind.Number => "any",
            _ => null
        };

    private static string? ParameterPlaceholder(MetricParamSpec parameter)
        => !string.IsNullOrWhiteSpace(parameter.Placeholder)
            ? parameter.Placeholder
            : parameter.Kind switch
            {
                MetricParamKind.Topic => "factory/#",
                MetricParamKind.Duration => "60s",
                _ => null
            };

    private static string? ParameterMetaText(MetricParamSpec parameter)
    {
        if (parameter.Min.HasValue && parameter.Max.HasValue)
        {
            return $"{parameter.Min.Value}-{parameter.Max.Value}";
        }

        if (parameter.Required)
        {
            return "Required";
        }

        return null;
    }

    private static string? ParameterAssistiveText(MetricParamSpec parameter)
        => string.IsNullOrWhiteSpace(parameter.HelpText)
            ? null
            : parameter.HelpText;

    private static string ParameterCountText(MetricDescriptor descriptor)
        => descriptor.Parameters.Count == 1 ? "1 parameter" : $"{descriptor.Parameters.Count} parameters";

    private static string MetricTypeFactsText(MetricDescriptor descriptor)
    {
        var unit = string.IsNullOrWhiteSpace(descriptor.Unit) ? "unitless" : descriptor.Unit;
        return $"{unit} · {ParameterCountText(descriptor)}";
    }

    private static string FormatRelativeTime(DateTimeOffset timestamp)
    {
        var elapsed = DateTimeOffset.UtcNow - timestamp.ToUniversalTime();
        if (elapsed.TotalSeconds < 5)
        {
            return "just now";
        }

        if (elapsed.TotalMinutes < 1)
        {
            return $"{Math.Max(1, (int)elapsed.TotalSeconds)}s ago";
        }

        if (elapsed.TotalHours < 1)
        {
            return $"{Math.Max(1, (int)elapsed.TotalMinutes)}m ago";
        }

        return timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture);
    }
}

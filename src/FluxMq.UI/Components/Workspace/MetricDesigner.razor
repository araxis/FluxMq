@using FluxMq.App.Metrics
@using FluxMq.UI.Models
@inject IFluxMetricCatalog Catalog
@inject IDialogService DialogService

<div class="workspace-tab-content">
    <MudGrid Class="pa-3" Spacing="2" Style="height:100%; overflow:hidden;">
        <MudItem xs="12" md="4" Style="height:100%; overflow:hidden;">
            <MudPaper Outlined="true" Class="pa-3" Style="height:100%; overflow:auto;">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle1">Metrics</MudText>
                        <MudMenu Dense="true"
                                 Icon="@Icons.Material.Filled.Add"
                                 Size="Size.Small"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight">
                            <ChildContent>
                                @foreach (var descriptor in Catalog.Descriptors)
                                {
                                    var current = descriptor;
                                    <MudMenuItem Icon="@Icons.Material.Filled.QueryStats"
                                                 OnClick="@(() => AddMetricFromDescriptorAsync(current))">@current.DisplayName</MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    </MudStack>
                    <MudTextField T="string"
                                  Value="@_search"
                                  ValueChanged="@((string? value) => { _search = value ?? string.Empty; return Task.CompletedTask; })"
                                  Placeholder="Search metrics"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                    @if (FilteredMetrics.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            No metrics yet. Add one from a metric type.
                        </MudAlert>
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            @foreach (var metric in FilteredMetrics)
                            {
                                var currentMetric = metric;
                                var resource = Metrics[currentMetric];
                                <MudListItem T="string"
                                             Value="@currentMetric"
                                             Icon="@Icons.Material.Filled.QueryStats"
                                             Class="@(string.Equals(currentMetric, _selectedMetricName, StringComparison.Ordinal) ? "mud-primary-text" : null)"
                                             OnClick="@(() => SelectMetric(currentMetric))">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@resource.DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@currentMetric</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8" Style="height:100%; overflow:auto;">
            @if (SelectedResource is null || SelectedDescriptor is null)
            {
                <MudPaper Outlined="true" Class="pa-6">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Large" />
                        <MudText Typo="Typo.h6">No metric selected</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Add a metric from a metric type to start.</MudText>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0" Style="min-width:0;">
                            <MudText Typo="Typo.subtitle1">@_displayName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@MetricSentence</MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@DuplicateSelectedMetricAsync">Duplicate</MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DeleteOutline"
                                       OnClick="@DeleteSelectedMetricAsync">Delete</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Check"
                                       Disabled="@(!CanApply)"
                                       OnClick="@ApplyMetricAsync">Apply metric</MudButton>
                        </MudStack>
                    </MudStack>
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="Name"
                                          Value="@_displayName"
                                          ValueChanged="@SetDisplayNameAsync"
                                          Immediate="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="Description"
                                          Value="@_description"
                                          ValueChanged="@SetDescriptionAsync"
                                          Immediate="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="mt-2">@SelectedDescriptor.DisplayName</MudChip>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Parameters</MudText>
                    <MudStack Spacing="2">
                        @foreach (var parameter in SelectedDescriptor.Parameters)
                        {
                            @RenderParameterField(parameter)
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Validation</MudText>
                    @if (ValidationErrors.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">Metric is valid.</MudAlert>
                    }
                    else
                    {
                        @foreach (var error in ValidationErrors)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@error</MudAlert>
                        }
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    private long _revision = -1;
    private string _search = string.Empty;
    private string? _selectedMetricName;
    private string _displayName = string.Empty;
    private string _description = string.Empty;
    private string _typeId = TopicCountMetric.TypeId;
    private readonly Dictionary<string, string> _parameters = new(StringComparer.Ordinal);

    private const string TrueValue = "true";
    private const string FalseValue = "false";

    private IReadOnlyDictionary<string, FluxMetricResourceDefinition> Metrics => Project.GetMetricResources();

    private FluxMetricResourceDefinition? SelectedResource =>
        !string.IsNullOrWhiteSpace(_selectedMetricName) && Metrics.TryGetValue(_selectedMetricName, out var resource)
            ? resource
            : null;

    private MetricDescriptor? SelectedDescriptor => Catalog.Describe(_typeId);

    private IReadOnlyList<string> FilteredMetrics =>
        [
            .. Metrics
                .Where(metric =>
                    string.IsNullOrWhiteSpace(_search) ||
                    metric.Key.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    metric.Value.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .Select(static metric => metric.Key)
                .Order(StringComparer.OrdinalIgnoreCase)
        ];

    private string DisplayNameOrFallback =>
        string.IsNullOrWhiteSpace(_displayName) ? _selectedMetricName ?? "Metric" : _displayName.Trim();

    private FluxMetricResourceDefinition CurrentResource =>
        new()
        {
            Id = _selectedMetricName ?? string.Empty,
            TypeId = _typeId,
            DisplayName = DisplayNameOrFallback,
            Description = _description ?? string.Empty,
            Parameters = new Dictionary<string, string>(_parameters, StringComparer.Ordinal),
            Labels = SelectedResource?.Labels ?? new Dictionary<string, string>(StringComparer.Ordinal),
            ExportPolicy = SelectedResource?.ExportPolicy ?? FluxMetricExportPolicy.Disabled
        };

    private string MetricSentence => SelectedDescriptor?.Description ?? "Select a metric to edit";

    private IReadOnlyList<string> ValidationErrors
    {
        get
        {
            if (SelectedDescriptor is not { } descriptor)
            {
                return [];
            }

            return
            [
                .. descriptor.Parameters
                    .Where(parameter => parameter.Required && string.IsNullOrWhiteSpace(ParameterValue(parameter)))
                    .Select(static parameter => $"{parameter.DisplayName} is required.")
            ];
        }
    }

    private bool CanApply =>
        SelectedDescriptor is not null &&
        !string.IsNullOrWhiteSpace(_selectedMetricName) &&
        !string.IsNullOrWhiteSpace(_displayName) &&
        ValidationErrors.Count == 0;

    protected override void OnParametersSet()
    {
        if (_revision == Project.DefinitionRevision)
        {
            return;
        }

        _revision = Project.DefinitionRevision;
        if (_selectedMetricName is null || !Metrics.ContainsKey(_selectedMetricName))
        {
            _selectedMetricName = Metrics.Keys.Order(StringComparer.OrdinalIgnoreCase).FirstOrDefault();
        }

        LoadSelectedMetric();
    }

    private void SelectMetric(string metricName)
    {
        _selectedMetricName = metricName;
        LoadSelectedMetric();
    }

    private void LoadSelectedMetric()
    {
        if (SelectedResource is not { } resource)
        {
            _displayName = string.Empty;
            _description = string.Empty;
            _typeId = TopicCountMetric.TypeId;
            _parameters.Clear();
            return;
        }

        _displayName = resource.DisplayName;
        _description = resource.Description;
        _typeId = resource.TypeId;
        _parameters.Clear();
        foreach (var (key, value) in resource.Parameters)
        {
            _parameters[key] = value;
        }
    }

    private Task SetDisplayNameAsync(string? value)
    {
        _displayName = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SetDescriptionAsync(string? value)
    {
        _description = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task AddMetricFromDescriptorAsync(MetricDescriptor descriptor)
    {
        var metricName = UniqueMetricName(descriptor.DisplayName);
        var parameters = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var parameter in descriptor.Parameters)
        {
            if (!string.IsNullOrWhiteSpace(parameter.DefaultValue))
            {
                parameters[parameter.Key] = parameter.DefaultValue;
            }
        }

        Project.AddMetric(metricName);
        Project.UpdateMetric(metricName, new FluxMetricResourceDefinition
        {
            Id = metricName,
            TypeId = descriptor.TypeId,
            DisplayName = descriptor.DisplayName,
            Description = descriptor.Description,
            Parameters = parameters
        });
        _selectedMetricName = metricName;
        _revision = -1;
        await InvokeAsync(StateHasChanged);
    }

    private Task ApplyMetricAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedMetricName) || SelectedDescriptor is null)
        {
            return Task.CompletedTask;
        }

        Project.UpdateMetric(_selectedMetricName, CurrentResource);
        _revision = -1;
        return Task.CompletedTask;
    }

    private Task DuplicateSelectedMetricAsync()
    {
        if (!string.IsNullOrWhiteSpace(_selectedMetricName))
        {
            Project.DuplicateMetric(_selectedMetricName);
            _revision = -1;
        }

        return Task.CompletedTask;
    }

    private async Task DeleteSelectedMetricAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedMetricName))
        {
            return;
        }

        var references = Project.CountMetricReferences(_selectedMetricName);
        var message = references == 0
            ? $"Delete metric '{_selectedMetricName}'?"
            : $"Delete metric '{_selectedMetricName}'? {references} dashboard binding(s) will need another metric.";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete metric",
            message,
            "Delete",
            null,
            "Cancel",
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });
        if (confirmed == true)
        {
            Project.RemoveMetric(_selectedMetricName);
            _selectedMetricName = null;
            _revision = -1;
        }
    }

    private string ParameterValue(MetricParamSpec parameter)
        => _parameters.TryGetValue(parameter.Key, out var value) ? value : parameter.DefaultValue ?? string.Empty;

    private RenderFragment RenderParameterField(MetricParamSpec parameter)
    {
        var value = ParameterValue(parameter);
        if (parameter.Kind == MetricParamKind.Select && parameter.Options is { Count: > 0 } options)
        {
            return @<MudSelect T="string"
                               Label="@parameter.DisplayName"
                               Value="@value"
                               ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               HelperText="@parameter.HelpText">
                @foreach (var option in options)
                {
                    <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>;
        }

        if (parameter.Kind == MetricParamKind.Toggle)
        {
            return @<MudSelect T="string"
                               Label="@parameter.DisplayName"
                               Value="@value"
                               ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               HelperText="@parameter.HelpText">
                <MudSelectItem Value="@string.Empty">Default</MudSelectItem>
                <MudSelectItem Value="@TrueValue">On</MudSelectItem>
                <MudSelectItem Value="@FalseValue">Off</MudSelectItem>
            </MudSelect>;
        }

        var inputType = parameter.Kind is MetricParamKind.Integer or MetricParamKind.Number
            ? InputType.Number
            : InputType.Text;
        return @<MudTextField T="string"
                              Label="@parameter.DisplayName"
                              Value="@value"
                              ValueChanged="@(next => SetParameterValue(parameter.Key, next))"
                              Placeholder="@parameter.Placeholder"
                              InputType="@inputType"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="@parameter.HelpText" />;
    }

    private void SetParameterValue(string parameterKey, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _parameters.Remove(parameterKey);
        }
        else
        {
            _parameters[parameterKey] = value.Trim();
        }
    }

    private string UniqueMetricName(string preferred)
    {
        var id = FluxMetricNaming.ToArtifactId(preferred);
        if (!Project.MetricNames.Contains(id, StringComparer.Ordinal))
        {
            return id;
        }

        var index = 2;
        while (Project.MetricNames.Contains($"{id}{index}", StringComparer.Ordinal))
        {
            index++;
        }

        return $"{id}{index}";
    }
}

@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

@if (Projects.Projects.Count == 0)
{
    <div class="tree-empty">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Medium" />
        <div>
            <div class="tree-empty-title">No apps open</div>
            <div class="tree-empty-copy">Create or open a project from the top bar.</div>
        </div>
    </div>
}
else
{
    <div class="app-tree">
        @foreach (var app in Projects.Projects)
        {
            var a = app;
            var isActive = a == Projects.ActiveProject;
            var conns = GetConnections(a);
            var brokersCollapsed = IsSectionCollapsed(a, BrokerSection);
            var pipelinesCollapsed = IsSectionCollapsed(a, PipelineSection);
            var metricsCollapsed = IsSectionCollapsed(a, MetricSection);
            var dashboardsCollapsed = IsSectionCollapsed(a, DashboardSection);
            var testsCollapsed = IsSectionCollapsed(a, TestSection);

            <section class="app-card @(isActive ? "active" : null)" @key="a">
                <div class="app-row" @onclick="@(() => Projects.SetActive(a))">
                    <MudIcon Icon="@(isActive ? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.Folder)"
                             Size="Size.Small"
                             Class="app-row-icon" />
                    <div class="app-row-text">
                        <div class="app-name">@a.Name</div>
                        <div class="app-meta">
                            @BuildAppMeta(a)
                            @if (a.HasUnsavedChanges)
                            {
                                <span class="dirty-dot">Unsaved</span>
                            }
                        </div>
                    </div>
                    <div class="app-actions" @onclick:stopPropagation="true">
                        <MudTooltip Text="Close app">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Cancel"
                                           Class="tree-icon-button"
                                           OnClick="@(() => CloseAsync(a))" />
                        </MudTooltip>
                    </div>
                </div>

                <div class="tree-section">
                    <div class="tree-section-header" @onclick="@(() => ToggleSection(a, BrokerSection))">
                        <div class="tree-section-title">
                            <MudIcon Icon="@CollapseIcon(brokersCollapsed)"
                                     Size="Size.Small"
                                     Class="tree-section-chevron" />
                            <MudIcon Icon="@Icons.Material.Filled.Hub"
                                     Size="Size.Small"
                                     Class="tree-section-icon brokers" />
                            <span>Brokers</span>
                            <span class="tree-section-count">@conns.Count</span>
                        </div>
                        <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <MudTooltip Text="Add connection">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               Class="tree-icon-button"
                                               OnClick="@(() => AddConnectionAsync(a))" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!brokersCollapsed && conns.Count == 0)
                    {
                        <div class="tree-muted-row">No connections</div>
                    }
                    else if (!brokersCollapsed)
                    {
                        foreach (var conn in conns)
                        {
                            var c = conn;
                            <div class="conn-item" @key="c.Id">
                                <span class="@StateDotClass(c.State)"></span>
                                <div class="conn-text">
                                    <div class="conn-name">@c.ResourceName</div>
                                    <div class="conn-endpoint">@c.Profile.Host:@c.Profile.Port</div>
                                </div>
                                <div class="conn-actions">
                                    @if (c.State is MqttClientState.Disconnected or MqttClientState.Faulted)
                                    {
                                        <MudTooltip Text="Connect">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.PlayArrow"
                                                           Color="Color.Success"
                                                           Class="tree-icon-button"
                                                           OnClick="@(() => Live.ConnectAsync(c.Id))" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Disconnect">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.Stop"
                                                           Color="Color.Error"
                                                           Class="tree-icon-button"
                                                           OnClick="@(() => Live.DisconnectAsync(c.Id))" />
                                        </MudTooltip>
                                    }
                                    <MudTooltip Text="Remove">
                                        <MudIconButton Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Class="tree-icon-button"
                                                       OnClick="@(() => Live.RemoveConnectionAsync(c.Id))" />
                                    </MudTooltip>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="tree-section">
                    <div class="tree-section-header" @onclick="@(() => ToggleSection(a, PipelineSection))">
                        <div class="tree-section-title">
                            <MudIcon Icon="@CollapseIcon(pipelinesCollapsed)"
                                     Size="Size.Small"
                                     Class="tree-section-chevron" />
                            <MudIcon Icon="@Icons.Material.Filled.Timeline"
                                     Size="Size.Small"
                                     Class="tree-section-icon pipelines" />
                            <span>Pipelines</span>
                            <span class="tree-section-count">@a.WorkflowNames.Count</span>
                        </div>
                        <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <MudTooltip Text="Add pipeline">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               Class="tree-icon-button"
                                               OnClick="@(() => AddPipelineAsync(a))" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!pipelinesCollapsed && a.WorkflowNames.Count == 0)
                    {
                        <div class="tree-muted-row">No pipelines</div>
                    }
                    else if (!pipelinesCollapsed)
                    {
                        foreach (var wf in a.WorkflowNames)
                        {
                            var w = wf;
                            var isPipeActive = a == Projects.ActiveProject &&
                                a.ActiveArtifactKind == WorkspaceArtifactKind.Pipeline &&
                                string.Equals(w, a.ActiveWorkflowName, StringComparison.Ordinal);
                            <div class="pipe-item @(isPipeActive ? "active" : null)"
                                 @onclick="@(() => { Projects.SetActive(a); a.SetActiveWorkflow(w); })">
                                <MudIcon Icon="@Icons.Material.Filled.Timeline"
                                         Size="Size.Small"
                                         Class="pipe-icon" />
                                <span>@w</span>
                            </div>
                        }
                    }
                </div>

                <div class="tree-section">
                    <div class="tree-section-header" @onclick="@(() => ToggleSection(a, MetricSection))">
                        <div class="tree-section-title">
                            <MudIcon Icon="@CollapseIcon(metricsCollapsed)"
                                     Size="Size.Small"
                                     Class="tree-section-chevron" />
                            <MudIcon Icon="@Icons.Material.Filled.QueryStats"
                                     Size="Size.Small"
                                     Class="tree-section-icon dashboards" />
                            <span>Metrics</span>
                            <span class="tree-section-count">@a.MetricNames.Count</span>
                        </div>
                        <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <MudTooltip Text="Add metric">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               Class="tree-icon-button"
                                               OnClick="@(() => AddMetricAsync(a))" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!metricsCollapsed && a.MetricNames.Count == 0)
                    {
                        <div class="tree-muted-row">No metrics</div>
                    }
                    else if (!metricsCollapsed)
                    {
                        <div class="artifact-item @(a == Projects.ActiveProject && a.ActiveArtifactKind == WorkspaceArtifactKind.Metrics ? "active" : null)"
                             @onclick="@(() => { Projects.SetActive(a); a.SetActiveMetrics(); })">
                            <MudIcon Icon="@Icons.Material.Filled.QueryStats"
                                     Size="Size.Small"
                                     Class="artifact-icon dashboard" />
                            <span>Metric Designer</span>
                        </div>
                    }
                </div>

                <div class="tree-section">
                    <div class="tree-section-header" @onclick="@(() => ToggleSection(a, DashboardSection))">
                        <div class="tree-section-title">
                            <MudIcon Icon="@CollapseIcon(dashboardsCollapsed)"
                                     Size="Size.Small"
                                     Class="tree-section-chevron" />
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                                     Size="Size.Small"
                                     Class="tree-section-icon dashboards" />
                            <span>Dashboards</span>
                            <span class="tree-section-count">@a.DashboardNames.Count</span>
                        </div>
                        <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <MudTooltip Text="Add dashboard">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               Class="tree-icon-button"
                                               OnClick="@(() => AddDashboardAsync(a))" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!dashboardsCollapsed && a.DashboardNames.Count == 0)
                    {
                        <div class="tree-muted-row">No dashboards</div>
                    }
                    else if (!dashboardsCollapsed)
                    {
                        foreach (var dashboard in a.DashboardNames)
                        {
                            var d = dashboard;
                            var isDashboardActive = a == Projects.ActiveProject &&
                                a.ActiveArtifactKind == WorkspaceArtifactKind.Dashboard &&
                                string.Equals(d, a.ActiveDashboardName, StringComparison.Ordinal);
                            <div class="artifact-item @(isDashboardActive ? "active" : null)"
                                 @onclick="@(() => { Projects.SetActive(a); a.SetActiveDashboard(d); })">
                                <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                                         Size="Size.Small"
                                         Class="artifact-icon dashboard" />
                                <span>@d</span>
                            </div>
                        }
                    }
                </div>

                <div class="tree-section">
                    <div class="tree-section-header" @onclick="@(() => ToggleSection(a, TestSection))">
                        <div class="tree-section-title">
                            <MudIcon Icon="@CollapseIcon(testsCollapsed)"
                                     Size="Size.Small"
                                     Class="tree-section-chevron" />
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                                     Size="Size.Small"
                                     Class="tree-section-icon tests" />
                            <span>Test scenarios</span>
                            <span class="tree-section-count">@a.TestNames.Count</span>
                        </div>
                        <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                            <MudTooltip Text="Add test">
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.Add"
                                               Class="tree-icon-button"
                                               OnClick="@(() => AddTestAsync(a))" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!testsCollapsed && a.TestNames.Count == 0)
                    {
                        <div class="tree-muted-row">No tests</div>
                    }
                    else if (!testsCollapsed)
                    {
                        foreach (var test in a.TestNames)
                        {
                            var t = test;
                            var isTestActive = a == Projects.ActiveProject &&
                                a.ActiveArtifactKind == WorkspaceArtifactKind.Test &&
                                string.Equals(t, a.ActiveTestName, StringComparison.Ordinal);
                            <div class="artifact-item @(isTestActive ? "active" : null)"
                                 @onclick="@(() => { Projects.SetActive(a); a.SetActiveTest(t); })">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                                         Size="Size.Small"
                                         Class="artifact-icon test" />
                                <span>@t</span>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    private const string BrokerSection = "brokers";
    private const string PipelineSection = "pipelines";
    private const string MetricSection = "metrics";
    private const string DashboardSection = "dashboards";
    private const string TestSection = "tests";

    private readonly HashSet<FlowWorkspaceService> _subscribed = [];
    private readonly Dictionary<FlowWorkspaceService, HashSet<string>> _collapsedSections = [];

    protected override void OnInitialized()
    {
        Projects.Changed += OnChanged;
        Live.Changed += OnChanged;
        SyncSubscriptions();
    }

    private List<ManagedConnection> GetConnections(FlowWorkspaceService app)
    {
        var profiles = app.GetConnectionProfiles();
        return Live.Connections.Where(c =>
            profiles.Any(p =>
                string.Equals(p.Profile.Host, c.Profile.Host, StringComparison.OrdinalIgnoreCase) &&
                p.Profile.Port == c.Profile.Port) ||
            app.GetConnectionNames().Any(name => string.Equals(name, c.ResourceName, StringComparison.Ordinal))).ToList();
    }

    private static string BuildAppMeta(FlowWorkspaceService app)
    {
        var parts = new[]
        {
            CountLabel(app.WorkflowNames.Count, "pipeline"),
            CountLabel(app.MetricNames.Count, "metric"),
            CountLabel(app.DashboardNames.Count, "dashboard"),
            CountLabel(app.TestNames.Count, "test")
        };

        return string.Join(" / ", parts);
    }

    private static string CountLabel(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private void SyncSubscriptions()
    {
        foreach (var app in Projects.Projects)
            if (_subscribed.Add(app))
                app.Changed += OnChanged;

        foreach (var stale in _subscribed.Where(p => !Projects.Projects.Contains(p)).ToList())
        {
            stale.Changed -= OnChanged;
            _subscribed.Remove(stale);
            _collapsedSections.Remove(stale);
        }
    }

    private bool IsSectionCollapsed(FlowWorkspaceService app, string section)
        => _collapsedSections.TryGetValue(app, out var sections) && sections.Contains(section);

    private void ToggleSection(FlowWorkspaceService app, string section)
    {
        if (!_collapsedSections.TryGetValue(app, out var sections))
        {
            _collapsedSections[app] = [section];
            return;
        }

        if (!sections.Add(section))
            sections.Remove(section);

        if (sections.Count == 0)
            _collapsedSections.Remove(app);
    }

    private void ExpandSection(FlowWorkspaceService app, string section)
    {
        if (!_collapsedSections.TryGetValue(app, out var sections))
            return;

        sections.Remove(section);
        if (sections.Count == 0)
            _collapsedSections.Remove(app);
    }

    private static string CollapseIcon(bool isCollapsed)
        => isCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore;

    private Task CloseAsync(FlowWorkspaceService app) => Projects.CloseProjectAsync(app).AsTask();

    private async Task AddConnectionAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>("New Connection",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
        {
            var resourceKey = string.IsNullOrWhiteSpace(r.Profile.Name)
                ? "connection"
                : r.Profile.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            app.UpsertConnectionResource(resourceKey, r.Profile);
            Live.AddConnectionIfAbsent(r.Profile, r.Subscription, resourceKey);
            ExpandSection(app, BrokerSection);
        }
    }

    private async Task AddPipelineAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>("New Pipeline");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddWorkflow(name.Trim());
            app.SetActiveWorkflow(name.Trim());
            ExpandSection(app, PipelineSection);
        }
    }

    private async Task AddDashboardAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Dashboard",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Dashboard"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddDashboard(name.Trim());
            ExpandSection(app, DashboardSection);
        }
    }

    private async Task AddMetricAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Metric",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Metric"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddMetric(name.Trim());
            app.SetActiveMetrics();
            ExpandSection(app, MetricSection);
        }
    }

    private async Task AddTestAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Test",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Test"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddTest(name.Trim());
            ExpandSection(app, TestSection);
        }
    }

    private static string StateDotClass(MqttClientState state) => state switch
    {
        MqttClientState.Connected => "conn-dot live",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "conn-dot pending",
        MqttClientState.Faulted => "conn-dot faulted",
        _ => "conn-dot"
    };

    private void OnChanged(object? sender, EventArgs e)
    {
        SyncSubscriptions();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Projects.Changed -= OnChanged;
        Live.Changed -= OnChanged;
        foreach (var app in _subscribed)
            app.Changed -= OnChanged;
        _subscribed.Clear();
        _collapsedSections.Clear();
    }
}

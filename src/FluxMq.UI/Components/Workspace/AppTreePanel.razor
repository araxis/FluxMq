@using FluxMq.Scenarios
@implements IDisposable
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService

@if (Projects.Projects.Count == 0)
{
    <div class="tree-empty" role="status" aria-live="polite">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Medium" aria-hidden="true" />
        <div>
            <div class="tree-empty-title">No apps open</div>
            <div class="tree-empty-copy">Create or open a project from the top bar.</div>
        </div>
    </div>
}
else
{
    <div class="app-tree" aria-label="App structure tree">
        @foreach (var app in Projects.Projects)
        {
            var a = app;
            var isActive = a == Projects.ActiveProject;
            var conns = GetConnections(a);
            var brokersCollapsed = IsSectionCollapsed(a, BrokerSection);
            var pipelinesCollapsed = IsSectionCollapsed(a, PipelineSection);
            var metricsCollapsed = IsSectionCollapsed(a, MetricSection);
            var dashboardsCollapsed = IsSectionCollapsed(a, DashboardSection);
            var testsCollapsed = IsSectionCollapsed(a, TestSection);

            <section class="app-card @(isActive ? "active" : null)" @key="a">
                <div class="app-row"
                     role="button"
                     tabindex="0"
                     aria-label="@AppRowLabel(a, isActive)"
                     aria-current="@TreeItemCurrent(isActive)"
                     aria-keyshortcuts="Enter Space"
                     title="@AppRowLabel(a, isActive)"
                     @onclick="@(() => SelectApp(a))"
                     @onkeydown="@((KeyboardEventArgs args) => SelectAppFromKeyboardAsync(args, a))">
                    <MudIcon Icon="@(isActive ? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.Folder)"
                             Size="Size.Small"
                             Class="app-row-icon"
                             aria-hidden="true" />
                    <div class="app-row-text">
                        <div class="app-name">@a.Name</div>
                        <div class="app-meta">
                            @BuildAppMeta(a)
                            @if (a.HasUnsavedChanges)
                            {
                                <span class="dirty-dot">Unsaved</span>
                            }
                        </div>
                    </div>
                    <div class="app-actions" @onclick:stopPropagation="true">
                        <MudTooltip Text="Close app">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Cancel"
                                           Class="tree-icon-button"
                                           aria-label="@($"Close app {a.Name}")"
                                           OnClick="@(() => CloseAsync(a))" />
                        </MudTooltip>
                    </div>
                </div>

                <div class="tree-section">
                    @TreeSectionHeader(
                        a,
                        BrokerSection,
                        brokersCollapsed,
                        Icons.Material.Filled.Hub,
                        "brokers",
                        "Brokers",
                        conns.Count,
                        "Add connection",
                        AddConnectionAsync)

                    <div id="@TreeSectionBodyId(a, BrokerSection)" class="tree-section-body">
                        @if (!brokersCollapsed && conns.Count == 0)
                        {
                            <div class="tree-muted-row">No connections</div>
                        }
                        else if (!brokersCollapsed)
                        {
                            foreach (var conn in conns)
                            {
                                var c = conn;
                                <div class="conn-item" @key="c.Id">
                                    <span class="@ConnectionDotClass(c.State)"></span>
                                    <div class="conn-text">
                                        <div class="conn-name">@c.ResourceName</div>
                                        <div class="conn-endpoint">@c.Profile.Host:@c.Profile.Port</div>
                                    </div>
                                    <div class="conn-actions">
                                        @if (c.State is MqttClientState.Disconnected or MqttClientState.Faulted)
                                        {
                                            <MudTooltip Text="Connect">
                                                <MudIconButton Size="Size.Small"
                                                               Icon="@Icons.Material.Filled.PlayArrow"
                                                               Color="Color.Success"
                                                               Class="tree-icon-button"
                                                               aria-label="@($"Connect {c.ResourceName}")"
                                                               OnClick="@(() => Live.ConnectAsync(c.Id))" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="Disconnect">
                                                <MudIconButton Size="Size.Small"
                                                               Icon="@Icons.Material.Filled.Stop"
                                                               Color="Color.Error"
                                                               Class="tree-icon-button"
                                                               aria-label="@($"Disconnect {c.ResourceName}")"
                                                               OnClick="@(() => Live.DisconnectAsync(c.Id))" />
                                            </MudTooltip>
                                        }
                                        <MudTooltip Text="Remove">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Class="tree-icon-button"
                                                           aria-label="@($"Remove connection {c.ResourceName}")"
                                                           OnClick="@(() => Live.RemoveConnectionAsync(c.Id))" />
                                        </MudTooltip>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="tree-section">
                    @TreeSectionHeader(
                        a,
                        PipelineSection,
                        pipelinesCollapsed,
                        Icons.Material.Filled.Timeline,
                        "pipelines",
                        "Pipelines",
                        a.WorkflowNames.Count,
                        "Add pipeline",
                        AddPipelineAsync)

                    <div id="@TreeSectionBodyId(a, PipelineSection)" class="tree-section-body">
                        @if (!pipelinesCollapsed && a.WorkflowNames.Count == 0)
                        {
                            <div class="tree-muted-row">No pipelines</div>
                        }
                        else if (!pipelinesCollapsed)
                        {
                            foreach (var wf in a.WorkflowNames)
                            {
                                var w = wf;
                                var isPipeActive = a == Projects.ActiveProject &&
                                    a.ActiveArtifactKind == WorkspaceArtifactKind.Pipeline &&
                                    string.Equals(w, a.ActiveWorkflowName, StringComparison.Ordinal);
                                <div class="pipe-item @(isPipeActive ? "active" : null)"
                                     role="button"
                                     tabindex="0"
                                     aria-label="@($"Open pipeline {w}")"
                                     aria-current="@TreeItemCurrent(isPipeActive)"
                                     aria-keyshortcuts="Enter Space"
                                     @onclick="@(() => SelectPipeline(a, w))"
                                     @onkeydown="@((KeyboardEventArgs args) => SelectPipelineFromKeyboardAsync(args, a, w))">
                                    <MudIcon Icon="@Icons.Material.Filled.Timeline"
                                             Size="Size.Small"
                                             Class="pipe-icon"
                                             aria-hidden="true" />
                                    <span>@w</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="tree-section">
                    @TreeSectionHeader(
                        a,
                        MetricSection,
                        metricsCollapsed,
                        Icons.Material.Filled.QueryStats,
                        "dashboards",
                        "Metrics",
                        a.MetricNames.Count,
                        "Add metric",
                        AddMetricAsync)

                    <div id="@TreeSectionBodyId(a, MetricSection)" class="tree-section-body">
                        @if (!metricsCollapsed && a.MetricNames.Count == 0)
                        {
                            <div class="tree-muted-row">No metrics</div>
                        }
                        else if (!metricsCollapsed)
                        {
                            var isMetricsActive = a == Projects.ActiveProject &&
                                a.ActiveArtifactKind == WorkspaceArtifactKind.Metrics;
                            <div class="artifact-item @(isMetricsActive ? "active" : null)"
                                 role="button"
                                 tabindex="0"
                                 aria-label="Open metric designer"
                                 aria-current="@TreeItemCurrent(isMetricsActive)"
                                 aria-keyshortcuts="Enter Space"
                                 @onclick="@(() => SelectMetrics(a))"
                                 @onkeydown="@((KeyboardEventArgs args) => SelectMetricsFromKeyboardAsync(args, a))">
                                <MudIcon Icon="@Icons.Material.Filled.QueryStats"
                                         Size="Size.Small"
                                         Class="artifact-icon dashboard"
                                         aria-hidden="true" />
                                <span>Metric Designer</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="tree-section">
                    @TreeSectionHeader(
                        a,
                        DashboardSection,
                        dashboardsCollapsed,
                        Icons.Material.Filled.Dashboard,
                        "dashboards",
                        "Dashboards",
                        a.DashboardNames.Count,
                        "Add dashboard",
                        AddDashboardAsync)

                    <div id="@TreeSectionBodyId(a, DashboardSection)" class="tree-section-body">
                        @if (!dashboardsCollapsed && a.DashboardNames.Count == 0)
                        {
                            <div class="tree-muted-row">No dashboards</div>
                        }
                        else if (!dashboardsCollapsed)
                        {
                            foreach (var dashboard in a.DashboardNames)
                            {
                                var d = dashboard;
                                var isDashboardActive = a == Projects.ActiveProject &&
                                    a.ActiveArtifactKind == WorkspaceArtifactKind.Dashboard &&
                                    string.Equals(d, a.ActiveDashboardName, StringComparison.Ordinal);
                                <div class="artifact-item @(isDashboardActive ? "active" : null)"
                                     role="button"
                                     tabindex="0"
                                     aria-label="@($"Open dashboard {d}")"
                                     aria-current="@TreeItemCurrent(isDashboardActive)"
                                     aria-keyshortcuts="Enter Space"
                                     @onclick="@(() => SelectDashboard(a, d))"
                                     @onkeydown="@((KeyboardEventArgs args) => SelectDashboardFromKeyboardAsync(args, a, d))">
                                    <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                                             Size="Size.Small"
                                             Class="artifact-icon dashboard"
                                             aria-hidden="true" />
                                    <span>@d</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="tree-section">
                    @TreeSectionHeader(
                        a,
                        TestSection,
                        testsCollapsed,
                        Icons.Material.Filled.FactCheck,
                        "tests",
                        "Test scenarios",
                        a.TestNames.Count,
                        "Add test",
                        AddTestAsync)

                    <div id="@TreeSectionBodyId(a, TestSection)" class="tree-section-body">
                        @if (!testsCollapsed && a.TestNames.Count == 0)
                        {
                            <div class="tree-empty-artifact-row tests"
                                 role="button"
                                 tabindex="0"
                                 aria-label="Create test scenario"
                                 aria-keyshortcuts="Enter Space"
                                 @onclick="@(() => AddTestAsync(a))"
                                 @onkeydown="@((KeyboardEventArgs args) => AddTestFromKeyboardAsync(args, a))">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                                         Size="Size.Small"
                                         Class="tree-empty-artifact-icon"
                                         aria-hidden="true" />
                                <div class="tree-empty-artifact-copy">
                                    <span>No tests</span>
                                    <small>Create a scenario to design and run checks.</small>
                                </div>
                                <div class="tree-empty-artifact-cues" aria-hidden="true">
                                    <span>Design</span>
                                    <span>Run</span>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.Add"
                                         Size="Size.Small"
                                         Class="tree-empty-artifact-add"
                                         aria-hidden="true" />
                            </div>
                        }
                        else if (!testsCollapsed)
                        {
                            foreach (var test in a.TestNames)
                            {
                                var t = test;
                                var isTestActive = a == Projects.ActiveProject &&
                                    a.ActiveArtifactKind == WorkspaceArtifactKind.Test &&
                                    string.Equals(t, a.ActiveTestName, StringComparison.Ordinal);
                                var latestTestRun = LatestTestRun(a, t);
                                <div class="@TestArtifactItemClass(isTestActive, latestTestRun)"
                                     role="button"
                                     tabindex="0"
                                     title="@TestArtifactTitle(t, latestTestRun)"
                                     aria-label="@TestArtifactTitle(t, latestTestRun)"
                                     aria-current="@TreeItemCurrent(isTestActive)"
                                     aria-keyshortcuts="Enter Space"
                                     @onclick="@(() => SelectTest(a, t))"
                                     @onkeydown="@((KeyboardEventArgs args) => SelectTestFromKeyboardAsync(args, a, t))">
                                    <span class="test-artifact-icon-frame" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.FactCheck"
                                                 Size="Size.Small"
                                                 Class="artifact-icon test"
                                                 aria-hidden="true" />
                                    </span>
                                    <div class="artifact-item-copy test-artifact-copy">
                                        <span>@t</span>
                                        <small>@TestRunMeta(latestTestRun)</small>
                                    </div>
                                    <div class="@TestRunSummaryClass(latestTestRun)"
                                         aria-label="@TestRunSummaryLabel(latestTestRun)">
                                        <span class="@TestRunMarkerClass(latestTestRun)">
                                            <MudIcon Icon="@TestRunIcon(latestTestRun)" Size="Size.Small" aria-hidden="true" />
                                            <span>@TestRunText(latestTestRun)</span>
                                        </span>
                                        <span class="test-run-summary-meta">@TestRunDetailText(latestTestRun)</span>
                                    </div>
                                    <span class="tree-item-actions"
                                          @onclick:stopPropagation="true"
                                          @onmousedown:stopPropagation="true">
                                        <MudTooltip Text="Delete test">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Class="tree-icon-button tree-delete-button"
                                                           aria-label="@($"Delete test {t}")"
                                                           OnClick="@(() => RemoveTestAsync(a, t))" />
                                        </MudTooltip>
                                    </span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    private const string BrokerSection = "brokers";
    private const string PipelineSection = "pipelines";
    private const string MetricSection = "metrics";
    private const string DashboardSection = "dashboards";
    private const string TestSection = "tests";

    private readonly HashSet<FlowWorkspaceService> _subscribed = [];
    private readonly Dictionary<FlowWorkspaceService, HashSet<string>> _collapsedSections = [];

    private RenderFragment TreeSectionHeader(
        FlowWorkspaceService app,
        string section,
        bool isCollapsed,
        string icon,
        string iconClass,
        string title,
        int count,
        string addTooltip,
        Func<FlowWorkspaceService, Task> addAction) => @<div class="tree-section-header"
            role="button"
            tabindex="0"
            aria-expanded="@AriaExpanded(isCollapsed)"
            aria-controls="@TreeSectionBodyId(app, section)"
            aria-label="@SectionHeaderLabel(title, count, isCollapsed)"
            aria-keyshortcuts="Enter Space"
            @onclick="@(() => ToggleSection(app, section))"
            @onkeydown="@((KeyboardEventArgs args) => ToggleSectionFromKeyboardAsync(args, app, section))">
            <div class="tree-section-title">
                <MudIcon Icon="@CollapseIcon(isCollapsed)"
                         Size="Size.Small"
                         Class="tree-section-chevron"
                         aria-hidden="true" />
                <MudIcon Icon="@icon"
                         Size="Size.Small"
                         Class="@($"tree-section-icon {iconClass}")"
                         aria-hidden="true" />
                <span>@title</span>
                <span class="tree-section-count">@count</span>
            </div>
            <div class="tree-section-actions" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                <MudTooltip Text="@addTooltip">
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Add"
                                   Class="tree-icon-button"
                                   aria-label="@addTooltip"
                                   OnClick="@(() => addAction(app))" />
                </MudTooltip>
            </div>
        </div>;

    protected override void OnInitialized()
    {
        Projects.Changed += OnChanged;
        Live.Changed += OnChanged;
        SyncSubscriptions();
    }

    private List<ManagedConnection> GetConnections(FlowWorkspaceService app)
    {
        var profiles = app.GetConnectionProfiles();
        return Live.Connections.Where(c =>
            profiles.Any(p =>
                string.Equals(p.Profile.Host, c.Profile.Host, StringComparison.OrdinalIgnoreCase) &&
                p.Profile.Port == c.Profile.Port) ||
            app.GetConnectionNames().Any(name => string.Equals(name, c.ResourceName, StringComparison.Ordinal))).ToList();
    }

    private static string BuildAppMeta(FlowWorkspaceService app)
    {
        var parts = new[]
        {
            CountLabel(app.WorkflowNames.Count, "pipeline"),
            CountLabel(app.MetricNames.Count, "metric"),
            CountLabel(app.DashboardNames.Count, "dashboard"),
            CountLabel(app.TestNames.Count, "test")
        };

        return string.Join(" / ", parts);
    }

    private static string CountLabel(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private static string AriaExpanded(bool isCollapsed)
        => isCollapsed ? "false" : "true";

    private static string SectionHeaderLabel(string title, int count, bool isCollapsed)
        => $"{title} {count}. {(isCollapsed ? "Collapsed" : "Expanded")}.";

    private static string TreeSectionBodyId(FlowWorkspaceService app, string section)
        => $"app-tree-section-{SanitizeIdToken(app.Name)}-{System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(app)}-{SanitizeIdToken(section)}";

    private static string SanitizeIdToken(string value)
    {
        var builder = new System.Text.StringBuilder(value.Length);
        foreach (var current in value)
        {
            builder.Append(char.IsLetterOrDigit(current) || current is '-' or '_' ? current : '-');
        }

        return builder.Length == 0 ? "section" : builder.ToString();
    }

    private static string AppRowLabel(FlowWorkspaceService app, bool isActive)
    {
        var state = isActive ? "active" : "inactive";
        var saved = app.HasUnsavedChanges ? "unsaved changes" : "saved";
        return $"{app.Name}, {state}, {saved}, {BuildAppMeta(app)}";
    }

    private static string? TreeItemCurrent(bool isActive)
        => isActive ? "true" : null;

    private static bool IsActivationKey(KeyboardEventArgs args)
        => args.Key is "Enter" or " " or "Spacebar";

    private static Task RunFromKeyboardAsync(KeyboardEventArgs args, Action action)
    {
        if (IsActivationKey(args))
        {
            action();
        }

        return Task.CompletedTask;
    }

    private void SelectApp(FlowWorkspaceService app)
        => Projects.SetActive(app);

    private void SelectPipeline(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveWorkflow(name);
    }

    private void SelectMetrics(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        app.SetActiveMetrics();
    }

    private void SelectDashboard(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveDashboard(name);
    }

    private void SelectTest(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        app.SetActiveTest(name);
    }

    private Task SelectAppFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app)
        => RunFromKeyboardAsync(args, () => SelectApp(app));

    private Task ToggleSectionFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app, string section)
        => RunFromKeyboardAsync(args, () => ToggleSection(app, section));

    private Task SelectPipelineFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app, string name)
        => RunFromKeyboardAsync(args, () => SelectPipeline(app, name));

    private Task SelectMetricsFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app)
        => RunFromKeyboardAsync(args, () => SelectMetrics(app));

    private Task SelectDashboardFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app, string name)
        => RunFromKeyboardAsync(args, () => SelectDashboard(app, name));

    private Task SelectTestFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app, string name)
        => RunFromKeyboardAsync(args, () => SelectTest(app, name));

    private void SyncSubscriptions()
    {
        foreach (var app in Projects.Projects)
            if (_subscribed.Add(app))
                app.Changed += OnChanged;

        foreach (var stale in _subscribed.Where(p => !Projects.Projects.Contains(p)).ToList())
        {
            stale.Changed -= OnChanged;
            _subscribed.Remove(stale);
            _collapsedSections.Remove(stale);
        }
    }

    private bool IsSectionCollapsed(FlowWorkspaceService app, string section)
        => _collapsedSections.TryGetValue(app, out var sections) && sections.Contains(section);

    private void ToggleSection(FlowWorkspaceService app, string section)
    {
        if (!_collapsedSections.TryGetValue(app, out var sections))
        {
            _collapsedSections[app] = [section];
            return;
        }

        if (!sections.Add(section))
            sections.Remove(section);

        if (sections.Count == 0)
            _collapsedSections.Remove(app);
    }

    private void ExpandSection(FlowWorkspaceService app, string section)
    {
        if (!_collapsedSections.TryGetValue(app, out var sections))
            return;

        sections.Remove(section);
        if (sections.Count == 0)
            _collapsedSections.Remove(app);
    }

    private static string CollapseIcon(bool isCollapsed)
        => isCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore;

    private static ScenarioRunResult? LatestTestRun(FlowWorkspaceService app, string testName)
        => app.ScenarioRunHistory.FirstOrDefault(result =>
            string.Equals(result.Name, testName, StringComparison.Ordinal));

    private static string TestArtifactItemClass(bool isActive, ScenarioRunResult? latestRun)
    {
        var parts = new List<string> { "artifact-item", "test-artifact-item" };
        if (isActive)
        {
            parts.Add("active");
        }

        if (latestRun is not null)
        {
            parts.Add(latestRun.Status.ToString().ToLowerInvariant());
        }

        return string.Join(" ", parts);
    }

    private static string TestRunMeta(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No run yet"
            : $"Latest {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}";

    private static string TestRunSummaryLabel(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No scenario run history"
            : $"Latest run {latestRun.Status}, {TestRunDetailText(latestRun)}";

    private static string TestRunText(ScenarioRunResult? latestRun)
        => latestRun?.Status.ToString() ?? "No run";

    private static string TestRunDetailText(ScenarioRunResult? latestRun)
        => latestRun is null
            ? "No history"
            : $"{CountLabel(latestRun.Steps.Count, "step")} / {TestRunIssueText(latestRun)}";

    private static string TestRunIssueText(ScenarioRunResult latestRun)
    {
        var issueCount = latestRun.Steps.Count(step =>
            step.Status is ScenarioStepRunStatus.Failed or ScenarioStepRunStatus.TimedOut or ScenarioStepRunStatus.Canceled);

        return issueCount == 0 ? "No issues" : CountLabel(issueCount, "issue");
    }

    private static string TestRunSummaryClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "test-run-summary passed",
            ScenarioRunStatus.Failed => "test-run-summary failed",
            ScenarioRunStatus.Canceled => "test-run-summary canceled",
            _ => "test-run-summary idle"
        };

    private static string TestRunMarkerClass(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => "test-run-marker passed",
            ScenarioRunStatus.Failed => "test-run-marker failed",
            ScenarioRunStatus.Canceled => "test-run-marker canceled",
            _ => "test-run-marker idle"
        };

    private static string TestRunIcon(ScenarioRunResult? latestRun)
        => latestRun?.Status switch
        {
            ScenarioRunStatus.Passed => Icons.Material.Filled.CheckCircle,
            ScenarioRunStatus.Failed => Icons.Material.Filled.ErrorOutline,
            ScenarioRunStatus.Canceled => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.RadioButtonUnchecked
        };

    private static string TestArtifactTitle(string testName, ScenarioRunResult? latestRun)
        => latestRun is null
            ? $"Test {testName}. No runs yet."
            : $"Test {testName}. Latest run {latestRun.Status} at {latestRun.FinishedAt.ToLocalTime():HH:mm:ss}.";

    private Task CloseAsync(FlowWorkspaceService app) => Projects.CloseProjectAsync(app).AsTask();

    private async Task AddConnectionAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<AddConnectionDialog>("New Connection",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AddConnectionDialog.AddConnectionResult r })
        {
            var resourceKey = string.IsNullOrWhiteSpace(r.Profile.Name)
                ? "connection"
                : r.Profile.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            app.UpsertConnectionResource(resourceKey, r.Profile);
            Live.AddConnectionIfAbsent(r.Profile, r.Subscription, resourceKey);
            ExpandSection(app, BrokerSection);
        }
    }

    private async Task AddPipelineAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>("New Pipeline");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddWorkflow(name.Trim());
            app.SetActiveWorkflow(name.Trim());
            ExpandSection(app, PipelineSection);
        }
    }

    private async Task AddDashboardAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Dashboard",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Dashboard"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddDashboard(name.Trim());
            ExpandSection(app, DashboardSection);
        }
    }

    private async Task AddMetricAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Metric",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Metric"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddMetric(name.Trim());
            app.SetActiveMetrics();
            ExpandSection(app, MetricSection);
        }
    }

    private async Task AddTestAsync(FlowWorkspaceService app)
    {
        Projects.SetActive(app);
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Test",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Test"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            app.AddTest(name.Trim());
            ExpandSection(app, TestSection);
        }
    }

    private async Task AddTestFromKeyboardAsync(KeyboardEventArgs args, FlowWorkspaceService app)
    {
        if (IsActivationKey(args))
        {
            await AddTestAsync(app);
        }
    }

    private async Task RemoveTestAsync(FlowWorkspaceService app, string name)
    {
        Projects.SetActive(app);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete test",
            $"Delete test '{name}'? This cannot be undone.",
            "Delete",
            null,
            "Cancel",
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall });
        if (confirmed == true)
        {
            app.RemoveTest(name);
            ExpandSection(app, TestSection);
        }
    }

    private static string ConnectionDotClass(MqttClientState state) => state switch
    {
        MqttClientState.Connected => "conn-dot live",
        MqttClientState.Connecting or MqttClientState.Reconnecting => "conn-dot pending",
        MqttClientState.Faulted => "conn-dot faulted",
        _ => "conn-dot"
    };

    private void OnChanged(object? sender, EventArgs e)
    {
        SyncSubscriptions();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Projects.Changed -= OnChanged;
        Live.Changed -= OnChanged;
        foreach (var app in _subscribed)
            app.Changed -= OnChanged;
        _subscribed.Clear();
        _collapsedSections.Clear();
    }
}

@using FluxMq.UI.Components.Diagram
@using FluxMq.Components.Control
@using FluxMq.Components.MqttPublisher
@using FluxMq.UI.Models
@using Blazor.Diagrams.Core.Models.Base
@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject FlowComponentCatalog Catalog
@inject DragStateService DragState

<div class="flow-designer-root"
     role="region"
     aria-label="Flow designer canvas"
     @onpointerenter="HandleDesignerPointerEnter"
     @onpointermove="HandleDesignerPointerMove"
     @onpointerleave="HandleDesignerPointerLeave">
    <div class="flow-canvas-header">
        <div class="flow-canvas-title">
            <span class="flow-canvas-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" />
            </span>
            <div class="flow-canvas-title-copy">
                <h2>@WorkflowTitle</h2>
                <div class="flow-canvas-meta-strip" aria-label="Pipeline canvas summary">
                    <span>@WorkflowSubtitle</span>
                    <span>@WorkflowModeLabel</span>
                    @if (_selectedWorkflowLink is not null)
                    {
                        <span>@WorkflowSelectionLabel</span>
                    }
                </div>
            </div>
        </div>
        <div class="flow-canvas-actions" aria-label="Pipeline canvas status and commands">
            @if (ShowRuntimeState)
            {
                <span class="flow-state @RuntimeStateClass">
                    <span class="flow-state-dot" aria-hidden="true"></span>
                    @RuntimeStateLabel
                </span>
            }
            <div class="flow-canvas-metrics" aria-label="Pipeline canvas metrics">
                <span class="flow-canvas-stat">
                    <span>Nodes</span>
                    <strong>@PipelineNodeCount</strong>
                </span>
                <span class="flow-canvas-stat">
                    <span>Links</span>
                    <strong>@LinkCount</strong>
                </span>
                @if (ResourceNodeCount > 0)
                {
                    <span class="flow-canvas-stat">
                        <span>Resources</span>
                        <strong>@ResourceNodeCount</strong>
                    </span>
                }
                @if (DiagnosticCount > 0)
                {
                    @if (HasActionableDiagnostics)
                    {
                        <button type="button"
                                class="flow-canvas-stat flow-canvas-stat-button @DiagnosticSeverityClass"
                                title="@DiagnosticLogsTitle"
                                aria-label="@DiagnosticLogsAriaLabel"
                                @onclick="@OpenDiagnosticLogsAsync">
                            <span>@DiagnosticSummaryLabel</span>
                            <strong>@DiagnosticDisplayCount</strong>
                        </button>
                    }
                    else
                    {
                        <span class="flow-canvas-stat @DiagnosticSeverityClass">
                            <span>@DiagnosticSummaryLabel</span>
                            <strong>@DiagnosticDisplayCount</strong>
                        </span>
                    }
                }
            </div>
            <div class="flow-canvas-command-group" aria-label="Pipeline canvas commands">
                <MudTooltip Text="Zoom to fit">
                    <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong"
                                   Size="Size.Small"
                                   Class="flow-canvas-icon-button"
                                   OnClick="@ZoomToFit"
                                   aria-label="Zoom to fit" />
                </MudTooltip>
            </div>
        </div>
    </div>
    <div class="flow-canvas" role="group" aria-label="Pipeline diagram canvas">
        <CascadingValue Value="_diagram">
            <DiagramCanvas>
                <Widgets>
                    <GridWidget Size="20" Mode="GridMode.Point" BackgroundColor="transparent" />
                    <NavigatorWidget Width="180"
                                     Height="120"
                                     UseNodeShape="false"
                                     NodeColor="#2DD4BF"
                                     GroupColor="#1C222D"
                                     ViewStrokeColor="#FBBF24"
                                     Class="flow-navigator" />
                </Widgets>
            </DiagramCanvas>
        </CascadingValue>
    </div>
    @if (IsCanvasEmpty)
    {
        <div class="flow-canvas-empty" role="status" aria-live="polite">
            <span class="flow-canvas-empty-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Large" />
            </span>
            <strong>No pipeline nodes</strong>
            <span class="flow-canvas-empty-message">@EmptyCanvasText</span>
            <small>@EmptyCanvasHint</small>
        </div>
    }
    @if (DragState.ActiveComponentDrag is { IsOverDesigner: true, TargetKind: WorkspaceArtifactKind.Pipeline })
    {
        <div class="flow-canvas-drop-highlight" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" />
            <span>Drop component</span>
        </div>
    }
    @if (_selectedWorkflowLink is not null)
    {
        <div class="flow-link-condition-panel">
            <div class="flow-link-condition-meta">
                <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" />
                <div>
                    <span>Selected link</span>
                    <strong>@SelectedLinkLabel</strong>
                </div>
            </div>
            <MudTextField T="string"
                          Value="@_selectedLinkCondition"
                          ValueChanged="@OnSelectedLinkConditionChanged"
                          Label="Condition"
                          Placeholder="input.Topic.StartsWith(&quot;factory/&quot;)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Class="flow-link-condition-input" />
            <MudTooltip Text="Apply condition">
                <MudIconButton Icon="@Icons.Material.Filled.Check"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@ApplySelectedLinkCondition" />
            </MudTooltip>
            <MudTooltip Text="Clear condition">
                <MudIconButton Icon="@Icons.Material.Filled.Clear"
                               Size="Size.Small"
                               OnClick="@ClearSelectedLinkCondition" />
            </MudTooltip>
        </div>
    }
</div>

@code {
    [CascadingParameter] private FlowWorkspaceService Flow { get; set; } = null!;

    [Parameter] public EventCallback<WorkspaceLogQuery> LogsRequested { get; set; }

    private readonly BlazorDiagram _diagram = new(new Blazor.Diagrams.Options.BlazorDiagramOptions
    {
        AllowMultiSelection = true,
        AllowPanning = true,
        GridSize = 20,
        Links =
        {
            Factory = (diagram, source, targetAnchor) =>
            {
                Blazor.Diagrams.Core.Anchors.Anchor sourceAnchor = source switch
                {
                    NodeModel node => new Blazor.Diagrams.Core.Anchors.ShapeIntersectionAnchor(node),
                    PortModel port => new Blazor.Diagrams.Core.Anchors.SinglePortAnchor(port),
                    _ => throw new InvalidOperationException(
                        $"Unsupported diagram link source '{source.GetType().Name}'.")
                };
                return CreateStyledLink(sourceAnchor, targetAnchor);
            }
        }
    });

    private long _renderedDefinitionRevision = -1;
    private string? _renderedWorkflowName;
    private readonly Dictionary<string, DiagramNodeState> _nodeStates = new(StringComparer.Ordinal);
    private readonly Dictionary<string, long> _filterPassCounts = new(StringComparer.Ordinal);
    private static readonly LinkMarker FlowTargetMarker = new("M 0 -4 6 0 0 4 z", 13d);
    private static readonly Blazor.Diagrams.Core.Geometry.Point ConditionLabelOffset = new(0, -18);
    private const double DroppedNodeCenterOffsetX = 130d;
    private const double DroppedNodeCenterOffsetY = 45d;
    private const int ZoomToFitMargin = 80;
    private const int AutoZoomFirstPassDelayMs = 140;
    private const int AutoZoomSecondPassDelayMs = 160;
    private System.Threading.Timer? _pulseTimer;
    private int _portMeasurementGeneration;
    private int _autoZoomGeneration;
    private bool _isDisposed;
    private bool _isRebuildingDiagram;
    private bool _isApplyingLinkEdit;
    private SelectedWorkflowLink? _selectedWorkflowLink;
    private string _selectedLinkCondition = string.Empty;

    private string WorkflowTitle => Flow.ActiveWorkflowName ?? "Pipeline";

    private string WorkflowSubtitle => Flow.HasUnsavedChanges
        ? "Unsaved changes"
        : Flow.ActiveWorkflowName is null
            ? "No active pipeline"
            : "Ready";

    private string WorkflowModeLabel => Flow.ActiveWorkflowName is null ? "No pipeline" : "Editable";

    private string WorkflowSelectionLabel => _selectedWorkflowLink is null ? "No link selected" : "Link selected";

    private int PipelineNodeCount => _diagram.Nodes
        .OfType<FlowDiagramNodeModel>()
        .Count(static node => !node.IsResource);

    private int ResourceNodeCount => _diagram.Nodes
        .OfType<FlowDiagramNodeModel>()
        .Count(static node => node.IsResource);

    private int LinkCount => _diagram.Links.OfType<FlowDiagramLinkModel>().Count();

    private bool IsCanvasEmpty => _diagram.Nodes.Count == 0;

    private string EmptyCanvasText => Flow.ActiveWorkflowName is null
        ? "Create a pipeline first."
        : "Add components from the catalog.";

    private string EmptyCanvasHint => Flow.ActiveWorkflowName is null
        ? "Use the structure panel to add a pipeline."
        : "Drop a component here to begin.";

    private int DiagnosticCount => Flow.Diagnostics.Count;

    private int ErrorCount => Flow.Diagnostics.Count(static diagnostic =>
        string.Equals(diagnostic.Severity, "Error", StringComparison.OrdinalIgnoreCase));

    private int WarningCount => Flow.Diagnostics.Count(static diagnostic =>
        string.Equals(diagnostic.Severity, "Warning", StringComparison.OrdinalIgnoreCase));

    private bool HasActionableDiagnostics => ErrorCount > 0 || WarningCount > 0;

    private int DiagnosticDisplayCount => ErrorCount > 0
        ? ErrorCount
        : WarningCount > 0
            ? WarningCount
            : DiagnosticCount;

    private string DiagnosticSummaryLabel => ErrorCount > 0
        ? "Errors"
        : WarningCount > 0
            ? "Warnings"
            : "Notes";

    private string DiagnosticSeverityClass => ErrorCount > 0
        ? "error"
        : WarningCount > 0
            ? "warning"
            : "info";

    private string DiagnosticLogsTitle => ErrorCount > 0
        ? "Open logs filtered to errors"
        : "Open logs filtered to warnings";

    private bool ShowRuntimeState => Flow.State != RuntimeWorkspaceState.Faulted || ErrorCount == 0;

    private string RuntimeStateLabel => Flow.State switch
    {
        RuntimeWorkspaceState.Valid => "Valid",
        RuntimeWorkspaceState.Running => "Running",
        RuntimeWorkspaceState.Stopped => "Stopped",
        RuntimeWorkspaceState.Faulted => "Faulted",
        _ => "Idle"
    };

    private string RuntimeStateClass => Flow.State switch
    {
        RuntimeWorkspaceState.Valid => "valid",
        RuntimeWorkspaceState.Running => "running",
        RuntimeWorkspaceState.Stopped => "stopped",
        RuntimeWorkspaceState.Faulted => "faulted",
        _ => "idle"
    };

    private string SelectedLinkLabel => _selectedWorkflowLink is { } link
        ? $"{link.SourceNodeName}.{link.SourcePortName} -> {link.TargetNodeName}.{link.TargetPortName}"
        : string.Empty;

    private string DiagnosticLogsAriaLabel => $"{DiagnosticLogsTitle} for {WorkflowTitle}";

    private Task OpenDiagnosticLogsAsync()
    {
        if (!LogsRequested.HasDelegate)
        {
            return Task.CompletedTask;
        }

        var severity = ErrorCount > 0 ? "Error" : "Warning";
        return LogsRequested.InvokeAsync(new WorkspaceLogQuery(
            Severity: severity,
            Search: DiagnosticLogSearch));
    }

    private string? DiagnosticLogSearch
    {
        get
        {
            var workflowName = Flow.ActiveWorkflowName;
            if (string.IsNullOrWhiteSpace(workflowName))
            {
                return null;
            }

            var actionableDiagnostics = Flow.Diagnostics
                .Where(static diagnostic =>
                    string.Equals(diagnostic.Severity, "Error", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(diagnostic.Severity, "Warning", StringComparison.OrdinalIgnoreCase))
                .ToArray();

            return actionableDiagnostics.Length > 0 &&
                   actionableDiagnostics.All(diagnostic =>
                       string.IsNullOrWhiteSpace(diagnostic.WorkflowName) ||
                       string.Equals(diagnostic.WorkflowName, workflowName, StringComparison.Ordinal))
                ? workflowName
                : null;
        }
    }

    protected override void OnInitialized()
    {
        _diagram.RegisterComponent<FlowDiagramNodeModel, FlowDiagramNodeWidget>();
        _diagram.RegisterComponent<FlowDiagramLinkModel, FlowDiagramLinkWidget>();
        _diagram.RegisterComponent<FlowPortModel, FluxPortWidget>();
        Flow.GetDiagramState = () =>
        {
            var result = new Dictionary<string, (double X, double Y, bool Collapsed)>(StringComparer.Ordinal);
            foreach (var (id, state) in _nodeStates)
                result[id] = (state.Position.X, state.Position.Y, state.IsCollapsed);
            foreach (var node in _diagram.Nodes.OfType<FlowDiagramNodeModel>())
                result[node.Id] = (node.Position.X, node.Position.Y, node.IsCollapsed);
            return result;
        };
        _diagram.Nodes.Removed += OnDiagramNodeRemoved;
        _diagram.Links.Added += OnDiagramLinkAdded;
        _diagram.Links.Removed += OnDiagramLinkRemoved;
        _diagram.SelectionChanged += OnDiagramSelectionChanged;
        Flow.Changed += OnFlowChanged;
        Live.Changed += OnLiveChanged;
        DragState.Changed += OnDragStateChanged;
        DragState.ComponentDropRequested += OnComponentDropRequested;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;
        RebuildDiagram();
        ScheduleAutoZoomToFit();
        return InvokeAsync(StateHasChanged);
    }

    private void ZoomToFit() => _diagram.ZoomToFit(ZoomToFitMargin);

    private void ScheduleAutoZoomToFit()
    {
        var generation = ++_autoZoomGeneration;
        _ = AutoZoomToFitAsync(generation);
    }

    private async Task AutoZoomToFitAsync(int generation)
    {
        try
        {
            await Task.Delay(AutoZoomFirstPassDelayMs);
            await InvokeAutoZoomToFitAsync(generation);
            await Task.Delay(AutoZoomSecondPassDelayMs);
            await InvokeAutoZoomToFitAsync(generation);
        }
        catch (InvalidOperationException) when (_isDisposed)
        {
        }
    }

    private Task InvokeAutoZoomToFitAsync(int generation)
        => InvokeAsync(() =>
        {
            if (_isDisposed ||
                generation != _autoZoomGeneration ||
                !_diagram.Nodes.Any())
            {
                return;
            }

            ZoomToFit();
            _diagram.Refresh();
        });

    private void OnComponentDropRequested(object? sender, ComponentDropRequestedEventArgs args)
    {
        if (args.TargetKind != WorkspaceArtifactKind.Pipeline)
        {
            return;
        }

        InvokeAsync(() =>
        {
            var dropPoint = _diagram.GetRelativeMousePoint(args.ClientX, args.ClientY);
            Flow.AddComponent(
                args.ComponentType,
                (dropPoint.X - DroppedNodeCenterOffsetX, dropPoint.Y - DroppedNodeCenterOffsetY));
        });
    }

    private void OnDragStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleDesignerPointerEnter(PointerEventArgs args)
    {
        if (DragState.ActiveComponentDrag is { TargetKind: WorkspaceArtifactKind.Pipeline })
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerMove(PointerEventArgs args)
    {
        if (DragState.ActiveComponentDrag is { TargetKind: WorkspaceArtifactKind.Pipeline })
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerLeave(PointerEventArgs args)
    {
        if (DragState.ActiveComponentDrag is { TargetKind: WorkspaceArtifactKind.Pipeline })
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, false);
        }
    }

    private void RebuildDiagram()
    {
        CaptureDiagramState();
        ClearSelectedWorkflowLinkEditor();
        if (Flow.StagedNodePositions is { Count: > 0 } staged)
        {
            foreach (var (name, (x, y, collapsed)) in staged)
                _nodeStates[name] = new DiagramNodeState(new Blazor.Diagrams.Core.Geometry.Point(x, y), collapsed);
            Flow.ConsumeStagedPositions();
        }
        else
        {
            foreach (var (name, (x, y, collapsed)) in Flow.LastNodePositions)
                _nodeStates.TryAdd(name, new DiagramNodeState(new Blazor.Diagrams.Core.Geometry.Point(x, y), collapsed));
        }
        _isRebuildingDiagram = true;
        try
        {
            _diagram.Nodes.Clear();
            _diagram.Links.Clear();
            _renderedDefinitionRevision = Flow.DefinitionRevision;
            _renderedWorkflowName = Flow.ActiveWorkflowName;

            try
            {
                using var document = JsonDocument.Parse(Flow.DefinitionJson);
                if (!TryGetFlowApplication(document.RootElement, out var flowApplication))
                {
                    _diagram.Refresh();
                    return;
                }

                var nodes = new Dictionary<string, NodeModel>(StringComparer.Ordinal);
                var resourceY = 60d;
                if (flowApplication.TryGetProperty("resources", out var resources) && resources.ValueKind == JsonValueKind.Object)
                {
                    foreach (var resource in resources.EnumerateObject())
                    {
                        if (resource.Value.TryGetProperty("type", out var rType) &&
                            rType.GetString() == "mqtt.connection")
                            continue;

                        AddNode(nodes, resource.Name, resource.Value, x: 70, y: resourceY, isResource: true, workflowName: null);
                        resourceY += 150;
                    }
                }

                if (flowApplication.TryGetProperty("workflows", out var workflows) &&
                    workflows.ValueKind == JsonValueKind.Object &&
                    Flow.ActiveWorkflowName is { } activeWorkflowName &&
                    workflows.TryGetProperty(activeWorkflowName, out var activeWorkflow) &&
                    activeWorkflow.ValueKind == JsonValueKind.Object)
                {
                    var nodeX = 380d;
                    foreach (var node in activeWorkflow.EnumerateObject())
                    {
                        AddNode(nodes, node.Name, node.Value, nodeX, 60d, isResource: false, workflowName: activeWorkflowName);
                        nodeX += 300;
                    }

                    foreach (var target in activeWorkflow.EnumerateObject())
                    {
                        if (!nodes.TryGetValue(target.Name, out var targetNode) || target.Value.ValueKind != JsonValueKind.Object)
                            continue;

                        foreach (var port in target.Value.EnumerateObject())
                        {
                            if (IsDefinitionProperty(port.Name))
                                continue;

                            foreach (var sourceLink in ReadSourceLinks(port.Value))
                            {
                                var sourceReference = sourceLink.Reference;
                                var sourceName = sourceReference.Split('.', 2)[0];
                                if (nodes.TryGetValue(sourceName, out var sourceNode))
                                {
                                    var sourcePortName = sourceReference.Contains('.') ? sourceReference.Split('.', 2)[1] : null;
                                    var sourcePort = PortFor(sourceNode, PortAlignment.Right, sourcePortName);
                                    var targetPort = PortFor(targetNode, PortAlignment.Left, port.Name);
                                    if (sourcePort is null || targetPort is null) continue;

                                    var linkColor = FlowLinkVisuals.ColorFor(
                                        sourceLink.HasCondition,
                                        IsErrorLink(sourcePortName, port.Name));
                                    var link = CreateStyledLink(
                                        sourcePort,
                                        targetPort,
                                        linkColor,
                                        FlowLinkVisuals.WidthFor(sourceLink.HasCondition));
                                    if (FlowLinkVisuals.ConditionLabel(sourceLink.When) is { } label)
                                    {
                                        link.AddLabel(label, 0.5, ConditionLabelOffset);
                                    }

                                    _diagram.Links.Add(link);
                                }
                            }
                        }

                        if (target.Value.TryGetProperty("configuration", out var configuration) &&
                            configuration.ValueKind == JsonValueKind.Object &&
                            configuration.TryGetProperty("connection", out var connectionRef) &&
                            connectionRef.ValueKind == JsonValueKind.String &&
                            connectionRef.GetString() is { Length: > 0 } resourceName &&
                            nodes.TryGetValue(resourceName, out var resourceNode))
                        {
                            var sourcePort = PortFor(resourceNode, PortAlignment.Right, "Connection");
                            var targetPort = PortFor(targetNode, PortAlignment.Left, "Connection");
                            if (sourcePort is not null && targetPort is not null)
                            {
                                _diagram.Links.Add(CreateStyledLink(
                                    sourcePort,
                                    targetPort,
                                    FlowLinkVisuals.ConditionalColor,
                                    FlowLinkVisuals.ConditionalWidth));
                            }
                        }
                    }
                }
            }
            catch
            {
            }
        }
        finally
        {
            _isRebuildingDiagram = false;
        }

        UpdateDiagramActivity();
        UpdateDiagramDiagnostics();
        _diagram.Refresh();
        SchedulePortMeasurementRefresh();
    }

    private void AddNode(IDictionary<string, NodeModel> nodes, string name, JsonElement definition, double x, double y, bool isResource, string? workflowName)
    {
        var type = definition.TryGetProperty("type", out var typeElement) && typeElement.ValueKind == JsonValueKind.String
            ? typeElement.GetString()
            : "node";
        var positionKey = workflowName is not null ? $"{workflowName}.{name}" : name;
        // Fall back to unqualified name for files saved before qualified keys were introduced
        var hasState = _nodeStates.TryGetValue(positionKey, out var state) ||
                       _nodeStates.TryGetValue(name, out state);

        var node = FlowNodeModelFactory.Create(
            positionKey,
            hasState ? state!.Position : new Blazor.Diagrams.Core.Geometry.Point(x, y),
            name,
            type ?? "node",
            Catalog.Find(type ?? string.Empty),
            isResource);

        if (hasState)
            node.SetCollapsed(state!.IsCollapsed);

        if (definition.TryGetProperty("configuration", out var configElement) &&
            configElement.ValueKind == JsonValueKind.Object &&
            System.Text.Json.Nodes.JsonNode.Parse(configElement.GetRawText()) is System.Text.Json.Nodes.JsonObject configObject)
        {
            node.LoadConfiguration(configObject);
        }

        if (node.PortDescriptors.Count > 0)
        {
            foreach (var descriptor in node.PortDescriptors)
            {
                var valueType = node.ResolvePortValueType(descriptor);
                node.AddPort(new FlowPortModel(node, PortAlignment.Left, descriptor.Name, descriptor.SingleLink, descriptor.IsInput, valueType));
                node.AddPort(new FlowPortModel(node, PortAlignment.Right, descriptor.Name, descriptor.SingleLink, descriptor.IsInput, valueType));
            }
        }
        else
        {
            if (isResource || HasOutputPort(node.NodeType))
                node.AddPort(PortAlignment.Right);
            if (!isResource && HasInputPort(node.NodeType))
                node.AddPort(PortAlignment.Left);
        }

        _diagram.Nodes.Add(node);
        nodes[name] = node;
    }

    private static bool HasInputPort(string nodeType) => true;

    private static bool HasOutputPort(string nodeType) => nodeType switch
    {
        "mqtt.metrics" => false,
        _ => true
    };

    private static PortModel? PortFor(NodeModel node, PortAlignment alignment, string? portName = null)
    {
        if (portName is not null)
        {
            var named = node.Ports.OfType<FlowPortModel>()
                .FirstOrDefault(p => p.Alignment == alignment &&
                                     string.Equals(p.PortName, portName, StringComparison.OrdinalIgnoreCase));
            if (named is not null) return named;
        }
        return node.Ports.FirstOrDefault(p => p.Alignment == alignment);
    }

    private static FlowDiagramLinkModel CreateStyledLink(
        PortModel sourcePort,
        PortModel targetPort,
        string color = FlowLinkVisuals.DefaultColor,
        double width = FlowLinkVisuals.DefaultWidth)
        => StyleLink(new FlowDiagramLinkModel(sourcePort, targetPort), color, width);

    private static FlowDiagramLinkModel CreateStyledLink(
        Blazor.Diagrams.Core.Anchors.Anchor sourceAnchor,
        Blazor.Diagrams.Core.Anchors.Anchor targetAnchor,
        string color = FlowLinkVisuals.DefaultColor,
        double width = FlowLinkVisuals.DefaultWidth)
        => StyleLink(new FlowDiagramLinkModel(sourceAnchor, targetAnchor), color, width);

    private static FlowDiagramLinkModel StyleLink(FlowDiagramLinkModel link, string color, double width)
    {
        link.SetNormalStyle(color, width);
        link.TargetMarker = FlowTargetMarker;
        return link;
    }

    private void OnDiagramLinkAdded(BaseLinkModel link)
    {
        if (_isRebuildingDiagram)
        {
            return;
        }

        link.TargetAttached += OnDiagramLinkTargetAttached;
        if (link.IsAttached)
        {
            OnDiagramLinkTargetAttached(link);
        }
    }

    private void OnDiagramLinkRemoved(BaseLinkModel link)
    {
        link.TargetAttached -= OnDiagramLinkTargetAttached;

        if (_isRebuildingDiagram || _isApplyingLinkEdit)
        {
            return;
        }

        if (TryResolveWorkflowLink(link, out var sourcePort, out var targetPort))
        {
            Flow.RemoveWorkflowPortLink(
                ((FlowDiagramNodeModel)sourcePort.Parent).NodeName,
                sourcePort.PortName,
                ((FlowDiagramNodeModel)targetPort.Parent).NodeName,
                targetPort.PortName);
        }
    }

    private void OnDiagramLinkTargetAttached(BaseLinkModel link)
    {
        if (_isRebuildingDiagram || _isApplyingLinkEdit)
        {
            return;
        }

        if (!TryResolveWorkflowLink(link, out var sourcePort, out var targetPort) ||
            !sourcePort.CanCarryValueTo(targetPort))
        {
            RemoveUncommittedLink(link);
            return;
        }

        Flow.ConnectWorkflowPorts(
            ((FlowDiagramNodeModel)sourcePort.Parent).NodeName,
            sourcePort.PortName,
            ((FlowDiagramNodeModel)targetPort.Parent).NodeName,
            targetPort.PortName,
            ShouldReplaceTargetLinks(targetPort));
    }

    private void OnDiagramSelectionChanged(SelectableModel model)
    {
        if (_isRebuildingDiagram)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            RefreshSelectedWorkflowLink();
            StateHasChanged();
        });
    }

    private void RefreshSelectedWorkflowLink()
    {
        UpdateLinkSelectionVisuals();

        var selectedLink = _diagram.GetSelectedModels()
            .OfType<BaseLinkModel>()
            .FirstOrDefault(link => TryResolveWorkflowLink(link, out _, out _));

        if (selectedLink is null ||
            !TryResolveWorkflowLink(selectedLink, out var sourcePort, out var targetPort))
        {
            ClearSelectedWorkflowLinkEditor();
            return;
        }

        var sourceNode = (FlowDiagramNodeModel)sourcePort.Parent;
        var targetNode = (FlowDiagramNodeModel)targetPort.Parent;
        _selectedWorkflowLink = new SelectedWorkflowLink(
            sourceNode.NodeName,
            sourcePort.PortName,
            targetNode.NodeName,
            targetPort.PortName);
        _selectedLinkCondition = Flow.GetWorkflowPortLinkCondition(
            sourceNode.NodeName,
            sourcePort.PortName,
            targetNode.NodeName,
            targetPort.PortName) ?? string.Empty;
    }

    private void UpdateLinkSelectionVisuals()
    {
        foreach (var link in _diagram.Links.OfType<FlowDiagramLinkModel>())
        {
            link.ApplySelectionStyle(link.Selected);
        }
    }

    private void OnSelectedLinkConditionChanged(string? value)
        => _selectedLinkCondition = value ?? string.Empty;

    private void ApplySelectedLinkCondition()
    {
        if (_selectedWorkflowLink is not { } link)
        {
            return;
        }

        Flow.UpdateWorkflowPortLinkCondition(
            link.SourceNodeName,
            link.SourcePortName,
            link.TargetNodeName,
            link.TargetPortName,
            _selectedLinkCondition);
    }

    private void ClearSelectedLinkCondition()
    {
        _selectedLinkCondition = string.Empty;
        ApplySelectedLinkCondition();
    }

    private void ClearSelectedWorkflowLinkEditor()
    {
        _selectedWorkflowLink = null;
        _selectedLinkCondition = string.Empty;
    }

    private void RemoveUncommittedLink(BaseLinkModel link)
    {
        _isApplyingLinkEdit = true;
        try
        {
            _diagram.Links.Remove(link);
            _diagram.Refresh();
        }
        finally
        {
            _isApplyingLinkEdit = false;
        }
    }

    private static bool TryResolveWorkflowLink(BaseLinkModel link, out FlowPortModel sourcePort, out FlowPortModel targetPort)
    {
        sourcePort = null!;
        targetPort = null!;

        if (!TryGetFlowPort(link.Source, out var firstPort) ||
            !TryGetFlowPort(link.Target, out var secondPort) ||
            firstPort.Parent is not FlowDiagramNodeModel firstNode ||
            secondPort.Parent is not FlowDiagramNodeModel secondNode ||
            firstNode.IsResource ||
            secondNode.IsResource ||
            firstPort.RepresentsInput == secondPort.RepresentsInput)
        {
            return false;
        }

        sourcePort = firstPort.RepresentsInput ? secondPort : firstPort;
        targetPort = firstPort.RepresentsInput ? firstPort : secondPort;
        return true;
    }

    private static bool TryGetFlowPort(Blazor.Diagrams.Core.Anchors.Anchor anchor, out FlowPortModel port)
    {
        if (anchor is Blazor.Diagrams.Core.Anchors.SinglePortAnchor { Port: FlowPortModel flowPort })
        {
            port = flowPort;
            return true;
        }

        port = null!;
        return false;
    }

    private static bool ShouldReplaceTargetLinks(FlowPortModel targetPort)
    {
        if (string.Equals(targetPort.PortName, "FlowErrors", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return targetPort.Parent is not FlowDiagramNodeModel { NodeType: "flow.logger" } ||
               !string.Equals(targetPort.PortName, "Input", StringComparison.OrdinalIgnoreCase);
    }

    private void OnDiagramNodeRemoved(NodeModel node)
    {
        if (_isRebuildingDiagram || node is not FlowDiagramNodeModel flowNode || flowNode.IsResource)
        {
            return;
        }

        _nodeStates.Remove(flowNode.Id);
        _nodeStates.Remove(flowNode.NodeName);
        Flow.LastNodePositions.Remove(flowNode.Id);
        Flow.LastNodePositions.Remove(flowNode.NodeName);
        Flow.RemoveWorkflowNode(flowNode.NodeName);
    }

    private void UpdateDiagramActivity()
    {
        var count = Live.SelectedStoredSession is null
            ? Live.RecentMessages.Count
            : Live.SelectedSessionMessages.Count;

        foreach (var node in _diagram.Nodes.OfType<FlowDiagramNodeModel>())
        {
            var activity = node.NodeType switch
            {
                "mqtt.trigger" => TriggerActivity(node.NodeName),
                "session.source" or "replay.source" => Live.SelectedStoredSession is null
                    ? null
                    : $"{count} stored messages",
                "generated.source" => "Configured message list",
                "mqtt.payload-inspector" => PayloadInspectorActivity(node.NodeName),
                "mqtt.metrics" => MetricsActivity(node.NodeName),
                "mqtt.publisher" => PublisherActivity(node.NodeName),
                _ => null
            };

            node.SetActivity(activity);
        }
    }

    private string TriggerActivity(string nodeName)
    {
        var snapshot = Flow.GetTriggerActivitySnapshot(Flow.ActiveWorkflowName, nodeName);
        if (snapshot.MessageCount == 0)
        {
            return Flow.State == RuntimeWorkspaceState.Running
                ? "Waiting for subscribed messages"
                : "0 messages emitted";
        }

        var noun = snapshot.MessageCount == 1 ? "message" : "messages";
        return $"{snapshot.MessageCount} {noun} | {ShortTopic(snapshot.LastTopic ?? string.Empty)}";
    }

    private string MetricsActivity(string nodeName)
    {
        var snapshot = Flow.GetMetricsSnapshot(Flow.ActiveWorkflowName, nodeName);
        return $"{snapshot.MessageCount} messages | now {FormatRate(snapshot.MessagesPerSecond)}/s | avg {FormatRate(snapshot.AverageMessagesPerSecond)}/s";
    }

    private string PayloadInspectorActivity(string nodeName)
    {
        var inspection = Flow.GetPayloadInspection(Flow.ActiveWorkflowName, nodeName);
        return inspection is null
            ? "Waiting for payload"
            : $"{inspection.Payload.DisplayTypeLabel} | {inspection.Payload.SizeBytes} bytes | {ShortTopic(inspection.Envelope.Topic)}";
    }

    private string? PublisherActivity(string nodeName)
    {
        var publisher = Flow.Host?.Runtime?.Nodes
            .FirstOrDefault(runtimeNode =>
                string.Equals(runtimeNode.Address.Scope, Flow.ActiveWorkflowName, StringComparison.Ordinal) &&
                string.Equals(runtimeNode.Address.Node.Value, nodeName, StringComparison.Ordinal))
            ?.Node as MqttPublisherComponent;

        if (publisher is null)
        {
            return null;
        }

        var count = publisher.PublishedCount;
        if (count == 0)
        {
            return "Waiting for publish request";
        }

        return $"{count} published | {ShortTopic(publisher.LastPublishedTopic ?? string.Empty)}";
    }

    private void UpdateDiagramDiagnostics()
    {
        foreach (var node in _diagram.Nodes.OfType<FlowDiagramNodeModel>())
        {
            node.SetDiagnostics(Flow.Diagnostics.Where(diagnostic => DiagnosticMatchesNode(diagnostic, node)));
        }
    }

    private bool DiagnosticMatchesNode(WorkspaceDiagnostic diagnostic, FlowDiagramNodeModel node)
    {
        if (string.IsNullOrWhiteSpace(diagnostic.NodeName) ||
            !string.Equals(diagnostic.NodeName, node.NodeName, StringComparison.Ordinal))
        {
            return false;
        }

        if (node.IsResource)
        {
            return string.IsNullOrWhiteSpace(diagnostic.WorkflowName);
        }

        return !string.IsNullOrWhiteSpace(diagnostic.WorkflowName) &&
               string.Equals(diagnostic.WorkflowName, Flow.ActiveWorkflowName, StringComparison.Ordinal);
    }

    private void CaptureDiagramState()
    {
        var currentNodeIds = _diagram.Nodes
            .OfType<FlowDiagramNodeModel>()
            .Select(static node => node.Id)
            .ToHashSet(StringComparer.Ordinal);

        foreach (var removedKey in _nodeStates.Keys.Where(key => ShouldPrunePositionKey(key, currentNodeIds, _renderedWorkflowName)).ToArray())
        {
            _nodeStates.Remove(removedKey);
        }

        foreach (var node in _diagram.Nodes.OfType<FlowDiagramNodeModel>())
            _nodeStates[node.Id] = new DiagramNodeState(node.Position, node.IsCollapsed);
    }

    private static bool ShouldPrunePositionKey(string key, IReadOnlySet<string> currentNodeIds, string? renderedWorkflowName)
    {
        if (currentNodeIds.Contains(key))
        {
            return false;
        }

        if (renderedWorkflowName is { Length: > 0 })
        {
            return key.StartsWith($"{renderedWorkflowName}.", StringComparison.Ordinal) ||
                   !key.Contains('.', StringComparison.Ordinal);
        }

        return false;
    }

    private void SchedulePortMeasurementRefresh()
    {
        var generation = ++_portMeasurementGeneration;
        _ = RefreshPortMeasurementsAsync(generation);
    }

    private async Task RefreshPortMeasurementsAsync(int generation)
    {
        await Task.Delay(80);
        await InvokeAsync(() =>
        {
            if (generation != _portMeasurementGeneration) return;

            foreach (var port in _diagram.Nodes
                         .OfType<FlowDiagramNodeModel>()
                         .SelectMany(static node => node.Ports))
            {
                port.Initialized = false;
                port.Refresh();
            }
        });

        await Task.Delay(80);
        await InvokeAsync(() =>
        {
            if (generation != _portMeasurementGeneration) return;

            foreach (var node in _diagram.Nodes.OfType<FlowDiagramNodeModel>())
            {
                node.RefreshAll();
            }

            _diagram.Refresh();
        });
    }

    private static bool TryGetFlowApplication(JsonElement root, out JsonElement flowApplication)
    {
        flowApplication = default;
        if (root.TryGetProperty("FluxMq", out var fluxMq) &&
            fluxMq.TryGetProperty("FlowApplication", out flowApplication) &&
            flowApplication.ValueKind == JsonValueKind.Object)
        {
            return true;
        }

        return root.TryGetProperty("workflows", out _) || root.TryGetProperty("resources", out _)
            ? (flowApplication = root).ValueKind == JsonValueKind.Object
            : false;
    }

    private static IEnumerable<SourceLinkReference> ReadSourceLinks(JsonElement element)
    {
        if (element.ValueKind == JsonValueKind.String && element.GetString() is { } reference)
        {
            yield return new SourceLinkReference(reference, null);
        }
        else if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
                foreach (var sourceReference in ReadSourceLinks(item))
                    yield return sourceReference;
        }
        else if (element.ValueKind == JsonValueKind.Object)
        {
            var condition = ReadCondition(element);
            if (element.TryGetProperty("from", out var from) || element.TryGetProperty("From", out from))
                foreach (var sourceReference in ReadSourceLinks(from))
                    yield return sourceReference.When is { Length: > 0 }
                        ? sourceReference
                        : sourceReference with { When = condition };
        }
    }

    private static string? ReadCondition(JsonElement element)
    {
        if ((element.TryGetProperty("when", out var when) || element.TryGetProperty("When", out when)) &&
            when.ValueKind == JsonValueKind.String)
        {
            return when.GetString();
        }

        return null;
    }

    private static bool IsDefinitionProperty(string name)
        => string.Equals(name, "type", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(name, "configuration", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(name, "when", StringComparison.OrdinalIgnoreCase);

    private static string ShortTopic(string topic)
        => topic.Length <= 42 ? topic : $"{topic[..18]}...{topic[^18..]}";

    private static string FormatRate(double value) => value switch
    {
        < 0.005 => "0",
        < 1 => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
        < 10 => value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture),
        _ => value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
    };

    private static bool IsErrorLink(string? sourcePortName, string targetPortName)
        => string.Equals(sourcePortName, "Errors", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(targetPortName, "FlowErrors", StringComparison.OrdinalIgnoreCase);

    private readonly record struct SourceLinkReference(string Reference, string? When)
    {
        public bool HasCondition => !string.IsNullOrWhiteSpace(When);
    }

    private void UpdatePulseTimer()
    {
        if (Flow.State == RuntimeWorkspaceState.Running)
        {
            _pulseTimer ??= new System.Threading.Timer(
                _ => _ = InvokeAsync(CheckFilterPulses), null, 0, 200);
        }
        else
        {
            _pulseTimer?.Dispose();
            _pulseTimer = null;
        }
    }

    private void CheckFilterPulses()
    {
        var runtime = Flow.Host?.Runtime;
        if (runtime is null) return;

        foreach (var runtimeNode in runtime.Nodes)
        {
            if (runtimeNode.Node is not FlowFilterComponent<MqttEnvelope> filter) continue;

            var nodeName = runtimeNode.Address.Node.Value;
            var currentCount = filter.PassedCount;
            _filterPassCounts.TryGetValue(nodeName, out var lastCount);
            if (currentCount <= lastCount) continue;

            _filterPassCounts[nodeName] = currentCount;

            var diagramNode = _diagram.Nodes.OfType<FlowDiagramNodeModel>()
                .FirstOrDefault(n => string.Equals(n.NodeName, nodeName, StringComparison.Ordinal));
            if (diagramNode is null) continue;

            var outputPort = diagramNode.Ports.OfType<FlowPortModel>()
                .FirstOrDefault(p => p.Alignment == PortAlignment.Right &&
                                     string.Equals(p.PortName, "Output", StringComparison.OrdinalIgnoreCase));
            if (outputPort is null) continue;

            outputPort.IsPulsing = true;
            diagramNode.Refresh(); // fires NodeModel.Changed → node wrapper re-renders → NodeWidgetShell picks up new PortClass
            SchedulePortPulseReset(outputPort, diagramNode);
        }
    }

    private async void SchedulePortPulseReset(FlowPortModel port, FlowDiagramNodeModel node)
    {
        await Task.Delay(600);
        await InvokeAsync(() =>
        {
            port.IsPulsing = false;
            node.Refresh();
        });
    }

    private void OnFlowChanged(object? sender, EventArgs e)
    {
        InvokeAsync(() =>
        {
            var workflowChanged = _renderedWorkflowName != Flow.ActiveWorkflowName;
            var shouldRebuild = _renderedDefinitionRevision != Flow.DefinitionRevision ||
                workflowChanged ||
                Flow.StagedNodePositions is { Count: > 0 };

            if (shouldRebuild)
            {
                RebuildDiagram();
                if (workflowChanged)
                    ScheduleAutoZoomToFit();
            }
            else
            {
                UpdateDiagramActivity();
                UpdateDiagramDiagnostics();
                _diagram.Refresh();
            }
            UpdatePulseTimer();
            StateHasChanged();
        });
    }

    private void OnLiveChanged(object? sender, EventArgs e)
    {
        InvokeAsync(() =>
        {
            UpdateDiagramActivity();
            _diagram.Refresh();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        _autoZoomGeneration++;
        _pulseTimer?.Dispose();
        _pulseTimer = null;
        if (Flow.GetDiagramState is { } capture)
        {
            Flow.LastNodePositions.Clear();
            foreach (var (key, v) in capture())
                Flow.LastNodePositions[key] = v;
        }
        Flow.GetDiagramState = null;
        _diagram.Nodes.Removed -= OnDiagramNodeRemoved;
        _diagram.Links.Added -= OnDiagramLinkAdded;
        _diagram.Links.Removed -= OnDiagramLinkRemoved;
        _diagram.SelectionChanged -= OnDiagramSelectionChanged;
        Flow.Changed -= OnFlowChanged;
        Live.Changed -= OnLiveChanged;
        DragState.Changed -= OnDragStateChanged;
        DragState.ComponentDropRequested -= OnComponentDropRequested;
        _portMeasurementGeneration++;
    }

    private sealed record DiagramNodeState(Blazor.Diagrams.Core.Geometry.Point Position, bool IsCollapsed);
    private sealed record SelectedWorkflowLink(string SourceNodeName, string SourcePortName, string TargetNodeName, string TargetPortName);
}

@using FluxMq.Scenarios
@using FluxMq.UI.Models
@using FluxMq.UI.Services
@using System.Globalization
@implements IDisposable
@inject LiveMqttWorkspaceService Live
@inject IDialogService DialogService
@inject DragStateService DragState
@inject ScenarioStepCatalog ScenarioSteps
@inject ISnackbar Snackbar

<div class="@DesignerClass"
     aria-label="Test scenario designer"
     @onpointerenter="HandleDesignerPointerEnter"
     @onpointermove="HandleDesignerPointerMove"
     @onpointerleave="HandleDesignerPointerLeave">
    @if (Scenario is null)
    {
        <div class="test-scenario-empty">
            <div class="test-scenario-empty-panel">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="test-scenario-empty-icon" />
                <div class="test-scenario-empty-copy">
                    <span>No test selected</span>
                    <small>@NoTestEmptyText</small>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@AddTestAsync">New test</MudButton>
            </div>
        </div>
    }
    else
    {
        <div class="test-scenario-header">
            <div class="test-scenario-heading">
                <span class="test-scenario-heading-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                </span>
                <div class="test-scenario-title-copy">
                    <div class="test-scenario-title">@Scenario.Name</div>
                    <div class="test-scenario-meta-strip" aria-label="Scenario designer summary">
                        <span>@StepCountText</span>
                        <span>@PhaseCountText</span>
                        <span>@RunModeText</span>
                        <span>@RecentRunCountText</span>
                    </div>
                </div>
            </div>

            <div class="test-scenario-actions">
                @if (Project.LastScenarioRunResult is { } result)
                {
                    <span class="@RunStatusClass(result.Status)" aria-label="@($"Run status {result.Status}")">
                        <MudIcon Icon="@RunStatusIcon(result.Status)" Size="Size.Small" />
                        <span>@result.Status</span>
                    </span>
                    <MudTooltip Text="@ActiveRunTooltip">
                        <span class="@ActiveRunPillClass" aria-label="@ActiveRunTooltip">
                            <MudIcon Icon="@ActiveRunChipIcon" Size="Size.Small" />
                            <span>@ActiveRunChipText</span>
                        </span>
                    </MudTooltip>
                }
                <div class="test-scenario-report-actions" aria-label="Scenario report actions">
                    <MudTooltip Text="@ViewReportTooltip">
                        <MudIconButton Icon="@Icons.Material.Filled.Article"
                                       Size="Size.Small"
                                       Class="test-scenario-icon-action"
                                       Disabled="@(Project.LastScenarioRunResult is null)"
                                       OnClick="@OpenReportAsync" />
                    </MudTooltip>
                    <MudTooltip Text="@CopyReportTooltip">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       Class="test-scenario-icon-action"
                                       Disabled="@(Project.LastScenarioRunResult is null)"
                                       OnClick="@CopyLatestReportAsync" />
                    </MudTooltip>
                    <MudTooltip Text="@SaveReportTooltip">
                        <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                       Size="Size.Small"
                                       Class="test-scenario-icon-action"
                                       Disabled="@(Project.LastScenarioRunResult is null)"
                                       OnClick="@SaveLatestReportAsync" />
                    </MudTooltip>
                    <MudMenu Dense="true"
                             Icon="@Icons.Material.Filled.History"
                             Size="Size.Small"
                             Class="test-scenario-history-menu"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <ChildContent>
                            @if (RecentRuns.Count == 0)
                            {
                                <MudMenuItem Disabled="true" Label="No recent runs" />
                            }
                            else
                            {
                                @if (IsViewingHistoricalRun)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Schedule"
                                                 IconColor="Color.Primary"
                                                 Label="Show latest run"
                                                 OnClick="@ShowLatestRun" />
                                }
                                @foreach (var run in RecentRuns)
                                {
                                    var historyRun = run;
                                    <MudMenuItem Icon="@RunHistoryIcon(historyRun)"
                                                 IconColor="@RunHistoryIconColor(historyRun)"
                                                 Label="@RunHistoryLabel(historyRun)"
                                                 OnClick="@(() => SelectRun(historyRun))" />
                                }
                            }
                        </ChildContent>
                    </MudMenu>
                </div>
                <div class="test-scenario-build-actions" aria-label="Scenario build actions">
                    <MudMenu Dense="true"
                             Icon="@Icons.Material.Filled.Add"
                             Size="Size.Small"
                             Class="test-scenario-add-menu"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        <ChildContent>
                            @foreach (var step in ScenarioSteps.Steps)
                            {
                                var descriptor = step;
                                <MudMenuItem Icon="@descriptor.Icon"
                                             OnClick="@(() => AddStep(descriptor.Type))">@descriptor.DisplayName</MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="test-scenario-run-action"
                               StartIcon="@RunButtonIcon"
                               Disabled="@Project.IsScenarioRunning"
                               OnClick="@RunScenarioAsync">
                        @RunButtonText
                    </MudButton>
                </div>
            </div>
        </div>

        <div class="test-scenario-workspace">
            <div class="test-scenario-builder-strip" aria-label="Scenario build summary">
                <div class="@BuilderMetricClass(Scenario.StepCount > 0)">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" />
                    <span>Steps</span>
                    <strong>@StepCountText</strong>
                </div>
                <div class="@BuilderMetricClass(Scenario.Phases.Any(phase => phase.Steps.Count > 0))">
                    <MudIcon Icon="@Icons.Material.Filled.ViewTimeline" Size="Size.Small" />
                    <span>Active phases</span>
                    <strong>@ActivePhaseCountText</strong>
                </div>
                <div class="@BuilderMetricClass(!Project.IsScenarioRunning)">
                    <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
                    <span>Runner</span>
                    <strong>@RunnerStateText</strong>
                </div>
            </div>

            @if (Scenario.Steps.Count == 0)
            {
                <div class="test-scenario-empty">
                    <div class="test-scenario-empty-panel compact">
                        <MudIcon Icon="@Icons.Material.Filled.ViewTimeline" Class="test-scenario-empty-icon" />
                        <div class="test-scenario-empty-copy">
                            <span>No steps yet</span>
                            <small>Add a step from the toolbar or drag one from the catalog.</small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="@PhaseLanesClass">
                    @foreach (var phase in Scenario.Phases)
                    {
                        <section class="@PhaseLaneClass(phase)" @key="phase.Name">
                            <div class="test-phase-header">
                                <span class="test-phase-icon" aria-hidden="true">
                                    <MudIcon Icon="@PhaseIcon(phase.Kind)" Size="Size.Small" />
                                </span>
                                <div class="test-phase-copy">
                                    <span>@phase.Title</span>
                                    <small>@phase.Kind</small>
                                </div>
                                <strong class="test-phase-count">@PhaseStepCountText(phase)</strong>
                            </div>

                        @if (phase.Steps.Count == 0)
                        {
                            <div class="test-phase-empty">No steps</div>
                        }
                        else
                        {
                            <div class="test-phase-step-stack">
                                @for (var index = 0; index < phase.Steps.Count; index++)
                                {
                                    var step = phase.Steps[index];
                                    var stepNumber = StepNumber(step);
                                    var stepResult = FindStepResult(step);
                                    var visibleConfiguration = VisibleConfiguration(step).ToArray();
                                    <section class="@StepCardClass(step, stepResult)"
                                             aria-label="@StepCardLabel(step, stepResult)"
                                             tabindex="0"
                                             @key="step.Name">
                                        <div class="test-step-index">@stepNumber</div>
                                        <div class="test-step-body">
                                            <div class="test-step-topline">
                                                <div class="test-step-title-block">
                                                    <span class="test-step-name">@step.Name</span>
                                                    <span class="test-step-summary">@BuildStepSummary(step)</span>
                                                </div>
                                                <span class="test-step-badges">
                                                    <span class="@StepTypeClass(step)">@StepTypeLabel(step)</span>
                                                    @if (stepResult is not null)
                                                    {
                                                        <span class="@StepStatusClass(stepResult.Status)">
                                                            <MudIcon Icon="@StepStatusIcon(stepResult)" Size="Size.Small" />
                                                            <span>@stepResult.Status</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="test-step-status idle">
                                                            <MudIcon Icon="@StepStatusIcon(stepResult)" Size="Size.Small" />
                                                            <span>Not run</span>
                                                        </span>
                                                    }
                                                </span>
                                                <span class="test-step-actions">
                                                    <button type="button"
                                                            class="test-step-action"
                                                            title="Move earlier"
                                                            disabled="@(index == 0)"
                                                            @onclick="@(() => MoveStep(step.Name, -1))">
                                                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            class="test-step-action"
                                                            title="Move later"
                                                            disabled="@(index >= phase.Steps.Count - 1)"
                                                            @onclick="@(() => MoveStep(step.Name, 1))">
                                                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            class="test-step-action"
                                                            title="Edit step"
                                                            @onclick="@(() => OpenStepEditorAsync(step))">
                                                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                                                    </button>
                                                    <button type="button"
                                                            class="test-step-action danger"
                                                            title="Delete step"
                                                            @onclick="@(() => RemoveStep(step.Name))">
                                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                                    </button>
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(stepResult?.Message))
                                            {
                                                <div class="test-step-result-message">@stepResult.Message</div>
                                            }
                                            @if (stepResult?.MatchedEvent is { } matched)
                                            {
                                                <div class="test-step-event">
                                                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                                                    <span>@BuildEventSummary(matched)</span>
                                                </div>
                                            }
                                            @if (visibleConfiguration.Length > 0)
                                            {
                                                <dl class="test-step-config">
                                                    @foreach (var item in visibleConfiguration)
                                                    {
                                                        <div class="test-step-config-row">
                                                            <dt>@FormatConfigurationKey(step, item.Key)</dt>
                                                            <dd title="@item.Value">@item.Value</dd>
                                                        </div>
                                                    }
                                                </dl>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                        </section>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    private TestScenarioSnapshot? Scenario => Project.GetActiveTestScenario();

    protected override void OnInitialized()
    {
        DragState.Changed += OnDragStateChanged;
        DragState.ComponentDropRequested += OnComponentDropRequested;
    }

    private string DesignerClass
        => $"test-scenario-designer {(IsTestStepDrag && DragState.ActiveComponentDrag?.IsOverDesigner == true ? "drop-active" : null)}";

    private string NoTestEmptyText => Project.TestNames.Count == 0
        ? "Create a test to build a scenario."
        : "Select a test from the app tabs to edit its scenario.";

    private bool IsTestStepDrag
        => DragState.ActiveComponentDrag is { TargetKind: WorkspaceArtifactKind.Test };

    private bool IsDropActive
        => IsTestStepDrag && DragState.ActiveComponentDrag?.IsOverDesigner == true;

    private string PhaseLanesClass => IsDropActive ? "test-phase-lanes drop-active" : "test-phase-lanes";

    private string RunButtonText => Project.IsScenarioRunning ? "Running" : "Run test";

    private string? RunButtonIcon => Project.IsScenarioRunning ? null : Icons.Material.Filled.PlayArrow;

    private string PhaseCountText
        => Scenario is { } scenario ? FormatPhaseCount(scenario.Phases.Count) : "No phases";

    private string RunModeText
        => "Sequential";

    private string RecentRunCountText
        => FormatRecentRunCount(RecentRuns.Count);

    private string ActivePhaseCountText
        => Scenario is { } scenario
            ? FormatActivePhaseCount(scenario.Phases.Count(phase => phase.Steps.Count > 0))
            : "0 active";

    private string RunnerStateText
        => Project.IsScenarioRunning ? "Running" : "Ready";

    private IReadOnlyList<ScenarioRunResult> RecentRuns
        => Scenario is null
            ? []
            : Project.ScenarioRunHistory
                .Where(result => string.Equals(result.Name, Scenario.Name, StringComparison.Ordinal))
                .Take(5)
                .ToArray();

    private ScenarioRunResult? LatestRun => RecentRuns.FirstOrDefault();

    private bool IsViewingHistoricalRun
        => Project.LastScenarioRunResult is { } activeRun &&
           LatestRun is { } latestRun &&
           !ReferenceEquals(activeRun, latestRun);

    private string ActiveRunScopeText => IsViewingHistoricalRun ? "selected history" : "latest";

    private string ViewReportTooltip => $"View {ActiveRunScopeText} scenario report";

    private string CopyReportTooltip => $"Copy {ActiveRunScopeText} scenario report";

    private string SaveReportTooltip => $"Save {ActiveRunScopeText} scenario report";

    private string ActiveRunChipText
        => Project.LastScenarioRunResult is { } result
            ? $"{(IsViewingHistoricalRun ? "History" : "Latest")} {FormatRunTime(result)}"
            : "No run";

    private string ActiveRunChipIcon
        => IsViewingHistoricalRun ? Icons.Material.Filled.History : Icons.Material.Filled.Schedule;

    private Color ActiveRunChipColor => IsViewingHistoricalRun ? Color.Info : Color.Default;

    private string ActiveRunPillClass
        => IsViewingHistoricalRun ? "test-run-status history" : "test-run-status latest";

    private string ActiveRunTooltip
        => Project.LastScenarioRunResult is { } result
            ? $"Viewing {(IsViewingHistoricalRun ? "a historical" : "the latest")} run from {FormatRunTimestamp(result)}."
            : "No scenario run selected.";

    private string StepCountText
        => Scenario?.StepCount switch
        {
            1 => "1 step",
            > 1 => $"{Scenario.StepCount} steps",
            _ => "no steps"
        };

    private static string PhaseStepCountText(ScenarioPhaseSnapshot phase)
        => phase.Steps.Count switch
        {
            1 => "1 step",
            _ => $"{phase.Steps.Count} steps"
        };

    private string PhaseLaneClass(ScenarioPhaseSnapshot phase)
    {
        var classes = new List<string> { "test-phase-lane" };
        if (phase.Steps.Count == 0)
        {
            classes.Add("empty");
        }

        if (IsDropActive)
        {
            classes.Add("drop-target");
        }

        return string.Join(' ', classes);
    }

    private static string PhaseIcon(string kind)
        => kind switch
        {
            ScenarioPhaseKinds.Setup => Icons.Material.Filled.BuildCircle,
            ScenarioPhaseKinds.Stimulus => Icons.Material.Filled.PlayCircle,
            ScenarioPhaseKinds.Observe => Icons.Material.Filled.Visibility,
            ScenarioPhaseKinds.Assert => Icons.Material.Filled.Rule,
            ScenarioPhaseKinds.Cleanup => Icons.Material.Filled.CleaningServices,
            _ => Icons.Material.Filled.ViewTimeline
        };

    private int StepNumber(ScenarioStepSnapshot step)
    {
        if (Scenario is null)
        {
            return 1;
        }

        for (var index = 0; index < Scenario.Steps.Count; index++)
        {
            if (string.Equals(Scenario.Steps[index].Name, step.Name, StringComparison.Ordinal))
            {
                return index + 1;
            }
        }

        return 1;
    }

    private ScenarioStepDescriptor StepDescriptor(ScenarioStepSnapshot step)
        => ScenarioSteps.Describe(step.Type);

    private string StepTypeLabel(ScenarioStepSnapshot step)
        => StepDescriptor(step).DisplayName;

    private ScenarioStepResult? FindStepResult(ScenarioStepSnapshot step)
        => Project.LastScenarioRunResult?.Steps.FirstOrDefault(result =>
            string.Equals(result.Name, step.Name, StringComparison.Ordinal));

    private string StepCardClass(ScenarioStepSnapshot step, ScenarioStepResult? result)
    {
        var classes = new List<string> { ScenarioStepDisplay.StepCardClass(result?.Status) };
        if (result is not null)
        {
            classes.Add("selected");
        }

        if (result is not null && !IsSuccessfulStepStatus(result.Status))
        {
            classes.Add("issue");
        }

        if (VisibleConfiguration(step).Any())
        {
            classes.Add("configured");
        }

        return string.Join(' ', classes);
    }

    private string StepCardLabel(ScenarioStepSnapshot step, ScenarioStepResult? result)
    {
        var status = result?.Status.ToString() ?? "Not run";
        return $"{step.Name}, {StepTypeLabel(step)}, {status}";
    }

    private string StepTypeClass(ScenarioStepSnapshot step)
        => ScenarioStepDisplay.StepTypeClass(step, ScenarioSteps);

    private static string StepStatusClass(ScenarioStepRunStatus status)
        => ScenarioStepDisplay.StepStatusClass(status);

    private static string StepStatusIcon(ScenarioStepResult? result)
        => result?.Status switch
        {
            ScenarioStepRunStatus.Passed => Icons.Material.Filled.CheckCircle,
            ScenarioStepRunStatus.Skipped => Icons.Material.Filled.Info,
            ScenarioStepRunStatus.Failed => Icons.Material.Filled.ErrorOutline,
            ScenarioStepRunStatus.TimedOut => Icons.Material.Filled.Timer,
            ScenarioStepRunStatus.Canceled => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.RadioButtonUnchecked
        };

    private static string BuilderMetricClass(bool active)
        => active ? "test-builder-metric active" : "test-builder-metric";

    private static string RunStatusClass(ScenarioRunStatus status)
        => status switch
        {
            ScenarioRunStatus.Passed => "test-run-status passed",
            ScenarioRunStatus.Failed => "test-run-status failed",
            ScenarioRunStatus.Canceled => "test-run-status canceled",
            _ => "test-run-status"
        };

    private static string RunStatusIcon(ScenarioRunStatus status)
        => status switch
        {
            ScenarioRunStatus.Passed => Icons.Material.Filled.CheckCircle,
            ScenarioRunStatus.Failed => Icons.Material.Filled.Error,
            ScenarioRunStatus.Canceled => Icons.Material.Filled.Cancel,
            _ => Icons.Material.Filled.History
        };

    private static Color RunStatusColor(ScenarioRunStatus status)
        => status switch
        {
            ScenarioRunStatus.Passed => Color.Success,
            ScenarioRunStatus.Failed => Color.Error,
            ScenarioRunStatus.Canceled => Color.Warning,
            _ => Color.Default
        };

    private string RunHistoryIcon(ScenarioRunResult result)
        => IsSelectedRun(result) ? Icons.Material.Filled.Visibility : RunStatusIcon(result.Status);

    private Color RunHistoryIconColor(ScenarioRunResult result)
        => IsSelectedRun(result) ? Color.Primary : RunStatusColor(result.Status);

    private string RunHistoryLabel(ScenarioRunResult result)
    {
        var duration = result.FinishedAt - result.StartedAt;
        return $"{RunHistoryPrefix(result)} · {result.Status} · {FormatRunTime(result)} · {result.Steps.Count} steps · {FormatDuration(duration)}";
    }

    private string RunHistoryPrefix(ScenarioRunResult result)
    {
        if (IsSelectedRun(result))
        {
            return "Viewing";
        }

        return IsLatestRun(result) ? "Latest" : "History";
    }

    private bool IsSelectedRun(ScenarioRunResult result)
        => Project.LastScenarioRunResult is { } selected &&
           ReferenceEquals(selected, result);

    private bool IsLatestRun(ScenarioRunResult result)
        => LatestRun is { } latest &&
           ReferenceEquals(latest, result);

    private static string FormatRunTime(ScenarioRunResult result)
        => result.FinishedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture);

    private static string FormatRunTimestamp(ScenarioRunResult result)
        => result.FinishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.CurrentCulture);

    private string BuildStepSummary(ScenarioStepSnapshot step)
        => ScenarioStepDisplay.BuildStepSummary(step, ScenarioSteps);

    private IEnumerable<KeyValuePair<string, string>> VisibleConfiguration(ScenarioStepSnapshot step)
        => ScenarioStepDisplay.VisibleConfiguration(step, ScenarioSteps);

    private string FormatConfigurationKey(ScenarioStepSnapshot step, string key)
        => ScenarioStepDisplay.FormatConfigurationKey(step, key, ScenarioSteps);

    private static string JoinParts(params string?[] parts)
    {
        var value = string.Join(" / ", parts.Where(part => !string.IsNullOrWhiteSpace(part)));
        return string.IsNullOrWhiteSpace(value) ? "No summary" : value;
    }

    private static string FormatDuration(TimeSpan duration)
        => duration.TotalSeconds >= 1
            ? $"{duration.TotalSeconds:0.0}s"
            : $"{Math.Max(0, duration.TotalMilliseconds):0}ms";

    private static string FormatStepCount(int count)
        => count == 1 ? "1 step" : $"{count} steps";

    private static string FormatPhaseCount(int count)
        => count == 1 ? "1 phase" : $"{count} phases";

    private static string FormatActivePhaseCount(int count)
        => count == 1 ? "1 active" : $"{count} active";

    private static string FormatRecentRunCount(int count)
        => count == 1 ? "1 recent run" : $"{count} recent runs";

    private static string FormatReportStepCount(ScenarioStepStatusSummary summary)
        => summary.Planned != summary.Executed || summary.NotRun > 0
            ? $"{summary.Executed}/{summary.Planned} steps"
            : FormatStepCount(summary.Executed);

    private static ScenarioStepResult? FirstIssue(ScenarioRunResult result)
        => result.Steps.FirstOrDefault(step => !IsSuccessfulStepStatus(step.Status));

    private static string FirstIssueText(ScenarioRunResult result)
        => FirstIssue(result) is { } issue
            ? $"Issue: {issue.Name} {issue.Status}"
            : string.Empty;

    private static Color FirstIssueColor(ScenarioRunResult result)
        => FirstIssue(result)?.Status switch
        {
            ScenarioStepRunStatus.Failed => Color.Error,
            ScenarioStepRunStatus.TimedOut => Color.Warning,
            ScenarioStepRunStatus.Canceled => Color.Warning,
            _ => Color.Default
        };

    private static bool IsSuccessfulStepStatus(ScenarioStepRunStatus status)
        => status is ScenarioStepRunStatus.Passed or ScenarioStepRunStatus.Skipped;

    private async Task RunScenarioAsync()
    {
        var ready = await Live.EnsureConnectionsAsync(Project.GetConnectionResources());
        if (!ready)
        {
            return;
        }

        await Project.RunActiveTestScenarioAsync();
    }

    private async Task OpenReportAsync()
    {
        if (Project.LastScenarioRunResult is not { } result)
        {
            Snackbar.Add("No scenario report to view", Severity.Warning);
            return;
        }

        var scenario = Scenario;
        var report = ScenarioRunReportFormatter.Create(result, scenario);
        var textReport = ScenarioRunReportFormatter.ToText(report, ScenarioSteps);
        var jsonReport = ScenarioRunReportFormatter.ToJson(report);
        var dialog = await DialogService.ShowAsync<ScenarioRunReportDialog>(
            "Scenario report",
            new DialogParameters
            {
                [nameof(ScenarioRunReportDialog.Title)] = $"Scenario report: {result.Name}",
                [nameof(ScenarioRunReportDialog.RunScopeText)] = IsViewingHistoricalRun ? "Historical run" : "Latest run",
                [nameof(ScenarioRunReportDialog.RunScopeIcon)] = ActiveRunChipIcon,
                [nameof(ScenarioRunReportDialog.RunScopeColor)] = ActiveRunChipColor,
                [nameof(ScenarioRunReportDialog.RunIdText)] = FormatRunIdChip(report.RunId),
                [nameof(ScenarioRunReportDialog.RunStatusText)] = result.Status.ToString(),
                [nameof(ScenarioRunReportDialog.RunStatusColor)] = RunStatusColor(result.Status),
                [nameof(ScenarioRunReportDialog.RunStepSummaryText)] = FormatReportStepCount(report.StepSummary),
                [nameof(ScenarioRunReportDialog.RunIssueText)] = FirstIssueText(result),
                [nameof(ScenarioRunReportDialog.RunIssueColor)] = FirstIssueColor(result),
                [nameof(ScenarioRunReportDialog.RunFinishedAtText)] = FormatRunTimestamp(result),
                [nameof(ScenarioRunReportDialog.RunDurationText)] = FormatDuration(result.FinishedAt - result.StartedAt),
                [nameof(ScenarioRunReportDialog.TextReport)] = textReport,
                [nameof(ScenarioRunReportDialog.JsonReport)] = jsonReport
            },
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                BackdropClick = false
            });

        var dialogResult = await dialog.Result;
        if (dialogResult is not { Canceled: false, Data: ScenarioRunReportDialog.ReportDialogAction action })
        {
            return;
        }

        if (action == ScenarioRunReportDialog.ReportDialogAction.SaveSummary)
        {
            await SaveScenarioReportTextAsync(result, textReport);
        }
        else if (action == ScenarioRunReportDialog.ReportDialogAction.SaveJson)
        {
            await SaveScenarioReportJsonAsync(result, jsonReport);
        }
    }

    private async Task CopyLatestReportAsync()
    {
        if (Project.LastScenarioRunResult is not { } result)
        {
            Snackbar.Add("No scenario report to copy", Severity.Warning);
            return;
        }

        var jsonReport = ScenarioRunReportFormatter.ToJson(result, Scenario);
        await Clipboard.Default.SetTextAsync(jsonReport);
        Snackbar.Add("Scenario report copied to clipboard", Severity.Success);
    }

    private async Task SaveLatestReportAsync()
    {
        if (Project.LastScenarioRunResult is not { } result)
        {
            Snackbar.Add("No scenario report to save", Severity.Warning);
            return;
        }

        var jsonReport = ScenarioRunReportFormatter.ToJson(result, Scenario);
        await SaveScenarioReportJsonAsync(result, jsonReport);
    }

    private async Task SaveScenarioReportJsonAsync(ScenarioRunResult result, string jsonReport)
        => await SaveScenarioReportContentAsync(
            result,
            jsonReport,
            "json",
            "Save scenario report",
            "Full path including .scenario-report.json extension",
            "Scenario report saved",
            "Scenario report save failed");

    private async Task SaveScenarioReportTextAsync(ScenarioRunResult result, string textReport)
        => await SaveScenarioReportContentAsync(
            result,
            textReport,
            "txt",
            "Save scenario summary",
            "Full path including .scenario-report.txt extension",
            "Scenario summary saved",
            "Scenario summary save failed");

    private async Task SaveScenarioReportContentAsync(
        ScenarioRunResult result,
        string content,
        string extension,
        string title,
        string helperText,
        string successMessage,
        string failureMessagePrefix)
    {
        var dialog = await DialogService.ShowAsync<SaveAsDialog>(
            title,
            new DialogParameters
            {
                [nameof(SaveAsDialog.SuggestedPath)] = SuggestedReportPath(result, extension),
                [nameof(SaveAsDialog.DialogTitle)] = title,
                [nameof(SaveAsDialog.HelperText)] = helperText
            },
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false
            });

        var dialogResult = await dialog.Result;
        if (dialogResult is not { Canceled: false, Data: string path } || string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        try
        {
            if (string.Equals(extension, "json", StringComparison.OrdinalIgnoreCase))
            {
                await FlowWorkspaceService.SaveScenarioReportJsonAsync(content, path);
            }
            else
            {
                await FlowWorkspaceService.SaveScenarioReportTextAsync(content, path);
            }

            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Snackbar.Add($"{failureMessagePrefix}: {exception.Message}", Severity.Error);
        }
    }

    private string SuggestedReportPath(ScenarioRunResult result, string extension = "json")
    {
        var directory = !string.IsNullOrWhiteSpace(Project.CurrentFilePath)
            ? Path.GetDirectoryName(Project.CurrentFilePath)
            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "FluxMQ");
        var name = SafeFileName(result.Name);
        var stamp = result.FinishedAt.ToLocalTime().ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);

        return Path.Combine(directory ?? string.Empty, $"{name}-{stamp}.scenario-report.{extension}");
    }

    private static string SafeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var safe = new string(value.Select(character => invalid.Contains(character) ? '-' : character).ToArray());
        return string.IsNullOrWhiteSpace(safe) ? "scenario" : safe;
    }

    private static string FormatRunIdChip(string runId)
        => runId.Length <= 36 ? $"Run {runId}" : $"Run {runId[..33]}...";

    private void ShowLatestRun()
    {
        if (LatestRun is { } latestRun)
        {
            SelectRun(latestRun);
        }
    }

    private void SelectRun(ScenarioRunResult result)
    {
        if (IsSelectedRun(result))
        {
            return;
        }

        var message = IsLatestRun(result)
            ? "Showing latest scenario run"
            : "Scenario run restored from history";

        if (Project.SelectScenarioRunHistoryResult(result))
        {
            Snackbar.Add(message, Severity.Info);
        }
    }

    private void AddStep(string stepType)
        => Project.AddTestScenarioStep(stepType);

    private async Task AddTestAsync()
    {
        var dialog = await DialogService.ShowAsync<NewPipelineDialog>(
            "New Test",
            new DialogParameters
            {
                [nameof(NewPipelineDialog.Title)] = "New Test"
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            Project.AddTest(name.Trim());
        }
    }

    private async Task OpenStepEditorAsync(ScenarioStepSnapshot step)
    {
        var dialog = await DialogService.ShowAsync<ScenarioStepEditorDialog>(
            $"Edit {step.Name}",
            new DialogParameters
            {
                [nameof(ScenarioStepEditorDialog.Step)] = step,
                [nameof(ScenarioStepEditorDialog.ConnectionNames)] = Project.GetConnectionNames()
            },
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ScenarioStepEditorDialog.ScenarioStepUpdate update })
        {
            Project.UpdateTestScenarioStep(step.Name, update.Type, update.Configuration);
        }
    }

    private void RemoveStep(string stepName)
        => Project.RemoveTestScenarioStep(stepName);

    private void MoveStep(string stepName, int offset)
        => Project.MoveTestScenarioStep(stepName, offset);

    private void HandleDesignerPointerEnter(PointerEventArgs args)
    {
        if (IsTestStepDrag)
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerMove(PointerEventArgs args)
    {
        if (IsTestStepDrag)
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerLeave(PointerEventArgs args)
    {
        if (IsTestStepDrag)
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, false);
        }
    }

    private void OnComponentDropRequested(object? sender, ComponentDropRequestedEventArgs args)
    {
        if (args.TargetKind != WorkspaceArtifactKind.Test)
        {
            return;
        }

        InvokeAsync(() =>
        {
            Project.AddTestScenarioStep(args.ComponentType);
            StateHasChanged();
        });
    }

    private void OnDragStateChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    private static string BuildEventSummary(FluxFlow.Engine.Components.FlowEvent flowEvent)
        => JoinParts(
            flowEvent.Type,
            flowEvent.Channel,
            flowEvent.Subject,
            flowEvent.Status,
            flowEvent.PayloadBytes is null ? null : $"{flowEvent.PayloadBytes} B");

    public void Dispose()
    {
        DragState.Changed -= OnDragStateChanged;
        DragState.ComponentDropRequested -= OnComponentDropRequested;
    }
}

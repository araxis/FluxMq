@namespace FluxMq.UI.Components.Workspace
@using FluxMq.App.Metrics
@using FluxMq.Scenarios
@using FluxMq.UI.Models
@using FluxMq.UI.Services
@using System.Globalization

<div class="dashboard-query-builder">
    <div class="dashboard-query-builder-form">
        <section class="dashboard-query-builder-sentence" aria-label="Metric query sentence">
            <div class="dashboard-query-builder-sentence-header">
                <span class="dashboard-query-builder-sentence-kicker">Metric sentence</span>
                <MudSwitch T="bool"
                           Value="@ShowHelp"
                           ValueChanged="@SetShowHelpAsync"
                           Color="Color.Primary"
                           Label="Help"
                           Class="dashboard-query-builder-help-switch" />
            </div>
            <div class="dashboard-query-builder-sentence-line">
                <span>Show</span>
                <button type="button"
                        class="@SentenceTokenClass(SentencePartShow)"
                        @onclick="@(() => FocusSentencePart(SentencePartShow))">@CurrentMeasure.Label</button>
                <span>from</span>
                <button type="button"
                        class="@SentenceTokenClass(SentencePartFrom)"
                        @onclick="@(() => FocusSentencePart(SentencePartFrom))">@CurrentSourceLabel</button>
                <span>during</span>
                <button type="button"
                        class="@SentenceTokenClass(SentencePartDuring)"
                        @onclick="@(() => FocusSentencePart(SentencePartDuring))">@CurrentWindowLabel</button>
                <span>where</span>
                @if (FilterChips.Count == 0)
                {
                    <button type="button"
                            class="@SentenceTokenClass(SentencePartWhere)"
                            @onclick="@(() => FocusSentencePart(SentencePartWhere))">@EmptyFilterSentenceToken</button>
                }
                else
                {
                    <button type="button"
                            class="@SentenceTokenClass(SentencePartWhere)"
                            @onclick="@(() => FocusSentencePart(SentencePartWhere))">@FilterSentenceLabel</button>
                }
                <span>as</span>
                <button type="button"
                        class="@SentenceTokenClass(SentencePartAs)"
                        @onclick="@(() => FocusSentencePart(SentencePartAs))">@CurrentFormatLabel</button>
            </div>
        </section>

        <section class="@SectionClass(SentencePartShow)">
            <div class="dashboard-query-builder-section-heading">
                <span>Show</span>
                @if (ShowHelp)
                {
                    <small>Choose the one value this widget should calculate.</small>
                }
            </div>
            <MudToggleGroup T="string"
                            Value="@Draft.Aggregation"
                            ValueChanged="@SetAggregationAsync"
                            SelectionMode="SelectionMode.SingleSelection"
                            Size="Size.Small"
                            Color="Color.Primary"
                            Outlined="true"
                            Delimiters="true"
                            Class="dashboard-query-builder-measure-toggle"
                            aria-label="Metric measure">
                @foreach (var measure in MeasureOptions)
                {
                    var currentMeasure = measure;
                    <MudToggleItem T="string"
                                   Value="@currentMeasure.Id"
                                   Text="@currentMeasure.Label" />
                }
            </MudToggleGroup>
            @if (ShowHelp)
            {
                <div class="dashboard-query-builder-measure-summary">
                    <div class="dashboard-query-builder-measure-copy">
                        <span>Selected</span>
                        <strong>@CurrentMeasure.Label</strong>
                        <small>@CurrentMeasure.Explanation</small>
                    </div>
                    <div class="dashboard-query-builder-measure-meta">
                        <span><strong>Calculates</strong>@CurrentMeasure.Calculation</span>
                        <span><strong>Good for</strong>@CurrentMeasure.BestFor</span>
                        <span><strong>Source</strong>@CurrentMeasureDefaultSourceLabel</span>
                        <span><strong>Unit</strong>@CurrentMeasure.Unit</span>
                    </div>
                </div>
            }
        </section>

        <section class="@SectionClass(SentencePartFrom)">
            <div class="dashboard-query-builder-section-heading">
                <span>From</span>
                @if (ShowHelp)
                {
                    <small>Choose one compatible projection for @CurrentMeasure.Label.</small>
                }
            </div>
            <MudSelect T="string"
                       Value="@Draft.Source"
                       ValueChanged="@SetSourceAsync"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Class="dashboard-query-builder-select"
                       Style="width:100%;"
                       aria-label="Metric source">
                @foreach (var option in SourceOptions)
                {
                    <MudSelectItem T="string" Value="@option.Value">
                        @option.Label
                    </MudSelectItem>
                }
            </MudSelect>
            @if (ShowHelp)
            {
                <div class="dashboard-query-builder-source-detail">
                    <div class="dashboard-query-builder-source-current">
                        <span>Selected source</span>
                        <strong>@CurrentSourceLabel</strong>
                        <small>@CurrentSourceDescription</small>
                    </div>
                    <div class="dashboard-query-builder-source-list" aria-label="Available sources">
                        <span>Available sources</span>
                        <div>
                            @foreach (var option in SourceOptions)
                            {
                                var currentOption = option;
                                <div class="@SourceItemClass(currentOption)">
                                    <strong>@currentOption.Label</strong>
                                    <small>@SourceCompatibilityLabel(currentOption)</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>

        <section class="@SectionClass(SentencePartDuring)">
            <div class="dashboard-query-builder-section-heading">
                <span>During</span>
                @if (ShowHelp)
                {
                    <small>Pick a preset or type a custom duration.</small>
                }
            </div>
            <div class="dashboard-query-builder-window-presets">
                <span>Preset window</span>
                <MudToggleGroup T="string"
                                Value="@CurrentWindowPresetValue"
                                ValueChanged="@SetWindowAsync"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small"
                                Color="Color.Primary"
                                Outlined="true"
                                Delimiters="true"
                                Class="dashboard-query-builder-window-toggle"
                                aria-label="Preset window">
                    @foreach (var option in WindowOptions)
                    {
                        var currentOption = option;
                        <MudToggleItem T="string"
                                       Value="@currentOption.Value"
                                       Text="@currentOption.Label" />
                    }
                </MudToggleGroup>
            </div>
            <div class="@WindowDetailClass">
                @if (ShowHelp)
                {
                    <div class="dashboard-query-builder-window-current">
                        <span>Current window</span>
                        <strong>@CurrentWindowLabel</strong>
                        <small>@CurrentWindowMode. @CurrentWindowMeaning</small>
                    </div>
                }
                <div class="dashboard-query-builder-window-custom">
                    <span>Custom duration</span>
                    <MudTextField T="string"
                                  Value="@CustomWindowInputValue"
                                  ValueChanged="@SetWindowInputAsync"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Placeholder="2h"
                                  HelperText="@WindowInputHelperText"
                                  Error="@(!Draft.HasValidWindow)"
                                  ErrorText="@Draft.WindowValidationMessage"
                                  Class="dashboard-query-builder-window-input"
                                  Style="width:100%;"
                                  aria-label="Custom duration" />
                    @if (ShowHelp)
                    {
                        <small>@CustomWindowStateLabel</small>
                    }
                </div>
            </div>
        </section>

        <section class="@SectionClass(SentencePartWhere)">
            <div class="dashboard-query-builder-section-heading">
                <span>Match</span>
                @if (ShowHelp)
                {
                    <small>Set the where part of the sentence.</small>
                }
            </div>
            <div class="dashboard-query-builder-match-controls">
                <div class="dashboard-query-builder-filter-grid">
                    <label class="@(ShouldShowStatus ? null : "wide")">
                        <span>Event</span>
                        <MudSelect T="string"
                                   Value="@Draft.EventType"
                                   ValueChanged="@SetEventTypeAsync"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   Class="dashboard-query-builder-select"
                                   Style="width:100%;"
                                   aria-label="Event type">
                            @foreach (var option in EventTypeOptions)
                            {
                                <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </label>
                    @if (ShouldShowStatus)
                    {
                        <label>
                            <span>Status</span>
                            <MudSelect T="string"
                                       Value="@Draft.Status"
                                       ValueChanged="@SetStatusAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Class="dashboard-query-builder-select"
                                       Style="width:100%;"
                                       aria-label="Status">
                                @foreach (var option in StatusOptions)
                                {
                                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                                }
                            </MudSelect>
                        </label>
                    }
                </div>
                @if (Draft.CurrentEventType.Fields.Count > 0)
                {
                    <div class="dashboard-query-builder-match-details">
                        @RenderDetailFilters()
                    </div>
                }
                @if (FilterChips.Count > 0)
                {
                    <div class="dashboard-query-builder-match-chips">
                        <span>Filters</span>
                        <div class="dashboard-query-builder-chip-row">
                            @foreach (var chip in FilterChips)
                            {
                                var currentChip = chip;
                                <button type="button"
                                        class="dashboard-query-builder-filter-chip"
                                        title="Clear filter"
                                        @onclick="@(() => ClearFilterAsync(currentChip.Key))">
                                    <span class="dashboard-query-builder-filter-chip-text">@currentChip.Label</span>
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                </button>
                            }
                            <button type="button"
                                    class="dashboard-query-builder-clear-filters"
                                    @onclick="@ClearAllFiltersAsync">
                                Clear all
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="@SectionClass(SentencePartAs)">
            <div class="dashboard-query-builder-section-heading">
                <span>As</span>
                @if (ShowHelp)
                {
                    <small>Choose how the final number is displayed.</small>
                }
            </div>
            <MudToggleGroup T="string"
                            Value="@Draft.Format"
                            ValueChanged="@SetFormatAsync"
                            SelectionMode="SelectionMode.SingleSelection"
                            Size="Size.Small"
                            Color="Color.Primary"
                            Outlined="true"
                            Delimiters="true"
                            Class="dashboard-query-builder-format-toggle"
                            aria-label="Number format">
                @foreach (var option in FormatOptions)
                {
                    var currentOption = option;
                    <MudToggleItem T="string"
                                   Value="@currentOption.Value"
                                   Text="@currentOption.Label" />
                }
            </MudToggleGroup>
            @if (ShowHelp)
            {
                <div class="dashboard-query-builder-format-detail">
                    <div>
                        <span>Selected format</span>
                        <strong>@CurrentFormat.Label</strong>
                        <small>@CurrentFormatDescription</small>
                    </div>
                    <div>
                        <span>Example</span>
                        <strong>@CurrentFormatExample</strong>
                        <small>Preview updates immediately with the current query.</small>
                    </div>
                </div>
            }
        </section>
    </div>

    <aside class="dashboard-query-builder-preview">
        <DashboardQueryPreviewFrame DataLabel="@PreviewDataLabel"
                                    IsLive="@Preview.IsLive"
                                    ShowHelp="@ShowHelp"
                                    RefreshSample="@RefreshSampleAsync">
            <WidgetContent>
                <DashboardWidgetView Project="@Project"
                                     Widget="@Widget"
                                     SnapshotOverride="@Preview.Snapshot"
                                     MetricValueOverride="@Preview.Value"
                                     Mode="DashboardWidgetRenderMode.Live" />
            </WidgetContent>
            <ResultContent>
                <div class="dashboard-query-builder-result">
                    <div class="dashboard-query-builder-result-main">
                        <div>
                            <span>Result</span>
                            <strong>@Preview.Value.FormattedValue @Preview.Value.Unit</strong>
                        </div>
                        <small>@PreviewMatchLabel</small>
                    </div>
                    <div class="dashboard-query-builder-result-explain">
                        <span>Query</span>
                        <p>@SentenceSummary</p>
                    </div>
                    @if (Preview.TotalMatchCount != Preview.WindowEventCount)
                    {
                        <div class="dashboard-query-builder-result-explain">
                            <span>Retained</span>
                            <p>@PreviewRetainedMatchLabel</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Preview.EmptyReason))
                    {
                        <div class="dashboard-query-builder-result-note">@Preview.EmptyReason</div>
                    }
                    <div class="dashboard-query-builder-active-filters">
                        <span>Filters</span>
                        @if (FilterChips.Count == 0)
                        {
                            <small>@PreviewFilterEmptyLabel</small>
                        }
                        else
                        {
                            @foreach (var filter in FilterChips)
                            {
                                <small>@filter.Label</small>
                            }
                        }
                    </div>
                </div>
            </ResultContent>
        </DashboardQueryPreviewFrame>
    </aside>
</div>

@code {
    private const string SentencePartShow = "show";
    private const string SentencePartFrom = "from";
    private const string SentencePartDuring = "during";
    private const string SentencePartWhere = "where";
    private const string SentencePartAs = "as";

    private static readonly IReadOnlyList<QueryBuilderChoice> WindowOptions =
    [
        new("30s", "30s"),
        new("1m", "1m"),
        new("5m", "5m"),
        new("15m", "15m")
    ];

    private static readonly IReadOnlyList<QueryBuilderFormatChoice> FormatOptions =
    [
        new(
            "auto",
            "Auto",
            "Use the selected measure's natural display: bytes for payload sizes, plain numbers for counts and rates."),
        new(
            "number",
            "Number",
            "Show the raw numeric result without unit conversion."),
        new(
            "bytes",
            "Bytes",
            "Treat the result as a byte count and abbreviate it as B, KB, MB, or GB."),
        new(
            "percent",
            "Percent",
            "Show the result with a percent sign. Use this when the metric already represents a percentage.")
    ];

    private static readonly IReadOnlyList<QueryBuilderChoice> QosFilterOptions =
    [
        new("", "Any"),
        new("0", "0"),
        new("1", "1"),
        new("2", "2")
    ];

    private static readonly IReadOnlyList<QueryBuilderChoice> RetainFilterOptions =
    [
        new("", "Any"),
        new("true", "True"),
        new("false", "False")
    ];

    [Parameter, EditorRequired]
    public FluxMetricQueryDraft Draft { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardMetricQueryPreview Preview { get; set; } = null!;

    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardWidgetSnapshot Widget { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback RefreshSample { get; set; }

    [Parameter]
    public bool ShowHelp { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ShowHelpChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> AllowedMeasures { get; set; } = [];

    private string? _focusedSentencePart;

    private static FluxMetricCatalog MetricCatalog => FluxMetricCatalog.Shared;

    private FluxMetricMeasureDescriptor CurrentMeasure => MetricCatalog.FindMeasure(Draft.Aggregation);

    private IReadOnlyList<FluxMetricMeasureDescriptor> MeasureOptions =>
        AllowedMeasureIds.Count == 0
            ? MetricCatalog.Measures
            : [.. MetricCatalog.Measures.Where(measure => AllowedMeasureIds.Contains(measure.Id))];

    private IReadOnlySet<string> AllowedMeasureIds =>
        AllowedMeasures
            .Where(static measure => !string.IsNullOrWhiteSpace(measure))
            .Select(static measure => measure.Trim())
            .ToHashSet(StringComparer.Ordinal);

    private IReadOnlyList<DashboardQueryBuilderOption> SourceOptions =>
        [
            .. MetricCatalog.Sources
                .Where(source => MetricCatalog.IsSourceCompatible(Draft.Aggregation, source.Id))
                .Select(source => new DashboardQueryBuilderOption(
                    source.Id,
                    source.Label,
                    source.Description))
        ];

    private IReadOnlyList<DashboardQueryBuilderOption> EventTypeOptions =>
        [
            .. MetricCatalog.EventTypes.Select(static option => new DashboardQueryBuilderOption(
                option.Value,
                option.Label))
        ];

    private IReadOnlyList<DashboardQueryBuilderOption> StatusOptions =>
        [
            .. Draft.CurrentEventType.StatusOptions.Select(static option => new DashboardQueryBuilderOption(
                option.Value,
                option.Label))
        ];

    private IReadOnlyList<DashboardQueryBuilderOption> AssertionNameOptions
    {
        get
        {
            var names = Project.GetAssertionNames().ToList();
            var selected = Draft.SubjectStartsWith.Trim();
            if (!string.IsNullOrWhiteSpace(selected) &&
                !names.Contains(selected, StringComparer.Ordinal))
            {
                names.Add(selected);
            }

            return
            [
                new("", "Any assertion"),
                .. names.Select(static name => new DashboardQueryBuilderOption(name, name))
            ];
        }
    }

    private bool ShouldShowStatus => FluxMetricCatalog.ShouldExposeStatus(Draft.CurrentEventType);

    private bool IsAllRuntimeEventsSelected => string.IsNullOrWhiteSpace(Draft.CurrentEventType.Value);

    private IReadOnlyList<FluxMetricQueryFilterChip> FilterChips =>
        FluxMetricQuerySummary.ActiveFilterChips(Draft.BuildDefinition(Widget.Name));

    private string SentenceSummary => FluxMetricQuerySummary.DescribeSentence(Draft.BuildDefinition(Widget.Name));

    private string PreviewDataLabel => $"{Preview.SourceLabel} data";

    private string PreviewMatchLabel
    {
        get
        {
            var noun = Preview.WindowEventCount == 1 ? "event" : "events";
            return $"{Preview.WindowEventCount.ToString("N0", CultureInfo.InvariantCulture)} {Preview.SourceLabel.ToLowerInvariant()} {noun} in {CurrentWindowLabel}";
        }
    }

    private string PreviewRetainedMatchLabel
    {
        get
        {
            var noun = Preview.TotalMatchCount == 1 ? "event" : "events";
            return $"{Preview.TotalMatchCount.ToString("N0", CultureInfo.InvariantCulture)} total matching {Preview.SourceLabel.ToLowerInvariant()} {noun} retained locally.";
        }
    }

    private string PreviewFilterEmptyLabel => IsAllRuntimeEventsSelected
        ? "No filters. All runtime events can match."
        : $"No detail filters. {Draft.CurrentEventType.Label} events can match.";

    private string CurrentSourceDescription =>
        MetricCatalog.FindSource(Draft.Source)?.Description ?? "Runtime metric source.";

    private string CurrentSourceLabel =>
        MetricCatalog.FindSource(Draft.Source)?.Label ?? "Runtime events";

    private string CurrentMeasureDefaultSourceLabel =>
        MetricCatalog.FindSource(CurrentMeasure.DefaultSource)?.Label ?? CurrentMeasure.DefaultSource;

    private string SourceItemClass(DashboardQueryBuilderOption option)
    {
        if (string.Equals(option.Value, Draft.Source, StringComparison.Ordinal))
        {
            return "dashboard-query-builder-source-item selected";
        }

        return "dashboard-query-builder-source-item";
    }

    private string SourceCompatibilityLabel(DashboardQueryBuilderOption option)
    {
        if (string.Equals(option.Value, Draft.Source, StringComparison.Ordinal))
        {
            return "Selected for this KPI.";
        }

        return string.Equals(option.Value, CurrentMeasure.DefaultSource, StringComparison.Ordinal)
            ? $"Recommended default for {CurrentMeasure.Label}."
            : $"Compatible with {CurrentMeasure.Label}.";
    }

    private string CurrentWindowLabel =>
        WindowOptions.FirstOrDefault(option => WindowsRepresentSameDuration(option.Value, Draft.Window))?.Label
        ?? FluxMetricQuerySummary.WindowLabel(Draft.Window);

    private string CurrentWindowPresetValue =>
        WindowOptions.FirstOrDefault(option => WindowsRepresentSameDuration(option.Value, Draft.Window))?.Value
        ?? string.Empty;

    private bool CurrentWindowHasPreset => !string.IsNullOrWhiteSpace(CurrentWindowPresetValue);

    private string CurrentWindowMode => CurrentWindowHasPreset
        ? "Preset window"
        : "Custom duration";

    private string CustomWindowInputValue => CurrentWindowHasPreset
        ? string.Empty
        : Draft.Window;

    private string CustomWindowStateLabel => CurrentWindowHasPreset
        ? "No custom duration active."
        : "Custom duration is active.";

    private string CurrentWindowMeaning => CurrentMeasure.Id switch
    {
        "rate" => $"Rate is calculated from matching events in the last {CurrentWindowLabel}.",
        "topics" => $"Distinct topics are counted from matching traffic in the last {CurrentWindowLabel}.",
        "payloadBytes" => $"Payload bytes are summed from matching messages in the last {CurrentWindowLabel}.",
        "averagePayload" => $"Average payload size is calculated from matching messages in the last {CurrentWindowLabel}.",
        "retained" => $"Retained messages are counted from matching traffic in the last {CurrentWindowLabel}.",
        _ => $"Matching events are counted from the last {CurrentWindowLabel}."
    };

    private string CurrentFormatLabel =>
        FormatOptions.FirstOrDefault(option => string.Equals(option.Value, Draft.Format, StringComparison.Ordinal))?.Label
        ?? "Auto";

    private bool HasMqttDetailFields =>
        Draft.CurrentEventType.Fields.Any(IsQosFilter) ||
        Draft.CurrentEventType.Fields.Any(IsRetainFilter);

    private bool HasSchemaDetailFields =>
        string.Equals(Draft.CurrentEventType.Value, FluxMqEventTypes.JsonSchemaValidated, StringComparison.Ordinal);

    private bool HasFileDetailFields =>
        string.Equals(Draft.CurrentEventType.Value, FluxMqEventTypes.FileWritten, StringComparison.Ordinal);

    private bool HasAssertionDetailFields =>
        string.Equals(Draft.CurrentEventType.Value, FluxMqEventTypes.AssertionEvaluated, StringComparison.Ordinal);

    private IReadOnlyList<FluxMetricFilterFieldDescriptor> TopicDetailFields =>
        [.. Draft.CurrentEventType.Fields.Where(IsTopicDetailFilter)];

    private FluxMetricFilterFieldDescriptor? SchemaIdField =>
        Draft.CurrentEventType.Fields.FirstOrDefault(IsSchemaIdFilter);

    private FluxMetricFilterFieldDescriptor? FilePathField =>
        Draft.CurrentEventType.Fields.FirstOrDefault(IsSubjectFilter);

    private FluxMetricFilterFieldDescriptor? QosField =>
        Draft.CurrentEventType.Fields.FirstOrDefault(IsQosFilter);

    private FluxMetricFilterFieldDescriptor? RetainField =>
        Draft.CurrentEventType.Fields.FirstOrDefault(IsRetainFilter);

    private IReadOnlyList<FluxMetricFilterFieldDescriptor> GenericDetailFields =>
        [.. Draft.CurrentEventType.Fields.Where(static descriptor => !IsQosFilter(descriptor) && !IsRetainFilter(descriptor))];

    private QueryBuilderFormatChoice CurrentFormat =>
        FormatOptions.FirstOrDefault(option => string.Equals(option.Value, Draft.Format, StringComparison.Ordinal))
        ?? FormatOptions[0];

    private string CurrentFormatDescription => CurrentFormat.Value switch
    {
        "auto" => CurrentMeasure.DefaultFormat switch
        {
            "bytes" => "Auto will format this measure as bytes because payload size is its natural unit.",
            "percent" => "Auto will format this measure as a percentage because that is its natural unit.",
            _ => "Auto will format this measure as a plain number because counts and rates read best that way."
        },
        _ => CurrentFormat.Description
    };

    private string CurrentFormatExample => CurrentFormat.Value switch
    {
        "auto" when string.Equals(CurrentMeasure.DefaultFormat, "bytes", StringComparison.Ordinal) => "1.5 KB",
        "auto" when string.Equals(CurrentMeasure.DefaultFormat, "percent", StringComparison.Ordinal) => "72.5%",
        "bytes" => "1.5 KB",
        "percent" => "72.5%",
        _ => "1532"
    };

    private string FilterSentenceLabel =>
        string.Join(", ", FilterChips.Select(static chip => chip.Label));

    private string EmptyFilterSentenceToken => IsAllRuntimeEventsSelected
        ? "all events"
        : "no filters";

    private string WindowDetailClass => ShowHelp
        ? "dashboard-query-builder-window-detail"
        : "dashboard-query-builder-window-detail compact";

    private string? WindowInputHelperText => ShowHelp
        ? "Optional. Use seconds, minutes, or hours. Maximum 24h."
        : null;

    private void FocusSentencePart(string part)
    {
        _focusedSentencePart = part;
    }

    private string SentenceTokenClass(string part)
        => string.Equals(_focusedSentencePart, part, StringComparison.Ordinal)
            ? "dashboard-query-builder-sentence-token active"
            : "dashboard-query-builder-sentence-token";

    private string SectionClass(string part)
        => string.Equals(_focusedSentencePart, part, StringComparison.Ordinal)
            ? "dashboard-query-builder-section focused"
            : "dashboard-query-builder-section";

    private async Task SetAggregationAsync(string value)
    {
        Draft.SetAggregation(value);
        await Changed.InvokeAsync();
    }

    private async Task SetSourceAsync(string? value)
    {
        Draft.SetSource(value);
        await Changed.InvokeAsync();
    }

    private async Task SetWindowAsync(string value)
    {
        Draft.SetWindow(value);
        await Changed.InvokeAsync();
    }

    private async Task SetWindowInputAsync(string? value)
    {
        Draft.SetWindow(string.IsNullOrWhiteSpace(value) ? "1m" : value);
        await Changed.InvokeAsync();
    }

    private async Task SetEventTypeAsync(string? value)
    {
        Draft.SetEventType(value);
        await Changed.InvokeAsync();
    }

    private async Task SetStatusAsync(string? value)
    {
        Draft.Status = Normalize(value);
        await Changed.InvokeAsync();
    }

    private async Task SetFilterAsync(string key, string? value)
    {
        Draft.SetFilterValue(key, value);
        await Changed.InvokeAsync();
    }

    private async Task ClearFilterAsync(string key)
    {
        Draft.ClearFilter(key);
        await Changed.InvokeAsync();
    }

    private async Task ClearAllFiltersAsync()
    {
        foreach (var chip in FilterChips)
        {
            Draft.ClearFilter(chip.Key);
        }

        await Changed.InvokeAsync();
    }

    private async Task SetFormatAsync(string value)
    {
        Draft.SetFormat(value);
        await Changed.InvokeAsync();
    }

    private Task RefreshSampleAsync() => RefreshSample.InvokeAsync();

    private Task SetShowHelpAsync(bool value) => ShowHelpChanged.InvokeAsync(value);

    private RenderFragment RenderDetailFilters()
    {
        if (HasMqttDetailFields)
        {
            return RenderMqttDetailFilters();
        }

        if (HasSchemaDetailFields)
        {
            return RenderSchemaDetailFilters();
        }

        if (HasFileDetailFields)
        {
            return RenderFileDetailFilters();
        }

        if (HasAssertionDetailFields)
        {
            return RenderAssertionDetailFilters();
        }

        return @<div class="dashboard-query-builder-filter-grid">
            @foreach (var field in GenericDetailFields)
            {
                var currentField = field;
                @RenderFilterField(currentField)
            }
        </div>;
    }

    private RenderFragment RenderMqttDetailFilters()
        => @<div class="dashboard-query-builder-detail-panels dashboard-query-builder-mqtt-details">
            <div class="dashboard-query-builder-detail-panel dashboard-query-builder-mqtt-panel">
                <div class="dashboard-query-builder-detail-panel-heading dashboard-query-builder-mqtt-panel-heading">
                    <span>Topic match</span>
                    @if (ShowHelp)
                    {
                        <small>Limit traffic by included and excluded topic prefixes.</small>
                    }
                </div>
                <div class="dashboard-query-builder-filter-grid">
                    @foreach (var field in TopicDetailFields)
                    {
                        var currentField = field;
                        @RenderTextFilterField(currentField)
                    }
                </div>
            </div>
            <div class="dashboard-query-builder-detail-panel dashboard-query-builder-mqtt-panel">
                <div class="dashboard-query-builder-detail-panel-heading dashboard-query-builder-mqtt-panel-heading">
                    <span>MQTT delivery</span>
                    @if (ShowHelp)
                    {
                        <small>Filter by QoS and retain flag without opening dropdowns.</small>
                    }
                </div>
                <div class="dashboard-query-builder-mqtt-delivery-grid">
                    @if (QosField is { } qosField)
                    {
                        @RenderToggleFilterField(qosField, QosFilterOptions)
                    }
                    @if (RetainField is { } retainField)
                    {
                        @RenderToggleFilterField(retainField, RetainFilterOptions)
                    }
                </div>
            </div>
        </div>;

    private RenderFragment RenderSchemaDetailFilters()
        => @<div class="dashboard-query-builder-detail-panels dashboard-query-builder-schema-details">
            <div class="dashboard-query-builder-detail-panel">
                <div class="dashboard-query-builder-detail-panel-heading">
                    <span>Message match</span>
                    @if (ShowHelp)
                    {
                        <small>Filter schema validation events by message topic.</small>
                    }
                </div>
                <div class="dashboard-query-builder-filter-grid">
                    @foreach (var field in TopicDetailFields)
                    {
                        var currentField = field;
                        @RenderTextFilterField(currentField)
                    }
                </div>
            </div>
            <div class="dashboard-query-builder-detail-panel">
                <div class="dashboard-query-builder-detail-panel-heading">
                    <span>Schema match</span>
                    @if (ShowHelp)
                    {
                        <small>Target one schema id, or leave empty for all schemas.</small>
                    }
                </div>
                @if (SchemaIdField is { } schemaField)
                {
                    <div class="dashboard-query-builder-filter-grid">
                        @RenderTextFilterField(schemaField)
                    </div>
                }
            </div>
        </div>;

    private RenderFragment RenderFileDetailFilters()
        => @<div class="dashboard-query-builder-detail-panels dashboard-query-builder-file-details">
            <div class="dashboard-query-builder-detail-panel">
                <div class="dashboard-query-builder-detail-panel-heading">
                    <span>File match</span>
                    @if (ShowHelp)
                    {
                        <small>Leave empty for any written file, or enter the beginning of a path.</small>
                    }
                </div>
                @if (FilePathField is { } fileField)
                {
                    <div class="dashboard-query-builder-filter-grid">
                        @RenderTextFilterField(fileField)
                    </div>
                }
            </div>
        </div>;

    private RenderFragment RenderAssertionDetailFilters()
        => @<div class="dashboard-query-builder-detail-panels dashboard-query-builder-assertion-details">
            <div class="dashboard-query-builder-detail-panel">
                <div class="dashboard-query-builder-detail-panel-heading">
                    <span>Assertion match</span>
                    @if (ShowHelp)
                    {
                        <small>Select one configured assertion, or keep all assertions.</small>
                    }
                </div>
                <label class="dashboard-query-builder-assertion-select">
                    <span>Assertion</span>
                    <MudSelect T="string"
                               Value="@Draft.SubjectStartsWith"
                               ValueChanged="@((string? value) => SetFilterAsync(FluxMetricCatalog.SubjectStartsWithKey, value))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Class="dashboard-query-builder-select"
                               Style="width:100%;"
                               aria-label="Assertion">
                        @foreach (var option in AssertionNameOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    @if (ShowHelp && AssertionNameOptions.Count <= 1)
                    {
                        <small>No assertion nodes found in the current pipelines yet.</small>
                    }
                </label>
            </div>
        </div>;

    private RenderFragment RenderFilterField(FluxMetricFilterFieldDescriptor field)
    {
        if (IsQosFilter(field))
        {
            return RenderToggleFilterField(field, QosFilterOptions);
        }

        if (IsRetainFilter(field))
        {
            return RenderToggleFilterField(field, RetainFilterOptions);
        }

        return RenderTextFilterField(field);
    }

    private RenderFragment RenderTextFilterField(FluxMetricFilterFieldDescriptor field)
        => @<label class="wide">
            <span>@field.Label</span>
            <MudTextField T="string"
                          Value="@Draft.GetFilterValue(field.Key)"
                          ValueChanged="@((string? value) => SetFilterAsync(field.Key, value))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Placeholder="@field.Placeholder"
                          HelperText="@FilterFieldHelperText(field)"
                          Class="dashboard-query-builder-text-field"
                          Style="width:100%;"
                          aria-label="@field.Label" />
        </label>;

    private RenderFragment RenderToggleFilterField(
        FluxMetricFilterFieldDescriptor field,
        IReadOnlyList<QueryBuilderChoice> options)
        => @<label class="dashboard-query-builder-toggle-filter">
            <span>@field.Label</span>
            <MudToggleGroup T="string"
                            Value="@Draft.GetFilterValue(field.Key)"
                            ValueChanged="@((string value) => SetFilterAsync(field.Key, value))"
                            SelectionMode="SelectionMode.SingleSelection"
                            Size="Size.Small"
                            Color="Color.Primary"
                            Outlined="true"
                            Delimiters="true"
                            Class="dashboard-query-builder-filter-toggle"
                            aria-label="@field.Label">
                @foreach (var option in options)
                {
                    var currentOption = option;
                    <MudToggleItem T="string"
                                   Value="@currentOption.Value"
                                   Text="@currentOption.Label" />
                }
            </MudToggleGroup>
        </label>;

    private static bool IsQosFilter(FluxMetricFilterFieldDescriptor field)
        => string.Equals(field.Key, FluxMetricCatalog.AttributeFilterKey("qos"), StringComparison.Ordinal);

    private static bool IsRetainFilter(FluxMetricFilterFieldDescriptor field)
        => string.Equals(field.Key, FluxMetricCatalog.AttributeFilterKey("retain"), StringComparison.Ordinal);

    private static bool IsSchemaIdFilter(FluxMetricFilterFieldDescriptor field)
        => string.Equals(field.Key, FluxMetricCatalog.AttributeFilterKey("schemaId"), StringComparison.Ordinal);

    private static bool IsSubjectFilter(FluxMetricFilterFieldDescriptor field)
        => string.Equals(field.Key, FluxMetricCatalog.SubjectStartsWithKey, StringComparison.Ordinal);

    private static bool IsTopicDetailFilter(FluxMetricFilterFieldDescriptor field)
        => string.Equals(field.Key, FluxMetricCatalog.TopicStartsWithKey, StringComparison.Ordinal) ||
           string.Equals(field.Key, FluxMetricCatalog.TopicNotStartsWithKey, StringComparison.Ordinal);

    private string? FilterFieldHelperText(FluxMetricFilterFieldDescriptor field)
        => ShowHelp ? field.HelperText : null;

    private static bool WindowsRepresentSameDuration(string? left, string? right)
    {
        return TryGetWindowSeconds(left, out var leftSeconds) &&
               TryGetWindowSeconds(right, out var rightSeconds) &&
               Math.Abs(leftSeconds - rightSeconds) < 0.001d;
    }

    private static bool TryGetWindowSeconds(string? value, out double seconds)
    {
        seconds = 0d;
        if (!FluxMetricQueryDraft.TryNormalizeWindow(value, out var normalized))
        {
            return false;
        }

        var suffix = normalized[^1];
        var amountText = normalized[..^1];
        if (!double.TryParse(amountText, NumberStyles.Float, CultureInfo.InvariantCulture, out var amount))
        {
            return false;
        }

        seconds = suffix switch
        {
            'h' => amount * 3600d,
            'm' => amount * 60d,
            _ => amount
        };
        return true;
    }

    private static string Normalize(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private sealed record QueryBuilderChoice(string Value, string Label);

    private sealed record QueryBuilderFormatChoice(
        string Value,
        string Label,
        string Description);
}

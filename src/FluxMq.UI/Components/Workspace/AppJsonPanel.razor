@implements IDisposable
@inject ISnackbar Snackbar

<div class="app-json-view">
    <div class="app-json-toolbar" aria-label="Application JSON toolbar">
        <div class="app-json-title">
            <span class="app-json-title-icon">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
            </span>
            <div class="app-json-title-copy">
                <strong>App JSON</strong>
                <span>@FileLabel</span>
            </div>
        </div>
        <div class="app-json-meta" aria-label="JSON summary">
            <span>@JsonLineCount lines</span>
            <span>@JsonSizeLabel</span>
        </div>
        @if (Project.HasUnsavedChanges)
        {
            <span class="app-json-state unsaved" role="status" aria-live="polite">Unsaved</span>
        }
        <MudTooltip Text="Copy JSON">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Small"
                           aria-label="Copy JSON"
                           Class="app-json-copy-button"
                           Disabled="@string.IsNullOrWhiteSpace(_fullJson)"
                           OnClick="@CopyAsync" />
        </MudTooltip>
    </div>

    <div class="app-json-editor-shell">
        @if (string.IsNullOrWhiteSpace(_fullJson))
        {
            <div class="app-json-empty" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.CodeOff" Size="Size.Small" />
                <strong>No JSON available</strong>
                <span>Update the app definition to generate the full JSON view.</span>
            </div>
        }
        else
        {
            <pre class="app-json-body" aria-label="Application definition JSON">@_fullJson</pre>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public FlowWorkspaceService Project { get; set; } = null!;
    private string _fullJson = string.Empty;

    private string FileLabel => string.IsNullOrWhiteSpace(Project.CurrentFilePath)
        ? "In memory - not saved"
        : Project.CurrentFilePath;

    private int JsonLineCount => string.IsNullOrEmpty(_fullJson)
        ? 0
        : _fullJson.Count(static character => character == '\n') + 1;

    private string JsonSizeLabel
    {
        get
        {
            var bytes = System.Text.Encoding.UTF8.GetByteCount(_fullJson);
            return bytes < 1024
                ? $"{bytes} B"
                : $"{bytes / 1024d:0.#} KB";
        }
    }

    protected override void OnInitialized()
    {
        Project.Changed += OnChanged;
        _fullJson = Project.GetFullDefinitionJson();
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _fullJson = Project.GetFullDefinitionJson();
        InvokeAsync(StateHasChanged);
    }

    private async Task CopyAsync()
    {
        await Clipboard.Default.SetTextAsync(_fullJson);
        Snackbar.Add("JSON copied to clipboard", Severity.Success);
    }

    public void Dispose() => Project.Changed -= OnChanged;
}

@implements IDisposable
@inject ISnackbar Snackbar
@inject AppThemeService ThemeService
@inject IJSRuntime JsRuntime

<div class="app-json-view">
    <div class="app-json-toolbar" aria-label="Application JSON toolbar">
        <div class="app-json-title">
            <span class="app-json-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" aria-hidden="true" />
            </span>
            <div class="app-json-title-copy">
                <strong>App JSON</strong>
                <span>@FileLabel</span>
            </div>
        </div>
        <div class="app-json-meta" aria-label="Application JSON line and size summary">
            <span>@JsonLineCount lines</span>
            <span>@JsonSizeLabel</span>
        </div>
        @if (Project.HasUnsavedChanges)
        {
            <span class="app-json-unsaved-indicator" role="status" aria-live="polite">Unsaved</span>
        }
        <MudTooltip Text="Copy JSON">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Small"
                           aria-label="Copy JSON"
                           Class="app-json-copy-button"
                           Disabled="@string.IsNullOrWhiteSpace(_fullJson)"
                           OnClick="@CopyAsync" />
        </MudTooltip>
    </div>

    <div class="app-json-editor-shell" aria-label="Application definition JSON">
        @if (string.IsNullOrWhiteSpace(_fullJson))
        {
            <div class="app-json-empty" role="status" aria-live="polite">
                <MudIcon Icon="@Icons.Material.Filled.CodeOff" Size="Size.Small" aria-hidden="true" />
                <strong>No JSON available</strong>
                <span>Update the app definition to generate the full JSON view.</span>
            </div>
        }
        else
        {
            <StandaloneCodeEditor @ref="_editor"
                                  Id="@EditorId"
                                  CssClass="app-json-monaco-editor"
                                  ConstructionOptions="@EditorConstructionOptions" />
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public FlowWorkspaceService Project { get; set; } = null!;

    private string _fullJson = string.Empty;
    private StandaloneCodeEditor? _editor;

    private const string EditorId = "app-json-viewer";

    private string FileLabel => string.IsNullOrWhiteSpace(Project.CurrentFilePath)
        ? "In memory - not saved"
        : Project.CurrentFilePath;

    private int JsonLineCount => string.IsNullOrEmpty(_fullJson)
        ? 0
        : _fullJson.Count(static character => character == '\n') + 1;

    private string JsonSizeLabel
    {
        get
        {
            var bytes = System.Text.Encoding.UTF8.GetByteCount(_fullJson);
            return bytes < 1024
                ? $"{bytes} B"
                : $"{bytes / 1024d:0.#} KB";
        }
    }

    protected override void OnInitialized()
    {
        Project.Changed += OnChanged;
        ThemeService.Changed += OnThemeChanged;
        _fullJson = Project.GetFullDefinitionJson();
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _fullJson = Project.GetFullDefinitionJson();
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncEditorAsync();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ConfigureMonacoAsync();
            await SyncEditorAsync();
        }
    }

    private void OnThemeChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(ConfigureMonacoAsync);

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
        => new()
        {
            AutomaticLayout = true,
            Language = "json",
            ReadOnly = true,
            RenderLineHighlight = "none",
            ScrollBeyondLastLine = false,
            Theme = ThemeService.IsDarkMode ? "fluxmq-dark" : "fluxmq-light",
            Value = _fullJson
        };

    private async Task ConfigureMonacoAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("fluxmqMonaco.ensureConfigured", ThemeService.IsDarkMode);
        }
        catch (Exception exception) when (IsNonCriticalEditorException(exception))
        {
            Console.Error.WriteLine($"App JSON Monaco configuration failed: {exception.Message}");
        }
    }

    private async Task SyncEditorAsync()
    {
        if (_editor is not null)
        {
            try
            {
                await _editor.SetValue(_fullJson);
            }
            catch (Exception exception) when (IsNonCriticalEditorException(exception))
            {
                Console.Error.WriteLine($"App JSON Monaco sync failed: {exception.Message}");
            }
        }
    }

    private static bool IsNonCriticalEditorException(Exception exception)
        => exception is JSException or JSDisconnectedException or InvalidOperationException or ObjectDisposedException;

    private async Task CopyAsync()
    {
        await Clipboard.Default.SetTextAsync(_fullJson);
        Snackbar.Add("JSON copied to clipboard", Severity.Success);
    }

    public void Dispose()
    {
        Project.Changed -= OnChanged;
        ThemeService.Changed -= OnThemeChanged;
    }
}

@code {
    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> BooleanOptions =
    [
        new(bool.TrueString, Icons.Material.Filled.Check, "On"),
        new(bool.FalseString, Icons.Material.Filled.Close, "Off")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> SystemTopicOptions =
    [
        new(bool.FalseString, Icons.Material.Filled.Visibility, "Show"),
        new(bool.TrueString, Icons.Material.Filled.VisibilityOff, "Hide")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> TableDensityOptions =
    [
        new(DashboardEventTableVisualOptions.DensityCompact, Icons.Material.Filled.DensitySmall, "Compact"),
        new(DashboardEventTableVisualOptions.DensityComfortable, Icons.Material.Filled.DensityMedium, "Comfort")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> GaugeStyleOptions =
    [
        new(DashboardEventGaugeWidgetOptions.StyleRing, Icons.Material.Filled.DonutLarge, "Ring"),
        new(DashboardEventGaugeWidgetOptions.StyleMeter, Icons.Material.Filled.Speed, "Meter")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> BarOrientationOptions =
    [
        new(DashboardBarChartVisualOptions.OrientationVertical, Icons.Material.Filled.ViewColumn, "Vertical"),
        new(DashboardBarChartVisualOptions.OrientationHorizontal, Icons.Material.Filled.TableRows, "Horizontal")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> ChartTypeOptions =
    [
        new(DashboardChartWidgetOptions.TypeBars, Icons.Material.Filled.BarChart, "Bars"),
        new(DashboardChartWidgetOptions.TypeLine, Icons.Material.Filled.ShowChart, "Line"),

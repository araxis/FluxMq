@using FluxMq.UI.Models
@using FluxMq.UI.Services

@if (Draft is not null)
{
    @if (Draft.Profile.UsesLatestEventVisual)
    {
        <PropertyGridRow Name="Header">
            <input class="property-grid-input"
                   value="@Draft.LatestHeader"
                   @oninput="@((ChangeEventArgs args) => ChangeLatestEventVisualPropertyAsync(DashboardLatestEventVisualOptions.HeaderKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Show header">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowHeaderKey, Draft.LatestShowHeader)
        </PropertyGridRow>
        <PropertyGridRow Name="Event type">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowTypeKey, Draft.LatestShowType)
        </PropertyGridRow>
        <PropertyGridRow Name="Topic">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowTopicKey, Draft.LatestShowTopic)
        </PropertyGridRow>
        <PropertyGridRow Name="Status">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowStatusKey, Draft.LatestShowStatus)
        </PropertyGridRow>
        <PropertyGridRow Name="Time">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowTimestampKey, Draft.LatestShowTimestamp)
        </PropertyGridRow>
        <PropertyGridRow Name="Payload">
            @BooleanRow(DashboardLatestEventVisualOptions.ShowPayloadKey, Draft.LatestShowPayload)
        </PropertyGridRow>
        <PropertyGridRow Name="Empty text">
            <input class="property-grid-input"
                   value="@Draft.LatestEmptyText"
                   @oninput="@((ChangeEventArgs args) => ChangeLatestEventVisualPropertyAsync(DashboardLatestEventVisualOptions.EmptyTextKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Header color">
            <PropertyGridColorPicker Value="@Draft.LatestHeaderColor"
                                     ValueChanged="@((string? value) => ChangeLatestEventVisualPropertyAsync(DashboardLatestEventVisualOptions.HeaderColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Detail color">
            <PropertyGridColorPicker Value="@Draft.LatestDetailColor"
                                     ValueChanged="@((string? value) => ChangeLatestEventVisualPropertyAsync(DashboardLatestEventVisualOptions.DetailColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Payload color">
            <PropertyGridColorPicker Value="@Draft.LatestPayloadColor"
                                     ValueChanged="@((string? value) => ChangeLatestEventVisualPropertyAsync(DashboardLatestEventVisualOptions.PayloadColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesEventTableVisual)
    {
        <PropertyGridRow Name="Header">
            <input class="property-grid-input"
                   value="@Draft.TableHeader"
                   @oninput="@((ChangeEventArgs args) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.HeaderKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Show header">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowHeaderKey, Draft.TableShowHeader)
        </PropertyGridRow>
        <PropertyGridRow Name="Rows">
            <input class="property-grid-input"
                   type="number"
                   min="@DashboardEventTableVisualOptions.MinRowCount"
                   max="@DashboardEventTableVisualOptions.MaxRowCount"
                   value="@Draft.TableRowCount"
                   @oninput="@((ChangeEventArgs args) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.RowCountKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Density">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.TableDensity, DashboardEventTableVisualOptions.DensityCompact)"
                        @onclick="@(() => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.DensityKey, DashboardEventTableVisualOptions.DensityCompact))">Compact</button>
                <button type="button"
                        class="@ChoiceClass(Draft.TableDensity, DashboardEventTableVisualOptions.DensityComfortable)"
                        @onclick="@(() => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.DensityKey, DashboardEventTableVisualOptions.DensityComfortable))">Comfort</button>
            </div>
        </PropertyGridRow>
        <PropertyGridRow Name="Time">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowTimeKey, Draft.TableShowTime)
        </PropertyGridRow>
        <PropertyGridRow Name="Event">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowEventKey, Draft.TableShowEvent)
        </PropertyGridRow>
        <PropertyGridRow Name="Topic">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowTopicKey, Draft.TableShowTopic)
        </PropertyGridRow>
        <PropertyGridRow Name="Status">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowStatusKey, Draft.TableShowStatus)
        </PropertyGridRow>
        <PropertyGridRow Name="Payload">
            @TableBooleanRow(DashboardEventTableVisualOptions.ShowPayloadKey, Draft.TableShowPayload)
        </PropertyGridRow>
        <PropertyGridRow Name="Empty text">
            <input class="property-grid-input"
                   value="@Draft.TableEmptyText"
                   @oninput="@((ChangeEventArgs args) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.EmptyTextKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Header color">
            <PropertyGridColorPicker Value="@Draft.TableHeaderColor"
                                     ValueChanged="@((string? value) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.HeaderColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Text color">
            <PropertyGridColorPicker Value="@Draft.TableTextColor"
                                     ValueChanged="@((string? value) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.TextColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Muted color">
            <PropertyGridColorPicker Value="@Draft.TableMutedColor"
                                     ValueChanged="@((string? value) => ChangeEventTableVisualPropertyAsync(DashboardEventTableVisualOptions.MutedColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesTopicActivityVisual)
    {
        <PropertyGridRow Name="Header">
            <input class="property-grid-input"
                   value="@Draft.TopicActivityHeader"
                   @oninput="@((ChangeEventArgs args) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.HeaderKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Show header">
            @TopicActivityBooleanRow(DashboardTopicActivityVisualOptions.ShowHeaderKey, Draft.TopicActivityShowHeader)
        </PropertyGridRow>
        <PropertyGridRow Name="Topics">
            <input class="property-grid-input"
                   type="number"
                   min="@DashboardTopicActivityVisualOptions.MinLimit"
                   max="@DashboardTopicActivityVisualOptions.MaxLimit"
                   value="@Draft.TopicActivityLimit"
                   @oninput="@((ChangeEventArgs args) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.LimitKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Counts">
            @TopicActivityBooleanRow(DashboardTopicActivityVisualOptions.ShowCountsKey, Draft.TopicActivityShowCounts)
        </PropertyGridRow>
        <PropertyGridRow Name="Empty text">
            <input class="property-grid-input"
                   value="@Draft.TopicActivityEmptyText"
                   @oninput="@((ChangeEventArgs args) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.EmptyTextKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Header color">
            <PropertyGridColorPicker Value="@Draft.TopicActivityHeaderColor"
                                     ValueChanged="@((string? value) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.HeaderColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Text color">
            <PropertyGridColorPicker Value="@Draft.TopicActivityTextColor"
                                     ValueChanged="@((string? value) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.TextColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Muted color">
            <PropertyGridColorPicker Value="@Draft.TopicActivityMutedColor"
                                     ValueChanged="@((string? value) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.MutedColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Accent color">
            <PropertyGridColorPicker Value="@Draft.TopicActivityAccentColor"
                                     ValueChanged="@((string? value) => ChangeTopicActivityVisualPropertyAsync(DashboardTopicActivityVisualOptions.AccentColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesTopicTreeVisual)
    {
        <PropertyGridRow Name="Header">
            <input class="property-grid-input"
                   value="@Draft.TopicTreeHeader"
                   @oninput="@((ChangeEventArgs args) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.HeaderKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Show header">
            @TopicTreeBooleanRow(DashboardTopicTreeVisualOptions.ShowHeaderKey, Draft.TopicTreeShowHeader)
        </PropertyGridRow>
        <PropertyGridRow Name="Summary">
            @TopicTreeBooleanRow(DashboardTopicTreeVisualOptions.ShowSummaryKey, Draft.TopicTreeShowSummary)
        </PropertyGridRow>
        <PropertyGridRow Name="Topic count">
            @TopicTreeBooleanRow(DashboardTopicTreeVisualOptions.ShowTopicCountKey, Draft.TopicTreeShowTopicCount)
        </PropertyGridRow>
        <PropertyGridRow Name="Message count">
            @TopicTreeBooleanRow(DashboardTopicTreeVisualOptions.ShowMessageCountKey, Draft.TopicTreeShowMessageCount)
        </PropertyGridRow>
        <PropertyGridRow Name="@Labels.TopicSystemRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@BooleanChoiceClass(!Draft.ExcludeSystemTopics, true)"
                        @onclick="@(() => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.ExcludeSystemTopicsKey, bool.FalseString))">Show</button>
                <button type="button"
                        class="@BooleanChoiceClass(Draft.ExcludeSystemTopics, true)"
                        @onclick="@(() => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.ExcludeSystemTopicsKey, bool.TrueString))">Hide</button>
            </div>
        </PropertyGridRow>
        <PropertyGridRow Name="Empty text">
            <input class="property-grid-input"
                   value="@Draft.TopicTreeEmptyText"
                   @oninput="@((ChangeEventArgs args) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.EmptyTextKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Header color">
            <PropertyGridColorPicker Value="@Draft.TopicTreeHeaderColor"
                                     ValueChanged="@((string? value) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.HeaderColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Text color">
            <PropertyGridColorPicker Value="@Draft.TopicTreeTextColor"
                                     ValueChanged="@((string? value) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.TextColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Muted color">
            <PropertyGridColorPicker Value="@Draft.TopicTreeMutedColor"
                                     ValueChanged="@((string? value) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.MutedColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Accent color">
            <PropertyGridColorPicker Value="@Draft.TopicTreeAccentColor"
                                     ValueChanged="@((string? value) => ChangeTopicTreeVisualPropertyAsync(DashboardTopicTreeVisualOptions.AccentColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesGaugeStyle)
    {
        <PropertyGridRow Name="@Labels.GaugeRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.GaugeStyle, DashboardEventGaugeWidgetOptions.StyleRing)"
                        @onclick="@(() => GaugeStyleChanged.InvokeAsync(DashboardEventGaugeWidgetOptions.StyleRing))">Ring</button>
                <button type="button"
                        class="@ChoiceClass(Draft.GaugeStyle, DashboardEventGaugeWidgetOptions.StyleMeter)"
                        @onclick="@(() => GaugeStyleChanged.InvokeAsync(DashboardEventGaugeWidgetOptions.StyleMeter))">Meter</button>
            </div>
        </PropertyGridRow>
        <PropertyGridRow Name="Min">
            <input class="property-grid-input"
                   value="@Draft.GaugeMin"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.MinKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Max">
            <input class="property-grid-input"
                   value="@Draft.GaugeMax"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.MaxKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Target">
            <input class="property-grid-input"
                   value="@Draft.GaugeTarget"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.TargetKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Warning">
            <input class="property-grid-input"
                   value="@Draft.GaugeWarning"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.WarningKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Critical">
            <input class="property-grid-input"
                   value="@Draft.GaugeCritical"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.CriticalKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Normal color">
            <PropertyGridColorPicker Value="@Draft.GaugeNormalColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.NormalColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Warning color">
            <PropertyGridColorPicker Value="@Draft.GaugeWarningColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.WarningColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Critical color">
            <PropertyGridColorPicker Value="@Draft.GaugeCriticalColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardEventGaugeWidgetOptions.CriticalColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesChartType)
    {
        <PropertyGridRow Name="@Labels.ChartRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardChartWidgetOptions.TypeBars)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardChartWidgetOptions.TypeBars))">Bars</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardChartWidgetOptions.TypeLine)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardChartWidgetOptions.TypeLine))">Line</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardChartWidgetOptions.TypeArea)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardChartWidgetOptions.TypeArea))">Area</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardChartWidgetOptions.TypeTopics)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardChartWidgetOptions.TypeTopics))">Topics</button>
            </div>
        </PropertyGridRow>
    }

}

@code {
    [Parameter]
    public DashboardWidgetSettingsDraft? Draft { get; set; }

    [Parameter]
    public DashboardWidgetInspectorLabels Labels { get; set; } = DashboardWidgetInspectorLabels.Default;

    [Parameter]
    public EventCallback<string?> GaugeStyleChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> GaugePropertyChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> LatestEventVisualPropertyChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> EventTableVisualPropertyChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> TopicActivityVisualPropertyChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> TopicTreeVisualPropertyChanged { get; set; }

    [Parameter]
    public EventCallback<string?> ChartTypeChanged { get; set; }

    private static string ChoiceClass(string? currentValue, string value)
        => string.Equals(currentValue ?? string.Empty, value, StringComparison.Ordinal)
            ? "property-grid-choice selected"
            : "property-grid-choice";

    private static string BooleanChoiceClass(bool currentValue, bool value)
        => currentValue == value
            ? "property-grid-choice selected"
            : "property-grid-choice";

    private Task ChangeGaugePropertyAsync(string key, string? value)
        => GaugePropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private Task ChangeLatestEventVisualPropertyAsync(string key, string? value)
        => LatestEventVisualPropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private Task ChangeEventTableVisualPropertyAsync(string key, string? value)
        => EventTableVisualPropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private Task ChangeTopicActivityVisualPropertyAsync(string key, string? value)
        => TopicActivityVisualPropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private Task ChangeTopicTreeVisualPropertyAsync(string key, string? value)
        => TopicTreeVisualPropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));

    private RenderFragment BooleanRow(string key, bool value) => @<div class="property-grid-button-group">
        <button type="button"
                class="@BooleanChoiceClass(value, true)"
                @onclick="@(() => ChangeLatestEventVisualPropertyAsync(key, bool.TrueString))">On</button>
        <button type="button"
                class="@BooleanChoiceClass(value, false)"
                @onclick="@(() => ChangeLatestEventVisualPropertyAsync(key, bool.FalseString))">Off</button>
    </div>;

    private RenderFragment TableBooleanRow(string key, bool value) => @<div class="property-grid-button-group">
        <button type="button"
                class="@BooleanChoiceClass(value, true)"
                @onclick="@(() => ChangeEventTableVisualPropertyAsync(key, bool.TrueString))">On</button>
        <button type="button"
                class="@BooleanChoiceClass(value, false)"
                @onclick="@(() => ChangeEventTableVisualPropertyAsync(key, bool.FalseString))">Off</button>
    </div>;

    private RenderFragment TopicActivityBooleanRow(string key, bool value) => @<div class="property-grid-button-group">
        <button type="button"
                class="@BooleanChoiceClass(value, true)"
                @onclick="@(() => ChangeTopicActivityVisualPropertyAsync(key, bool.TrueString))">On</button>
        <button type="button"
                class="@BooleanChoiceClass(value, false)"
                @onclick="@(() => ChangeTopicActivityVisualPropertyAsync(key, bool.FalseString))">Off</button>
    </div>;

    private RenderFragment TopicTreeBooleanRow(string key, bool value) => @<div class="property-grid-button-group">
        <button type="button"
                class="@BooleanChoiceClass(value, true)"
                @onclick="@(() => ChangeTopicTreeVisualPropertyAsync(key, bool.TrueString))">On</button>
        <button type="button"
                class="@BooleanChoiceClass(value, false)"
                @onclick="@(() => ChangeTopicTreeVisualPropertyAsync(key, bool.FalseString))">Off</button>
    </div>;
}

@using FluxMq.UI.Models
@using FluxMq.UI.Services

@if (Draft is not null)
{
    @if (Draft.Profile.UsesGaugeStyle)
    {
        <PropertyGridRow Name="@Labels.GaugeRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.GaugeStyle, DashboardWidgetCatalog.GaugeStyleRing)"
                        @onclick="@(() => GaugeStyleChanged.InvokeAsync(DashboardWidgetCatalog.GaugeStyleRing))">Ring</button>
                <button type="button"
                        class="@ChoiceClass(Draft.GaugeStyle, DashboardWidgetCatalog.GaugeStyleMeter)"
                        @onclick="@(() => GaugeStyleChanged.InvokeAsync(DashboardWidgetCatalog.GaugeStyleMeter))">Meter</button>
            </div>
        </PropertyGridRow>
        <PropertyGridRow Name="Min">
            <input class="property-grid-input"
                   value="@Draft.GaugeMin"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeMinKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Max">
            <input class="property-grid-input"
                   value="@Draft.GaugeMax"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeMaxKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Target">
            <input class="property-grid-input"
                   value="@Draft.GaugeTarget"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeTargetKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Warning">
            <input class="property-grid-input"
                   value="@Draft.GaugeWarning"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeWarningKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Critical">
            <input class="property-grid-input"
                   value="@Draft.GaugeCritical"
                   @oninput="@((ChangeEventArgs args) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeCriticalKey, args.Value?.ToString()))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Normal color">
            <PropertyGridColorPicker Value="@Draft.GaugeNormalColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeNormalColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Warning color">
            <PropertyGridColorPicker Value="@Draft.GaugeWarningColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeWarningColorKey, value))" />
        </PropertyGridRow>
        <PropertyGridRow Name="Critical color">
            <PropertyGridColorPicker Value="@Draft.GaugeCriticalColor"
                                     ValueChanged="@((string? value) => ChangeGaugePropertyAsync(DashboardWidgetCatalog.GaugeCriticalColorKey, value))" />
        </PropertyGridRow>
    }

    @if (Draft.Profile.UsesChartType)
    {
        <PropertyGridRow Name="@Labels.ChartRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardWidgetCatalog.ChartTypeBars)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardWidgetCatalog.ChartTypeBars))">Bars</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardWidgetCatalog.ChartTypeLine)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardWidgetCatalog.ChartTypeLine))">Line</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardWidgetCatalog.ChartTypeArea)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardWidgetCatalog.ChartTypeArea))">Area</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ChartType, DashboardWidgetCatalog.ChartTypeTopics)"
                        @onclick="@(() => ChartTypeChanged.InvokeAsync(DashboardWidgetCatalog.ChartTypeTopics))">Topics</button>
            </div>
        </PropertyGridRow>
    }

    @if (Draft.Profile.IsTopicTreeWidget)
    {
        <PropertyGridRow Name="@Labels.TopicSystemRow">
            <div class="property-grid-button-group">
                <button type="button"
                        class="@ChoiceClass(Draft.ExcludeSystemTopics ? "false" : "true", "true")"
                        @onclick="@(() => ExcludeSystemTopicsChanged.InvokeAsync(false))">Show</button>
                <button type="button"
                        class="@ChoiceClass(Draft.ExcludeSystemTopics ? "true" : "false", "true")"
                        @onclick="@(() => ExcludeSystemTopicsChanged.InvokeAsync(true))">Hide</button>
            </div>
        </PropertyGridRow>
    }
}

@code {
    [Parameter]
    public DashboardWidgetSettingsDraft? Draft { get; set; }

    [Parameter]
    public DashboardWidgetInspectorLabels Labels { get; set; } = DashboardWidgetInspectorLabels.Default;

    [Parameter]
    public EventCallback<string?> GaugeStyleChanged { get; set; }

    [Parameter]
    public EventCallback<DashboardInspectorPropertyValueChange> GaugePropertyChanged { get; set; }

    [Parameter]
    public EventCallback<string?> ChartTypeChanged { get; set; }

    [Parameter]
    public EventCallback<bool> ExcludeSystemTopicsChanged { get; set; }

    private static string ChoiceClass(string? currentValue, string value)
        => string.Equals(currentValue ?? string.Empty, value, StringComparison.Ordinal)
            ? "property-grid-choice selected"
            : "property-grid-choice";

    private Task ChangeGaugePropertyAsync(string key, string? value)
        => GaugePropertyChanged.InvokeAsync(new DashboardInspectorPropertyValueChange(key, value));
}

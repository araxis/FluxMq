@implements IDisposable
@inject ProjectManagerService Projects

<div class="apps-panel" aria-label="@AppsPanelLabel">
    <div class="apps-panel-head">
        <div class="apps-panel-title">
            <span class="apps-panel-title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" aria-hidden="true" />
            </span>
            <div class="apps-panel-title-copy">
                <strong>Open Apps</strong>
                <span>@ProjectCountLabel</span>
            </div>
        </div>
    </div>

    @if (Projects.Projects.Count == 0)
    {
        <div class="apps-empty" role="status" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Small" aria-hidden="true" />
            <div>
                <div class="apps-empty-title">No apps open</div>
                <div class="apps-empty-copy">Use New or Open from the toolbar.</div>
            </div>
        </div>
    }
    else
    {
        <div class="apps-list" role="list">
            @foreach (var app in Projects.Projects)
            {
                var a = app;
                var isActive = a == Projects.ActiveProject;

                <div class="@AppTileClass(isActive)" role="listitem" @key="a">
                    <div class="app-tile-main"
                         role="button"
                         tabindex="0"
                         aria-label="@AppTileLabel(a, isActive)"
                         aria-current="@AppTileCurrent(isActive)"
                         aria-keyshortcuts="Enter Space"
                         title="@AppTileLabel(a, isActive)"
                         @onclick="@(() => Projects.SetActive(a))"
                         @onkeydown="@((KeyboardEventArgs args) => SelectAppFromKeyboard(args, a))">
                        <span class="app-tile-icon" aria-hidden="true">
                            <MudIcon Icon="@(isActive ? Icons.Material.Filled.FolderOpen : Icons.Material.Filled.Article)"
                                     Size="Size.Small"
                                     aria-hidden="true" />
                        </span>
                        <span class="app-tile-copy">
                            <span class="app-tile-name">@a.Name</span>
                            <span class="app-tile-path">@FileLabel(a)</span>
                            <span class="app-tile-meta">@BuildAppMeta(a)</span>
                        </span>
                        <span class="app-tile-markers">
                            @if (isActive)
                            {
                                <span class="app-marker active">@CurrentArtifactLabel(a)</span>
                            }
                            @if (a.HasUnsavedChanges)
                            {
                                <span class="app-marker unsaved">Unsaved</span>
                            }
                        </span>
                    </div>
                    <span class="app-tile-close" @onclick:stopPropagation="true" @onmousedown:stopPropagation="true">
                        <MudTooltip Text="Close app">
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Close"
                                           Class="app-close-button"
                                           aria-label="@CloseLabel(a)"
                                           OnClick="@(() => CloseAsync(a))" />
                        </MudTooltip>
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Projects.Changed += OnChanged;

    private string ProjectCountLabel => Projects.Projects.Count == 1
        ? "1 app"
        : $"{Projects.Projects.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)} apps";

    private string AppsPanelLabel => $"Open apps, {ProjectCountLabel}";

    private Task CloseAsync(FlowWorkspaceService app) => Projects.CloseProjectAsync(app).AsTask();

    private void SelectAppFromKeyboard(KeyboardEventArgs args, FlowWorkspaceService app)
    {
        if (IsActivationKey(args))
        {
            Projects.SetActive(app);
        }
    }

    private static bool IsActivationKey(KeyboardEventArgs args)
        => args.Key is "Enter" or " " or "Spacebar";

    private static string AppTileClass(bool isActive)
        => isActive ? "app-tile active" : "app-tile";

    private static string? AppTileCurrent(bool isActive)
        => isActive ? "true" : null;

    private static string FileLabel(FlowWorkspaceService app)
        => string.IsNullOrWhiteSpace(app.CurrentFilePath)
            ? "In memory - not saved"
            : app.CurrentFilePath;

    private static string BuildAppMeta(FlowWorkspaceService app)
    {
        var parts = new[]
        {
            CountLabel(app.WorkflowNames.Count, "pipeline"),
            CountLabel(app.MetricNames.Count, "metric"),
            CountLabel(app.DashboardNames.Count, "dashboard"),
            CountLabel(app.TestNames.Count, "test")
        };

        return string.Join(" / ", parts);
    }

    private static string CountLabel(int count, string singular)
        => count == 1 ? $"1 {singular}" : $"{count} {singular}s";

    private static string CurrentArtifactLabel(FlowWorkspaceService app)
        => app.ActiveArtifactKind switch
        {
            WorkspaceArtifactKind.Dashboard => "Dashboard",
            WorkspaceArtifactKind.Metrics => "Metrics",
            WorkspaceArtifactKind.Test => "Test",
            WorkspaceArtifactKind.Topics => "Topics",
            WorkspaceArtifactKind.Logs => "Logs",
            _ => "Pipeline"
        };

    private static string CloseLabel(FlowWorkspaceService app)
        => $"Close {app.Name}";

    private static string AppTileLabel(FlowWorkspaceService app, bool isActive)
    {
        var state = isActive ? "active" : "inactive";
        var saved = app.HasUnsavedChanges ? "unsaved changes" : "saved";
        return $"{app.Name}, {state}, {saved}, {CurrentArtifactLabel(app)}, {BuildAppMeta(app)}, {FileLabel(app)}";
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Projects.Changed -= OnChanged;
}

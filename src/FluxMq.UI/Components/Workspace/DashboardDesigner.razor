@using FluxMq.App.Definitions
@using System.Globalization
@implements IDisposable
@inject IDialogService DialogService
@inject DragStateService DragState
@inject DashboardWidgetRegistry DashboardWidgets

<div class="dashboard-designer">
    <div class="dashboard-toolbar">
        <div class="dashboard-heading">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Class="dashboard-heading-icon" />
            <div>
                <div class="dashboard-title">@Project.ActiveDashboardName</div>
                <div class="dashboard-meta">@LayoutMeta</div>
            </div>
        </div>

        <MudToggleGroup T="string" @bind-Value="DashboardMode" Size="Size.Small" Outlined="true" Color="Color.Primary" Class="dashboard-mode-toggle">
            <MudToggleItem Value="@DashboardModeEdit" UnselectedIcon="@Icons.Material.Filled.Edit" SelectedIcon="@Icons.Material.Filled.Edit">Edit</MudToggleItem>
            <MudToggleItem Value="@DashboardModeLive" UnselectedIcon="@Icons.Material.Filled.Visibility" SelectedIcon="@Icons.Material.Filled.Visibility">Live</MudToggleItem>
        </MudToggleGroup>

        @if (IsEditMode)
        {
            <div class="dashboard-command-strip">
            <div class="dashboard-grid-picker">
                <MudTooltip Text="Set grid layout">
                    <MudIconButton Icon="@Icons.Material.Filled.GridOn"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@ToggleGridPicker" />
                </MudTooltip>
                <span>@GridPickerSummary</span>

                @if (_isGridPickerOpen)
                {
                    <button type="button" class="dashboard-picker-backdrop" @onclick="@CloseGridPicker"></button>
                    <div class="dashboard-grid-picker-popover">
                        <div class="dashboard-grid-picker-cells">
                            @foreach (var row in PickerRows)
                            {
                                @foreach (var column in PickerColumns)
                                {
                                    var r = row;
                                    var c = column;
                                    <button type="button"
                                            class="@GridPickerCellClass(r, c)"
                                            title="@($"Set grid to {c} columns x {r} rows")"
                                            @onmouseenter="@(() => PreviewGrid(r, c))"
                                            @onclick="@(() => PickGrid(r, c))">
                                    </button>
                                }
                            }
                        </div>
                        <div class="dashboard-picker-label">@GridPickerLabel</div>
                    </div>
                }
            </div>

            <span class="dashboard-toolbar-separator"></span>

            <MudTooltip Text="Merge selected cells">
                <MudIconButton Icon="@Icons.Material.Filled.ViewColumn"
                               Size="Size.Small"
                               Disabled="@(!CanMerge)"
                               OnClick="@MergeSelected" />
            </MudTooltip>
            <div class="dashboard-grid-picker">
                <MudTooltip Text="Split selected cell">
                    <MudIconButton Icon="@Icons.Material.Filled.Splitscreen"
                                   Size="Size.Small"
                                   Disabled="@(!CanOpenSplitPicker)"
                                   OnClick="@ToggleSplitPicker" />
                </MudTooltip>
                <span>@SplitPickerSummary</span>

                @if (_isSplitPickerOpen)
                {
                    <button type="button" class="dashboard-picker-backdrop" @onclick="@CloseSplitPicker"></button>
                    <div class="dashboard-grid-picker-popover">
                        <div class="dashboard-grid-picker-cells split-picker-cells">
                            @foreach (var row in SplitPickerRows)
                            {
                                @foreach (var column in SplitPickerColumns)
                                {
                                    var r = row;
                                    var c = column;
                                    <button type="button"
                                            class="@SplitPickerCellClass(r, c)"
                                            title="@($"Split selected cell to {c} columns x {r} rows")"
                                            @onmouseenter="@(() => PreviewSplit(r, c))"
                                            @onclick="@(() => PickSplit(r, c))">
                                    </button>
                                }
                            }
                        </div>
                        <div class="dashboard-picker-label">@SplitPickerLabel</div>
                    </div>
                }
            </div>

            <span class="dashboard-toolbar-separator"></span>
            <span class="dashboard-selection-summary">@SelectionSummary</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="dashboard-error">@_error</MudAlert>
    }

    @if (_layout is null)
    {
        <div class="dashboard-empty">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="dashboard-empty-icon" />
            <span>No dashboard selected</span>
        </div>
    }
    else
    {
        @if (IsEditMode)
        {
            <div class="dashboard-editor-workbench">
                <div class="dashboard-grid-frame"
                     @onpointerenter="HandleDesignerPointerEnter"
                     @onpointermove="HandleDesignerPointerMove"
                     @onpointerleave="HandleDesignerPointerLeave">
                <div class="dashboard-grid-stage">
                <div class="dashboard-column-handles" style="@ColumnHandleStyle">
                    @for (var column = 0; column < _layout.Columns.Count; column++)
                    {
                        var c = column;
                        <button type="button"
                                class="dashboard-track-handle"
                                title="@($"Edit column {c + 1}")"
                                @onclick="() => OpenTrackEditorAsync(ColumnAxis, c)">
                            <span>C@(c + 1)</span>
                            <small>@_layout.Columns[c]</small>
                            @if (GetTrackPadding(ColumnAxis, c) > 0)
                            {
                                <small class="dashboard-track-padding">pad @FormatNumber(GetTrackPadding(ColumnAxis, c))</small>
                            }
                        </button>
                    }
                </div>
                <div class="dashboard-row-handles" style="@RowHandleStyle">
                    @for (var row = 0; row < _layout.Rows.Count; row++)
                    {
                        var r = row;
                        <button type="button"
                                class="dashboard-track-handle"
                                title="@($"Edit row {r + 1}")"
                                @onclick="() => OpenTrackEditorAsync(RowAxis, r)">
                            <span>R@(r + 1)</span>
                            <small>@_layout.Rows[r]</small>
                            @if (GetTrackPadding(RowAxis, r) > 0)
                            {
                                <small class="dashboard-track-padding">pad @FormatNumber(GetTrackPadding(RowAxis, r))</small>
                            }
                        </button>
                    }
                </div>
                <div class="dashboard-grid" style="@GridStyle">
                    @foreach (var cell in VisibleCells)
                    {
                        var currentCell = cell;
                        <section class="@CellClass(currentCell)"
                                 style="@CellStyle(currentCell)"
                                 @onpointerenter="@((PointerEventArgs args) => TrackDropCell(currentCell, args))"
                                 @onpointermove="@((PointerEventArgs args) => TrackDropCell(currentCell, args))"
                                 @onpointerleave="@((PointerEventArgs args) => ClearDropCell(currentCell, args))"
                                 @ondragenter="@(() => TrackWidgetMoveCell(currentCell))"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => DropWidgetOnCell(currentCell))"
                                 @ondragleave="@(() => ClearWidgetMoveCell(currentCell))"
                                 @onclick="@((MouseEventArgs args) => SelectCell(currentCell, args))"
                                 @key="currentCell.Name">
                            <div class="@CellContentClass(currentCell)">
                                @if (!string.IsNullOrWhiteSpace(currentCell.Widget))
                                {
                                    var widget = FindWidget(currentCell.Widget);
                                    if (widget is not null)
                                    {
                                        var previewSample = PreviewSample(widget.Name);
                                        <div class="dashboard-cell-widget-preview"
                                             draggable="true"
                                             title="Drag to move widget"
                                             @ondragstart="@(() => BeginWidgetMove(currentCell.Widget, currentCell.Name))"
                                             @ondragend="@EndWidgetMove">
                                            <DashboardWidgetView Project="@Project"
                                                                 Widget="@widget"
                                                                 Mode="DashboardWidgetRenderMode.EditCell"
                                                                 SnapshotOverride="@previewSample?.Snapshot"
                                                                 TopicMessagesOverride="@previewSample?.TopicMessages" />
                                        </div>
                                        <div class="dashboard-cell-widget-toolbar"
                                             @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="dashboard-cell-widget-action simulate"
                                                    title="Simulate widget data"
                                                    @onclick="@(() => SimulateWidgetPreview(currentCell.Widget))">
                                                <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                                            </button>
                                            <button type="button"
                                                    class="dashboard-cell-widget-action danger"
                                                    title="Delete widget"
                                                    @onclick="@(() => RemoveWidget(currentCell.Widget))">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        @RenderEmptyCellContent(currentCell)
                                    }
                                }
                                else
                                {
                                    @RenderEmptyCellContent(currentCell)
                                }
                            </div>
                        </section>
                    }
                </div>
                </div>
                </div>
                <DashboardInspector Project="@Project"
                                    Layout="@_layout"
                                    SelectedCells="@SelectedCells"
                                    Widget="@SelectedWidget"
                                    CollapsedPropertyGroups="@_inspectorCollapsedPropertyGroups"
                                    CollapsedPropertyGroupsChanged="@RememberInspectorCollapsedPropertyGroups"
                                    Changed="@OnInspectorChanged" />
            </div>
        }
        else
        {
            <div class="dashboard-live-frame">
                <div class="dashboard-live-grid" style="@GridStyle">
                    @foreach (var cell in VisibleCells)
                    {
                        var currentCell = cell;
                        <section class="@LiveCellClass(currentCell)"
                                 style="@CellStyle(currentCell)"
                                 @key="currentCell.Name">
                            @if (!string.IsNullOrWhiteSpace(currentCell.Widget))
                            {
                                var widget = FindWidget(currentCell.Widget);
                                if (widget is not null)
                                {
                                    <DashboardWidgetView Project="@Project" Widget="@widget" Mode="DashboardWidgetRenderMode.Live" />
                                }
                                else
                                {
                                    <div class="dashboard-live-widget">
                                        <MudIcon Icon="@Icons.Material.Filled.Widgets" Size="Size.Small" />
                                        <span>@currentCell.Widget</span>
                                    </div>
                                }
                            }
                        </section>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private const string ColumnAxis = "column";
    private const string RowAxis = "row";
    private const string DashboardModeEdit = "edit";
    private const string DashboardModeLive = "live";
    private const string StylePropertyGroupId = "style";

    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = default!;

    [Parameter]
    public EventCallback<bool> EditModeChanged { get; set; }

    private readonly HashSet<string> _selectedCellIds = new(StringComparer.Ordinal);
    private DashboardLayoutSnapshot? _layout;
    private string? _dashboardName;
    private string? _error;
    private bool _isGridPickerOpen;
    private bool _isSplitPickerOpen;
    private int _previewRows = 1;
    private int _previewColumns = 1;
    private int _previewSplitRows = 2;
    private int _previewSplitColumns = 2;
    private string _dashboardMode = DashboardModeEdit;
    private string? _hoveredDropCellName;
    private string? _movingWidgetName;
    private string? _movingWidgetSourceCellName;
    private string? _hoveredWidgetMoveCellName;
    private readonly HashSet<string> _inspectorCollapsedPropertyGroups = new(StringComparer.Ordinal)
    {
        StylePropertyGroupId
    };
    private readonly Dictionary<string, DashboardPreviewSample> _previewSamples = new(StringComparer.Ordinal);
    private bool? _lastNotifiedEditMode;
    private long _definitionRevision = -1;
    private FlowWorkspaceService? _subscribedProject;
    private bool _isDisposed;

    protected override void OnInitialized()
    {
        DragState.Changed += OnDragStateChanged;
        DragState.ComponentDropRequested += OnComponentDropRequested;
    }

    protected override void OnParametersSet()
    {
        SyncProjectSubscription();

        if (_definitionRevision != Project.DefinitionRevision ||
            !string.Equals(_dashboardName, Project.ActiveDashboardName, StringComparison.Ordinal))
        {
            LoadLayout();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lastNotifiedEditMode != IsEditMode)
        {
            _lastNotifiedEditMode = IsEditMode;
            await EditModeChanged.InvokeAsync(IsEditMode);
        }
    }

    private static IEnumerable<int> PickerRows => Enumerable.Range(1, 12);

    private static IEnumerable<int> PickerColumns => Enumerable.Range(1, 12);

    private static IEnumerable<int> SplitPickerRows => Enumerable.Range(1, 6);

    private static IEnumerable<int> SplitPickerColumns => Enumerable.Range(1, 6);

    private IReadOnlyList<DashboardCellSnapshot> VisibleCells
        => _layout is null ? [] : BuildVisibleCells(_layout);

    private IReadOnlyList<DashboardCellSnapshot> SelectedCells
        => VisibleCells.Where(cell => _selectedCellIds.Contains(cell.Name)).ToArray();

    private DashboardWidgetSnapshot? SelectedWidget
        => SelectedCells.Count == 1 ? FindWidget(SelectedCells[0].Widget) : null;

    private bool CanMerge => IsRectangularSelection(SelectedCells);

    private bool CanOpenSplitPicker => SelectedCells.Count == 1;

    private bool IsEditMode => string.Equals(_dashboardMode, DashboardModeEdit, StringComparison.Ordinal);

    private string DashboardMode
    {
        get => _dashboardMode;
        set
        {
            var next = string.Equals(value, DashboardModeLive, StringComparison.Ordinal)
                ? DashboardModeLive
                : DashboardModeEdit;
            if (string.Equals(_dashboardMode, next, StringComparison.Ordinal))
            {
                return;
            }

            _dashboardMode = next;
            _isGridPickerOpen = false;
            _isSplitPickerOpen = false;
            _selectedCellIds.Clear();
            _hoveredDropCellName = null;
            ClearWidgetMove();
        }
    }

    private string LayoutMeta => _layout is null
        ? "Dashboard"
        : $"{_layout.Columns.Count} columns / {_layout.Rows.Count} rows / {_layout.Cells.Count} cells / {_layout.WidgetCount} widgets";

    private string SelectionSummary => SelectedCells.Count switch
    {
        0 => "No cell selected",
        1 => SelectedCells[0].IsMerged ? $"Selected {SelectedCells[0].ColumnSpan} x {SelectedCells[0].RowSpan} cell" : $"Selected {SelectedCells[0].Label}",
        _ => $"{SelectedCells.Count} cells selected"
    };

    private string GridPickerSummary => _layout is null
        ? "Grid"
        : $"{_layout.Columns.Count} columns x {_layout.Rows.Count} rows";

    private string GridPickerLabel => $"{_previewColumns} columns x {_previewRows} rows";

    private string SplitPickerSummary => SelectedCells.Count == 1
        ? "Split"
        : "Select one cell";

    private string SplitPickerLabel => $"{_previewSplitColumns} columns x {_previewSplitRows} rows";

    private string GridStyle => _layout is null
        ? string.Empty
        : $"grid-template-columns:{CssTemplate(_layout.Columns, ColumnAxis)};grid-template-rows:{CssTemplate(_layout.Rows, RowAxis)};";

    private string ColumnHandleStyle => _layout is null
        ? string.Empty
        : $"grid-template-columns:{CssTemplate(_layout.Columns, ColumnAxis)};";

    private string RowHandleStyle => _layout is null
        ? string.Empty
        : $"grid-template-rows:{CssTemplate(_layout.Rows, RowAxis)};";

    private void LoadLayout()
    {
        var dashboardChanged = !string.Equals(_dashboardName, Project.ActiveDashboardName, StringComparison.Ordinal);
        _dashboardName = Project.ActiveDashboardName;
        _definitionRevision = Project.DefinitionRevision;
        _layout = Project.GetActiveDashboardLayout();
        _previewRows = _layout?.Rows.Count ?? 1;
        _previewColumns = _layout?.Columns.Count ?? 1;
        _previewSplitRows = 2;
        _previewSplitColumns = 2;
        _error = null;
        if (dashboardChanged)
        {
            DashboardMode = DashboardModeEdit;
            _selectedCellIds.Clear();
            SyncSelectionFromProject();
            if (_selectedCellIds.Count == 0)
            {
                Project.SetActiveDashboardCell(null);
            }
        }

        TrimSelection();
        TrimPreviewSamples();
    }

    private void SyncSelectionFromProject()
    {
        if (string.IsNullOrWhiteSpace(Project.ActiveDashboardCellName) ||
            !VisibleCells.Any(cell => string.Equals(cell.Name, Project.ActiveDashboardCellName, StringComparison.Ordinal)))
        {
            return;
        }

        _selectedCellIds.Clear();
        _selectedCellIds.Add(Project.ActiveDashboardCellName);
    }

    private async Task OpenTrackEditorAsync(string axis, int index)
    {
        if (_layout is null)
        {
            return;
        }

        var isRow = string.Equals(axis, RowAxis, StringComparison.Ordinal);
        var size = isRow ? _layout.Rows[index] : _layout.Columns[index];
        var padding = GetTrackPadding(axis, index);
        var dialog = await DialogService.ShowAsync<DashboardTrackEditorDialog>(
            $"Edit {axis} {index + 1}",
            new DialogParameters
            {
                [nameof(DashboardTrackEditorDialog.Axis)] = axis,
                [nameof(DashboardTrackEditorDialog.Index)] = index,
                [nameof(DashboardTrackEditorDialog.Size)] = size,
                [nameof(DashboardTrackEditorDialog.Padding)] = padding
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: DashboardTrackEditorDialog.DashboardTrackUpdate update })
        {
            Project.UpdateDashboardTrack(axis, index, update.Size, update.Padding);
            CaptureDashboardError();
            RefreshLayoutAfterCommand();
        }
    }

    private async Task OpenWidgetEditorAsync(string? widgetName)
    {
        var widget = FindWidget(widgetName);
        if (widget is null)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<DashboardWidgetEditorDialog>(
            $"Edit {WidgetLabel(widgetName)}",
            new DialogParameters
            {
                [nameof(DashboardWidgetEditorDialog.Widget)] = widget
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: DashboardWidgetEditorDialog.DashboardWidgetUpdate update })
        {
            Project.UpdateDashboardWidget(widget.Name, update.Configuration);
            CaptureDashboardError();
            RefreshLayoutAfterCommand();
        }
    }

    private void RemoveWidget(string? widgetName)
    {
        if (string.IsNullOrWhiteSpace(widgetName))
        {
            return;
        }

        Project.RemoveDashboardWidget(widgetName);
        _previewSamples.Remove(widgetName);
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
    }

    private void MergeSelected()
    {
        Project.MergeDashboardCells(SelectedCells);
        _selectedCellIds.Clear();
        _isSplitPickerOpen = false;
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
    }

    private void SelectCell(DashboardCellSnapshot cell, MouseEventArgs args)
    {
        var extendSelection = args.CtrlKey || args.ShiftKey || args.MetaKey;
        if (!extendSelection)
        {
            _selectedCellIds.Clear();
        }

        if (!_selectedCellIds.Add(cell.Name) && extendSelection)
        {
            _selectedCellIds.Remove(cell.Name);
        }

        Project.SetActiveDashboardCell(_selectedCellIds.Count == 1 ? _selectedCellIds.Single() : null);
    }

    private void HandleDesignerPointerEnter(PointerEventArgs args)
    {
        if (IsDashboardComponentDrag)
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerMove(PointerEventArgs args)
    {
        if (IsDashboardComponentDrag)
        {
            DragState.SetComponentDragOverDesigner(args.PointerId, true);
        }
    }

    private void HandleDesignerPointerLeave(PointerEventArgs args)
    {
        if (IsDashboardComponentDrag)
        {
            _hoveredDropCellName = null;
            DragState.SetComponentDragOverDesigner(args.PointerId, false);
        }
    }

    private void TrackDropCell(DashboardCellSnapshot cell, PointerEventArgs args)
    {
        if (!IsDashboardComponentDrag)
        {
            return;
        }

        _hoveredDropCellName = cell.Name;
        DragState.SetComponentDragOverDesigner(args.PointerId, true);
    }

    private void ClearDropCell(DashboardCellSnapshot cell, PointerEventArgs args)
    {
        if (IsDashboardComponentDrag && string.Equals(_hoveredDropCellName, cell.Name, StringComparison.Ordinal))
        {
            _hoveredDropCellName = null;
        }
    }

    private void BeginWidgetMove(string? widgetName, string sourceCellName)
    {
        if (string.IsNullOrWhiteSpace(widgetName))
        {
            return;
        }

        _movingWidgetName = widgetName;
        _movingWidgetSourceCellName = sourceCellName;
        _hoveredWidgetMoveCellName = sourceCellName;
    }

    private void TrackWidgetMoveCell(DashboardCellSnapshot cell)
    {
        if (!IsDashboardMoveDrag)
        {
            return;
        }

        _hoveredWidgetMoveCellName = cell.Name;
    }

    private void ClearWidgetMoveCell(DashboardCellSnapshot cell)
    {
        if (IsDashboardMoveDrag && string.Equals(_hoveredWidgetMoveCellName, cell.Name, StringComparison.Ordinal))
        {
            _hoveredWidgetMoveCellName = null;
        }
    }

    private void DropWidgetOnCell(DashboardCellSnapshot cell)
    {
        if (string.IsNullOrWhiteSpace(_movingWidgetName) ||
            string.Equals(_movingWidgetSourceCellName, cell.Name, StringComparison.Ordinal))
        {
            ClearWidgetMove();
            return;
        }

        Project.MoveDashboardWidget(_movingWidgetName, cell.Name);
        ClearWidgetMove();
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
    }

    private void EndWidgetMove()
    {
        ClearWidgetMove();
    }

    private void ClearWidgetMove()
    {
        _movingWidgetName = null;
        _movingWidgetSourceCellName = null;
        _hoveredWidgetMoveCellName = null;
    }

    private void OnComponentDropRequested(object? sender, ComponentDropRequestedEventArgs args)
    {
        if (args.TargetKind != WorkspaceArtifactKind.Dashboard)
        {
            return;
        }

        InvokeAsync(() =>
        {
            if (_isDisposed)
            {
                return;
            }

            Project.AddDashboardWidget(args.ComponentType, _hoveredDropCellName);
            _hoveredDropCellName = null;
            CaptureDashboardError();
            RefreshLayoutAfterCommand();
        });
    }

    private void OnDragStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_isDisposed)
            {
                return;
            }

            if (_definitionRevision != Project.DefinitionRevision ||
                !string.Equals(_dashboardName, Project.ActiveDashboardName, StringComparison.Ordinal))
            {
                LoadLayout();
            }

            StateHasChanged();
        });
    }

    private void SyncProjectSubscription()
    {
        if (ReferenceEquals(_subscribedProject, Project))
        {
            return;
        }

        if (_subscribedProject is not null)
        {
            _subscribedProject.Changed -= OnProjectChanged;
        }

        _subscribedProject = Project;
        _subscribedProject.Changed += OnProjectChanged;
    }

    private void ToggleGridPicker()
    {
        if (!_isGridPickerOpen && _layout is not null)
        {
            _previewRows = _layout.Rows.Count;
            _previewColumns = _layout.Columns.Count;
        }

        _isSplitPickerOpen = false;
        _isGridPickerOpen = !_isGridPickerOpen;
    }

    private void CloseGridPicker()
    {
        _isGridPickerOpen = false;
    }

    private void ToggleSplitPicker()
    {
        var selected = SelectedCells.SingleOrDefault();
        if (selected is null)
        {
            return;
        }

        if (!_isSplitPickerOpen)
        {
            _previewSplitRows = Math.Min(6, Math.Max(2, selected.RowSpan));
            _previewSplitColumns = Math.Min(6, Math.Max(2, selected.ColumnSpan));
        }

        _isGridPickerOpen = false;
        _isSplitPickerOpen = !_isSplitPickerOpen;
    }

    private void CloseSplitPicker()
    {
        _isSplitPickerOpen = false;
    }

    private Task RememberInspectorCollapsedPropertyGroups(IReadOnlySet<string> collapsedGroups)
    {
        _inspectorCollapsedPropertyGroups.Clear();
        foreach (var group in collapsedGroups)
        {
            _inspectorCollapsedPropertyGroups.Add(group);
        }

        return Task.CompletedTask;
    }

    private void PreviewGrid(int rows, int columns)
    {
        _previewRows = rows;
        _previewColumns = columns;
    }

    private void PreviewSplit(int rows, int columns)
    {
        _previewSplitRows = rows;
        _previewSplitColumns = columns;
    }

    private void PickGrid(int rows, int columns)
    {
        CloseGridPicker();
        Project.ResizeDashboardGrid(rows, columns);
        _selectedCellIds.Clear();
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
    }

    private void PickSplit(int rows, int columns)
    {
        if (rows == 1 && columns == 1)
        {
            return;
        }

        var cell = SelectedCells.SingleOrDefault();
        if (cell is null || !CanSubdivide(rows, columns))
        {
            return;
        }

        CloseSplitPicker();
        Project.SubdivideDashboardCell(cell, rows, columns);
        _selectedCellIds.Clear();
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
    }

    private void RefreshLayoutAfterCommand()
    {
        _definitionRevision = Project.DefinitionRevision;
        _layout = Project.GetActiveDashboardLayout();
        _previewRows = _layout?.Rows.Count ?? _previewRows;
        _previewColumns = _layout?.Columns.Count ?? _previewColumns;
        TrimSelection();
        TrimPreviewSamples();
    }

    private Task OnInspectorChanged()
    {
        CaptureDashboardError();
        RefreshLayoutAfterCommand();
        return Task.CompletedTask;
    }

    private void TrimSelection()
    {
        var knownIds = VisibleCells.Select(static cell => cell.Name).ToHashSet(StringComparer.Ordinal);
        _selectedCellIds.RemoveWhere(id => !knownIds.Contains(id));
        Project.SetActiveDashboardCell(_selectedCellIds.Count == 1 ? _selectedCellIds.Single() : null);
    }

    private void CaptureDashboardError()
    {
        _error = Project.Diagnostics
            .FirstOrDefault(diagnostic => diagnostic.Code.StartsWith("Dashboard", StringComparison.Ordinal))
            ?.Message;
    }

    private bool CanSubdivide(int rowParts, int columnParts)
    {
        if (_layout is null || SelectedCells.Count != 1 || rowParts <= 0 || columnParts <= 0)
        {
            return false;
        }

        var selected = SelectedCells[0];
        var rowInsertCount = Math.Max(0, rowParts - selected.RowSpan);
        var columnInsertCount = Math.Max(0, columnParts - selected.ColumnSpan);

        return (rowParts > 1 || columnParts > 1)
            && _layout.Rows.Count + rowInsertCount <= 12
            && _layout.Columns.Count + columnInsertCount <= 12;
    }

    private string GridPickerCellClass(int rows, int columns)
        => $"dashboard-grid-picker-cell {(rows <= _previewRows && columns <= _previewColumns ? "active" : null)} {(_layout is not null && rows == _layout.Rows.Count && columns == _layout.Columns.Count ? "current" : null)}";

    private string SplitPickerCellClass(int rows, int columns)
        => $"dashboard-grid-picker-cell {(rows <= _previewSplitRows && columns <= _previewSplitColumns ? "active" : null)} {(rows == 1 && columns == 1 || !CanSubdivide(rows, columns) ? "disabled" : null)}";

    private bool IsDashboardComponentDrag
        => DragState.ActiveComponentDrag is { TargetKind: WorkspaceArtifactKind.Dashboard };

    private bool IsDashboardMoveDrag
        => !string.IsNullOrWhiteSpace(_movingWidgetName);

    private string CellClass(DashboardCellSnapshot cell)
        => $"dashboard-cell {(cell.IsExplicit ? "explicit" : "virtual")} {(cell.IsMerged ? "merged" : null)} {(_selectedCellIds.Contains(cell.Name) ? "selected" : null)} {(IsDashboardComponentDrag && string.Equals(_hoveredDropCellName, cell.Name, StringComparison.Ordinal) ? "dropping" : null)} {(IsDashboardMoveDrag && string.Equals(_hoveredWidgetMoveCellName, cell.Name, StringComparison.Ordinal) ? "dropping" : null)} {(IsDashboardMoveDrag && string.Equals(_movingWidgetSourceCellName, cell.Name, StringComparison.Ordinal) ? "moving-source" : null)}";

    private static string LiveCellClass(DashboardCellSnapshot cell)
        => $"dashboard-live-cell {(cell.IsMerged ? "merged" : null)} {(!string.IsNullOrWhiteSpace(cell.Widget) ? "has-widget" : "empty")}";

    private string CellStyle(DashboardCellSnapshot cell)
    {
        var rowPadding = GetCellRowPadding(cell);
        var columnPadding = GetCellColumnPadding(cell);
        return $"grid-row:{cell.Row + 1} / span {cell.RowSpan};grid-column:{cell.Column + 1} / span {cell.ColumnSpan};margin:{FormatNumber(rowPadding)}px {FormatNumber(columnPadding)}px;{CellResponsiveVariables(cell, rowPadding, columnPadding)}{DashboardCellStyleDraft.CssVariables(cell.Style)}";
    }

    private double GetCellRowPadding(DashboardCellSnapshot cell)
        => Enumerable.Range(cell.Row, cell.RowSpan).Select(index => GetTrackPadding(RowAxis, index)).DefaultIfEmpty(0).Max();

    private double GetCellColumnPadding(DashboardCellSnapshot cell)
        => Enumerable.Range(cell.Column, cell.ColumnSpan).Select(index => GetTrackPadding(ColumnAxis, index)).DefaultIfEmpty(0).Max();

    private double GetTrackPadding(string axis, int index)
    {
        if (_layout is null)
        {
            return 0;
        }

        var values = string.Equals(axis, RowAxis, StringComparison.Ordinal)
            ? _layout.RowPadding
            : _layout.ColumnPadding;
        return index >= 0 && index < values.Count ? values[index] : 0;
    }

    private static string CellTitle(DashboardCellSnapshot cell)
        => $"{cell.Column + 1},{cell.Row + 1}";

    private static string CellSpan(DashboardCellSnapshot cell)
        => $"{cell.ColumnSpan} x {cell.RowSpan}";

    private string CellContentClass(DashboardCellSnapshot cell)
        => !string.IsNullOrWhiteSpace(cell.Widget) && FindWidget(cell.Widget) is not null
            ? "dashboard-cell-content has-widget-preview"
            : "dashboard-cell-content";

    private static RenderFragment RenderEmptyCellContent(DashboardCellSnapshot cell) => @<text>
        <div class="dashboard-cell-placeholder" title="@($"{CellTitle(cell)} {CellSpan(cell)}")">
            <span class="dashboard-cell-name">@CellTitle(cell)</span>
            @if (cell.IsMerged)
            {
                <span class="dashboard-cell-span">@CellSpan(cell)</span>
            }
        </div>
    </text>;

    private DashboardWidgetSnapshot? FindWidget(string? widgetName)
        => !string.IsNullOrWhiteSpace(widgetName) &&
           _layout?.Widgets.TryGetValue(widgetName, out var widget) == true
            ? widget
            : null;

    private DashboardPreviewSample? PreviewSample(string widgetName)
        => _previewSamples.TryGetValue(widgetName, out var sample)
            ? sample
            : null;

    private void SimulateWidgetPreview(string? widgetName)
    {
        var widget = FindWidget(widgetName);
        if (widget is null)
        {
            return;
        }

        _previewSamples[widget.Name] = DashboardPreviewSampleFactory.Create(widget);
    }

    private void TrimPreviewSamples()
    {
        if (_layout is null)
        {
            _previewSamples.Clear();
            return;
        }

        var widgetNames = _layout.Widgets.Keys.ToHashSet(StringComparer.Ordinal);
        foreach (var widgetName in _previewSamples.Keys.Where(widgetName => !widgetNames.Contains(widgetName)).ToArray())
        {
            _previewSamples.Remove(widgetName);
        }
    }

    private string WidgetLabel(string? widgetName)
    {
        var widget = FindWidget(widgetName);
        if (widget is null)
        {
            return string.IsNullOrWhiteSpace(widgetName) ? "Widget" : widgetName;
        }

        return widget.ReadString("title") ??
               DashboardWidgets.Find(widget.Type)?.DisplayName ??
               widget.Name;
    }

    private static string CssTemplate(IReadOnlyList<string> sizes, string axis)
        => string.Join(" ", sizes.Select(size => ToCssTrack(size, axis)));

    private static IReadOnlyList<DashboardCellSnapshot> BuildVisibleCells(DashboardLayoutSnapshot layout)
    {
        var visible = new List<DashboardCellSnapshot>(layout.Cells);
        for (var row = 0; row < layout.Rows.Count; row++)
        {
            for (var column = 0; column < layout.Columns.Count; column++)
            {
                if (!layout.Cells.Any(cell => Covers(cell, row, column)))
                {
                    visible.Add(DashboardCellSnapshot.Slot(row, column));
                }
            }
        }

        return visible
            .OrderBy(static cell => cell.Row)
            .ThenBy(static cell => cell.Column)
            .ThenByDescending(static cell => cell.IsExplicit)
            .ToArray();
    }

    private static bool Covers(DashboardCellSnapshot cell, int row, int column)
        => row >= cell.Row &&
           row < cell.Row + cell.RowSpan &&
           column >= cell.Column &&
           column < cell.Column + cell.ColumnSpan;

    private static bool IsRectangularSelection(IReadOnlyList<DashboardCellSnapshot> cells)
    {
        if (cells.Count < 2)
        {
            return false;
        }

        var coordinates = cells.SelectMany(static cell => cell.CoveredCoordinates()).ToArray();
        var unique = coordinates.ToHashSet();
        if (coordinates.Length != unique.Count)
        {
            return false;
        }

        var minRow = unique.Min(static coordinate => coordinate.Row);
        var maxRow = unique.Max(static coordinate => coordinate.Row);
        var minColumn = unique.Min(static coordinate => coordinate.Column);
        var maxColumn = unique.Max(static coordinate => coordinate.Column);

        return unique.Count == (maxRow - minRow + 1) * (maxColumn - minColumn + 1);
    }

    private static string CellResponsiveVariables(DashboardCellSnapshot cell, double rowPadding, double columnPadding)
    {
        var tabletSpan = Math.Clamp(cell.ColumnSpan, 1, 2);
        var mobileSpan = 1;
        var minHeight = Math.Clamp(136 * Math.Max(1, cell.RowSpan), 136, 420);
        return
            $"--dashboard-cell-column-span:{Math.Max(1, cell.ColumnSpan)};" +
            $"--dashboard-cell-row-span:{Math.Max(1, cell.RowSpan)};" +
            $"--dashboard-cell-tablet-span:{tabletSpan};" +
            $"--dashboard-cell-mobile-span:{mobileSpan};" +
            $"--dashboard-cell-row-padding:{FormatNumber(rowPadding)}px;" +
            $"--dashboard-cell-column-padding:{FormatNumber(columnPadding)}px;" +
            $"--dashboard-cell-responsive-min-height:{FormatNumber(minHeight)}px;";
    }

    private static string ToCssTrack(string size, string axis)
    {
        try
        {
            var track = DashboardGridTrackDefinition.Parse(size);
            var value = FormatNumber(track.Value);
            var minVariable = string.Equals(axis, RowAxis, StringComparison.Ordinal)
                ? "var(--dashboard-grid-row-min, 136px)"
                : "var(--dashboard-grid-column-min, 156px)";
            return track.Unit switch
            {
                DashboardGridTrackUnit.Fixed => $"minmax({minVariable},{value}px)",
                DashboardGridTrackUnit.Percent => $"minmax({minVariable},{value}%)",
                DashboardGridTrackUnit.Star => $"minmax({minVariable},{value}fr)",
                _ => "minmax(0,1fr)"
            };
        }
        catch
        {
            return "minmax(0,1fr)";
        }
    }

    private static string FormatNumber(double value)
        => value.ToString("0.###", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _isDisposed = true;
        DragState.Changed -= OnDragStateChanged;
        DragState.ComponentDropRequested -= OnComponentDropRequested;
        if (_subscribedProject is not null)
        {
            _subscribedProject.Changed -= OnProjectChanged;
            _subscribedProject = null;
        }
    }
}

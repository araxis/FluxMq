@using FluxMq.UI.Models
@using FluxMq.App.Metrics
@using FluxMq.UI.Services
@inject DashboardEventFilterCatalog EventFilters
@inject DashboardMetricRegistry MetricRegistry
@inject DashboardWidgetRegistry WidgetRegistry
@inject IDialogService DialogService

<aside class="dashboard-inspector">
    <header class="dashboard-inspector-header">
        <div class="dashboard-inspector-icon">
            <MudIcon Icon="@InspectorIcon" Size="Size.Small" />
        </div>
        <div class="dashboard-inspector-heading">
            <span class="dashboard-inspector-title">@InspectorTitle</span>
            <span class="dashboard-inspector-subtitle">@InspectorSubtitle</span>
        </div>
        @if (Widget is not null)
        {
            <button type="button"
                    class="dashboard-inspector-command"
                    title="Reset widget properties"
                    aria-label="Reset widget properties"
                    @onclick="@ResetWidgetPropertiesAsync">
                <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" />
            </button>
        }
    </header>

    @if (PropertyGroups.Count > 0)
    {
        <PropertyGrid Groups="@PropertyGroups"
                      CollapsedGroupIds="@CollapsedPropertyGroups"
                      CollapsedGroupIdsChanged="@CollapsedPropertyGroupsChanged" />
    }
    else
    {
        <div class="dashboard-inspector-empty">
            @if (SelectedCells.Count == 0)
            {
                <MudIcon Icon="@Icons.Material.Filled.GridView" />
                <span>Select a cell or widget</span>
                <small>Use the grid to place widgets, merge cells, split cells, and inspect layout.</small>
            }
            else
            {
                @RenderCellSummary()
                <MudDivider />
                <small>Drop a widget here or choose one from the catalog.</small>
            }
        </div>
    }
</aside>

@code {
    private static readonly IReadOnlyList<DashboardFilterChoice> QosFilterOptions =
    [
        new("", "Any"),
        new("0", "0"),
        new("1", "1"),
        new("2", "2")
    ];

    private static readonly IReadOnlyList<DashboardFilterChoice> RetainFilterOptions =
    [
        new("", "Any"),
        new("true", "True"),
        new("false", "False")
    ];

    private static readonly IReadOnlyList<DashboardFilterChoice> WindowOptions =
    [
        new("30s", "30s"),
        new("60s", "1m"),
        new("300s", "5m"),
        new("900s", "15m")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> HorizontalAlignmentOptions =
    [
        new(DashboardWidgetCatalog.KpiAlignLeft, Icons.Material.Filled.FormatAlignLeft, "Left"),
        new(DashboardWidgetCatalog.KpiAlignCenter, Icons.Material.Filled.FormatAlignCenter, "Center"),
        new(DashboardWidgetCatalog.KpiAlignRight, Icons.Material.Filled.FormatAlignRight, "Right")
    ];

    private static readonly IReadOnlyList<PropertyGridIconSegmentOption> ValuePlacementOptions =
    [
        new(DashboardWidgetCatalog.KpiValuePlacementTop, Icons.Material.Filled.VerticalAlignTop, "Top"),
        new(DashboardWidgetCatalog.KpiValuePlacementMiddle, Icons.Material.Filled.VerticalAlignCenter, "Middle"),
        new(DashboardWidgetCatalog.KpiValuePlacementBottom, Icons.Material.Filled.VerticalAlignBottom, "Bottom")
    ];

    private const string DataGroupId = "data";
    private const string MetricQueryGroupId = "metric-query";
    private const string FilterGroupId = "filters";
    private const string DisplayGroupId = "display";
    private const string StyleGroupId = "style";
    private const string LayoutGroupId = "layout";

    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    [Parameter]
    public DashboardLayoutSnapshot? Layout { get; set; }

    [Parameter]
    public IReadOnlyList<DashboardCellSnapshot> SelectedCells { get; set; } = [];

    [Parameter]
    public DashboardWidgetSnapshot? Widget { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public IReadOnlySet<string>? CollapsedPropertyGroups { get; set; }

    [Parameter]
    public EventCallback<IReadOnlySet<string>> CollapsedPropertyGroupsChanged { get; set; }

    private DashboardWidgetSettingsDraft? _widgetDraft;
    private DashboardCellStyleDraft? _cellStyleDraft;
    private DashboardMetricEditorDraft? _metricDraft;
    private string? _draftWidgetName;
    private string? _draftCellName;
    private string? _draftMetricName;
    private string? _metricToAdd;
    private string? _displayMetricToAdd;
    private List<string> _bindingMetrics = [];
    private string? _primaryBindingMetric;

    private string InspectorIcon => Widget is null
        ? Icons.Material.Filled.GridView
        : DashboardWidgetFormatting.WidgetIcon(Widget);

    private string InspectorTitle => Widget is null
        ? SelectedCells.Count switch
        {
            0 => "Dashboard inspector",
            1 => $"Cell {SelectedCells[0].Label}",
            _ => $"{SelectedCells.Count} cells"
        }
        : DashboardWidgetFormatting.WidgetTitle(PreviewWidget);

    private string InspectorSubtitle => Widget is null
        ? Layout is null ? "No dashboard loaded" : $"{Layout.Columns.Count} columns / {Layout.Rows.Count} rows"
        : Widget.Type;

    private DashboardWidgetSnapshot PreviewWidget => Widget is null || _widgetDraft is null
        ? Widget ?? new DashboardWidgetSnapshot("preview", DashboardWidgetCatalog.EventCounterType, new Dictionary<string, string>())
        : Widget with { Configuration = _widgetDraft.BuildConfiguration() };

    protected override void OnParametersSet()
    {
        var selectedCell = SelectedCells.Count == 1 ? SelectedCells[0] : null;
        var selectedCellName = selectedCell?.Name;
        if (!string.Equals(_draftCellName, selectedCellName, StringComparison.Ordinal))
        {
            _draftCellName = selectedCellName;
            _cellStyleDraft = selectedCell is null
                ? null
                : DashboardCellStyleDraft.Create(selectedCell.Style);
        }

        if (Widget is null)
        {
            _widgetDraft = null;
            _metricDraft = null;
            _draftWidgetName = null;
            _draftMetricName = null;
            _metricToAdd = null;
            _displayMetricToAdd = null;
            _bindingMetrics = [];
            _primaryBindingMetric = null;
            return;
        }

        var binding = Layout?.Bindings.TryGetValue(Widget.Name, out var foundBinding) == true
            ? foundBinding
            : null;
        var metricName = binding?.PrimaryMetric ??
            Widget.ReadString("metric") ??
            binding?.Metrics.FirstOrDefault() ??
            $"{Widget.Name}Metric";

        if (string.Equals(_draftWidgetName, Widget.Name, StringComparison.Ordinal) &&
            string.Equals(_draftMetricName, metricName, StringComparison.Ordinal))
        {
            return;
        }

        _draftWidgetName = Widget.Name;
        _draftMetricName = metricName;
        _widgetDraft = DashboardWidgetSettingsDraft.Create(Widget, EventFilters);
        _metricToAdd = null;
        _displayMetricToAdd = null;

        if (!_widgetDraft.Profile.UsesMetricQuery)
        {
            _metricDraft = null;
            _bindingMetrics = [];
            _primaryBindingMetric = null;
            return;
        }

        _widgetDraft.MetricName = metricName;
        _primaryBindingMetric = metricName;
        _bindingMetrics = binding?.Metrics.Count > 0
            ? [.. binding.Metrics]
            : [metricName];
        if (!_widgetDraft.Profile.SupportsMetricSlots)
        {
            _bindingMetrics = [metricName];
        }
        else if (!_bindingMetrics.Contains(metricName, StringComparer.Ordinal))
        {
            _bindingMetrics.Insert(0, metricName);
        }

        var metric = Layout?.Metrics.TryGetValue(metricName, out var foundMetric) == true
            ? foundMetric
            : null;
        if (metric is null && _widgetDraft.UsesMetricQueryBuilder)
        {
            var legacyDefinition = FluxMetricQueryDraft
                .Create(
                    metric: null,
                    Widget.Configuration,
                    metricName)
                .BuildDefinition(metricName);
            metric = ToMetricSnapshot(
                metricName,
                DashboardMetricQueryMapper.ToDashboardQuery(legacyDefinition));
        }

        _metricDraft = DashboardMetricEditorDraft.Create(
            metricName,
            metric,
            EventFilters,
            MetricRegistry,
            Widget.Type);
    }

    private IReadOnlyList<PropertyGridGroup> PropertyGroups => BuildPropertyGroups();

    private IReadOnlyList<PropertyGridGroup> BuildPropertyGroups()
    {
        if (Widget is null || _widgetDraft is null)
        {
            var cellGroups = new List<PropertyGridGroup>();
            if (_cellStyleDraft is not null)
            {
                cellGroups.Add(new(StyleGroupId, "Cell style", StylePropertyCount, RenderStyleProperties(), StartCollapsed: true));
                cellGroups.Add(new(LayoutGroupId, "Layout", LayoutPropertyCount, RenderLayoutProperties()));
            }

            return cellGroups;
        }

        var groups = new List<PropertyGridGroup>();
        if (ShowsDataProperties)
        {
            groups.Add(new(
                DataGroupId,
                SupportsMetricSlots ? InspectorLabels.SeriesGroup : InspectorLabels.DataGroup,
                DataPropertyCount,
                RenderDataProperties()));
        }

        if (ShowsMetricQueryProperties)
        {
            groups.Add(new(
                MetricQueryGroupId,
                InspectorLabels.TimeWindowGroup,
                MetricQueryPropertyCount,
                RenderMetricQueryProperties()));
        }

        if (ShowsFilterProperties)
        {
            groups.Add(new(FilterGroupId, InspectorLabels.FilterGroup, FilterPropertyCount, RenderFilterProperties()));
        }

        groups.Add(new(DisplayGroupId, InspectorLabels.DisplayGroup, DisplayPropertyCount, RenderDisplayProperties()));
        if (_cellStyleDraft is not null)
        {
            groups.Add(new(StyleGroupId, "Cell style", StylePropertyCount, RenderStyleProperties(), StartCollapsed: true));
        }

        groups.Add(new(LayoutGroupId, "Layout", LayoutPropertyCount, RenderLayoutProperties()));
        return groups;
    }

    private RenderFragment RenderDataProperties() => @<text>
        @if (IsMetricQueryBuilderWidget)
        {
        <PropertyGridRow Name="Metric query">
            <div class="dashboard-inspector-query-row">
                <div class="dashboard-inspector-query-preview">
                    <span>@MetricQueryPreviewValue</span>
                    <small title="@MetricQuerySummary">@MetricQuerySummary</small>
                </div>
                <button type="button"
                        class="dashboard-inspector-query-edit"
                        title="@MetricQueryEditTitle"
                        aria-label="@MetricQueryEditTitle"
                        @onclick="@OpenMetricBuilderAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                </button>
            </div>
        </PropertyGridRow>
        }
        else if (!SupportsMetricSlots)
        {
        <PropertyGridRow Name="@InspectorLabels.MetricRow">
            <PropertyGridSelect Value="@(_primaryBindingMetric ?? string.Empty)"
                                Options="@MetricNameOptions"
                                AriaLabel="@InspectorLabels.MetricRow"
                                ValueChanged="@SetPrimaryBindingMetricAsync" />
        </PropertyGridRow>
        }
        else
        {
        <PropertyGridRow Name="@InspectorLabels.PrimarySeriesRow">
            <PropertyGridSelect Value="@(_primaryBindingMetric ?? string.Empty)"
                                Options="@MetricNameOptions"
                                AriaLabel="@InspectorLabels.PrimarySeriesRow"
                                ValueChanged="@SetPrimaryBindingMetricAsync" />
        </PropertyGridRow>

        @foreach (var item in _bindingMetrics.Select((metric, index) => new { Metric = metric, Index = index }))
        {
            var currentMetric = item.Metric;
            <PropertyGridRow Name="@($"{InspectorLabels.SeriesRowPrefix} {item.Index + 1}")">
                <div class="property-grid-inline">
                    <span class="property-grid-cell-text" title="@currentMetric">@DashboardWidgetFormatting.MetricDisplayName(currentMetric)</span>
                    <button type="button"
                            class="property-grid-small-button"
                            title="Move up"
                            disabled="@(item.Index == 0)"
                            @onclick="@(() => MoveBindingMetricAsync(currentMetric, -1))">^</button>
                    <button type="button"
                            class="property-grid-small-button"
                            title="Move down"
                            disabled="@(item.Index == _bindingMetrics.Count - 1)"
                            @onclick="@(() => MoveBindingMetricAsync(currentMetric, 1))">v</button>
                    <button type="button"
                            class="property-grid-small-button"
                            title="Remove"
                            disabled="@(_bindingMetrics.Count == 1)"
                            @onclick="@(() => RemoveBindingMetricAsync(currentMetric))">x</button>
                </div>
            </PropertyGridRow>
        }

        <PropertyGridRow Name="@InspectorLabels.AddSeriesRow">
            <div class="property-grid-inline">
                <PropertyGridSelect Value="@(_metricToAdd ?? string.Empty)"
                                    Options="@AddMetricOptions"
                                    AriaLabel="@InspectorLabels.AddSeriesRow"
                                    ValueChanged="@SetMetricToAddAsync" />
                <button type="button"
                        class="property-grid-small-button"
                        disabled="@string.IsNullOrWhiteSpace(_metricToAdd)"
                        @onclick="@AddBindingMetricAsync">+</button>
            </div>
        </PropertyGridRow>
        }
    </text>;

    private RenderFragment RenderMetricQueryProperties() => @<text>
        @if (_metricDraft is not null)
        {
            @if (_widgetDraft?.Profile.UsesMetricAggregation == true)
            {
                <PropertyGridRow Name="Aggregate">
                    <PropertyGridSelect Value="@_metricDraft.Aggregation"
                                        Options="@AggregationSelectOptions"
                                        AriaLabel="Aggregate"
                                        ValueChanged="@SetMetricAggregationAsync" />
                </PropertyGridRow>
            }
            @if (_widgetDraft?.Profile.UsesMetricWindow == true)
            {
            <PropertyGridRow Name="@InspectorLabels.WindowRow">
                <PropertyGridSelect Value="@_metricDraft.Window"
                                    Options="@WindowSelectOptions"
                                    AriaLabel="@InspectorLabels.WindowRow"
                                    ValueChanged="@SetMetricWindowAsync" />
            </PropertyGridRow>
            }
        }
    </text>;

    private RenderFragment RenderFilterProperties() => @<text>
        @if (_widgetDraft is not null && _metricDraft is not null)
        {
            <PropertyGridRow Name="@InspectorLabels.EventRow">
                <PropertyGridSelect Value="@_widgetDraft.EventType"
                                    Options="@EventTypeSelectOptions"
                                    AriaLabel="@InspectorLabels.EventRow"
                                    ValueChanged="@SetEventTypeAsync" />
            </PropertyGridRow>
            <PropertyGridRow Name="@InspectorLabels.StatusRow">
                <PropertyGridSelect Value="@_widgetDraft.Status"
                                    Options="@StatusSelectOptions"
                                    AriaLabel="@InspectorLabels.StatusRow"
                                    ValueChanged="@SetStatusAsync" />
            </PropertyGridRow>
            @foreach (var field in _widgetDraft.CurrentEventType.Fields)
            {
                var currentField = field;
                <PropertyGridRow Name="@currentField.Label" HelpText="@currentField.HelperText">
                    @RenderFilterField(currentField)
                </PropertyGridRow>
            }
        }
    </text>;

    private RenderFragment RenderMetricVisualizationProperties(DashboardWidgetSettingsDraft draft) => @<text>
        @foreach (var property in MetricVisualizationProperties)
        {
            <PropertyGridRow Name="@property.Label" HelpText="@property.HelpText">
                @RenderMetricVisualizationEditor(property, draft)
            </PropertyGridRow>
        }
    </text>;

    private RenderFragment RenderMetricVisualizationEditor(
        DashboardWidgetPropertyDefinition property,
        DashboardWidgetSettingsDraft draft) => @<text>
        @switch (property.Key)
        {
            case DashboardWidgetCatalog.KpiTitleColorKey:
                <PropertyGridColorPicker Value="@draft.TitleColor"
                                         DefaultValue="@(property.DefaultValue ?? DashboardWidgetCatalog.KpiDefaultTitleColor)"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiTitleColorAsync" />
                break;
            case DashboardWidgetCatalog.KpiSubtitleColorKey:
                <PropertyGridColorPicker Value="@draft.SubtitleColor"
                                         DefaultValue="@(property.DefaultValue ?? DashboardWidgetCatalog.KpiDefaultSubtitleColor)"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiSubtitleColorAsync" />
                break;
            case DashboardWidgetCatalog.KpiValueColorKey:
                <PropertyGridColorPicker Value="@draft.ValueColor"
                                         DefaultValue="@(property.DefaultValue ?? DashboardWidgetCatalog.KpiDefaultValueColor)"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiValueColorAsync" />
                break;
            case DashboardWidgetCatalog.KpiTitleAlignKey:
                <PropertyGridIconSegment Value="@draft.TitleAlign"
                                         Options="@HorizontalAlignmentOptions"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiTitleAlignAsync" />
                break;
            case DashboardWidgetCatalog.KpiValueAlignKey:
                <PropertyGridIconSegment Value="@draft.ValueAlign"
                                         Options="@HorizontalAlignmentOptions"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiValueAlignAsync" />
                break;
            case DashboardWidgetCatalog.KpiValuePlacementKey:
                <PropertyGridIconSegment Value="@draft.ValuePlacement"
                                         Options="@ValuePlacementOptions"
                                         AriaLabel="@property.Label"
                                         ValueChanged="@SetKpiValuePlacementAsync" />
                break;
            default:
                <span class="property-grid-cell-text">Unsupported visual property</span>
                break;
        }
    </text>;

    private RenderFragment RenderDisplayProperties() => @<text>
        @if (_widgetDraft is { } draft)
        {
        <PropertyGridRow Name="@InspectorLabels.TitleRow">
            <input class="property-grid-input"
                   value="@draft.Title"
                   @oninput="@((ChangeEventArgs args) => SetTitleAsync(args.Value?.ToString()))" />
        </PropertyGridRow>
        @if (draft.Profile.UsesSubtitle)
        {
            <PropertyGridRow Name="Subtitle">
                <input class="property-grid-input"
                       value="@draft.Subtitle"
                       @oninput="@((ChangeEventArgs args) => SetSubtitleAsync(args.Value?.ToString()))" />
            </PropertyGridRow>
        }

        @if (draft.Profile.UsesMetricVisualization)
        {
            <PropertyGridRow Name="Visualization">
                <PropertyGridSelect Value="@draft.MetricVisualizationId"
                                    Options="@MetricVisualizationOptions"
                                    AriaLabel="Visualization"
                                    ValueChanged="@SetMetricVisualizationAsync" />
            </PropertyGridRow>

            @RenderMetricVisualizationProperties(draft)
        }

        @if (draft.Profile.UsesVisualMetrics)
        {
            <PropertyGridRow Name="@InspectorLabels.PrimaryCardRow">
                <PropertyGridSelect Value="@draft.PrimaryMetric"
                                    Options="@VisualMetricOptions"
                                    AriaLabel="@InspectorLabels.PrimaryCardRow"
                                    ValueChanged="@SetVisualPrimaryMetricAsync" />
            </PropertyGridRow>

            @if (draft.Profile.SupportsMetricSlots)
            {
                @foreach (var item in draft.DisplayMetrics.Select((metric, index) => new { Metric = metric, Index = index }))
                {
                    var currentMetric = item.Metric;
                    <PropertyGridRow Name="@($"{InspectorLabels.CardRowPrefix} {item.Index + 1}")">
                        <div class="property-grid-inline">
                            <span class="property-grid-cell-text" title="@currentMetric">@VisualMetricLabel(currentMetric)</span>
                            <button type="button"
                                    class="property-grid-small-button"
                                    title="Move up"
                                    disabled="@(item.Index == 0)"
                                    @onclick="@(() => MoveVisualMetricAsync(currentMetric, -1))">^</button>
                            <button type="button"
                                    class="property-grid-small-button"
                                    title="Move down"
                                    disabled="@(item.Index == draft.DisplayMetrics.Count - 1)"
                                    @onclick="@(() => MoveVisualMetricAsync(currentMetric, 1))">v</button>
                            <button type="button"
                                    class="property-grid-small-button"
                                    title="Remove"
                                    disabled="@(!draft.CanRemoveDisplayMetric)"
                                    @onclick="@(() => RemoveVisualMetricAsync(currentMetric))">x</button>
                        </div>
                    </PropertyGridRow>
                }

                <PropertyGridRow Name="@InspectorLabels.AddCardRow">
                    <div class="property-grid-inline">
                        <PropertyGridSelect Value="@(_displayMetricToAdd ?? string.Empty)"
                                            Options="@AddVisualMetricOptions"
                                            AriaLabel="@InspectorLabels.AddCardRow"
                                            ValueChanged="@SetVisualMetricToAddAsync" />
                        <button type="button"
                                class="property-grid-small-button"
                                disabled="@string.IsNullOrWhiteSpace(_displayMetricToAdd)"
                                @onclick="@AddVisualMetricAsync">+</button>
                    </div>
                </PropertyGridRow>

                <PropertyGridRow Name="@InspectorLabels.ColumnsRow" Unit="cols">
                    <input class="property-grid-input"
                           type="number"
                           min="@DashboardWidgetCatalog.MinMetricCardColumns"
                           max="@DashboardWidgetCatalog.MaxMetricCardColumns"
                           step="1"
                           value="@draft.MetricCardColumns"
                           @oninput="@SetMetricCardColumnsFromEventAsync" />
                </PropertyGridRow>
            }
        }

        @if (draft.Profile.UsesGaugeStyle)
        {
            <PropertyGridRow Name="@InspectorLabels.GaugeRow">
                <div class="property-grid-button-group">
                    <button type="button" class="@ChoiceClass(draft.GaugeStyle, DashboardWidgetCatalog.GaugeStyleRing)" @onclick="@(() => SetGaugeStyleAsync(DashboardWidgetCatalog.GaugeStyleRing))">Ring</button>
                    <button type="button" class="@ChoiceClass(draft.GaugeStyle, DashboardWidgetCatalog.GaugeStyleMeter)" @onclick="@(() => SetGaugeStyleAsync(DashboardWidgetCatalog.GaugeStyleMeter))">Meter</button>
                    <button type="button" class="@ChoiceClass(draft.GaugeStyle, DashboardWidgetCatalog.GaugeStyleTiles)" @onclick="@(() => SetGaugeStyleAsync(DashboardWidgetCatalog.GaugeStyleTiles))">Tiles</button>
                </div>
            </PropertyGridRow>
        }

        @if (draft.Profile.UsesChartType)
        {
            <PropertyGridRow Name="@InspectorLabels.ChartRow">
                <div class="property-grid-button-group">
                    <button type="button" class="@ChoiceClass(draft.ChartType, DashboardWidgetCatalog.ChartTypeBars)" @onclick="@(() => SetChartTypeAsync(DashboardWidgetCatalog.ChartTypeBars))">Bars</button>
                    <button type="button" class="@ChoiceClass(draft.ChartType, DashboardWidgetCatalog.ChartTypeLine)" @onclick="@(() => SetChartTypeAsync(DashboardWidgetCatalog.ChartTypeLine))">Line</button>
                    <button type="button" class="@ChoiceClass(draft.ChartType, DashboardWidgetCatalog.ChartTypeArea)" @onclick="@(() => SetChartTypeAsync(DashboardWidgetCatalog.ChartTypeArea))">Area</button>
                    <button type="button" class="@ChoiceClass(draft.ChartType, DashboardWidgetCatalog.ChartTypeTopics)" @onclick="@(() => SetChartTypeAsync(DashboardWidgetCatalog.ChartTypeTopics))">Topics</button>
                </div>
            </PropertyGridRow>
        }

        @if (draft.Profile.IsTopicTreeWidget)
        {
            <PropertyGridRow Name="@InspectorLabels.TopicSystemRow">
                <div class="property-grid-button-group">
                    <button type="button" class="@ChoiceClass(draft.ExcludeSystemTopics ? "false" : "true", "true")" @onclick="@(() => SetExcludeSystemTopicsAsync(false))">Show</button>
                    <button type="button" class="@ChoiceClass(draft.ExcludeSystemTopics ? "true" : "false", "true")" @onclick="@(() => SetExcludeSystemTopicsAsync(true))">Hide</button>
                </div>
            </PropertyGridRow>
        }

        }
    </text>;

    private RenderFragment RenderLayoutProperties() => @<text>
        <PropertyGridRow Name="@LayoutSelectionName">
            <span class="property-grid-cell-text">@LayoutSelectionValue</span>
        </PropertyGridRow>
        <PropertyGridRow Name="Position">
            <span class="property-grid-cell-text">@LayoutPositionValue</span>
        </PropertyGridRow>
        <PropertyGridRow Name="Span">
            <span class="property-grid-cell-text">@LayoutSpanValue</span>
        </PropertyGridRow>
        <PropertyGridRow Name="Widget">
            <span class="property-grid-cell-text">@LayoutWidgetValue</span>
        </PropertyGridRow>
        @if (Widget is not null)
        {
        <PropertyGridRow Name="Actions">
            <div class="property-grid-button-group">
                <button type="button" class="property-grid-action-button" @onclick="@DuplicateWidget">Duplicate</button>
                <button type="button" class="property-grid-action-button danger" @onclick="@DeleteWidget">Delete</button>
            </div>
        </PropertyGridRow>
        }
    </text>;

    private RenderFragment RenderStyleProperties() => @<text>
        @if (_cellStyleDraft is { } draft)
        {
            @foreach (var field in DashboardCellStyleDraft.Fields)
            {
                var currentField = field;
                <PropertyGridRow Name="@currentField.Label" Unit="@currentField.Unit">
                    @if (currentField.Editor == DashboardWidgetPropertyEditorKind.Color)
                    {
                        <PropertyGridColorPicker Value="@draft.GetValue(currentField.Key)"
                                                 DefaultValue="@currentField.DefaultValue"
                                                 AriaLabel="@currentField.Label"
                                                 ValueChanged="@((string? value) => SetStyleValueAsync(currentField.Key, value))" />
                    }
                    else if (currentField.Editor == DashboardWidgetPropertyEditorKind.Select)
                    {
                        <PropertyGridSelect Value="@draft.GetValue(currentField.Key)"
                                            Options="@StyleSelectOptions(currentField)"
                                            AriaLabel="@currentField.Label"
                                            ValueChanged="@((string? value) => SetStyleValueAsync(currentField.Key, value))" />
                    }
                    else
                    {
                        <input class="property-grid-input"
                               type="@StyleInputType(currentField)"
                               value="@draft.GetValue(currentField.Key)"
                               @oninput="@((ChangeEventArgs args) => SetStyleValueAsync(currentField.Key, args.Value?.ToString()))" />
                    }
                </PropertyGridRow>
            }
            <PropertyGridRow Name="Defaults">
                <button type="button" class="property-grid-action-button" @onclick="@ResetCellStyleAsync">Reset cell style</button>
            </PropertyGridRow>
        }
    </text>;

    private RenderFragment RenderFilterField(DashboardEventFilterFieldDescriptor field)
    {
        if (IsQosFilter(field))
        {
            return @<div class="property-grid-button-group">
                    @foreach (var option in QosFilterOptions)
                    {
                        var currentOption = option;
                        <button type="button"
                                class="@ChoiceClass(_widgetDraft!.GetFilterValue(field.Key), currentOption.Value)"
                                @onclick="@(() => SetFilterValueAsync(field.Key, currentOption.Value))">@currentOption.Label</button>
                    }
            </div>;
        }

        if (IsRetainFilter(field))
        {
            return @<div class="property-grid-button-group">
                    @foreach (var option in RetainFilterOptions)
                    {
                        var currentOption = option;
                        <button type="button"
                                class="@ChoiceClass(_widgetDraft!.GetFilterValue(field.Key), currentOption.Value)"
                                @onclick="@(() => SetFilterValueAsync(field.Key, currentOption.Value))">@currentOption.Label</button>
                    }
            </div>;
        }

        return @<input class="property-grid-input"
                       value="@_widgetDraft!.GetFilterValue(field.Key)"
                       placeholder="@field.Placeholder"
                       title="@field.HelperText"
                       @oninput="@((ChangeEventArgs args) => SetFilterValueAsync(field.Key, args.Value?.ToString()))" />;
    }

    private RenderFragment RenderCellSummary() => @<div class="dashboard-inspector-cell-summary">
        @if (SelectedCells.Count == 0)
        {
            <span>No cell selected</span>
        }
        else if (SelectedCells.Count == 1)
        {
            var cell = SelectedCells[0];
            <span>@cell.Label</span>
            <small>Row @(cell.Row + 1), column @(cell.Column + 1), span @cell.ColumnSpan x @cell.RowSpan</small>
            @if (!string.IsNullOrWhiteSpace(cell.Widget))
            {
                <small>Widget: @cell.Widget</small>
            }
        }
        else
        {
            <span>@SelectedCells.Count cells selected</span>
            <small>Use the toolbar to merge this selection when it forms a rectangle.</small>
        }
    </div>;


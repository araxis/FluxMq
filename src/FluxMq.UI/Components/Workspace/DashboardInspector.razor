    private async Task RemoveBindingMetricAsync(string metricName)
    {
        if (_bindingMetrics.Count <= 1)
        {
            return;
        }

        _bindingMetrics.RemoveAll(metric => string.Equals(metric, metricName, StringComparison.Ordinal));
        if (string.Equals(_primaryBindingMetric, metricName, StringComparison.Ordinal))
        {
            _primaryBindingMetric = _bindingMetrics[0];
        }

        await AutoApplyAsync();
    }

    private async Task MoveBindingMetricAsync(string metricName, int offset)
    {
        var index = _bindingMetrics.FindIndex(metric => string.Equals(metric, metricName, StringComparison.Ordinal));
        if (index < 0)
        {
            return;
        }

        var next = Math.Clamp(index + offset, 0, _bindingMetrics.Count - 1);
        if (next == index)
        {
            return;
        }

        _bindingMetrics.RemoveAt(index);
        _bindingMetrics.Insert(next, metricName);
        await AutoApplyAsync();
    }

    private async Task AutoApplyAsync()
    {
        if (Widget is null || _widgetDraft is null)
        {
            return;
        }

        if (_widgetDraft.Profile.UsesMetricQuery)
        {
            _widgetDraft.MetricName = _draftMetricName ?? _widgetDraft.MetricName;
        }

        Project.UpdateDashboardWidget(Widget.Name, _widgetDraft.BuildConfiguration());
        if (_widgetDraft.Profile.UsesMetricQuery &&
            _metricDraft is not null &&
            !string.IsNullOrWhiteSpace(_draftMetricName))
        {
            Project.UpdateDashboardMetric(_draftMetricName, _metricDraft.BuildQuery());
        }

        if (_widgetDraft.Profile.UsesMetricQuery)
        {
            var primaryMetric = _primaryBindingMetric ?? _draftMetricName;
            Project.UpdateDashboardWidgetBinding(
                Widget.Name,
                primaryMetric,
                CurrentBindingMetrics(primaryMetric));
        }

        await Changed.InvokeAsync();
    }


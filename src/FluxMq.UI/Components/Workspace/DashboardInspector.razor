    private async Task ResetWidgetPropertiesAsync()
    {
        if (Widget is null || _widgetDraft is null)
        {
            return;
        }

        _widgetDraft.ResetToDefaultConfiguration(WidgetRegistry.CreateDefaultConfiguration(Widget.Type));
        _metricToAdd = null;
        _displayMetricToAdd = null;

        if (!_widgetDraft.Profile.UsesMetricQuery)
        {
            _metricDraft = null;
            _draftMetricName = null;
            _primaryBindingMetric = null;
            _bindingMetrics = [];
            await AutoApplyAsync();
            return;
        }

        var metricName = string.IsNullOrWhiteSpace(_draftMetricName)
            ? Widget.ReadString("metric") ?? $"{Widget.Name}Metric"
            : _draftMetricName;
        if (IsAppMetricConsumerWidget)
        {
            metricName = Project.MetricNames.Contains(metricName, StringComparer.Ordinal)
                ? metricName
                : Project.MetricNames.FirstOrDefault() ?? metricName;
            _bindingOptions = [];
        }

        _draftMetricName = metricName;
        _widgetDraft.MetricName = metricName;
        _primaryBindingMetric = metricName;
        _bindingMetrics = [metricName];
        _metricDraft = IsAppMetricConsumerWidget
            ? DashboardMetricEditorDraft.Create(
                metricName,
                DashboardMetricReferenceResolver.ResolveAppMetricSnapshot(Project, metricName, _bindingOptions),
                EventFilters,
                MetricRegistry,
                Widget.Type)
            : DashboardMetricEditorDraft.Create(
                metricName,
                null,
                EventFilters,
                MetricRegistry,
                Widget.Type);

        await AutoApplyAsync();
    }

    private async Task OpenMetricBuilderAsync()
    {
        if (Widget is null || _widgetDraft is null || !IsMetricQueryBuilderWidget)
        {
            return;
        }

        var metricName = string.IsNullOrWhiteSpace(_draftMetricName)
            ? Widget.ReadString("metric") ?? $"{Widget.Name}Metric"
            : _draftMetricName;
        var metric = Layout?.Metrics.TryGetValue(metricName, out var foundMetric) == true
            ? foundMetric
            : null;
        var dialog = await DialogService.ShowAsync<DashboardMetricQueryBuilderDialog>(
            MetricQueryDialogTitle,
            new DialogParameters
            {
                [nameof(DashboardMetricQueryBuilderDialog.Project)] = Project,
                [nameof(DashboardMetricQueryBuilderDialog.Widget)] = Widget,
                [nameof(DashboardMetricQueryBuilderDialog.Metric)] = metric,
                [nameof(DashboardMetricQueryBuilderDialog.DialogTitle)] = MetricQueryDialogTitle,
                [nameof(DashboardMetricQueryBuilderDialog.ApplyNote)] = MetricQueryApplyNote,
                [nameof(DashboardMetricQueryBuilderDialog.AllowedMeasures)] = MetricQueryAllowedMeasures
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: DashboardMetricQueryBuilderDialog.DashboardMetricQueryUpdate update })
        {
            await ApplyMetricQueryAsync(metricName, update.Query);
        }
    }


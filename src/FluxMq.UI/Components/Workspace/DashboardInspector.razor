        {
            await AutoApplyAsync();
        }
    }

    private async Task AutoApplyAsync()
    {
        if (Widget is null || _widgetDraft is null)
        {
            return;
        }

        if (_widgetDraft.Profile.UsesMetricQuery)
        {
            _widgetDraft.MetricName = _draftMetricName ?? _widgetDraft.MetricName;
        }

        Project.UpdateDashboardWidget(Widget.Name, _widgetDraft.BuildConfiguration());
        if (_widgetDraft.Profile.UsesMetricQuery &&
            !IsAppMetricConsumerWidget &&
            _metricDraft is not null &&
            !string.IsNullOrWhiteSpace(_draftMetricName))
        {
            Project.UpdateDashboardMetric(_draftMetricName, _metricDraft.BuildQuery());
        }

        if (_widgetDraft.Profile.UsesMetricQuery)
        {
            var primaryMetric = _primaryBindingMetric ?? _draftMetricName;
            Project.UpdateDashboardWidgetBinding(
                Widget.Name,
                primaryMetric,
                DashboardInspectorMetricBindingState.Current(
                    SupportsMetricSlots,
                    _bindingMetrics,
                    primaryMetric,
                    _draftMetricName),
                IsAppMetricConsumerWidget ? _bindingOptions : null);
        }

        await Changed.InvokeAsync();
    }


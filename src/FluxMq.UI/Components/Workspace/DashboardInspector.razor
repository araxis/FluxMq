@using FluxMq.UI.Models
@using FluxMq.App.Metrics
@using FluxMq.UI.Services
@inject DashboardEventFilterCatalog EventFilters
@inject DashboardWidgetRegistry WidgetRegistry
@inject IFluxMetricTypeRegistry TypeRegistry
@inject IDialogService DialogService

<aside class="dashboard-inspector">
    <header class="dashboard-inspector-header">
        <div class="dashboard-inspector-icon">
            <MudIcon Icon="@InspectorIcon" Size="Size.Small" />
        </div>
        <div class="dashboard-inspector-heading">
            <span class="dashboard-inspector-title">@InspectorTitle</span>
            <span class="dashboard-inspector-subtitle">@InspectorSubtitle</span>
        </div>
        @if (Widget is not null)
        {
            <button type="button"
                    class="dashboard-inspector-command"
                    title="Reset widget properties"
                    aria-label="Reset widget properties"
                    @onclick="@ResetWidgetPropertiesAsync">
                <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" />
            </button>
        }
    </header>

    @if (PropertyGroups.Count > 0)
    {
        <PropertyGrid Groups="@PropertyGroups"
                      CollapsedGroupIds="@CollapsedPropertyGroups"
                      CollapsedGroupIdsChanged="@CollapsedPropertyGroupsChanged" />
    }
    else
    {
        <div class="dashboard-inspector-empty">
            @if (SelectedCells.Count == 0)
            {
                <MudIcon Icon="@Icons.Material.Filled.GridView" />
                <span>Select a cell or widget</span>
                <small>Use the grid to place widgets, merge cells, split cells, and inspect layout.</small>
            }
            else
            {
                @RenderCellSummary()
                <MudDivider />
                <small>Drop a widget here or choose one from the catalog.</small>
            }
        </div>
    }
</aside>

@code {
    private static readonly IReadOnlyList<DashboardFilterChoice> WindowOptions =
    [
        new("30s", "30s"),
        new("60s", "1m"),
        new("300s", "5m"),
        new("900s", "15m")
    ];

    private const string DataGroupId = "data";
    private const string MetricQueryGroupId = "metric-query";
    private const string FilterGroupId = "filters";
    private const string DisplayGroupId = "display";
    private const string StyleGroupId = "style";
    private const string LayoutGroupId = "layout";
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    [Parameter]
    public DashboardLayoutSnapshot? Layout { get; set; }

    [Parameter]
    public IReadOnlyList<DashboardCellSnapshot> SelectedCells { get; set; } = [];

    [Parameter]
    public DashboardWidgetSnapshot? Widget { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public IReadOnlySet<string>? CollapsedPropertyGroups { get; set; }

    [Parameter]
    public EventCallback<IReadOnlySet<string>> CollapsedPropertyGroupsChanged { get; set; }

    private DashboardWidgetSettingsDraft? _widgetDraft;
    private DashboardCellStyleDraft? _cellStyleDraft;
    private string? _draftWidgetName;
    private string? _draftCellName;
    private string? _draftMetricName;
    private string? _metricToAdd;
    private string? _displayMetricToAdd;
    private List<string> _bindingMetrics = [];
    private Dictionary<string, string> _bindingOptions = [];
    private string? _primaryBindingMetric;

    private string InspectorIcon => Widget is null
        ? Icons.Material.Filled.GridView
        : DashboardWidgetFormatting.WidgetIcon(Widget);

    private string InspectorTitle => Widget is null
        ? SelectedCells.Count switch
        {
            0 => "Dashboard inspector",
            1 => $"Cell {SelectedCells[0].Label}",
            _ => $"{SelectedCells.Count} cells"
        }
        : DashboardWidgetFormatting.WidgetTitle(PreviewWidget);

    private string InspectorSubtitle => Widget is null
        ? Layout is null ? "No dashboard loaded" : $"{Layout.Columns.Count} columns / {Layout.Rows.Count} rows"
        : Widget.Type;

    private DashboardWidgetSnapshot PreviewWidget => Widget is null || _widgetDraft is null
        ? Widget ?? new DashboardWidgetSnapshot("preview", DashboardWidgetCatalog.EventCounterType, new Dictionary<string, string>())
        : Widget with { Configuration = _widgetDraft.BuildConfiguration() };

    protected override void OnParametersSet()
    {
        LoadSelectedCellDraft();

        if (Widget is null)
        {
            ClearWidgetDraftState();
            return;
        }

        LoadWidgetDraftState(Widget);
    }

    private void LoadSelectedCellDraft()
    {
        var selectedCell = SelectedCells.Count == 1 ? SelectedCells[0] : null;
        var selectedCellName = selectedCell?.Name;
        if (string.Equals(_draftCellName, selectedCellName, StringComparison.Ordinal))
        {
            return;
        }

        _draftCellName = selectedCellName;
        _cellStyleDraft = selectedCell is null
            ? null
            : DashboardCellStyleDraft.Create(selectedCell.Style);
    }

    private void ClearWidgetDraftState()
    {
        _widgetDraft = null;
        _draftWidgetName = null;
        _draftMetricName = null;
        _metricToAdd = null;
        _displayMetricToAdd = null;
        _bindingMetrics = [];
        _bindingOptions = [];
        _primaryBindingMetric = null;
    }

    private void LoadWidgetDraftState(DashboardWidgetSnapshot widget)
    {
        var binding = FindWidgetBinding(widget.Name);
        var metricName = ResolveWidgetMetricName(widget, binding);

        if (string.Equals(_draftWidgetName, widget.Name, StringComparison.Ordinal) &&
            string.Equals(_draftMetricName, metricName, StringComparison.Ordinal))
        {
            return;
        }

        _draftWidgetName = widget.Name;
        _draftMetricName = metricName;
        _widgetDraft = DashboardWidgetSettingsDraft.Create(widget, EventFilters);
        _metricToAdd = null;
        _displayMetricToAdd = null;
        _bindingOptions = binding?.Options is null
            ? []
            : new Dictionary<string, string>(binding.Options, StringComparer.Ordinal);

        if (!IsAppMetricConsumerType(_widgetDraft.Profile.Type))
        {
            ClearMetricDraftState();
            return;
        }

        LoadMetricDraftState(binding, metricName);
    }

    private DashboardWidgetBindingSnapshot? FindWidgetBinding(string widgetName)
        => Layout?.Bindings.TryGetValue(widgetName, out var foundBinding) == true
            ? foundBinding
            : null;

    private string ResolveWidgetMetricName(
        DashboardWidgetSnapshot widget,
        DashboardWidgetBindingSnapshot? binding)
        => binding?.PrimaryMetric ??
            widget.ReadString("metric") ??
            binding?.Metrics.FirstOrDefault() ??
            (IsAppMetricConsumerType(widget.Type) ? Project.MetricNames.FirstOrDefault() : null) ??
            $"{widget.Name}Metric";

    private void ClearMetricDraftState()
    {
        _bindingMetrics = [];
        _bindingOptions = [];
        _primaryBindingMetric = null;
    }

    private void LoadMetricDraftState(
        DashboardWidgetBindingSnapshot? binding,
        string metricName)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.MetricName = metricName;
        _primaryBindingMetric = metricName;
        _bindingMetrics = DashboardInspectorMetricBindingState.Initialize(
            binding?.Metrics,
            metricName,
            _widgetDraft.Profile.SupportsMetricSlots);
    }

    private IReadOnlyList<PropertyGridGroup> PropertyGroups => BuildPropertyGroups();

    private IReadOnlyList<PropertyGridGroup> BuildPropertyGroups()
    {
        if (Widget is null || _widgetDraft is null)
        {
            var cellGroups = new List<PropertyGridGroup>();
            if (_cellStyleDraft is not null)
            {
                cellGroups.Add(new(StyleGroupId, "Cell style", StylePropertyCount, RenderStyleProperties(), StartCollapsed: true));
                cellGroups.Add(new(LayoutGroupId, "Layout", LayoutPropertyCount, RenderLayoutProperties()));
            }

            return cellGroups;
        }

        var groups = new List<PropertyGridGroup>();
        if (ShowsDataProperties)
        {
            groups.Add(new(
                DataGroupId,
                SupportsMetricSlots ? InspectorLabels.SeriesGroup : InspectorLabels.DataGroup,
                DataPropertyCount,
                RenderDataProperties()));
        }

        if (ShowsMetricQueryProperties)
        {
            groups.Add(new(
                MetricQueryGroupId,
                InspectorLabels.TimeWindowGroup,
                MetricQueryPropertyCount,
                RenderMetricQueryProperties()));
        }

        if (ShowsFilterProperties)
        {
            groups.Add(new(FilterGroupId, InspectorLabels.FilterGroup, FilterPropertyCount, RenderFilterProperties()));
        }

        groups.Add(new(DisplayGroupId, InspectorLabels.DisplayGroup, DisplayPropertyCount, RenderDisplayProperties()));
        if (_cellStyleDraft is not null)
        {
            groups.Add(new(StyleGroupId, "Cell style", StylePropertyCount, RenderStyleProperties(), StartCollapsed: true));
        }

        groups.Add(new(LayoutGroupId, "Layout", LayoutPropertyCount, RenderLayoutProperties()));
        return groups;
    }

    private RenderFragment RenderDataProperties() => @<text>
        @if (IsAppMetricConsumerWidget)
        {
        <DashboardInspectorAppMetricRows MetricId="@_primaryBindingMetric"
                                         MetricOptions="@AppMetricNameOptions"
                                         Parameters="@SelectedAppMetricParameters"
                                         ParameterValues="@_bindingOptions"
                                         Summary="@SelectedAppMetricSummary"
                                         Preview="@SelectedAppMetricPreview"
                                         MetricChanged="@SetAppMetricAsync"
                                         ParameterChanged="@SetMetricParameterAsync"
                                         OpenMetric="@OpenSelectedMetricAsync" />
        }
        else
        {
        <DashboardInspectorMetricBindingRows Labels="@InspectorLabels"
                                             SupportsSlots="@SupportsMetricSlots"
                                             PrimaryMetric="@_primaryBindingMetric"
                                             Metrics="@_bindingMetrics"
                                             MetricToAdd="@_metricToAdd"
                                             MetricOptions="@MetricNameOptions"
                                             AddMetricOptions="@AddMetricOptions"
                                             PrimaryMetricChanged="@SetPrimaryBindingMetricAsync"
                                             MetricToAddChanged="@SetMetricToAddAsync"
                                             AddMetric="@AddBindingMetricAsync"
                                             RemoveMetric="@RemoveBindingMetricAsync"
                                             MoveMetric="@MoveBindingMetricAsync" />
        }
    </text>;

    private RenderFragment RenderMetricQueryProperties() => @<text>
        @if (_widgetDraft is { } draft && draft.Profile.UsesMetricWindow)
        {
        <PropertyGridRow Name="@InspectorLabels.WindowRow">
            <PropertyGridSelect Value="@draft.Window"
                                Options="@WindowSelectOptions"
                                AriaLabel="@InspectorLabels.WindowRow"
                                ValueChanged="@SetMetricWindowAsync" />
        </PropertyGridRow>
        }
    </text>;

    private RenderFragment RenderFilterProperties() => @<DashboardInspectorEventFilterRows Draft="@_widgetDraft"
                                                                                           Labels="@InspectorLabels"
                                                                                           EventOptions="@EventTypeSelectOptions"
                                                                                           StatusOptions="@StatusSelectOptions"
                                                                                           EventChanged="@SetEventTypeAsync"
                                                                                           StatusChanged="@SetStatusAsync"
                                                                                           FilterChanged="@SetFilterValueAsync" />;

    private RenderFragment RenderDisplayProperties() => @<text>
        @if (_widgetDraft is { } draft)
        {
        @if (!draft.Profile.UsesMetricVisualization &&
             !draft.Profile.UsesLatestEventVisual &&
             !draft.Profile.UsesEventTableVisual &&
             !draft.Profile.UsesTopicActivityVisual &&
             !draft.Profile.UsesLineChartVisual &&
             !draft.Profile.UsesAreaChartVisual &&
             !draft.Profile.UsesBarChartVisual &&
             !draft.Profile.UsesDonutChartVisual &&
             !draft.Profile.UsesTopicTreeVisual)
        {
            <PropertyGridRow Name="@InspectorLabels.TitleRow">
                <input class="property-grid-input"
                       value="@draft.Title"
                       @oninput="@((ChangeEventArgs args) => SetTitleAsync(args.Value?.ToString()))" />
            </PropertyGridRow>
            @if (draft.Profile.UsesSubtitle)
            {
                <PropertyGridRow Name="Subtitle">
                    <input class="property-grid-input"
                           value="@draft.Subtitle"
                           @oninput="@((ChangeEventArgs args) => SetSubtitleAsync(args.Value?.ToString()))" />
                </PropertyGridRow>
            }
        }

        @if (draft.Profile.UsesMetricVisualization)
        {
            <DashboardInspectorMetricVisualizationRows Draft="@draft"
                                                       VisualizationOptions="@MetricVisualizationOptions"
                                                       Properties="@CurrentMetricVisualizationProperties"
                                                       VisualizationChanged="@SetMetricVisualizationAsync"
                                                       PropertyChanged="@SetMetricVisualizationValueAsync" />
        }

        @if (draft.Profile.UsesVisualMetrics)
        {
            <DashboardInspectorVisualMetricRows Draft="@draft"
                                                Labels="@InspectorLabels"
                                                MetricToAdd="@_displayMetricToAdd"
                                                MetricOptions="@VisualMetricOptions"
                                                AddMetricOptions="@AddVisualMetricOptions"
                                                PrimaryMetricChanged="@SetVisualPrimaryMetricAsync"
                                                MetricToAddChanged="@SetVisualMetricToAddAsync"
                                                AddMetric="@AddVisualMetricAsync"
                                                MoveMetric="@MoveVisualMetricAsync"
                                                RemoveMetric="@RemoveVisualMetricAsync"
                                                CardColumnsChanged="@SetMetricCardColumnsAsync" />
        }

        <DashboardInspectorDisplayModeRows Draft="@draft"
                                           Labels="@InspectorLabels"
                                           GaugeStyleChanged="@SetGaugeStyleAsync"
                                           GaugePropertyChanged="@SetGaugePropertyAsync"
                                           LatestEventVisualPropertyChanged="@SetLatestEventVisualPropertyAsync"
                                           EventTableVisualPropertyChanged="@SetEventTableVisualPropertyAsync"
                                           TopicActivityVisualPropertyChanged="@SetTopicActivityVisualPropertyAsync"
                                           TopicTreeVisualPropertyChanged="@SetTopicTreeVisualPropertyAsync"
                                           LineChartVisualPropertyChanged="@SetLineChartVisualPropertyAsync"
                                           AreaChartVisualPropertyChanged="@SetAreaChartVisualPropertyAsync"
                                           BarChartVisualPropertyChanged="@SetBarChartVisualPropertyAsync"
                                           DonutChartVisualPropertyChanged="@SetDonutChartVisualPropertyAsync"
                                           ChartTypeChanged="@SetChartTypeAsync" />

        }
    </text>;

    private RenderFragment RenderLayoutProperties() => @<DashboardInspectorLayoutRows SelectedCells="@SelectedCells"
                                                                                       Widget="@Widget"
                                                                                       DuplicateWidget="@DuplicateWidget"
                                                                                       DeleteWidget="@DeleteWidget" />;

    private RenderFragment RenderStyleProperties() => @<DashboardInspectorCellStyleRows Draft="@_cellStyleDraft"
                                                                                         ValueChanged="@SetStyleValueAsync"
                                                                                         WidgetAlignmentChanged="@SetCellWidgetAlignmentAsync"
                                                                                         Reset="@ResetCellStyleAsync" />;

    private RenderFragment RenderCellSummary() => @<div class="dashboard-inspector-cell-summary">
        @if (SelectedCells.Count == 0)
        {
            <span>No cell selected</span>
        }
        else if (SelectedCells.Count == 1)
        {
            var cell = SelectedCells[0];
            <span>@cell.Label</span>
            <small>Row @(cell.Row + 1), column @(cell.Column + 1), span @cell.ColumnSpan x @cell.RowSpan</small>
            @if (!string.IsNullOrWhiteSpace(cell.Widget))
            {
                <small>Widget: @cell.Widget</small>
            }
        }
        else
        {
            <span>@SelectedCells.Count cells selected</span>
            <small>Use the toolbar to merge this selection when it forms a rectangle.</small>
        }
    </div>;

    private bool SupportsMetricSlots => _widgetDraft?.Profile.SupportsMetricSlots == true;

    private DashboardWidgetInspectorLabels InspectorLabels =>
        _widgetDraft?.Profile.InspectorLabels ?? DashboardWidgetInspectorLabels.Default;

    private bool IsAppMetricConsumerWidget =>
        IsAppMetricConsumerType(_widgetDraft?.Profile.Type);

    // App-metric tiles select a metric resource; inline event widgets edit filters + window directly.
    private bool ShowsDataProperties => IsAppMetricConsumerWidget;

    private bool ShowsMetricQueryProperties =>
        _widgetDraft?.Profile.UsesMetricWindow == true &&
        !IsAppMetricConsumerWidget;

    private bool ShowsFilterProperties =>
        _widgetDraft?.Profile.UsesEventFilters == true &&
        !IsAppMetricConsumerWidget;

    private int DataPropertyCount => ShowsDataProperties
        ? 3 + SelectedAppMetricParameters.Count
        : 0;

    private int MetricQueryPropertyCount => ShowsMetricQueryProperties ? 1 : 0;

    private int FilterPropertyCount => _widgetDraft is null || !ShowsFilterProperties
        ? 0
        : 2 + _widgetDraft.CurrentEventType.Fields.Count;

    private int DisplayPropertyCount => _widgetDraft is null
        ? 0
        : (_widgetDraft.Profile.UsesMetricVisualization ? 1 + MetricVisualizationPropertyCount : _widgetDraft.Profile.UsesLatestEventVisual || _widgetDraft.Profile.UsesEventTableVisual || _widgetDraft.Profile.UsesTopicActivityVisual || _widgetDraft.Profile.UsesLineChartVisual || _widgetDraft.Profile.UsesAreaChartVisual || _widgetDraft.Profile.UsesBarChartVisual || _widgetDraft.Profile.UsesDonutChartVisual || _widgetDraft.Profile.UsesTopicTreeVisual ? 0 : 1 + (_widgetDraft.Profile.UsesSubtitle ? 1 : 0)) +
          (_widgetDraft.Profile.UsesLatestEventVisual ? 11 : 0) +
          (_widgetDraft.Profile.UsesEventTableVisual ? 13 : 0) +
          (_widgetDraft.Profile.UsesTopicActivityVisual ? 9 : 0) +
          (_widgetDraft.Profile.UsesLineChartVisual ? 10 : 0) +
          (_widgetDraft.Profile.UsesAreaChartVisual ? 12 : 0) +
          (_widgetDraft.Profile.UsesBarChartVisual ? 10 : 0) +
          (_widgetDraft.Profile.UsesDonutChartVisual ? 14 : 0) +
          (_widgetDraft.Profile.UsesTopicTreeVisual ? 11 : 0) +
          (_widgetDraft.Profile.UsesGaugeStyle ? 9 : 0) +
          (_widgetDraft.Profile.UsesChartType ? 1 : 0) +
          (_widgetDraft.Profile.UsesVisualMetrics
              ? 1 + (_widgetDraft.Profile.SupportsMetricSlots ? 2 + _widgetDraft.DisplayMetrics.Count : 0)
              : 0);

    private DashboardMetricVisualizationModule? CurrentMetricVisualizationModule =>
        DashboardMetricVisualizationCatalog.Find(_widgetDraft?.MetricVisualizationId);

    private IReadOnlyList<DashboardWidgetPropertyDefinition> CurrentMetricVisualizationProperties =>
        CurrentMetricVisualizationModule?.PropertyGroups
            .SelectMany(static group => group.Properties)
            .ToArray() ?? [];

    private int MetricVisualizationPropertyCount => CurrentMetricVisualizationProperties.Count;

    private int StylePropertyCount => _cellStyleDraft is null
        ? 0
        : DashboardCellStyleDraft.Fields.Count + 1;

    private int LayoutPropertyCount => Widget is null ? 4 : 5;

    private DashboardCellSnapshot? PrimarySelectedCell => SelectedCells.Count == 1
        ? SelectedCells[0]
        : null;

    private IEnumerable<string> AvailableMetricNames
    {
        get
        {
            var names = new HashSet<string>(StringComparer.Ordinal);
            if (!string.IsNullOrWhiteSpace(_draftMetricName))
            {
                names.Add(_draftMetricName);
            }

            if (Layout is not null)
            {
                foreach (var name in Layout.Metrics.Keys)
                {
                    names.Add(name);
                }
            }

            return names.OrderBy(DashboardWidgetFormatting.MetricDisplayName, StringComparer.Ordinal);
        }
    }

    private IReadOnlyDictionary<string, FluxMetricResourceDefinition> AppMetricArtifacts => Project.GetMetricResources();

    private FluxMetricResourceDefinition? SelectedAppMetric =>
        !string.IsNullOrWhiteSpace(_primaryBindingMetric) &&
        AppMetricArtifacts.TryGetValue(_primaryBindingMetric, out var metric)
            ? metric
            : null;

    private IReadOnlyList<FluxMetricParameterDescriptor> SelectedAppMetricParameters =>
        SelectedAppMetric is { } resource && TypeRegistry.TryGetNumberType(resource.TypeId, out var type)
            ? type.Parameters
            : [];

    private IReadOnlyList<PropertyGridSelectOption> AppMetricNameOptions
    {
        get
        {
            var options = new List<PropertyGridSelectOption>();
            if (AppMetricArtifacts.Count == 0)
            {
                options.Add(new("", "No metrics", true));
                return options;
            }

            if (string.IsNullOrWhiteSpace(_primaryBindingMetric))
            {
                options.Add(new("", "Select metric", true));
            }

            var compatibleMetrics = AppMetricArtifacts
                .Where(metric => IsCompatibleAppMetric(metric.Value))
                .ToArray();
            if (compatibleMetrics.Length == 0)
            {
                options.Add(new("", "No compatible metrics", true));
            }

            options.AddRange(compatibleMetrics.Select(metric => new PropertyGridSelectOption(
                metric.Key,
                AppMetricDisplayName(metric.Key, metric.Value))));

            if (!string.IsNullOrWhiteSpace(_primaryBindingMetric) &&
                (!AppMetricArtifacts.TryGetValue(_primaryBindingMetric, out var selectedMetric) ||
                 !IsCompatibleAppMetric(selectedMetric)))
            {
                var label = selectedMetric is null
                    ? $"{_primaryBindingMetric} (missing)"
                    : $"{AppMetricDisplayName(_primaryBindingMetric, selectedMetric)} (incompatible)";
                options.Insert(0, new(_primaryBindingMetric, label, true));
            }

            return options;
        }
    }

    private IReadOnlyList<PropertyGridSelectOption> MetricNameOptions
        => [.. AvailableMetricNames.Select(static metric => new PropertyGridSelectOption(
            metric,
            DashboardWidgetFormatting.MetricDisplayName(metric)))];

    private IReadOnlyList<PropertyGridSelectOption> AddMetricOptions
        => [
            new("", "Select metric", true),
            .. AvailableMetricNames
                .Where(metric => !_bindingMetrics.Contains(metric, StringComparer.Ordinal))
                .Select(static metric => new PropertyGridSelectOption(
                    metric,
                    DashboardWidgetFormatting.MetricDisplayName(metric)))
        ];

    private IReadOnlyList<PropertyGridSelectOption> VisualMetricOptions
        => [.. DashboardWidgetCatalog.MetricOptions.Select(static metric => new PropertyGridSelectOption(metric.Id, metric.Label))];

    private IReadOnlyList<PropertyGridSelectOption> MetricVisualizationOptions
        => [.. DashboardMetricVisualizationCatalog.CreateModules().Select(static visual => new PropertyGridSelectOption(
            visual.Id,
            visual.DisplayName))];

    private IReadOnlyList<PropertyGridSelectOption> AddVisualMetricOptions
        => _widgetDraft is null
            ? [new("", "Select card metric", true)]
            : [
                new("", "Select card metric", true),
                .. _widgetDraft.AvailableDisplayMetrics
                    .Select(static metric => new PropertyGridSelectOption(metric.Id, metric.Label))
            ];

    private IReadOnlyList<PropertyGridSelectOption> WindowSelectOptions
        => ToSelectOptions(WindowOptions);

    private IReadOnlyList<PropertyGridSelectOption> EventTypeSelectOptions
        => [.. EventFilters.EventTypes.Select(static option => new PropertyGridSelectOption(option.Value, option.Label))];

    private IReadOnlyList<PropertyGridSelectOption> StatusSelectOptions
        => _widgetDraft is null
            ? []
            : [.. _widgetDraft.CurrentEventType.StatusOptions.Select(static option => new PropertyGridSelectOption(option.Value, option.Label))];

    private string SelectedAppMetricSummary
    {
        get
        {
            var resource = DashboardMetricReferenceResolver.ResolveAppMetric(Project, _primaryBindingMetric, _bindingOptions);
            return resource is not null && TypeRegistry.TryGetNumberType(resource.TypeId, out var type)
                ? type.Summarize(resource)
                : "Select an app metric";
        }
    }

    private string SelectedAppMetricPreview
    {
        get
        {
            if (SelectedAppMetric is null)
            {
                return "No metric selected";
            }

            var value = Project.GetDashboardMetricValue(PreviewWidget);
            return $"{value.FormattedValue} - {SelectedAppMetricSummary}";
        }
    }


    private async Task SetTitleAsync(string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.Title = value ?? string.Empty;
        await AutoApplyAsync();
    }

    private async Task SetSubtitleAsync(string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.Subtitle = value ?? string.Empty;
        await AutoApplyAsync();
    }

    private async Task SetMetricVisualizationAsync(string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.MetricVisualization.SetVisualization(value, applyDefaults: true);
        await AutoApplyAsync();
    }

    private Task SetMetricVisualizationValueAsync(DashboardInspectorPropertyValueChange change)
        => SetMetricVisualizationValueAsync(change.Key, change.Value);

    private async Task SetMetricVisualizationValueAsync(string key, string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        var configuration = _widgetDraft.MetricVisualization.BuildConfiguration()
            .ToDictionary(static pair => pair.Key, static pair => pair.Value, StringComparer.Ordinal);
        configuration[key] = value ?? string.Empty;
        _widgetDraft.MetricVisualization.ApplyConfiguration(configuration);
        await AutoApplyAsync();
    }

    private async Task SetGaugeStyleAsync(string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.GaugeStyle = string.IsNullOrWhiteSpace(value)
            ? DashboardEventGaugeWidgetOptions.StyleRing
            : value.Trim();
        await AutoApplyAsync();
    }

    private Task SetGaugePropertyAsync(DashboardInspectorPropertyValueChange change)
        => SetGaugePropertyAsync(change.Key, change.Value);

    private async Task SetGaugePropertyAsync(string key, string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        var normalized = value ?? string.Empty;
        switch (key)
        {
            case DashboardEventGaugeWidgetOptions.MinKey:
                _widgetDraft.GaugeMin = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.MaxKey:
                _widgetDraft.GaugeMax = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.TargetKey:
                _widgetDraft.GaugeTarget = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.WarningKey:
                _widgetDraft.GaugeWarning = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.CriticalKey:
                _widgetDraft.GaugeCritical = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.NormalColorKey:
                _widgetDraft.GaugeNormalColor = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.WarningColorKey:
                _widgetDraft.GaugeWarningColor = normalized;
                break;
            case DashboardEventGaugeWidgetOptions.CriticalColorKey:
                _widgetDraft.GaugeCriticalColor = normalized;
                break;
            default:
                return;
        }

        await AutoApplyAsync();
    }

    private Task SetLatestEventVisualPropertyAsync(DashboardInspectorPropertyValueChange change)
        => SetLatestEventVisualPropertyAsync(change.Key, change.Value);

    private async Task SetLatestEventVisualPropertyAsync(string key, string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.SetLatestEventVisualValue(key, value);
        await AutoApplyAsync();
    }

    private Task SetEventTableVisualPropertyAsync(DashboardInspectorPropertyValueChange change)
        => SetEventTableVisualPropertyAsync(change.Key, change.Value);

    private async Task SetEventTableVisualPropertyAsync(string key, string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.SetEventTableVisualValue(key, value);
        await AutoApplyAsync();
    }

    private Task SetTopicActivityVisualPropertyAsync(DashboardInspectorPropertyValueChange change)
        => SetTopicActivityVisualPropertyAsync(change.Key, change.Value);

    private async Task SetTopicActivityVisualPropertyAsync(string key, string? value)
    {
        if (_widgetDraft is null)
        {
            return;
        }

        _widgetDraft.SetTopicActivityVisualValue(key, value);
        await AutoApplyAsync();
    }

    private Task SetTopicTreeVisualPropertyAsync(DashboardInspectorPropertyValueChange change)
        => SetTopicTreeVisualPropertyAsync(change.Key, change.Value);

    private async Task SetTopicTreeVisualPropertyAsync(string key, string? value)
    {

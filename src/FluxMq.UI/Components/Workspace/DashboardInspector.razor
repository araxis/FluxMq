    private IReadOnlyList<string> CurrentBindingMetrics(string? primaryMetric)
    {
        if (!SupportsMetricSlots)
        {
            var metric = string.IsNullOrWhiteSpace(primaryMetric)
                ? _draftMetricName
                : primaryMetric;
            return string.IsNullOrWhiteSpace(metric)
                ? []
                : [metric];
        }

        var metrics = _bindingMetrics
            .Where(static metric => !string.IsNullOrWhiteSpace(metric))
            .Distinct(StringComparer.Ordinal)
            .ToList();
        if (!string.IsNullOrWhiteSpace(primaryMetric) &&
            !metrics.Contains(primaryMetric, StringComparer.Ordinal))
        {
            metrics.Insert(0, primaryMetric);
        }

        if (metrics.Count == 0 && !string.IsNullOrWhiteSpace(_draftMetricName))
        {
            metrics.Add(_draftMetricName);
        }

        return metrics;
    }

    private void LoadMetricDraft(string metricName)
    {
        _draftMetricName = metricName;
        if (_widgetDraft is not null)
        {
            _widgetDraft.MetricName = metricName;
        }

        var metric = Layout?.Metrics.TryGetValue(metricName, out var foundMetric) == true
            ? foundMetric
            : null;
        _metricDraft = DashboardMetricEditorDraft.Create(
            metricName,
            metric,
            EventFilters,
            MetricRegistry,
            Widget?.Type ?? DashboardWidgetCatalog.EventCounterType);
    }

    private static DashboardMetricSnapshot ToMetricSnapshot(
        string metricName,
        DashboardMetricQueryDefinition query)
    {
        var filters = new Dictionary<string, string>(StringComparer.Ordinal);
        AddIfPresent(filters, DashboardEventFilterCatalog.EventTypeKey, query.EventType);
        AddIfPresent(filters, DashboardEventFilterCatalog.TopicStartsWithKey, query.TopicStartsWith);
        AddIfPresent(filters, DashboardEventFilterCatalog.TopicNotStartsWithKey, query.TopicNotStartsWith);
        AddIfPresent(filters, DashboardEventFilterCatalog.StatusKey, query.Status);
        foreach (var (key, value) in query.AdditionalFilters)
        {
            AddIfPresent(filters, key, value);
        }

        return new DashboardMetricSnapshot(
            metricName,
            query.Source,
            query.Aggregation,
            query.Window,
            query.GroupBy,
            filters,
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["unit"] = query.Format
            });
    }

    private static void AddIfPresent(Dictionary<string, string> target, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            target[key] = value.Trim();
        }
    }

    private static string NormalizeValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();


    private async Task ResetWidgetPropertiesAsync()
    {
        if (Widget is null || _widgetDraft is null)
        {
            return;
        }

        _widgetDraft.ResetToDefaultConfiguration(WidgetRegistry.CreateDefaultConfiguration(Widget.Type));
        _metricToAdd = null;
        _displayMetricToAdd = null;

        if (!IsAppMetricConsumerWidget)
        {
            _draftMetricName = null;
            _primaryBindingMetric = null;
            _bindingMetrics = [];
            await AutoApplyAsync();
            return;
        }

        var metricName = string.IsNullOrWhiteSpace(_draftMetricName)
            ? Widget.ReadString("metric") ?? $"{Widget.Name}Metric"
            : _draftMetricName;
        metricName = Project.MetricNames.Contains(metricName, StringComparer.Ordinal)
            ? metricName
            : Project.MetricNames.FirstOrDefault() ?? metricName;
        _bindingOptions = [];

        _draftMetricName = metricName;
        _widgetDraft.MetricName = metricName;
        _primaryBindingMetric = metricName;
        _bindingMetrics = [metricName];

        await AutoApplyAsync();
    }


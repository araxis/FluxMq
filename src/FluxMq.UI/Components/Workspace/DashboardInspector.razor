    private Task SetFilterValueAsync(DashboardInspectorPropertyValueChange change)
        => SetFilterValueAsync(change.Key, change.Value);

    private async Task SetFilterValueAsync(string key, string? value)
    {
        _widgetDraft?.SetFilterValue(key, value);
        if (_metricDraft is null)
        {
            await AutoApplyAsync();
            return;
        }

        if (string.Equals(key, DashboardEventFilterCatalog.TopicStartsWithKey, StringComparison.Ordinal))
        {
            _metricDraft.TopicStartsWith = value ?? string.Empty;
        }
        else if (string.Equals(key, DashboardEventFilterCatalog.TopicNotStartsWithKey, StringComparison.Ordinal))
        {
            _metricDraft.TopicNotStartsWith = value ?? string.Empty;
        }
        else if (string.Equals(key, DashboardEventFilterCatalog.SubjectStartsWithKey, StringComparison.Ordinal))
        {
            _metricDraft.SubjectStartsWith = value ?? string.Empty;
        }
        else if (string.Equals(key, DashboardEventFilterCatalog.AttributeFilterKey("qos"), StringComparison.Ordinal))
        {
            _metricDraft.Qos = value ?? string.Empty;
        }
        else if (string.Equals(key, DashboardEventFilterCatalog.AttributeFilterKey("retain"), StringComparison.Ordinal))
        {
            _metricDraft.Retain = value ?? string.Empty;
        }
        else if (string.Equals(key, DashboardEventFilterCatalog.AttributeFilterKey("schemaId"), StringComparison.Ordinal))
        {
            _metricDraft.SchemaId = value ?? string.Empty;
        }

        await AutoApplyAsync();
    }

    private async Task SetPrimaryBindingMetricAsync(string? value)
    {
        _primaryBindingMetric = DashboardInspectorMetricBindingState.NormalizeSelection(value, _draftMetricName);
        _bindingMetrics = DashboardInspectorMetricBindingState.EnsurePrimary(
            _bindingMetrics,
            _primaryBindingMetric,
            SupportsMetricSlots);

        if (!string.IsNullOrWhiteSpace(_primaryBindingMetric))
        {
            LoadMetricDraft(_primaryBindingMetric);
        }

        await AutoApplyAsync();
    }

    private async Task SetAppMetricAsync(string? value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        _primaryBindingMetric = normalized;
        _draftMetricName = normalized;
        _bindingMetrics = string.IsNullOrWhiteSpace(normalized) ? [] : [normalized];
        _bindingOptions = [];
        if (_widgetDraft is not null)
        {
            _widgetDraft.MetricName = normalized ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(normalized))
        {
            LoadMetricDraft(normalized);
        }

        await AutoApplyAsync();
    }


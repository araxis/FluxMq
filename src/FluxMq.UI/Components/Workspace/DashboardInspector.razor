    private void LoadMetricDraft(string metricName)
    {
        _draftMetricName = metricName;
        if (_widgetDraft is not null)
        {
            _widgetDraft.MetricName = metricName;
        }

        var metric = DashboardMetricReferenceResolver.ResolveAppMetricSnapshot(Project, metricName, _bindingOptions) ??
            (Layout?.Metrics.TryGetValue(metricName, out var foundMetric) == true
            ? foundMetric
            : null);
        _metricDraft = DashboardMetricEditorDraft.Create(
            metricName,
            metric,
            EventFilters,
            MetricRegistry,
            Widget?.Type ?? DashboardWidgetCatalog.EventCounterType);
    }

    private FluxMetricDefinition? CreateSelectedAppMetricDefinition()
        => string.IsNullOrWhiteSpace(_primaryBindingMetric)
            ? null
            : DashboardMetricReferenceResolver.ResolveAppMetricDefinition(Project, _primaryBindingMetric, _bindingOptions);

    private static bool IsAppMetricConsumerType(string? type)
        => string.Equals(type, DashboardWidgetCatalog.KpiTileType, StringComparison.Ordinal) ||
           string.Equals(type, DashboardWidgetCatalog.StatusValueType, StringComparison.Ordinal) ||
           string.Equals(type, DashboardWidgetCatalog.EventGaugeType, StringComparison.Ordinal) ||
           string.Equals(type, DashboardWidgetCatalog.RateTileType, StringComparison.Ordinal) ||
           string.Equals(type, DashboardWidgetCatalog.EventCounterType, StringComparison.Ordinal) ||
           string.Equals(type, DashboardWidgetCatalog.EventRateType, StringComparison.Ordinal);

    private bool IsCompatibleAppMetric(FluxMetricArtifactDefinition metric)
    {
        if (string.Equals(_widgetDraft?.Profile.Type, DashboardWidgetCatalog.EventCounterType, StringComparison.Ordinal) ||
            string.Equals(_widgetDraft?.Profile.Type, DashboardWidgetCatalog.StatusValueType, StringComparison.Ordinal))
        {
            return string.Equals(metric.Definition.Measure, FluxMetricCatalog.MeasureCount, StringComparison.Ordinal);
        }

        if (string.Equals(_widgetDraft?.Profile.Type, DashboardWidgetCatalog.EventRateType, StringComparison.Ordinal) ||
            string.Equals(_widgetDraft?.Profile.Type, DashboardWidgetCatalog.RateTileType, StringComparison.Ordinal))
        {
            return string.Equals(metric.Definition.Measure, FluxMetricCatalog.MeasureRate, StringComparison.Ordinal);
        }

        return true;
    }

    private static string AppMetricDisplayName(string metricName, FluxMetricArtifactDefinition metric)
        => string.IsNullOrWhiteSpace(metric.DisplayName)
            ? DashboardWidgetFormatting.MetricDisplayName(metricName)
            : metric.DisplayName;

    private static string NormalizeValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private static IReadOnlyList<PropertyGridSelectOption> ToSelectOptions(IEnumerable<DashboardFilterChoice> options)
        => [.. options.Select(static option => new PropertyGridSelectOption(option.Value, option.Label))];

    private sealed record DashboardFilterChoice(string Value, string Label);

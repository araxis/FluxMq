    private async Task SetPrimaryBindingMetricAsync(string? value)
    {
        _primaryBindingMetric = DashboardInspectorMetricBindingState.NormalizeSelection(value, _draftMetricName);
        _bindingMetrics = DashboardInspectorMetricBindingState.EnsurePrimary(
            _bindingMetrics,
            _primaryBindingMetric,
            SupportsMetricSlots);

        if (!string.IsNullOrWhiteSpace(_primaryBindingMetric))
        {
            LoadMetricDraft(_primaryBindingMetric);
        }

        await AutoApplyAsync();
    }

    private async Task SetAppMetricAsync(string? value)
    {
        var normalized = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        _primaryBindingMetric = normalized;
        _draftMetricName = normalized;
        _bindingMetrics = string.IsNullOrWhiteSpace(normalized) ? [] : [normalized];
        _bindingOptions = [];
        if (_widgetDraft is not null)
        {
            _widgetDraft.MetricName = normalized ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(normalized))
        {
            LoadMetricDraft(normalized);
        }

        await AutoApplyAsync();
    }


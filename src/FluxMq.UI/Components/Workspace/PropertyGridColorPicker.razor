@namespace FluxMq.UI.Components.Workspace
@using MudBlazor
@using MudBlazor.Utilities

<div class="property-grid-mud-color-picker">
    <MudColorPicker Value="@MudValue"
                    ValueChanged="@SetMudColorAsync"
                    ShowAlpha="true"
                    ShowColorField="true"
                    ShowInputs="true"
                    ShowModeSwitch="true"
                    ShowPreview="true"
                    ShowSliders="true"
                    ShowToolbar="true"
                    ColorPickerMode="ColorPickerMode.HEX"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Label="@PickerLabel" />
</div>

@code {
    private const string FallbackColor = "#2ed3c6";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    private MudColor MudValue => ParseColor(Value, DefaultValue);

    private string PickerLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? "Color"
        : AriaLabel;

    private async Task SetMudColorAsync(MudColor color)
        => await ValueChanged.InvokeAsync(ToPersistedColor(color));

    private static MudColor ParseColor(string? value, string? fallback)
    {
        var candidate = string.IsNullOrWhiteSpace(value) ? fallback : value;
        if (string.Equals(candidate, "transparent", StringComparison.OrdinalIgnoreCase))
        {
            candidate = "#00000000";
        }

        if (!string.IsNullOrWhiteSpace(candidate) &&
            MudColor.TryParse(candidate, out var parsed))
        {
            return parsed;
        }

        return MudColor.Parse(FallbackColor);
    }

    private static string ToPersistedColor(MudColor color)
    {
        var alpha = Convert.ToInt32(color.A);
        if (alpha >= 255)
        {
            return $"#{Convert.ToInt32(color.R):X2}{Convert.ToInt32(color.G):X2}{Convert.ToInt32(color.B):X2}";
        }

        return $"#{Convert.ToInt32(color.R):X2}{Convert.ToInt32(color.G):X2}{Convert.ToInt32(color.B):X2}{alpha:X2}";
    }
}

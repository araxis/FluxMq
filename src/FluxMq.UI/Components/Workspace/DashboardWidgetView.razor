@namespace FluxMq.UI.Components.Workspace
@inject DashboardWidgetRegistry Widgets

<div class="dashboard-widget @DashboardWidgetFormatting.WidgetClass(Widget)" style="@DashboardWidgetFormatting.WidgetStyle(Widget)">
    @if (!VisualOwnsHeader)
    {
        <div class="dashboard-widget-header">
            <div class="dashboard-widget-icon">
                <MudIcon Icon="@DashboardWidgetFormatting.WidgetIcon(Widget)" Size="Size.Small" />
            </div>
            <div class="dashboard-widget-title-block">
                <span class="dashboard-widget-title">@DashboardWidgetFormatting.WidgetTitle(Widget)</span>
                <span class="dashboard-widget-subtitle">@DashboardWidgetFormatting.WidgetSubtitle(Widget)</span>
            </div>
        </div>
    }

    @if (Module is { } module)
    {
        <DynamicComponent Type="@ComponentType" Parameters="@ComponentParameters" />
    }
    else
    {
        <DashboardUnknownWidget Type="@Widget.Type" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardWidgetSnapshot Widget { get; set; } = null!;

    [Parameter]
    public DashboardEventSnapshot? SnapshotOverride { get; set; }

    [Parameter]
    public IReadOnlyList<MqttEnvelope>? TopicMessagesOverride { get; set; }

    [Parameter]
    public DashboardMetricValue? MetricValueOverride { get; set; }

    [Parameter]
    public DashboardWidgetRenderMode Mode { get; set; } = DashboardWidgetRenderMode.Live;

    private DashboardWidgetModule? Module => Widgets.FindModule(Widget.Type);

    private Type ComponentType => Mode == DashboardWidgetRenderMode.EditCell
        ? Module!.EditCellComponent
        : Module!.LiveComponent;

    private bool VisualOwnsHeader =>
        string.Equals(Widget.Type, DashboardWidgetCatalog.KpiTileType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.StatusValueType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.EventCounterType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.EventRateType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.RateTileType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.LatestEventType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.EventTableType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.TopicActivityType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.LineChartType, StringComparison.Ordinal) ||
        string.Equals(Widget.Type, DashboardWidgetCatalog.TopicTreeType, StringComparison.Ordinal);

    private IDictionary<string, object> ComponentParameters => new Dictionary<string, object>
    {
        ["Context"] = new DashboardWidgetRenderContext(
            Project,
            Widget,
            Mode,
            SnapshotOverride,
            TopicMessagesOverride,
            MetricValueOverride)
    };
}

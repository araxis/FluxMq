@namespace FluxMq.UI.Components.Workspace

<div class="dashboard-widget @DashboardWidgetFormatting.WidgetClass(Widget)">
    <div class="dashboard-widget-header">
        <div class="dashboard-widget-icon">
            <MudIcon Icon="@DashboardWidgetFormatting.WidgetIcon(Widget)" Size="Size.Small" />
        </div>
        <div class="dashboard-widget-title-block">
            <span class="dashboard-widget-title">@DashboardWidgetFormatting.WidgetTitle(Widget)</span>
            <span class="dashboard-widget-subtitle">@DashboardWidgetFormatting.WidgetSubtitle(Widget)</span>
        </div>
    </div>

    @if (DashboardWidgetCatalog.IsTopicTreeWidget(Widget.Type))
    {
        <DashboardTopicTreeWidget Widget="@Widget" />
    }
    else
    {
        var snapshot = Project.GetDashboardEventSnapshot(Widget);
        @switch (Widget.Type)
        {
            case DashboardWidgetCatalog.KpiTileType:
            case DashboardWidgetCatalog.EventCounterType:
                <DashboardEventCounterWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.RateTileType:
            case DashboardWidgetCatalog.EventRateType:
                <DashboardEventRateWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.EventGaugeType:
                <DashboardEventGaugeWidget Widget="@Widget" Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.LineChartType:
            case DashboardWidgetCatalog.AreaChartType:
            case DashboardWidgetCatalog.BarChartType:
            case DashboardWidgetCatalog.EventChartType:
                <DashboardEventChartWidget Widget="@Widget" Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.StatusStripType:
                <DashboardStatusStripWidget Widget="@Widget" Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.DonutChartType:
            case DashboardWidgetCatalog.QosRetainBreakdownType:
                <DashboardQosRetainBreakdownWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.PayloadDistributionType:
                <DashboardPayloadDistributionWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.EventTableType:
                <DashboardEventTableWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.TopicActivityType:
                <DashboardTopicActivityWidget Snapshot="@snapshot" />
                break;
            case DashboardWidgetCatalog.LatestEventType:
                <DashboardLatestEventWidget Snapshot="@snapshot" />
                break;
            default:
                <DashboardUnknownWidget Type="@Widget.Type" />
                break;
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public FlowWorkspaceService Project { get; set; } = null!;

    [Parameter, EditorRequired]
    public DashboardWidgetSnapshot Widget { get; set; } = null!;
}

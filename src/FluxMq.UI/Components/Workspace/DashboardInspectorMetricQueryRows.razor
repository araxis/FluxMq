<PropertyGridRow Name="Metric query">
    <div class="dashboard-inspector-query-row">
        <div class="dashboard-inspector-query-preview">
            <small title="@Summary">@Summary</small>
        </div>
        <button type="button"
                class="dashboard-inspector-query-edit"
                title="@EditTitle"
                aria-label="@EditTitle"
                @onclick="@(() => Edit.InvokeAsync())">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
        </button>
    </div>
</PropertyGridRow>

@code {
    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public string EditTitle { get; set; } = "Edit metric query";

    [Parameter]
    public EventCallback Edit { get; set; }
}

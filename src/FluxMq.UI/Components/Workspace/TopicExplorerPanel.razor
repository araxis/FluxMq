    private MqttClientState ConnectionStateFor(string monitorResourceName)
    {
        var connection = Live.Connections.FirstOrDefault(connection =>
            string.Equals(connection.ResourceName, monitorResourceName, StringComparison.Ordinal));

        return connection?.State ?? MqttClientState.Disconnected;
    }

    private IReadOnlyList<ManagedConnection> BuildPublishConnections()
    {
        var projectConnections = Projects.ActiveProject?.GetConnectionResources() ?? [];
        var appConnectionOrder = projectConnections
            .Select((connection, index) => (connection.Name, Index: index))
            .ToDictionary(item => item.Name, item => item.Index, StringComparer.Ordinal);

        return Live.Connections
            .Where(connection => !LiveMqttWorkspaceService.IsTopicMonitorConnection(connection))
            .Where(connection => appConnectionOrder.ContainsKey(connection.ResourceName))
            .OrderBy(connection => appConnectionOrder.TryGetValue(connection.ResourceName, out var index)
                ? index
                : int.MaxValue)
            .ThenBy(connection => connection.ResourceName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void EnsurePublishConnectionsForActiveProject()
    {
        if (Projects.ActiveProject is not { } project)
        {
            return;
        }

        foreach (var (name, profile, subscription) in project.GetConnectionResources())
        {
            Live.AddConnectionIfAbsent(profile, subscription, name);
        }
    }

    private void EnsurePublishBrokerSelection()
    {
        var connections = PublishConnections;
        if (connections.Count == 0)
        {
            _publishConnectionId = string.Empty;
            return;
        }

        if (Guid.TryParse(_publishConnectionId, out var selectedId) &&
            connections.Any(connection => connection.Id == selectedId))
        {
            return;
        }

        var preferred = FindPublishConnectionForBroker(_selectedBrokerName) ?? connections[0];
        _publishConnectionId = preferred.Id.ToString();
    }

    private void SyncPublishSelectionFromTopicSelection(bool prefillTopic)
    {
        var connections = PublishConnections;
        if (connections.Count == 0)
        {
            _publishConnectionId = string.Empty;
            return;
        }

        var preferred = FindPublishConnectionForBroker(_selectedBrokerName) ?? connections[0];
        _publishConnectionId = preferred.Id.ToString();

        if (prefillTopic &&
            !string.IsNullOrWhiteSpace(_selectedTopic))
        {
            _publishTopic = _selectedTopic;
        }
    }

    private ManagedConnection? FindPublishConnectionForBroker(string? brokerName)
    {
        if (string.IsNullOrWhiteSpace(brokerName))
        {
            return null;
        }

        var normalizedBrokerName = brokerName.Trim();
        var connections = PublishConnections;
        var byResource = SinglePublishConnectionOrDefault(connections.Where(connection =>
            string.Equals(connection.ResourceName, normalizedBrokerName, StringComparison.Ordinal)));
        if (byResource is not null)
        {
            return byResource;
        }

        var byProfileName = SinglePublishConnectionOrDefault(connections.Where(connection =>
            string.Equals(connection.Profile.Name, normalizedBrokerName, StringComparison.Ordinal)));
        if (byProfileName is not null)
        {
            return byProfileName;
        }

        var monitor = TopicExplorerMonitorConnections.FirstOrDefault(connection =>
            string.Equals(connection.DisplayName, normalizedBrokerName, StringComparison.Ordinal));

        return monitor is null
            ? null
            : SinglePublishConnectionOrDefault(connections.Where(connection =>
                SameBrokerEndpoint(connection.Profile, monitor.Profile)));
    }

    private static ManagedConnection? SinglePublishConnectionOrDefault(IEnumerable<ManagedConnection> connections)
    {
        var matches = connections.Take(2).ToArray();
        return matches.Length == 1 ? matches[0] : null;
    }

    private static bool SameBrokerEndpoint(MqttConnectionProfile left, MqttConnectionProfile right)
        => string.Equals(left.Host, right.Host, StringComparison.OrdinalIgnoreCase) &&
           left.Port == right.Port &&
           left.UseTls == right.UseTls &&
           string.Equals(left.Username, right.Username, StringComparison.Ordinal);

    private static string PublishConnectionOptionLabel(ManagedConnection connection)
    {
        var scheme = connection.Profile.UseTls ? "mqtts" : "mqtt";
        return $"{connection.ResourceName} ({scheme}://{connection.Profile.Host}:{connection.Profile.Port})";
    }

    private async Task EnsureTopicMonitorAsync()
    {
        if (_disposed || _monitorStarting)
        {
            return;
        }

        if (!await EnsureTopicExplorerSetupAsync())
        {
            return;
        }

        var connections = BuildTopicMonitorConnections();

        if (connections.Length == 0)
        {
            return;
        }

        _monitorStarting = true;
        try
        {
            await Live.EnsureConnectionsAsync(connections).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"Topics broker monitor failed: {exception.Message}");
        }
        finally
        {
            _monitorStarting = false;
        }

        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private (string ResourceName, MqttConnectionProfile Profile, string Subscription)[] BuildTopicMonitorConnections()
        => TopicExplorerMonitorResolver.Resolve(Projects.ActiveProject)
            .Select(static connection => (
                connection.ResourceName,
                connection.Profile,
                connection.Subscription))
            .ToArray();

    private async Task<bool> EnsureTopicExplorerSetupAsync()
    {
        var active = Projects.ActiveProject;
        if (active is null ||
            active.GetExplorers().Count > 0)
        {
            return true;
        }

        var connectionResources = active.GetConnectionResources();
        if (connectionResources.Count == 0)
        {
            return true;
        }

        var candidates = TopicExplorerMonitorResolver.Resolve(
            new Dictionary<string, ExplorerDefinition>(StringComparer.Ordinal),
            connectionResources);
        if (candidates.Count == 0)
        {
            return true;
        }

        if (_setupDialogOpen ||
            ReferenceEquals(active, _setupPromptedProject))
        {
            return false;
        }

        _setupDialogOpen = true;
        _setupPromptedProject = active;
        try
        {
            var parameters = new DialogParameters
            {
                ["Candidates"] = candidates
            };
            var dialog = await DialogService.ShowAsync<TopicExplorerSetupDialog>("Topic monitors", parameters);
            var result = await dialog.Result;
            if (result is not { Canceled: false, Data: TopicExplorerSetupDialog.TopicExplorerSetupResult setup } ||
                !ReferenceEquals(active, Projects.ActiveProject))
            {
                return false;
            }

            foreach (var item in setup.Explorers)
            {
                active.UpsertExplorer(item.Name, item.Explorer);
            }

            return true;
        }
        finally
        {
            _setupDialogOpen = false;
        }
    }

    private void OnLiveChanged(object? sender, EventArgs e)
    {
        EnsurePublishBrokerSelection();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectsChanged(object? sender, EventArgs e)
    {
        SyncProjectSubscription();
        EnsurePublishConnectionsForActiveProject();
        EnsurePublishBrokerSelection();
        _ = EnsureTopicMonitorAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(object? sender, EventArgs e)
    {
        EnsurePublishConnectionsForActiveProject();
        EnsurePublishBrokerSelection();
        _ = EnsureTopicMonitorAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncProjectSubscription()
    {
        var active = Projects.ActiveProject;
        if (ReferenceEquals(active, _subscribedProject))
        {
            return;
        }

        if (_subscribedProject is not null)
        {
            _subscribedProject.Changed -= OnProjectChanged;
        }

        _subscribedProject = active;
        if (_subscribedProject is not null)
        {
            _subscribedProject.Changed += OnProjectChanged;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Live.Changed -= OnLiveChanged;
        Projects.Changed -= OnProjectsChanged;
        if (_subscribedProject is not null)
        {
            _subscribedProject.Changed -= OnProjectChanged;
        }
    }


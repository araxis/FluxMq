    private static string FormatAveragePayloadBytes(double bytes)
        => bytes <= 0
            ? "0 B"
            : FormatByteCount((long)Math.Round(bytes, MidpointRounding.AwayFromZero));

    private static string FormatByteCount(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes.ToString(CultureInfo.InvariantCulture)} B";
        }

        var kib = bytes / 1024d;
        if (kib < 1024)
        {
            return $"{kib.ToString("0.#", CultureInfo.InvariantCulture)} KB";
        }

        var mib = kib / 1024d;
        if (mib < 1024)
        {
            return $"{mib.ToString("0.#", CultureInfo.InvariantCulture)} MB";
        }

        var gib = mib / 1024d;
        return $"{gib.ToString("0.#", CultureInfo.InvariantCulture)} GB";
    }


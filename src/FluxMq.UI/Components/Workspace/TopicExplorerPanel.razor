    private async Task CopyPayloadViewAsync(PayloadInspectionResult? inspection, string view, string successMessage)
    {
        if (inspection is null)
        {
            Snackbar.Add("No payload view to copy", Severity.Info);
            return;
        }

        await Clipboard.Default.SetTextAsync(DisplayPayloadView(inspection, view));
        Snackbar.Add(successMessage, Severity.Success);
    }

    private static string DisplayPayloadView(PayloadInspectionResult? inspection, string view)
    {
        if (inspection is null)
        {
            return "No payload captured.";
        }

        return view switch
        {
            PayloadRawView => DisplayRawPayload(inspection),
            PayloadHexView => DisplayHexPayload(inspection),
            PayloadMetaView => DisplayPayloadMeta(inspection),
            _ => DisplayFormattedPayload(inspection)
        };
    }

    private static string DisplayFormattedPayload(PayloadInspectionResult inspection)
    {
        if (inspection.SizeBytes == 0)
        {
            return "Empty payload.";
        }

        if (!string.IsNullOrWhiteSpace(inspection.FormattedText))
        {
            return inspection.FormattedText;
        }

        if (inspection.IsText)
        {
            return inspection.RawText;
        }

        return string.IsNullOrWhiteSpace(inspection.HexDump)
            ? "No formatted preview available."
            : inspection.HexDump;
    }

    private static string DisplayRawPayload(PayloadInspectionResult inspection)
    {
        if (inspection.SizeBytes == 0)
        {
            return "Empty payload.";
        }

        return inspection.IsText
            ? inspection.RawText
            : "Binary payload. Use the hex view.";
    }

    private static string DisplayHexPayload(PayloadInspectionResult inspection)
        => string.IsNullOrWhiteSpace(inspection.HexDump)
            ? "Empty payload."
            : inspection.HexDump;

    private static string DisplayPayloadMeta(PayloadInspectionResult inspection)
    {
        var builder = new StringBuilder();
        builder.Append("Type: ");
        builder.AppendLine(inspection.DisplayTypeLabel);
        builder.Append("Size: ");
        builder.Append(inspection.SizeBytes);
        builder.AppendLine(" bytes");
        builder.Append("Text: ");
        builder.AppendLine(inspection.IsText ? "Yes" : "No");
        builder.Append("Metadata: ");
        builder.Append(inspection.Metadata);

        return builder.ToString();
    }


    private void ApplyMessagePublishSource(MqttEnvelope? message)
    {
        if (message is null)
        {
            Snackbar.Add("No message to load", Severity.Info);
            return;
        }

        var inspection = PayloadInspector.Inspect(message.Payload);
        if (!inspection.IsText)
        {
            Snackbar.Add("Only text payloads can be loaded into the publisher", Severity.Info);
            return;
        }

        _publishTopic = message.Topic;
        _publishPayload = inspection.RawText;
        _publishQos = message.QualityOfService;
        _publishRetain = message.Retain;

        var connection = FindPublishConnectionForBroker(BrokerLabel(message));
        if (connection is not null)
        {
            _publishConnectionId = connection.Id.ToString();
        }
    }

    private async Task PublishTopicMessageAsync()
    {
        var connection = SelectedPublishConnection;
        var topic = _publishTopic.Trim();
        if (connection is null ||
            string.IsNullOrWhiteSpace(topic))
        {
            return;
        }

        _publishBusy = true;
        try
        {
            if (connection.State != MqttClientState.Connected)
            {
                await Live.ConnectAsync(connection.Id);
            }

            var connectedConnection = PublishConnections.FirstOrDefault(item => item.Id == connection.Id);
            if (connectedConnection?.State != MqttClientState.Connected)
            {
                return;
            }

            var payload = _publishPayload ?? string.Empty;
            var published = await Live.PublishAsync(
                connectedConnection.Id,
                topic,
                payload,
                _publishQos,
                _publishRetain);

            if (published)
            {
                Projects.ActiveProject?.RecordManualMqttPublish(
                    topic,
                    payload,
                    (int)_publishQos,
                    _publishRetain,
                    connectedConnection.ResourceName);

                RecordRecentPublish(connectedConnection, topic, payload);
            }
        }
        finally
        {
            _publishBusy = false;
            StateHasChanged();
        }
    }

    private void RecordRecentPublish(ManagedConnection connection, string topic, string payload)
    {
        var payloadText = payload ?? string.Empty;
        var payloadBytes = Encoding.UTF8.GetBytes(payloadText);
        var inspection = PayloadInspector.Inspect(payloadBytes);
        var recent = new TopicRecentPublish(
            connection.ResourceName,
            PublishConnectionOptionLabel(connection),
            topic,
            payloadText,
            _publishQos,
            _publishRetain,
            DateTimeOffset.UtcNow,
            inspection.DisplayTypeLabel,
            inspection.SizeBytes);

        _recentPublishes.RemoveAll(item =>
            string.Equals(item.BrokerResourceName, recent.BrokerResourceName, StringComparison.Ordinal) &&
            string.Equals(item.Topic, recent.Topic, StringComparison.Ordinal) &&
            string.Equals(item.Payload, recent.Payload, StringComparison.Ordinal) &&
            item.QualityOfService == recent.QualityOfService &&
            item.Retain == recent.Retain);
        _recentPublishes.Insert(0, recent);
        if (_recentPublishes.Count > MaxRecentPublishes)
        {
            _recentPublishes.RemoveRange(MaxRecentPublishes, _recentPublishes.Count - MaxRecentPublishes);
        }
    }

    private void LoadRecentPublish(TopicRecentPublish publish)
    {
        var connection = PublishConnections.FirstOrDefault(connection =>
            string.Equals(connection.ResourceName, publish.BrokerResourceName, StringComparison.Ordinal));
        if (connection is not null)
        {
            _publishConnectionId = connection.Id.ToString();
        }

        _publishTopic = publish.Topic;
        _publishPayload = publish.Payload;
        _publishQos = publish.QualityOfService;
        _publishRetain = publish.Retain;
    }

    private void ClearRecentPublishes()
    {
        _recentPublishes.Clear();
    }

    private bool CanEditBrokerMonitor(TopicBrokerGroup group)
        => FindTopicMonitorConnection(group) is not null;

    private TopicExplorerMonitorConnection? FindTopicMonitorConnection(TopicBrokerGroup group)
        => TopicExplorerMonitorConnections.FirstOrDefault(connection =>
            string.Equals(connection.DisplayName, group.Name, StringComparison.Ordinal) &&
            string.Equals(connection.Endpoint, group.Endpoint, StringComparison.Ordinal));

    private async Task OpenBrokerMonitorEditorAsync(TopicBrokerGroup group)
    {
        var active = Projects.ActiveProject;
        var candidate = FindTopicMonitorConnection(group);
        if (active is null ||
            candidate is null ||
            _setupDialogOpen)
        {
            return;
        }

        var saved = false;
        _setupDialogOpen = true;
        try
        {
            var preserveExplorerName = active.GetExplorers().ContainsKey(candidate.ExplorerName);
            var parameters = new DialogParameters
            {
                ["Candidates"] = new[] { candidate },
                ["Title"] = "Edit broker monitor",
                ["SaveLabel"] = "Save changes",
                ["PreserveCandidateExplorerNames"] = preserveExplorerName
            };
            var dialog = await DialogService.ShowAsync<TopicExplorerSetupDialog>("Edit broker monitor", parameters);
            var result = await dialog.Result;
            if (result is not { Canceled: false, Data: TopicExplorerSetupDialog.TopicExplorerSetupResult setup } ||
                !ReferenceEquals(active, Projects.ActiveProject))
            {
                return;
            }

            foreach (var item in setup.Explorers)
            {
                active.UpsertExplorer(item.Name, item.Explorer);
            }

            saved = true;
        }
        finally
        {
            _setupDialogOpen = false;
        }

        if (saved)
        {
            await EnsureTopicMonitorAsync();
        }
    }


@implements IDisposable
@using System.Text
@using FluxMq.App.Definitions
@using MQTTnet.Protocol
@inject LiveMqttWorkspaceService Live
@inject ProjectManagerService Projects
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="topic-explorer">
    <section class="topic-explorer-tree" aria-label="Topic tree">
        <div class="topic-explorer-header">
            <div class="topic-explorer-title">
                <span class="topic-explorer-title-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                </span>
                <div>
                    <h2>Topics</h2>
                    <div class="topic-explorer-subtitle">@TopicSourceLabel</div>
                </div>
            </div>
            <div class="topic-explorer-stats">
                <span>@BrokerGroups.Count brokers</span>
                <span>@TopicCount topics</span>
                <span>@MessageSource.Count messages</span>
            </div>
        </div>

        @if (Live.SelectedStoredSession is not null)
        {
            <div class="topic-session-note">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                <span>@Live.SelectedStoredSession.Name</span>
                <button type="button" @onclick="@Live.ClearStoredSessionSelection">Switch to live</button>
            </div>
        }

        <div class="topic-explorer-toolbar">
            <MudTextField T="string"
                          Value="@_filter"
                          ValueChanged="@OnFilterChanged"
                          Placeholder="Search topics"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Secondary"
                          Class="topic-search" />
            @if (HasTopicSelection)
            {
                <MudTooltip Text="Clear topic selection">
                    <MudIconButton Icon="@Icons.Material.Filled.Backspace"
                                   Size="Size.Small"
                                   Class="topic-clear-button"
                                   OnClick="@ClearTopicSelection" />
                </MudTooltip>
            }
        </div>

        <div class="topic-tree-frame">
            @if (VisibleBrokerGroups.Count == 0)
            {
                <div class="topic-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
                    <strong>@TreeEmptyTitle</strong>
                    <span>@TreeEmptyText</span>
                </div>
            }
            else
            {
                @foreach (var group in VisibleBrokerGroups)
                {
                    <section class="topic-broker-group" @key="@group.Name">
                        <div class="@BrokerRowClass(group)" title="@group.Endpoint">
                            <button type="button"
                                    class="topic-broker-main"
                                    aria-label="@($"Select broker {group.Name}")"
                                    @onclick="@(() => OnBrokerSelected(group.Name))">
                                <span class="topic-broker-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                                </span>
                                <span class="topic-broker-copy">
                                    <strong>@group.Name</strong>
                                    <span>@group.Endpoint</span>
                                </span>
                            </button>
                            <span class="topic-broker-state">@BrokerStateLabel(group)</span>
                            <span class="topic-broker-count">@group.TopicCount</span>
                            @if (CanEditBrokerMonitor(group))
                            {
                                <MudTooltip Text="Broker monitor settings">
                                    <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                                   Size="Size.Small"
                                                   Class="topic-broker-edit"
                                                   aria-label="@($"Open broker monitor settings {group.Name}")"
                                                   OnClick="@(() => OpenBrokerMonitorEditorAsync(group))" />
                                </MudTooltip>
                            }
                        </div>

                        @if (group.Messages.Count == 0)
                        {
                            <div class="topic-broker-empty" role="status" aria-live="polite">
                                Waiting for messages
                            </div>
                        }
                        else
                        {
                            <div class="topic-broker-tree">
                                <TopicTreeView Messages="@group.Messages"
                                               SelectedTopic="@SelectedTopicForGroup(group.Name)"
                                               TopicSelected="@((topic) => OnTopicSelected(group.Name, topic))"
                                               Filter="@FilterForGroup(group)"
                                               EmptyMessage="@TreeEmptyMessage"
                                               Compact="true" />
                            </div>
                        }
                    </section>
                }
            }
        </div>
    </section>

    <section class="topic-explorer-detail" aria-label="Topic last state and history">
        <section class="topic-last-state" aria-label="Latest topic message">
            <div class="topic-last-header">
                <div class="topic-detail-heading">
                    <h3>@SelectedTopicLabel</h3>
                    <div class="topic-explorer-subtitle">@LastStateSubtitle</div>
                </div>
                <div class="topic-explorer-stats">
                    <span>@FilteredMessages.Count messages</span>
                    <span>@LastPayloadLabel</span>
                </div>
            </div>

            @if (LastMessage is null)
            {
                <div class="topic-no-traffic" role="status" aria-live="polite">
                    <div class="topic-no-traffic-copy">
                        <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" />
                        <strong>@MessageEmptyTitle</strong>
                        <span>@MessageEmptyText</span>
                    </div>

                    @if (NoTrafficBrokerGroups.Count > 0)
                    {
                        <div class="topic-monitor-list" aria-label="Broker monitor status">
                            @foreach (var broker in NoTrafficBrokerGroups)
                            {
                                <div class="@MonitorRowClass(broker)" @key="@broker.Name">
                                    <span class="topic-monitor-dot" aria-hidden="true"></span>
                                    <span class="topic-monitor-name" title="@broker.Name">@broker.Name</span>
                                    <span class="topic-monitor-endpoint" title="@broker.Endpoint">@broker.Endpoint</span>
                                    <span class="topic-monitor-subscription">Sub # + $SYS/#</span>
                                    <span class="topic-monitor-state">@BrokerStateLabel(broker)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="topic-last-body">
                    <div class="topic-last-payload">
                        <div class="topic-payload-header">
                            <div class="topic-payload-heading">
                                <span>Payload</span>
                                <span>@LastPayloadMeta</span>
                            </div>
                            <div class="topic-payload-controls" role="tablist" aria-label="Latest payload views">
                                @foreach (var view in PayloadViewOptions)
                                {
                                    <button type="button"
                                            role="tab"
                                            aria-selected="@IsPayloadViewActive(_lastPayloadView, view)"
                                            class="@PayloadViewButtonClass(_lastPayloadView, view)"
                                            title="@PayloadViewLabel(view)"
                                            @onclick="@(() => _lastPayloadView = view)">
                                        <MudIcon Icon="@PayloadViewIcon(view)" Size="Size.Small" />
                                        <span>@PayloadViewLabel(view)</span>
                                    </button>
                                }
                                <MudTooltip Text="Copy latest payload view">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Class="topic-payload-copy"
                                                   Disabled="@(LastInspection is null)"
                                                   aria-label="Copy latest payload view"
                                                   OnClick="@CopyLatestPayloadViewAsync" />
                                </MudTooltip>
                            </div>
                        </div>
                        <pre>@LastPayloadPreview</pre>
                    </div>

                    <div class="topic-last-meta" aria-label="Latest message metadata">
                        <div>
                            <span>Broker</span>
                            <strong title="@BrokerLabel(LastMessage)">@BrokerLabel(LastMessage)</strong>
                        </div>
                        <div>
                            <span>Topic</span>
                            <strong title="@LastMessage.Topic">@LastMessage.Topic</strong>
                        </div>
                        <div>
                            <span>Received</span>
                            <strong>@LastReceivedLabel</strong>
                        </div>
                        <div>
                            <span>QoS</span>
                            <strong>@((int)LastMessage.QualityOfService)</strong>
                        </div>
                        <div>
                            <span>Retain</span>
                            <strong>@(LastMessage.Retain ? "Yes" : "No")</strong>
                        </div>
                    </div>
                </div>
            }
        </section>

        @if (Live.SelectedStoredSession is null)
        {
            <section class="topic-publish-panel" aria-label="Publish MQTT message">
                <div class="topic-publish-header">
                    <span>Publish</span>
                    <span>@PublishConnectionLabel</span>
                </div>

                <div class="topic-publish-grid">
                    <label class="topic-publish-field broker">
                        <span class="topic-publish-label split">
                            <span>Broker</span>
                            <span>@PublishClientCountLabel</span>
                        </span>
                        @if (PublishConnections.Count > 0)
                        {
                            <select class="topic-publish-input"
                                    aria-label="Publish broker"
                                    @bind="_publishConnectionId">
                                @foreach (var connection in PublishConnections)
                                {
                                    <option value="@connection.Id.ToString()">@PublishConnectionOptionLabel(connection)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="topic-publish-static">No app brokers</div>
                        }
                    </label>

                    <label class="topic-publish-field topic">
                        <span class="topic-publish-label">Topic</span>
                        <input class="topic-publish-input"
                               value="@_publishTopic"
                               @oninput="OnPublishTopicChanged" />
                    </label>

                    <label class="topic-publish-field payload">
                        <span class="topic-publish-label split">
                            <span>Payload</span>
                            <span>@PublishPayloadMeta</span>
                        </span>
                        <textarea class="topic-publish-textarea"
                                  spellcheck="false"
                                  @bind="_publishPayload"></textarea>
                    </label>

                    <div class="topic-publish-actions">
                        <label class="topic-publish-qos" aria-label="Publish quality of service">
                            <select @bind="_publishQos">
                                <option value="@MqttQualityOfServiceLevel.AtMostOnce">QoS 0</option>
                                <option value="@MqttQualityOfServiceLevel.AtLeastOnce">QoS 1</option>
                                <option value="@MqttQualityOfServiceLevel.ExactlyOnce">QoS 2</option>
                            </select>
                        </label>

                        <button type="button"
                                class="topic-publish-retain @(_publishRetain ? "active" : null)"
                                @onclick="@(() => _publishRetain = !_publishRetain)">
                            <span>Retain</span>
                            <strong>@(_publishRetain ? "On" : "Off")</strong>
                        </button>

                        <button type="button"
                                class="topic-publish-submit"
                                disabled="@(!CanPublish)"
                                @onclick="PublishTopicMessageAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                            <span>@PublishButtonLabel</span>
                        </button>
                    </div>
                </div>
            </section>
        }

        <section class="topic-history-panel" aria-label="Topic message history">
            <div class="topic-history-header">
                <span>History</span>
                <span>@HistorySummaryLabel</span>
            </div>

            <div class="topic-history-body">
                <div class="topic-message-table">
                    <MudTable T="MqttEnvelope"
                              Items="@HistoryMessages"
                              Dense="true"
                              Hover="true"
                              Class="topic-message-grid"
                              Elevation="0"
                              FixedHeader="true"
                              Height="100%"
                              ItemSize="30"
                              OverscanCount="8"
                              SelectedItem="@SelectedHistoryMessage"
                              SelectedItemChanged="@OnHistoryMessageSelected"
                              RowClassFunc="@HistoryRowClass"
                              SelectOnRowClick="true"
                              Virtualize="true">
                        <ColGroup>
                            <col class="topic-col-time" />
                            <col class="topic-col-broker" />
                            <col class="topic-col-topic" />
                            <col class="topic-col-qos" />
                            <col class="topic-col-bytes" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>Time</MudTh>
                            <MudTh>Broker</MudTh>
                            <MudTh>Topic</MudTh>
                            <MudTh>QoS</MudTh>
                            <MudTh>Bytes</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Time">@context.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Broker">@BrokerLabel(context)</MudTd>
                            <MudTd DataLabel="Topic">
                                <MudText Typo="Typo.caption" Class="topic-cell">
                                    @context.Topic
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="QoS">@((int)context.QualityOfService)</MudTd>
                            <MudTd DataLabel="Bytes">@context.Payload.Length</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="topic-history-empty" role="status" aria-live="polite">
                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                                <span>No history for the current selection.</span>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <aside class="topic-history-detail" aria-label="Selected MQTT message details">
                    <div class="topic-history-detail-header">
                        <span>Message details</span>
                        <span>@SelectedHistoryMeta</span>
                    </div>

                    @if (SelectedHistoryMessage is null)
                    {
                        <div class="topic-history-detail-empty" role="status" aria-live="polite">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" />
                            <strong>No message selected</strong>
                            <span>Select a history row to inspect MQTT metadata and payload.</span>
                        </div>
                    }
                    else
                    {
                        <div class="topic-history-detail-body">
                            <div class="topic-history-detail-meta">
                                <div>
                                    <span>Broker</span>
                                    <strong title="@BrokerLabel(SelectedHistoryMessage)">@BrokerLabel(SelectedHistoryMessage)</strong>
                                </div>
                                <div>
                                    <span>Topic</span>
                                    <strong title="@SelectedHistoryMessage.Topic">@SelectedHistoryMessage.Topic</strong>
                                </div>
                                <div>
                                    <span>Received</span>
                                    <strong>@SelectedHistoryReceivedLabel</strong>
                                </div>
                                <div>
                                    <span>QoS</span>
                                    <strong>@((int)SelectedHistoryMessage.QualityOfService)</strong>
                                </div>
                                <div>
                                    <span>Retain</span>
                                    <strong>@(SelectedHistoryMessage.Retain ? "Yes" : "No")</strong>
                                </div>
                            </div>

                            <div class="topic-history-detail-payload">
                                <div class="topic-payload-header">
                                    <div class="topic-payload-heading">
                                        <span>Payload</span>
                                        <span>@SelectedHistoryPayloadMeta</span>
                                    </div>
                                    <div class="topic-payload-controls" role="tablist" aria-label="Selected payload views">
                                        @foreach (var view in PayloadViewOptions)
                                        {
                                            <button type="button"
                                                    role="tab"
                                                    aria-selected="@IsPayloadViewActive(_selectedHistoryPayloadView, view)"
                                                    class="@PayloadViewButtonClass(_selectedHistoryPayloadView, view)"
                                                    title="@PayloadViewLabel(view)"
                                                    @onclick="@(() => _selectedHistoryPayloadView = view)">
                                                <MudIcon Icon="@PayloadViewIcon(view)" Size="Size.Small" />
                                                <span>@PayloadViewLabel(view)</span>
                                            </button>
                                        }
                                        <MudTooltip Text="Copy selected payload view">
                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                           Size="Size.Small"
                                                           Class="topic-payload-copy"
                                                           Disabled="@(SelectedHistoryInspection is null)"
                                                           aria-label="Copy selected payload view"
                                                           OnClick="@CopySelectedHistoryPayloadViewAsync" />
                                        </MudTooltip>
                                    </div>
                                </div>
                                <pre>@SelectedHistoryPayloadPreview</pre>
                            </div>
                        </div>
                    }
                </aside>
            </div>
        </section>
    </section>
</div>

@code {
    private const string PayloadFormattedView = "formatted";
    private const string PayloadRawView = "raw";
    private const string PayloadHexView = "hex";
    private const string PayloadMetaView = "meta";
    private static readonly string[] PayloadViewOptions =
    [
        PayloadFormattedView,
        PayloadRawView,
        PayloadHexView,
        PayloadMetaView
    ];

    private bool _disposed;
    private bool _monitorStarting;
    private FlowWorkspaceService? _subscribedProject;
    private MqttEnvelope? _selectedHistoryMessage;
    private string? _selectedBrokerName;
    private string? _selectedTopic;
    private string _filter = string.Empty;
    private string _lastPayloadView = PayloadFormattedView;
    private string _selectedHistoryPayloadView = PayloadFormattedView;
    private bool _setupDialogOpen;
    private FlowWorkspaceService? _setupPromptedProject;
    private bool _publishBusy;
    private string _publishConnectionId = string.Empty;
    private string _publishTopic = "test/topic";
    private string _publishPayload = "{}";
    private MqttQualityOfServiceLevel _publishQos = MqttQualityOfServiceLevel.AtMostOnce;
    private bool _publishRetain;

    private IReadOnlyList<MqttEnvelope> MessageSource => Live.SelectedStoredSession is null
        ? Live.RecentMessages
        : Live.SelectedSessionMessages;

    private IReadOnlyList<ManagedConnection> PublishConnections => BuildPublishConnections();

    private ManagedConnection? SelectedPublishConnection
    {
        get
        {
            EnsurePublishBrokerSelection();
            return Guid.TryParse(_publishConnectionId, out var selectedId)
                ? PublishConnections.FirstOrDefault(connection => connection.Id == selectedId)
                : null;
        }
    }

    private IReadOnlyList<TopicBrokerGroup> BrokerGroups
    {
        get
        {
            var messageGroups = MessageSource
                .GroupBy(BrokerLabel, StringComparer.Ordinal)
                .ToDictionary(group => group.Key, group => (IReadOnlyList<MqttEnvelope>)group.ToArray(), StringComparer.Ordinal);

            var declaredBrokers = Live.SelectedStoredSession is null
                ? ExplorerBrokerSnapshots
                : Array.Empty<TopicBrokerSnapshot>();

            var groups = new List<TopicBrokerGroup>();
            foreach (var broker in declaredBrokers)
            {
                messageGroups.TryGetValue(broker.Name, out var messages);
                groups.Add(new TopicBrokerGroup(
                    broker.Name,
                    broker.Endpoint,
                    broker.State,
                    messages ?? Array.Empty<MqttEnvelope>()));
            }

            foreach (var (name, messages) in messageGroups.OrderBy(static group => group.Key, StringComparer.Ordinal))
            {
                if (groups.Any(group => string.Equals(group.Name, name, StringComparison.Ordinal)))
                {
                    continue;
                }

                groups.Add(new TopicBrokerGroup(
                    name,
                    "Captured messages",
                    MqttClientState.Disconnected,
                    messages));
            }

            return groups
                .OrderBy(static group => group.Name, StringComparer.Ordinal)
                .ToArray();
        }
    }

    private IReadOnlyList<TopicBrokerGroup> VisibleBrokerGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter))
            {
                return BrokerGroups;
            }

            return BrokerGroups
                .Where(group =>
                    BrokerMatchesFilter(group) ||
                    group.Messages.Any(message => message.Topic.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
                .ToArray();
        }
    }

    private IReadOnlyList<TopicBrokerSnapshot> ExplorerBrokerSnapshots
    {
        get
        {
            var projectBrokers = TopicExplorerMonitorConnections
                .Select(connection => new TopicBrokerSnapshot(
                    connection.DisplayName,
                    connection.Endpoint,
                    ConnectionStateFor(connection.ResourceName)));

            return projectBrokers
                .GroupBy(static broker => broker.Name, StringComparer.Ordinal)
                .Select(static group => group.First())
                .OrderBy(static broker => broker.Name, StringComparer.Ordinal)
                .ToArray();
        }
    }

    private IReadOnlyList<TopicExplorerMonitorConnection> TopicExplorerMonitorConnections
        => Live.SelectedStoredSession is null
            ? TopicExplorerMonitorResolver.Resolve(Projects.ActiveProject)
            : [];

    private IReadOnlyList<MqttEnvelope> FilteredMessages
    {
        get
        {
            IEnumerable<MqttEnvelope> query = MessageSource;

            if (!string.IsNullOrWhiteSpace(_selectedBrokerName))
            {
                query = query.Where(message => string.Equals(BrokerLabel(message), _selectedBrokerName, StringComparison.Ordinal));
            }

            if (!string.IsNullOrWhiteSpace(_selectedTopic))
            {
                query = query.Where(message => IsInSelectedTopic(message.Topic));
            }

            return query.ToArray();
        }
    }

    private IReadOnlyList<MqttEnvelope> HistoryMessages => FilteredMessages
        .OrderByDescending(message => message.ReceivedAt)
        .ToArray();

    private IReadOnlyList<TopicBrokerGroup> NoTrafficBrokerGroups
    {
        get
        {
            var groups = string.IsNullOrWhiteSpace(_selectedBrokerName)
                ? BrokerGroups
                : BrokerGroups
                    .Where(group => string.Equals(group.Name, _selectedBrokerName, StringComparison.Ordinal))
                    .ToArray();

            return groups
                .OrderBy(static group => group.Name, StringComparer.Ordinal)
                .Take(4)
                .ToArray();
        }
    }

    private MqttEnvelope? LastMessage => HistoryMessages.FirstOrDefault();

    private PayloadInspectionResult? LastInspection => LastMessage is null
        ? null
        : PayloadInspector.Inspect(LastMessage.Payload);

    private MqttEnvelope? SelectedHistoryMessage
    {
        get
        {
            var messages = HistoryMessages;
            if (_selectedHistoryMessage is not null &&
                messages.Contains(_selectedHistoryMessage))
            {
                return _selectedHistoryMessage;
            }

            return messages.FirstOrDefault();
        }
    }

    private PayloadInspectionResult? SelectedHistoryInspection => SelectedHistoryMessage is null
        ? null
        : PayloadInspector.Inspect(SelectedHistoryMessage.Payload);

    private int TopicCount => MessageSource
        .Select(message => $"{BrokerLabel(message)}\u001f{message.Topic}")
        .Distinct(StringComparer.Ordinal)
        .Count();

    private bool HasTopicSelection => !string.IsNullOrWhiteSpace(_selectedBrokerName) || !string.IsNullOrWhiteSpace(_selectedTopic);

    private string SelectedTopicLabel => (_selectedBrokerName, _selectedTopic) switch
    {
        (null or "", null or "") => "All brokers",
        ({ } broker, null or "") => broker,
        ({ } broker, { } topic) => $"{broker} / {topic}",
        _ => _selectedTopic ?? "All brokers"
    };

    private string LastPayloadLabel => LastMessage is { } message
        ? $"{message.Payload.Length} B"
        : "No payload";

    private string LastPayloadMeta => LastInspection is { } inspection
        ? $"{inspection.DisplayTypeLabel} / {inspection.SizeBytes} B"
        : "No payload";

    private string LastPayloadPreview => DisplayPayloadView(LastInspection, _lastPayloadView);

    private string LastReceivedLabel => LastMessage is { } message
        ? message.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")
        : "No message";

    private string SelectedHistoryMeta => SelectedHistoryInspection is { } inspection
        ? $"{inspection.DisplayTypeLabel} / {inspection.SizeBytes} B"
        : "No selection";

    private string SelectedHistoryPayloadMeta => SelectedHistoryInspection is { } inspection
        ? $"{inspection.DisplayTypeLabel} / {inspection.SizeBytes} B"
        : "No payload";

    private string SelectedHistoryPayloadPreview => DisplayPayloadView(SelectedHistoryInspection, _selectedHistoryPayloadView);

    private string SelectedHistoryReceivedLabel => SelectedHistoryMessage is { } message
        ? message.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        : "No message";

    private string HistorySummaryLabel => HistoryMessages.Count switch
    {
        0 => "No messages",
        1 => "1 message",
        var count => $"{count} messages"
    };

    private bool CanPublish =>
        !_publishBusy &&
        SelectedPublishConnection is not null &&
        !string.IsNullOrWhiteSpace(_publishTopic);

    private string PublishButtonLabel => _publishBusy ? "Publishing" : "Publish";

    private string PublishClientCountLabel => PublishConnections.Count switch
    {
        0 => "0 brokers",
        1 => "1 broker",
        var count => $"{count} brokers"
    };

    private string PublishConnectionLabel => SelectedPublishConnection is { } connection
        ? $"{connection.ResourceName} / {BrokerStateLabel(connection.State)}"
        : "No app broker";

    private string PublishPayloadMeta
    {
        get
        {
            var payload = Encoding.UTF8.GetBytes(_publishPayload ?? string.Empty);
            var inspection = PayloadInspector.Inspect(payload);
            return $"{inspection.DisplayTypeLabel} / {payload.Length} B";
        }
    }

    private string TopicSourceLabel => Live.SelectedStoredSession is null
        ? "App broker monitor"
        : "Stored session";

    private string TreeEmptyMessage => string.IsNullOrWhiteSpace(_filter)
        ? "No topics yet"
        : "No topics match your search";

    private string TreeEmptyTitle => string.IsNullOrWhiteSpace(_filter)
        ? "No topics yet"
        : "No matching topics";

    private string TreeEmptyText => string.IsNullOrWhiteSpace(_filter)
        ? "Add MQTT brokers to this app or wait for broker traffic."
        : "Clear or change the search text.";

    private string MessageEmptyTitle => (_selectedBrokerName, _selectedTopic) switch
    {
        ({ } _, { } _) => "Waiting for this topic",
        ({ } _, _) => "Waiting for this broker",
        _ => "Waiting for broker traffic"
    };

    private string MessageEmptyText => Live.SelectedStoredSession is null
        ? MonitorEmptyText
        : "Choose another broker or switch back to live.";

    private string MonitorEmptyText => BrokerGroups.Count switch
    {
        0 => "No app MQTT brokers are available for monitoring.",
        1 => "One broker monitor is subscribed to #. Topics appear when retained or live messages arrive.",
        var count => $"{count} broker monitors are subscribed to #. Topics appear when retained or live messages arrive."
    };


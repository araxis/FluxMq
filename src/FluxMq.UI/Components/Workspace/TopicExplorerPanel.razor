    private bool IsInSelectedTopic(string topic) =>
        string.IsNullOrWhiteSpace(_selectedTopic) ||
        string.Equals(topic, _selectedTopic, StringComparison.Ordinal) ||
        topic.StartsWith($"{_selectedTopic}/", StringComparison.Ordinal);

    private bool MatchesHistoryTextFilter(MqttEnvelope message)
    {
        var filter = _historyFilter.Trim();
        var receivedAt = message.ReceivedAt.ToLocalTime();
        var qosLabel = $"QoS {(int)message.QualityOfService}";
        var retainLabel = message.Retain ? "Retained" : "Not retained";
        var retainShortLabel = message.Retain ? "Yes" : "No";
        var byteCount = message.Payload.Length.ToString(CultureInfo.InvariantCulture);
        var byteLabel = $"{byteCount} B";

        return BrokerLabel(message).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               message.Topic.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               receivedAt.ToString("HH:mm:ss", CultureInfo.InvariantCulture).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               receivedAt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               qosLabel.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               ((int)message.QualityOfService).ToString(CultureInfo.InvariantCulture).Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               retainLabel.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               retainShortLabel.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               byteCount.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               byteLabel.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesHistoryQosFilter(MqttEnvelope message)
        => _historyQosFilter switch
        {
            HistoryQos0 => message.QualityOfService == MqttQualityOfServiceLevel.AtMostOnce,
            HistoryQos1 => message.QualityOfService == MqttQualityOfServiceLevel.AtLeastOnce,
            HistoryQos2 => message.QualityOfService == MqttQualityOfServiceLevel.ExactlyOnce,
            _ => true
        };

    private bool MatchesHistoryRetainFilter(MqttEnvelope message)
        => _historyRetainFilter switch
        {
            HistoryRetained => message.Retain,
            HistoryNotRetained => !message.Retain,
            _ => true
        };

    private string BrokerLabel(MqttEnvelope message)
    {
        if (!string.IsNullOrWhiteSpace(message.BrokerName))
        {
            return message.BrokerName.Trim();
        }

        var explorerBrokers = ExplorerBrokerSnapshots;
        return explorerBrokers.Count == 1
            ? explorerBrokers[0].Name
            : "Unknown broker";
    }


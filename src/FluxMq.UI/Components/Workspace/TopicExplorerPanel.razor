@implements IDisposable
@using System.Globalization
@using System.Text
@using System.Text.Json.Serialization
@using FluxMq.App.Definitions
@using MQTTnet.Protocol
@inject LiveMqttWorkspaceService Live
@inject ProjectManagerService Projects
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="topic-explorer">
    <section class="topic-explorer-tree" aria-label="Topic tree">
        <div class="topic-explorer-header">
            <div class="topic-explorer-title">
                <span class="topic-explorer-title-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" aria-hidden="true" />
                </span>
                <div>
                    <h2>Topics</h2>
                    <div class="topic-explorer-subtitle">@TopicSourceLabel</div>
                </div>
            </div>
            <div class="topic-explorer-stats">
                <span>@BrokerGroups.Count brokers</span>
                <span>@TopicCount topics</span>
                <span>@MessageSource.Count messages</span>
            </div>
        </div>

        @if (Live.SelectedStoredSession is not null)
        {
            <div class="topic-session-note">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" aria-hidden="true" />
                <span>@Live.SelectedStoredSession.Name</span>
                <MudTooltip Text="Switch to live traffic">
                    <MudIconButton Icon="@Icons.Material.Filled.Sensors"
                                   Size="Size.Small"
                                   Class="topic-session-live-button"
                                   aria-label="Switch to live traffic"
                                   OnClick="@Live.ClearStoredSessionSelection" />
                </MudTooltip>
            </div>
        }

        <div class="topic-explorer-toolbar">
            <MudTextField T="string"
                          Value="@_filter"
                          ValueChanged="@OnFilterChanged"
                          Placeholder="Search topics"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Secondary"
                          Class="topic-search" />
            @if (HasTopicSelection)
            {
                <MudTooltip Text="Clear topic selection">
                    <MudIconButton Icon="@Icons.Material.Filled.Backspace"
                                   Size="Size.Small"
                                   Class="topic-clear-button"
                                   aria-label="Clear topic selection"
                                   OnClick="@ClearTopicSelection" />
                </MudTooltip>
            }
        </div>

        <div class="topic-tree-frame">
            @if (VisibleBrokerGroups.Count == 0)
            {
                <div class="topic-empty-panel" role="status" aria-live="polite">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" aria-hidden="true" />
                    <strong>@TreeEmptyTitle</strong>
                    <span>@TreeEmptyText</span>
                </div>
            }
            else
            {
                @foreach (var group in VisibleBrokerGroups)
                {
                    <section class="topic-broker-group" @key="@group.Name">
                        <div class="@BrokerRowClass(group)" title="@group.Endpoint">
                            <button type="button"
                                    class="topic-broker-main"
                                    aria-label="@($"Select broker {group.Name}")"
                                    @onclick="@(() => OnBrokerSelected(group.Name))">
                                <span class="topic-broker-icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" aria-hidden="true" />
                                </span>
                                <span class="topic-broker-copy">
                                    <strong>@group.Name</strong>
                                    <span>@group.Endpoint</span>
                                </span>
                            </button>
                            <span class="topic-broker-connection">@BrokerConnectionLabel(group)</span>
                            <span class="topic-broker-count">@group.TopicCount</span>
                            @if (CanEditBrokerMonitor(group))
                            {
                                <MudTooltip Text="Broker monitor settings">
                                    <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                                   Size="Size.Small"
                                                   Class="topic-broker-edit"
                                                   aria-label="@($"Open broker monitor settings {group.Name}")"
                                                   OnClick="@(() => OpenBrokerMonitorEditorAsync(group))" />
                                </MudTooltip>
                            }
                        </div>

                        @if (group.Messages.Count == 0)
                        {
                            <div class="topic-broker-empty" role="status" aria-live="polite">
                                Waiting for messages
                            </div>
                        }
                        else
                        {
                            <div class="topic-broker-tree">
                                <TopicTreeView Messages="@group.Messages"
                                               SelectedTopic="@SelectedTopicForGroup(group.Name)"
                                               TopicSelected="@((topic) => OnTopicSelected(group.Name, topic))"
                                               Filter="@FilterForGroup(group)"
                                               EmptyMessage="@TreeEmptyMessage"
                                               Compact="true" />
                            </div>
                        }
                    </section>
                }
            }
        </div>
    </section>

    <section class="topic-explorer-detail" aria-label="Topic latest message and history">
        <section class="topic-latest-message" aria-label="Latest topic message">
            <div class="topic-last-header">
                <div class="topic-detail-heading">
                    <h3>@SelectedTopicLabel</h3>
                    <div class="topic-explorer-subtitle">@LatestMessageSubtitle</div>
                </div>
                <div class="topic-explorer-stats">
                    <span>@FilteredMessages.Count messages</span>
                    <span>@LastPayloadLabel</span>
                </div>
            </div>

            @if (LastMessage is null)
            {
                <div class="topic-no-traffic" role="status" aria-live="polite">
                    <div class="topic-no-traffic-copy">
                        <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" aria-hidden="true" />
                        <strong>@MessageEmptyTitle</strong>
                        <span>@MessageEmptyText</span>
                    </div>

                    @if (NoTrafficBrokerGroups.Count > 0)
                    {
                        <div class="topic-monitor-list" aria-label="Broker monitors">
                            @foreach (var broker in NoTrafficBrokerGroups)
                            {
                                <div class="@MonitorRowClass(broker)" @key="@broker.Name">
                                    <span class="topic-monitor-dot" aria-hidden="true"></span>
                                    <span class="topic-monitor-name" title="@broker.Name">@broker.Name</span>
                                    <span class="topic-monitor-endpoint" title="@broker.Endpoint">@broker.Endpoint</span>
                                    <span class="topic-monitor-subscription">Sub # + $SYS/#</span>
                                    <span class="topic-monitor-connection">@BrokerConnectionLabel(broker)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="topic-last-body">
                    <div class="topic-last-payload">
                        <div class="topic-payload-header">
                            <div class="topic-payload-heading">
                                <span>Payload</span>
                                <span>@LastPayloadMeta</span>
                            </div>
                            <div class="topic-payload-controls" role="tablist" aria-label="Latest payload views">
                                @foreach (var view in PayloadViewOptions)
                                {
                                    <button type="button"
                                            id="@LatestPayloadViewTabId(view)"
                                            role="tab"
                                            aria-selected="@IsPayloadViewActive(_lastPayloadView, view)"
                                            aria-controls="@LatestPayloadPanelId"
                                            aria-keyshortcuts="Enter Space"
                                            class="@PayloadViewButtonClass(_lastPayloadView, view)"
                                            title="@PayloadViewLabel(view)"
                                            @onclick="@(() => _lastPayloadView = view)">
                                        <MudIcon Icon="@PayloadViewIcon(view)" Size="Size.Small" aria-hidden="true" />
                                        <span>@PayloadViewLabel(view)</span>
                                    </button>
                                }
                                <MudTooltip Text="Copy latest payload view">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Small"
                                                   Class="topic-payload-copy"
                                                   Disabled="@(LastInspection is null)"
                                                   aria-label="Copy latest payload view"
                                                   OnClick="@CopyLatestPayloadViewAsync" />
                                </MudTooltip>
                            </div>
                        </div>
                        <pre id="@LatestPayloadPanelId"
                             role="tabpanel"
                             aria-labelledby="@LatestPayloadViewTabId(_lastPayloadView)"
                             tabindex="0">@LastPayloadPreview</pre>
                    </div>

                    <div class="topic-last-meta" aria-label="Latest message metadata">
                        <div>
                            <span>Broker</span>
                            <strong title="@BrokerLabel(LastMessage)">@BrokerLabel(LastMessage)</strong>
                        </div>
                        <div>
                            <span>Topic</span>
                            <strong title="@LastMessage.Topic">@LastMessage.Topic</strong>
                        </div>
                        <div>
                            <span>Received</span>
                            <strong>@LastReceivedLabel</strong>
                        </div>
                        <div>
                            <span>QoS</span>
                            <strong>@((int)LastMessage.QualityOfService)</strong>
                        </div>
                        <div>
                            <span>Retain</span>
                            <strong>@(LastMessage.Retain ? "Yes" : "No")</strong>
                        </div>
                    </div>
                </div>
            }
        </section>

        @{
            var topicStats = TopicStats;
        }
        <section class="topic-stats-panel" aria-label="Topic scope statistics">
            <div class="topic-stats-header">
                <span>Stats</span>
                <span>@TopicStatsScopeLabel</span>
            </div>

            @if (topicStats.MessageCount == 0)
            {
                <div class="topic-stats-empty" role="status" aria-live="polite">
                    No messages in this scope
                </div>
            }
            else
            {
                <div class="topic-stats-grid">
                    <div class="topic-stats-item primary">
                        <span>Messages</span>
                        <strong>@topicStats.MessageCount.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>Topics</span>
                        <strong>@topicStats.TopicCount.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>Retained</span>
                        <strong>@topicStats.RetainedCount.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>Payload</span>
                        <strong>@FormatByteCount(topicStats.TotalPayloadBytes)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>Average</span>
                        <strong>@FormatAveragePayloadBytes(topicStats.AveragePayloadBytes)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>QoS 0</span>
                        <strong>@topicStats.Qos0Count.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>QoS 1</span>
                        <strong>@topicStats.Qos1Count.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item">
                        <span>QoS 2</span>
                        <strong>@topicStats.Qos2Count.ToString(CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="topic-stats-item latest">
                        <span>Latest</span>
                        <strong>@FormatTopicStatsLatest(topicStats)</strong>
                    </div>
                </div>
            }
        </section>

        @if (Live.SelectedStoredSession is null)
        {
            <section class="topic-publish-panel" aria-label="Publish MQTT message">
                <div class="topic-publish-header">
                    <span>Publish</span>
                    <span>@PublishConnectionLabel</span>
                </div>

                <div class="topic-publish-grid">
                    <label class="topic-publish-field broker">
                        <span class="topic-publish-label split">
                            <span>Broker</span>
                            <span>@PublishClientCountLabel</span>
                        </span>
                        @if (PublishConnections.Count > 0)
                        {
                            <select class="topic-publish-input"
                                    aria-label="Publish broker"
                                    @bind="_publishConnectionId">
                                @foreach (var connection in PublishConnections)
                                {
                                    <option value="@connection.Id.ToString()">@PublishConnectionOptionLabel(connection)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="topic-publish-static">No app brokers</div>
                        }
                    </label>

                    <label class="topic-publish-field topic">
                        <span class="topic-publish-label">Topic</span>
                        <input class="topic-publish-input"
                               value="@_publishTopic"
                               @oninput="OnPublishTopicChanged" />
                    </label>

                    <label class="topic-publish-field payload">
                        <span class="topic-publish-label split">
                            <span>Payload</span>
                            <span>@PublishPayloadMeta</span>
                        </span>
                        <textarea class="topic-publish-textarea"
                                  spellcheck="false"
                                  @bind="_publishPayload"></textarea>
                    </label>

                    <div class="topic-publish-actions">
                        <label class="topic-publish-qos" aria-label="Publish quality of service">
                            <select @bind="_publishQos">
                                <option value="@MqttQualityOfServiceLevel.AtMostOnce">QoS 0</option>
                                <option value="@MqttQualityOfServiceLevel.AtLeastOnce">QoS 1</option>
                                <option value="@MqttQualityOfServiceLevel.ExactlyOnce">QoS 2</option>
                            </select>
                        </label>

                        <button type="button"
                                class="topic-publish-retain @(_publishRetain ? "active" : null)"
                                aria-label="Publish retained message"
                                aria-pressed="@(_publishRetain ? "true" : "false")"
                                @onclick="@(() => _publishRetain = !_publishRetain)">
                            <span>Retain</span>
                            <strong>@(_publishRetain ? "On" : "Off")</strong>
                        </button>

                        <button type="button"
                                class="topic-publish-submit"
                                disabled="@(!CanPublish)"
                                @onclick="PublishTopicMessageAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" aria-hidden="true" />
                            <span>@PublishButtonLabel</span>
                        </button>
                    </div>
                </div>

                <div class="topic-publish-assist" aria-label="Publish assist">
                    <div class="topic-publish-assist-actions">
                        <span class="topic-publish-assist-label">Use message</span>
                        <button type="button"
                                class="topic-publish-assist-button"
                                disabled="@(!CanUseLatestPublishSource)"
                                title='@PublishSourceHint(LastMessage, LastInspection, "latest")'
                                @onclick="@(() => ApplyMessagePublishSource(LastMessage))">
                            <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" aria-hidden="true" />
                            <span>Use latest</span>
                        </button>
                        <button type="button"
                                class="topic-publish-assist-button"
                                disabled="@(!CanUseSelectedPublishSource)"
                                title='@PublishSourceHint(SelectedHistoryMessage, SelectedHistoryInspection, "selected")'
                                @onclick="@(() => ApplyMessagePublishSource(SelectedHistoryMessage))">
                            <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" aria-hidden="true" />
                            <span>Use selected</span>
                        </button>
                    </div>

                    <div class="topic-publish-recent" aria-label="Recent publishes">
                        @if (_recentPublishes.Count == 0)
                        {
                            <div class="topic-publish-recent-empty" role="status" aria-live="polite">No recent publishes</div>
                        }
                        else
                        {
                            <div class="topic-publish-recent-list">
                                @foreach (var publish in _recentPublishes)
                                {
                                    <button type="button"
                                            class="topic-publish-recent-row"
                                            title="@RecentPublishTitle(publish)"
                                            @key="@publish.PublishedAt"
                                            @onclick="@(() => LoadRecentPublish(publish))">
                                        <strong>@publish.Topic</strong>
                                        <span>@RecentPublishMeta(publish)</span>
                                    </button>
                                }
                            </div>
                            <MudTooltip Text="Clear recent publishes">
                                <MudIconButton Icon="@Icons.Material.Filled.ClearAll"
                                               Size="Size.Small"
                                               Class="topic-publish-recent-clear"
                                               aria-label="Clear recent publishes"
                                               OnClick="@ClearRecentPublishes" />
                            </MudTooltip>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="topic-history-panel" aria-label="Topic message history">
            <div class="topic-history-header">
                <span>History</span>
                <span>@HistorySummaryLabel</span>
            </div>

            <div class="topic-history-toolbar" role="search" aria-label="History filters">
                <MudTextField T="string"
                              Value="@_historyFilter"
                              ValueChanged="@OnHistoryFilterChanged"
                              Placeholder="Filter history"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Secondary"
                              Class="topic-history-filter" />

                <label class="topic-history-select" aria-label="Filter history quality of service">
                    <select @bind="HistoryQosFilter">
                        <option value="@HistoryFilterAll">All</option>
                        <option value="@HistoryQos0">QoS 0</option>
                        <option value="@HistoryQos1">QoS 1</option>
                        <option value="@HistoryQos2">QoS 2</option>
                    </select>
                </label>

                <label class="topic-history-select" aria-label="Filter history retain state">
                    <select @bind="HistoryRetainFilter">
                        <option value="@HistoryFilterAll">All</option>
                        <option value="@HistoryRetained">Retained</option>
                        <option value="@HistoryNotRetained">Not retained</option>
                    </select>
                </label>

                @if (HasHistoryFilters)
                {
                    <MudTooltip Text="Reset history filters">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                       Size="Size.Small"
                                       Class="topic-history-action"
                                       aria-label="Reset history filters"
                                       OnClick="@ResetHistoryFilters" />
                    </MudTooltip>
                }

                <MudTooltip Text="@ExportHistoryLabel">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                   Size="Size.Small"
                                   Class="topic-history-action export"
                                   Disabled="@(!CanExportHistory)"
                                   aria-label="Export visible history as JSON"
                                   OnClick="@ExportVisibleHistoryAsync" />
                </MudTooltip>
            </div>

            <div class="topic-history-body">
                <div class="topic-message-table">
                    <MudTable T="MqttEnvelope"
                              Items="@VisibleHistoryMessages"
                              Dense="true"
                              Hover="true"
                              Class="topic-message-grid"
                              Elevation="0"
                              FixedHeader="true"
                              Height="100%"
                              ItemSize="30"
                              OverscanCount="8"
                              SelectedItem="@SelectedHistoryMessage"
                              SelectedItemChanged="@OnHistoryMessageSelected"
                              RowClassFunc="@HistoryRowClass"
                              SelectOnRowClick="true"
                              Virtualize="true">
                        <ColGroup>
                            <col class="topic-col-time" />
                            <col class="topic-col-broker" />
                            <col class="topic-col-topic" />
                            <col class="topic-col-qos" />
                            <col class="topic-col-retain" />
                            <col class="topic-col-bytes" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>Time</MudTh>
                            <MudTh>Broker</MudTh>
                            <MudTh>Topic</MudTh>
                            <MudTh>QoS</MudTh>
                            <MudTh>Retain</MudTh>
                            <MudTh>Bytes</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Time">@context.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Broker">@BrokerLabel(context)</MudTd>
                            <MudTd DataLabel="Topic">
                                <MudText Typo="Typo.caption" Class="topic-cell">
                                    @context.Topic
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="QoS">@((int)context.QualityOfService)</MudTd>
                            <MudTd DataLabel="Retain">@(context.Retain ? "Yes" : "No")</MudTd>
                            <MudTd DataLabel="Bytes">@context.Payload.Length</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="topic-history-empty" role="status" aria-live="polite">
                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" aria-hidden="true" />
                                <span>No history for the current selection.</span>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <aside class="topic-history-detail" aria-label="Selected MQTT message details">
                    <div class="topic-history-detail-header">
                        <span>Message details</span>
                        <span>@SelectedHistoryMeta</span>
                    </div>

                    @if (SelectedHistoryMessage is null)
                    {
                        <div class="topic-history-detail-empty" role="status" aria-live="polite">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" aria-hidden="true" />
                            <strong>No message selected</strong>
                            <span>Select a history row to inspect MQTT metadata and payload.</span>
                        </div>
                    }
                    else
                    {
                        <div class="topic-history-detail-body">
                            <div class="topic-history-detail-meta">
                                <div>
                                    <span>Broker</span>
                                    <strong title="@BrokerLabel(SelectedHistoryMessage)">@BrokerLabel(SelectedHistoryMessage)</strong>
                                </div>
                                <div>
                                    <span>Topic</span>
                                    <strong title="@SelectedHistoryMessage.Topic">@SelectedHistoryMessage.Topic</strong>
                                </div>
                                <div>
                                    <span>Received</span>
                                    <strong>@SelectedHistoryReceivedLabel</strong>
                                </div>
                                <div>
                                    <span>QoS</span>
                                    <strong>@((int)SelectedHistoryMessage.QualityOfService)</strong>
                                </div>
                                <div>
                                    <span>Retain</span>
                                    <strong>@(SelectedHistoryMessage.Retain ? "Yes" : "No")</strong>
                                </div>
                            </div>

                            <div class="topic-history-detail-payload">
                                <div class="topic-payload-header">
                                    <div class="topic-payload-heading">
                                        <span>Payload</span>
                                        <span>@SelectedHistoryPayloadMeta</span>
                                    </div>
                                    <div class="topic-payload-controls" role="tablist" aria-label="Selected payload views">
                                        @foreach (var view in SelectedPayloadViewOptions)
                                        {
                                            <button type="button"
                                                    id="@SelectedPayloadViewTabId(view)"
                                                    role="tab"
                                                    aria-selected="@IsPayloadViewActive(_selectedHistoryPayloadView, view)"
                                                    aria-controls="@SelectedPayloadPanelId"
                                                    aria-keyshortcuts="Enter Space"
                                                    class="@PayloadViewButtonClass(_selectedHistoryPayloadView, view)"
                                                    title="@PayloadViewLabel(view)"
                                                    @onclick="@(() => _selectedHistoryPayloadView = view)">
                                                <MudIcon Icon="@PayloadViewIcon(view)" Size="Size.Small" aria-hidden="true" />
                                                <span>@PayloadViewLabel(view)</span>
                                            </button>
                                        }
                                        <MudTooltip Text="Copy selected payload view">
                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                           Size="Size.Small"
                                                           Class="topic-payload-copy"
                                                           Disabled="@(SelectedHistoryInspection is null)"
                                                           aria-label="Copy selected payload view"
                                                           OnClick="@CopySelectedHistoryPayloadViewAsync" />
                                        </MudTooltip>
                                    </div>
                                </div>
                                <pre id="@SelectedPayloadPanelId"
                                     role="tabpanel"
                                     aria-labelledby="@SelectedPayloadViewTabId(_selectedHistoryPayloadView)"
                                     tabindex="0">@SelectedHistoryPayloadPreview</pre>
                            </div>
                        </div>
                    }
                </aside>
            </div>
        </section>
    </section>
</div>

@code {
    private const string PayloadFormattedView = "formatted";
    private const string PayloadRawView = "raw";
    private const string PayloadHexView = "hex";
    private const string PayloadMetaView = "meta";
    private const string PayloadDiffView = "diff";
    private const string LatestPayloadPanelId = "topic-latest-payload-panel";
    private const string SelectedPayloadPanelId = "topic-selected-payload-panel";
    private const int PayloadDiffContextLineCount = 2;
    private const int PayloadDiffMaxChangedLines = 80;
    private const int MaxRecentPublishes = 6;
    private const string HistoryFilterAll = "all";
    private const string HistoryQos0 = "0";
    private const string HistoryQos1 = "1";
    private const string HistoryQos2 = "2";
    private const string HistoryRetained = "retained";
    private const string HistoryNotRetained = "not-retained";
    private static readonly string[] PayloadViewOptions =
    [
        PayloadFormattedView,
        PayloadRawView,
        PayloadHexView,
        PayloadMetaView
    ];
    private static readonly string[] SelectedPayloadViewOptions =
    [
        PayloadFormattedView,
        PayloadRawView,
        PayloadHexView,
        PayloadMetaView,
        PayloadDiffView
    ];
    private static readonly JsonSerializerOptions HistoryExportJsonOptions = new(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented = true
    };

    private bool _disposed;
    private bool _monitorStarting;
    private FlowWorkspaceService? _subscribedProject;
    private MqttEnvelope? _selectedHistoryMessage;
    private string? _selectedBrokerName;
    private string? _selectedTopic;
    private string _filter = string.Empty;
    private string _historyFilter = string.Empty;
    private string _historyQosFilter = HistoryFilterAll;
    private string _historyRetainFilter = HistoryFilterAll;
    private string _lastPayloadView = PayloadFormattedView;
    private string _selectedHistoryPayloadView = PayloadFormattedView;
    private bool _setupDialogOpen;
    private FlowWorkspaceService? _setupPromptedProject;
    private bool _publishBusy;

    private TopicScopeStats BuildTopicScopeStats(IReadOnlyList<MqttEnvelope> messages)
    {
        if (messages.Count == 0)
        {
            return TopicScopeStats.Empty;
        }

        var totalPayloadBytes = messages.Sum(static message => (long)message.Payload.Length);
        return new TopicScopeStats(
            messages.Count,
            messages
                .Select(message => $"{BrokerLabel(message)}\u001f{message.Topic}")
                .Distinct(StringComparer.Ordinal)
                .Count(),
            messages.Count(static message => message.Retain),
            totalPayloadBytes,
            (double)totalPayloadBytes / messages.Count,
            messages.Count(static message => message.QualityOfService == MqttQualityOfServiceLevel.AtMostOnce),
            messages.Count(static message => message.QualityOfService == MqttQualityOfServiceLevel.AtLeastOnce),
            messages.Count(static message => message.QualityOfService == MqttQualityOfServiceLevel.ExactlyOnce),
            messages.Max(static message => message.ReceivedAt));
    }


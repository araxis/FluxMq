    private async Task ExportVisibleHistoryAsync()
    {
        var messages = VisibleHistoryMessages;
        if (messages.Count == 0)
        {
            Snackbar.Add("No history rows to export", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<SaveAsDialog>(
            "Export history",
            new DialogParameters
            {
                [nameof(SaveAsDialog.SuggestedPath)] = SuggestedHistoryExportPath(),
                [nameof(SaveAsDialog.DialogTitle)] = "Export history",
                [nameof(SaveAsDialog.HelperText)] = "Full path including .json extension",
                [nameof(SaveAsDialog.SubmitText)] = "Export"
            },
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false
            });

        var dialogResult = await dialog.Result;
        if (dialogResult is not { Canceled: false, Data: string path } ||
            string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        try
        {
            await WriteHistoryExportAsync(BuildHistoryExportJson(messages), path);
            Snackbar.Add("History export saved", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"History export failed: {exception.Message}", Severity.Error);
        }
    }

    private string BuildHistoryExportJson(IReadOnlyList<MqttEnvelope> messages)
    {
        var rows = messages.Select(message =>
        {
            var inspection = PayloadInspector.Inspect(message.Payload);
            return new
            {
                broker = BrokerLabel(message),
                topic = message.Topic,
                receivedAt = message.ReceivedAt,
                qos = (int)message.QualityOfService,
                retain = message.Retain,
                payloadByteCount = message.Payload.Length,
                payloadType = inspection.DisplayTypeLabel,
                payloadBase64 = Convert.ToBase64String(message.Payload),
                payloadText = inspection.IsText ? inspection.RawText : null,
                payloadHex = inspection.HexDump
            };
        });

        return JsonSerializer.Serialize(rows, HistoryExportJsonOptions);
    }

    private string SuggestedHistoryExportPath()
    {
        var currentFilePath = Projects.ActiveProject?.CurrentFilePath;
        var directory = !string.IsNullOrWhiteSpace(currentFilePath)
            ? Path.GetDirectoryName(currentFilePath)
            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "FluxMQ");
        var stamp = DateTimeOffset.Now.ToString("yyyyMMdd-HHmmss", CultureInfo.InvariantCulture);

        return Path.Combine(directory ?? string.Empty, $"topics-history-{stamp}.json");
    }

    private static async Task WriteHistoryExportAsync(string content, string path)
    {
        var fullPath = Path.GetFullPath(path);
        var directory = Path.GetDirectoryName(fullPath);
        if (!string.IsNullOrWhiteSpace(directory))
        {
            Directory.CreateDirectory(directory);
        }

        await File.WriteAllTextAsync(fullPath, content);
    }


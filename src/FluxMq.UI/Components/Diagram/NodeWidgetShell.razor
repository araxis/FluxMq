@*
    Per-type widget shell. Concrete widgets pass:
        Body     = the read-only view face
        Editor   = the edit content shown inside a MudDialog (optional).
                   When absent the dialog still lets the user rename the node.

    Common chrome (selection state, expand/collapse, activity badge, ports) lives
    here so widgets stay focused on their content.
*@
@using FluxMq.UI.Components.Workspace.Dialogs
@using FluxMq.UI.Models
@using FluxMq.UI.Services
@inject IDialogService DialogService

<div class="flow-node @(Node.Selected ? "flow-node-selected" : null) @(Node.IsCollapsed ? "flow-node-collapsed" : null) @DiagnosticClass">
    <div class="flow-node-header">
        <MudIconButton Size="Size.Small"
                       Icon="@(Node.IsCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                       OnClick="@(() => Node.Toggle())" />
        <MudIcon Icon="@HeaderIcon" Color="@CategoryColor" Size="Size.Small" Class="me-2" />
        <div class="flow-node-title">
            <MudText Typo="Typo.subtitle2">@Node.NodeName</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Node.DisplayName</MudText>
        </div>
        <MudTooltip Text="Edit settings">
            <MudIconButton Size="Size.Small"
                           Icon="@Icons.Material.Filled.Edit"
                           OnClick="@OpenEditDialogAsync" />
        </MudTooltip>
        @if (Node.PrimaryDiagnostic is { } diagnostic)
        {
            <MudTooltip Text="@DiagnosticTooltip">
                <MudIcon Icon="@DiagnosticIcon(diagnostic)"
                         Color="@DiagnosticColor(diagnostic)"
                         Size="Size.Small"
                         Class="flow-node-diagnostic-icon" />
            </MudTooltip>
        }
        <MudChip T="string" Size="Size.Small" Color="@CategoryColor">@Node.Category</MudChip>
    </div>

    @if (!Node.IsCollapsed)
    {
        <MudDivider Class="my-2" />
        @if (!string.IsNullOrWhiteSpace(Node.ActivityText))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                @Node.ActivityText
            </MudAlert>
        }
        @Body
    }
    else if (!string.IsNullOrWhiteSpace(Node.ActivityText))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Node.ActivityText</MudText>
    }

    @if (Node.PortDescriptors.Count > 0)
    {
        <div class="flow-node-port-list">
            @foreach (var descriptor in Node.PortDescriptors.OrderBy(PortSortKey).ThenBy(p => p.IsInput ? 0 : 1).ThenBy(p => p.Name))
            {
                var leftPort = Node.Ports.OfType<FlowPortModel>()
                    .FirstOrDefault(p => p.Alignment == PortAlignment.Left && p.PortName == descriptor.Name);
                var rightPort = Node.Ports.OfType<FlowPortModel>()
                    .FirstOrDefault(p => p.Alignment == PortAlignment.Right && p.PortName == descriptor.Name);

                <div class="flow-port-row">
                    <div class="flow-port-side flow-port-side-left">
                        @if (leftPort is not null)
                        {
                            <PortRenderer @key="leftPort"
                                          Port="leftPort"
                                          Class="@PortClass(descriptor.IsInput, leftPort)">
                                <FluxPortWidget Port="leftPort" IsInput="@descriptor.IsInput" />
                            </PortRenderer>
                        }
                    </div>
                    <span class="flow-port-name @PortLabelClass(descriptor)">
                        @descriptor.Name
                    </span>
                    <div class="flow-port-side flow-port-side-right">
                        @if (rightPort is not null)
                        {
                            <PortRenderer @key="rightPort"
                                          Port="rightPort"
                                          Class="@PortClass(descriptor.IsInput, rightPort)">
                                <FluxPortWidget Port="rightPort" IsInput="@descriptor.IsInput" />
                            </PortRenderer>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Fallback port renderers for nodes without descriptors. *@
    @if (Node.PortDescriptors.Count == 0)
    {
        @foreach (var port in Node.Ports)
        {
            <PortRenderer @key="port" Port="port">
                <FluxPortWidget Port="port" />
            </PortRenderer>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public FlowDiagramNodeModel Node { get; set; } = null!;
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>
    /// Widget-specific editor content rendered inside the edit dialog.
    /// When null the dialog still allows renaming the node.
    /// </summary>
    [Parameter] public RenderFragment? Editor { get; set; }

    [Parameter] public string HeaderIcon { get; set; } = Icons.Material.Filled.Memory;
    [Parameter] public Color CategoryColor { get; set; } = Color.Default;

    /// <summary>Called before the dialog closes with Save, so the widget can flush its draft state.</summary>
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Called when the dialog is cancelled so the widget can discard its draft state.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Max width of the edit dialog — defaults to Small; use Medium for complex editors.</summary>
    [Parameter] public MaxWidth EditDialogMaxWidth { get; set; } = MaxWidth.Small;

    [CascadingParameter] private FlowWorkspaceService? Flow { get; set; }
    [CascadingParameter] private BlazorDiagram? Diagram { get; set; }

    private bool _lastCollapsedState;

    private string? DiagnosticClass => Node.PrimaryDiagnostic is { } diagnostic
        ? $"flow-node-diagnostic-{diagnostic.Severity.ToLowerInvariant()}"
        : null;

    private string DiagnosticTooltip => string.Join(Environment.NewLine, Node.Diagnostics.Select(FormatDiagnostic));

    private static string PortClass(bool isInput, FlowPortModel port)
        => isInput ? "port-input" : "port-output";

    private static int PortSortKey(ComponentPortDescriptor descriptor)
        => IsErrorPort(descriptor) ? 1 : 0;

    private static string PortLabelClass(ComponentPortDescriptor descriptor)
    {
        if (IsErrorPort(descriptor))
        {
            return "flow-port-error";
        }

        return descriptor.IsInput ? "flow-port-input" : "flow-port-output";
    }

    private static bool IsErrorPort(ComponentPortDescriptor descriptor)
        => string.Equals(descriptor.Name, "Errors", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(descriptor.Name, "FlowErrors", StringComparison.OrdinalIgnoreCase) ||
           string.Equals(descriptor.ValueType, "FlowError", StringComparison.OrdinalIgnoreCase);

    private static string DiagnosticIcon(WorkspaceDiagnostic diagnostic)
        => diagnostic.Severity switch
        {
            "Error" => Icons.Material.Filled.ErrorOutline,
            "Warning" => Icons.Material.Filled.WarningAmber,
            "Info" => Icons.Material.Filled.Info,
            _ => Icons.Material.Filled.Info
        };

    private static Color DiagnosticColor(WorkspaceDiagnostic diagnostic)
        => diagnostic.Severity switch
        {
            "Error" => Color.Error,
            "Warning" => Color.Warning,
            "Info" => Color.Info,
            _ => Color.Default
        };

    private static string FormatDiagnostic(WorkspaceDiagnostic diagnostic)
        => string.IsNullOrWhiteSpace(diagnostic.PortName)
            ? $"{diagnostic.Code}: {diagnostic.Message}"
            : $"{diagnostic.Code} ({diagnostic.PortName}): {diagnostic.Message}";

    protected override void OnInitialized()
    {
        _lastCollapsedState = Node.IsCollapsed;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && Node.IsCollapsed != _lastCollapsedState)
        {
            _lastCollapsedState = Node.IsCollapsed;
            _ = ReinitializePortsAsync();
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// Resets port measurement state after a collapse/expand so the library
    /// re-queries getBoundingClientRect. A second pass (after one frame) then
    /// forces all connected links to re-route using the freshly measured positions.
    /// </summary>
    private async Task ReinitializePortsAsync()
    {
        // Pass 1: mark all ports as un-measured so PortRenderer will re-read the DOM.
        foreach (var port in Node.Ports)
        {
            port.Initialized = false;
            port.Refresh();
        }

        // Wait one frame for Blazor to re-render PortRenderers and let the async
        // JS getBoundingClientRect calls complete.
        await Task.Delay(60);

        // Pass 2: force the diagram to re-route every link that touches this node.
        await InvokeAsync(() =>
        {
            Node.RefreshAll();
            Diagram?.Refresh();
        });
    }

    private async Task OpenEditDialogAsync()
    {
        Node.SetCollapsed(false);

        var parameters = new DialogParameters
        {
            [nameof(NodeEditDialog.NodeDisplayName)] = Node.DisplayName,
            [nameof(NodeEditDialog.NodeId)] = Node.NodeName,
            [nameof(NodeEditDialog.WorkflowName)] = Flow?.ActiveWorkflowName ?? string.Empty,
            [nameof(NodeEditDialog.CategoryColor)] = CategoryColor,
            [nameof(NodeEditDialog.EditorContent)] = Editor,
            [nameof(NodeEditDialog.OnSave)] = OnSave,
            [nameof(NodeEditDialog.OnCancel)] = OnCancel,
            [nameof(NodeEditDialog.Flow)] = Flow
        };

        var options = new DialogOptions
        {
            MaxWidth = EditDialogMaxWidth,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<NodeEditDialog>(Node.DisplayName, parameters, options);
    }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject AppThemeService ThemeService
@inject ProjectManagerService Projects
@inject LiveMqttWorkspaceService Live
@inject DragStateService DragState

<MudThemeProvider Theme="@_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="@ShellClass"
     @onpointermove="HandleShellPointerMove"
     @onpointerup="HandleShellPointerUp"
     @onpointercancel="HandleShellPointerCancel">
    <header class="flux-topbar">
        <div class="flux-brand">
            <span class="flux-brand-mark" aria-hidden="true"></span>
            <span class="flux-brand-name">FluxMQ</span>
        </div>

        <nav class="flux-breadcrumb" aria-label="Current workspace">
            <span>Workspace</span>
            <span class="flux-breadcrumb-separator">/</span>
            <span class="flux-breadcrumb-current">@(Projects.ActiveProject?.Name ?? "No app open")</span>
        </nav>

        <div class="flux-toolbar">
            <MudTooltip Text="New project">
                <MudIconButton Icon="@Icons.Material.Filled.NoteAdd"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               Disabled="@_busy"
                               OnClick="@NewProject" />
            </MudTooltip>
            <MudTooltip Text="Open file">
                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               Disabled="@_busy"
                               OnClick="@OpenAsync" />
            </MudTooltip>
            <MudTooltip Text="Save">
                <MudIconButton Icon="@Icons.Material.Filled.Save"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               Disabled="@(_busy || Projects.ActiveProject is null)"
                               OnClick="@SaveAsync" />
            </MudTooltip>
            <MudTooltip Text="Save as">
                <MudIconButton Icon="@Icons.Material.Filled.SaveAs"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               Disabled="@(_busy || Projects.ActiveProject is null)"
                               OnClick="@SaveAsAsync" />
            </MudTooltip>

            <span class="flux-toolbar-divider"></span>

            <MudTooltip Text="Validate app">
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FactCheck"
                           Class="flux-command-button"
                           Disabled="@(!CanValidateActiveProject)"
                           OnClick="@ValidateActiveAsync">Validate</MudButton>
            </MudTooltip>
            <MudTooltip Text="Run app">
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Class="flux-command-button"
                           Disabled="@(!CanRunActiveProject)"
                           OnClick="@RunActiveAsync">Run</MudButton>
            </MudTooltip>
            <MudTooltip Text="Stop app">
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@StopButtonIcon"
                           Class="flux-command-button"
                           Disabled="@(!CanStopActiveProject)"
                           OnClick="@StopActiveAsync">
                    @if (_stopping)
                    {
                        <span class="flux-command-loading">
                            <MudIcon Icon="@Icons.Material.Filled.Sync"
                                     Size="Size.Small"
                                     Class="flux-command-spin-icon" />
                            <span>Stop</span>
                        </span>
                    }
                    else
                    {
                        <span>Stop</span>
                    }
                </MudButton>
            </MudTooltip>

            <MudTooltip Text="@ActiveProjectStateTooltip">
                <div class="@FlowStateClass">
                    <span class="flux-flow-dot"></span>
                    <span>@ActiveProjectStateLabel</span>
                </div>
            </MudTooltip>

            <span class="flux-toolbar-divider"></span>

            <div class="@RunStateClass">
                <span class="flux-run-dot"></span>
                <span>@Live.State</span>
            </div>

            <MudTooltip Text="@_themeLabel">
                <MudIconButton Icon="@_themeIcon"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               OnClick="@CycleTheme" />
            </MudTooltip>
            <MudTooltip Text="@(_rightOpen ? "Hide inspector" : "Show inspector")">
                <MudIconButton Icon="@(_rightOpen ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                               Size="Size.Small"
                               Class="flux-icon-button"
                               OnClick="@(() => _rightOpen = !_rightOpen)" />
            </MudTooltip>
        </div>
    </header>

    <aside class="flux-rail" aria-label="Workspace navigation">
        <MudTooltip Text="Explorer" Placement="Placement.Right">
            <button type="button"
                    class="flux-rail-button @(_railTab == ExplorerRailTab ? "active" : null)"
                    @onclick="@(() => { _railTab = ExplorerRailTab; _leftOpen = true; })">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            </button>
        </MudTooltip>
        <MudTooltip Text="Sessions" Placement="Placement.Right">
            <button type="button"
                    class="flux-rail-button @(_railTab == SessionsRailTab ? "active" : null)"
                    @onclick="@(() => { _railTab = SessionsRailTab; _leftOpen = true; })">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
            </button>
        </MudTooltip>
        <div class="flux-rail-spacer"></div>
        <MudTooltip Text="@(_leftOpen ? "Collapse panel" : "Expand panel")" Placement="Placement.Right">
            <button type="button" class="flux-rail-button" @onclick="@(() => _leftOpen = !_leftOpen)">
                <MudIcon Icon="@(_leftOpen ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
            </button>
        </MudTooltip>
    </aside>

    @if (_leftOpen)
    {
        <aside class="flux-side-panel flux-left-panel">
            <div class="flux-panel-header">
                <div>
                    <div class="flux-panel-kicker">FluxMQ</div>
                    <div class="flux-panel-title">@LeftPanelTitle</div>
                </div>
            </div>
            <div class="flux-panel-body">
                @if (_railTab == ExplorerRailTab)
                {
                    <AppTreePanel />
                }
                else
                {
                    <SessionPanel />
                }
            </div>
        </aside>
    }

    <main class="flux-main-canvas">
        @Body
    </main>

    @if (_rightOpen)
    {
        <aside class="flux-side-panel flux-right-panel">
            <LiveInspectorPanel />
        </aside>
    }

    <footer class="flux-statusbar">
        <div class="flux-status-group">
            <span class="@StatusDotClass"></span>
            <span>@Live.State</span>
            @if (Live.Connections.Count > 0)
            {
                <span class="flux-status-muted">@Live.Connections.Count connections</span>
            }
        </div>
        <div class="flux-status-path">
            @if (Projects.ActiveProject is { } active)
            {
                @(string.IsNullOrEmpty(active.CurrentFilePath) ? "Untitled project" : active.CurrentFilePath)
            }
            else
            {
                <span>No active project</span>
            }
        </div>
        <div class="flux-status-group right">
            <span>@Live.RecentMessages.Count messages</span>
        </div>
    </footer>
</div>

@if (DragState.ActiveComponentDrag is { DidDrag: true } activeDrag)
{
    <div class="@DragPreviewClass" style="@DragPreviewStyle">
        <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Small" />
        <span>@activeDrag.DisplayName</span>
    </div>
}

@code {
    private const int ExplorerRailTab = 0;
    private const int SessionsRailTab = 1;

    private bool _leftOpen = true;
    private bool _rightOpen = true;
    private bool _busy;
    private bool _stopping;
    private int _railTab;
    private readonly HashSet<FlowWorkspaceService> _subscribedProjects = [];

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F766E",
            Secondary = "#2563EB",
            Tertiary = "#D97706",
            Info = "#2563EB",
            Success = "#059669",
            Warning = "#D97706",
            Error = "#DC2626",
            Background = "#F4F6F8",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            LinesDefault = "#DDE3EA",
            LinesInputs = "#CBD5E1",
            TextPrimary = "#111827",
            TextSecondary = "#526174"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#2DD4BF",
            Secondary = "#60A5FA",
            Tertiary = "#FBBF24",
            Info = "#60A5FA",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            Background = "#0A0D12",
            Surface = "#11151C",
            DrawerBackground = "#11151C",
            LinesDefault = "#1D232E",
            LinesInputs = "#2A313D",
            TextPrimary = "#E8ECF2",
            TextSecondary = "#A0A8B4"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Geist", "Segoe UI", "Roboto", "Arial", "sans-serif"],
                FontSize = "13px",
                LineHeight = "1.4"
            }
        }
    };

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
        Projects.Changed += OnChanged;
        Live.Changed += OnChanged;
        DragState.Changed += OnChanged;
        SyncProjectSubscriptions();
    }

    private string ShellClass =>
        $"flux-shell {(ThemeService.IsDarkMode ? "flux-theme-dark" : "flux-theme-light")}{(!_leftOpen ? " left-collapsed" : "")}{(!_rightOpen ? " right-collapsed" : "")}{(DragState.ActiveComponentDrag?.DidDrag == true ? " flux-component-drag-active" : "")}";

    private string DragPreviewClass =>
        $"flux-drag-preview {(DragState.ActiveComponentDrag?.IsOverDesigner == true ? "over-designer" : null)}";

    private string DragPreviewStyle => DragState.ActiveComponentDrag is { } activeDrag
        ? $"left:{activeDrag.ClientX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px;top:{activeDrag.ClientY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px;"
        : string.Empty;


    private string LeftPanelTitle => _railTab switch
    {
        SessionsRailTab => "Sessions",
        _ => "Explorer"
    };

    private string RunStateClass => Live.State switch
    {
        MqttSessionState.Connected => "flux-runstate live",
        MqttSessionState.Connecting or MqttSessionState.Reconnecting => "flux-runstate pending",
        MqttSessionState.Faulted => "flux-runstate faulted",
        _ => "flux-runstate"
    };

    private string FlowStateClass => Projects.ActiveProject?.State switch
    {
        RuntimeWorkspaceState.Valid => "flux-flowstate valid",
        RuntimeWorkspaceState.Running => "flux-flowstate running",
        RuntimeWorkspaceState.Faulted => "flux-flowstate faulted",
        RuntimeWorkspaceState.Stopped => "flux-flowstate stopped",
        _ => "flux-flowstate"
    };

    private string ActiveProjectStateLabel => Projects.ActiveProject is null
        ? "No app"
        : Projects.ActiveProject.State switch
        {
            RuntimeWorkspaceState.Valid => "App valid",
            RuntimeWorkspaceState.Running => "App running",
            RuntimeWorkspaceState.Faulted => "App faulted",
            RuntimeWorkspaceState.Stopped => "App stopped",
            _ => "App idle"
        };

    private string ActiveProjectStateTooltip
    {
        get
        {
            var project = Projects.ActiveProject;
            if (project is null) return "No active app";

            var errors = project.Diagnostics.Count(d => string.Equals(d.Severity, "Error", StringComparison.Ordinal));
            var warnings = project.Diagnostics.Count(d => string.Equals(d.Severity, "Warning", StringComparison.Ordinal));
            return errors > 0 || warnings > 0
                ? $"{project.State}: {errors} errors, {warnings} warnings"
                : $"App runtime state: {project.State}";
        }
    }

    private bool ActiveProjectIsRunning => Projects.ActiveProject?.State == RuntimeWorkspaceState.Running;
    private bool CanValidateActiveProject => !_busy && Projects.ActiveProject is not null && !ActiveProjectIsRunning;
    private bool CanRunActiveProject => !_busy && Projects.ActiveProject is not null && !ActiveProjectIsRunning;
    private bool CanStopActiveProject => !_busy && ActiveProjectIsRunning;

    private string StatusDotClass => Live.State switch
    {
        MqttSessionState.Connected => "flux-status-dot live",
        MqttSessionState.Connecting or MqttSessionState.Reconnecting => "flux-status-dot pending",
        MqttSessionState.Faulted => "flux-status-dot faulted",
        _ => "flux-status-dot"
    };

    private Task NewProject() => RunBusyAsync(async () =>
    {
        var dialog = await DialogService!.ShowAsync<NewAppDialog>("New App");
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: NewAppDialog.NewAppResult r })
        {
            var project = Projects.NewProject();
            project.SetDisplayName(r.AppName);
            project.AddWorkflow(r.PipelineName);
            project.SetActiveWorkflow(r.PipelineName);
            var resourceKey = string.IsNullOrWhiteSpace(r.Connection.Name)
                ? "connection"
                : r.Connection.Name.Trim().ToLowerInvariant().Replace(' ', '-');
            project.UpsertConnectionResource(resourceKey, r.Connection);
            Live.AddConnectionIfAbsent(r.Connection, r.Subscription, resourceKey);
        }
    });

    private Task OpenAsync() => RunBusyAsync(async () =>
    {
        var result = await FilePicker.Default.PickAsync(new PickOptions
        {
            PickerTitle = "Open FluxMQ Project",
            FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, [".json"] },
                { DevicePlatform.macOS, ["json", "public.json"] }
            })
        });
        if (result is not null)
        {
            var project = await Projects.OpenAsync(result.FullPath);
            foreach (var (name, profile, sub) in project.GetConnectionResources())
                Live.AddConnectionIfAbsent(profile, sub, name);
        }
    });

    private Task SaveAsync() => RunBusyAsync(async () =>
    {
        var project = Projects.ActiveProject;
        if (project is null) return;
        if (string.IsNullOrEmpty(project.CurrentFilePath))
            await PromptSaveAsAsync(project);
        else
            await project.SaveToFileAsync();
    });

    private Task SaveAsAsync() => RunBusyAsync(async () =>
    {
        var project = Projects.ActiveProject;
        if (project is null) return;
        await PromptSaveAsAsync(project);
    });

    private async Task PromptSaveAsAsync(FlowWorkspaceService project)
    {
        var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "FluxMQ");
        var suggested = string.IsNullOrEmpty(project.CurrentFilePath)
            ? Path.Combine(dir, $"{project.Name}.json")
            : project.CurrentFilePath;

        var dialog = await DialogService!.ShowAsync<SaveAsDialog>("Save As", new DialogParameters
        {
            ["SuggestedPath"] = suggested
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var dialogResult = await dialog.Result;
        if (!dialogResult!.Canceled && dialogResult.Data is string path && !string.IsNullOrWhiteSpace(path))
            await project.SaveAsAsync(path);
    }

    private Task ValidateActiveAsync() => RunBusyAsync(async () =>
    {
        if (Projects.ActiveProject is { } project)
            await project.ValidateAsync();
    });

    private Task RunActiveAsync() => RunBusyAsync(async () =>
    {
        if (Projects.ActiveProject is { } project)
        {
            var brokersReady = await Live.EnsureConnectionsAsync(project.GetConnectionResources());
            if (!brokersReady)
            {
                return;
            }

            await project.RunAsync();
        }
    });

    private async Task StopActiveAsync()
    {
        _stopping = true;
        try
        {
            await RunBusyAsync(async () =>
            {
                if (Projects.ActiveProject is { } project)
                {
                    await project.StopAsync();
                    await Live.DisconnectAutoStartedConnectionsAsync();
                }
            });
        }
        finally
        {
            _stopping = false;
            StateHasChanged();
        }
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        _busy = true;
        StateHasChanged();
        try { await action(); }
        finally { _busy = false; StateHasChanged(); }
    }

    private string _themeIcon => ThemeService.Preference switch
    {
        ThemePreference.Light  => Icons.Material.Filled.LightMode,
        ThemePreference.Dark   => Icons.Material.Filled.DarkMode,
        _                      => Icons.Material.Filled.Brightness6
    };

    private string? StopButtonIcon => _stopping ? null : Icons.Material.Filled.Stop;

    private string _themeLabel => ThemeService.Preference switch
    {
        ThemePreference.Light => "Light mode (click for Dark)",
        ThemePreference.Dark  => "Dark mode (click for System)",
        _                     => "System theme (click for Light)"
    };

    private void CycleTheme()
    {
        var next = ThemeService.Preference switch
        {
            ThemePreference.System => ThemePreference.Light,
            ThemePreference.Light  => ThemePreference.Dark,
            _                      => ThemePreference.System
        };
        ThemeService.SetPreference(next);
        StateHasChanged();
    }

    private void OnThemeChanged(ThemePreference preference)
    {
        ThemeService.SetPreference(preference);
        StateHasChanged();
    }

    private void HandleShellPointerMove(PointerEventArgs args)
    {
        DragState.MoveComponentDrag(args.PointerId, args.ClientX, args.ClientY);
    }

    private void HandleShellPointerUp(PointerEventArgs args)
    {
        var completed = DragState.FinishComponentDrag(args.PointerId, args.ClientX, args.ClientY);
        if (completed is { DidDrag: false })
        {
            Projects.ActiveProject?.AddComponent(completed.ComponentType);
        }
    }

    private void HandleShellPointerCancel(PointerEventArgs args)
    {
        DragState.CancelComponentDrag(args.PointerId);
    }

    private void OnThemeChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    private void OnChanged(object? sender, EventArgs e)
    {
        SyncProjectSubscriptions();
        InvokeAsync(StateHasChanged);
    }

    private void SyncProjectSubscriptions()
    {
        foreach (var project in Projects.Projects)
        {
            if (_subscribedProjects.Add(project))
                project.Changed += OnChanged;
        }

        foreach (var stale in _subscribedProjects.Where(project => !Projects.Projects.Contains(project)).ToArray())
        {
            stale.Changed -= OnChanged;
            _subscribedProjects.Remove(stale);
        }
    }

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        Projects.Changed -= OnChanged;
        Live.Changed -= OnChanged;
        DragState.Changed -= OnChanged;
        foreach (var project in _subscribedProjects)
            project.Changed -= OnChanged;
        _subscribedProjects.Clear();
    }

    [Inject] private IDialogService? DialogService { get; set; }
}

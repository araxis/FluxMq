@page "/"
@using System.Text

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudText Typo="Typo.h6">Live Session</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    Payload inspection is ready for selected MQTT messages.
                </MudText>

                <MudList T="string" Dense="true" Class="mt-3">
                    <MudListItem Icon="@Icons.Material.Filled.Memory" Text="factory/line-1/temperature" />
                    <MudListItem Icon="@Icons.Material.Filled.Bolt" Text="factory/line-1/status" />
                    <MudListItem Icon="@Icons.Material.Filled.Storage" Text="factory/line-1/raw-frame" />
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <PayloadInspectorPanel Topic="factory/line-1/temperature"
                                   ReceivedAt="_sampleReceivedAt"
                                   Payload="_samplePayload" />
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private readonly DateTimeOffset _sampleReceivedAt = DateTimeOffset.UtcNow;
    private readonly byte[] _samplePayload = Encoding.UTF8.GetBytes("""{"device":"line-1","metric":"temperature","value":21.4,"unit":"c"}""");
}

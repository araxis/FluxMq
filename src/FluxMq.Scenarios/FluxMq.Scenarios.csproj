<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="'$(UseFluxFlowSourceReferences)' != 'true'">
    <PackageReference Include="FluxFlow.Engine" Version="$(FluxFlowEngineVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseFluxFlowSourceReferences)' == 'true'">
    <ProjectReference Include="$(FluxFlowSourceRoot)src\FluxFlow.Engine\FluxFlow.Engine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
